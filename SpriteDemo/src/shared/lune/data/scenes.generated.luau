-- 토벌의 방(rf1#3처럼 장면 이름 뒤에 #번호 — 2026-10-16): 그 장면(rf1)의 자료를 쓴다. 들어갈 때마다 따로 된 방이 열린다(서버의 방 · 화면 모두 이 이름으로 찾는다)
setmetatable(M.scenes, { __index = function(t, k)
	local base = if type(k) == "string" then string.match(k, "^(.-)#w?[nh]?%d+$") else nil
	return if base then rawget(t, base) else nil
end })
-- 방의 이름 → 장면의 이름(rf1#3 → rf1 · r1c4#5 → r1c4 · 따로 된 방이 아니면 그대로). 퀘스트 · 튜토리얼 · NPC처럼 설계의 장면 이름과 견줄 때 쓴다(2026-10-21 — 파티마다 따로 들어가는 장면 inst)
function M.base(key: string?): string?
	return if type(key) == "string" then (string.match(key, "^(.-)#w?[nh]?%d+$") or key) else key
end
return M
