		["그런데 꼭대기에서 쇠사슬 소리가 나."] = "But I hear chains rattling up at the top.",
		["망루를 부리는 우두머리야."] = "He's the boss who runs the watchtower.",
		["놈을 끝내면 망루를 되찾을 수 있어."] = "Finish him and the watchtower is ours again.",
		["등롱을 치켜들면 검병이 몰려와. 조심해."] = "When he raises his lantern, Swordsmen swarm in. Careful.",
		["영주님의 도장… 영주님이 왜?"] = "The Lord's signet… Why would our Lord do this?",
		["보름 밤까지라니, 오늘이잖아!"] = "By the full moon night? That's tonight!",
		["저길 봐. 마을 하늘이 붉어!"] = "Look! The sky over the village is red!",
		["사당 쪽이야. 놈들이 사당을 뒤지고 있어!"] = "Over by the Shrine. They're ransacking it!",
		["어서 가! 나도 뒤따라갈게."] = "Go, hurry! I'll be right behind you.",
		["놈들이 찾던 건 닮은 아이였네."] = "They were after the child who bears that likeness.",
		["명령서 속 그 얼굴… 자네였어."] = "The face on those orders… It was you.",
		["알면서도 말하지 못했네. 미안하네."] = "I knew, yet I couldn't tell you. Forgive me.",
		["이 마을에 있으면 자네가 위험해."] = "You're in danger if you stay in this village.",
		["대장간 너머 나루에 은달 항구로 가는 배가 있네."] = "Past the Smithy, at the dock, a ship sails to Silvermoon Harbor.",
		["이제 자네는 이 산골에 머물 사람이 아니야."] = "You're not meant to stay in these mountains anymore.",
		["나루의 선장 배를 타고 은달 항구로 가게."] = "Take the Captain's ship from the dock to Silvermoon Harbor.",
		["부두의 안내인에게 이 편지를 주게."] = "Give this letter to the Harbor Guide on the pier.",
		["선장에게 말을 걸면 배에 태워 줄 걸세."] = "Talk to the Captain and he'll take you aboard.",
		["「산골에서 크게 될 아이」래요. 헤헤."] = "It says 'a mountain kid bound for great things.' Hehe.",
		["저는 바람, 새로 온 사람을 안내해요."] = "I'm Baram. I show newcomers around.",
		["장터 거리의 대장간과 창고부터 가 보세요."] = "Start with the Smithy and Storage on Market Street.",
		["광장엔 경매장과 항구 의뢰소가 있어요."] = "Moonrise Square has the Auction House and the Harbor Request Hall.",
		["의뢰소엔 토벌대장님도 계세요."] = "The Raid Captain is at the Request Hall too.",
		["다 만나고 부두로 오세요!"] = "Meet everyone, then come back to the pier!",
		["문 앞에서 ↑를 누르면 들어가요."] = "Press ↑ at a door to go inside.",
		["제작 · 강화는 담금 아저씨, 짐은 한아름 할아버지."] = "Mr. Damgeum crafts and enhances. Grandpa Hanareum keeps your stuff.",
		["토벌은 무진 대장님이 매일 열어요."] = "Captain Mujin opens Raids every day.",
		["이 「모험의 서」에 도시에서 한 일이 쌓여요."] = "Everything you do in the city goes into this 'Adventure Journal'.",
		["기사단이요? 성문 앞에 견습 기사님이 있어요."] = "The Knights? There's a Squire at the great gate.",
		["마침 숲 일을 거들 사람을 찾더라고요."] = "As it happens, the Squire needs help in the forest.",
		["#층 동쪽 끝의 큰 성문이에요."] = "It's the great gate at the east end of #F.",
		["성문지기 마루 아저씨 옆이요."] = "Right next to Mr. Maru, the Gatekeeper.",
		["기사단의 옛 책을 보러 오셨다고요?"] = "You've come to see the Knights' old books?",
		["그건… 아무에게나 보여 주는 게 아니에요."] = "Those… aren't shown to just anyone.",
		["향신료 가게의 다홍한테 이 짐 좀."] = "Take this cargo to Dahong at the Spice Shop.",
		["성문 옆, 향 냄새 나는 집일세."] = "The shop by the gate that smells of spice.",
		["다홍이에요. 고마워요, 나그네님."] = "I'm Dahong. Thank you, traveler.",
		["상자마다 검은 수정이 들러붙어 와."] = "Every crate comes in crusted with black crystal.",
		["끊긴 순찰로의 봉오리 탓이래."] = "They blame the buds on the Severed Patrol Route.",
		["스물만 걷어 내 주게."] = "Clear out twenty of them for me.",
		["자네 덕에 허리가 다 펴졌네."] = "Thanks to you, I can finally stand up straight.",
		["연못의 두꺼비들이 다 먹어 치운다더군."] = "Seems the toads at the pond are eating them all.",
		["빛나는 연못의 두꺼비 스물만."] = "Just twenty toads at the Glowing Pond.",
		["오늘 저녁은 내가 사지."] = "Dinner's on me tonight.",
		["쉰 해를 쓴 바늘이라네."] = "I've used that hook for fifty years.",
		["물든 숲의 여우 놈일 거야."] = "Must be one of those foxes in the Tainted Forest.",
		["자네는 내 은인일세."] = "I owe you a great debt.",
		["두드리면 종처럼 울려요."] = "Tap them and they ring like bells.",
		["여덟 개만 있으면 악기를 만들어요."] = "With just eight, I can make an instrument.",
		["…이 소리로 옛 노래를 불러 볼게요."] = "…I'll try singing the old song with this sound.",
		["연못 둑의 수정 틈 안쪽에 큰 수정 문이 하나 생겼어."] = "A big crystal gate appeared inside the Crystal Rift by the pond.",
		["그 너머로 수정 짐승들이 끝없이 몰려나온다더군."] = "They say crystal beasts pour out of it without end.",
		["몸 단련엔 그만한 데가 없지."] = "No better place to toughen up.",
		["가서 그 문에 손을 대 보게."] = "Go and lay a hand on that gate.",
		["반달네 옛집 옆의 큰 수정 문일세."] = "It's the big crystal gate by Bandal's Old Home.",
		["하루 한 번 「수정 거울숲」에 들 수 있다."] = "You may enter 'Crystal Mirrorwood' once a day.",
		["기사단 초소 위층의 잠긴 문 너머라오."] = "Beyond the locked door upstairs in the Knights' Outpost.",
		["그 깊은 곳에 검은 수정 문이 하나 섰다지."] = "They say a black crystal gate has risen deep within.",
		["기록이 다 젖어 버리기 전에 살펴봐 주시오."] = "Pray, look into it before the records are soaked through.",
		["금서고 안쪽의 검은 수정 문이오."] = "It is the black crystal gate deep in the Forbidden Archive.",
		["하루 한 번 「검은 거울숲」에 들 수 있다."] = "You may enter 'Black Mirrorwood' once a day.",
		["수정에 덮인 빈집 벽에 있대요."] = "It's on the wall of an empty house covered in crystal.",
		["옮겨 적어 와 줄래요?"] = "Could you copy it down for me?",
		["또 낱말이 빠져 있어요."] = "Words are missing again.",
		["누가 일부러 지운 것 같아요."] = "Looks like someone erased them on purpose.",
		["언덕의 서기님은 옛 기록을 다 봤대요."] = "They say the Hill Scribe has read every old record.",
		["이 악보를 보여 줄래요?"] = "Would you show this sheet music to the Scribe?",
		["금서고의 책에도 긁힌 이름이 다섯이오."] = "A book in the Forbidden Archive has five scratched-out names, too.",
		["우연이라기엔… 아니, 아무것도 아니오."] = "Hardly a coincidence… No. Pay it no mind.",
		["연못 물가에만 피거든요."] = "They only bloom at the pond's edge.",
		["딱 한 송이만 꺾어다 줄래요?"] = "Could you pick just one for me?",
		["이건 안 팔고 제가 가질래요."] = "I'm not selling this one. It's mine!",
		["숲 쪽으로 날아갔대요."] = "It blew toward the forest.",
		["거미줄에 걸렸을까요…?"] = "Maybe it got caught in a spiderweb…?",
		["엄마가 엄청 좋아할 거예요!"] = "Mom's gonna be so happy!",
		["수정싹 그루터기의 연한 싹이 필요해."] = "I need tender shoots from Crystal Sprout Stumps.",
		["성문 밖 숲길에서 열 개만."] = "Just ten, from the Outer Gate Woods.",
		["첫 그릇은 자네 몫이야."] = "The first bowl's yours.",
		["물든 숲의 여우 놈들이야."] = "It's those foxes from the Tainted Forest.",
		["스물만 혼내 주게."] = "Teach twenty of them a lesson.",
		["오늘 고기는 자네 몫까지 떠 놨어."] = "I've set aside some of today's meat for you, too.",
		["갈매 할아버지 앞으로요."] = "It's addressed to Grandpa Galmae.",
		["…이름이 아주 오래된 글씨예요."] = "…The name's written in a very old hand.",
		["…섬에 두고 온 동생의 글씨구먼."] = "…It's the hand of the brother I left on the island.",
		["고맙네. 정말 고맙네."] = "Thank you. Truly, thank you.",
		["말들이 꼴을 안 먹어!"] = "The horses won't eat their hay!",
		["오솔길 달팽이 스물만 부탁해."] = "Twenty snails from the trail, please!",
		["고마워. 너 진짜 기사 같아."] = "Thanks! You're just like a real knight.",
		["고슴도치 가시에 걸려 있대."] = "They're stuck on the hedgehogs' quills.",
		["다섯 개만 구해 줄래? 꼭 갖고 싶어."] = "Can you get me five? I really want them.",
		["근데 기사들은 다 어디 갔을까?"] = "But where did all the knights go?",
		["수정 거미 실이 쇠줄보다 질기대."] = "Crystal Spider silk is tougher than steel wire!",
		["실타래 열 개만 구해 줘."] = "Get me ten spools of silk!",
		["고마워. 비행선이 더 높이 날 거야!"] = "Thanks! The airship will fly even higher!",
		["엔진에 넣으면 더 멀리 날아."] = "Put one in the engine and we fly farther!",
		["성당 앞뜰의 골렘 새끼 거야."] = "The Young Geode Golems in the Cathedral Forecourt have them.",
		["이걸로 동쪽 대륙까지 단숨이야."] = "With this, we'll zip to the eastern continent!",
		["근데 성당 쪽 연기가 뱃길을 가려."] = "But smoke from the cathedral is blocking our sky route.",
		["회랑의 향로 스물만 꺼 줘."] = "Snuff out twenty censers in the corridor!",
		["첫 비행 땐 꼭 너를 태울게. 약속!"] = "You're riding on the first flight. Promise!",
		["여우의 꼬리 불이 가장 오래 타요."] = "A fox's tail-fire burns the longest.",
		["여덟 개만 구해 주실래요?"] = "Could you get me eight?",
		["…등불이 꺼지면 영주님이 화를 내세요."] = "…The Lord gets angry if the lanterns go out.",
		["무언가 무거운 게 끌리는 소리요."] = "Like something heavy being dragged.",
		["낮에 한 번만 살펴봐 주실래요?"] = "Could you take a look, just once, in daylight?",
		["누가 큰 짐승을 들여왔나 봐요."] = "Someone must have brought in a big beast.",
		["…아무한테도 말하지 말아 주세요."] = "…Please don't tell anyone.",
		["이름을 긁어낸 책이 있다고 적혀 있소."] = "It is written that one book had its names scratched out.",
		["그 책등을 한 번 봐 주시오."] = "Pray, take a look at its spine.",
		["…기록을 지운 자가 있다는 뜻이오."] = "…That means someone erased the records.",
		["이 일은 우리 둘만 알고 있읍시다."] = "Let us keep this between the two of us.",
		["장작 하러 나가는 사람들이 무서워해."] = "Folks going out for firewood are scared.",
		["성문 밖 숲길의 그루터기 스물만."] = "Just twenty stumps in the Outer Gate Woods.",
		["고맙네, 젊은이."] = "Thank you, youngster.",
		["진통제를 만들 참이에요."] = "I'm going to make a painkiller.",
		["독주머니 여덟 개만요. 조심해요!"] = "Just eight venom sacs. Be careful!",
		["이 약은 당신 몫도 있어요."] = "There's some of this medicine for you, too.",
		["금서고 열쇠는 부단장님만 갖고 계세요."] = "Only the Vice Captain holds the Archive key.",
		["…그런데 요즘 숲이 이상해서 다들 바빠요."] = "…But the forest's been strange lately, so everyone's busy.",
		["숲 일을 도와주시면 부단장님께 말씀드릴게요."] = "Help with the forest, and I'll speak to the Vice Captain.",
		["저는 하늬예요. 수정 기사단의 견습 기사."] = "I'm Hanui, a Squire of the Crystal Knights.",
		["먼저 성문 밖 숲 어귀부터 봐 주세요."] = "First, check the edge of the forest outside the gate.",
		["수정이 박힌 나무 그루터기예요."] = "Tree stumps with crystals stuck in them.",
		["원래 수정은 숲을 지켜 주는 거였는데…"] = "Crystals used to protect the forest…",
		["열둘만 쓰러뜨려 주세요."] = "Please take down twelve.",
		["이런 건 기사단에서도 처음 봐요."] = "Even the Knights have never seen anything like this.",
		["…그리고 연못에 간 순찰대가 안 돌아와요."] = "…And the patrol that went to the pond hasn't come back.",
		["마지막으로 간 곳이 빛나는 연못이에요."] = "The last place they went was the Glowing Pond.",
		["두꺼비들이 반짝이는 걸 물어 가요."] = "The toads snatch up anything shiny.",
		["순찰대 표식을 찾아 주세요."] = "Please find the Patrol Insignias.",
		["그런데 이 화살 좀 보세요."] = "But look at this arrow.",
		["@hero 산골에서 본 갑옷 병사들의 화살이에요."] = "@hero It's from the armored soldiers I saw back in the mountains.",
		["속이 빈 갑옷이요? 그게 왜 숲까지…"] = "Hollow armor? Why would they come all the way to the forest…",
		["끊긴 순찰로의 수정이 검게 물들었어요."] = "The crystals on the Severed Patrol Route have turned black.",
		["검은 수정 봉오리가 길을 막아요."] = "Black crystal buds are blocking the way.",
		["열다섯만 걷어 주세요."] = "Please clear fifteen of them.",
		["검은 수정은 기사단 책에도 없어요."] = "Black crystals aren't in any of the Knights' books.",
		["순찰로 끝의 초소까지 가 봐야겠어요."] = "We should go to the outpost at the end of the route.",
		["고슴도치 떼가 초소를 덮었대요."] = "They say a horde of hedgehogs has overrun the outpost.",
		["몰아내고 안을 살펴봐 주세요."] = "Drive them out and search inside.",
		["\"금서고의 옛 기록을 남김없이 태울 것.\""] = "\"Burn every old record in the Forbidden Archive.\"",
		["왕도의 도장이에요. 왜 왕도가 우리 책을…"] = "That's the Capital's seal. Why would the Capital want our books…",
		["본당으로 가요. 보여 드릴 게 있어요."] = "Let's go to the Main Hall. There's something I must show you.",
		["명령서를 들고 같이 봐요."] = "Bring the orders and let's look together.",
		["이름 칸도 다 지워졌어요."] = "Even the name plates are wiped clean.",
		["어릴 때부터 원래 그런 줄 알았어요."] = "Since I was little, I thought it had always been like that.",
		["@hero 산골 망루의 그림과 똑같아요."] = "@hero It's just like the painting in the mountain watchtower.",
		["…부단장님께 여쭤봐야겠어요."] = "…I need to ask the Vice Captain.",
		["…부단장님 얼굴이 하얘지셨어요."] = "…The Vice Captain went pale.",
		["명령서를 나르던 사수가 능선으로 달아났대요."] = "The archer carrying the orders fled toward the ridge.",
		["능선 끝의 무너진 아치까지 쫓아가 주세요."] = "Chase them to the fallen arch at the end of the ridge.",
		["아치 밑에 무언가 있을 거예요."] = "There must be something under the arch.",
		["「기록은 모두 수정 성당으로」…"] = "'All records to the Crystal Cathedral'…",
		["부단장님이 금서고 열쇠를 들고 성당에 가셨대요."] = "The Vice Captain went to the cathedral with the Archive key.",
		["회랑에 향로가 떠다니며 연기를 뿜어요."] = "Censers drift through the corridor, belching smoke.",
		["향로를 걷어 내고 길을 터 주세요."] = "Clear out the censers and open a path.",
		["종탑 위에서 불빛이… 무언가를 태워요!"] = "A light atop the Bell Tower… Something's burning!",
		["…눈이 검게 물들었어요. 검은 수정이에요."] = "…The Vice Captain's eyes went black. It's the black crystal.",
		["한 장이라도 건져 주세요!"] = "Save even a single page!",
		["부단장님은… 이제 우리를 몰라봐요."] = "The Vice Captain… doesn't know us anymore.",
		["도끼 · 창 · 낫 · 대검 · 불…"] = "Axe · Spear · Scythe · Greatsword · Fire…",
		["…이건 당신이 든 무기잖아요?"] = "…Isn't that the weapon you carry?",
		["부단장님은 불길 너머로 사라졌어요."] = "The Vice Captain vanished beyond the flames.",
		["마지막 줄은 「불 앞에서는 지우지 못했다」."] = "The last line says: 'Before the fire, none could erase it.'",
		["그루터기의 끈끈한 진이면 때울 수 있지."] = "Sticky sap from the stumps would patch it up.",
		["고맙네. 짐 나를 일 있으면 말하게."] = "Thanks. If you need anything hauled, just say so.",
		["빛나는 연못 뒤 수정 틈 너머일세."] = "It's past the Crystal Rift behind the Glowing Pond.",
		["그 집 장부가 아직 있을 거야."] = "That family's ledger should still be there.",
		["…마지막 장이 뜯겨 나갔구먼."] = "…The last page has been torn out.",
		["그 집안은 무언가를 숨겨 왔네."] = "That family has been hiding something.",
		["두꺼비 등의 빛 이끼가 약이 돼요."] = "The Glow Moss on the toads' backs makes good medicine.",
		["…고마워요. 정말로요."] = "…Thank you. I mean it.",
		["고슴도치 가시에 걸려 있을 거예요."] = "They're probably stuck on the hedgehogs' quills.",
		["닦아서 본당 벽에 걸어 둘게요."] = "I'll clean them and hang them on the Main Hall wall.",
		["장꾼들이 못 넘어와요. 서른만 부탁해요."] = "The traders can't get across. Thirty of them, please.",
		["장삿길이 다시 열렸어요. 고마워요!"] = "The trade road is open again. Thank you!",
		["골렘 새끼들이 낱장을 삼켰대요."] = "They say the young golems swallowed the pages.",
		["삼백 년 내내 같은 글씨예요."] = "The same handwriting for three hundred years.",
		["종지기들이 종을 깨뜨려 놓았대요."] = "They say the Bellkeepers broke the bell.",
		["조각 여덟을 모아 와 주세요."] = "Please bring back eight pieces.",
		["…여기도 다섯 칸이 비어 있어요."] = "…Five blank spaces here, too.",
		["헤헤, 동쪽 대륙엔 저도 처음이에요."] = "Hehe, it's my first time on the eastern continent too.",
		["「불 앞에서는 지우지 못했다」…"] = "'Before the fire, none could erase it'…",
		["땅속에 꺼지지 않는 불, 화롯골이 있대요."] = "They say there's an undying fire underground: Emberhollow.",
		["굴 입구의 굴쥐부터 쫓아 주실래요?"] = "Could you chase off the Cave Rats at the Cave Entrance first?",
		["아래 야영지에 지상 상인들이 있대요."] = "There are surface traders at the camp below.",
		["화롯골에서 쫓겨난 사람들이래요."] = "They were driven out of Emberhollow.",
		["야영지의 소금 장수가 사정을 잘 안대요."] = "The Salt Peddler at the camp knows the whole story.",
		["서른 해 소금을 댔는데 하루아침에 쫓겨났네."] = "Thirty years I sold them salt, and overnight they threw me out.",
		["우리가 안 했다는 걸 보여 줘야 문이 열리지."] = "The gate won't open till we prove we didn't do it.",
		["식은 광산에 바퀴 자국이 남았을 거야."] = "There should be wheel tracks left in the Cold Mine.",
		["코볼트들이 수레 못을 주워 가더군."] = "The kobolds keep picking up the cart nails.",
		["바퀴 자국이 지상 광산 쪽으로 나 있다고?"] = "The tracks lead toward the surface mines?",
		["지상 광산은 영주님 것인데…"] = "But the surface mines belong to the Lord…",
		["불씨 길의 지렁이를 조심하게."] = "Mind the worms on the Ember Path.",
		["그 끝에 불의 아이들이 산다더군."] = "They say the Children of Fire live at the end.",
		["나는 아리야. 화롯골 아이야."] = "I'm Ari. I'm from Emberhollow.",
		["어른들은 내 말을 안 믿어 줘."] = "The grown-ups won't believe me.",
		["도둑들이 불씨 단지를 거기 쌓아 둬."] = "The thieves stash the Ember Jars in there.",
		["도둑을 혼내 주면 어른들도 믿을 거야."] = "Beat the thieves and the grown-ups will believe us.",
		["불씨를 지상 영주에게 바치고 있었다고?"] = "They were handing our embers to a surface lord?",
		["미안하네. 화롯골의 문을 열겠네."] = "Forgive us. We'll open Emberhollow's gate.",
		["나는 아궁, 이 골의 족장일세."] = "I am Agung, chieftain of this hollow.",
		["둘레길에 재 회오리가 날뛰어."] = "Ash Whirlwinds are running wild on the ring road.",
		["걷어 주면 화로가 숨을 쉴 걸세."] = "Clear them and the furnace can breathe again.",
		["자네 손의 그 무기… 어디서 났나?"] = "That weapon in your hand… where did you get it?",
		["보여 줄 것이 있네. 따라오게."] = "There's something I must show you. Follow me.",
		["지상 사람들은 다 지웠지만 우리는 지우지 않았지."] = "The surface folk erased it all, but we never did.",
		["불 앞에서는 아무도 지우지 못했거든."] = "For before the fire, no one could erase it.",
		["다섯은 검은 용과 함께 봉인되었지. 오천 년 전에."] = "The five were sealed with the Black Dragon. Five thousand years ago.",
		["그리고 언젠가 용사를 닮은 아이가 태어난다고…"] = "And one day, a child who looks like a hero would be born…",
		["@hero …그 아이가 저라고요?"] = "@hero …You mean that child is me?",
		["마지막 그림을 보게. 사람 옷을 입은 용들일세."] = "Look at the last picture. Dragons dressed as humans.",
		["왕도의 깃발을 단 폭탄병들이야."] = "Bombers flying the Capital's banner.",
		["기슭의 폭탄병부터 막아 주게."] = "Stop the Bombers on the foothills first.",
		["분화구 바닥에서 무언가 깨어났네."] = "Something has awakened at the bottom of the crater.",
		["벽화를 묻으려고 화약을 묻은 걸세."] = "They planted powder to bury the mural.",
		["분화구 바닥에 무엇을 남겼는지 보고 오게."] = "Go see what they left at the bottom of the Crater.",
		["바닥 한가운데를 살펴보게."] = "Search the very center of the floor.",
		["…산을 터뜨린 건 왕도였구먼."] = "…So it was the Capital that blew up the mountain.",
		["벽화의 마지막 그림이 그린 곳도 만월성이야."] = "The place in the mural's last picture is Full Moon Castle, too.",
		["오천 년 전 사람의 왕도였지."] = "It was the capital of humankind five thousand years ago.",
		["자네 마을 사람들도 그리로 갔다네."] = "Your village folk have gone there, too.",
		["굴쥐 수염이 횃불 심지로 딱이에요."] = "Cave Rat whiskers make perfect torch wicks.",
		["이제 야영지가 밤에도 밝겠어요."] = "Now the camp will stay bright at night.",
		["코볼트가 등잔 조각을 주워 갔어요."] = "The kobolds took the Lamp Pieces.",
		["갱 맨 밑의 제단에 올리는 거래요."] = "It goes on the altar at the bottom of the mine.",
		["폭주 광차 스물만 세워 주게."] = "Stop twenty of those Rampaging Minecarts.",
		["짐이 생기면 우리가 맡아 주지."] = "If you have things to store, we'll keep them for you.",
		["지렁이가 삼켰어. 찾아다 줄래?"] = "The worms swallowed them. Can you get them back?",
		["고마워. 이건 내 보물이야."] = "Thanks! This is my treasure.",
		["도둑들한테서 되찾아다 줘."] = "Get them back from the thieves!",
		["이걸로 큰 화로를 다시 지필 거야."] = "We'll light the Great Furnace again with these.",
		["열 통만 가져오게. 쇠테는 녹여 쓰겠네."] = "Bring me ten kegs. I'll melt down the iron hoops.",
		["불은 터뜨리라고 있는 게 아닐세."] = "Fire isn't meant for blowing things up.",
		["조각 여덟 개만 찾아다 줘."] = "Find me eight pieces!",
		["못가에 놓으면 어미가 올라온대."] = "They say if you set it by the pool, the mother comes up.",
		["하늬도, 할멈도, 촌장님도 오셨어요."] = "Hanui, Granny Agung, even the Village Chief came!",
		["할멈께 먼저 인사드리세요."] = "Go greet Granny Agung first.",
		["사람 옷을 입은 용들이 이 성에 있었지."] = "The dragons dressed as humans were in this castle.",
		["먼저 외성 너머 아랫마을부터 되찾아야 하네."] = "First, we must retake the Lower Town past the outer wall.",
		["네. 부단장님 일 뒤로 다들 정신 차렸어요."] = "Yes. After the Vice Captain, everyone came to their senses.",
		["외성이 무너진 틈으로 들어가요."] = "We'll go in through the breach in the outer wall.",
		["틈을 지키는 검병부터 치워 주세요."] = "Please clear the Swordsmen guarding the breach first.",
		["아랫마을 사람들이 숨어 있대요."] = "They say the Lower Town folk are in hiding.",
		["옛 기사들의 석상이 움직여요."] = "The statues of the old knights are moving.",
		["기사상부터 쓰러뜨려 주세요."] = "Please take down the knight statues first.",
		["이제 사람들이 돌아올 수 있어요."] = "Now people can come back.",
		["…점령군이 누구 편인지 아무도 몰라요."] = "…Nobody knows whose side the occupiers are on.",
		["성벽 위에 폭탄병이 줄지어 있어요."] = "Bombers are lined up on the rampart.",
		["화산을 터뜨린 그 깃발이에요."] = "Same banner as the ones who blew up the volcano.",
		["왕도의 대신들 깃발이 걸려 있어요."] = "The banners of the Capital's ministers hang there.",
		["대신들이 직접 내려와 있대요."] = "They say the ministers came here in person.",
		["뜰의 창병부터 줄여 주세요."] = "Please thin out the Spearmen in the yard first.",
		["봉인을… 왜 왕도의 대신들이?"] = "The seal… Why would the Capital's ministers…?",
		["서둘러요. 계단으로 내려가야 해요."] = "Hurry. We need to go down the stairs.",
		["감시하는 눈이 온통 깔려 있어요."] = "Watching Eyes are everywhere.",
		["눈에 띄면 대신들이 알아챌 거예요."] = "If they spot us, the ministers will know.",
		["오늘 밤은 숙소에서 쉬어요."] = "Let's rest at the barracks tonight.",
		["촌장님이 하실 말씀이 있대요."] = "The Village Chief has something to tell you.",
		["하실 말씀이 있으시대요."] = "He says he has something to tell you.",
		["오천 년 동안 숨어서 가르침을 이어 왔지."] = "For five thousand years, we hid and passed on the teachings.",
		["사당에서 배운 기술이 그 가르침일세."] = "The skills you learned at the Shrine are those teachings.",
		["명령서 속 얼굴… 자네를 숨기려 했네."] = "The face on the orders… I tried to hide you.",
		["이제 숨지 않겠네. 함께 가세."] = "No more hiding. Let us go together.",
		["봉인의 문으로 내려가려면 그 성문을 지나야 하지."] = "To go down to the Seal Gate, we must pass that gate.",
		["깨진 쐐기의 방 끝 계단으로 올라가 빗장을 풀게."] = "Climb the stairs at the end of the Broken Wedge Chamber and lift the bar.",
		["성문의 큰 빗장일세."] = "It's the great bar on the gate.",
		["대신들이 봉인의 문으로 내려갔대요."] = "The ministers went down to the Seal Gate.",
		["…무언가를 하러 간 거예요."] = "…They're up to something.",
		["저도 갈게요. 같이 가요!"] = "I'm coming too. Let's go together!",
		["성문 오른쪽 계단으로 내려가면 돼요."] = "Take the stairs down, to the right of the gate.",
		["무슨 짓을 하는지 봐야 해요."] = "We have to see what they're doing.",
		["문 앞에서 ↑로 살펴봐요."] = "Press ↑ at the gate to examine it.",
		["나라의 수뇌부가 사람으로 변한 용이었구먼."] = "The kingdom's rulers were dragons in human form.",
		["사람들은 아무것도 모르고 섬겨 왔네."] = "And the people served them, knowing nothing.",
		["저들도 이제 자네를 알았을 걸세."] = "They must know about you now, too.",
		["이제 우리가 먼저 움직여야 하네."] = "Now we must make the first move.",
		["창병의 부러진 창대를 엮을게요."] = "I'll weave the Spearmen's broken shafts together.",
		["오늘 밤은 다들 푹 자겠네요."] = "Everyone will sleep soundly tonight.",
		["상자 여덟 개만 되찾아 주실래요?"] = "Could you get back eight crates?",
		["다들 한시름 놓겠어요!"] = "Everyone can breathe easier now!",
		["궁병들이 열쇠를 넷으로 나눠 가졌소."] = "The archers split the key four ways.",
		["옛 수로의 문에 꽂으면 되오."] = "Simply fit it into the door of the Old Waterway.",
		["창병의 쇠 덧판을 벗겨다 주세요."] = "Please strip the Iron Plates off the Spearmen.",
		["스무 자루는 고치겠대요."] = "The smithy says they can fix twenty weapons.",
		["책 사이에 톱니가 끼어 있대요."] = "They say Cogwheels are stuck between the books.",
		["됐어요! 멈춘 태엽이에요."] = "Done! It's the Stilled Clockwork.",
		["검병들이 떼어 갔어요. 되찾아 줘요."] = "The Swordsmen tore them down. Please get them back.",
		["이제 회랑이 다시 회랑 같아요."] = "Now the corridor feels like itself again.",
		["검병에게서 여섯 장만 되찾아 주게."] = "Take back six from the Swordsmen.",
		["둥지 쪽으로는 함부로 가지 말게."] = "Don't go near the nest lightly.",
		["빛 먹는 것들이 물고 다닌다네."] = "The Light Eaters carry them around in their mouths.",
		["수고했네. 제단에 올려 두겠네."] = "Well done. I'll set them on the altar.",
		["지하의 수련 인형에게서 조각 넷을 가져오너라."] = "Bring me four pieces from the Training Dummies below.",
		["네 개를 모으거든 다시 오너라."] = "Return once you have gathered four.",
		["다음 길을 열어 주마. 받아라."] = "I shall open the next path for you. Take it.",
		["수정 성당의 종탑에 달빛이 서린 종이 있다."] = "In the Crystal Cathedral's Bell Tower hangs a moonlit bell.",
		["그 조각 넷을 가져오너라."] = "Bring me four of its pieces.",
		["이제 한 단계 더 깊은 힘이다. 받아라."] = "Now, a power one step deeper. Take it.",
		["외성 밖 들판의 정예 창병들이 옛 깃발을 지녔다."] = "The Elite Spearmen of the Outer Wall Fields bear an old banner.",
		["바래지 않은 조각 넷을 가져오너라."] = "Bring me four unfaded pieces.",
		["이제 마지막 힘이다. 받아라."] = "Now, the final power. Take it.",
		["또 달빛 꿈을 꾸었구나."] = "So the Moonlight Dream came to you again.",
		["먼저 몸부터 풀고 오너라."] = "Go and warm up your body first.",
		["좋다. 몸이 먼저 기억하는구나."] = "Good. Your body remembers before you do.",
		["마침 잘 오셨어요. 큰일 났어요."] = "You came just in time. We're in big trouble!",
		["어귀의 수습 검병부터 쫓아 주세요."] = "Please drive off the Recruit Swordsmen at the Village Entrance first.",
		["베니까 재가 되고 갑옷만 남았다고?"] = "You cut them down, and they turned to ash, leaving only armor?",
		["갑옷 조각을 여덟 개만 가져오게."] = "Just bring me eight Armor Pieces.",
		["어귀 너머 사냥터의 검병에게서 나온다네."] = "The Swordsmen in the hunting ground past the Village Entrance drop them.",
		["…조각마다 재가 묻어 있구먼."] = "…Every piece is covered in ash.",
		["샛별이 병사들의 발자국을 찾았다네."] = "Saetbyeol found the soldiers' footprints.",
		["달그림자 사냥터 너머 깊은 곳일세."] = "It's the Deep Hunting Ground, past the Moonshadow Hunting Ground.",
		["길이 트였구먼. 발자국은 어디로 가던가?"] = "The path is clear. So, where did the footprints lead?",
		["그 야영지에 가 보게."] = "Go and take a look at that camp.",
		["야영지의 재까마귀가 종이를 물고 다닌다네."] = "The Ash Crows at the camp carry scraps of paper around.",
		["찢어진 명령서로구먼. 어디, 맞춰 보세."] = "Torn orders, eh? Come, let's piece them together.",
		["명령서대로 놈들이 고갯길을 막았네."] = "Just as the orders said, they've blocked the pass road.",
		["세 갈래 길 너머 고갯길 초입의 궁병일세."] = "It's the Archers at the Pass Trailhead, past the Three-Way Fork.",
		["궁병을 뚫고 왔다고? 장하구먼."] = "You broke through the Archers? Well done!",
		["장꾼들이 굽잇길에서 짐을 털렸다네."] = "The traders were robbed of their goods on the Winding Road.",
		["굽잇길의 폭탄병일세. 조심하게."] = "It's the Bombers on the Winding Road. Be careful.",
		["덕분에 장삿길이 다시 열렸구먼."] = "Thanks to you, the trade road is open again.",
		["목이 말라 이야기가 안 나오는구먼."] = "My throat's too dry to tell a story.",
		["무너진 다리 너머 돌무더기 밑일세."] = "It's under the rock pile past the Fallen Bridge.",
		["시원하구먼. 자, 옛이야기 하나 하지."] = "Ahh, refreshing. Now, let me tell you an old tale.",
		["노인이 보냈다고? 마침 잘 왔어."] = "The old man sent you? You came at a good time.",
		["#층의 정예 검병이야. 조심해."] = "It's the Elite Swordsmen on floor #. Be careful.",
		["혼자서 #층을 쓸었다고? 깃발까지!"] = "You cleared floor # all by yourself? And found the banner!",
		["#층엔 주인 없는 투구만 굴러다녀."] = "Floor # has nothing but empty helmets rolling around.",
		["망루 #층의 빈 투구야."] = "The Empty Helms on Watchtower #F.",
		["투구 속에도 재뿐이라고?"] = "Nothing but ash inside the helmets, too?",
		["쿵 소리의 정체는 거인이야."] = "That thudding sound? It's a giant.",
		["#층 맨 위의 문으로 꼭대기에 올라가."] = "Go up to the top through the door at the top of floor #.",
