-- 「달의 계승자」(횡스크롤 MMORPG) — 클라이언트 · 서버가 같이 쓰는 기본 상수.
--  움직임 수치는 공방 「횡스크롤 시험」 탭(dino-workshop/js/lune/luneTab.js)에서 손맛을 맞춘 값 그대로다 — 여기서 따로 고치지 않는다.
--  좌표는 모두 도트(게임 화면 384x216) 단위. 캐릭터의 (x, y)는 발밑 가운데다.
return {
	VIEW_W = 384,
	VIEW_H = 216,
	TILE = 16,

	RUN = 92, -- 달리는 빠르기(도트/초)
	GRAVITY = 640,
	JUMP = 270, -- 뛰는 높이 = JUMP² / (2 · GRAVITY) ≈ 57도트
	MAX_FALL = 420,
	BOX_W = 10, -- 몸 상자(발밑 가운데 기준)
	BOX_H = 17,
	FALL_OUT = 40, -- 맵 아래로 이만큼 떨어지면 시작 자리로

	GROUND_Y = 176, -- 장면에서 땅의 윗면(공방의 맵은 모두 11째 칸 위에 땅을 둔다). 화면에서는 이것이 Kit.GROUND(150)에 오게 올려 그린다
}
