Panel.GUIDE_W = Panel.INNER - Panel.NAV_W - Panel.NAV_GAP -- 받을 수 있는 퀘스트의 이름이 쓰는 폭
-- 알리미의 크기 세 단계(머리줄 오른쪽 끝의 「−」 · 「+」 단추로 한 단계씩 줄이고 늘린다):
--   최소(MIN) = 머리줄만(다 닫힌다) · 중간(MID — 처음) = 중요한 것만: 메인 · 전직 · 일일 의뢰(+ 다음 메인 · 전직의 길잡이) · 최대(MAX) = 받은 퀘스트와 일일 의뢰 모두 + 받을 수 있는 퀘스트
--  사용자 2026-10-13: "퀘스트 가 - 누르면 중요한거 메인 , 일퀘 이런거만 뜨고  + 누르면 다보이는 식이여야죠" → 같은 날
--   "최소화   중간   최대화  이렇게 해서   최소화는 다 닫히는거  중간은  현재 최소화  최대화는  지금 최대화 로 해서  +- 버튼을 몇번더 누르냐에 따라 늘리고 줄일수 있도록"
--  판은 정한 높이(Panel.maxH)까지만 자라고, 적을 것이 그보다 많으면 판 안에서 스크롤한다(같은 날: "스크롤을 넣어야죠 무식하게 아래로 계속확장하면 어쩌라는거에요")
Panel.MIN, Panel.MID, Panel.MAX = 0, 1, 2
Panel.SIZE_FIRST = Panel.MID -- 처음의 크기(사용자: "퀘스트는 중요한것만 보이는게 디폴트입니다")
Panel.FOLD_BETWEEN = 3 -- 「−」와 「+」 사이
Panel.KEY_TAGS = { main = true, job = true, daily = true } -- 중요한 것: 메인 · 전직 · 일일 의뢰
Panel.FOLD_W, Panel.FOLD_H, Panel.FOLD_GAP = 15, 13, 6 -- 단추(머리줄의 오른쪽 끝)
Panel.FOLD_HIT = { x = 5, y = 4 } -- 누르는 자리는 그림보다 이만큼씩 넓다
Panel.LIST_TOP = Panel.HEAD + 1 -- 스크롤하는 칸이 시작하는 자리(머리줄과 가르는 줄 아래)
Panel.LIST_BOTTOM = 2 -- 판의 아래 테두리
Panel.SCROLL_W = 3 -- 스크롤 막대의 폭(판의 오른쪽 여백 안에 든다)
-- 판의 가장 큰 높이: PC = 공방의 칸(hud.quest.h) — 창이 작아 메뉴 단추에 닿으면 그 위까지만 · 스마트폰 = 손가락 단추에 닿지 않는 칸
function Panel.maxH(gridH: number?, touch: boolean?): number
	if touch then
		return Panel.H_TOUCH
	end
	local below = UI.grid.h - UI.hud.menu.y + 8
	return math.min(Panel.H, (gridH or UI.grid.h) - UI.hud.quest.y - below)
end

-- 할 일 한 줄을 글과 숫자로 가른다: 「검병 · 갑옷 조각 3/8」 → 「검병 · 갑옷 조각」, 「3/8」
function Panel.split(text: string): (string, string?)
	local label, count = string.match(text, "^(.-)%s+(%d+/%d+)$")
	if label then
		return label, count
	end
	return text, nil
end

-- 알리미에 적을 것을 차례대로 셈한다(화면을 모르는 셈 — 자동 검사가 그대로 부른다). 돌려주는 것: 줄들, 적은 것 전체의 높이, 적은 퀘스트의 수, 길잡이 수, 그 밖의 것(info)
--  줄: { kind = "quest"(갈래 · 이름 · key) | "step"(글 · 숫자 · 한 수 · 할 수) | "ready"(돌려줄 사람) | "label"(「받을 수 있는 퀘스트」) | "guide"(이름) | "where"(받는 곳), y, … }
--   y = 판의 위에서부터(머리줄을 넣어). 적은 것 전체의 높이가 판의 가장 큰 높이(maxH)를 넘으면 판은 maxH까지만 그리고 그 안에서 스크롤한다
--  maxH = 판의 가장 큰 높이(안 주면 PC의 칸 — 게임은 Panel.maxH를 준다)
--  daily = 받아 둔 일일 의뢰들 { { name(몬스터), place(맵), n, have } … }(sim/daily.luau의 tracked) — 하는 중인 퀘스트 다음, 길잡이 앞에 「일일」 표로 적는다
--  size = 크기(Panel.MIN · MID · MAX — 안 주면 MAX. 예전의 꼴: true = MID · false = MAX)
--  info = { total = 받은 것 모두의 수, hidden = 중요한 것만일 때 안 적은 수, fold, view = 판의 높이, scroll = 스크롤하는가, any = 어느 모습에서든 적을 것이 있는가 }
function Panel.layout(book, names, level: number?, maxH: number?, daily: any?, sizeOrFold: any?)
	local size = if typeof(sizeOrFold) == "number" then sizeOrFold elseif sizeOrFold == true then Panel.MID else Panel.MAX
	local fold = size <= Panel.MID -- 중요한 것만
	local rows = {}
	local y = Panel.HEAD + 4
	local shown, guided = 0, 0
	-- 받은 것들: 하는 중인 퀘스트(전직 → 메인 → 부탁) → 일일 의뢰
	local entries = {}
	for _, id in Quests.active(book or {}) do
		local def = Quests.def(id)
		local st = book[id]
		local e = { tag = def.kind, name = def.name, key = id, ready = Quests.isReady(book, id), steps = {} }
		if e.ready then
			e.back = Quests.todo(book, id, names)[1] or ""
		else
			for i, step in def.steps do
				local have = st.c[i] or 0
				if have < step.n then
					local label, count = Panel.split(Quests.trackText(step, have))
					table.insert(e.steps, { text = label, count = count or ("%d/%d"):format(have, step.n), have = have, n = step.n })
				end
			end
		end
		table.insert(entries, e)
	end
	-- 일일 의뢰(받아 둔 것): 「일일」 표 + 맵의 이름 / 「포자 주머니 3/8」과 진행 띠 — 다 잡았으면 「? 게시판에 낸다」
	for _, d in daily or {} do
		local e = { tag = "daily", name = d.place, key = if d.region then ("daily:%s:%d"):format(d.region, d.i) else nil, ready = d.have >= d.n, steps = {} }
		if e.ready then
			e.back = Panel.DAILY_BACK
		else
			table.insert(e.steps, { text = d.name, count = ("%d/%d"):format(d.have, d.n), have = d.have, n = d.n })
		end
		table.insert(entries, e)
	end
	local info = { total = #entries, hidden = 0, fold = size == Panel.MID, size = size, view = 0, scroll = false, any = #entries > 0 }
	for _, e in entries do
		if fold and not Panel.KEY_TAGS[e.tag] then
			info.hidden += 1
			continue
		end
		shown += 1
		table.insert(rows, { kind = "quest", y = y, tag = e.tag, name = e.name, key = e.key }) -- key = 길찾기 단추가 가리키는 것
		y += TITLE
		if e.ready then
			table.insert(rows, { kind = "ready", y = y, text = e.back })
			y += LINE + 2
		else
			for _, st in e.steps do
				table.insert(rows, { kind = "step", y = y, text = st.text, count = st.count, have = st.have, n = st.n })
				y += Panel.STEP
			end
		end
		y += GAP
	end
	-- 길잡이(받을 수 있는 퀘스트): 중요한 것만일 때는 다음 메인 · 전직만(부탁은 뺀다)
	--  사용자 2026-10-13: "퀘스트 ui에 받을수있는 퀘스트 띄우지마세요  그건  퀘스트 버튼을 누르고 시작가능까지 들어가서 확인하는거지  왜 간편 ui에서 띄웁니까" → 알리미는 받은 것만 적는다(받을 수 있는 것은 퀘스트 창의 「시작 가능」)
	local guides = {}
	info.any = info.any or #guides > 0
	if size == Panel.MIN then
		-- 최소: 머리줄만(받은 것의 수는 머리줄의 「진행 N」에 남는다)
		info.hidden = #entries
		info.view = Panel.HEAD + 2
		return {}, Panel.HEAD + 2, 0, 0, info
	end
	for _, g in guides do
		if fold and g.kind == "side" then
			continue
		end
		if guided == 0 then
			table.insert(rows, { kind = "label", y = y, line = shown > 0 })
			y += LINE + 6
		else
			y += GAP - 2
		end
		guided += 1
		table.insert(rows, { kind = "guide", y = y, text = g.title, tone = g.kind, key = if g.kind ~= "level" then g.id else nil }) -- 레벨이 모자란 것은 아직 갈 데가 없다
		y += TITLE
		table.insert(rows, { kind = "where", y = y, text = g.line, tone = g.kind })
		y += LINE
	end
	if shown > 0 and guided == 0 then
		y -= GAP
	end
	local height = if shown + guided == 0 then Panel.HEAD + 2 else y + Panel.PAD
	local cap = maxH or Panel.H
	info.view = math.min(height, cap)
	info.scroll = height > cap
	return rows, height, shown, guided, info
end

return Panel

end
MODULES['ReplicatedStorage/shared/lune/ui/quick'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 퀵슬롯의 셈 — 화면 가운데 아래의 스킬 칸(여섯 x 두 줄). 그리지는 않는다: 화면(client/lune/hud.luau · boot.luau)과 서버(sim/hero.luau), 테스트가 같이 쓴다.
--  사용자 2026-10-07: "스킬키를 단축키에 등록하기 쉬워야합니다. … 드래그앤 드랍으로 배치도 되어야하고, 스킬탭에서 스킬아이콘을 꾹누르거나 클릭하면 퀵슬롯쪽이 반짝거리고 거기서 퀵슬롯을 누르면 배치된다던가"
--  키는 스킬이 아니라 칸에 붙는다(칸마다 키 하나). 칸에는 스킬의 이름표나 소비 아이템의 이름표("potion1" … — data/items.generated.luau의 GOODS)가 놓인다. 빈 칸은 false.
--   소비 아이템은 저마다 따로 놓는다(사용자 2026-10-08 — 가방의 진짜 아이템이다): 작은 달빛 물약과 큰 달빛 물약은 다른 칸. 칸의 숫자 = 가방에 든 그 아이템의 수.
--  값과 놓는 법은 공방 js/lune/design/ui.js의 QUICK · quickPlace · quickClear · quickStart(횡스크롤 시험 탭이 같은 셈으로 논다) — data/ui.generated.luau의 quick.
local UI = require(script.Parent.Parent.data["ui.generated"])
local ITEMS = require(script.Parent.Parent.data["items.generated"])

local GOODS = {}
for _, g in ITEMS.GOODS do
	GOODS[g.id] = g
end

local Q = {}
Q.DATA = UI.quick
Q.N = UI.quick.n -- 칸의 수
Q.COLS = UI.quick.cols -- 한 줄
Q.START_POTION = UI.quick.potion -- 새 캐릭터의 첫 칸에 놓이는 물약(작은 달빛 물약)
Q.OLD_POTION = "potion" -- 예전 저장의 물약 칸(물약이 한 가지였을 때의 이름표) — Q.renew가 지금의 이름표로 바꾼다

-- 칸에 놓인 것이 소비 아이템이면 그 자료(스킬이면 nil)
function Q.item(what: any)
	return if typeof(what) == "string" then GOODS[what] else nil
end

-- 칸에 놓인 것의 그림 이름(화면의 그림 24x24 — 공방의 아이콘 이름)
function Q.pic(what: string): string
	local g = GOODS[what]
	if g then
		return g.icon
	end
	return "skill_" .. what
end

-- 예전 저장의 칸들을 지금 꼴로: "potion" → potionId(그때 마시던 물약). 꼴이 다른 것은 그대로 돌려준다(Q.clean이 걸러 낸다)
function Q.renew(list: any, potionId: string): any
	if typeof(list) ~= "table" then
		return list
	end
	local out = table.clone(list)
	for k, v in out do
		if v == Q.OLD_POTION then
			out[k] = potionId
		end
	end
	return out
end

local function copy(slots)
	local out = table.create(Q.N, false)
	for i = 1, Q.N do
		out[i] = slots[i] or false
	end
	return out
end

local function find(slots, what): number?
	for i = 1, Q.N do
		if slots[i] == what then
			return i
		end
	end
	return nil
end
Q.find = find

-- 칸에 놓는다: what(스킬 · 소비 아이템의 이름표)을 j째 칸에. 이미 다른 칸에 있던 것이면 두 칸이 자리를 바꾼다.
--  창(스킬 창 · 가방)에서 온 것이면 그 칸에 있던 것은 빠진다. 새 칸들을 돌려준다(못 놓으면 nil)
function Q.place(slots, what: string, j: number)
	if typeof(what) ~= "string" or what == "" or j < 1 or j > Q.N or j % 1 ~= 0 then
		return nil
	end
	local out = copy(slots)
	local i = find(out, what)
	if i == j then
		return out
	end
	local old = out[j]
	out[j] = what
	if i then
		out[i] = old
	end
	return out
end

-- 칸에서 뺀다(소비 아이템도 빠진다 — 가방의 소비 탭에서 다시 끌어다 놓는다)
function Q.clear(slots, i: number)
	if i < 1 or i > Q.N then
		return nil
	end
	local out = copy(slots)
	out[i] = false
	return out
end

-- 새 캐릭터의 칸: start의 차례대로(물약 · 사냥기 · 보스기 · 이동기 — 스킬은 그 갈래의 첫 스킬). skills = { { id, type } … }
function Q.start(skills)
	local out = table.create(Q.N, false)
	for k, kind in UI.quick.start do
		if kind == "potion" then
			out[k] = Q.START_POTION
		else
			for _, s in skills do
				if s.type == kind then
					out[k] = s.id
					break
				end
			end
		end
	end
	return out
end

-- 스마트폰의 단추 배치. 단추가 있는 칸은 Q.TOUCH뿐이다(공방 basics.js의 TOUCH —
--  사용자 2026-10-13(폰에서 해 보고): "모바일에서 상호작용 버튼 아래에 있는 버튼 없애고" → 칸 1의 단추가 없어졌다. 칸 2 ~ 12의 열하나).
--  단추가 없는 칸에 놓인 것은 단추가 있는 첫 빈 칸으로 옮긴다(빈 칸이 없으면 뺀다) — 새 캐릭터의 물약은 칸 5로, 전에 칸 1에 놓아 둔 것도 들어올 때 옮겨진다.
--  공방 js/lune/design/ui.js의 quickTouchFix와 같은 셈(data/ui.generated.luau의 quick.touchCheck로 맞춰 본다)
Q.TOUCH = UI.quick.touch
local hasTouch = {}
for _, i in Q.TOUCH do
	hasTouch[i] = true
end
function Q.touchFix(slots)
	local out = copy(slots)
	for k = 1, Q.N do
		if not hasTouch[k] and out[k] then
			for _, j in Q.TOUCH do
				if not out[j] then
					out[j] = out[k]
					break
				end
			end
			out[k] = false
		end
	end
	return out
end
-- 새 캐릭터의 스마트폰 배치: 처음 차림(Q.start)에서 단추가 없는 칸의 것을 옮긴 것
function Q.touchStart(skills)
	return Q.touchFix(Q.start(skills))
end

-- 밖에서 온 칸들(클라이언트가 보낸 것 · 저장된 것)을 살핀다: 꼭 N칸, 칸마다 false · 놓아도 되는 것(ok(id)가 참 — 배운 스킬 · 소비 아이템), 겹치는 것 없이.
--  말이 되면 깨끗한 칸들을, 아니면 nil을 돌려준다
function Q.clean(list: any, ok: (string) -> boolean)
	if typeof(list) ~= "table" then
		return nil
	end
	local out = table.create(Q.N, false)
	local seen = {}
	for k in list do
		if typeof(k) ~= "number" or k < 1 or k > Q.N or k % 1 ~= 0 then
			return nil
		end
	end
	for i = 1, Q.N do
		local v = list[i]
		if v == nil or v == false then
			out[i] = false
		elseif typeof(v) == "string" and #v <= 40 and not seen[v] and ok(v) then
			seen[v] = true
			out[i] = v
		else
			return nil
		end
	end
	return out
end

-- 윗줄(둘째 줄)에 놓인 것이 있는가 — 있으면 윗줄도 늘 보인다
function Q.usesTop(slots): boolean
	for i = Q.COLS + 1, Q.N do
		if slots[i] then
			return true
		end
	end
	return false
end

return Q

end
MODULES['ReplicatedStorage/shared/lune/ui/sheet'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 장비 창의 능력치 표 — 줄 · 칸의 자리와 값의 글(화면 없이 셈한다: 창은 client/lune/ui/equipWindow.luau, 글이 칸에 드는지는 15_lune_items가 본다).
--  사용자 2026-10-14: "장비 탭에 지금 전투력, 방어력만 표기되는데 여기에 현재 스텟, 공격력 등 여러 수치가 다 출력되어야하고 크리티컬 확률, 크리티컬 데미지 이런것도 다 나와야합니다."
--  줄의 차례 · 이름은 공방 design/ui.js의 UILAYOUT.equip.sheet, 수는 서버가 셈한 내 상태의 sheet(sim/hero.luau의 Hero.sheet)와 능력치 · 전투력 · 최대 체력.
local root = script.Parent.Parent
local N = require(root.config.numbers)
local Layout = require(script.Parent.layout)
local Format = require(script.Parent.format)

local SH = Layout.EQUIP.sheet
local STATS = N.data.STATS

local Sheet = {}
Sheet.SH = SH

-- 칸들의 자리(오른쪽 덩이의 왼쪽 위가 0, 0 · 가르는 줄 바로 아래부터). width = 오른쪽 덩이의 폭. { id, x, y, w }의 목록
function Sheet.cells(width: number)
	local colW = math.floor((width - SH.colGap) / 2)
	local out = {}
	for r, row in SH.rows do
		local y = SH.top + (r - 1) * SH.row
		for c, id in row do
			if #row == 1 then
				table.insert(out, { id = id, x = 0, y = y, w = width })
			else
				table.insert(out, { id = id, x = (c - 1) * (colW + SH.colGap), y = y, w = colW })
			end
		end
	end
	return out
end

-- 표의 높이(가르는 줄 아래부터)
function Sheet.height(): number
	return SH.top + #SH.rows * SH.row
end

-- 칸의 이름
function Sheet.name(id: string): string
	return SH.names[id] or STATS.names[id] or id
end

-- 그 직업에게 그 능력치가 무엇인가: "main"(주) · "sub"(부) · "none"(안 쓴다). 능력치가 아니면 nil
function Sheet.tone(class: string, id: string): string?
	if STATS.names[id] == nil then
		return nil
	end
	local pair = STATS.classes[class]
	if id == "hp" then
		return "hp"
	end
	return if pair[1] == id then "main" elseif pair[2] == id then "sub" else "none"
end

-- 수의 글: 만 넘으면 짧게(「1.2만」) · 아니면 쉼표
local function num(n: number): string
	return if n >= 1e4 then Format.short(n) else Format.comma(n)
end
-- %의 수: 정수면 정수, 아니면 소수 한 자리
local function p(v: number): string
	local r = math.floor(v + 0.5)
	if math.abs(v - r) < 0.05 then
		return tostring(r)
	end
	return ("%.1f"):format(v)
end

-- 칸마다의 값 { [id] = 글 }. me = 서버가 보낸 내 상태(sheet · stats · power · maxHp · class)
function Sheet.values(me)
	local s = me.sheet
	local out = {}
	if not s then
		return out
	end
	out.atk = ("%s ~ %s"):format(num(s.atk[1]), num(s.atk[2])) -- 스탯 공격력
	out.power = Format.short(me.power)
	out.maxHp = num(me.maxHp)
	out.attack = num(s.attack or 0) -- 공격력(무기 x 공격력% — 2026-10-15)
	out.def = num(s.def or 0) -- 방어력(방어구의 합)
	for _, id in STATS.order do
		out[id] = tostring(if s.stats then s.stats[id] else STATS.base + (me.stats[id] or 0)) -- 처음 4 + 찍은 점수 + 장비의 올스탯
	end
	-- 두 칸짜리 줄의 %는 정수로(가장 작은 화면에서 칸이 78점 — 소수까지 적으면 넘친다)
	local function i(v: number): string
		return tostring(math.floor(v + 0.5))
	end
	out.guard = i(s.guard) .. "%"
	out.critRate = p(s.crit) .. "%" -- 크리티컬은 한 줄을 다 쓰니 소수 한 자리까지
	out.critDmg = p(s.critDmg) .. "%"
	out.dmg = "+" .. i(math.max(0, s.dmg)) .. "%"
	out.final = "+" .. i(math.max(0, s.final)) .. "%"
	out.haste = "+" .. i(math.max(0, s.haste)) .. "%"
	out.cut = i(math.max(0, s.cut)) .. "%" -- 받는 피해 감소(방어력 · 버프 · 패시브 — 2026-10-15: 「받는 피해 -n%」에서 「받는 피해 감소 n%」로)
	out.run = i(s.run) .. "%"
	out.jump = i(s.jump) .. "%"
	return out
end

return Sheet

end
MODULES['ReplicatedStorage/shared/lune/ui/skillDamage'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 스킬 창의 「지금 Lv.n · 다음 Lv.n+1」에 적는 공격 스킬의 % 피해.
--  사용자 2026-10-13: "스킬 퍼뎀같은거 스킬 창에 설명에 나와있어야해  메이플처럼 / 스킬레벨 추가로 찍으면 퍼뎀올라가는것도 보여야하고"
--  % = 스탯 공격력에 곱하는 값 x 100(한 대상에게 다 맞혔을 때 · 그 스킬 레벨의 세기를 곱한 것) — 서버가 피해를 셈하는 바로 그 값이다:
--    화면에 뜨는 피해 숫자 = 스탯 공격력 x % x dmgScale(1 — 2026-10-15에 전투력 x % x 10에서 바꿨다). 사냥기를 일반 몬스터에게 · 보스기를 보스에게 쓰면 거기에 +targetBonus%(설명 칸의 민트색 줄). 버프 · 패시브 · 치명타는 그 위에 곱해진다.
--  1차의 사냥기 · 보스기: 타마다의 배수(data/combat.generated.luau의 skills[스킬].hits[].mul) x 스킬 레벨의 세기(Hero.skillScale).
--    글은 공방이 만들어 kitEffects에 실어 보낸다(design/combat.js의 damageText — 공방의 시험 탭과 같은 글). 여기의 firstText는 같은 글을 게임의 수로 다시 만든 것이다(테스트가 둘을 맞춰 본다).
--  2~4차의 쓰는 스킬: 서버가 그 스킬을 빈 방에서 돌려 잰 값(Caster.profile — 쓰는 시간 · 맞는 횟수)으로 셈한다.
--    한 번 다 맞혔을 때 = rate x (쓰는 시간 + cdTime) x 스킬 레벨의 세기(Caster.scale). 타마다의 몫은 스킬의 코드가 정하므로 합과 횟수만 적는다.
--    one = 한 타 · sum = 여러 타(횟수가 늘 같다) · avg = 쓸 때마다 다르다(다섯 번째마다 터지는 것 …) · full = 장치를 다 갖췄을 때가 기준(공명 폭발의 수정 · 열 방출의 열기 — 자료의 w)
--  끝에 그 스킬을 한 번 쓰는 데 드는 시간을 붙인다(dmgWords.time — 바로 나가는 스킬은 빼고): %는 「한 번 쓸 때」의 것이라 빠른 스킬은 %가 작아도 같은 시간에 더 넣는다
--    (2차의 쪼개기 Lv.1 = 199% · 0.5초 / 1차의 삼단 베기 마스터 = 410% · 1.2초 — %만 적으면 2차가 약해 보인다).
--  글의 꼴은 공방의 것(combat.generated.luau의 dmgWords).
local root = script.Parent.Parent
local COMBAT = require(root.data["combat.generated"])
local Hero = require(root.sim.hero)
local Caster = require(root.sim.caster)
local Lines = require(root.sim.lines) -- 타수 나누기: 한 타를 몇 줄로(2026-10-14)
local Format = require(script.Parent.format)

local WORDS = COMBAT.dmgWords
local SkillDamage = {}

local function round(v: number): number
	return math.floor(v + 0.5)
end
-- 쓰는 시간을 붙인다(소수 한 자리 — 공방 design/combat.js의 dmgTime과 같은 법). 0이면 그대로
local function withTime(text: string, t: number): string
	if t <= 0 then
		return text
	end
	return text .. Format.fill(WORDS.time, { t = ("%.1f"):format(math.floor(t * 10 + 0.5) / 10) })
end

-- 1차의 사냥기 · 보스기: 그 레벨에서 타마다의 % { { pct, side } … }. side = 가운데 타의 범위 밖의 적만 맞는 타(대지 강타의 양옆 가시). 아니면 nil
function SkillDamage.firstParts(id: string, lv: number)
	local def = COMBAT.skills[id]
	if not def or def.job ~= 1 or #def.hits == 0 or lv < 1 or lv > def.max then
		return nil
	end
	local s = Hero.skillScale(lv, def.max)
	local out = {}
	for i, h in def.hits do
		out[i] = { pct = h.mul * s * 100, side = h.except ~= nil and h.except ~= false }
	end
	return out
end

function SkillDamage.firstText(id: string, lv: number): string?
	local parts = SkillDamage.firstParts(id, lv)
	if not parts then
		return nil
	end
	local main, sum, same = {}, 0, true
	for _, p in parts do
		if not p.side then
			table.insert(main, p)
			sum += p.pct
		end
	end
	for _, p in main do
		if round(p.pct) ~= round(main[1].pct) then
			same = false
		end
	end
	-- 타수 나누기(sim/lines.luau): 한 타가 L줄로 쪼개진다 — 모두의 줄 수와 합을 적는다(줄마다의 %는 반올림하면 한 레벨 올린 것이 묻혀서 합으로. 공방 design/combat.js의 damageText와 같은 글)
	local L = Lines.first(id)
	local n = #main * L
	local out
	if n == 1 then
		out = Format.fill(WORDS.one, { pct = round(sum) })
	elseif L > 1 then
		out = Format.fill(WORDS.sum, { n = n, pct = round(sum) })
	elseif same then
		out = Format.fill(WORDS.same, { pct = round(main[1].pct), n = #main })
	else
		local list = {}
		for i, p in main do
			list[i] = ("%d%%"):format(round(p.pct))
		end
		out = Format.fill(WORDS.split, { n = #main, pct = round(sum), list = table.concat(list, " + ") })
	end
	for _, p in parts do
		if p.side then
			out ..= Format.fill(WORDS.side, { pct = round(p.pct) })
		end
	end
	return withTime(out, COMBAT.skills[id].time)
end

-- 2~4차의 쓰는 스킬: 그 레벨에서 한 번 다 맞혔을 때의 % · 맞는 횟수 · 글의 꼴 { pct, n, kind }. 피해가 없는 것(묶기만 하는 것 · 회복)은 nil
function SkillDamage.cast(id: string, lv: number)
	local def = COMBAT.cast[id]
	if not def or lv < 1 or lv > def.max then
		return nil
	end
	-- 재다가 탈이 나도 스킬 창은 멈추지 않는다(그 스킬의 %만 비운다 — 테스트는 %가 있는지를 본다)
	local ok, p = pcall(function()
		if not Caster.makeDry then
			require(root.sim.room) -- 재 볼 빈 방을 짓는 함수는 방의 셈이 넣어 준다(sim/room.luau) — 화면에서는 여기서 처음 불러온다
		end
		return Caster.profile(id, 0)
	end)
	if not ok or not p then
		return nil
	end
	local pct = def.rate * (p.time + def.cdTime) * Caster.scale(lv, def.max) * 100
	if pct < 0.5 or p.measured <= 0 then
		return nil
	end
	local L = Caster.lines(id) -- 타수 나누기: 한 타를 L줄로 — 적는 횟수는 줄의 수
	local n = round(p.hits) * L
	local kind = if def.w then "full" elseif math.abs(p.hits - round(p.hits)) > 0.01 then "avg" elseif n <= 1 then "one" else "sum"
	return { pct = pct, n = n, kind = kind, time = p.time, lines = L }
end

function SkillDamage.castText(id: string, lv: number): string?
	local c = SkillDamage.cast(id, lv)
	if not c then
		return nil
	end
	return withTime(Format.fill(WORDS[c.kind], { pct = round(c.pct), n = c.n }), c.time)
end

-- 스킬 창이 그 레벨에 적는 글: 공방이 실어 보낸 효과 글(사출기 · 장치 · 패시브 · 버프 · 1차 공격 스킬의 % 피해)이 있으면 그것, 없으면 2~4차의 쓰는 스킬의 % 피해. 적을 것이 없으면 nil
function SkillDamage.text(id: string, lv: number): string?
	local list = COMBAT.kitEffects[id]
	if list then
		return list[lv]
	end
	return SkillDamage.castText(id, lv)
end

return SkillDamage

end
MODULES['ReplicatedStorage/shared/lune/ui/starText'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 장비의 별(스타포스)을 글로 — 이름 위에 별 그림으로 적는다(2026-10-15).
--  사용자: "강화 표기 방법도 잘못됬는데 아이템 이름 옆에 +1 이렇게 되는게 아니라 아이템 이름 위에 별이 표기되는겁니다. 별 개수에 맞춰서 1강당 별 1개"
--  메이플스토리의 툴팁처럼: 한 줄에 15개(다섯마다 한 칸 띄운다) · 붙은 별은 노랑, 아직 안 붙은 별(최대 22까지)은 흐리게. 게임의 글꼴에 「★」가 있다(공방 tools/import_bdf_font.mjs의 EXTRA).
--  화면 없이 셈하는 부분만 여기에 둔다 — 그리는 것은 client/lune/ui/ui.luau의 Ui.stars, 공방은 js/lune/ui/paint.js의 starRows가 같은 셈을 한다.
local StarText = {}

StarText.PER = 15 -- 한 줄의 별
StarText.GROUP = 5 -- 다섯마다 한 칸 띄운다
StarText.STAR = "★"

-- 줄마다 { on = 붙은 별의 글, off = 안 붙은 별의 글 } — n = 붙은 별 · max = 최대(22). 별이 하나도 없는 장비도 빈 별을 보인다(메이플처럼 — 얼마나 더 붙일 수 있는지 보인다)
function StarText.rows(n: number, max: number): { { on: string, off: string } }
	local out = {}
	local k = 0
	while k < max do
		local on, off = {}, {}
		for i = 1, math.min(StarText.PER, max - k) do
			local idx = k + i
			local piece = StarText.STAR
			if i > 1 and (i - 1) % StarText.GROUP == 0 then
				piece = " " .. piece
			end
			if idx <= n then
				table.insert(on, piece)
			else
				table.insert(off, piece)
			end
		end
		table.insert(out, { on = table.concat(on), off = table.concat(off) })
		k += StarText.PER
	end
	return out
end

return StarText

end
MODULES['ReplicatedStorage/shared/lune/ui/tags'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 이름표와 채팅 줄의 셈(그리지는 않는다). 테스트 14가 본다.
local T = {}

-- 이름표가 겹칠 때: 아무것도 옮기지 않는다 — 이름은 늘 제 주인의 발밑 그 자리에 있다.
--  사용자 2026-10-07: "닉네임이 npc랑 지나갈때 npc이름 아래로 낑겨버리는데 … 이건 말도 안되는 상황입니다" → 겹치면 밀어서 쌓던 것(stack)을 없앴다.
--  list = 앞선 차례대로(내 것 → 다른 사람 → 주민 · 문 → 졸개) { x(왼쪽), y(위), w(폭) }. h = 한 줄의 높이 · gap = 옆으로 이만큼보다 가까우면 겹친 것으로 본다.
--  앞선 것이 보이고, 그것과 겹치는 뒤의 것은 겹치는 동안 숨는다(글씨끼리 포개져 못 읽게 되지 않게). 돌려주는 것 = 보이는가의 차례표.
--  공방의 횡스크롤 시험 탭(js/lune/ui/paint.js의 tagsVisible)과 같은 셈이다.
function T.visible(list, h: number, gap: number?): { boolean }
	local near = gap or 4
	local shown = {}
	local out = {}
	for i, t in list do
		local hit = false
		for _, q in shown do
			if t.x < q.x + q.w + near and q.x < t.x + t.w + near and math.abs(q.y - t.y) < h then
				hit = true
				break
			end
		end
		if not hit then
			table.insert(shown, t)
		end
		out[i] = not hit
	end
	return out
end

return T

end
MODULES['ReplicatedStorage/shared/lune/ui/worldmap'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 월드맵의 셈 — 화면을 모르는 셈이다(그리는 것은 client/lune/ui/mapWindow.luau · 자동 검사가 그대로 부른다).
--  메이플스토리의 월드맵 · 길라잡이처럼: 그 지역의 맵들이 길로 이어진 그림에서 ① 내가 있는 곳 ② 맵마다의 레벨과 몬스터 ③ 퀘스트를 받을 곳(!) · 돌려줄 곳(?) ④ 내 레벨에 맞는 사냥터를 알려 준다.
--  자료는 data/worldmap.generated.luau(공방 js/lune/design/journey.js의 그림) · 맵의 몬스터와 주민은 data/scenes.generated.luau.
local D = require(script.Parent.Parent.data["worldmap.generated"])
local SCENES = require(script.Parent.Parent.data["scenes.generated"])
local COMBAT = require(script.Parent.Parent.data["combat.generated"])
local Quests = require(script.Parent.Parent.sim.quests)
local Navi = require(script.Parent.navi) -- 퀘스트 길찾기(켠 퀘스트가 있으면 「가는 길」이 그것을 따른다)
local Voyage = require(script.Parent.Parent.sim.voyage) -- 배(초승달 마을 ↔ 은달 항구 — 2026-10-16)

-- 그 장면에서 한 걸음에 닿는 곳: 문들 + 배(선장에게 말을 걸면 닿는 곳 · 갑판 위면 닿는 곳 — 문이 아니라 { to, ship = true }).
--  사용자 2026-10-16 "왜 대도시로 넘어갈때 배타는건 구현을 안합니까 왜 그냥 포탈이에요" — 마을 ↔ 항구는 문이 없다. 지도의 길 · 이어지는 곳은 배도 길로 친다
local function hopsOf(key: string)
	local out = table.clone(SCENES.scenes[key].portals or {})
	for _, r in Voyage.routesFrom(key) do
		table.insert(out, { to = r.to, ship = true, need = r.need })
	end
	local onShip = Voyage.onShip(key)
	if onShip then
		table.insert(out, { to = onShip.to, ship = true })
	end
	return out
end

local WM = {}
WM.data = D
WM.order = D.order
-- 그림으로 된 지도(client/lune/ui/mapWindow.luau): 그림의 크기 · 오른쪽 글 칸의 폭과 줄 수
WM.ART_W, WM.ART_H = D.artSize.w, D.artSize.h
WM.SIDE_W = 190
WM.SIDE = { mobLines = 2, npcLines = 2, routeLines = 2 }
WM.PIN = { town = 5, village = 5, rest = 4, hunt = 4, road = 3, climb = 4, dead = 3, boss = 4, out = 5 } -- 표시의 반지름(가운데에서 가장자리까지 — 점). out = 다른 지역
WM.PLATE = { padX = 4, h = 14, gap = 3 } -- 이름표: 글의 양옆 여백 · 높이 · 표시와의 사이

-- 그림이 있는 지역들(탭의 차례) — 그림이 없는 지역은 월드맵에 나오지 않는다
function WM.arted(): { string }
	local out = {}
	for _, rid in D.order do
		if D.regions[rid].art then
			table.insert(out, rid)
		end
	end
	return out
end

-- 마디를 이름표로 찾는 표: [지역][마디] = 마디
local byId = {}
for rid, region in D.regions do
	byId[rid] = {}
	for i, n in region.nodes do
		byId[rid][n.id] = n
		n.order = i
	end
end

function WM.region(rid: any)
	return if typeof(rid) == "string" then D.regions[rid] else nil
end

function WM.node(rid: string, id: string)
	return byId[rid] and byId[rid][id]
end

-- 그 장면이 어느 지역의 어느 마디인가. 마디에 없는 장면(가게 · 사당 같은 실내 · 숨은 방)은 문을 따라 가장 가까운 마디다. 못 찾으면 nil
local nodeCache = {}
function WM.nodeOf(sceneKey: any): (string?, string?)
	if typeof(sceneKey) ~= "string" or not SCENES.scenes[sceneKey] then
		return nil, nil
	end
	sceneKey = string.match(sceneKey, "^(.-)#%d+$") or sceneKey -- 토벌의 방(rf1#3) = 그 장면(rf1) — 캐시가 방마다 쌓이지 않게(2026-10-16)
	local hit = nodeCache[sceneKey]
	if hit ~= nil then
		if hit == false then
			return nil, nil
		end
		return hit.region, hit.node
	end
	local seen = { [sceneKey] = true }
	local queue, at = { sceneKey }, 1
	local found = nil
	while queue[at] do
		local key = queue[at]
		at += 1
		if D.sceneNode[key] then
			found = D.sceneNode[key]
			break
		end
		-- 퀘스트를 받아야 열리는 문(need — 달의 사당 안의 「사당 지하」)은 늘 열린 문 다음에 따라간다: 사당 안은 지하가 아니라 마을의 마디다
		local next, gated = {}, {}
		for _, p in hopsOf(key) do
			if SCENES.scenes[p.to] and not seen[p.to] then
				seen[p.to] = true
				table.insert(if p.need or p.done then gated else next, p.to)
			end
		end
		table.sort(next) -- 차례가 늘 같게
		table.sort(gated)
		for _, k in next do
			table.insert(queue, k)
		end
		for _, k in gated do
			table.insert(queue, k)
		end
	end
	nodeCache[sceneKey] = found or false
	if found then
		return found.region, found.node
	end
	return nil, nil
end

-- 그 마디의 몬스터 레벨(가장 낮은 · 가장 높은). 몬스터가 없으면 nil
function WM.levels(node): (number?, number?)
	local lo, hi = nil, nil
	for _, key in node.scenes do
		for _, m in SCENES.scenes[key].mobs or {} do
			lo = if lo then math.min(lo, m.lv) else m.lv
			hi = if hi then math.max(hi, m.lv) else m.lv
		end
	end
	return lo, hi
end

-- 「Lv.14~15」 · 한 레벨이면 「Lv.9」 · 몬스터가 없으면 빈 글
function WM.levelText(node): string
	local lo, hi = WM.levels(node)
	if not lo then
		return ""
	end
	return if lo == hi then ("Lv.%d"):format(lo) else ("Lv.%d~%d"):format(lo, hi :: number)
end

-- 그 마디에 나오는 몬스터의 이름들(겹치지 않게, 맵의 차례대로)
function WM.mobNames(node): { string }
	local out, seen = {}, {}
	for _, key in node.scenes do
		for _, m in SCENES.scenes[key].mobs or {} do
			local def = COMBAT.mobs[m.kind]
			local name = if def then def.name else m.kind
			if not seen[name] then
				seen[name] = true
				table.insert(out, name)
			end
		end
	end
	return out
end

-- 그 지역의 마디마다 서 있는 주민: [마디] = { [주민 id] = 이름 } — 실내의 주민은 그 건물이 선 마디에 든다
local npcCache = {}
function WM.npcs(rid: string)
	if npcCache[rid] then
		return npcCache[rid]
	end
	local out = {}
	for key, sc in SCENES.scenes do
		if sc.npcs and #sc.npcs > 0 then
			local r, id = WM.nodeOf(key)
			if r == rid and id then
				out[id] = out[id] or {}
				for _, n in sc.npcs do
					if not n.stone then -- 비석(명예의 전당)은 주민이 아니다
						out[id][n.id] = n.name
					end
				end
			end
		end
	end
	npcCache[rid] = out
	return out
end

-- 그 마디의 주민 이름들(가나다 차례)
function WM.npcNames(rid: string, nodeId: string): { string }
	local out = {}
	for _, name in WM.npcs(rid)[nodeId] or {} do
		table.insert(out, name)
	end
	table.sort(out)
	return out
end

-- 퀘스트의 표시: [마디] = "?"(돌려줄 것이 있다) · "!"(받을 것이 있다). 그 지역의 마디만.
--  돌려줄 것 = 다 한 퀘스트를 돌려받는 주민이 선 마디 · 받을 것 = 지금 받을 수 있는 퀘스트를 주는 주민이 선 마디(그 퀘스트를 하는 맵에서 가장 가까운 곳)
function WM.marks(rid: string, book, level: number): { [string]: string }
	local out = {}
	local npcs = WM.npcs(rid)
	for _, def in Quests.list do
		local state = Quests.state(book, level, def.id)
		if state == "ready" then
			for nodeId, set in npcs do
				if set[def.endNpc] then
					out[nodeId] = "?"
				end
			end
		elseif state == "open" and not def.auto then
			local key = Quests.giverScene(def)
			local r, nodeId = WM.nodeOf(key)
			if r == rid and nodeId and out[nodeId] ~= "?" then
				out[nodeId] = "!"
			end
		end
	end
	return out
end

-- 내 레벨에 맞는 사냥터(그 지역에서): 몬스터의 가장 낮은 레벨이 내 레벨을 넘지 않는 마디 가운데 그 레벨이 가장 높은 것 — 같으면 그림의 차례가 앞선 것.
--  모두 내 레벨보다 높으면 가장 낮은 마디. 사냥터가 없는 지역이면 nil
function WM.recommend(rid: string, level: number): string?
	local region = D.regions[rid]
	if not region then
		return nil
	end
	local best, bestLo, lowest, lowestLo = nil, -1, nil, math.huge
	for _, n in region.nodes do
		local lo = WM.levels(n)
		-- 이야기의 방(사당 지하 — 그 퀘스트를 하는 동안에만 병사가 나온다)은 사냥터로 권하지 않는다
		local story = false
		for _, key in n.scenes do
			story = story or SCENES.scenes[key].story == true
		end
		if lo and not story then
			if lo <= level and lo > bestLo then
				best, bestLo = n.id, lo
			end
			if lo < lowestLo then
				lowest, lowestLo = n.id, lo
			end
		end
	end
	return best or lowest
end

-- ---------- 다른 지역으로 이어지는 곳 ----------
-- 그 지역의 마디에서 문 하나로 다른 지역의 마디에 닿는 것들: { { node, to(지역), toNode } … } — 그림의 차례, 같은 마디면 탭의 차례.
--  예: 초승 고개의 수비대 야영지 → 은달 항구(성문 거리) · 은달 항구의 부두 → 수정 숲(반달 나루) · 물마루 바다(물마루 마을)
local exitCache = {}
function WM.exits(rid: string)
	if exitCache[rid] then
		return exitCache[rid]
	end
	local out, seen, rank = {}, {}, {}
	for i, id in D.order do
		rank[id] = i
	end
	local region = D.regions[rid]
	for _, n in (if region then region.nodes else {}) do
		for _, key in n.scenes do
			for _, p in hopsOf(key) do
				local to = D.sceneNode[p.to]
				if to and to.region ~= rid and not seen[n.id .. ">" .. to.region] then
					seen[n.id .. ">" .. to.region] = true
					table.insert(out, { node = n.id, to = to.region, toNode = to.node })
				end
			end
		end
	end
	table.sort(out, function(a, b)
		local na, nb = byId[rid][a.node].order, byId[rid][b.node].order
		if na ~= nb then
			return na < nb
		end
		return rank[a.to] < rank[b.to]
	end)
	exitCache[rid] = out
	return out
end

-- 그 마디에서 이어지는 다른 지역들(없으면 빈 표)
function WM.exitsOf(rid: string, nodeId: string)
	local out = {}
	for _, ex in WM.exits(rid) do
		if ex.node == nodeId then
			table.insert(out, ex)
		end
	end
	return out
end

-- 마디 아래에 적는 줄들(그림): 짧은 이름 · 몬스터의 레벨(있으면) · 이어지는 지역마다 「→ 은달 항구」. { { text, kind = "name" | "level" | "exit", exit? } … }
WM.ROWS_MAX = 5 -- 마디 아래에 적는 줄의 끝(이름 + 이어지는 지역 넷 — 은달 항구 한 장: 초승 고개(배) · 수정 숲 · 땅속 화롯골(비행선) · 물마루 바다. 2026-10-13에 셋 → 넷, 2026-10-16 도시를 한 장으로 합쳐 넷 → 다섯)
function WM.rows(rid: string, node)
	local rows = { { text = node.label, kind = "name" } }
	local lv = WM.levelText(node)
	if lv ~= "" then
		table.insert(rows, { text = lv, kind = "level" })
	end
	for _, ex in WM.exitsOf(rid, node.id) do
		table.insert(rows, { text = "→ " .. D.regions[ex.to].name, kind = "exit", exit = ex })
	end
	return rows
end

-- ---------- 가는 길 ----------
-- 장면에서 장면까지 문을 가장 적게 지나는 길(장면의 이름표들 — 처음과 끝을 넣어). 같은 수면 문이 놓인 차례가 앞선 쪽. 닿지 않으면 nil
function WM.path(from: any, to: any): { string }?
	if typeof(from) ~= "string" or typeof(to) ~= "string" or not SCENES.scenes[from] or not SCENES.scenes[to] then
		return nil
	end
	local prev = { [from] = from }
	local queue, at = { from }, 1
	while queue[at] and not prev[to] do
		local key = queue[at]
		at += 1
		for _, p in hopsOf(key) do
			if SCENES.scenes[p.to] and not prev[p.to] then
				prev[p.to] = key
				table.insert(queue, p.to)
			end
		end
	end
	if not prev[to] then
		return nil
	end
	local out = { to }
	while out[1] ~= from do
		table.insert(out, 1, prev[out[1]])
	end
	return out
end

-- 그 길이 지나는 마디들: { { region, node } … } — 이어서 같은 마디는 한 번만(실내 · 여러 층은 한 마디다). 닿지 않으면 nil
function WM.route(from: any, to: any)
	local path = WM.path(from, to)
	if not path then
		return nil
	end
	local out = {}
	for _, key in path do
		local r, n = WM.nodeOf(key)
		local last = out[#out]
		if r and n and (not last or last.region ~= r or last.node ~= n) then
			table.insert(out, { region = r, node = n })
		end
	end
	return out
end

-- 가는 길의 글: 지금 있는 마디의 다음부터 끝까지의 이름을 「→」로 잇는다 — 「성문 거리 → 달맞이 광장 → … → 부두 → 반달 나루」.
--  네 곳을 넘으면 앞의 하나 · … · 뒤의 둘만(오른쪽 글 칸의 두 줄에 들어가게 — 길 자체는 그림 위의 금빛 점줄이 보여 준다). 이미 그 마디에 있으면 빈 글
WM.ROUTE_MAX = 4
function WM.routeText(route): string
	if not route then
		return ""
	end
	local names = {}
	for i = 2, #route do
		local n = WM.node(route[i].region, route[i].node)
		table.insert(names, n.label)
	end
	if #names > WM.ROUTE_MAX then
		names = { names[1], "…", names[#names - 1], names[#names] }
	end
	return table.concat(names, " → ")
end

-- 지금 가야 할 곳의 한 줄(월드맵의 맨 아래 줄): 「「고갯길」 받으러 가는 길: 달그림자 사냥터 → 세 갈래 길 → …」 · 그 맵에 이미 있으면 「「고갯길」 — 지금 있는 맵에서 받는다」.
--  돌려주는 것: 글, 길(마디들 — 그림이 그 길을 금빛으로 칠한다), 갈 곳(goal). 갈 곳이 없으면 빈 글과 nil
local GOAL_WORD = { ["do"] = "하러", back = "돌려주러", take = "받으러" }
local GOAL_HERE = { ["do"] = "한다", back = "돌려준다", take = "받는다" }
function WM.goalText(goal, sceneKey: any): (string, any)
	local route = WM.route(sceneKey, goal.scene)
	if not route or #route == 0 then
		return "", nil
	end
	if #route == 1 then
		return ("「%s」 — 지금 있는 맵에서 %s"):format(goal.def.name, GOAL_HERE[goal.kind]), route
	end
	return ("「%s」 %s 가는 길: %s"):format(goal.def.name, GOAL_WORD[goal.kind], WM.routeText(route)), route
end
function WM.goalLine(book, level: number, sceneKey: any): (string, any, any)
	local goal = Quests.goal(book, level)
	if not goal then
		return "", nil, nil
	end
	local text, route = WM.goalText(goal, sceneKey)
	return text, route, goal
end

-- 내 레벨에 맞는 사냥터의 한 줄(월드맵의 셋째 줄). 돌려주는 것: 글, 그 마디(이름을 풀빛으로 칠한다 — 권할 것이 없으면 nil)
--  그 지역의 사냥터가 모두 내 레벨보다 높으면 권하지 않고 「이 지역의 사냥터는 Lv.47부터(갯바위 해변)」라고만 적는다. 사냥터가 없는 지역(은달 항구)이면 빈 글
function WM.recommendLine(rid: string, level: number): (string, string?)
	local id = WM.recommend(rid, level)
	local n = id and WM.node(rid, id)
	if not n then
		return "", nil
	end
	local lo = WM.levels(n)
	if lo and lo > level then
		return ("이 지역의 사냥터는 Lv.%d부터(%s)"):format(lo, n.name), nil
	end
	return ("Lv.%d에 맞는 사냥터: %s(%s)"):format(level, n.name, WM.levelText(n)), id
end

-- 내 레벨에 맞는 사냥터를 오른쪽 글 칸의 한 줄로: 「굽잇길 Lv.14~15」 — 그 지역이 모두 내 레벨보다 높으면 「Lv.47부터(갯바위 해변)」. 돌려주는 것: 글, 그 마디(권할 것이 없으면 nil)
function WM.recommendShort(rid: string, level: number): (string, string?)
	local id = WM.recommend(rid, level)
	local n = id and WM.node(rid, id)
	if not n then
		return "", nil
	end
	local lo = WM.levels(n)
	if lo and lo > level then
		return ("Lv.%d부터(%s)"):format(lo, n.label), nil
	end
	return ("%s %s"):format(n.label, WM.levelText(n)), id
end

-- 그 지역의 몬스터 레벨의 폭(「Lv.1~26」 — 오른쪽 글 칸의 머리줄). 몬스터가 없으면 빈 글
function WM.regionLevels(rid: string): string
	local lo, hi = nil, nil
	for _, n in D.regions[rid].nodes do
		local a, b = WM.levels(n)
		if a then
			lo = if lo then math.min(lo, a) else a
			hi = if hi then math.max(hi, b :: number) else b
		end
	end
	return if lo then ("Lv.%d~%d"):format(lo, hi :: number) else ""
end

-- 장소 하나를 고르면 오른쪽 글 칸에 적는 것: { name(이름), sub(「사냥터 · Lv.14~15」), mobs(「폭탄병 · 바위 산양」), npcs(「주모 달래 · 반달」) }
-- 사람 이름들을 한 줄의 글로 — cap명이 넘으면 앞의 cap명과 「외 n명」(큰 도시 — 은달 항구는 건물 안까지 스물 남짓)
WM.CARD_PEOPLE = 9 -- 오른쪽 글 칸(두 줄 · 190점)에 적는 사람의 수
function WM.peopleLine(names: { string }, cap: number): string
	if #names <= cap then
		return table.concat(names, " · ")
	end
	return table.concat(table.move(names, 1, cap, 1, {}), " · ") .. (" 외 %d명"):format(#names - cap)
end
function WM.card(rid: string, nodeId: string)
	local n = WM.node(rid, nodeId)
	if not n then
		return { name = "", sub = "", link = "", mobs = "", npcs = "" }
	end
	local lv = WM.levelText(n)
	local kind = D.kinds[n.kind] or n.kind
	return {
		name = n.name,
		sub = if lv ~= "" then ("%s · %s"):format(kind, lv) else kind,
		link = WM.linkText(rid, nodeId),
		mobs = table.concat(WM.mobNames(n), " · "),
		npcs = WM.peopleLine(WM.npcNames(rid, nodeId), WM.CARD_PEOPLE),
	}
end

-- 그 장소에서 다른 지역으로 가는 문이 있으면 한 줄: 「은달 항구로 가는 포탈이 있다」(없으면 빈 글)
function WM.linkText(rid: string, nodeId: string): string
	local names = {}
	for _, ex in WM.exitsOf(rid, nodeId) do
		table.insert(names, D.regions[ex.to].name)
	end
	return if #names > 0 then ("%s로 가는 포탈이 있다"):format(table.concat(names, " · ")) else ""
end

-- 그림 위의 다른 지역(은달 항구)을 골랐을 때 오른쪽 글 칸에 적는 것: { name, sub(「다른 지역」), link(「수비대 야영지의 포탈로 간다」), mobs = "", npcs = "" }
function WM.outCard(rid: string, to: string)
	local from = {}
	for _, ex in WM.exits(rid) do
		if ex.to == to then
			table.insert(from, WM.node(rid, ex.node).label)
		end
	end
	return {
		name = D.regions[to].name,
		sub = "다른 지역",
		link = if #from > 0 then ("%s의 포탈로 간다"):format(table.concat(from, " · ")) else "",
		mobs = "",
		npcs = "",
	}
end

-- 이름표를 놓는다(화면을 모르는 셈 — 그림 위에서 서로, 그리고 표시와 겹치지 않게): 차례대로 아래 → 위 → 오른쪽 → 왼쪽을 대 보고 처음 맞는 자리에.
--  items = { { id, x, y, r(표시의 반지름), w(글의 폭) } … }(앞선 것이 먼저 자리를 잡는다). 돌려주는 것: [id] = { x, y, w, h }(놓을 자리가 없으면 그 이름은 빠진다)
--  lines = 가리지 말아야 할 점줄들({ { x1, y1, x2, y2 } … } — 포탈로 이어진 두 곳 사이): 그 점을 가장 적게 가리는 자리를 고른다(같으면 앞선 자리)
-- 점줄의 점들: 표시에서 표시로 곧게, 다섯 점마다 한 점(지도 창이 이대로 그린다)
function WM.linkDots(ax: number, ay: number, bx: number, by: number)
	local dx, dy = bx - ax, by - ay
	local n = math.max(1, math.floor(math.sqrt(dx * dx + dy * dy) / 5))
	local out = {}
	for k = 1, n - 1 do
		table.insert(out, { math.floor(ax + dx * k / n) - 1, math.floor(ay + dy * k / n) - 1 })
	end
	return out
end

-- 그 지역의 이어진 줄들(지도 창과 이름표 놓기가 함께 쓴다): 장소끼리 + 다른 지역으로 나가는 줄
function WM.lines(rid: string)
	local region = D.regions[rid]
	local A = region and region.art
	local out = {}
	if not (region and A) then
		return out
	end
	for _, link in region.links do
		local a, b = A.at[link[1]], A.at[link[2]]
		if a and b then
			table.insert(out, { a[1], a[2], b[1], b[2], link[1], link[2] })
		end
	end
	for _, ex in WM.exits(rid) do
		local a, b = A.at[ex.node], A.out and A.out[ex.to]
		if a and b then
			table.insert(out, { a[1], a[2], b[1], b[2], ex.node, "out:" .. ex.to })
		end
	end
	return out
end

WM.PLACE = { amb = 4, drop = 100, budget = 20000, depth = 2 } -- 남의 표시에 더 가까운 자리의 값 · 못 놓은 이름의 값 · 되돌아가며 대 보는 횟수의 끝
function WM.placeLabels(items, lines)
	local P, K = WM.PLATE, WM.PLACE
	local dotsAll = {}
	for _, l in lines or {} do
		for _, d in WM.linkDots(l[1], l[2], l[3], l[4]) do
			table.insert(dotsAll, d)
		end
	end
	local function covered(x: number, y: number, w: number, h: number): number
		local n = 0
		for _, d in dotsAll do
			if d[1] + 2 > x and d[1] < x + w and d[2] + 2 > y and d[2] < y + h then
				n += 1
			end
		end
		return n
	end
	-- 네모에서 표시의 가장자리까지
	local function gapTo(x: number, y: number, w: number, h: number, pin): number
		local dx = math.max(x - pin.x, 0, pin.x - (x + w))
		local dy = math.max(y - pin.y, 0, pin.y - (y + h))
		return math.sqrt(dx * dx + dy * dy) - pin.r
	end
	-- ① 이름마다 놓을 수 있는 자리들과 그 값(다른 이름표와는 상관없는 것): 그림 안 · 표시를 가리지 않음 · 가린 점의 수 + 남의 표시에 더 가까우면 amb
	local cands = {}
	for n, it in items do
		local w, h = it.w + P.padX * 2, P.h
		local cx = it.x - math.floor(w / 2)
		-- 대 보는 자리의 차례: 바로 아래 · 바로 위(가운데 → 오른쪽으로 · 왼쪽으로 반씩 민 것) → 오른쪽 · 왼쪽(가운데 → 아래로 · 위로 민 것) → 한 줄 더 떨어진 아래 · 위
		local below, above = it.y + it.r + P.gap, it.y - it.r - P.gap - h
		local half, quarter = math.floor(w / 2) - it.r, math.floor(w / 4)
		local right, left = it.x + it.r + P.gap + 1, it.x - it.r - P.gap - 1 - w
		local mid = it.y - math.floor(h / 2)
		local tries = {
			{ cx, below }, { cx, above },
			{ cx + quarter, below }, { cx - quarter, below }, { cx + quarter, above }, { cx - quarter, above },
			{ cx + half, below }, { cx - half, below }, { cx + half, above }, { cx - half, above },
			{ right, mid }, { left, mid },
			{ right, mid + it.r + 3 }, { left, mid + it.r + 3 }, { right, mid - it.r - 3 }, { left, mid - it.r - 3 },
			{ cx, below + h + 1 }, { cx, above - h - 1 },
			{ cx + half, below + h + 1 }, { cx - half, below + h + 1 }, { cx + half, above - h - 1 }, { cx - half, above - h - 1 },
		}
		local list = {}
		for k, t in tries do
			-- 옆으로 조금 밀어도 된다(그림의 가장자리에 붙은 마을)
			local x, y = math.clamp(t[1], 1, WM.ART_W - 1 - w), t[2]
			local ok = y >= 1 and y + h <= WM.ART_H - 1
			if ok then
				for _, pin in items do
					if x < pin.x + pin.r + 2 and x + w > pin.x - pin.r - 2 and y < pin.y + pin.r + 2 and y + h > pin.y - pin.r - 2 then
						ok = false
						break
					end
				end
			end
			if ok then
				local cost = covered(x, y, w, h)
				local own = gapTo(x, y, w, h, it)
				for _, other in items do
					if other ~= it and gapTo(x, y, w, h, other) <= own then
						cost += K.amb
						break
					end
				end
				table.insert(list, { x = x, y = y, w = w, h = h, cost = cost, k = k })
			end
		end
		table.sort(list, function(a, b)
			if a.cost ~= b.cost then
				return a.cost < b.cost
			end
			return a.k < b.k
		end)
		cands[n] = list
	end
	-- ② 서로 겹치지 않는 짝 가운데 값의 합이 가장 작은 것: 앞선 이름부터 값이 작은 자리를 먼저 대 본다(첫 답 = 예전처럼 차례로 놓은 것 → 그보다 나쁜 답은 없다)
	local chosen, best, bestCost, budget = {}, nil, math.huge, K.budget
	local function clash(c, upto: number): boolean
		for n = 1, upto do
			local o = chosen[n]
			if o and c.x < o.x + o.w + 1 and c.x + c.w > o.x - 1 and c.y < o.y + o.h + 1 and c.y + c.h > o.y - 1 then
				return true
			end
		end
		return false
	end
	-- left = 값이 가장 작은 자리(예전의 답)에서 벗어나도 되는 횟수: 0 → 1 → 2로 늘려 가며 찾는다(앞쪽 이름 하나만 옮기면 풀리는 일이 많다)
	local function walk(n: number, cost: number, left: number)
		if cost >= bestCost or budget <= 0 then
			return
		end
		if n > #items then
			best, bestCost = table.clone(chosen), cost
			return
		end
		budget -= 1
		local first = true
		for _, c in cands[n] do
			if cost + c.cost >= bestCost then
				break
			end
			if not clash(c, n - 1) then
				if not first and left <= 0 then
					break
				end
				chosen[n] = c
				walk(n + 1, cost + c.cost, if first then left else left - 1)
				chosen[n] = nil
				first = false
				if bestCost == 0 then
					return
				end
			end
		end
		if first then
			chosen[n] = false -- 놓을 자리가 없으면 그 이름은 빠진다
			walk(n + 1, cost + K.drop, left)
			chosen[n] = nil
		end
	end
	for left = 0, K.depth do
		walk(1, 0, left)
		if bestCost == 0 or budget <= 0 then
			break
		end
	end
	local out = {}
	for n, it in items do
		local c = best and best[n]
		if c then
			out[it.id] = { x = c.x, y = c.y, w = c.w, h = c.h }
		end
	end
	return out
end

-- 지금 가야 할 곳을 오른쪽 글 칸에 두 토막으로: title(「「고갯길」 받으러」) · text(가는 길의 이름들 — 그 맵에 있으면 「지금 있는 맵에서 받는다」).
--  갈 곳이 없으면 nil. route = 그 길의 마디들(그림이 금빛 점줄을 잇는다) · goal
local CARD_WORD = { ["do"] = "하러", back = "돌려주러", take = "받으러" }
local CARD_HERE = { ["do"] = "지금 있는 맵에서 한다", back = "지금 있는 맵에서 돌려준다", take = "지금 있는 맵에서 받는다" }
function WM.goalCardOf(goal, sceneKey: any)
	local route = WM.route(sceneKey, goal.scene)
	if not route or #route == 0 then
		return nil
	end
	return {
		title = ("「%s」 %s"):format(goal.def.name, CARD_WORD[goal.kind]),
		text = if #route == 1 then CARD_HERE[goal.kind] else WM.routeText(route),
		route = route,
		goal = goal,
	}
end
--  navi = 길찾기를 켠 줄의 이름표(알리미의 화살표 단추) · daily = 일일 의뢰의 모습: 켠 것이 있으면 그 퀘스트의 지금 진행에 맞는 곳까지의 길을 적는다(머리 위의 화살표와 같은 곳)
WM.DAILY_NAME = "일일 의뢰"
function WM.naviGoal(navi: any, book, level: number, daily: any)
	local target = Navi.target(navi, book, level, daily)
	if not target then
		return nil
	end
	local def = Quests.def(navi)
	local kind = if target.kind ~= "npc" then "do" elseif def and not (book and book[navi]) then "take" else "back"
	return { def = def or { name = WM.DAILY_NAME }, scene = target.scene, kind = kind }
end
function WM.goalCard(book, level: number, sceneKey: any, navi: any, daily: any)
	local goal = (if navi then WM.naviGoal(navi, book, level, daily) else nil) or Quests.goal(book, level)
	return if goal then WM.goalCardOf(goal, sceneKey) else nil
end

-- 마디 하나를 고르면 아래에 적는 두 줄: 「굽잇길 · 사냥터 · Lv.14~15」 / 「폭탄병 · 고갯길 염소」(주민이 있으면 「주민: 달래 · 반달」)
WM.INFO_PEOPLE = 10 -- 아래 둘째 줄에 적는 주민의 수(넘으면 「외 n명」)
function WM.info(rid: string, nodeId: string): (string, string)
	local n = WM.node(rid, nodeId)
	if not n then
		return "", ""
	end
	local head = { n.name, D.kinds[n.kind] or n.kind }
	local lv = WM.levelText(n)
	if lv ~= "" then
		table.insert(head, lv)
	end
	local parts = {}
	local mobs = WM.mobNames(n)
	if #mobs > 0 then
		table.insert(parts, table.concat(mobs, " · "))
	end
	local people = WM.npcNames(rid, nodeId)
	if #people > WM.INFO_PEOPLE then -- 큰 도시(은달 항구 — 사람 스물 남짓)는 앞의 몇 사람과 「외 n명」(창의 폭 620에 든다)
		local more = #people - WM.INFO_PEOPLE
		people = table.move(people, 1, WM.INFO_PEOPLE, 1, {})
		table.insert(people, ("외 %d명"):format(more))
	end
	if #people > 0 then
		table.insert(parts, "주민: " .. table.concat(people, " · "))
	end
	return table.concat(head, " · "), table.concat(parts, " / ")
end

return WM

end
MODULES['ReplicatedStorage/shared/net/net'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 네트워크 계층. 모든 RemoteEvent/RemoteFunction은 shared/net/packets.luau의 정의로만 만들고 쓴다 — 모듈마다
-- 리모트를 제각각 만들고 이름 문자열로 찾던 구조를 대체한다.
--   서버: Net.OnServer(이름, 핸들러) — 인자 개수/타입과 요청 빈도를 검사해서 통과한 요청만 핸들러로 보낸다.
--         Net.FireClient / Net.FireAllClients
--   클라: Net.FireServer / Net.Invoke / Net.OnClient
-- 검증에 실패하거나 빈도를 넘긴 요청은 조용히 버리고(서버 로그에는 플레이어·패킷별로 몇 초에 한 번만 경고) 핸들러는
-- 호출하지 않는다. 이동 위치를 매번 거절하는 것은 엔진 공식 문서가 비권장하지만(오탐/지연), 이 계층은 "중요 행동
-- 요청이 형식에 맞는지, 폭주하지 않는지"만 본다 — 위치/내용의 타당성 검증은 각 서비스가 맡는다.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local packets = require(script.Parent.packets)

local IS_SERVER = RunService:IsServer()
local FOLDER_NAME = "Remotes"

local Net = {}

local folder: Folder
if IS_SERVER then
	folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME) or Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = ReplicatedStorage
	for name, def in packets do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new(if def.Kind == "Function" then "RemoteFunction" else "RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

local function getRemote(name: string)
	assert(packets[name], ("Net: 정의되지 않은 패킷 '%s' (shared/net/packets.luau에 먼저 추가)"):format(name))
	if IS_SERVER then
		return folder:FindFirstChild(name)
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME):WaitForChild(name)
end

-- ===== 서버 =====

-- 플레이어별 패킷별 토큰 버킷: buckets[userId][name] = { tokens, last }
local buckets: { [number]: { [string]: { tokens: number, last: number } } } = {}
local lastWarn: { [string]: number } = {}

local function warnThrottled(key: string, message: string)
	local now = os.clock()
	if not lastWarn[key] or now - lastWarn[key] > 5 then
		lastWarn[key] = now
		warn(message)
	end
end

local function takeToken(player: Player, name: string, limit): boolean
	local perPlayer = buckets[player.UserId]
	if not perPlayer then
		perPlayer = {}
		buckets[player.UserId] = perPlayer
	end
	local now = os.clock()
	local bucket = perPlayer[name]
	if not bucket then
		bucket = { tokens = limit.Burst, last = now }
		perPlayer[name] = bucket
	end
	bucket.tokens = math.min(limit.Burst, bucket.tokens + (now - bucket.last) * limit.PerSecond)
	bucket.last = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

local function validArgs(def, ...): boolean
	if select("#", ...) > #def.Args then
		return false -- 정의보다 인자가 많으면 형식 위반
	end
	for i, check in def.Args do
		if not check((select(i, ...))) then
			return false
		end
	end
	return true
end

-- ClientToServer 패킷 핸들러 등록. Function 패킷이면 핸들러의 반환값이 클라이언트에 돌아간다.
function Net.OnServer(name: string, handler: (player: Player, ...any) -> ...any)
	assert(IS_SERVER, "Net.OnServer는 서버에서만 쓴다")
	local def = packets[name]
	assert(def and def.Direction == "ClientToServer", ("Net.OnServer: '%s'는 ClientToServer 패킷이 아니다"):format(name))
	local remote = getRemote(name)

	local function guarded(player: Player, ...)
		if not takeToken(player, name, def.RateLimit) then
			warnThrottled(player.UserId .. name .. "rate", ("Net: %s의 '%s' 요청이 빈도 제한을 넘어 버려졌다"):format(player.Name, name))
			return false
		end
		if not validArgs(def, ...) then
			warnThrottled(player.UserId .. name .. "arg", ("Net: %s의 '%s' 요청 인자가 형식에 맞지 않아 버려졌다"):format(player.Name, name))
			return false
		end
		return true
	end

	if def.Kind == "Function" then
		remote.OnServerInvoke = function(player: Player, ...)
			if not guarded(player, ...) then
				return nil
			end
			return handler(player, ...)
		end
	else
		remote.OnServerEvent:Connect(function(player: Player, ...)
			if guarded(player, ...) then
				handler(player, ...)
			end
		end)
	end
end

function Net.FireClient(name: string, player: Player, ...: any)
	assert(IS_SERVER)
	getRemote(name):FireClient(player, ...)
end

function Net.FireAllClients(name: string, ...: any)
	assert(IS_SERVER)
	getRemote(name):FireAllClients(...)
end

if IS_SERVER then
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		buckets[player.UserId] = nil
	end)
end

-- ===== 클라이언트 =====

function Net.FireServer(name: string, ...: any)
	assert(not IS_SERVER)
	getRemote(name):FireServer(...)
end

function Net.Invoke(name: string, ...: any): any
	assert(not IS_SERVER)
	return getRemote(name):InvokeServer(...)
end

function Net.OnClient(name: string, handler: (...any) -> ()): RBXScriptConnection
	assert(not IS_SERVER)
	return getRemote(name).OnClientEvent:Connect(handler)
end

return Net

end
MODULES['ReplicatedStorage/shared/net/packets'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 네트워크 패킷(RemoteEvent/RemoteFunction) 정의의 "단 하나의 출처". 공식 멀티플레이 데모(shared/packets.luau,
-- Remo + t 라이브러리)와 같은 개념 — 리모트 이름/방향/인자 타입/요청 빈도 제한을 여기에만 적는다. 서버는 이 정의로
-- 리모트를 만들고, 클라이언트→서버 패킷은 net.luau가 인자 타입과 빈도를 자동으로 검사한 뒤에야 핸들러를 부른다.
--
-- Direction: "ClientToServer"(클라가 서버에 요청/보고) / "ServerToClient"(서버가 클라에 통지).
-- Kind: "Event"(RemoteEvent) / "Function"(RemoteFunction, 서버 핸들러가 값을 돌려줌).
-- Args: ClientToServer 패킷만 사용 — 위치 인자 검증 함수 목록(개수도 정확히 맞아야 통과).
-- RateLimit: ClientToServer 패킷만 사용 — 플레이어별 토큰 버킷(PerSecond: 초당 보충량, Burst: 최대 적립량).
-- ServerToClient의 Doc은 인자 설명용(검증하지 않음).
local scenes = require(script.Parent.Parent.config.scenes)

local t = {}

-- 유한한 숫자만(NaN/무한대는 좌표 조작에 쓰일 수 있어 거른다).
function t.number(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function t.string(value: any): boolean
	return typeof(value) == "string" and #value <= 64
end

function t.oneOf(...: string)
	local allowed = {}
	for _, value in { ... } do
		allowed[value] = true
	end
	return function(value: any): boolean
		return typeof(value) == "string" and allowed[value] == true
	end
end

function t.optional(check)
	return function(value: any): boolean
		return value == nil or check(value)
	end
end

function t.either(a, b)
	return function(value: any): boolean
		return a(value) or b(value)
	end
end

local packets = {
	-- ===== 클라이언트 -> 서버 =====
	-- 위치와 씬은 클라이언트가 보고하지 않는다 — 서버가 캐릭터 복제 요청(ReplicationRequest)의 내용에서 직접 읽는다.
	-- 씬 이동은 서버가 승인한다: 클라이언트는 "이 씬으로 가고 싶다"고 요청만 하고, 서버가 지금 씬/포탈 위치를 검증해서
	-- TravelApproved로 승인해야 실제로 이동한다. 플레이어가 어느 씬에 있는지의 진실은 서버가 갖는다.
	RequestTravel = {
		Kind = "Event",
		Direction = "ClientToServer",
		-- 목적지 씬 이름. 탑다운 씬이 여러 개라 이름 목록을 고정하지 않고, 실제로 갈 수 있는지는 서버 travelService가 포탈 위치로 검증한다.
		Args = { t.string },
		RateLimit = { PerSecond = 2, Burst = 3 },
	},
	EquipAction = {
		Kind = "Event",
		Direction = "ClientToServer",
		Args = { t.oneOf("Equip", "Unequip"), t.either(t.number, t.string) }, -- 동작, 인벤토리 슬롯 번호 또는 장비 슬롯 이름
		RateLimit = { PerSecond = 5, Burst = 5 },
	},
	-- ===== 탑다운 씬(온라인 공유) =====
	-- 지금 씬의 몬스터·월드 드랍 전체 목록(씬에 들어왔을 때 한 번). 돌려주는 값: { scene, monsters, drops }
	GetTownState = {
		Kind = "Function",
		Direction = "ClientToServer",
		Args = {},
		RateLimit = { PerSecond = 2, Burst = 4 },
	},
