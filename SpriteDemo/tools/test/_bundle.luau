--  장면의 칸(rows): "#" 막힌 칸 · "=" 아래에서 올라탈 수 있는 얇은 발판(↓를 누른 채 뛰기를 누르면 내려간다 — 하단 점프) · "^" 가시 · "." 빈 칸.
--  body = { x, y, vx, vy, ground, air = 땅을 떠난 뒤 공중에서 뛴 수(2단 점프 — 땅에 닿으면 0) } — (x, y)는 발밑 가운데.  input = { mx = -1 | 0 | 1, jump = 이번 걸음에 뛰기를 눌렀나, down = ↓를 누르고 있나, speed = 빠르기 배수(없으면 1),
--          vx = 가로 빠르기를 직접 준다(대쉬 · 기술 중의 이동), float = 떨어지지 않는다(대쉬), up = ↑를 누르고 있나(사다리) }
--  사다리(scene.ladders = { { x, top, bottom } } — 도트, 2026-10-16 밤): ↑를 누르면 잡고 곧게 오르고, ↓로 내린다. 처음에는 "올라가는 모션없이" 서 있는 모습이었고,
--   같은 밤 사용자: "사다리 올라가는 모션 만들어서 적용해줘" → 오르기 동작(climb — 등을 보이고 팔다리를 번갈아, tools/build_lune_climb.py). 꼭대기의 발판 위에서 ↓(뛰기 없이)를 누르면
--   잡고 내려간다(메이플처럼 — ↓ + 뛰기는 그대로 하단 점프). 뛰기 = 놓고 뛰어내린다
local G = require(script.Parent.Parent.config.game)
local COMBAT = require(script.Parent.Parent.data["combat.generated"])
-- 바닷속(scene.sea): 걷기는 조금 느리고, 뛰면 느리게 높이 떴다가 천천히 가라앉는다(공방 combat.js의 sea — 시험 탭과 같은 숫자)
local SEA = COMBAT.rules.sea

local T = G.TILE
local HALF = G.BOX_W / 2
local CLIMB = 80 -- 사다리를 오르내리는 빠르기(점/초 — 달리기 92보다 조금 느리게 · 제가 정한 것)
local GRAB = 7 -- 사다리 가운데에서 이만큼 안이면 잡는다(점)

local P = {}

-- 칸 하나. 맵 위는 빈 칸, 맵 아래와 좌우 밖은 막힌 칸이다.
function P.cell(scene, tx: number, ty: number): string
	if ty < 0 then
		return "."
	end
	if ty >= scene.h or tx < 0 or tx >= scene.w then
		return "#"
	end
	return string.sub(scene.rows[ty + 1], tx + 1, tx + 1)
end

-- 발밑 가운데가 (x, y)인 몸 상자가 막힌 칸에 걸리는가.
function P.solidBox(scene, x: number, y: number): boolean
	for ty = math.floor((y - G.BOX_H) / T), math.floor((y - 1) / T) do
		for tx = math.floor((x - HALF) / T), math.floor((x + HALF - 1) / T) do
			if P.cell(scene, tx, ty) == "#" then
				return true
			end
		end
	end
	return false
end

-- 가시(^)에 닿아 있는가: 발이 놓인 칸이 가시일 때(몸 폭에서 양옆 두 점씩 뺀 안쪽 — 스치기만 한 것은 치지 않는다). 가시 위로 뛰어넘는 동안에는 닿지 않는다.
--  닿으면 약한 피해를 입는다(서버 — sim/room.luau의 step. 사용자 2026-10-08: "맵에 가시 있잖아요 그거 닿으면 데미지 입게 약한데미지 입게하세요")
function P.onSpike(scene, x: number, y: number): boolean
	local ty = math.floor((y - 1) / T)
	for tx = math.floor((x - HALF + 2) / T), math.floor((x + HALF - 3) / T) do
		if P.cell(scene, tx, ty) == "^" then
			return true
		end
	end
	return false
end

-- 발밑이 얇은 발판(=)뿐인가 — 하단 점프를 할 수 있는 자리. 몸 폭 안의 발밑 칸에 막힌 칸(#)이 하나라도 있으면 아니다(그 칸이 받친다)
function P.onPlatform(scene, body): boolean
	local ty = math.floor(body.y / T)
	if body.y ~= ty * T then
		return false
	end
	local found = false
	for tx = math.floor((body.x - HALF) / T), math.floor((body.x + HALF - 1) / T) do
		local k = P.cell(scene, tx, ty)
		if k == "#" then
			return false
		elseif k == "=" then
			found = true
		end
	end
	return found
end

-- 그 자리에서 잡을 수 있는 사다리(번호 · 사다리) — 가로가 사다리 가운데에서 GRAB 안 · 세로가 꼭대기와 바닥 사이(양 끝 포함)
function P.ladderAt(scene, x: number, y: number): (number?, any)
	for i, l in scene.ladders or {} do
		if math.abs(x - l.x) <= GRAB and y >= l.top - 0.5 and y <= l.bottom + 0.5 then
			return i, l
		end
	end
	return nil, nil
end

function P.newBody(scene)
	return { x = scene.spawn.x, y = scene.spawn.y, vx = 0, vy = 0, ground = false }
end

function P.respawn(scene, body)
	body.x, body.y, body.vx, body.vy, body.ground = scene.spawn.x, scene.spawn.y, 0, 0, false
	body.air = 0
end

-- 한 걸음(dt초). 맵 아래로 떨어져 시작 자리로 돌아갔으면 "respawn"을 돌려준다.
--  가시("^")는 닿아도 시작 자리로 돌려보내지 않는다 — 사용자 2026-10-07: "가시맞고 돌아가는거 없애세요 가시맞고 돌아간다음에 몬스터랑 전투도안되고 고장나네요"
--   (2026-10-08부터는 닿으면 약한 피해를 입는다 — 위의 onSpike. 움직임은 그대로다)
--   (고장난 까닭: 화면에서만 시작 자리로 옮겨지고 서버는 그 순간이동을 믿지 않아, 그 뒤로 서버가 아는 자리와 어긋났다. 맵 아래로 떨어진 때를 위해 서버는 시작 자리로 온 보고는 받는다 — world.luau의 onMove)
P.GRAB_LOCK = 0.3 -- 사다리에서 뛰어 놓은 뒤 다시 잡지 않는 시간(초)
function P.step(scene, body, input, dt: number): string?
	local mx = input.mx or 0
	local sea = if scene.sea then SEA else nil
	-- 사다리: 잡기(↑ — 꼭대기 아래에서 · ↓ — 꼭대기의 발판 위에서, 뛰기 없이)
	--  뛰어 놓은 뒤 GRAB_LOCK초 동안은 다시 잡지 않는다 — ↑를 누른 채(폰은 막대를 비스듬히) 뛰면 바로 다시 잡혀 뛰어내릴 수 없었다(2026-10-18 검토)
	if (body.grabLock or 0) > 0 then
		body.grabLock = math.max(0, body.grabLock - dt)
	end
	if not body.climb and (body.grabLock or 0) <= 0 and not input.float and input.vx == nil and (input.up or (input.down and not input.jump and body.ground)) then
		local i, l = P.ladderAt(scene, body.x, body.y)
		if l and input.up and body.y > l.top + 0.5 then
			body.climb = i
		elseif l and input.down and math.abs(body.y - l.top) < 1 then
			body.climb, body.y = i, l.top + 1
		end
	end
	if body.climb then
		local l = (scene.ladders or {})[body.climb]
		if not l or input.float or input.vx ~= nil then
			body.climb = nil -- 사다리가 없는 장면으로 옮겼다 · 기술(대쉬)로 떨어져 나갔다
		elseif input.jump then
			body.climb = nil -- 뛰기: 놓는다(옆으로 누르고 있으면 그쪽으로 조금 뛰어내린다)
			body.grabLock = P.GRAB_LOCK
			body.vy = if mx ~= 0 then -G.JUMP * 0.5 else 0
			body.ground = false
			input = table.clone(input)
			input.jump = false
		else
			body.vx, body.vy, body.air = 0, 0, 0
			body.x = l.x
			local ny = body.y + ((if input.down then 1 else 0) - (if input.up then 1 else 0)) * CLIMB * dt
			if ny <= l.top then
				body.y, body.climb, body.ground = l.top, nil, true -- 꼭대기: 위의 발판에 선다
			elseif ny >= l.bottom then
				body.y, body.climb, body.ground = l.bottom, nil, true -- 바닥에 닿았다
			else
				body.y, body.ground = ny, false
			end
			return nil
		end
	end
	-- body.run · body.jump = 걸음 · 뛰는 힘의 배수(패시브 — 리븐의 날랜 몸 · 살라맨더의 뜨거운 피. 없으면 1)
	body.vx = if input.vx ~= nil then input.vx else mx * G.RUN * (input.speed or 1) * (body.run or 1) * (if sea then sea.run else 1)
	if input.jump and not body.ground and not input.float and (body.air or 0) < G.AIR_JUMPS then
		-- 2단 점프: 공중에서 뛰기를 한 번 더 누르면 그 자리에서 다시 뛰어오른다(전 직업 — 사용자 2026-10-11). 발판에서 걸어 떨어진 뒤에도 한 번 된다.
		--  땅에 닿으면 다시 센다. 바닷속에서도 같다(뛰는 힘만 바닷속의 것)
		body.air = (body.air or 0) + 1
		body.vy = -G.JUMP * G.JUMP2 * (body.jump or 1) * (if sea then sea.jump else 1)
	elseif input.jump and body.ground and not input.float then
		body.air = 0
		if input.down and P.onPlatform(scene, body) then
			-- 하단 점프: 발판 위에서 ↓ 를 누른 채 뛰기를 누르면 그 발판을 지나 내려간다(↓ 만으로는 내려가지 않는다).
			--  사용자 2026-10-08: "하단점프가 지금 그냥 아래키만 누르면 지금 하단점프인데 아래방향+점프키 여야 하단점프되어야합니다."
			--  발을 발판의 윗면 바로 아래로 옮긴다 — 그 발판은 더 받치지 않고, 그 아래의 발판 · 땅에는 평소처럼 선다
			body.y += 1
			body.vy = 0
			body.ground = false
		else
			body.vy = -G.JUMP * (body.jump or 1) * (if sea then sea.jump else 1)
			body.ground = false
		end
	end

	local nx = body.x + body.vx * dt
	if not P.solidBox(scene, nx, body.y) then
		body.x = nx
	end

	body.vy = if input.float then 0 else math.min(body.vy + G.GRAVITY * (if sea then sea.grav else 1) * dt, if sea then sea.fall else G.MAX_FALL) -- 대쉬 중에는 높이를 지킨다
	local ny = body.y + body.vy * dt
	if input.float then
		-- 떨어지지 않는다
	elseif body.vy >= 0 then
		-- 내려가는 중: 막힌 칸이나 발판 윗면에 선다
		local land: number? = nil
		local ty = math.floor(body.y / T)
		while ty <= math.floor(ny / T) and land == nil do
			for tx = math.floor((body.x - HALF) / T), math.floor((body.x + HALF - 1) / T) do
				local k = P.cell(scene, tx, ty)
				if k == "#" or (k == "=" and body.y <= ty * T) then
					land = ty * T
					break
				end
			end
			ty += 1
		end
		if land ~= nil and ny >= land then
			body.y, body.vy, body.ground = land, 0, true
			body.air = 0 -- 땅에 닿았다: 2단 점프를 다시 쓴다
		else
			body.y, body.ground = ny, false
		end
	elseif P.solidBox(scene, body.x, ny) then
		body.vy = 0 -- 머리가 닿았다
	else
		body.y, body.ground = ny, false
	end

	if body.y > scene.h * T + G.FALL_OUT then
		P.respawn(scene, body)
		return "respawn"
	end
	return nil
end

-- 지금 보일 동작 이름(서 있기 · 달리기 · 뛰기 · 떨어지기)
function P.clipOf(body, mx: number): string
	if body.climb then
		return "climb" -- 사다리: 오르기 동작(사용자 2026-10-16 밤 — 오르내릴 때만 장이 넘어간다: boot)
	end
	if not body.ground then
		return if body.vy < 0 then "jump" else "fall"
	end
	return if mx ~= 0 then "run" else "idle"
end

return P

end
MODULES['ReplicatedStorage/shared/lune/sim/quests'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 퀘스트의 셈 — 받기 · 잡은 것 세기 · 다 됐는지 · 돌려주기. 화면도 서버도 모르는 순수한 셈이다.
--  자료는 data/quests.generated.luau(공방 js/lune/design/questplay.js에서 내보낸 것): 누구에게서 받고 · 무엇을 몇 개 · 누구에게 돌려주고 · 무엇을 받나.
--  사람마다의 상태(book) = { [퀘스트 id] = { done = 끝냈는가, c = { [할 일 차례] = 지금까지의 수 } } } — 받지 않은 퀘스트는 들어 있지 않다.
--  서버는 캐릭터의 표에(h.quests), 클라이언트는 서버가 보내 준 것을 그대로 갖고 같은 함수로 주민 머리 위의 표시와 알리미를 셈한다.
local D = require(script.Parent.Parent.data["quests.generated"])

local Q = {}
Q.list = D.list
Q.MAX_ACTIVE = 10 -- 한 번에 받아 둘 수 있는 수

local byId = {}
for i, def in D.list do
	byId[def.id] = def
	def.order = i
end

function Q.def(id: any)
	return if typeof(id) == "string" then byId[id] else nil
end

-- 할 일 하나를 화면에 적는 꼴: 「수습 검병 3/5」 · 들르는 일은 「달맞이 광장 들르기」 · 다 했으면 「… ✓」
function Q.stepText(step, have: number): string
	if step.type == "visit" then
		return ("%s 들르기%s"):format(step.name, if have >= step.n then " ✓" else "")
	elseif step.type == "meet" then
		return ("%s 만나기%s"):format(step.name, if have >= step.n then " ✓" else "") -- 처음 인사(2026-10-16 — 만나면 그 사람의 기능이 열린다)
	end
	return ("%s %d/%d"):format(step.name, math.min(have, step.n), step.n)
end

-- 받침이 있으면 a, 없으면 b(을 · 를 / 이 · 가)를 고른다 — 한글로 끝나지 않으면 a
local function josa(word: string, a: string, b: string): string
	local last = nil
	for _, code in utf8.codes(word) do
		last = code
	end
	if last and last >= 0xAC00 and last <= 0xD7A3 and (last - 0xAC00) % 28 == 0 then
		return b
	end
	return a
end
Q.josa = josa

-- 그 일을 어디서 무엇을 잡아 하는가: 「달그림자 사냥터의 검병을 잡으면 떨어진다」 · 「마을 어귀에 있다」
--  사용자 2026-10-07: "뭘잡아야 갑옷조각이 나오는지를 자연스럽게 적어둬야 퀘스트를 진행할거아닙니까 이렇게 적으면 누가 어떻게 알아요"
function Q.stepHint(def, step): string
	local SCENES = require(script.Parent.Parent.data["scenes.generated"])
	local COMBAT = require(script.Parent.Parent.data["combat.generated"])
	local scene = def.scene and SCENES.scenes[def.scene]
	local place = if scene then scene.name else "이 근처"
	local mob = COMBAT.mobs[step.mob]
	local name = if mob then mob.name else step.name
	if step.type == "gather" then
		return ("%s의 %s%s 잡으면 떨어진다"):format(place, name, josa(name, "을", "를"))
	elseif step.type == "use" then
		return ("%s — %s 앞에서 ↑"):format(place, step.place) -- 맵에 놓인 것 앞에서 ↑를 누르는 일
	elseif step.type == "visit" then
		return ("%s에 가 본다"):format(step.name) -- 그 맵에 들어가면 된다(2026-10-16)
	elseif step.type == "meet" then
		local at = Q.npcScene(def, step.npc)
		local sc = at and SCENES.scenes[at]
		return ("%s — %s에게 말을 건다"):format(if sc then sc.name else place, step.name)
	end
	return ("%s에 있다"):format(place)
end

-- 아직 다 하지 못한 일들의 길잡이(퀘스트 창에 적는다)
function Q.hints(book, id: string): { string }
	local def, st = byId[id], book[id]
	local out = {}
	if def and st then
		for i, step in def.steps do
			if (st.c[i] or 0) < step.n then
				table.insert(out, Q.stepHint(def, step))
			end
		end
	end
	return out
end

-- 알리미에 적는 한 줄: 모으는 일은 떨어뜨리는 졸개의 이름을 앞에 — 「검병 · 갑옷 조각 0/8」
function Q.trackText(step, have: number): string
	if step.type == "gather" then
		local COMBAT = require(script.Parent.Parent.data["combat.generated"])
		local mob = COMBAT.mobs[step.mob]
		if mob then
			return ("%s · %s"):format(mob.name, Q.stepText(step, have))
		end
	end
	return Q.stepText(step, have)
end

-- 받아 둔 퀘스트의 할 일이 다 됐는가
function Q.isReady(book, id: string): boolean
	local def, st = byId[id], book[id]
	if not def or not st or st.done then
		return false
	end
	for i, step in def.steps do
		if (st.c[i] or 0) < step.n then
			return false
		end
	end
	return true
end

-- 퀘스트의 지금 모습: "done" 끝냄 · "ready" 돌려주면 된다 · "active" 하는 중 · "open" 받을 수 있다 · "locked" 아직 못 받는다
function Q.state(book, level: number, id: string): string
	local def, st = byId[id], book[id]
	if not def then
		return "locked"
	elseif st then
		return if st.done then "done" elseif Q.isReady(book, id) then "ready" else "active"
	elseif not def.playable or level < def.lv then
		return "locked"
	elseif def.after and not (book[def.after] and book[def.after].done) then
		return "locked"
	elseif def.kind == "job" and def.reward.job and def.reward.job > 2 then
		-- 전직은 차례대로(2026-10-18 검토): 앞 차수의 전직 퀘스트를 끝내야 받는다 — 2차를 건너뛰고 Lv.60에 3차를 받아 돌려주면
		--  전직은 되지 않고(Hero.advance는 바로 다음 차수만) 퀘스트만 끝나 3차를 영영 못 했다
		local prev = Q.jobQuest(def.reward.job - 1)
		if prev and not (book[prev.id] and book[prev.id].done) then
			return "locked"
		end
	end
	return "open"
end

local function activeCount(book): number
	local n = 0
	for _, st in book do
		if not st.done then
			n += 1
		end
	end
	return n
end

-- 그 지역의 퀘스트 줄에서 아직 끝내지 않은 퀘스트가 잡게 하는 몬스터 { [몬스터] = true } — 일일 의뢰가 피한다(sim/daily.luau — 2026-10-15
--  사용자: "메인퀘스트에서 궁병잡는거 중간에 일일퀘스트도 자연스럽게하면 너무 반복됩니다")
function Q.lineMobs(book, region: string): { [string]: boolean }
	local out = {}
	for _, def in D.list do
		if def.line and def.region == region and def.playable and not (book[def.id] and book[def.id].done) then
			for _, step in def.steps do
				if step.mob then
					out[step.mob] = true
				end
			end
		end
	end
	return out
end

-- 받는다
function Q.accept(book, level: number, id: any): (boolean?, string?)
	local def = Q.def(id)
	if not def then
		return nil, "없는 퀘스트다"
	end
	local state = Q.state(book, level, id)
	if state == "locked" then
		return nil, if level < def.lv then ("Lv.%d부터 받는다"):format(def.lv) else "아직 받을 수 없다"
	elseif state ~= "open" then
		return nil, "이미 받은 퀘스트다"
	elseif activeCount(book) >= Q.MAX_ACTIVE then
		return nil, "퀘스트를 더 받을 수 없다"
	end
	book[id] = { done = false, c = {} }
	return true
end

-- 저절로 받는 퀘스트(자료의 auto) — 지금은 하나도 없다: 모든 퀘스트는 주는 주민에게 말을 걸어 받는다
--  (사용자 2026-10-11: "퀘스트를 부여해주는 npc 랑 말을하고 퀘스트를 수락해야 퀘스트가 수락되고 … 정석적으로". 전에는 새 캐릭터의 「첫 기술」과 전직 퀘스트를 여기서 저절로 받았다.)
--  공방의 검사가 auto를 막는다. 이 함수는 빈 표를 돌려준다(부르는 곳들은 그대로 둔다)
function Q.start(book, level: number): { string }
	local got = {}
	for _, def in D.list do
		if def.auto and Q.state(book, level, def.id) == "open" then
			if Q.accept(book, level, def.id) then
				table.insert(got, def.id)
			end
		end
	end
	return got
end

-- 새 캐릭터가 서는 곳: 첫 퀘스트(「첫 기술」)를 끝내기 전에는 그것을 주는 사제의 사당 안(공방 questplay.js의 FIRST) — 끝낸 뒤에는 nil(마을의 시작 자리).
--  Lv.1일 때만이다: 첫 퀘스트를 건너뛰고 자란 예전 캐릭터(이 규칙이 생기기 전 — 2026-10-10)는 하던 대로 마을에서 시작하고 기술도 그대로 쓴다.
--  받기 전(사제에게 아직 말을 걸지 않았다)이든 받은 뒤든, 끝내기 전이면 새 캐릭터다
Q.FIRST = D.first
function Q.isNew(book, level: number): boolean
	local st = book[D.first.quest]
	return level <= 1 and not (st ~= nil and st.done)
end
function Q.firstScene(book, level: number): string?
	return if Q.isNew(book, level) then D.first.scene else nil
end

-- 그 차수로 올려 주는 전직 퀘스트(없으면 nil — 그 차수는 레벨만 되면 오른다)
function Q.jobQuest(job: number)
	for _, def in D.list do
		if def.kind == "job" and def.playable and def.reward.job == job then
			return def
		end
	end
	return nil
end

-- 이미 닿은 차수의 전직 퀘스트는 끝낸 것으로 적는다(전직 퀘스트가 생기기 전의 캐릭터 · 확인용 캐릭터가 다시 받지 않게)
function Q.jobsDone(book, job: number)
	for _, def in D.list do
		if def.kind == "job" and def.reward.job and def.reward.job <= job then
