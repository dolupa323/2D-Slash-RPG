local function syncKit()
	local kit = state.me and state.me.kit
	local a = state.actor
	if not kit or not a then
		return
	end
	local s = a.g.s
	if s.souls ~= nil then
		s.souls = kit.souls
	end
	if s.heat ~= nil then
		s.heat = kit.heat
	end
end

