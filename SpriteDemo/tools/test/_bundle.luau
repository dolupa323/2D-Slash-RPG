--   무니     수정 조각(대검이 맞으면 1.5초에 한 번, 수정마다 조각) · 수정 공명(수정이 맺히고, 곁에서 쓴 대검이 수정에서도 나간다) · 지키는 마음(받는 피해 -)
--   살라맨더 불티(주먹이 맞을 때마다) · 열기(맞히면 오르고 50부터 달아오름 — 불꽃이 한 번 더) · 뜨거운 피(체력이 찬다 · 달아오르면 걸음 +)
--  여기는 화면도 방도 모르는 셈이다: 캐릭터의 표(sim/hero.luau)에 얹는 상태 h.kit과, 레벨에 따른 값들. 맞혔을 때 따라 나가는 것(사출기 · 표식 · 수정 …)은 sim/room.luau가 이 값으로 푼다.
--  모든 "세기"는 마스터했을 때의 값이고, 그 스킬의 레벨에 따른 배수(레벨 1에서 40% → 마스터 100%)를 곱한다. 확률 · 시간 · 개수는 레벨과 상관없다.
local COMBAT = require(script.Parent.Parent.data["combat.generated"])
local CLASSES = require(script.Parent.Parent.data["classes.generated"])

local KIT = COMBAT.kit -- [직업] = { skills, toggle, core, passive }
local SKILL = COMBAT.kitSkill -- [스킬] = { who, role, max }
local PASS = COMBAT.passive -- 2~4차의 패시브가 장치를 키운다(깊은 호흡 = 3단계 · 영혼 주머니 = 영혼 8 · 끓는 피 = 열기) — 셈은 sim/passives.luau, 여기서는 장치의 크기만 읽는다
local FLOOR = CLASSES.skillRule.floor

local Kit = {}
Kit.data = KIT

local FOLLOW = {} -- [기술] = true: 장치와 사출기가 따라붙는 기술(도끼질 · 베기 · 낫질 · 대검 · 주먹)
for _, k in KIT do
	for _, id in k.skills do
		FOLLOW[id] = true
	end
end

-- 스킬 레벨의 효과(sim/hero.luau의 skillScale과 같은 셈 — 레벨 1에서 floor, 마스터에서 1. 배우지 않았으면 0)
local function scaleOf(lv: number, max: number): number
	if lv <= 0 then
		return 0
	end
	return FLOOR + (1 - FLOOR) * (if max > 1 then (lv - 1) / (max - 1) else 1)
end

-- 2~4차의 패시브 하나의 값과 세기(배우지 않았으면 nil, 0)
local function pass(h, id: string)
	local def = PASS[id]
	local lv = h.skills[id] or 0
	if not def or lv <= 0 or def.who ~= h.class then
		return nil, 0
	end
	return def.fx, scaleOf(lv, def.max)
end

-- 힘 모으기의 단계(액시온: 깊은 호흡을 배우면 3단계) · 모으는 영혼의 수(리퍼: 영혼 주머니) · 달아오르는 열기(살라맨더: 끓는 피)
function Kit.chargeLevels(h): number
	local fx = pass(h, "ax_charge2")
	return if fx then fx.levels else (KIT[h.class].core.levels or 0)
end
function Kit.soulMax(h): number
	local fx = pass(h, "rp_soul2")
	return if fx then fx.souls else KIT.reaper.core.max
end
function Kit.hotAt(h): number
	local fx = pass(h, "sl_heat2")
	return if fx then fx.hot else KIT.salamander.core.hot
end

-- 그 스킬이 어느 직업의 어느 갈래인가({ who, role("toggle" · "core" · "passive"), max } — 장치가 아니면 nil)
function Kit.skill(id: any)
	return if typeof(id) == "string" then SKILL[id] else nil
end

-- 그 캐릭터의 그 갈래의 자료 · 레벨 · 세기(레벨의 효과)
function Kit.def(h, role: string)
	return KIT[h.class][role]
end

function Kit.level(h, role: string): number
	return h.skills[KIT[h.class][role].id] or 0
end

function Kit.scale(h, role: string): number
	local def = KIT[h.class][role]
	return scaleOf(h.skills[def.id] or 0, SKILL[def.id].max)
end

-- 그 기술에 장치와 사출기가 따라붙는가
function Kit.follows(skillId: any): boolean
	return FOLLOW[skillId] == true
end

-- 캐릭터에 얹는 그때그때의 상태. 저장하는 것은 사출기를 켰는지(on)뿐이다(sim/hero.luau의 pack)
--  n = 사출기가 센 타수 · at = 사출기가 마지막으로 나간 때(방의 시간) · souls · soulT = 영혼과 마지막으로 얻은 뒤 흐른 시간 · heat · heatT = 열기와 마지막으로 맞힌 뒤 흐른 시간 · regen = 아직 차지 않은 회복의 소수
function Kit.init(h)
	h.kit = { on = false, n = 0, at = -1e9, souls = 0, soulT = 0, heat = 0, heatT = 0, regen = 0 }
end

-- ---------- 온오프 사출기 ----------
-- 그 스킬이 이 캐릭터의 (배운) 사출기인가
function Kit.isToggle(h, id: any): boolean
	local def = KIT[h.class].toggle
	return def.id == id and (h.skills[id] or 0) > 0
end

-- 사출기를 켜고 끈다. 바뀐 뒤의 상태를 돌려준다(배우지 않았으면 nil)
function Kit.toggle(h): boolean?
	if Kit.level(h, "toggle") < 1 then
		return nil
	end
	h.kit.on = not h.kit.on
	return h.kit.on
end

-- 사출기가 나가는가(켜 두었고 배웠다)
function Kit.firing(h): boolean
	return h.kit.on and Kit.level(h, "toggle") > 0
end

-- ---------- 늘 걸려 있는 것 ----------
-- 공격력의 배수: 리퍼의 영혼(하나마다 each%)
function Kit.attack(h): number
	if h.class == "reaper" and h.kit.souls > 0 then
		return 1 + h.kit.souls * KIT.reaper.core.each / 100 * Kit.scale(h, "core")
	end
	return 1
end

-- 최대 체력의 배수: 액시온의 묵직한 몸
function Kit.maxHp(h): number
	if h.class == "axion" then
		return 1 + KIT.axion.passive.hp / 100 * Kit.scale(h, "passive")
	end
	return 1
end

-- 달아올랐는가(살라맨더: 열기가 hot 이상)
function Kit.hot(h): boolean
	return h.class == "salamander" and Kit.level(h, "core") > 0 and h.kit.heat >= Kit.hotAt(h)
end

-- 걸음 · 뛰는 힘의 배수: 리븐의 날랜 몸 · 살라맨더의 뜨거운 피(달아오름 동안)
function Kit.move(h): (number, number)
	if h.class == "riven" then
		local p, s = KIT.riven.passive, Kit.scale(h, "passive")
		return 1 + p.run / 100 * s, 1 + p.jump / 100 * s
	elseif h.class == "salamander" and Kit.hot(h) then
		return 1 + KIT.salamander.passive.run / 100 * Kit.scale(h, "passive"), 1
	end
	return 1, 1
end

-- 맞지 않을 확률(0~1): 리븐의 날랜 몸
function Kit.dodge(h): number
	if h.class == "riven" then
		return KIT.riven.passive.dodge / 100 * Kit.scale(h, "passive")
	end
	return 0
end

-- 받는 피해의 배수: 무니의 지키는 마음(near = 내 수정 곁인가 — 그러면 두 배로 준다)
function Kit.cut(h, near: boolean?): number
	if h.class == "mooni" then
		local p = KIT.mooni.passive
		return 1 - p.cut / 100 * Kit.scale(h, "passive") * (if near then p.nearMul else 1)
	end
	return 1
end

-- ---------- 힘 모으기(액시온) ----------
-- 단계마다 붙는 피해(레벨 1 ~ 마스터 사이를 고르게 — 공방의 chargeBonus와 같은 셈)
function Kit.chargeBonus(lv: number, max: number): number
	if lv <= 0 then
		return 0
	end
	local b = KIT.axion.core.bonus
	return b[1] + (b[2] - b[1]) * (if max > 1 then (lv - 1) / (max - 1) else 1)
end

-- 그 기술을 held초 동안 모았을 때: 단계 · 피해의 배수 · 더 닿는 거리(도트). 모을 수 없는 기술 · 배우지 않았으면 0 · 1 · 0
function Kit.charge(h, skillId: string, held: number): (number, number, number)
	local core = KIT[h.class].core
	local per = core.per and core.per[skillId]
	local lv = h.skills[core.id] or 0
	if not per or lv < 1 or held <= 0 then
		return 0, 1, 0
	end
	local level = math.clamp(math.floor(held / per + 1e-6), 0, Kit.chargeLevels(h))
	return level, 1 + level * Kit.chargeBonus(lv, SKILL[core.id].max), level * core.reach
end

-- 그 기술을 가장 오래 모으는 시간(초 — 모을 수 없으면 0)
function Kit.chargeTime(h, skillId: string): number
	local core = KIT[h.class].core
	local per = core.per and core.per[skillId]
	if not per or (h.skills[core.id] or 0) < 1 then
		return 0
	end
	return per * Kit.chargeLevels(h)
end

-- 그 단계로 쳤을 때의 피해의 배수 · 더 닿는 거리(서버가 단계를 따로 정했을 때 — 넘치는 힘)
function Kit.chargeAt(h, level: number): (number, number)
	local core = KIT[h.class].core
	return 1 + level * Kit.chargeBonus(h.skills[core.id] or 0, SKILL[core.id].max), level * (core.reach or 0)
end

-- ---------- 맞혔을 때 · 쓰러뜨렸을 때(방이 부른다) ----------
-- 영혼을 하나 얻는다(리퍼). 늘었으면 true
function Kit.gainSoul(h): boolean
	if h.class ~= "reaper" or Kit.level(h, "core") < 1 then
		return false
	end
	local k = h.kit
	k.soulT = 0
	if k.souls >= Kit.soulMax(h) then
		return false
	end
	k.souls += 1
	return true
end

-- 주먹이 맞았다: 열기가 오른다(살라맨더). 맞힌 뒤에 달아올라 있는지를 돌려준다
function Kit.gainHeat(h): boolean
	if h.class ~= "salamander" or Kit.level(h, "core") < 1 then
		return false
	end
	local core, k = KIT.salamander.core, h.kit
	local fx, s = pass(h, "sl_heat2") -- 끓는 피: 더 빨리 오른다
	k.heat = math.min(core.max, k.heat + core.gain * (1 + (if fx then fx.gain * s else 0)))
	k.heatT = 0
	return k.heat >= Kit.hotAt(h)
end

-- ---------- 한 걸음 ----------
-- 시간이 흐른다: 영혼이 흩어지고, 열기가 식고, 체력이 찬다. 돌려주는 것: 장치의 모습이 바뀌었는가(화면에 알린다) · 되찾은 체력(없으면 0)
function Kit.tick(h, dt: number): (boolean, number)
	local k = h.kit
	local changed, healed = false, 0
	if h.class == "reaper" and k.souls > 0 then
		k.soulT += dt
		if k.soulT >= KIT.reaper.core.decay then
			k.soulT = 0
			k.souls -= 1
			changed = true
		end
	elseif h.class == "salamander" then
		local core = KIT.salamander.core
		if k.heat > 0 then
			k.heatT += dt
			if k.heatT > core.cool then
				local before = k.heat
				local fx, s = pass(h, "sl_heat2") -- 끓는 피: 천천히 식는다
				local hot = Kit.hotAt(h)
				k.heat = math.max(0, k.heat - core.decay * (1 - (if fx then fx.slow * s else 0)) * math.min(dt, k.heatT - core.cool)) -- cool초를 넘긴 만큼만 식는다
				-- 화면의 숫자(5 단위) · 달아오름이 바뀔 때만 알린다
				changed = math.floor(before / 5) ~= math.floor(k.heat / 5) or (before >= hot) ~= (k.heat >= hot)
			end
		end
		-- 뜨거운 피: 초마다 최대 체력의 regen%
		local s = Kit.scale(h, "passive")
		if s > 0 and h.alive and h.hp < h.maxHp then
			k.regen += h.maxHp * KIT.salamander.passive.regen / 100 * s * dt
			if k.regen >= 1 then
				healed = math.min(math.floor(k.regen), h.maxHp - h.hp)
				k.regen -= math.floor(k.regen)
				h.hp += healed
			end
		else
			k.regen = 0
		end
	end
	return changed, healed
end

-- ---------- 화면에 보내는 것 ----------
-- on = 사출기를 켰는가 · souls = 영혼 · heat = 열기(정수) · hot = 달아올랐는가
function Kit.view(h)
	local k = h.kit
	return { on = k.on, souls = k.souls, heat = math.floor(k.heat), hot = Kit.hot(h) }
end

return Kit

end
MODULES['ReplicatedStorage/shared/lune/sim/lines'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 타수 나누기(2026-10-14) — 공격 스킬의 한 타를 여러 줄(숫자 여럿)로 쪼갠다. 피해의 합은 그대로다.
--  사용자: "현재 스킬들 거의다 타수가 너무 적습니다. 동일데미지에서 타수분할을 하세요 7~8번 다다다다다 데미지가 올라오는맛이 있어야합니다.
--   극딜기의 경우 더 높은 타수가 들어가야하구요 100% 데미지로 1타가 아닌 10% 데미지로 10번 이런식이여야합니다."
--  규칙은 공방 design/combat.js의 COMBAT.lines(→ combat.generated의 rules.lines): 한 번 쓸 때 붙어 있는 적 한 마리가 받는 줄이 per(극딜기 = 큰 기술은 nuke)쯤 되게
--   타마다의 줄 수 = per ÷ (한 번 쓸 때 그 적이 맞는 타의 수)를 반올림(1 ~ max), 그래도 per - 1보다 적으면 한 줄 더. 공방의 linesFor · firstLines와 같은 셈이다(스킬 창의 글이 같은 수를 적는다).
--  쪼개는 것은 서버(sim/room.luau의 Room:strike — 피해는 한 번에 넣고 숫자만 여러 줄로 적는다), 줄을 하나씩 위로 쌓아 띄우는 것은 화면(client/lune/boot.luau의 Hits).
local root = script.Parent.Parent
local COMBAT = require(root.data["combat.generated"])

local R = COMBAT.rules.lines

local Lines = {}
Lines.R = R

-- 타마다의 줄 수. hits = 한 번 쓸 때 그 적이 맞는 타의 수(평균이어도 된다) · nuke = 극딜기 · job = 그 스킬의 차수
--  (2026-10-15 — 사용자: "현재 저 차수 스킬은 타수가 너무 많습니다. 타수는 밸런스 있게 맞추고" → per · nuke가 차수마다 — 1차 3 · 2차 4 · 3차 6 · 4차 8줄, 극딜기 5 · 7 · 10 · 15줄)
function Lines.count(hits: number, nuke: boolean?, job: number?): number
	if not hits or hits <= 0 then
		return 1
	end
	local tier = math.clamp(job or 4, 1, 4)
	local per = (if nuke then R.nuke else R.per)[tier]
	local L = math.clamp(math.floor(per / hits + 0.5), 1, R.max)
	if hits * L < per - 1 then
		L = math.min(R.max, L + 1) -- 반올림으로 모자라면 한 줄 더: 적어도 per - 1
	end
	return L
end

-- 1차의 사냥기 · 보스기: 가운데 타(범위 밖으로 번진 타 — except — 는 빼고)의 수로 정한다. 공격 스킬이 아니면 1
local first: { [string]: number } = {}
function Lines.first(id: string?): number
	if not id then
		return 1
	end
	local got = first[id]
	if got then
		return got
	end
	local def = COMBAT.skills[id]
	local n = 0
	if def and def.job == 1 and def.hits then
		for _, h in def.hits do
			if not h.except then
				n += 1
			end
		end
	end
	got = if n > 0 then Lines.count(n, false, 1) else 1
	first[id] = got
	return got
end

-- 피해 total을 n줄로 쪼갠다(줄마다 ±jitter만큼 다르게 — 합은 꼭 total, 줄마다 1 이상). rng = 방의 Random(없으면 고르게 나눈다)
function Lines.split(total: number, n: number, rng: Random?): { number }
	n = math.clamp(math.floor(n), 1, math.max(1, math.floor(total)))
	if n == 1 then
		return { total }
	end
	local weights, sum = table.create(n), 0
	for i = 1, n do
		local w = 1 + (if rng then rng:NextNumber(-R.jitter, R.jitter) else 0)
		weights[i] = w
		sum += w
	end
	local out, given, acc = table.create(n), 0, 0
	for i = 1, n do
		acc += weights[i]
		local upto = if i == n then total else math.floor(total * acc / sum + 0.5)
		local d = math.max(1, upto - given)
		if i < n then
			d = math.min(d, total - given - (n - i)) -- 남은 줄이 1씩은 가져가게
		else
			d = total - given
		end
		out[i] = d
		given += d
	end
	return out
end

return Lines

end
MODULES['ReplicatedStorage/shared/lune/sim/market'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 경매장의 셈 — 장부(저장소의 문서 하나)를 바꾸는 법과, 계정의 「맡긴 것」을 장부와 견주는 법. 저장소는 모른다(읽고 쓰는 것은 server/lune/modules/store.luau, 흐름은 world.luau).
--  사용자 2026-10-06: "경매장으로 전부 거래가능하게 할겁니다" · 2026-10-13: "경매장 부터 진행합시다.  알아서 조사하고 판단하고 해서  경매장 구현 해보세요"
--  **사용자 2026-10-13(처음 만든 것을 보고): "메이플 식 경매장을 말하는거긴합니다."** — 메이플스토리의 메이플 옥션 방식이다:
--    값을 매겨 올리고 그 값에 바로 산다(입찰 없음) · 소비와 기타 아이템은 **개당 가격**으로 올리고 **낱개로** 팔린다 · 올릴 때 보증금(다 팔리면 돌려받는다) ·
--    산 것 · 대금 · 안 팔린 것은 모두 「완료」에서 받는다(수령 · 대금 수령 · 반환 / 재등록) · 분류마다 최근 거래를 남겨 시세로 보여 준다.
--  규칙과 숫자는 공방 js/lune/design/economy.js의 AUCTION(→ data/items.generated.luau의 MARKET).
--
--  장부(분류마다 하나 — 무기는 직업마다 w_<직업> · 방어구는 부위마다 a_<부위> · 소비 u · 기타 e): { v = 2, list = { 줄 … }, log = { 최근 거래 … } }
--   줄 = { id, u = 판 사람(번호), sn = 그 캐릭터의 이름, it = 올린 물건(처음의 수 그대로), p = 값(개당), t = 올린 때, e = 기간이 끝나는 때(os.time),
--          l = 남은 수(장비는 1 → 0), c = 1(판 사람이 닫았다 — 더 팔리지 않는다. 없으면 열려 있다), b = 최근 구매 몇 건 { { u = 산 사람, q = 수, k = 그 구매의 표 } … } }
--   물건(it) = 장비 { slot, stage, q, star, who("" = 없음), fails, broken(0/1) } · 묶음 { g = 이름표, n = 수 }
--   최근 거래(log) = { { it = 그때 팔린 것(묶음은 팔린 수), p = 개당 값, t = 때 } … } — 새것이 뒤에. logMax건 · logDays일까지만 둔다.
--  한 줄은 장부의 UpdateAsync 한 번으로만 바뀐다(아래의 tx…는 그때 불리는 함수 — 받은 문서를 고치지 않고, 여러 번 불려도 같은 답을 낸다):
--    올리기 = 줄을 더한다 · 사기 = 남은 수를 줄인다 · 닫기 = 「닫았다」를 적는다(취소 · 반환 · 재등록의 첫걸음) · 매듭 = 줄을 지운다(판 사람의 계정이 저장된 뒤)
--   두 서버에서 같은 줄을 같이 사려 해도 남은 수만큼만 팔린다.
--
--  물건과 달돈이 복사되거나 사라지지 않게(계정의 「맡긴 것」 — acct.market.list):
--    판 것   [줄 번호] = { b = 장부, it = 올린 물건, p = 개당 값, t, e, got = 대금을 받은 수, d = 낸 보증금 }
--    산 것   ["h_…"]   = { hold = true, it = 산 물건, p = 치른 값, t } — 「완료」의 「낙찰」(「수령」하면 가방으로)
--   판 물건의 운명은 「맡긴 것」과 장부의 줄을 견주어 정한다(Market.resolve):
--     팔린 수 = 올린 수 − 줄의 남은 수 · 받을 대금 = (팔린 수 − got)개의 값. **대금을 받으면 got만 늘린다 — 장부는 고치지 않는다**(받은 것의 기록은 판 사람의 계정이다).
--     줄이 없다 → back(올린 것이 장부에 적히지 못했다 — 물건과 보증금이 돌아온다) · 보관 기간(KEEP)이 지났다 → void(사라진다)
--   올릴 때: 가방에서 빼 「맡긴 것」에 넣고 **계정을 먼저 저장한 뒤** 장부에 줄을 더한다.
--   끝낼 때(취소 · 반환 · 다 팔린 것): 줄을 닫는다(남은 수가 굳는다) → 남은 것을 돌려받고 대금을 받고 「맡긴 것」에서 지운다 → **계정을 저장한 뒤에야** 줄을 지운다.
--    도중에 서버가 꺼지면 「맡긴 것」과 닫힌 줄이 남아 있어 다음에 같은 셈을 다시 한다 — 같은 대금을 두 번 받거나 물건이 둘이 되는 길이 없다.
--   장부가 끝없이 불어나지 않게, 기간이 끝나고 KEEP이 지난 줄은 지운다(그때는 「맡긴 것」도 void다).
local Items = require(script.Parent.items)
local CLASSES = require(script.Parent.Parent.data["classes.generated"])

local D = Items.data
local M = D.MARKET

local Market = {}
Market.DATA = M
Market.WORDS = M.words
Market.WHY = M.words.why
Market.KEEP = M.keepDays * 86400 -- 기간이 끝난 뒤 보관하는 시간(초)
Market.LOG_KEEP = M.logDays * 86400 -- 시세에 남겨 두는 시간(초)
Market.VERSION = 2

local function whole(v: any, lo: number, hi: number): boolean
	return typeof(v) == "number" and v == math.floor(v) and v >= lo and v <= hi
end

-- ---------- 물건의 꼴 ----------
-- 가방의 것(장비 · 묶음 { item, n }) → 장부에 적는 꼴
function Market.pack(it: any)
	if typeof(it) ~= "table" then
		return nil
	elseif it.item ~= nil then
		return { g = it.item, n = it.n }
	end
	return { it.slot, it.stage, it.q, it.star, it.who or "", it.fails or 0, if it.broken then 1 else 0 }
end

-- 장부의 꼴 → 가방의 것(꼴이 맞지 않으면 nil). 장비에는 번호(id)가 없다 — 가방에 넣을 때 붙는다
function Market.unpack(row: any)
	if typeof(row) ~= "table" then
		return nil
	end
	if row.g ~= nil then
		local def = Items.goods(row.g)
		if not def or not whole(row.n, 1, def.stack) then
			return nil
		end
		return { item = row.g, n = row.n }
	end
	local it = { slot = row[1], stage = row[2], q = row[3], star = row[4], who = if row[5] ~= "" then row[5] else nil, fails = row[6], broken = row[7] == 1 }
	if not Items.valid(it) or not whole(it.fails, 0, 9) then
		return nil
	end
	if it.slot ~= "weapon" then
		it.who = nil
	end
	return it
end

-- 그 물건의 수(장비는 하나) · 같은 물건을 n개로(장비는 그대로 — 새 표를 돌려준다)
function Market.units(row: any): number
	if typeof(row) == "table" and row.g ~= nil then
		return if typeof(row.n) == "number" then row.n else 0
	end
	return 1
end
function Market.withUnits(row: any, n: number)
	if row.g ~= nil then
		return { g = row.g, n = n }
	end
	return table.clone(row)
end

-- 올릴 수 있는 물건인가 → true, 아니면 nil과 까닭. 퀘스트의 물건 · 부서진 장비는 못 올린다
function Market.sellable(it: any): (boolean?, string?)
	local row = Market.pack(it)
	local back = Market.unpack(row)
	if not back then
		return nil, Market.WHY.item
	end
	if back.item then
		local def = Items.goods(back.item)
		if def.quest then
			return nil, Market.WHY.quest
		end
	elseif back.broken then
		return nil, Market.WHY.item -- 부서진 장비(강화하다 부서진 것 — 되살려야 쓴다)는 올리지 못한다(내 판단: 모르고 사는 일이 없게)
	end
	return true
end

-- 그 물건이 올라가는 장부의 이름
function Market.boardOf(row: any): string?
	local it = Market.unpack(row)
	if not it then
		return nil
	elseif it.item then
		return if Items.goods(it.item).tab == "use" then "u" else "e"
	elseif it.slot == "weapon" then
		return "w_" .. tostring(it.who)
	end
	return "a_" .. it.slot
end

-- 화면의 분류: 무기(직업마다 장부가 다르다) · 방어구의 부위들 · 소비 · 기타 → { { id, name, weapon } … }
function Market.cats()
	local out = {}
	for _, slot in D.GEAR do
		local name = slot
		for _, def in D.SLOTS do
			if def.id == slot then
				name = def.name
			end
		end
		table.insert(out, { id = slot, name = name, weapon = slot == "weapon" })
	end
	table.insert(out, { id = "use", name = D.BAG.tabs[2], weapon = false })
	table.insert(out, { id = "etc", name = D.BAG.tabs[3], weapon = false })
	return out
end
function Market.catBoard(cat: string, class: string): string
	if cat == "weapon" then
		return "w_" .. class
	elseif cat == "use" then
		return "u"
	elseif cat == "etc" then
		return "e"
	end
	return "a_" .. cat
end
-- 있는 장부 모두(무기는 직업마다 · 방어구는 부위마다 · 소비 · 기타)
function Market.boards(): { string }
	local out = {}
	for _, id in CLASSES.order do
		table.insert(out, "w_" .. id)
	end
	for _, slot in D.GEAR do
		if slot ~= "weapon" then
			table.insert(out, "a_" .. slot)
		end
	end
	table.insert(out, "u")
	table.insert(out, "e")
	return out
end
-- 있는 장부의 이름인가(밖에서 온 글을 그대로 열쇠로 쓰지 않는다)
function Market.isBoard(key: any): boolean
	if typeof(key) ~= "string" then
		return false
	elseif key == "u" or key == "e" then
		return true
	end
	local kind, rest = string.match(key, "^(%a)_(%w+)$")
	if kind == "w" then
		return CLASSES.classes[rest] ~= nil
	elseif kind == "a" and rest ~= "weapon" then
		for _, slot in D.GEAR do
			if slot == rest then
				return true
			end
		end
	end
	return false
end

-- 글로 적는 물건의 이름(알림에 쓴다): 장비 = 이름 +별 · 묶음 = 이름 x수
function Market.nameOf(row: any): string
	local it = Market.unpack(row)
	if not it then
		return "?"
	elseif it.item then
		local def = Items.goods(it.item)
		return if it.n > 1 then ("%s x%d"):format(def.name, it.n) else def.name
	end
	return Items.name(it) -- (2026-10-15부터 「+별」을 붙이지 않는다)
end

-- ---------- 값 ----------
-- 값(개당)은 1부터 priceMax까지의 정수
function Market.priceOk(p: any): boolean
	return whole(p, 1, M.priceMax)
end
function Market.hoursOk(h: any): boolean
	for _, v in M.hours do
		if v == h then
			return true
		end
	end
	return false
end
-- 대금(amount)을 받을 때 떼는 수수료 · 받는 금액
function Market.fee(amount: number): number
	return math.floor(amount * M.fee / 100)
end
function Market.payout(amount: number): number
	return amount - Market.fee(amount)
end

-- ---------- 장부 ----------
-- 줄의 상태: "soldout"(다 팔렸다) · "ended"(판 사람이 닫았거나 기간이 끝났다 — 남은 것이 있다) · "selling"
function Market.stateOf(entry, now: number): string
	if entry.l <= 0 then
		return "soldout"
	elseif entry.c == 1 or now >= entry.e then
		return "ended"
	end
	return "selling"
end

-- 장부를 읽을 꼴로(없거나 꼴이 깨졌으면 빈 장부). 보관 기간이 지난 줄 · 오래된 거래 기록은 버린다. 받은 표는 건드리지 않고 새 표를 돌려준다
local function fresh(doc: any, now: number)
	local list, log = {}, {}
	if typeof(doc) == "table" and typeof(doc.list) == "table" then
		for _, e in doc.list do
			if typeof(e) == "table" and typeof(e.id) == "string" and typeof(e.e) == "number" and typeof(e.l) == "number" and now < e.e + Market.KEEP then
				local copy = table.clone(e) -- 받은 줄을 고치지 않는다(저장소가 이 함수를 다시 불러도 같은 답)
				copy.b = if typeof(e.b) == "table" then table.clone(e.b) else {}
				table.insert(list, copy)
			end
		end
	end
	if typeof(doc) == "table" and typeof(doc.log) == "table" then
		for _, r in doc.log do
			if typeof(r) == "table" and typeof(r.t) == "number" and now < r.t + Market.LOG_KEEP then
				table.insert(log, r)
			end
		end
		while #log > M.logMax do
			table.remove(log, 1)
		end
	end
	return { v = Market.VERSION, list = list, log = log }
end
Market.fresh = fresh

local function find(list, id: any)
	for i, e in list do
		if e.id == id then
			return e, i
		end
	end
	return nil, nil
end

-- 새 줄(price = 개당 값)
function Market.entry(id: string, userId: number, seller: string, row: any, price: number, hours: number, now: number)
	return { id = id, u = userId, sn = seller, it = row, p = price, t = now, e = now + hours * 3600, l = Market.units(row), b = {} }
end

-- 올린다: 새 장부, 아니면 nil과 까닭(판매 중인 줄이 cap에 찼다). 같은 번호가 이미 있으면 올린 것으로 친다(다시 불렸다)
function Market.txList(doc: any, entry, now: number)
	local out = fresh(doc, now)
	local selling = 0
	for _, e in out.list do
		if e.id == entry.id then
			return out, nil
		end
		if Market.stateOf(e, now) == "selling" then
			selling += 1
		end
	end
	if selling >= M.cap then
		return nil, Market.WHY.full
	end
	table.insert(out.list, entry)
	return out, nil
end

-- 그 줄에 그 표(token)의 구매가 적혀 있는가
local function bought(e, buyerId: number, token: string): boolean
	for _, r in e.b or {} do
		if typeof(r) == "table" and r.u == buyerId and r.k == token then
			return true
		end
	end
	return false
end

-- 산다: 새 장부와 그 줄, 아니면 nil과 까닭. q = 사는 수 · price = 사는 사람이 본 값(개당) · token = 이 구매의 표(같은 구매가 두 번 불려도 한 번만 친다)
function Market.txBuy(doc: any, id: any, buyerId: number, q: number, price: any, now: number, token: string)
	local out = fresh(doc, now)
	local e = find(out.list, id)
	if e and bought(e, buyerId, token) then
		return nil, nil, e -- 이 구매는 이미 적혀 있다(다시 불렸다): 그대로 둔다 — 산 것으로 친다
	elseif not e or e.l <= 0 or e.c == 1 then
		return nil, Market.WHY.gone, nil
	elseif now >= e.e then
		return nil, Market.WHY.expired, nil
	elseif e.u == buyerId then
		return nil, Market.WHY.mine, nil
	elseif e.p ~= price then
		return nil, Market.WHY.changed, nil
	elseif not whole(q, 1, e.l) then
		return nil, Market.WHY.count, nil
	end
	e.l -= q
	table.insert(e.b, { u = buyerId, q = q, k = token })
	while #e.b > M.lastBuys do
		table.remove(e.b, 1)
	end
	table.insert(out.log, { it = Market.withUnits(e.it, q), p = e.p, t = now })
	while #out.log > M.logMax do
		table.remove(out.log, 1)
	end
	return out, nil, e
end

-- 줄을 닫는다(판 사람이 — 취소 · 반환 · 재등록의 첫걸음): 더 팔리지 않고 남은 수가 굳는다. 돌려주는 것: 새 장부(바뀐 것이 없으면 nil), "closed" · "none"(줄이 없다), 굳은 남은 수
function Market.txClose(doc: any, id: any, userId: number, now: number)
	local out = fresh(doc, now)
	local e = find(out.list, id)
	if not e or e.u ~= userId then
		return nil, "none", 0
	elseif e.c == 1 then
		return nil, "closed", e.l
	end
	e.c = 1
	return out, "closed", e.l
end

-- 줄을 지운다(판 사람의 계정이 저장된 뒤 — 그 줄에서 받을 것을 다 받았다). 없으면 그대로
function Market.txSettle(doc: any, id: any, userId: number, now: number)
	local out = fresh(doc, now)
	local e, i = find(out.list, id)
	if not e or e.u ~= userId then
		return nil, "none"
	end
	table.remove(out.list, i)
	return out, "ok"
end

-- 그 사람의 줄을 모두 지운다(관리자의 시험 물건을 치울 때 — 판 사람의 번호가 0인 줄). 돌려주는 것: 새 장부(지운 것이 없으면 nil), 지운 수
function Market.txPurge(doc: any, userId: number, now: number)
	local out = fresh(doc, now)
	local kept, removed = {}, 0
	for _, e in out.list do
		if e.u == userId then
			removed += 1
		else
			table.insert(kept, e)
		end
	end
	if removed == 0 then
		return nil, 0
	end
	out.list = kept
	return out, removed
end

-- 사려는 사람에게 보여 줄 줄들: 판매 중인 것만, 싼 것부터(값이 같으면 먼저 올린 것부터) show개까지 → { { id, it(남은 수로), p(개당), sn, e, t, l, mine } … }
function Market.rows(doc: any, now: number, viewer: number?)
	local rows = {}
	for _, e in fresh(doc, now).list do
		if Market.stateOf(e, now) == "selling" and Market.unpack(e.it) then
			table.insert(rows, { id = e.id, it = Market.withUnits(e.it, e.l), p = e.p, sn = e.sn, e = e.e, t = e.t, l = e.l, mine = e.u == viewer })
		end
	end
	table.sort(rows, function(a, b)
		if a.p ~= b.p then
			return a.p < b.p
		elseif a.t ~= b.t then
			return a.t < b.t
		end
		return a.id < b.id
	end)
	while #rows > M.show do
		table.remove(rows)
	end
	return rows
end

-- 시세: 그 분류의 최근 거래(새것부터 show개까지) → { { it, p(개당), t } … }
function Market.trades(doc: any, now: number)
	local log = fresh(doc, now).log
	local out = {}
	for i = #log, 1, -1 do
		local r = log[i]
		if Market.unpack(r.it) and typeof(r.p) == "number" then
			table.insert(out, { it = r.it, p = r.p, t = r.t })
			if #out >= M.show then
				break
			end
		end
	end
	return out
end

-- 장부에서 그 번호의 줄(누구의 것이든)
function Market.entryById(doc: any, id: any)
	if typeof(doc) ~= "table" or typeof(doc.list) ~= "table" then
		return nil
	end
	for _, e in doc.list do
		if typeof(e) == "table" and e.id == id and typeof(e.l) == "number" then
			return e
		end
	end
	return nil
end
-- 그 줄에 그 사람의 그 구매(token)가 적혀 있으면 그 줄(저장소가 답하지 않았을 때 — 적혔는지 다시 읽어 본다)
function Market.boughtBy(doc: any, id: any, buyerId: number, token: string)
	local e = Market.entryById(doc, id)
	if e and bought(e, buyerId, token) then
		return e
	end
	return nil
end
-- 장부에서 내 줄을 찾는다. 보관 기간이 지난 줄은 없는 것으로 본다(장부를 고칠 때 버려지는 줄 — fresh와 같은 규칙: 그때는 맡긴 것도 void다)
function Market.entryIn(doc: any, id: string, userId: number, now: number)
	local e = Market.entryById(doc, id)
	if e and e.u == userId and typeof(e.e) == "number" and now < e.e + Market.KEEP then
		return e
	end
	return nil
end

-- ---------- 계정의 「맡긴 것」 ----------
-- 새 계정의 것
function Market.newBook()
	return { seq = 0, list = {} }
end

-- 다음 줄의 번호(판 사람 안에서 겹치지 않는다 · 사람 번호가 들어 있어 사람끼리도 겹치지 않는다)
function Market.nextId(book, userId: number, now: number): string
	book.seq += 1
	return ("%d_%d_%d"):format(userId, now, book.seq)
end
-- 구매 하나의 표(때와 차례 — 서버가 꺼졌다 켜져 차례가 되돌아가도 때가 달라 겹치지 않는다)
function Market.nextToken(book, now: number): string
	book.seq += 1
	return ("%d_%d"):format(now, book.seq)
end

-- 올려 둔 것의 수(다 받기 전의 것도 센다 — 판매 slots) · 받지 않은 구매품의 수(holdMax)
function Market.count(book): number
	local n = 0
	for _, h in book.list do
		if not h.hold then
			n += 1
		end
	end
	return n
end
function Market.holds(book): number
	local n = 0
	for _, h in book.list do
		if h.hold then
			n += 1
		end
	end
	return n
end

-- 「맡긴 것」 하나와 장부의 그 줄(없으면 nil)을 견준다 → { state, n(올린 수), left(장부에 남은 수 — 돌려받을 수), sold(팔린 수), due(대금을 아직 받지 않은 수) }
--  state: "hold"(산 것 — 수령할 것) · "selling" · "ended"(닫혔거나 기간이 끝났다 — 남은 것을 돌려받는다) · "soldout"(다 팔렸다) · "back"(줄이 없다 — 물건이 돌아온다) · "void"(보관 기간이 지났다)
function Market.resolve(handle, entry: any, now: number)
	if handle.hold then
		return { state = "hold", n = Market.units(handle.it), left = 0, sold = 0, due = 0 }
	end
	local n, got = Market.units(handle.it), handle.got or 0
	if not entry then
		local gone = now >= handle.e + Market.KEEP
		return { state = if gone then "void" else "back", n = n, left = math.max(0, n - got), sold = got, due = 0 }
	end
	local left = math.clamp(entry.l, 0, n)
	local sold = n - left
	return { state = Market.stateOf(entry, now), n = n, left = left, sold = sold, due = math.max(0, sold - got) }
end

-- 지금 받을 금액. r = resolve의 답 → { gross(팔린 값), fee(수수료), pay(대금 — 수수료를 뗀 것), deposit(돌려받는 보증금) }
--  보증금은 다 팔렸을 때(남은 수 0) 마지막 대금과 함께, 그리고 올린 것이 장부에 적히지 못했을 때(back) 돌아온다. 취소 · 미판매는 돌려받지 못한다(메이플 옥션)
function Market.amount(handle, r)
	local gross = r.due * handle.p
	local fee = Market.fee(gross)
	local deposit = 0
	if (r.state ~= "back" and r.left == 0) or (r.state == "back" and (handle.got or 0) == 0) then
		deposit = handle.d or 0
	end
	return { gross = gross, fee = fee, pay = gross - fee, deposit = deposit }
end

-- 저장할 꼴 · 읽기(꼴이 맞는 것만)
function Market.packBook(book)
	local rows = {}
	for id, h in book.list do
		table.insert(rows, { id = id, b = h.b or "", it = h.it, p = h.p or 0, t = h.t or 0, e = h.e or 0, got = h.got or 0, d = h.d or 0, hold = h.hold == true })
	end
	table.sort(rows, function(a, b)
		return a.id < b.id
	end)
	return { seq = book.seq, list = rows }
end
function Market.unpackBook(data: any)
	local book = Market.newBook()
	if typeof(data) ~= "table" then
		return book
	end
	book.seq = if whole(data.seq, 0, 9e9) then data.seq else 0
	if typeof(data.list) == "table" then
		for _, r in data.list do
			if typeof(r) == "table" and typeof(r.id) == "string" and #r.id <= 60 and Market.unpack(r.it) and whole(r.p, 0, 9e15) and whole(r.t, 0, 9e12) then
				if r.hold == true then
					book.list[r.id] = { hold = true, it = r.it, p = r.p, t = r.t, e = r.t }
				elseif Market.isBoard(r.b) and whole(r.e, 0, 9e12) then
					local n = Market.units(r.it)
					book.list[r.id] = { b = r.b, it = r.it, p = r.p, t = r.t, e = r.e, got = if whole(r.got, 0, n) then r.got else 0, d = if whole(r.d, 0, 9e9) then r.d else 0 }
				end
			end
		end
	end
	return book
end

return Market

end
MODULES['ReplicatedStorage/shared/lune/sim/party'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 파티 — 넷까지(사용자 결정). 초대 → 받기 / 거절, 나가기, 파티장 넘기기(파티장이 나가면 먼저 들어온 사람에게), 둘 아래로 줄면 흩어진다.
--  누가 어느 파티인지만 다루는 순수한 셈이다(사람 = 번호). 경험치를 나누는 몫도 여기서 낸다:
--   같은 맵에서 함께 잡으면 몬스터의 경험치 x (1 + 보너스)를 사람 수로 고르게 나눈다(보너스: 둘 10% · 셋 15% · 넷 20% — 공방 「성장 · 장비」 탭의 XPRULE).
--   예: 둘이면 한 사람이 55%씩 — 둘이 잡으면 두 배 빨리 잡으니 혼자일 때의 110%다. 레벨 차이가 20을 넘는 파티원과는 나누지 않는다.
local N = require(script.Parent.Parent.config.numbers)

local RULE = N.data.XPRULE

local Party = {}
Party.MAX = RULE.partyMax
Party.ASK_LIFE = 30 -- 초대가 살아 있는 시간(초)
Party.LEVEL_GAP = 20 -- 이보다 레벨 차이가 크면 경험치를 나누지 않는다

-- 장부: parties[번호] = { id, leader, members = { 들어온 차례대로 } } · of[사람] = 파티 번호 · asks[받은 사람] = { from, at }
function Party.newBook()
	return { parties = {}, of = {}, asks = {}, nextId = 1 }
end

function Party.of(book, who: any)
	local id = book.of[who]
	return if id then book.parties[id] else nil
end

-- 그 사람의 파티원들(자기도 든다). 파티가 없으면 혼자
function Party.members(book, who: any): { any }
	local party = Party.of(book, who)
	return if party then table.clone(party.members) else { who }
end

function Party.same(book, a: any, b: any): boolean
	return a == b or (book.of[a] ~= nil and book.of[a] == book.of[b])
end

-- 살아 있는 초대(시간이 지난 것은 지운다)
function Party.ask(book, to: any, now: number)
	local ask = book.asks[to]
	if ask and now - ask.at > Party.ASK_LIFE then
		book.asks[to] = nil
		return nil
	end
	return ask
end

-- 초대한다. 파티가 없는 사람이 초대하면 받는 순간 파티가 생기고 초대한 사람이 파티장이 된다
function Party.invite(book, from: any, to: any, now: number): (boolean?, string?)
	if from == to then
		return nil, "자기 자신은 초대할 수 없다"
	elseif book.of[to] then
		return nil, "이미 파티가 있는 사람이다"
	end
	local party = Party.of(book, from)
	if party then
		if party.leader ~= from then
			return nil, "파티장만 초대한다"
		elseif #party.members >= Party.MAX then
			return nil, "파티가 가득 찼다"
		end
	end
	if Party.ask(book, to, now) then
		return nil, "이미 초대를 받고 있는 사람이다"
	end
	book.asks[to] = { from = from, at = now }
	return true
end

-- 초대를 받는다. 들어간 파티를 돌려준다
function Party.accept(book, to: any, now: number)
	local ask = Party.ask(book, to, now)
	if not ask then
		return nil, "받은 초대가 없다"
	end
	book.asks[to] = nil
	if book.of[to] then
		return nil, "이미 파티가 있다"
	end
	local party = Party.of(book, ask.from)
	if party and party.leader ~= ask.from then
		return nil, "초대한 사람이 이제 파티장이 아니다" -- 초대한 뒤 남의 파티에 들어갔다(2026-10-18 검토)
	end
	if not party then
		party = { id = book.nextId, leader = ask.from, members = { ask.from } }
		book.nextId += 1
		book.parties[party.id] = party
		book.of[ask.from] = party.id
	end
	if #party.members >= Party.MAX then
		return nil, "파티가 가득 찼다"
	end
	table.insert(party.members, to)
	book.of[to] = party.id
	return party
end

-- 초대를 거절한다. 초대한 사람을 돌려준다(초대가 없었으면 nil)
function Party.decline(book, to: any): any
	local ask = book.asks[to]
	book.asks[to] = nil
	return if ask then ask.from else nil
end

-- 나간다(접속을 끊었을 때도). 돌려주는 것: 남은 사람들(흩어졌으면 그 마지막 한 사람까지), 흩어졌는가
-- 돌려주는 것: 남은 파티원들 · 파티가 흩어졌는가 · 초대가 지워진 사람들(그 사람들의 초대 상자를 닫게 — 2026-10-18 검토)
function Party.leave(book, who: any): ({ any }, boolean, { any })
	book.asks[who] = nil
	-- 나간 사람이 보낸 초대도 지운다(2026-10-18 검토: 접속을 끊은 사람의 초대를 받으면 파티장이 없는 파티가 생겼다)
	local cleared = {}
	for to, ask in book.asks do
		if ask.from == who then
			book.asks[to] = nil
			table.insert(cleared, to)
		end
	end
	local party = Party.of(book, who)
	if not party then
		return {}, false, cleared
	end
	local index = table.find(party.members, who)
	table.remove(party.members, index)
	book.of[who] = nil
	local left = table.clone(party.members)
	if #party.members < 2 then
		for _, m in party.members do
			book.of[m] = nil
		end
		book.parties[party.id] = nil
		return left, true, cleared
	end
	if party.leader == who then
		party.leader = party.members[1]
	end
	return left, false, cleared
end

-- 함께 잡은 사람 수에 따른 보너스 %
function Party.bonus(n: number): number
	local bonus = 0
	for _, row in RULE.party do
		if n >= row.n then
			bonus = row.bonus
		end
	end
	return bonus
end

-- 함께 잡은 사람이 n이면 한 사람이 몬스터 경험치의 몇 배를 받나(혼자면 1)
function Party.share(n: number): number
	if n <= 1 then
		return 1
	end
	return (1 + Party.bonus(n) / 100) / n
end

-- 경험치를 나눌 사람들: killer의 파티원 가운데 here(같은 맵에 있는 살아 있는 사람들 { [번호] = { level } })에 있고 레벨 차이가 20 안쪽인 사람(killer도 든다)
function Party.mates(book, killer: any, here): { any }
	local me = here[killer]
	local list = {}
	for _, m in Party.members(book, killer) do
		local other = here[m]
		if m == killer or (other and me and math.abs(other.level - me.level) <= Party.LEVEL_GAP) then
			table.insert(list, m)
		end
	end
	return list
end

return Party

end
MODULES['ReplicatedStorage/shared/lune/sim/pass'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 달빛 패스의 셈(2026-10-20) — 화면 없이 돈다(서버 · 테스트가 같이 쓴다). 설계 = 공방 js/lune/design/bm.js의 BM_PASS(bm.generated의 pass).
--  사용자 2026-10-20: "달빛패스에 자동줍기는 아니에요 줍기는 펫의 기능이에요" · "달빛 패스도 개발자 상품에 등록해야해요" ·
--   "근데 달빛패스에 시즌이라는 개념이 필요가 없잖아" → 산 때부터 days일(30). 모두가 같이 쓰는 시즌 · 무료 아랫줄은 없다.
--  그 30일 동안 놀면 「달빛」이 쌓이고 per마다 칸이 하나 열린다(steps칸 · 하루 dayCap까지 — 하루는 한국 시각 0시에 바뀐다). 칸마다 보상.
--  30일이 지나도 연 칸의 보상은 받을 수 있다(다시 사면 받지 않은 것을 먼저 보관함에 넣고 — sim/cash.luau — 새 30일).
--  계정의 것(acct.bm.pass — 저장은 sim/cash.luau의 Cash.pack이 함께):
--   ends = 패스가 끝나는 때(os.time · 0 = 산 적 없음) · pts = 이번 패스의 달빛 · day · dayPts = 오늘(한국 날짜)과 오늘 얻은 달빛 ·
--   kills = 다음 「몬스터 n마리」까지 센 수 · p = 받은 칸 { [칸] = true } · n = 산 번수
local lune = script.Parent.Parent
local D = require(lune.data["bm.generated"]).pass

local Pass = {}
Pass.DATA = D
local DAY = 86400

local function whole(v: any, lo: number, hi: number): boolean
	return typeof(v) == "number" and v == v and v % 1 == 0 and v >= lo and v <= hi
end
local function dayOf(now: number): number
	return math.floor((now + D.offset * 3600) / DAY)
end

function Pass.new()
	return { ends = 0, pts = 0, day = 0, dayPts = 0, kills = 0, p = {}, n = 0 }
end

function Pass.active(ps, now: number): boolean
	return now < ps.ends
end
-- 남은 날(올림 — 마지막 날이면 1) · 패스가 없으면 0
function Pass.left(ps, now: number): number
	return if Pass.active(ps, now) then math.ceil((ps.ends - now) / DAY) else 0
end

-- 달빛을 얻는다(패스가 있는 동안 · 하루 상한까지) → 얻은 수
local function gain(ps, n: number, now: number): number
	local d = dayOf(now)
	if ps.day ~= d then
		ps.day, ps.dayPts = d, 0
	end
	local add = math.max(0, math.min(n, D.dayCap - ps.dayPts, D.steps * D.per - ps.pts))
	ps.pts += add
	ps.dayPts += add
	return add
end

-- 한 일을 알린다: "daily" 일일 의뢰 하나 · "attend" 출석 · "rift" 토벌 한 번 · "kill"(n마리 — killEach마다 달빛) → 얻은 달빛(패스가 없으면 0)
function Pass.add(ps, key: string, now: number, n: number?): number
	if not Pass.active(ps, now) then
		return 0
	end
	if key == "kill" then
		ps.kills += n or 1
		local got = 0
		while ps.kills >= D.killEach do
			ps.kills -= D.killEach
			got += gain(ps, D.gain.kill, now)
		end
		return got
	end
	local g = D.gain[key]
	return if g then gain(ps, g, now) else 0
end

function Pass.reached(ps): number
	return math.min(D.steps, ps.pts // D.per)
end

-- 받을 수 있는 칸들 { { step, kind, n } } — 연 칸까지 · 아직 받지 않은 것(패스가 끝난 뒤에도 — 다시 살 때까지)
function Pass.ready(ps)
	local out = {}
	for step = 1, Pass.reached(ps) do
		if not ps.p[step] then
			local pd = D.paid[step]
			table.insert(out, { step = step, kind = pd[1], n = pd[2] })
		end
	end
	return out
end

-- 보상 하나의 아이템: potion = 받는 캐릭터의 레벨의 물약(potionId) · scroll = 귀환 주문서 · exp = 경험치 쿠폰 · money · dust = 레벨대(band)의 주머니 · 상자
function Pass.itemOf(kind: string, potionId: string, band: number): string
	if kind == "potion" then
		return potionId
	elseif kind == "scroll" then
		return "scroll_return"
	elseif kind == "exp" then
		return "bm_exp"
	end
	return ("bm_%s_%d"):format(kind, band)
end

-- 받을 수 있는 것을 모두 받았다고 적는다 → 줄 아이템 { { id, n } } (보관함에 넣는 것은 부른 쪽 — sim/cash.luau)
function Pass.claim(ps, potionId: string, band: number)
	local gifts = {}
	for _, r in Pass.ready(ps) do
		ps.p[r.step] = true
		table.insert(gifts, { id = Pass.itemOf(r.kind, potionId, band), n = r.n })
	end
	return gifts
end

-- 패스를 샀다: 새 30일(달빛 · 받은 칸을 비운다 — 받지 않은 것은 부른 쪽이 먼저 Pass.claim으로 보관함에).
--  아직 패스가 있는데 결제가 또 왔으면(구매 창을 띄운 뒤에 다른 곳에서 산 경우) 끝나는 때만 30일 늘린다 — 받은 돈은 반드시 준다
function Pass.buy(ps, now: number)
	ps.n += 1
	if Pass.active(ps, now) then
		ps.ends += D.days * DAY
		return
	end
	ps.ends = now + D.days * DAY
	ps.pts, ps.kills, ps.p = 0, 0, {}
	ps.day, ps.dayPts = dayOf(now), 0
end

-- 화면에 보내는 것
function Pass.view(ps, now: number)
	local p = {}
	for k in ps.p do
		table.insert(p, k)
	end
	local d = dayOf(now)
	return {
		active = Pass.active(ps, now),
		left = Pass.left(ps, now),
		ended = ps.ends > 0 and not Pass.active(ps, now),
		pts = ps.pts,
		today = if ps.day == d and Pass.active(ps, now) then ps.dayPts else 0,
		reached = Pass.reached(ps),
		p = p,
		ready = #Pass.ready(ps),
	}
end

-- ---------- 저장 ----------
function Pass.pack(ps)
	local p = {}
	for k in ps.p do
		table.insert(p, k)
	end
	table.sort(p)
	return { ends = ps.ends, pts = ps.pts, day = ps.day, dayPts = ps.dayPts, kills = ps.kills, p = p, n = ps.n }
end
function Pass.unpack(data: any)
	local ps = Pass.new()
	if typeof(data) ~= "table" then
		return ps
	end
	ps.ends = if whole(data.ends, 0, 1e11) then data.ends else 0
	ps.pts = if whole(data.pts, 0, D.steps * D.per) then data.pts else 0
	ps.day = if whole(data.day, 0, 1e7) then data.day else 0
	ps.dayPts = if whole(data.dayPts, 0, D.dayCap) then data.dayPts else 0
	ps.kills = if whole(data.kills, 0, D.killEach) then data.kills else 0
	ps.n = if whole(data.n, 0, 1e6) then data.n else 0
	if typeof(data.p) == "table" then
		for _, st in data.p do
			if whole(st, 1, D.steps) then
				ps.p[st] = true
			end
		end
	end
	return ps
end

return Pass

end
MODULES['ReplicatedStorage/shared/lune/sim/passives'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 2~4차의 패시브(사출기 강화 말고의 것) — 공방 js/lune/design/combat.js의 PASSIVE → data/combat.generated.luau의 passive.
--  사용자 2026-10-08: "작업 이어서 하세요"(남은 2~4차). 패시브 = { who · job · max · fx(세기 — 마스터했을 때의 값) }.
--  세기에는 그 스킬의 레벨에 따른 배수(레벨 1에서 40% → 마스터 100%)를 곱한다. 개수 · 시간 · 기준(단계 · 영혼 · 수정의 수 …)은 배우기만 하면 그 값이다.
--  여기서는 셈만 한다(방 · 캐릭터의 셈이 부른다):
--    주는 피해 — atk(공격력에 늘 곱한다) · vs(그 적에게만 붙는 것: 넘어진 적 · 체력이 많은/적은 적 · 먼 거리 · 이어 맞히기 · 모은 단계 · 옛 사냥기)
--    받는 피해 — cut · dodge(회피 +) · rekindle(쓰러질 피해를 버틴다)
--    표식 치명타(리븐) — crit · 닿는 거리 — reach · 그 밖의 값은 get(캐릭터, 열쇠)로 읽는다(단계 · 영혼 · 수정 · 표식의 수 …)
--  캐릭터에 얹는 그때그때의 상태(저장하지 않는다): h.pass = { streak · streakAt(이어 맞힌 수 · 마지막으로 맞힌 때) · press · pressN · pressAt(이어 때리는 적 · 수 · 때) ·
--    sure(피했다 — 다음 베기가 반드시 치명타) · surge(이때까지 다음 강타가 높은 단계에서 시작한다) · rekindle(다시 버틸 수 있는 때) · edge(대검이 맞은 횟수) · venom(독이 다음에 드는 때) · extended(폭주가 늘어난 시간) }
local COMBAT = require(script.Parent.Parent.data["combat.generated"])
local CLASSES = require(script.Parent.Parent.data["classes.generated"])
local Kit = require(script.Parent.kit)

local PASS = COMBAT.passive
local RULES = COMBAT.rules
local FLOOR = CLASSES.skillRule.floor

-- 직업마다: 그 열쇠가 든 패시브들 { [직업] = { [열쇠] = { 스킬 … } } }
local BY = {}
for id, def in PASS do
	BY[def.who] = BY[def.who] or {}
	for key in def.fx do
		BY[def.who][key] = BY[def.who][key] or {}
		table.insert(BY[def.who][key], id)
	end
end
for _, keys in BY do
	for _, list in keys do
		table.sort(list)
	end
end

local Passives = {}
Passives.data = PASS

function Passives.is(id: any): boolean
	return typeof(id) == "string" and PASS[id] ~= nil
end

function Passives.init(h)
	h.pass = { streak = 0, streakAt = -1e9, press = nil, pressN = 0, pressAt = -1e9, sure = false, surge = -1e9, rekindle = -1e9, edge = 0, venom = 0, extended = 0 }
end

-- 그 패시브의 세기(레벨의 배수 — 배우지 않았으면 0)
local function scaleOf(h, id: string): number
	local def = PASS[id]
	local lv = h.skills[id] or 0
	if lv <= 0 or def.who ~= h.class then
		return 0
	end
	return FLOOR + (1 - FLOOR) * (if def.max > 1 then (lv - 1) / (def.max - 1) else 1)
end
Passives.scale = scaleOf

-- 그 열쇠의 값 x 세기를 그 직업의 패시브에서 모두 더한다
local function sum(h, key: string): number
	local list = BY[h.class] and BY[h.class][key]
	if not list then
		return 0
	end
	local total = 0
	for _, id in list do
		local s = scaleOf(h, id)
		if s > 0 then
			total += PASS[id].fx[key] * s
		end
	end
	return total
end
Passives.sum = sum

-- 그 열쇠가 든 패시브를 배웠으면 그 패시브의 값들(fx)과 세기 — 여럿이면 처음 것(배우지 않았으면 nil)
function Passives.get(h, key: string)
	local list = BY[h.class] and BY[h.class][key]
	if list then
		for _, id in list do
			local s = scaleOf(h, id)
			if s > 0 then
				return PASS[id].fx, s
			end
		end
	end
	return nil, 0
end

-- 세기와 상관없는 값(단계 · 영혼 · 수정 · 표식 · 망령 · 수호령의 수 …): 배웠으면 그 값, 아니면 base
function Passives.count(h, key: string, base: number): number
	local fx = Passives.get(h, key)
	return if fx then fx[key] else base
end

-- ---------- 주는 피해 ----------
-- 공격력% (패시브의 「공격력 +」의 합 — 스탯 공격력의 공격력에 곱한다. 2026-10-15 스펙의 낱말)
function Passives.atkPct(h): number
	return sum(h, "atk")
end
-- 그 효과의 합(배운 패시브들의 fx[key] x 세기)
function Passives.sumOf(h, key: string): number
	return sum(h, key)
end
-- 최종 데미지의 배수(패시브의 「최종 데미지 +」 · 피의 계약 — 잃은 체력만큼)
function Passives.finalMul(h): number
	local mul = 1 + sum(h, "final")
	local pact = sum(h, "pact")
	if pact > 0 and h.maxHp > 0 then
		mul *= 1 + pact * math.clamp(1 - h.hp / h.maxHp, 0, 1)
	end
	return mul
end
-- 공격력에 늘 곱하는 것: 공격력% · 최종 데미지 · 피의 계약(잃은 체력만큼) — 피해의 셈이 쓴다(= (1 + 공격력%) x 최종 데미지의 배수)
function Passives.atk(h): number
	local mul = (1 + sum(h, "atk")) * (1 + sum(h, "final"))
	local pact = sum(h, "pact")
	if pact > 0 and h.maxHp > 0 then
		mul *= 1 + pact * math.clamp(1 - h.hp / h.maxHp, 0, 1)
	end
	return mul
end

-- 그 적에게만 붙는 것. info = { skill 그 기술 · charge 모은 단계 · now 방의 시간 }
function Passives.vs(h, mob, info): number
	local class = BY[h.class]
	if not class then
		return 1
	end
	local mul = 1
	if class.stunned and ((mob.stun or 0) > 0 or (mob.bind or 0) > 0) then
		mul *= 1 + sum(h, "stunned")
	end
	if class.healthy then
		local fx, s = Passives.get(h, "healthy")
		if fx then
			if mob.hp >= mob.maxHp * fx.healthyAt then
				mul *= 1 + fx.healthy * s
			end
			if info and (info.charge or 0) > 0 then
				mul *= 1 + fx.perCharge * s * info.charge
			end
		end
	end
	if class.low then
		local fx, s = Passives.get(h, "low")
		if fx and mob.hp < mob.maxHp * fx.lowAt then
			mul *= 1 + fx.low * s
		end
	end
	if class.far then
		local fx, s = Passives.get(h, "far")
		if fx and math.abs(mob.x - h.x) >= fx.farAt then
			mul *= 1 + fx.far * s
		end
	end
	local p = h.pass
	if class.streak and p then
		local fx, s = Passives.get(h, "streak")
		if fx and p.streak > 0 and info and info.now - p.streakAt <= fx.streakTime then
			mul *= 1 + fx.streak * s * math.min(p.streak, fx.streakMax)
		end
	end
	if class.press and p then
		local fx, s = Passives.get(h, "press")
		if fx and p.press == mob and info and info.now - p.pressAt <= fx.pressTime then
			mul *= 1 + fx.press * s * math.min(p.pressN, fx.pressMax)
		end
	end
	-- 옛 사냥기의 피해 +
	if class.skills and info and info.skill then
		for _, id in class.skills do
			local s = scaleOf(h, id)
			if s > 0 and table.find(PASS[id].fx.skills, info.skill) then
				mul *= 1 + PASS[id].fx.boost * s
			end
		end
	end
	return mul
end

-- 기술의 한 타가 그 적에게 맞았다: 이어 맞힌 수 · 이어 때린 수를 센다(살라맨더)
function Passives.onHit(h, mob, now: number)
	local p = h.pass
	local class = BY[h.class]
	if not p or not class then
		return
	end
	if class.streak then
		local fx = Passives.get(h, "streak")
		if fx then
			p.streak = if now - p.streakAt <= fx.streakTime then math.min(fx.streakMax, p.streak + 1) else 1
			p.streakAt = now
		end
	end
	if class.press then
		local fx = Passives.get(h, "press")
		if fx then
			p.pressN = if p.press == mob and now - p.pressAt <= fx.pressTime then math.min(fx.pressMax, p.pressN + 1) else 1
			p.press, p.pressAt = mob, now
		end
	end
end

-- 치명타(사용자 2026-10-08: "치명타 확률과 치명타 터지는건 만들겁니다"): 모든 직업의 기술 타가 확률로 치명타가 된다.
--  돌려주는 것: 확률(%) · 피해의 배수 · 반드시 치명타인가(리븐의 흘리기 — 피한 직후. 쓰면 사라진다). marked = 그 적에게 내 표식이 있는가(리븐)
--   확률 = 기본(RULES.critChance) + 패시브(창 숙련) + 표식이 있는 적이면 표식의 것 · 배수 = 기본(RULES.critMul) + 패시브(달인) + 표식이 있는 적이면 급소
function Passives.crit(h, marked: boolean?): (number, number, boolean)
	local chance, mul = RULES.critChance + sum(h, "crit"), RULES.critMul + sum(h, "critMul")
	if marked and h.class == "riven" then
		chance += COMBAT.kit.riven.core.crit * Kit.scale(h, "core")
		mul += sum(h, "markCritMul")
	end
	return chance, mul, h.pass ~= nil and h.pass.sure == true
end

-- 기술이 닿는 거리의 배수(리퍼: 낫 숙련 · 영혼이 많을 때의 영혼 주머니)
function Passives.reach(h): number
	local class = BY[h.class]
	if not class or not class.reach then
		return 1
	end
	local add = 0
	for _, id in class.reach do
		local s = scaleOf(h, id)
		local fx = PASS[id].fx
		if s > 0 and (not fx.reachAt or h.kit.souls >= fx.reachAt) then
			add += fx.reach * s
		end
	end
	return 1 + add
end

-- ---------- 받는 피해 ----------
-- 받는 피해의 배수. casting = 기술을 쓰는 중인가(굳센 자세)
function Passives.cut(h, casting: boolean?): number
	local class = BY[h.class]
	if not class then
		return 1
	end
	local mul = 1
	if class.cut then
		local fx, s = Passives.get(h, "cut")
		if fx then
			mul *= 1 - (if casting then fx.cutCast else fx.cut) * s
		end
	end
	if class.cutHot and Kit.hot(h) then
		mul *= 1 - sum(h, "cutHot")
	end
	return mul
end

-- 회피에 더하는 것(0~1)
function Passives.dodge(h): number
	return sum(h, "dodge") / 100
end

-- 피했다: 흘리기를 배웠으면 다음 베기가 반드시 표식 치명타
function Passives.dodged(h)
	local fx = Passives.get(h, "sure")
	if fx and h.pass then
		h.pass.sure = true
	end
end

-- 쓰러질 피해를 받았다(살라맨더의 재점화): 버틸 수 있으면 열기를 모두 태우고, 남길 체력을 돌려준다(못 버티면 nil). now = 방의 시간
function Passives.rekindle(h, now: number): number?
	local fx, s = Passives.get(h, "rekindle")
	if not fx or not h.pass or now < h.pass.rekindle then
		return nil
	end
	h.pass.rekindle = now + fx.cd
	h.kit.heat = 0
	return math.max(1, math.floor(h.maxHp * fx.rekindle * s + 0.5))
end

return Passives

end
MODULES['ReplicatedStorage/shared/lune/sim/physics'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 횡스크롤 움직임 — 달리기 · 뛰기 · 떨어지기 · 발판. 화면과 상관없는 셈만 한다(클라이언트가 제 캐릭터를 움직이고, 서버가 같은 식으로 따져 본다).
--  공방 「횡스크롤 시험」 탭(dino-workshop/js/lune/luneTab.js)의 step()을 그대로 옮겼다.
--  장면의 칸(rows): "#" 막힌 칸 · "=" 아래에서 올라탈 수 있는 얇은 발판(↓를 누른 채 뛰기를 누르면 내려간다 — 하단 점프) · "^" 가시 · "." 빈 칸.
--  body = { x, y, vx, vy, ground, air = 땅을 떠난 뒤 공중에서 뛴 수(2단 점프 — 땅에 닿으면 0) } — (x, y)는 발밑 가운데.  input = { mx = -1 | 0 | 1, jump = 이번 걸음에 뛰기를 눌렀나, down = ↓를 누르고 있나, speed = 빠르기 배수(없으면 1),
--          vx = 가로 빠르기를 직접 준다(대쉬 · 기술 중의 이동), float = 떨어지지 않는다(대쉬), up = ↑를 누르고 있나(사다리) }
--  사다리(scene.ladders = { { x, top, bottom } } — 도트, 2026-10-16 밤): ↑를 누르면 잡고 곧게 오르고, ↓로 내린다. 처음에는 "올라가는 모션없이" 서 있는 모습이었고,
--   같은 밤 사용자: "사다리 올라가는 모션 만들어서 적용해줘" → 오르기 동작(climb — 등을 보이고 팔다리를 번갈아, tools/build_lune_climb.py). 꼭대기의 발판 위에서 ↓(뛰기 없이)를 누르면
--   잡고 내려간다(메이플처럼 — ↓ + 뛰기는 그대로 하단 점프). 뛰기 = 놓고 뛰어내린다
local G = require(script.Parent.Parent.config.game)
local COMBAT = require(script.Parent.Parent.data["combat.generated"])
-- 바닷속(scene.sea): 걷기는 조금 느리고, 뛰면 느리게 높이 떴다가 천천히 가라앉는다(공방 combat.js의 sea — 시험 탭과 같은 숫자)
local SEA = COMBAT.rules.sea

local T = G.TILE
local HALF = G.BOX_W / 2
local CLIMB = 80 -- 사다리를 오르내리는 빠르기(점/초 — 달리기 92보다 조금 느리게 · 제가 정한 것)
local GRAB = 7 -- 사다리 가운데에서 이만큼 안이면 잡는다(점)

local P = {}

-- 칸 하나. 맵 위는 빈 칸, 맵 아래와 좌우 밖은 막힌 칸이다.
function P.cell(scene, tx: number, ty: number): string
	if ty < 0 then
		return "."
	end
	if ty >= scene.h or tx < 0 or tx >= scene.w then
		return "#"
	end
	return string.sub(scene.rows[ty + 1], tx + 1, tx + 1)
end

-- 발밑 가운데가 (x, y)인 몸 상자가 막힌 칸에 걸리는가.
function P.solidBox(scene, x: number, y: number): boolean
	for ty = math.floor((y - G.BOX_H) / T), math.floor((y - 1) / T) do
		for tx = math.floor((x - HALF) / T), math.floor((x + HALF - 1) / T) do
			if P.cell(scene, tx, ty) == "#" then
				return true
			end
		end
	end
	return false
end

-- 가시(^)에 닿아 있는가: 발이 놓인 칸이 가시일 때(몸 폭에서 양옆 두 점씩 뺀 안쪽 — 스치기만 한 것은 치지 않는다). 가시 위로 뛰어넘는 동안에는 닿지 않는다.
--  닿으면 약한 피해를 입는다(서버 — sim/room.luau의 step. 사용자 2026-10-08: "맵에 가시 있잖아요 그거 닿으면 데미지 입게 약한데미지 입게하세요")
function P.onSpike(scene, x: number, y: number): boolean
	local ty = math.floor((y - 1) / T)
	for tx = math.floor((x - HALF + 2) / T), math.floor((x + HALF - 3) / T) do
		if P.cell(scene, tx, ty) == "^" then
			return true
		end
	end
	return false
end

-- 발밑이 얇은 발판(=)뿐인가 — 하단 점프를 할 수 있는 자리. 몸 폭 안의 발밑 칸에 막힌 칸(#)이 하나라도 있으면 아니다(그 칸이 받친다)
function P.onPlatform(scene, body): boolean
	local ty = math.floor(body.y / T)
	if body.y ~= ty * T then
		return false
	end
	local found = false
	for tx = math.floor((body.x - HALF) / T), math.floor((body.x + HALF - 1) / T) do
		local k = P.cell(scene, tx, ty)
		if k == "#" then
			return false
		elseif k == "=" then
			found = true
		end
	end
	return found
end

-- 그 자리에서 잡을 수 있는 사다리(번호 · 사다리) — 가로가 사다리 가운데에서 GRAB 안 · 세로가 꼭대기와 바닥 사이(양 끝 포함)
function P.ladderAt(scene, x: number, y: number): (number?, any)
	for i, l in scene.ladders or {} do
		if math.abs(x - l.x) <= GRAB and y >= l.top - 0.5 and y <= l.bottom + 0.5 then
			return i, l
		end
	end
	return nil, nil
end

function P.newBody(scene)
	return { x = scene.spawn.x, y = scene.spawn.y, vx = 0, vy = 0, ground = false }
end

function P.respawn(scene, body)
	body.x, body.y, body.vx, body.vy, body.ground = scene.spawn.x, scene.spawn.y, 0, 0, false
	body.air = 0
end

-- 한 걸음(dt초). 맵 아래로 떨어져 시작 자리로 돌아갔으면 "respawn"을 돌려준다.
