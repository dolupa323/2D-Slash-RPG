		local sz = World.session(pz)
		if sz.scene ~= sg.scene then
			goTo(pz, sg.scene)
		end
		run(0.5)
		table.clear(sent)
		sz.loading = World.now -- (막 들어온 때처럼 — 화면이 아직 열리지 않았다)
		handlers.Move(pz, sz.hero.x, sz.hero.y, 1)
		local seen = false
		for _, e in got("Buffs", pz) do
