	end
	eq(hg.x, x0, "받지 않는 2~4차 스킬 요청은 자리를 옮기지 않는다")
	for _ = 1, 10 do
		handlers.Skill(pg, "ax_breath", 1, hg.x + 40, hg.y, 1) -- 다시 쓰기 없는 버프(곧바로 걸린다)
