	end
	-- 몸의 한 색 실루엣을 덧그린다(분신 · 굳은 몸의 윤곽 · 사신의 그림자 · 망령): 그 동작의 f째 장(0부터)을 (x, y)에. o = { color, alpha } — 그리는 동안(draw)에만 부른다.
	--  캐릭터들의 층 맨 뒤에 놓인다(몸 뒤). o.scale = 크기(거신)
	function g.sprite(clip: string, f: number, x: number, y: number, dir: number, o)
		self.spriteN += 1
		local sp = self.sprites[self.spriteN]
		if not sp or sp.who ~= a.who then
			if sp then
				sp:destroy()
			end
			sp = Sprite.new(self.view.heroLayer, a.who, 0, true)
			sp.label.Name = "Shade"
			self.sprites[self.spriteN] = sp
		end
		local c = (o and o.color) or a.tone.n
		sp.label.ImageColor3 = Color3.fromRGB(bit32.rshift(c, 16), bit32.band(bit32.rshift(c, 8), 255), bit32.band(c, 255))
		sp.label.ImageTransparency = 1 - ((o and o.alpha) or 1)
		sp:set(clip, f + 1, x, y, dir, o and o.scale)
	end
	return g
end

-- 사람을 올린다(이미 있으면 그대로). own = 나
function Cast:actor(id: any, who: string, own: boolean?)
	local a = self.actors[id]
	if a and a.who == who then
		return a
	end
	local kit = Kitset.of(who)
	a = { id = id, who = who, kit = kit, tone = Fx.TONE[(kit and kit.tone) or "mint"], x = 0, y = 0, dir = 1, ground = true, vx = 0, vy = 0, scale = 1, alpha = 1, sil = nil, skill = nil, buffs = {}, toggle = false, own = own == true, skills = {}, pose = nil, charge = 0 }
	a.g = makeG(self, a)
	if kit and kit.init then
		kit.init(a.g)
	end
	self.actors[id] = a
	if own then
		self.own = a
	end
	return a
end

function Cast:drop(id: any)
	local a = self.actors[id]
	if a and a.shades then
		for _, sp in a.shades do
			sp:destroy()
		end
	end
	self.actors[id] = nil
end

-- 그 사람의 몸을 그린다 — 버프가 입히는 모습까지(시험 탭이 몸을 그리는 그 줄들):
--   크기(거신의 두 배) · 비치는 몸(그림자 숨기 · 연막 · 저승 걸음) · 한 색 실루엣(sil) · 윤곽을 따라 도는 빛(직업 묶음의 heroGlow — 네 쪽으로 한 점씩 민 실루엣) · 몸에 얹는 색(heroTint)
--  body = 그 사람의 몸 그림(Sprite) · (clip, frame) = 지금의 동작과 장(1부터) · fade = 그 밖의 비침(맞은 직후의 깜빡임 — 0이면 또렷하다)
local GLOW = { { -1, 0 }, { 1, 0 }, { 0, -1 }, { 0, 1 } }
local function rgb(c: number): Color3
	return Color3.fromRGB(bit32.rshift(c, 16), bit32.band(bit32.rshift(c, 8), 255), bit32.band(c, 255))
end
function Cast:look(a, body, clip: string, frame: number, x: number, y: number, dir: number, fade: number?)
	local sc = a.scale or 1
	local alpha = max(fade or 0, 1 - (a.alpha or 1))
	body:set(clip, frame, x, y, dir, sc)
	body.label.ImageTransparency = alpha
	local kit, g = a.kit, a.g
	local glow = if kit and kit.heroGlow then kit.heroGlow(g) else nil
	local tint = if kit and kit.heroTint then kit.heroTint(g) else nil
	local sil = a.sil
	local sh = a.shades
	if not sh then
		if not (glow or tint or sil) then
			return
		end
		-- 덧그리는 실루엣들: 윤곽 빛 넷(몸 뒤) · 실루엣 하나(몸의 자리) · 얹는 색 하나(몸 앞)
		sh = {}
		local z = body.label.ZIndex
		for i = 1, 6 do
			sh[i] = Sprite.new(self.view.heroLayer, a.who, if i <= 4 then max(0, z - 1) elseif i == 5 then z else z + 1, true)
			sh[i].label.Name = "Look"
		end
		a.shades = sh
	end
	for i = 1, 4 do
		if glow then
			sh[i]:set(clip, frame, x + GLOW[i][1], y + GLOW[i][2], dir, sc)
			sh[i].label.ImageColor3 = rgb(glow)
		else
			sh[i].label.Visible = false
		end
	end
	if sil then
		sh[5]:set(clip, frame, x, y, dir, sc)
		sh[5].label.ImageColor3 = rgb(sil)
		sh[5].label.ImageTransparency = alpha
		body.label.Visible = false
	else
		sh[5].label.Visible = false
	end
	if tint then
		sh[6]:set(clip, frame, x, y, dir, sc)
		sh[6].label.ImageColor3 = rgb(tint[1])
		sh[6].label.ImageTransparency = 1 - tint[2]
	else
		sh[6].label.Visible = false
	end
end

-- 그 기술의 그 구간이 시작됐다. lv = 모은 단계
function Cast:start(a, id: string, seg: number, lv: number?)
	local def = a.kit and a.kit.byId[id]
	local s = def and def.segs and def.segs[seg]
	if not s then
		a.skill = nil
		return
	end
	-- 앞 구간에서 이어지는 것이면 그 구간을 닫는다: 다 틀고 넘어가는 구간은 아직 안 터진 장의 이펙트를 마저 내고, 끝날 때의 일을 부른다(몰아치기의 휘두른 시간 …)
	local prev = a.skill
	if prev and prev.def == def and prev.i == seg - 1 then
		local ps = prev.s
		if not (ps.hold or ps.charge or ps.till) then
			for _, e in ps.evs do
				if not prev.fired[e[1]] then
					prev.fired[e[1]] = true
					e[2](a.g)
				end
			end
		end
		if ps.finish then
			ps.finish(a.g)
		end
	end
	local clip = CHARS.chars[a.who].clips[s.clip]
	a.skill = { def = def, i = seg, s = s, t = 0, lv = lv or 0, fired = {}, acc = 0, last = s.to or (if clip then #clip.frames - 1 else 0) }
	if s.start then
		s.start(a.g)
	end
end

-- 바로 걸리는 것(버프 · 생존기 · 극딜 — 쓰는 동작이 없다): 걸리는 순간의 이펙트
function Cast:instant(a, id: string)
	local def = a.kit and a.kit.byId[id]
	if def and def.cast then
		def.cast(a.g)
	end
end

-- 그 사람에게 걸린 버프(서버가 알려 준 것)를 받아 적는다. list = { { id, t, dur, x, y } … }
function Cast:setBuffs(a, list)
	local old = a.buffs
	a.buffs = {}
	for _, b in list do
		a.buffs[b.id] = { t = b.t, dur = b.dur, x = b.x, y = b.y }
	end
	-- 사라진 것: 끝났을 때의 이펙트(굳었던 빛이 깨져 흩어진다 · 돔이 깨진다)
	for id in old do
		if not a.buffs[id] and a.kit and a.kit.onBuffEnd then
			a.kit.onBuffEnd(a.g, id)
		end
	end
end

-- 힘이 한 단계 모였다(시험 탭: 단계가 오를 때마다 고리가 오므라든다)
function Cast:chargeUp(a, lv: number)
	a.charge = lv
	self.fx.ring(a.x, a.y - 8, 26 + lv * 8, 4, a.tone, { squash = 1, back = false, life = 0.25 })
	self.fx.shards(a.x, a.y - 8, 4 + lv * 2, a.tone, { speed = 40, up = 60, kind = "dot", grav = -60, life = 0.4 })
end

-- 레벨이 올랐다(2026-10-18 — 메이플스토리처럼 캐릭터 둘레로 빛이 솟는다. 전에는 머리 위의 글씨와 소리뿐이었다): 큰 기운 · 발밑의 넓은 고리 · 위로 흩어지는 점(직업 색)
--  시험 탭 js/lune/luneTab.js의 gainXp가 같은 값으로 그린다
function Cast:levelUp(a)
	self.fx.aura(a.x, a.y, a.tone, { r = 18, h = 46, life = 0.9 })
	self.fx.ring(a.x, a.y - 2, 4, 34, a.tone, { squash = 0.35, back = true, life = 0.7 })
	self.fx.shards(a.x, a.y - 10, 14, a.tone, { speed = 30, up = 90, kind = "dot", grav = -80, life = 0.9 })
end

-- 사냥터 정예가 나왔다(2026-10-18 — 시험 탭의 spawnElite와 같다): 그 자리에서 분홍 기운이 솟고 고리가 퍼지며 불티가 오른다
function Cast:eliteRise(x: number, y: number)
	local tone = Cast.tone("pink")
	self.fx.aura(x, y, tone, { r = 16, h = 40, life = 1.1 })
	self.fx.ring(x, y - 2, 4, 30, tone, { squash = 0.35, back = true, life = 0.8 })
	self.fx.shards(x, y - 8, 12, tone, { speed = 26, up = 80, kind = "dot", grav = -60, life = 1 })
end

-- 사출기를 켰다(시험 탭: 켜는 순간 작은 기운)
function Cast:toggled(a)
	self.fx.aura(a.x, a.y, a.tone, { r = 10, h = 16, life = 0.35 })
end

-- 졸개가 맞았다(시험 탭의 hurt): 파편이 튄다. 쓰러졌으면 세모 파편이 터진다. by = 때린 사람의 직업 색
--  dir = 때린 쪽의 반대(몬스터가 밀리는 쪽 — 1 · -1): 불꽃은 때린 쪽으로 조금 치우친 자리에서 퍼지고, 파편은 반대쪽으로 튄다(공방 combat.js의 hit)
function Cast:hurt(m, tone, big: boolean?, dead: boolean?, dir: number?)
	local y = m.info.y
	local H = COMBAT.rules.hit
	self.fx.pop(m.x - (dir or 0) * 3, y - 8, tone, { r = if big then H.sparkBig else H.spark, life = 0.14 })
	self.fx.shards(m.x, y - 7, if big then H.shardsBig else H.shards, tone, { speed = 70, up = 40, kind = "mix", life = 0.4, dir = dir or 0, spread = 1.2 })
	if dead then
		self.fx.shards(m.x, y - 6, 8, tone, { kind = "tri" })
	end
end

-- 서버가 알린 따로 나가는 타(지금의 1차 — 메아리 도끼 · 표창 · 도깨비불 …). 그 직업 묶음에 이펙트가 있으면 돌리고 true(land = 닿은 순간에 부를 것)
--  e = 그 타의 기록(i 몇째 것 · n 한 번에 나간 수 · hop 튕긴 것 · up 그 사람이 배운 사출기 강화 — 1 하나 더 · 2 셋째 갈래 · 4 넷째 갈래)
function Cast:proc(a, kind: string, m, sx: number, sy: number, land: () -> (), e): boolean
	local fn = a and a.kit and a.kit.procs and a.kit.procs[kind]
	if not fn then
		return false
	end
	-- 남의 것: 그 사람이 배운 강화를 받아 적어 그 모습(큰 도끼 · 불새 …)으로 그린다(내 것은 내 스킬 레벨을 그대로 읽는다)
	local ups = COMBAT.kitUp[a.who]
	if e and e.up and not a.own and ups then
		for role, def in ups do
			local bit = if role == "two" then 1 elseif role == "fast" then 4 else 2
			a.skills[def.id] = if bit32.band(e.up, bit) ~= 0 then 1 else 0
		end
	end
	fn(a.g, m, { sx = sx, sy = sy, land = land, i = e and e.i, n = e and e.n, hop = e and e.hop })
	return true
end

function Cast:update(dt: number)
	dt *= Cast.speed
	self.shakeT = max(0, self.shakeT - dt)
	if self.shakeT == 0 then
		self.shakeA = 0
	end
	self.invertT = max(0, self.invertT - dt)
	self.dimT = max(0, self.dimT - dt)
	local sh = if self.shakeT > 0 then self.shakeA else 0
	self.sx, self.sy = R((random() * 2 - 1) * sh), R((random() * 2 - 1) * sh * 0.6)
	self:syncMobs(dt)
	if self.stopT > 0 then
		self.stopT -= dt -- 멈칫: 맞는 순간 이펙트가 잠깐 선다
		return
	end
	self.clock += dt
	local timers = self.timers
	for i = #timers, 1, -1 do
		local t = timers[i]
		t.t -= dt
		if t.t <= 0 then
			table.remove(timers, i)
			t.fn()
		end
	end
	for _, a in self.actors do
		local g = a.g
		for _, b in a.buffs do
			b.t = max(0.01, b.t - dt) -- 끝나는 것은 서버가 알린다(그때까지는 걸려 있는 모습이다)
		end
		if a.kit and a.kit.tick then
			a.kit.tick(g, dt)
		end
		-- 스킬 진행: 구간의 장 번호에 맞춰 일을 터뜨린다
		local sk = a.skill
		if sk then
			local s = sk.s
			local haste = if s.charge then 1 else (a.haste or 1) -- 공격 속도 버프: 동작 · 타격 시점 · 되풀이 타격 간격이 빨라진다(힘 모으기 구간은 그대로)
			sk.t += dt * haste
			local f = (s.from or 0) + floor(sk.t * (s.fps or 14))
			for _, e in s.evs do
				if f >= e[1] and not sk.fired[e[1]] then
					sk.fired[e[1]] = true
					e[2](g)
				end
			end
			if s.every then
				sk.acc += dt * haste
				while sk.acc >= s.every[1] do
					sk.acc -= s.every[1]
					s.every[2](g)
				end
			end
			-- 끝: 보통 구간은 마지막 장을 넘기면. 누르고 있는 구간 · 모으는 구간 · 조건을 기다리는 구간은 다음 구간이 시작되면 바뀐다(안 오면 max에서 끝난다)
			local done
			if s.loop then
				done = sk.t >= s.dur
			elseif s.hold or s.charge or s.till then
				done = sk.t >= (s.max or 3)
			else
				done = f > sk.last
			end
			if done then
				if s.finish then
					s.finish(g)
				end
				if a.skill == sk then
					a.skill = nil
				end
			end
		end
	end
	-- 날아가는 것 · 놓인 것 · 따라다니는 것
	local shots = self.shots
	for i = #shots, 1, -1 do
		local p = shots[i]
		p.t += dt
		local gone = false
		if p.target then -- 쫓아가는 것: 닿으면 onReach
			local tm = p.target
			local tx, ty = tm.x, tm.y - tm.h - (if tm.boss then 14 else 7)
			local d = sqrt((tx - p.x) ^ 2 + (ty - p.y) ^ 2)
			if tm.dead >= 0 then
				table.remove(shots, i)
				continue
			end
			if d < 6 then
				if p.onReach then
					p.onReach(p)
				end
				table.remove(shots, i)
				continue
			end
			local sp = (p.speed or 200) * dt
			p.x += ((tx - p.x) / d) * sp
			p.y += ((ty - p.y) / d) * sp + (p.curl or 0) * sin(p.t * 12) * dt
		else
			if p.g then
				p.vy = (p.vy or 0) + p.g * dt
			end
			p.x += (p.vx or 0) * dt
			p.y += (p.vy or 0) * dt
		end
		if p.update then
			p.update(p, dt)
		end
		if p.every then
			p.acc += dt
			while p.acc >= p.every[1] do
				p.acc -= p.every[1]
				p.every[2](p)
			end
		end
		if p.dmg ~= 0 then
			for _, m in self.mobView.mobs do
				local hh = if m.boss then 26 else 12
				if m.dead >= 0 or abs(m.x - p.x) > p.w / 2 + 7 or m.y - m.h < p.y - p.h / 2 - 2 or m.y - m.h - hh > p.y + p.h / 2 then
					continue
				end
				local was = p.hitSet[m]
				if was ~= nil and not (p.tick and p.t - was >= p.tick) then
					continue
				end
				p.hitSet[m] = p.t
				if p.onHit then
					p.onHit(p, m)
				end
			end
		end
		local wall = ((p.vx or 0) ~= 0 or (p.vy or 0) ~= 0) and not p.ghost and P.cell(self.scene, floor(p.x / G.TILE), floor(p.y / G.TILE)) == "#"
		if p.dead or p.t >= p.life or wall or gone then
			if p.finish then
				p.finish(p, wall)
			end
			table.remove(shots, i)
		end
	end
	self.fx.update(dt)
end

local STACK_MARK = Fx.TONE.mint.n

function Cast:draw()
	local view = self.view
	local back, front = view.fxBack, view.fxFront
	local cx, cy = view.camX, view.camY
	back:begin(cx, cy)
	front:begin(cx, cy)
	self.spriteN = 0
	self.flash.Visible = self.invertT > 0
	local own = self.own
	-- 큰 기술 · 극딜: 배경을 어둡게 눌러 네온이 도드라지게
	local dim = if self.dimT > 0 then self.dimA * min(1, self.dimT / (self.dimLife * 0.25), (self.dimLife - self.dimT) / 0.12) else 0
	if own and own.kit and own.kit.dim then
		dim = max(dim, own.kit.dim(own.g) or 0)
	end
	if dim > 0 then
		back:alpha(dim)
		back:style(0x12161c)
		back:rect(cx - 8, cy - 8, G.VIEW_W + 16, G.VIEW_H + 16)
		back:alpha(1)
	end
	for _, p in self.shots do
		if p.back and p.draw then
			p.draw(back, p)
		end
	end
	self.fx.draw(back, true)
	for _, a in self.actors do
		if a.kit and a.kit.drawBack then
			a.kit.drawBack(back, a.g)
		end
	end
	local kit = own and own.kit
	if kit then
		for _, m in self.mobView.mobs do
			if m.dead and m.dead < 0 then
				local sc = if m.boss then 2 else 1
				if kit.drawMarks then
					kit.drawMarks(back, own.g, m, sc, false)
				end
				if m.bind > 0 and kit.drawBind then
					kit.drawBind(back, own.g, m, sc, false) -- 바인드: 휘감는 기운의 뒤쪽 반
				end
			end
		end
	end
	-- 모은 단계(머리 위의 점)
	for _, a in self.actors do
		if a.charge > 0 then
			front:style(a.tone.l)
			for i = 0, a.charge - 1 do
				front:rect(R(a.x) - a.charge * 2 + i * 4, R(a.y) - 28 * a.scale, 2, 2)
			end
		end
	end
	for _, p in self.shots do
		if not p.back and p.draw then
			p.draw(front, p)
		end
	end
	for _, a in self.actors do
		if a.kit and a.kit.draw then
			a.kit.draw(front, a.g)
		end
	end
	self.fx.draw(front, false)
	for _, m in self.mobView.mobs do
		if not (m.dead and m.dead < 0) then
			continue
		end
		local sc = if m.boss then 2 else 1
		local top, mx = R(m.y - m.h) - 13 * sc, R(m.x)
		if kit then
			if kit.drawMarks then
				kit.drawMarks(front, own.g, m, sc, true)
			end
			if m.bind > 0 and kit.drawBind then
				kit.drawBind(front, own.g, m, sc, true) -- 앞쪽 반
			end
		end
		if m.stun > 0 then
			front:style(0xeef6f6)
			for i = 0, 2 do
				local a = self.clock * 6 + i * 2.1
				front:rect(R(mx + cos(a) * 6), R(top - 3 + sin(a) * 2), 1, 1)
			end
		end
		for i = 0, m.mark - 1 do -- 표식
			local bx, by = mx - (m.mark - 1) * 3 + i * 6, R(top - 9 + sin(self.clock * 6 + i) * 1.5)
			front:style(STACK_MARK)
			front:rect(bx - 1, by, 3, 1)
			front:rect(bx, by - 1, 1, 3)
		end
	end
	for i = self.spriteN + 1, #self.sprites do
		self.sprites[i].label.Visible = false
	end
	back:present()
	front:present()
end

return Cast

end
MODULES['Client/lune/chat'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 채팅 — Roblox의 기본 채팅(TextChatService의 채팅 창 · 입력줄 · 채널 탭)을 그대로 쓴다. 우리가 그리는 채팅 화면은 없다.
--  사용자 2026-10-13: "우리가 자체 채팅을 구현하는게 아니라 로블록스 채팅이 있어요 로블록스 공식문서좀 확인해보고 ,  그걸 어떻게 로블록스 채팅을 우리게임에 자연스럽게 사용하게 연결할수있는지
--                     불가능하다면 그냥 채팅 없어도됩니다."
--  전에는 글만 Roblox의 채팅으로 보내고(TextChannel:SendAsync) 창과 쓰는 칸은 우리 것이었다(기본 창 · 입력줄은 꺼 두었다). 이제 창 · 입력줄 · 폰의 채팅 단추까지 Roblox의 것이다:
--    글 거르기 · 신고 · 한글 입력 · 폰의 글자판 · 채팅 제한(나이 확인 등)이 걸린 사람에게 뜨는 안내를 Roblox가 맡는다 — 우리가 따라 만들 것이 없다.
--  공식 문서(create.roblox.com/docs/chat/in-experience-text-chat · chat-window · reference의 ChatWindowConfiguration · ChatInputBarConfiguration · ChannelTabsConfiguration)에서 확인한 것:
--    · 기본 화면은 셋: 채팅 창(ChatWindowConfiguration) · 입력줄(ChatInputBarConfiguration) · 채널 탭(ChannelTabsConfiguration — 기본은 꺼져 있다). Enabled를 끄면 그 부분이 숨는다.
--    · 창의 자리는 HorizontalAlignment(기본 Left) · VerticalAlignment(기본 Top), 크기는 WidthScale · HeightScale, 모습은 BackgroundColor3 · BackgroundTransparency · TextColor3 · TextSize · FontFace.
--    · 입력줄은 그것을 누르거나 KeyboardKeyCode(기본 Slash — 「/」)로 연다. 폰에서는 화면 위의 Roblox 채팅 단추로 창을 여닫는다.
--    · 채널 탭을 켜면 RBXGeneral이 「General」 탭이 되고, 따로 만든 TextChannel은 그 Name으로 탭이 생긴다 — 우리의 「파티」 채널.
--    · 글의 앞머리(이름)는 TextChatService.OnIncomingMessage에서 TextChatMessageProperties.PrefixText로 바꾼다(글자색 꼬리표를 쓸 수 있다).
--    · 알림 글은 TextChannel:DisplaySystemMessage(그 사람의 화면에만 뜬다).
--    · 창 · 입력줄의 화면에서의 자리는 AbsolutePosition · AbsoluteSize로 읽는다(문서의 본보기 「Get Total Chat UI Bounds」) · 글을 치는 중인지는 ChatInputBarConfiguration.IsFocused.
--  누구에게 가는지는 그대로 서버가 정한다(server/lune/modules/chat.luau): 둘레(RBXGeneral) = 같은 맵의 사람 · 「파티」 = 같은 파티.
--  여기서 하는 일: ① 기본 창 · 입력줄 · 채널 탭을 켜고 게임의 색에 맞춘다(data/ui.generated.luau의 chatUi) ② 이름을 그 사람의 캐릭터 이름으로(Roblox의 이름을 쓰지 않는다 — 사용자 2026-10-10)
--                 ③ 글을 치는 동안 게임의 키를 받지 않게 알려 준다(Chat.focused) ④ 창이 차지한 자리의 아래 끝을 알려 준다(Chat.bottom — PC에서 파티원 칸을 그 아래로 내린다)
--  Roblox 캐릭터가 없는 게임이라(2D 화면) 머리 위 말풍선은 뜨지 않는다.
--  확인하지 못한 것: 실제 화면에서의 모습(Play를 하지 않았다). 속성은 모두 문서에 있는 것이고, 하나가 안 먹어도 나머지와 게임은 그대로 돈다(pcall).
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UI = require(ReplicatedStorage.shared.lune.data["ui.generated"])
local Stage = require(script.Parent.stage)

local K = UI.chatUi -- 공방 js/lune/design/ui.js의 CHATUI

local Chat = {}
Chat.bottom = 0 -- Roblox 채팅 화면(창 + 입력줄)의 아래 끝 — 화면 틀의 점(위에서부터). 아직 모르면 0
Chat.onMoved = nil :: (() -> ())? -- 그 자리가 바뀌었을 때(boot가 파티원 칸을 다시 놓는다)

local window: Instance? = nil
local bar: Instance? = nil

local function config(class: string): Instance?
	local found = TextChatService:FindFirstChildOfClass(class)
	if found then
		return found
	end
	-- 설정들은 TextChatService 바로 아래나 그 아래의 묶음에 있다
	for _, d in TextChatService:GetDescendants() do
		if d.ClassName == class then
			return d
		end
	end
	return nil
end

local function color(hex: string): Color3
	return Color3.fromHex(hex)
end

-- 속성 하나를 건다(그 속성이 없거나 막혀 있어도 나머지는 그대로 건다).
--  값이 없으면(자료에 그 값이 없다) 걸지 않는다 — 2026-10-13: 자료에서 뺀 값(stroke)을 걸려던 줄이 남아, nil을 수 속성에 넣다가
--  Studio의 Output에 "value of type nil cannot be converted to a number"가 떴다(pcall 안이라 게임은 그대로 돌았다). 걸어야 하는 값이 다 걸리는지는 테스트 40이 본다
local function set(target: Instance?, key: string, value: any)
	if value == nil then
		warn("[lune] 채팅: 걸 값이 자료(ui.generated의 chatUi)에 없다 — " .. key)
		return
	end
	if target then
		pcall(function()
			(target :: any)[key] = value
		end)
	end
end

-- 글에 넣는 이름: 글자 꾸밈 꼬리표로 읽히지 않게
local function plain(text: string): string
	return (text:gsub("[&<>\"']", { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;", ["'"] = "&apos;" }))
end
Chat.plain = plain

-- 그 글의 앞머리: 「[파티] 이름:」 — 이름은 그 사람이 하고 있는 캐릭터의 이름(서버가 사람에게 적어 둔 LuneName). 아직 캐릭터를 고르지 않은 사람이면 nil(Roblox의 기본 앞머리 그대로)
function Chat.prefix(charName: any, party: boolean): string?
	if typeof(charName) ~= "string" or charName == "" then
		return nil
	end
	local head = if party then ("<font color='%s'>%s</font> "):format(K.party.color, plain(K.party.tag)) else ""
	return ("%s<font color='%s'>%s:</font>"):format(head, if party then K.party.color else K.nameColor, plain(charName))
end

-- 입력줄에 글을 치는 중인가(그동안 게임의 키를 받지 않는다 — input.luau)
function Chat.focused(): boolean
	local ok, on = pcall(function()
		return bar ~= nil and (bar :: any).IsFocused == true
	end)
	return ok and on == true
end

-- 알림 글(내 화면에만 뜬다)
function Chat.note(text: string)
	task.spawn(function()
		pcall(function()
			local channels = TextChatService:WaitForChild("TextChannels", 5)
			local channel = channels and (channels:FindFirstChild("RBXSystem") or channels:FindFirstChild("RBXGeneral"))
			if channel then
				(channel :: any):DisplaySystemMessage(text)
			end
		end)
	end)
end

-- 채팅 화면이 차지한 자리의 아래 끝을 다시 잰다(창과 입력줄을 합친 네모 — 문서의 본보기와 같은 법). 화면 틀의 점으로
local function measure()
	local ok, y = pcall(function()
		local low = 0
		for _, c in { window, bar } do
			if c and (c :: any).Enabled then
				local pos, size = (c :: any).AbsolutePosition, (c :: any).AbsoluteSize
				if size.Y > 0 then
					low = math.max(low, pos.Y + size.Y)
				end
			end
		end
		if low <= 0 or not Stage.ui then
			return 0
		end
		return math.max(0, math.ceil((low - Stage.ui.AbsolutePosition.Y) / Stage.uiScale))
	end)
	local now = if ok then y else 0
	if now ~= Chat.bottom then
		Chat.bottom = now
		if Chat.onMoved then
			Chat.onMoved()
		end
	end
end
Chat.measure = measure

function Chat.init()
	window = config("ChatWindowConfiguration")
	bar = config("ChatInputBarConfiguration")
	local tabs = config("ChannelTabsConfiguration")

	-- ① 기본 화면을 켜고 게임의 색에 맞춘다
	local W = K.window
	set(window, "Enabled", true)
	set(window, "BackgroundColor3", color(W.back))
	set(window, "BackgroundTransparency", W.alpha)
	set(window, "TextColor3", color(W.text))
	set(window, "WidthScale", W.width)
	set(window, "HeightScale", W.height)
	set(bar, "Enabled", true)
	set(bar, "BackgroundColor3", color(W.back))
	set(bar, "BackgroundTransparency", W.alpha)
	set(bar, "TextColor3", color(W.text))
	set(bar, "PlaceholderColor3", color(W.dim))
	-- 채널 탭: 「General」(둘레 — 같은 맵) · 「파티」
	set(tabs, "Enabled", K.tabs)
	set(tabs, "BackgroundColor3", color(W.back))
	set(tabs, "BackgroundTransparency", W.alpha)
	set(tabs, "TextColor3", color(W.dim))
	set(tabs, "SelectedTabTextColor3", color(K.nameColor))

	-- ② 이름은 캐릭터의 이름으로(이 함수는 기다리지 않는다 — 문서: 콜백은 멈추지 않아야 한다)
	pcall(function()
		TextChatService.OnIncomingMessage = function(message: TextChatMessage)
			local props = Instance.new("TextChatMessageProperties")
			local source = message.TextSource
			if source then
				local player = Players:GetPlayerByUserId(source.UserId)
				local channel = message.TextChannel
				local prefix = Chat.prefix(if player then player:GetAttribute("LuneName") else nil, channel ~= nil and channel.Name == K.party.channel)
				if prefix then
					props.PrefixText = prefix
				end
			end
			return props
		end
	end)

	-- ④ 창이 차지한 자리(바뀔 때마다 다시 잰다 — 창 크기 · 창을 여닫을 때)
	for _, c in { window, bar } do
		if c then
			pcall(function()
				c:GetPropertyChangedSignal("AbsoluteSize"):Connect(measure)
				c:GetPropertyChangedSignal("AbsolutePosition"):Connect(measure)
				c:GetPropertyChangedSignal("Enabled"):Connect(measure)
			end)
		end
	end
	Stage.onResize(measure)
	task.delay(2, measure) -- 채팅 화면이 뜬 뒤(문서의 본보기도 잠깐 기다렸다가 잰다)
	measure()
end

return Chat

end
MODULES['Client/lune/chooser'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- ※ 2026-10-10부터 쓰지 않는다 — 처음 화면은 title.luau다. 이 파일은 화면을 RunService.RenderStepped 이벤트에서 고쳐서, 캐릭터의 그림과 틀의 크기가 한 장 어긋나 그려지는 잘못이 있다(title.luau의 「돌리기」에 적은 것). 다시 쓰려면 BindToRenderStep으로 바꿀 것.
-- 직업 고르기 — 처음 온 사람에게 한 번 나온다. 달 아래 다섯 영웅이 나란히 서 있고, 하나를 고르면 그 영웅의 달 · 무기 · 싸우는 법이 뜬다.
--  ← → 로 고르고 Space(또는 Enter)로 정한다. 눌러서(터치) 고를 수도 있다 — 고른 영웅을 한 번 더 누르면 정해진다.
--  자료는 shared/lune/data/classes.generated.luau(공방의 전직 설계와 줄거리에서 내보낸 것). 글씨는 제 칸을 넘지 않게 폭을 준다.
--  하늘 · 영웅들은 게임 세계의 층에, 글(제목 · 이름 · 설명 판)은 화면 틀의 층(고운 격자)에 그린다 — 늘 보이는 화면과 같은 방식.
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local lune = ReplicatedStorage.shared.lune
local G = require(lune.config.game)
local CLASSES = require(lune.data["classes.generated"])
local COMBAT = require(lune.data["combat.generated"])
local SCENES = require(lune.data["scenes.generated"])
local ASSETS = require(lune.data["assets.generated"])
local Stage = require(script.Parent.stage)
local Sprite = require(script.Parent.sprite)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR
local INK = Color3.fromRGB(18, 22, 28)
local WHITE, GRAY, MINT, PINK = C.text, C.dim, C.accent, C.pink

local GROUND_Y = 124 -- 영웅들이 서는 높이(게임의 도트)
local GAP = 70 -- 영웅 사이의 간격(게임의 도트 — 이름이 겹치지 않을 만큼)
local PANEL = { w = 520, h = 86, up = 44 } -- 설명 판(화면 틀의 점): 아래 가운데에, 화면 아래에서 up만큼 위

local Chooser = {}

-- 직업을 고를 때까지 기다렸다가 고른 직업의 이름을 돌려준다
function Chooser.run(): string
	local root = Stage.group(Stage.view, "Chooser", 200)
	root.BackgroundTransparency = 0
	local town = SCENES.scenes[SCENES.start]
	root.BackgroundColor3 = Color3.fromRGB(tonumber(town.sky:sub(2, 3), 16), tonumber(town.sky:sub(4, 5), 16), tonumber(town.sky:sub(6, 7), 16))
	-- 달이 뜬 하늘과 먼 산(마을과 같은 그림)
	for i, l in town.layers do
		if i <= 2 then
			local img = Stage.image(root, "Layer" .. i, ASSETS[l.img] or "", l.w, l.h)
			img.Position = UDim2.fromOffset(0, l.y)
		end
	end
	-- 서 있는 바닥
	local floor = Instance.new("Frame")
	floor.Position = UDim2.fromOffset(0, GROUND_Y)
	floor.Size = UDim2.fromOffset(G.VIEW_W, G.VIEW_H - GROUND_Y)
	floor.BackgroundColor3 = INK
	floor.BorderSizePixel = 0
	floor.ZIndex = 3
	floor.Parent = root

	-- 글의 층(화면 틀): 제목 · 영웅의 이름 · 설명 판 · 누르는 자리
	local over = Stage.group(Stage.ui, "Chooser", 200)
	local titleBox = Stage.place(over, "Title", "tc", Stage.REF_W / 2 - 300, 22, 600, 16)
	Ui.text(titleBox, "달이 고른 자 — 누구의 뒤를 이을 것인가", 0, 0, 600, { font = "body", align = "center", outline = true })

	local order = CLASSES.order
	local n = #order
	local x0 = G.VIEW_W / 2 - GAP * (n - 1) / 2
	local slots = {}
	for i, id in order do
		local c = CLASSES.classes[id]
		local x = x0 + (i - 1) * GAP
		local sprite = Sprite.new(root, id, 5)
		local name = Ui.tag(over, c.name, WHITE, 200)
		-- 눌러서 고르는 자리(보이지 않는 단추)
		local button = Instance.new("TextButton")
		button.Name = "Pick_" .. id
		button.Text = ""
		button.BackgroundTransparency = 1
		button.ZIndex = 8
		button.Parent = over
		slots[i] = { id = id, class = c, x = x, sprite = sprite, name = name, button = button }
	end
	-- 이름과 누르는 자리는 영웅의 자리(게임의 도트)를 따라 놓는다 — 화면 틀의 배율이 바뀌면 다시 놓는다
	local function place()
		local r = Stage.ratio
		for _, s in slots do
			local cx, gy = math.floor(s.x * r + 0.5), math.floor(GROUND_Y * r + 0.5)
			s.name.Frame.Position = UDim2.fromOffset(cx - math.floor(s.name.Width / 2), gy + 6)
			s.button.Position = UDim2.fromOffset(cx - math.floor(GAP * r / 2), gy - math.floor(44 * r))
			s.button.Size = UDim2.fromOffset(math.floor(GAP * r), math.floor(44 * r) + 24)
		end
	end
	place()
	Stage.onResize(function()
		if over.Parent then
			place()
		end
	end)

	-- 고른 영웅의 설명: 아래 가운데의 판
	local holder = Stage.place(over, "Panel", "bc", Stage.REF_W / 2 - PANEL.w / 2, Stage.REF_H - PANEL.up - PANEL.h, PANEL.w, PANEL.h + 24)
	local panel = Ui.panel(holder, 0, 0, PANEL.w, PANEL.h)
	local head = Ui.text(panel, "", 18, 14, PANEL.w - 36, { font = "body", color = MINT })
	local role = Ui.text(panel, "", 18, 36, PANEL.w - 36, { lines = 3, line = 15 })
	Ui.text(holder, "← → 고르기 · Space 정하기", 0, PANEL.h + 8, PANEL.w, { align = "center", color = GRAY, outline = true })

	local picked = math.ceil(n / 2)
	local chosen: string? = nil
	local pickedAt = 0
	local clock = 0

	local function show()
		local slot = slots[picked]
		local c = slot.class
		head:color(if c.tone == "pink" then PINK else MINT)
		head:set(c.weapon) -- 무기만 적는다 — 처음에는 아무 이야기도 들려주지 않는다(사용자 2026-10-08: "처음에는 아무 스토리도 모르다가 그냥 캐릭터 키우다가")
		role:set(c.role)
		for i, s in slots do
			s.name:SetColor(if i == picked then WHITE else GRAY)
		end
		pickedAt = clock
	end
	local function pick(i: number)
		if i == picked then
			chosen = slots[i].id -- 고른 영웅을 한 번 더 누르면 정해진다
		else
			picked = i
			show()
		end
	end
	show()

	local connections = {}
	for i, s in slots do
		table.insert(connections, s.button.Activated:Connect(function()
			pick(i)
		end))
	end
	table.insert(connections, UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local key = input.KeyCode
		if key == Enum.KeyCode.Left then
			picked = (picked - 2) % n + 1
			show()
		elseif key == Enum.KeyCode.Right then
			picked = picked % n + 1
			show()
		elseif key == Enum.KeyCode.Space or key == Enum.KeyCode.Return then
			chosen = slots[picked].id
		end
	end))

	-- 고른 영웅은 사냥기를 한 번씩 써 보이고, 나머지는 서 있다(흐리게)
	local function mobSkill(id: string)
		for _, sk in COMBAT.skills do
			if sk.who == id and sk.type == "mob" then
				return sk
			end
		end
		return nil
	end
	table.insert(connections, RunService.RenderStepped:Connect(function(dt)
		clock += dt
		for i, s in slots do
			local char = s.sprite.char
			local clip, frame = "idle", Sprite.frameAt(char, "idle", clock + i * 0.2, false)
			if i == picked then
				local sk = mobSkill(s.id)
				local t = (clock - pickedAt) % 3 - 0.8 -- 0.8초 서 있다가 기술을 쓴다
				if sk and t >= 0 then
					for _, seg in sk.segs do
						if t < seg.time then
							clip, frame = seg.clip, seg.from + math.min(seg.to - seg.from, math.floor(t * seg.fps)) + 1
							break
						end
						t -= seg.time
					end
				end
			end
			s.sprite:set(clip, frame, s.x, GROUND_Y, 1)
			s.sprite.label.ImageTransparency = if i == picked then 0 else 0.45
		end
	end))

	while not chosen do
		task.wait()
	end
	for _, c in connections do
		c:Disconnect()
	end
	Chooser.root = root -- 서버의 답을 받을 때까지 화면을 그대로 둔다 — 부른 쪽이 close()로 닫는다
	Chooser.over = over
	return chosen :: string
end

function Chooser.close()
	if Chooser.root then
		Chooser.root:Destroy()
		Chooser.root = nil
	end
	if Chooser.over then
		Chooser.over:Destroy()
		Chooser.over = nil
	end
end

return Chooser

end
MODULES['Client/lune/cineView'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 퀘스트 연출(장면)의 그리기(2026-10-15) — 공방 「횡스크롤 시험」 탭의 장면(js/lune/luneTab.js의 drawCineActors · drawCineOver · paintCine)과 같은 자리 · 모양.
--  사용자 2026-10-15: "현재 메인 퀘스트 라인 너무스토리 몰입이 안됩니다 … 몰입되는 중간에 연출이 있는것도아니고 다른게임들 어떻게 스토리 진행하는지 좀 파악하고 만들어야합니다."
--  셈은 shared/lune/cine.luau(무엇이 언제 끝나나 · 누가 어디에). 여기서는 그 상태를 화면에 옮긴다:
--   세계(게임 도트): 장면이 세운 졸개 · 주민 · 쓰러질 때 흩어지는 재 / 화면 틀(고운 격자): 색 덮개 · 큰 그림 · 위아래 검은 띠 · 암전 · 장의 이름 · 보스의 이름 · 종이 · 머리 위 표시 · 「건너뛰기」
--   말은 아래의 대화창(ui/talk.luau의 Talk.cine)에 뜬다. 카메라 · 주민의 자리는 sceneView.luau가 장면의 값(camOverride · npcOver)을 읽는다.
--  boot.luau가 부른다: CineView.init(부모) · CineView.play(def, 세계) · CineView.update(dt, 세계의 층) · CineView.input("next" | "skip") · CineView.active()
--  퀘스트 동안의 맵 모습(불타는 마을의 붉은 하늘 — 장면 밖에서도): CineView.setLook(색, 비침)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local lune = ReplicatedStorage.shared.lune
local Cine = require(lune.cine)
local SCENES = require(lune.data["scenes.generated"])
local ASSETS = require(lune.data["assets.generated"])
local CHARS = require(lune.data["chars.generated"])
local Layout = require(lune.ui.layout)
local Format = require(lune.ui.format)
local Stage = require(script.Parent.stage)
local Overlay = require(script.Parent.overlay)
local Sprite = require(script.Parent.sprite)
local Ui = require(script.Parent.ui.ui)
local Talk = require(script.Parent.ui.talk)
local pixelText = require(script.Parent.Parent.modules.ui.pixelText)

local C = Ui.COLOR
local M = Ui.M
local CL = Layout.CINE
local LK = Cine.DATA.ui
local CPS = Format.DIALOG.cps
local INK = Color3.fromRGB(5, 7, 11)
local PINK = Color3.fromRGB(255, 126, 162)
local MINT = Color3.fromRGB(62, 255, 215)
local ASH = { Color3.fromRGB(201, 204, 209), Color3.fromRGB(139, 144, 152), Color3.fromRGB(74, 79, 87) }

local View = {}
View.onEnd = nil :: ((any) -> ())? -- 장면이 끝났다(def) — boot가 서버에 「봤다」를 알리고 다음 장면을 튼다

local low: Frame, high: Frame
local lookTint: Frame, tint: Frame, backdrop: Frame, picture: ImageLabel, glow: Frame, glowStroke: UIStroke
local cardBand: Frame, titleBand: Frame, barTop: Frame, barBottom: Frame, shade: Frame
local cardBox: Frame, cardText, cardSub, cardLines: { Frame }
local titleBox: Frame, titleText, titleSub, titleLine: Frame
local noteBox: Frame, notePaper: ImageLabel, noteShadow: ImageLabel, noteTitle, noteRows: { any }, noteHint, noteKey
local skipBtn, skipEsc, catcher: TextButton
local marks: { any } = {}
local session: any = nil

local function bigLabel(parent: Instance, color: Color3)
	-- 두 배 글: 틀에 UIScale 2를 걸고 그 안에 본문 글씨(테두리)를 놓는다
	local box = Ui.group(parent, 0, 0, 10, 10, "Big")
