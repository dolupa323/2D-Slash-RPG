	-- 전직해서 칸이 바뀌었다(서버가 윗차수의 사냥기 · 보스기를 앞 차수의 자리에 넣었다)
	state.onJob = function(me)
		state.slots = me.slots or state.slots
		state.touchSlots = me.tslots or state.touchSlots
