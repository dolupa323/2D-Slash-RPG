	-- 게임에 들어온다: 처음 화면(캐릭터 고르기) 위로 막을 치고 → 그 뒤에서 게임 화면을 그리고 → 그림이 다 불러와지면 막을 걷는다(아래 — 화면이 돌기 시작한 뒤)
	Curtain.cover()
	enterScene(first.scene, first.x, first.y, first.room)
	Title.close() -- 게임 화면이 그려졌다: 처음 화면을 걷는다
	state.busy = true

	-- 캐릭터 고르기 화면으로 돌아간다(메뉴 → 캐릭터 선택): 서버가 저장하고 세계에서 빼 준 뒤, 고르기 화면에서 고른 캐릭터로 다시 들어온다.
	--  그동안 게임 화면은 멈춰 있다(자리 보고 · 기술 · 창을 여는 키를 받지 않는다). 확인용 임시 캐릭터(LuneGuest = 직업)에게는 고르기 화면이 없다.
	state.toSelect = function()
		if state.paused then
			return
		end
		state.paused = true
		Input.paused = true
		while Windows.closeTop() do
		end
		Talk.close()
		local left = Net.Invoke("Chars", "leave", nil, nil)
		if not (left and left.select) then
			state.paused, Input.paused = false, false
			if state.fx then
				state.fx:float("이 캐릭터로는 캐릭터 선택으로 갈 수 없다", state.body.x, state.body.y - 46, Effects.MINT, 1.6)
			end
			return
		end
		-- 게임 화면의 것(이름표 · 문 위의 글 · 손가락 단추)은 고르기 화면 위에 비치지 않게 숨긴다
		local touchWas = Touch.root ~= nil and Touch.root.Visible
		Hud.root.Visible = false
		Overlay.root.Visible = false
		if Touch.root then
			Touch.root.Visible = false
		end
		DeathBox.hide()
		Guide.clear()
		PartyHud.ask(nil) -- 앞 캐릭터가 받은 파티 초대는 지운다(서버는 이미 지웠다 — 2026-10-18 검토)
		closeMenus()
		Music.play(MUSIC.title)
		local got = Title.run(left.select, {
			skipLoading = true,
			invoke = function(action: string, a: any, b: any)
				return Net.Invoke("Chars", action, a, b)
			end,
		})
		adopt(got)
		state.daily = nil
		state.fetchDaily() -- 바꿔 들어온 캐릭터의 일일 의뢰
		state.attend, state.ach = nil, nil
		state.fetchAttend() -- 출석 칸(오늘 처음이면 창이 뜬다 — 계정에 하루 한 번이라 대개는 이미 찼다)
		Windows.resetLevel(got.self.level)
		Input.reset()
		Input.import(got.self.keys)
		drawKeyHints()
		Touch.setCounts()
		Curtain.cover() -- 고르기 화면 위로 막을 치고, 그 뒤에서 게임 화면을 그린다
		enterScene(got.scene, got.x, got.y, got.room)
		Hud.root.Visible = true
		Overlay.root.Visible = true
		if Touch.root then
			Touch.root.Visible = touchWas
		end
		Title.close()
		state.acc = 0
		state.busy = true
		state.paused, Input.paused = false, false
		task.spawn(function()
			showLoaded() -- 그 장면의 그림이 다 불러와진 뒤에 막을 걷는다
			Curtain.lift()
			afterLift()
			Input.flush()
			state.busy = false
		end)
	end

	local markT = 0
	RunService:BindToRenderStep("LuneFrame", Enum.RenderPriority.Camera.Value - 1, function(dt)
		if state.paused then
			return -- 캐릭터 고르기 화면에 가 있다
		end
		state.now += dt
		state.acc = math.min(state.acc + dt, STEP * MAX_STEPS)
		while state.acc >= STEP do
			state.acc -= STEP
			step()
		end
		draw(dt)
		Hud.step(dt) -- 체력 바의 효과
		QuestHud.step(state.now) -- 켠 길찾기 단추의 빛
		-- 길찾기의 화살표: 켜 둔 퀘스트의 지금 진행에 맞는 쪽을 머리 위에(쓰러졌거나 장면을 바꾸는 중에는 숨긴다)
		if state.naviArrow then
			local dirNow = nil
			if state.navi and not state.dead and not state.busy and state.me and not CineView.active() then -- 장면이 도는 동안은 화살표를 숨긴다
				Navi.prepare(state.sceneKey) -- 이 맵의 발판과 길을 조금씩 잰다(다 재면 화살표가 발판을 따라 가리킨다)
				-- 땅에 서 있는 동안 1초에 10번만 다시 셈한다(맵이 바뀌었거나 방향이 없으면 바로 — 2026-10-18 검토: 매 장면 맵 사이의 길 · 발판 길을 다시 셈했다)
				if state.naviDir == nil or state.naviScene ~= state.sceneKey or (state.body.ground and state.now - (state.naviAt or -9) >= 0.1) then
					state.naviAt = state.now
					local mobs = {}
					if state.mobs then
						for id, m in state.mobs.mobs do
							if m.state ~= "gone" and m.state ~= "dead" then
								-- 길찾기는 { id, kind, x, y }를 본다 — 화면의 몬스터는 종류 · 높이를 info에 둔다(2026-10-18 검토: 그대로 넘겨 종류가 맞지 않아 사냥터에서 화살표가 몬스터를 가리키지 않고 사라졌다)
								table.insert(mobs, { id = id, kind = m.info.kind, x = m.x, y = m.info.y })
							end
						end
					end
					local arrow = Navi.arrow(state.navi, state.sceneKey, state.body.x, state.body.y, state.quests, state.me.level, state.daily, mobs)
					state.naviDir, state.naviScene = if arrow then arrow.dir else "none", state.sceneKey
				end
				-- 뛰어오른 동안에는 땅에 있을 때의 방향을 그대로 둔다(공중에서는 선 발판이 없어 길을 셈하지 못한다 — 화살표가 깜빡이지 않게)
				dirNow = state.naviDir
			else
				state.naviDir = nil
			end
			state.naviArrow:set(dirNow, state.body.x, state.body.y, state.now)
		end
		if state.me and state.body then
			if state.skill then
				TutView.cast = true -- 튜토리얼: 기술을 썼다
			end
			-- 꿈(튜토리얼)에서는 Lv.1이어도 가방이 열린다(「가방 열기」 미션) — 꿈을 나서면 거둔다. 바뀌면 화면 아래의 단추 줄을 다시 그린다
			local dreaming = state.sceneKey == Tutorial.SCENE
			if (Windows.extra.bag == true) ~= dreaming then
				Windows.extra.bag = if dreaming then true else nil
				if not dreaming then
					Windows.close("bag")
				end
				if state.drawKeyHints then
					state.drawKeyHints()
				end
			end
			local skillKey, skillName = state.slotOf("mob")
			TutView.update({
				tut = state.me.tut, skip = state.me.tutSkip, scene = state.sceneKey, zones = SCENES.scenes[state.sceneKey] and SCENES.scenes[state.sceneKey].tut,
				body = state.body, touch = Touch.on, key = state.keyName, dt = dt,
				skill = if skillKey then ("%s 키 「%s」"):format(skillKey, skillName or "") else nil, potion = (state.slotOf("potion")),
				windows = { bag = Windows.isOpen("bag"), stat = Windows.isOpen("stat"), skill = Windows.isOpen("skill") }, find = state.tutFind,
			})
		end
		Guide.step(dt)
		MapName.step(dt, (BossView.box ~= nil and BossView.box.Visible) or CineView.active() or Windows.anyOpen()) -- 보스 체력 · 퀘스트 연출이 그 자리를 쓰거나 창이 열리면(창의 윗부분과 겹친다 — 2026-10-18) 바로 사라진다. 보스 체력은 칸이 보일 때만(전에는 한 번 보인 보스의 이름이 남아, 첫 보스 뒤로 맵 이름이 영영 안 떴다 — 2026-10-18 검토)
		GainLog.step(dt)
		markT += dt
		if markT >= 0.25 then
			markT = 0
			debugMarks()
			Guide.setHint(if Talk.npc then nil else state.guide()) -- 말풍선이 떠 있는 동안은 안내를 걷는다
		end
	end)
	-- 처음 장면의 그림이 다 불러와지면 막을 걷는다(그때까지 캐릭터는 멈춰 있다)
	task.spawn(function()
		showLoaded()
		Curtain.lift()
		afterLift()
		Input.flush()
		state.busy = false
	end)
	print(("[lune] 시작 — 장면 %s · 캐릭터 %s · 배율 x%s"):format(state.sceneKey, state.who, tostring(math.floor(Stage.scale * 100 + 0.5) / 100)))
end

return Boot

end
MODULES['Client/lune/bossView'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 스토리 보스의 화면 — 예고(바닥에 칠해지는 맞을 자리 · 머리 위의 느낌표) · 치는 순간의 이펙트 그림과 화면 흔들림 · 땅 울림의 물결 · 내달리기의 잔상과 먼지 ·
--  화면 위 가운데의 체력 바(이름 · 숫자 · 지금 쓰는 패턴의 이름).
--  보스가 무엇을 하는지는 서버가 정한다(sim/room.luau의 stepBoss) — 여기서는 서버가 보내는 모습(상태 · 패턴의 차례 · 흐른 시간: mobsView가 받아 적는다)이
--  바뀌는 때를 보고 그림을 띄운다. 그리는 것은 shared/lune/bossfx.luau(공방 시험 탭의 bossfx.js를 옮긴 것), 자료는 COMBAT.mobs[보스].story(공방 design/bosses.js의 STORYBOSS).
--  몸의 그림(대기 그림을 움직여 대신하는 것 · 예고 때의 분홍 윤곽)은 mobsView.luau가 그린다.
--  사용자 2026-10-11(해 보고): "뭐 보스 패턴도 없고 이펙트도없고 체력 몇인지도 숫자로안보이고 …" → 체력 바 안에 숫자(지금/최대)를 적고, 패턴을 쓸 때 그 이름을 바 아래에 띄우고, 예고와 이펙트를 크게 했다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local BossFx = require(lune.bossfx)
local BossPat = require(lune.sim.bosspat) -- 표시된 자리 · 도약 · 물결의 자리와 시간(서버와 같은 셈)
local MobsView = require(script.Parent.mobsView)
local Layout = require(lune.ui.layout)
local Format = require(lune.ui.format)
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)
local HpBar = require(script.Parent.ui.hpBar) -- 체력 바의 효과(플레이어의 체력 바와 같은 셈)

local C = Ui.COLOR
local M = Ui.M
local TRAIL = 0.05 -- 내달리는 동안 발밑의 먼지를 내는 간격(초 — 그 패턴에 적힌 것이 없을 때)
local GHOST = 0.07 -- 내달리는 동안 잔상을 남기는 간격(초)
local PINK = Color3.fromRGB(255, 126, 162) -- 패턴의 이름 · 잔상(적의 분홍)

local BossView = {}
BossView.__index = BossView

-- 화면 위 가운데의 체력 바(한 번 만든다): 이름(금색) · 넓은 바(안에 지금/최대 숫자) · 그 아래에 지금 쓰는 패턴의 이름(분홍)
--  공방 「기본 · UI」의 UILAYOUT.boss · 시험 탭의 P.bossBar와 같은 자리 · 크기
function BossView.init(root: Frame)
	local B = Layout.BOSS
	local box = Stage.place(root, "Boss", "tc", math.floor((Stage.REF_W - B.w) / 2), B.y, B.w, B.patY + 16)
	box.Visible = false
	BossView.box = box
	BossView.name = Ui.text(box, "", 0, 0, B.w, { font = "body", color = C.gold, align = "center", outline = true })
	BossView.bar = Ui.bar(box, 0, B.barY, B.w, B.h, C.hp)
	BossView.barFx = HpBar.attach(BossView.bar, B.w, B.h) -- 닳은 자리가 밝게 남았다 줄어든다 · 번쩍임(사용자 2026-10-13: "몬스터 체력바도  유저 체력바처럼 고도화 되어야합니다.")
	BossView.hpText = Ui.text(box, "", B.pad, B.barY + math.floor((B.h - M.small) / 2), B.w - B.pad * 2, { align = "center", outline = true, z = 6 })
	BossView.pat = Ui.text(box, "", 0, B.patY, B.w, { font = "body", color = PINK, align = "center", outline = true })
	BossView.shownName, BossView.shownHp, BossView.shownPat = nil, nil, nil
end

-- 체력 글: "지금 / 최대"(칸에 안 들어가면 짧게 — shared/lune/ui/format.luau의 hp)
function BossView.hpLabel(hp: number, maxHp: number, width: number, measure): string
	return Format.hp(math.max(0, math.ceil(hp)), maxHp, width, measure)
end

-- mobs = 그 장면의 졸개 그림(mobsView) · cast = 기술의 이펙트를 돌리는 것(cast.fx = 이펙트 한 벌 · 화면 흔들기) · effects = 장면의 효과(잔상) · scene = 장면 자료(bosses의 range = 내달리기의 끝)
--  hooks = { push(x, dist) } — 보스가 포효할 때 부른다(x = 보스의 자리 · dist = 밀어내는 거리): 내 캐릭터가 가까이 있으면 밀려난다(boot.luau)
--          music(곡의 이름표 또는 nil) — 보스가 나타나 그 곡으로 바꿀 때 · 쓰러지거나 사라져 맵의 곡으로 돌아갈 때(nil)
function BossView.new(mobs, cast, effects, scene, hooks)
	local self = setmetatable({ cast = cast, effects = effects, list = {}, hooks = hooks or {}, spots = {} }, BossView)
	-- 이펙트 한 벌: 예고(맞을 자리 · 느낌표)는 기술의 이펙트와 같은 판(cast.fx)에 그리고, 패턴의 이펙트 그림(스프라이트)은 장면의 효과(effects:play)가 튼다
	self.fx = setmetatable({
		sprite = function(who: string, clip: string, x: number, y: number, dir: number, opts)
			if effects and effects.play then
				effects:play(who, clip, x, y, dir, opts)
			end
		end,
	}, { __index = cast.fx })
	self.roomLo, self.roomHi = BossPat.bounds(scene) -- 표시된 자리들이 놓이는 범위(서버와 같다)
	self.shake = function(amount: number, t: number)
		cast.shakeA, cast.shakeT = math.max(cast.shakeA or 0, amount), math.max(cast.shakeT or 0, t)
	end
	-- 방의 양 끝(보스가 선 바닥 바로 위의 줄에서 막힌 칸이 아닌 첫 칸 · 끝 칸): 땅 울림의 물결을 그 밖으로는 그리지 않는다(서버의 판정도 벽에서 멈춘다)
	self.lo, self.hi = 0, scene.w * 16
	local first = (scene.bosses or {})[1]
	if first then
		local row = scene.rows[math.floor((first.y - 1) / 16) + 1]
		local mid = math.floor(first.x / 16)
		local a, b = mid, mid
		while a > 0 and string.sub(row, a, a) ~= "#" do
			a -= 1
		end
		while b < scene.w - 1 and string.sub(row, b + 2, b + 2) ~= "#" do
			b += 1
		end
		self.lo, self.hi = a * 16, (b + 1) * 16
	end
	local range = {}
	for _, b in scene.bosses or {} do
		range[b.kind] = b.range
	end
	for _, m in mobs.mobs do
		if m.def.story then
			local r = range[m.info.kind] or { 0, scene.w * 16 }
			table.insert(self.list, { m = m, state = m.state, pat = m.pat or 0, a = r[1], b = r[2], trail = 0, ghost = 0, x = nil :: number? })
		end
	end
	table.sort(self.list, function(p, q)
		return p.m.info.id < q.m.info.id
	end)
	return self
end

function BossView:update(dt: number)
	local shown, shownPat = nil, ""
	local now = os.clock()
	for _, b in self.list do
		local m = b.m
		local pat = m.pat or 0
		local S = m.def.story
		local p = MobsView.patOf(m) -- 연속기 안에서는 예고 · 굳는 시간이 줄어든 것
		local y = m.info.y
		local top = m.sprite.char.fh -- 그림의 높이(뿔 · 깃발까지) — 느낌표를 그 위에 띄운다
		local who = m.sprite.who -- 패턴의 이펙트 그림은 그 보스의 동작 묶음에 있다
		if m.state == "tell" and p and (b.state ~= "tell" or b.pat ~= pat) then
			-- 예고가 시작됐다: 그 자리에(보스는 예고하는 동안 서 있다 — 연속기는 한 걸음 다가서며) 맞을 자리와 머리 위의 느낌표를 그린다 — 끊기면(묶임) 그리지 않는다
			--  도약 찍기: 내려앉을 자리는 겨눈 사람을 따라오고(m.aim), 날아가는 동안에도 보인다
			b.x = m.toX
			self.fx.add(p.tell + (if p.leap then p.leap.time else 0) + 0.5, function(ctx)
				if m.state == "tell" and m.pat == pat then
					BossFx.tell(ctx, m.x, y, m.dir, p, math.clamp((m.tNow or 0) / p.tell, 0, 1), b.a, b.b, top, m.aim)
				elseif p.leap and m.state == "act" and m.pat == pat and (m.tNow or 0) < p.leap.time then
					BossFx.tell(ctx, b.leapX or m.x, y, b.leapDir or m.dir, p, 1, b.a, b.b, nil, m.aim)
				end
			end, { back = true })
			if p.spots then
				-- 표시된 자리들(불씨 뿌리기 · 봉화 불기둥): 지금 정해진다 — 예고가 끝나면(자리마다 더 기다린 뒤) 솟는다. 자리는 서버와 같은 식으로 센다
				local fromX, fromY = nil, nil
				if p.spots.aim ~= "grid" then
					fromX, fromY = m.toX - m.dir * 10, y - m.def.body[2] - 16 -- 등의 화로에서 불씨가 날아온다
				end
				for _, sp in BossPat.spots(p, m.aim or m.toX, self.roomLo, self.roomHi) do
					local spot = { m = m, who = who, pat = pat, x = sp[1], at = now, T = p.tell + sp[2], def = p.spots, live = true, armed = false }
					table.insert(self.spots, spot)
					self.fx.add(spot.T + 0.1, function(ctx)
						if spot.live then
							BossFx.spot(ctx, spot.x, y, spot.def.r, spot.def.up, (os.clock() - spot.at) / spot.T, fromX, fromY)
						end
					end, { back = true })
				end
			end
		elseif (m.state == "act" or m.state == "dash") and p and b.state == "tell" then
			local x = m.toX
			if p.leap then
				-- 도약: 뛰어오른다 — 이펙트와 물결은 내려앉을 때
				BossFx.jump(self.fx, who, p, b.x or x, y)
				b.leapX, b.leapDir, b.leapPat = b.x or x, m.dir, pat
			else
				-- 친다: 그 순간의 이펙트(화면이 흔들린다) · 물결(화면이 조금 늦게 알았으면 그만큼 간 자리에서 시작한다)
				BossFx.strike(self.fx, who, p, x, y, m.dir, self.shake)
				for _, spot in self.spots do
					if spot.m == m and spot.pat == pat then
						spot.armed = true -- 예고가 끝까지 갔다: 표시된 자리는 이제 보스가 무엇을 하든 제 때에 솟는다
					end
				end
				if p.wave then
					for _, w in BossPat.waves(p, m.dir) do
						BossFx.wave(self.fx, who, x + m.dir * p.wave.at, y, w[1], p.wave, (m.tNow or 0) - w[2], self.lo, self.hi)
					end
				end
			end
			b.trail, b.ghost = 0, 0
			b.dashP = if p.dash then p else nil -- 내달리기가 끝날 때(그때는 패턴이 이미 바뀌어 있다) 그 패턴의 그림으로 터진다
		elseif b.state == "dash" and m.state ~= "dash" and m.state ~= "gone" and m.state ~= "dead" then
			-- 내달리기가 끝났다(벽에 닿았다)
			BossFx.crash(self.fx, who, b.dashP, m.toX, y, m.dir, self.shake)
		elseif m.state == "roar" and b.state ~= "roar" then
			-- 체력 구간의 포효: 큰 고리와 긴 흔들림 — 가까이 있는 내 캐릭터는 밀려난다
			BossFx.roar(self.fx, who, S, m.toX, y, self.shake)
			if self.hooks.push and S.phase then
				self.hooks.push(m.toX, S.phase.push)
			end
		end
		if b.leapPat and (m.state ~= "act" or m.pat ~= b.leapPat) then
			b.leapPat = nil -- 뛰어오른 것이 끊겼다(묶임)
		elseif b.leapPat and p and p.leap and (m.tNow or 0) >= p.leap.time then
			-- 도약: 내려앉았다 — 그 자리에서 친다
			b.leapPat = nil
			BossFx.strike(self.fx, who, p, m.toX, y, m.dir, self.shake)
			if p.wave then
				for _, w in BossPat.waves(p, m.dir) do
					BossFx.wave(self.fx, who, m.toX + m.dir * p.wave.at, y, w[1], p.wave, (m.tNow or 0) - p.leap.time - w[2], self.lo, self.hi)
				end
			end
		end
		if m.state == "dash" then
			b.trail -= dt
			if b.trail <= 0 then
				local dp = if p and p.dash then p else b.dashP
				b.trail = (dp and dp.dash.trail and dp.dash.trail.every) or TRAIL
				BossFx.dashTrail(self.fx, who, dp, m.x, y, m.dir)
			end
			b.ghost -= dt
			if b.ghost <= 0 and self.effects then
				b.ghost = GHOST
				self.effects:ghost(m.def.sprite, "idle", 1, m.x, y, m.dir, PINK) -- 달리는 몸의 잔상(분홍)
			end
		end
		if (b.state ~= m.state or b.pat ~= pat) and BossView.box then
			-- 확인용: 지금 보스가 하는 것을 체력 바의 틀에 적어 둔다(PlayerGui.LuneStage.Holder.Ui.Hud.Boss의 속성 State · Pattern · Chain)
			if m.state ~= "gone" then
				BossView.box:SetAttribute("State", m.state)
				BossView.box:SetAttribute("Pattern", if p then p.id else "")
				BossView.box:SetAttribute("Chain", if S.patterns[m.chain or 0] then S.patterns[m.chain].id else "")
			end
		end
		b.state, b.pat = m.state, pat
		if m.state ~= "gone" and m.state ~= "dead" then
			shown = m
			-- 바 아래의 이름: 포효 = 그 이름 · 연속기 = 연속기의 이름 · 그 밖에는 패턴의 이름
			local chain = S.patterns[m.chain or 0]
			shownPat = if m.state == "roar" and S.phase then S.phase.name elseif p and (m.state == "tell" or m.state == "act" or m.state == "dash") then (if chain then chain.name else p.name) else ""
		end
	end
	-- 표시된 자리들: 때가 되면 솟는다. 예고하던 중에 끊기거나(묶임) 보스가 쓰러지면 사라진다(서버와 같다)
	for i = #self.spots, 1, -1 do
		local spot = self.spots[i]
		local m = spot.m
		local age = now - spot.at
		if m.state == "dead" or m.state == "gone" or (not spot.armed and not (m.state == "tell" and m.pat == spot.pat)) then
			spot.live = false
			table.remove(self.spots, i)
		elseif age >= spot.T then
			spot.live = false
			table.remove(self.spots, i)
			BossFx.blast(self.fx, spot.who, spot.x, m.info.y, spot.def, self.shake)
		end
	end
	-- 보스의 곡: 보스가 나타나 있는 동안은 그 보스의 곡을(없으면 그 맵의 곡 그대로), 쓰러지거나 사라지면 맵의 곡으로 — 바뀔 때만 알린다(boot.luau가 튼다)
	local track = if shown then shown.def.story.music else nil
	if track ~= self.track then
		self.track = track
		if self.hooks.music then
			self.hooks.music(track)
		end
	end
	local box = BossView.box
	if not box then
		return
	end
	box.Visible = shown ~= nil
	if shown then
		if BossView.shownName ~= shown.info.name then
			BossView.shownName = shown.info.name
			BossView.name:set(shown.info.name)
		end
		if BossView.shownMob ~= shown then
			BossView.shownMob = shown -- 다른 보스 · 다시 나타난 보스: 효과 없이 그대로 놓는다
			BossView.shownHp = nil
			BossView.barFx:reset()
		end
		if BossView.shownHp ~= shown.hp then
			BossView.shownHp = shown.hp
			BossView.barFx:set(math.max(0, shown.hp) / shown.info.maxHp, math.max(0, shown.hp))
			BossView.hpText:set(BossView.hpLabel(shown.hp, shown.info.maxHp, Layout.BOSS.w - Layout.BOSS.pad * 2, Ui.measure))
		end
		if BossView.shownPat ~= shownPat then
			BossView.shownPat = shownPat
			BossView.pat:set(shownPat)
		end
		BossView.barFx:step(dt)
	else
		BossView.shownMob = nil
	end
end

function BossView:destroy()
	table.clear(self.list)
	for _, spot in self.spots do
		spot.live = false
	end
	table.clear(self.spots)
	if BossView.box then
		BossView.box.Visible = false
	end
	BossView.shownHp, BossView.shownPat = nil, nil
end

return BossView

end
MODULES['Client/lune/canvas'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
--!native
--!optimize 2
-- 점 그림판 — 공방 시험 탭의 이펙트(dino-workshop/js/lune/fx.js · kits/*.js)는 캔버스에 점을 하나씩 찍어 그린다.
--  사용자 2026-10-08: "시험탭의 이펙트를 게임으로 옮기세요" — 게임도 같은 식으로 찍는다: 게임 화면 크기(384x216)의 EditableImage 두 장(캐릭터 뒤 · 앞)에
--  장마다 지우고 다시 찍는다. 그리는 쪽(client/lune/fx.luau · shared/lune/kits)은 시험 탭의 코드를 줄마다 옮긴 것이라, 캔버스의 2D 문맥에서 쓰던 것만 흉내 낸다:
--    ctx.fillStyle = c      → ctx:style(c)   (c = 0xRRGGBB)
--    ctx.globalAlpha = a    → ctx:alpha(a)   (0~1)
--    ctx.fillRect(x, y, w, h) → ctx:rect(x, y, w, h)   (게임 세계의 좌표 — 카메라만큼 밀어 찍는다. 화면 밖은 잘린다)
--  그림판은 맵 틀(world) 안에 카메라 자리로 놓여 화면에 붙어 있다(화면을 흔들면 같이 흔들린다).
--  EditableImage를 만들지 못하는 기기에서는 아무것도 찍지 않는다(게임은 그대로 돈다 — 이펙트만 안 보인다).
local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local G = require(ReplicatedStorage.shared.lune.config.game)

local W, H = G.VIEW_W, G.VIEW_H
local SIZE = Vector2.new(W, H)

local Ctx = {}
Ctx.__index = Ctx

local function newCtx(name: string)
	local self = setmetatable({}, Ctx)
	self.buf = buffer.create(W * H * 4)
	self.ox, self.oy = 0, 0 -- 카메라(게임 세계의 좌표에서 뺀다)
	self.r, self.g, self.b, self.a = 255, 255, 255, 255
	self.packed = 0xffffffff
	self.used = false -- 이번 장에 찍은 것이 있다
	self.shown = false -- 화면에 지난 장의 그림이 남아 있다
	local label = Instance.new("ImageLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.ResampleMode = Enum.ResamplerMode.Pixelated
	label.ScaleType = Enum.ScaleType.Stretch
	label.Size = UDim2.fromOffset(W, H)
	label.Active = false
	self.label = label
	local ok, image = pcall(function()
		return AssetService:CreateEditableImage({ Size = SIZE })
	end)
	if ok and image then
		self.image = image
		label.ImageContent = Content.fromObject(image)
	else
		warn("[lune] 점 그림판을 만들지 못했다 — 이펙트를 그리지 않는다: " .. tostring(image))
	end
	return self
end

function Ctx:style(c: number)
	local r, g, b = bit32.band(bit32.rshift(c, 16), 255), bit32.band(bit32.rshift(c, 8), 255), bit32.band(c, 255)
	self.r, self.g, self.b = r, g, b
	self.packed = r + g * 256 + b * 65536 + 255 * 16777216
end

function Ctx:alpha(a: number)
	self.a = math.clamp(math.floor(a * 255 + 0.5), 0, 255)
end

-- 네모를 채운다. 좌표와 크기는 가장 가까운 점으로 맞춘다
function Ctx:rect(x: number, y: number, w: number, h: number)
	local x0 = math.floor(x + 0.5) - self.ox
	local y0 = math.floor(y + 0.5) - self.oy
	local x1 = x0 + math.floor(w + 0.5)
	local y1 = y0 + math.floor(h + 0.5)
	if x0 < 0 then
		x0 = 0
	end
	if y0 < 0 then
		y0 = 0
	end
	if x1 > W then
		x1 = W
	end
	if y1 > H then
		y1 = H
	end
	local a = self.a
	if x1 <= x0 or y1 <= y0 or a <= 0 then
		return
	end
	self.used = true
	local buf = self.buf
	if a >= 255 then
		local v = self.packed
		for yy = y0, y1 - 1 do
			local i = (yy * W + x0) * 4
			for _ = x0, x1 - 1 do
				buffer.writeu32(buf, i, v)
				i += 4
			end
		end
		return
	end
	-- 비치는 점: 먼저 찍힌 점 위에 얹는다
	local r, g, b = self.r, self.g, self.b
	local inv = 255 - a
	for yy = y0, y1 - 1 do
		local i = (yy * W + x0) * 4
		for _ = x0, x1 - 1 do
			local da = buffer.readu8(buf, i + 3)
			if da == 0 then
				buffer.writeu8(buf, i, r)
				buffer.writeu8(buf, i + 1, g)
				buffer.writeu8(buf, i + 2, b)
				buffer.writeu8(buf, i + 3, a)
			else
				local rest = da * inv / 255
				local oa = a + rest
				buffer.writeu8(buf, i, math.floor((r * a + buffer.readu8(buf, i) * rest) / oa + 0.5))
				buffer.writeu8(buf, i + 1, math.floor((g * a + buffer.readu8(buf, i + 1) * rest) / oa + 0.5))
				buffer.writeu8(buf, i + 2, math.floor((b * a + buffer.readu8(buf, i + 2) * rest) / oa + 0.5))
				buffer.writeu8(buf, i + 3, math.floor(oa + 0.5))
			end
			i += 4
		end
	end
end

-- 그림(점 자료 { w, h, buf })의 한 조각을 찍는다 — 캔버스의 translate · scale · drawImage 대신.
--  자르는 네모 (sx, sy, w, h) · (x, y) = 기준점(게임 세계의 좌표) · (lx, ly) = 기준점에서 조각의 왼쪽 위까지 · flip = 기준점에서 좌우로 뒤집는다 · sc = 배(1 · 2) · mul = 불투명도의 배수
function Ctx:blit(src, sx: number, sy: number, w: number, h: number, x: number, y: number, lx: number, ly: number, flip: boolean?, sc: number?, mul: number?)
	local keepA, keepR, keepG, keepB, keepP = self.a, self.r, self.g, self.b, self.packed
	local base = keepA * (mul or 1)
	if base <= 0 then
		return
	end
	local s = sc or 1
	local data, sw = src.buf, src.w
	for j = 0, h - 1 do
		for i = 0, w - 1 do
			local at = ((sy + j) * sw + sx + i) * 4
			local sa = buffer.readu8(data, at + 3)
			if sa > 0 then
				local r, g, b = buffer.readu8(data, at), buffer.readu8(data, at + 1), buffer.readu8(data, at + 2)
				self.r, self.g, self.b = r, g, b
				self.packed = r + g * 256 + b * 65536 + 255 * 16777216
				self.a = math.floor(sa * base / 255 + 0.5)
				local px = lx + i
				self:rect(x + (if flip then -(px + 1) else px) * s, y + (ly + j) * s, s, s)
			end
		end
	end
	self.a, self.r, self.g, self.b, self.packed = keepA, keepR, keepG, keepB, keepP
end

-- 한 장을 시작한다: 지난 장을 지우고 카메라를 받는다
function Ctx:begin(camX: number, camY: number)
	if self.used then
		buffer.fill(self.buf, 0, 0)
		self.used = false
	end
	self.ox, self.oy = camX, camY
	self.r, self.g, self.b, self.a, self.packed = 255, 255, 255, 255, 0xffffffff
	self.label.Position = UDim2.fromOffset(camX, camY)
end

-- 찍은 것을 화면에 올린다(찍은 것도 남은 것도 없으면 아무것도 하지 않는다)
function Ctx:present()
	if self.image and (self.used or self.shown) then
		self.image:WritePixelsBuffer(Vector2.zero, SIZE, self.buf)
	end
	self.shown = self.used
end

local Canvas = {}
Canvas.W, Canvas.H = W, H

local back: any, front: any = nil, nil

-- 맵 틀에 붙인다(장면이 바뀔 때마다 — 그림판은 한 번만 만들어 다시 쓴다). 캐릭터 뒤의 것 · 앞의 것
function Canvas.attach(world: Instance, zBack: number, zFront: number)
	if not back then
		back, front = newCtx("FxBack"), newCtx("FxFront")
	end
	back.label.ZIndex, front.label.ZIndex = zBack, zFront
	back.label.Parent, front.label.Parent = world, world
	return back, front
end

-- 장면을 치울 때: 그림판을 떼어 둔다(없애지 않는다)
function Canvas.detach()
	if back then
		back.label.Parent, front.label.Parent = nil, nil
	end
end

return Canvas

end
MODULES['Client/lune/cast'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 기술의 이펙트를 돌린다 — 공방 시험 탭(dino-workshop/js/lune/luneTab.js)에서 화면에 보이는 쪽만 옮긴 것:
--  "스킬이 쓰는 손잡이 g" · 스킬 진행(구간의 장 번호에 맞춰 일을 터뜨린다) · 날아가는 것 · 늦게 터지는 것 · 화면 효과(흔들림 · 어두워짐 · 번쩍 · 멈칫) · 그리는 차례.
--  사용자 2026-10-08: "시험탭의 이펙트를 게임으로 옮기세요". 직업 묶음(shared/lune/kits)은 시험 탭의 것을 줄마다 옮긴 것이고, 여기서는 그것을 "보이기만" 돌린다:
--    g.hit · g.hitAt = 그 범위에 있는 졸개를 돌려줄 뿐 피해를 주지 않는다(피해 · 숫자는 서버가 정해 보낸다) · g.hurt · g.buff · g.call … = 아무 일도 하지 않는다.
--  그리는 차례(시험 탭의 draw와 같다): [뒤 그림판] 어두워짐 → 뒤의 날아가는 것 → 뒤의 이펙트 → 직업의 drawBack → 졸개에 남은 표시의 뒤쪽 반
--                                    [앞 그림판] 모은 단계 → 앞의 날아가는 것 → 직업의 draw → 앞의 이펙트 → 졸개에 남은 표시의 앞쪽 반 · 표식
--  사람 = actor(나 · 다른 사람). 나: boot.luau가 자리와 상태를 장마다 넣어 준다. 다른 사람: 서버가 알린 기술(Act)을 그 사람의 자리에서 돌린다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local G = require(lune.config.game)
local P = require(lune.sim.physics)
local Fx = require(lune.fx)
local Kitset = require(lune.kitset)
local CHARS = require(lune.data["chars.generated"])
local COMBAT = require(lune.data["combat.generated"])
local FxArt = require(script.Parent.fxart)
local Sprite = require(script.Parent.sprite)

local floor, max, min, abs, random, sin, cos, sqrt = math.floor, math.max, math.min, math.abs, math.random, math.sin, math.cos, math.sqrt
local function R(v: number): number
	return floor(v + 0.5)
end

local Cast = {}
Cast.__index = Cast
Cast.speed = 1 -- 이펙트의 빠르기(확인용 — 느리게 돌려 화면을 찍는다)

-- 직업 색의 이름("mint" · "pink") → 색 한 벌
function Cast.tone(name: string)
	return Fx.TONE[name] or Fx.TONE.mint
end

-- view = 장면(SceneView — fxBack · fxFront · camX · camY · root) · scene = 장면의 자료(벽을 본다) · effects = 잔상을 남기는 것 · mobs = 졸개들(MobsView)
function Cast.new(view, scene, effects, mobs)
	local self = setmetatable({}, Cast)
	self.view, self.scene, self.effects, self.mobView = view, scene, effects, mobs
	self.fx = Fx.new()
	self.timers, self.shots, self.actors = {}, {}, {}
	self.clock = 0
	self.shakeA, self.shakeT, self.stopT, self.invertT, self.dimA, self.dimT, self.dimLife = 0, 0, 0, 0, 0, 0, 1
	self.sx, self.sy = 0, 0 -- 이번 장의 흔들림(장면이 맵 틀을 이만큼 민다)
	self.own = nil -- 나
	self.sprites, self.spriteN = {}, 0 -- 몸의 실루엣을 덧그리는 그림들(장마다 쓴 만큼만 보인다)
	-- 화면 반전(시험 탭은 한두 장 색을 뒤집는다 — 게임은 뒤집지 못해 흰빛으로 번쩍인다)
	local flash = Instance.new("Frame")
	flash.Name = "Flash"
	flash.BackgroundColor3 = Color3.new(1, 1, 1)
	flash.BackgroundTransparency = 0.45
	flash.BorderSizePixel = 0
	flash.Size = UDim2.fromScale(1, 1)
	flash.ZIndex = 90
	flash.Visible = false
	flash.Parent = view.root
	self.flash = flash
	return self
end

-- ---------- 졸개 ----------
local function aliveMob(m): boolean
	return m.state ~= "dead" and m.state ~= "gone" and m.state ~= "spawn"
end

-- 직업 묶음이 읽는 값을 졸개에 얹는다(시험 탭의 졸개와 같은 이름): y 발밑 · h 뜬 높이(게임에는 없다 — 0) · boss · dead(쓰러졌으면 0 이상) · 표시들
function Cast:syncMobs(dt: number)
	for _, m in self.mobView.mobs do
		m.id = m.info.id
		m.y = m.info.y
		m.h = m.alt or 0 -- 나는 몬스터는 떠 있는 높이(mobsView가 셈한다)
		m.boss = m.def.boss == true
		m.dead = if aliveMob(m) then -1 else 0
		m.max = m.info.maxHp
		m.mark = m.mark or 0
		m.markT = m.markT or 0
		m.bind = max(0, (m.bind or 0) - dt)
		m.bindImm = max(0, (m.bindImm or 0) - dt)
		m.stun = max(0, (m.stun or 0) - dt)
		m.rend = max(0, (m.rend or 0) - dt)
		m.cracks = m.cracks or 0
		if m.mark > 0 then
			m.markT -= dt
			if m.markT <= 0 or m.dead >= 0 then
				m.mark = 0
			end
		end
		if m.dead >= 0 then
			m.cracks, m.bind, m.rend, m.stun = 0, 0, 0, 0
		end
	end
end

function Cast:alive()
	local out = {}
	for _, m in self.mobView.mobs do
		if aliveMob(m) then
			out[#out + 1] = m
		end
	end
	return out
end

-- 그 네모 안의 졸개들(시험 탭의 hitBox와 같은 몸 크기). 피해는 주지 않는다
function Cast:box(xa: number, xb: number, ya: number, yb: number)
	local out = {}
	for _, m in self.mobView.mobs do
		if aliveMob(m) then
			local hh, hw = if m.boss then 26 else 12, if m.boss then 12 else 7
			local y = m.info.y
			if m.def.body then -- 새 몬스터: 종류마다의 몸(서버의 room.luau bodyOf와 같다)
				hw, hh = m.def.body[1] / 2 + 1, m.def.body[2]
				y -= (m.def.lift or 0) + (m.alt or 0)
			end
			if m.x + hw > xa and m.x - hw < xb and y > ya and y - hh < yb then
				out[#out + 1] = m
			end
		end
	end
	return out
end

-- ---------- 사람 ----------
local function makeG(self, a)
	-- art = Aseprite로 그린 그림(점 자료) · authority = 판정을 정하는 쪽인가(화면은 아니다 — 서버가 정한 값을 받아 그린다)
	local g = { fx = self.fx, rnd = random, s = {}, PW = self.view.width, art = FxArt, authority = false }
	local GET = {
		x = function()
			return a.x
		end,
		y = function()
			return a.y
		end,
		dir = function()
			return a.dir
		end,
		tone = function()
			return a.tone
		end,
		ground = function()
			return a.ground
		end,
		big = function()
			return if a.scale > 1 then 1.5 else 1
		end,
		lv = function()
			return if a.skill then a.skill.lv else 0
		end,
		held = function()
			return if a.skill then a.skill.t else 0
		end,
		clock = function()
			return self.clock
		end,
		toggle = function()
			return a.toggle
		end,
		hero = function()
			return a
		end,
		pose = function()
			return a.pose
		end,
		cam = function()
			return { x = self.view.camX, y = self.view.camY }
		end,
	}
	setmetatable(g, {
		__index = function(_, key)
			local get = GET[key]
			return if get then get() else nil
		end,
	})
	function g.fwd(d: number): number
		return a.x + a.dir * d
	end
	function g.hit(from: number, to: number, up: number, down: number, _dmg: number, o)
		local k = if a.scale > 1 then 1.5 else 1
		local x0, x1 = a.x + a.dir * from * k, a.x + a.dir * to * k
		local out = self:box(min(x0, x1), max(x0, x1), a.y - up * k, a.y + down)
		if #out > 0 and o and o.stop and a.own then
			self.stopT = max(self.stopT, o.stop) -- 멈칫: 내 타가 닿은 순간 잠깐 선다
		end
		return out
	end
	function g.hitAt(x: number, y: number, hw: number, h: number, _dmg: number, o)
		local out = self:box(x - hw, x + hw, y - h, y + 6)
		if #out > 0 and o and o.stop and a.own then
			self.stopT = max(self.stopT, o.stop)
		end
		return out
	end
	function g.hurt(_m, _dmg, _o)
		return true -- 피해는 서버가 준다
	end
	function g.mobs()
		return self:alive()
	end
	function g.nearest(range: number, o)
		local from, not_, front = (o and o.from) or a.x, o and o["not"], o and o.front
		local best, bd = nil, range
		for _, m in self:alive() do
			if m == not_ or abs(m.y - a.y) > 60 or (front and (m.x - a.x) * a.dir < -8) then
				continue
			end
			local d = abs(m.x - from)
			if d <= bd then
				bd, best = d, m
			end
		end
		return best
	end
	function g.boss()
		local best = nil
		for _, m in self:alive() do
			if abs(m.x - a.x) < 280 and (not best or m.max > best.max) then
				best = m
			end
		end
		return best
	end
	-- 화면 효과는 내가 쓴 기술에만 붙는다(남의 기술이 내 화면을 흔들지 않는다)
	function g.shake(amount: number, t: number)
		if a.own then
			self.shakeA, self.shakeT = max(self.shakeA, amount), max(self.shakeT, t)
		end
	end
	function g.stop(t: number)
		if a.own then
			self.stopT = max(self.stopT, t)
		end
	end
	function g.invert(t: number)
		if a.own then
			self.invertT = t
		end
	end
	function g.dim(amount: number, t: number)
		if a.own then
			self.dimA, self.dimT, self.dimLife = amount, t, t
		end
	end
	function g.after(d: number, fn)
		self.timers[#self.timers + 1] = { t = d, fn = fn }
	end
	function g.shot(o)
		local p = { t = 0, acc = 0, hitSet = {}, dir = a.dir, who = a.who, w = 0, h = 0, dmg = 0, life = 1 }
		for k, v in o do
			p[k] = v
		end
		self.shots[#self.shots + 1] = p
		return p
	end
	-- 몸을 옮기는 것(내 캐릭터만 — 다른 사람의 자리는 서버가 알려 준다). boot.luau가 control을 넣어 준다
	function g.move(v: number, t: number)
		if a.own and self.control then
			self.control.move(v, t)
		end
	end
	function g.hop(v: number)
		if a.own and self.control then
			self.control.hop(v)
		end
	end
	function g.face(d: number)
		a.dir = d
		if a.own and self.control then
			self.control.face(d)
		end
	end
	-- 순간이동: 내 몸은 바로 옮긴다(서버도 같은 스킬을 돌려 그 자리로 옮겨 적는다 — 어긋나면 서버가 Warp로 바로잡는다). 옮긴 자리를 이어지는 이펙트가 바로 읽는다
	function g.teleport(x: number): boolean
		if a.own and self.control then
			local nx = self.control.teleport(x)
			if nx then
				a.x = nx
				return true
			end
			return false
		end
		return true
	end
	-- 버프 · 스킬 레벨 · 졸개의 표시: 서버가 정한 것을 읽기만 한다
	function g.buff(_id, _dur) end
	function g.has(id: string): boolean
		local b = a.buffs[id]
		return b ~= nil and b.t > 0
	end
	function g.left(id: string): number
		local b = a.buffs[id]
		return if b then b.t else 0
	end
	function g.endBuff(_id) end
	function g.resetCd(_key) end
	function g.sk(id: string): number
		return a.skills[id] or 0
	end
	-- 바인드: 화면의 어림(묶는 것은 서버다 — 졸개의 묶인 시간이 Snap으로 와서 이것을 덮는다. mobsView.luau의 apply)
	function g.bind(m, t: number, kind: string?): boolean
		if (m.bindImm or 0) > 0 then
			return false
		end
		m.bind, m.bindKind, m.bindImm, m.bindAt = t, kind, t + 90, os.clock()
		return true
	end
	function g.call(_name, ...) end -- 서버가 정해 알린다(Cast:call로 온다)
	function g.drag(_m, _x) end -- 졸개를 끌어 옮기는 것은 서버가 한다
	function g.heal(_k) end
	function g.revive() end
	function g.chargeMax(): number
		return if a.kit and a.kit.chargeMax then a.kit.chargeMax(g) else 2
	end
	function g.ghost(color)
		local p = a.pose
		if p and self.effects then
			self.effects:ghost(a.who, p.clip, p.f + 1, a.x, a.y, a.dir, Color3.fromRGB(bit32.rshift(color or a.tone.n, 16), bit32.band(bit32.rshift(color or a.tone.n, 8), 255), bit32.band(color or a.tone.n, 255)))
		end
	end
	-- 몸의 한 색 실루엣을 덧그린다(분신 · 굳은 몸의 윤곽 · 사신의 그림자 · 망령): 그 동작의 f째 장(0부터)을 (x, y)에. o = { color, alpha } — 그리는 동안(draw)에만 부른다.
	--  캐릭터들의 층 맨 뒤에 놓인다(몸 뒤). o.scale = 크기(거신)
	function g.sprite(clip: string, f: number, x: number, y: number, dir: number, o)
		self.spriteN += 1
		local sp = self.sprites[self.spriteN]
		if not sp or sp.who ~= a.who then
			if sp then
				sp:destroy()
			end
			sp = Sprite.new(self.view.heroLayer, a.who, 0, true)
			sp.label.Name = "Shade"
			self.sprites[self.spriteN] = sp
		end
		local c = (o and o.color) or a.tone.n
		sp.label.ImageColor3 = Color3.fromRGB(bit32.rshift(c, 16), bit32.band(bit32.rshift(c, 8), 255), bit32.band(c, 255))
		sp.label.ImageTransparency = 1 - ((o and o.alpha) or 1)
		sp:set(clip, f + 1, x, y, dir, o and o.scale)
	end
	return g
end

-- 사람을 올린다(이미 있으면 그대로). own = 나
function Cast:actor(id: any, who: string, own: boolean?)
	local a = self.actors[id]
	if a and a.who == who then
		return a
	end
	local kit = Kitset.of(who)
	a = { id = id, who = who, kit = kit, tone = Fx.TONE[(kit and kit.tone) or "mint"], x = 0, y = 0, dir = 1, ground = true, vx = 0, vy = 0, scale = 1, alpha = 1, sil = nil, skill = nil, buffs = {}, toggle = false, own = own == true, skills = {}, pose = nil, charge = 0 }
	a.g = makeG(self, a)
	if kit and kit.init then
		kit.init(a.g)
	end
	self.actors[id] = a
	if own then
		self.own = a
	end
	return a
end

function Cast:drop(id: any)
	local a = self.actors[id]
	if a and a.shades then
		for _, sp in a.shades do
			sp:destroy()
		end
	end
	self.actors[id] = nil
end

-- 그 사람의 몸을 그린다 — 버프가 입히는 모습까지(시험 탭이 몸을 그리는 그 줄들):
--   크기(거신의 두 배) · 비치는 몸(그림자 숨기 · 연막 · 저승 걸음) · 한 색 실루엣(sil) · 윤곽을 따라 도는 빛(직업 묶음의 heroGlow — 네 쪽으로 한 점씩 민 실루엣) · 몸에 얹는 색(heroTint)
--  body = 그 사람의 몸 그림(Sprite) · (clip, frame) = 지금의 동작과 장(1부터) · fade = 그 밖의 비침(맞은 직후의 깜빡임 — 0이면 또렷하다)
local GLOW = { { -1, 0 }, { 1, 0 }, { 0, -1 }, { 0, 1 } }
local function rgb(c: number): Color3
	return Color3.fromRGB(bit32.rshift(c, 16), bit32.band(bit32.rshift(c, 8), 255), bit32.band(c, 255))
end
function Cast:look(a, body, clip: string, frame: number, x: number, y: number, dir: number, fade: number?)
	local sc = a.scale or 1
	local alpha = max(fade or 0, 1 - (a.alpha or 1))
	body:set(clip, frame, x, y, dir, sc)
	body.label.ImageTransparency = alpha
	local kit, g = a.kit, a.g
	local glow = if kit and kit.heroGlow then kit.heroGlow(g) else nil
	local tint = if kit and kit.heroTint then kit.heroTint(g) else nil
	local sil = a.sil
	local sh = a.shades
	if not sh then
		if not (glow or tint or sil) then
			return
		end
		-- 덧그리는 실루엣들: 윤곽 빛 넷(몸 뒤) · 실루엣 하나(몸의 자리) · 얹는 색 하나(몸 앞)
		sh = {}
		local z = body.label.ZIndex
		for i = 1, 6 do
			sh[i] = Sprite.new(self.view.heroLayer, a.who, if i <= 4 then max(0, z - 1) elseif i == 5 then z else z + 1, true)
			sh[i].label.Name = "Look"
		end
		a.shades = sh
	end
	for i = 1, 4 do
		if glow then
			sh[i]:set(clip, frame, x + GLOW[i][1], y + GLOW[i][2], dir, sc)
			sh[i].label.ImageColor3 = rgb(glow)
		else
			sh[i].label.Visible = false
		end
	end
	if sil then
		sh[5]:set(clip, frame, x, y, dir, sc)
		sh[5].label.ImageColor3 = rgb(sil)
		sh[5].label.ImageTransparency = alpha
		body.label.Visible = false
	else
		sh[5].label.Visible = false
	end
	if tint then
		sh[6]:set(clip, frame, x, y, dir, sc)
		sh[6].label.ImageColor3 = rgb(tint[1])
		sh[6].label.ImageTransparency = 1 - tint[2]
	else
		sh[6].label.Visible = false
	end
end

-- 그 기술의 그 구간이 시작됐다. lv = 모은 단계
function Cast:start(a, id: string, seg: number, lv: number?)
	local def = a.kit and a.kit.byId[id]
	local s = def and def.segs and def.segs[seg]
	if not s then
		a.skill = nil
		return
	end
	-- 앞 구간에서 이어지는 것이면 그 구간을 닫는다: 다 틀고 넘어가는 구간은 아직 안 터진 장의 이펙트를 마저 내고, 끝날 때의 일을 부른다(몰아치기의 휘두른 시간 …)
	local prev = a.skill
	if prev and prev.def == def and prev.i == seg - 1 then
		local ps = prev.s
		if not (ps.hold or ps.charge or ps.till) then
			for _, e in ps.evs do
				if not prev.fired[e[1]] then
					prev.fired[e[1]] = true
					e[2](a.g)
				end
			end
		end
		if ps.finish then
			ps.finish(a.g)
		end
	end
	local clip = CHARS.chars[a.who].clips[s.clip]
	a.skill = { def = def, i = seg, s = s, t = 0, lv = lv or 0, fired = {}, acc = 0, last = s.to or (if clip then #clip.frames - 1 else 0) }
	if s.start then
		s.start(a.g)
	end
end

-- 바로 걸리는 것(버프 · 생존기 · 극딜 — 쓰는 동작이 없다): 걸리는 순간의 이펙트
function Cast:instant(a, id: string)
	local def = a.kit and a.kit.byId[id]
	if def and def.cast then
		def.cast(a.g)
	end
end

-- 그 사람에게 걸린 버프(서버가 알려 준 것)를 받아 적는다. list = { { id, t, dur, x, y } … }
function Cast:setBuffs(a, list)
	local old = a.buffs
	a.buffs = {}
	for _, b in list do
		a.buffs[b.id] = { t = b.t, dur = b.dur, x = b.x, y = b.y }
	end
	-- 사라진 것: 끝났을 때의 이펙트(굳었던 빛이 깨져 흩어진다 · 돔이 깨진다)
	for id in old do
		if not a.buffs[id] and a.kit and a.kit.onBuffEnd then
			a.kit.onBuffEnd(a.g, id)
		end
	end
end

-- 힘이 한 단계 모였다(시험 탭: 단계가 오를 때마다 고리가 오므라든다)
function Cast:chargeUp(a, lv: number)
	a.charge = lv
	self.fx.ring(a.x, a.y - 8, 26 + lv * 8, 4, a.tone, { squash = 1, back = false, life = 0.25 })
	self.fx.shards(a.x, a.y - 8, 4 + lv * 2, a.tone, { speed = 40, up = 60, kind = "dot", grav = -60, life = 0.4 })
end

-- 레벨이 올랐다(2026-10-18 — 메이플스토리처럼 캐릭터 둘레로 빛이 솟는다. 전에는 머리 위의 글씨와 소리뿐이었다): 큰 기운 · 발밑의 넓은 고리 · 위로 흩어지는 점(직업 색)
--  시험 탭 js/lune/luneTab.js의 gainXp가 같은 값으로 그린다
function Cast:levelUp(a)
	self.fx.aura(a.x, a.y, a.tone, { r = 18, h = 46, life = 0.9 })
	self.fx.ring(a.x, a.y - 2, 4, 34, a.tone, { squash = 0.35, back = true, life = 0.7 })
	self.fx.shards(a.x, a.y - 10, 14, a.tone, { speed = 30, up = 90, kind = "dot", grav = -80, life = 0.9 })
end

-- 사냥터 정예가 나왔다(2026-10-18 — 시험 탭의 spawnElite와 같다): 그 자리에서 분홍 기운이 솟고 고리가 퍼지며 불티가 오른다
function Cast:eliteRise(x: number, y: number)
	local tone = Cast.tone("pink")
	self.fx.aura(x, y, tone, { r = 16, h = 40, life = 1.1 })
	self.fx.ring(x, y - 2, 4, 30, tone, { squash = 0.35, back = true, life = 0.8 })
	self.fx.shards(x, y - 8, 12, tone, { speed = 26, up = 80, kind = "dot", grav = -60, life = 1 })
end

-- 사출기를 켰다(시험 탭: 켜는 순간 작은 기운)
function Cast:toggled(a)
	self.fx.aura(a.x, a.y, a.tone, { r = 10, h = 16, life = 0.35 })
end

-- 졸개가 맞았다(시험 탭의 hurt): 파편이 튄다. 쓰러졌으면 세모 파편이 터진다. by = 때린 사람의 직업 색
--  dir = 때린 쪽의 반대(몬스터가 밀리는 쪽 — 1 · -1): 불꽃은 때린 쪽으로 조금 치우친 자리에서 퍼지고, 파편은 반대쪽으로 튄다(공방 combat.js의 hit)
function Cast:hurt(m, tone, big: boolean?, dead: boolean?, dir: number?)
	local y = m.info.y
	local H = COMBAT.rules.hit
	self.fx.pop(m.x - (dir or 0) * 3, y - 8, tone, { r = if big then H.sparkBig else H.spark, life = 0.14 })
	self.fx.shards(m.x, y - 7, if big then H.shardsBig else H.shards, tone, { speed = 70, up = 40, kind = "mix", life = 0.4, dir = dir or 0, spread = 1.2 })
	if dead then
		self.fx.shards(m.x, y - 6, 8, tone, { kind = "tri" })
	end
end

-- 서버가 알린 따로 나가는 타(지금의 1차 — 메아리 도끼 · 표창 · 도깨비불 …). 그 직업 묶음에 이펙트가 있으면 돌리고 true(land = 닿은 순간에 부를 것)
--  e = 그 타의 기록(i 몇째 것 · n 한 번에 나간 수 · hop 튕긴 것 · up 그 사람이 배운 사출기 강화 — 1 하나 더 · 2 셋째 갈래 · 4 넷째 갈래)
function Cast:proc(a, kind: string, m, sx: number, sy: number, land: () -> (), e): boolean
	local fn = a and a.kit and a.kit.procs and a.kit.procs[kind]
	if not fn then
		return false
	end
	-- 남의 것: 그 사람이 배운 강화를 받아 적어 그 모습(큰 도끼 · 불새 …)으로 그린다(내 것은 내 스킬 레벨을 그대로 읽는다)
	local ups = COMBAT.kitUp[a.who]
	if e and e.up and not a.own and ups then
		for role, def in ups do
			local bit = if role == "two" then 1 elseif role == "fast" then 4 else 2
			a.skills[def.id] = if bit32.band(e.up, bit) ~= 0 then 1 else 0
		end
	end
	fn(a.g, m, { sx = sx, sy = sy, land = land, i = e and e.i, n = e and e.n, hop = e and e.hop })
	return true
end

function Cast:update(dt: number)
	dt *= Cast.speed
	self.shakeT = max(0, self.shakeT - dt)
	if self.shakeT == 0 then
		self.shakeA = 0
	end
	self.invertT = max(0, self.invertT - dt)
	self.dimT = max(0, self.dimT - dt)
	local sh = if self.shakeT > 0 then self.shakeA else 0
	self.sx, self.sy = R((random() * 2 - 1) * sh), R((random() * 2 - 1) * sh * 0.6)
	self:syncMobs(dt)
	if self.stopT > 0 then
		self.stopT -= dt -- 멈칫: 맞는 순간 이펙트가 잠깐 선다
		return
	end
	self.clock += dt
	local timers = self.timers
	for i = #timers, 1, -1 do
		local t = timers[i]
		t.t -= dt
		if t.t <= 0 then
			table.remove(timers, i)
			t.fn()
		end
	end
	for _, a in self.actors do
		local g = a.g
		for _, b in a.buffs do
			b.t = max(0.01, b.t - dt) -- 끝나는 것은 서버가 알린다(그때까지는 걸려 있는 모습이다)
		end
		if a.kit and a.kit.tick then
			a.kit.tick(g, dt)
		end
		-- 스킬 진행: 구간의 장 번호에 맞춰 일을 터뜨린다
		local sk = a.skill
		if sk then
			local s = sk.s
			local haste = if s.charge then 1 else (a.haste or 1) -- 공격 속도 버프: 동작 · 타격 시점 · 되풀이 타격 간격이 빨라진다(힘 모으기 구간은 그대로)
			sk.t += dt * haste
			local f = (s.from or 0) + floor(sk.t * (s.fps or 14))
			for _, e in s.evs do
				if f >= e[1] and not sk.fired[e[1]] then
					sk.fired[e[1]] = true
					e[2](g)
				end
			end
			if s.every then
				sk.acc += dt * haste
				while sk.acc >= s.every[1] do
					sk.acc -= s.every[1]
					s.every[2](g)
				end
			end
			-- 끝: 보통 구간은 마지막 장을 넘기면. 누르고 있는 구간 · 모으는 구간 · 조건을 기다리는 구간은 다음 구간이 시작되면 바뀐다(안 오면 max에서 끝난다)
			local done
			if s.loop then
				done = sk.t >= s.dur
			elseif s.hold or s.charge or s.till then
				done = sk.t >= (s.max or 3)
			else
				done = f > sk.last
			end
			if done then
				if s.finish then
					s.finish(g)
				end
				if a.skill == sk then
					a.skill = nil
				end
			end
		end
	end
	-- 날아가는 것 · 놓인 것 · 따라다니는 것
	local shots = self.shots
	for i = #shots, 1, -1 do
		local p = shots[i]
		p.t += dt
		local gone = false
		if p.target then -- 쫓아가는 것: 닿으면 onReach
			local tm = p.target
			local tx, ty = tm.x, tm.y - tm.h - (if tm.boss then 14 else 7)
			local d = sqrt((tx - p.x) ^ 2 + (ty - p.y) ^ 2)
			if tm.dead >= 0 then
				table.remove(shots, i)
				continue
			end
			if d < 6 then
				if p.onReach then
					p.onReach(p)
				end
				table.remove(shots, i)
				continue
			end
			local sp = (p.speed or 200) * dt
			p.x += ((tx - p.x) / d) * sp
			p.y += ((ty - p.y) / d) * sp + (p.curl or 0) * sin(p.t * 12) * dt
		else
			if p.g then
				p.vy = (p.vy or 0) + p.g * dt
			end
			p.x += (p.vx or 0) * dt
			p.y += (p.vy or 0) * dt
		end
		if p.update then
			p.update(p, dt)
		end
		if p.every then
			p.acc += dt
			while p.acc >= p.every[1] do
				p.acc -= p.every[1]
				p.every[2](p)
			end
		end
		if p.dmg ~= 0 then
			for _, m in self.mobView.mobs do
				local hh = if m.boss then 26 else 12
				if m.dead >= 0 or abs(m.x - p.x) > p.w / 2 + 7 or m.y - m.h < p.y - p.h / 2 - 2 or m.y - m.h - hh > p.y + p.h / 2 then
					continue
				end
				local was = p.hitSet[m]
				if was ~= nil and not (p.tick and p.t - was >= p.tick) then
					continue
				end
				p.hitSet[m] = p.t
				if p.onHit then
					p.onHit(p, m)
				end
			end
		end
		local wall = ((p.vx or 0) ~= 0 or (p.vy or 0) ~= 0) and not p.ghost and P.cell(self.scene, floor(p.x / G.TILE), floor(p.y / G.TILE)) == "#"
		if p.dead or p.t >= p.life or wall or gone then
			if p.finish then
				p.finish(p, wall)
			end
			table.remove(shots, i)
		end
	end
	self.fx.update(dt)
end

local STACK_MARK = Fx.TONE.mint.n

function Cast:draw()
	local view = self.view
	local back, front = view.fxBack, view.fxFront
	local cx, cy = view.camX, view.camY
	back:begin(cx, cy)
	front:begin(cx, cy)
	self.spriteN = 0
	self.flash.Visible = self.invertT > 0
	local own = self.own
	-- 큰 기술 · 극딜: 배경을 어둡게 눌러 네온이 도드라지게
	local dim = if self.dimT > 0 then self.dimA * min(1, self.dimT / (self.dimLife * 0.25), (self.dimLife - self.dimT) / 0.12) else 0
	if own and own.kit and own.kit.dim then
		dim = max(dim, own.kit.dim(own.g) or 0)
	end
	if dim > 0 then
		back:alpha(dim)
		back:style(0x12161c)
		back:rect(cx - 8, cy - 8, G.VIEW_W + 16, G.VIEW_H + 16)
		back:alpha(1)
	end
	for _, p in self.shots do
		if p.back and p.draw then
			p.draw(back, p)
		end
	end
	self.fx.draw(back, true)
	for _, a in self.actors do
		if a.kit and a.kit.drawBack then
			a.kit.drawBack(back, a.g)
		end
	end
	local kit = own and own.kit
	if kit then
		for _, m in self.mobView.mobs do
			if m.dead and m.dead < 0 then
				local sc = if m.boss then 2 else 1
				if kit.drawMarks then
					kit.drawMarks(back, own.g, m, sc, false)
				end
				if m.bind > 0 and kit.drawBind then
					kit.drawBind(back, own.g, m, sc, false) -- 바인드: 휘감는 기운의 뒤쪽 반
				end
			end
		end
	end
	-- 모은 단계(머리 위의 점)
	for _, a in self.actors do
		if a.charge > 0 then
			front:style(a.tone.l)
			for i = 0, a.charge - 1 do
				front:rect(R(a.x) - a.charge * 2 + i * 4, R(a.y) - 28 * a.scale, 2, 2)
			end
		end
	end
	for _, p in self.shots do
		if not p.back and p.draw then
			p.draw(front, p)
		end
	end
	for _, a in self.actors do
		if a.kit and a.kit.draw then
			a.kit.draw(front, a.g)
		end
	end
	self.fx.draw(front, false)
	for _, m in self.mobView.mobs do
		if not (m.dead and m.dead < 0) then
			continue
		end
		local sc = if m.boss then 2 else 1
		local top, mx = R(m.y - m.h) - 13 * sc, R(m.x)
		if kit then
			if kit.drawMarks then
				kit.drawMarks(front, own.g, m, sc, true)
			end
			if m.bind > 0 and kit.drawBind then
				kit.drawBind(front, own.g, m, sc, true) -- 앞쪽 반
			end
		end
		if m.stun > 0 then
			front:style(0xeef6f6)
			for i = 0, 2 do
				local a = self.clock * 6 + i * 2.1
				front:rect(R(mx + cos(a) * 6), R(top - 3 + sin(a) * 2), 1, 1)
			end
		end
		for i = 0, m.mark - 1 do -- 표식
			local bx, by = mx - (m.mark - 1) * 3 + i * 6, R(top - 9 + sin(self.clock * 6 + i) * 1.5)
			front:style(STACK_MARK)
			front:rect(bx - 1, by, 3, 1)
			front:rect(bx, by - 1, 1, 3)
		end
	end
	for i = self.spriteN + 1, #self.sprites do
		self.sprites[i].label.Visible = false
	end
	back:present()
	front:present()
end

return Cast

end
MODULES['Client/lune/chat'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 채팅 — Roblox의 기본 채팅(TextChatService의 채팅 창 · 입력줄 · 채널 탭)을 그대로 쓴다. 우리가 그리는 채팅 화면은 없다.
--  사용자 2026-10-13: "우리가 자체 채팅을 구현하는게 아니라 로블록스 채팅이 있어요 로블록스 공식문서좀 확인해보고 ,  그걸 어떻게 로블록스 채팅을 우리게임에 자연스럽게 사용하게 연결할수있는지
--                     불가능하다면 그냥 채팅 없어도됩니다."
--  전에는 글만 Roblox의 채팅으로 보내고(TextChannel:SendAsync) 창과 쓰는 칸은 우리 것이었다(기본 창 · 입력줄은 꺼 두었다). 이제 창 · 입력줄 · 폰의 채팅 단추까지 Roblox의 것이다:
--    글 거르기 · 신고 · 한글 입력 · 폰의 글자판 · 채팅 제한(나이 확인 등)이 걸린 사람에게 뜨는 안내를 Roblox가 맡는다 — 우리가 따라 만들 것이 없다.
--  공식 문서(create.roblox.com/docs/chat/in-experience-text-chat · chat-window · reference의 ChatWindowConfiguration · ChatInputBarConfiguration · ChannelTabsConfiguration)에서 확인한 것:
--    · 기본 화면은 셋: 채팅 창(ChatWindowConfiguration) · 입력줄(ChatInputBarConfiguration) · 채널 탭(ChannelTabsConfiguration — 기본은 꺼져 있다). Enabled를 끄면 그 부분이 숨는다.
--    · 창의 자리는 HorizontalAlignment(기본 Left) · VerticalAlignment(기본 Top), 크기는 WidthScale · HeightScale, 모습은 BackgroundColor3 · BackgroundTransparency · TextColor3 · TextSize · FontFace.
--    · 입력줄은 그것을 누르거나 KeyboardKeyCode(기본 Slash — 「/」)로 연다. 폰에서는 화면 위의 Roblox 채팅 단추로 창을 여닫는다.
--    · 채널 탭을 켜면 RBXGeneral이 「General」 탭이 되고, 따로 만든 TextChannel은 그 Name으로 탭이 생긴다 — 우리의 「파티」 채널.
--    · 글의 앞머리(이름)는 TextChatService.OnIncomingMessage에서 TextChatMessageProperties.PrefixText로 바꾼다(글자색 꼬리표를 쓸 수 있다).
--    · 알림 글은 TextChannel:DisplaySystemMessage(그 사람의 화면에만 뜬다).
--    · 창 · 입력줄의 화면에서의 자리는 AbsolutePosition · AbsoluteSize로 읽는다(문서의 본보기 「Get Total Chat UI Bounds」) · 글을 치는 중인지는 ChatInputBarConfiguration.IsFocused.
--  누구에게 가는지는 그대로 서버가 정한다(server/lune/modules/chat.luau): 둘레(RBXGeneral) = 같은 맵의 사람 · 「파티」 = 같은 파티.
--  여기서 하는 일: ① 기본 창 · 입력줄 · 채널 탭을 켜고 게임의 색에 맞춘다(data/ui.generated.luau의 chatUi) ② 이름을 그 사람의 캐릭터 이름으로(Roblox의 이름을 쓰지 않는다 — 사용자 2026-10-10)
--                 ③ 글을 치는 동안 게임의 키를 받지 않게 알려 준다(Chat.focused) ④ 창이 차지한 자리의 아래 끝을 알려 준다(Chat.bottom — PC에서 파티원 칸을 그 아래로 내린다)
--  Roblox 캐릭터가 없는 게임이라(2D 화면) 머리 위 말풍선은 뜨지 않는다.
--  확인하지 못한 것: 실제 화면에서의 모습(Play를 하지 않았다). 속성은 모두 문서에 있는 것이고, 하나가 안 먹어도 나머지와 게임은 그대로 돈다(pcall).
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UI = require(ReplicatedStorage.shared.lune.data["ui.generated"])
local Stage = require(script.Parent.stage)

local K = UI.chatUi -- 공방 js/lune/design/ui.js의 CHATUI

local Chat = {}
Chat.bottom = 0 -- Roblox 채팅 화면(창 + 입력줄)의 아래 끝 — 화면 틀의 점(위에서부터). 아직 모르면 0
Chat.onMoved = nil :: (() -> ())? -- 그 자리가 바뀌었을 때(boot가 파티원 칸을 다시 놓는다)

local window: Instance? = nil
local bar: Instance? = nil

local function config(class: string): Instance?
	local found = TextChatService:FindFirstChildOfClass(class)
	if found then
		return found
	end
	-- 설정들은 TextChatService 바로 아래나 그 아래의 묶음에 있다
	for _, d in TextChatService:GetDescendants() do
		if d.ClassName == class then
			return d
		end
	end
	return nil
end

local function color(hex: string): Color3
	return Color3.fromHex(hex)
end

-- 속성 하나를 건다(그 속성이 없거나 막혀 있어도 나머지는 그대로 건다).
--  값이 없으면(자료에 그 값이 없다) 걸지 않는다 — 2026-10-13: 자료에서 뺀 값(stroke)을 걸려던 줄이 남아, nil을 수 속성에 넣다가
--  Studio의 Output에 "value of type nil cannot be converted to a number"가 떴다(pcall 안이라 게임은 그대로 돌았다). 걸어야 하는 값이 다 걸리는지는 테스트 40이 본다
local function set(target: Instance?, key: string, value: any)
	if value == nil then
		warn("[lune] 채팅: 걸 값이 자료(ui.generated의 chatUi)에 없다 — " .. key)
		return
	end
	if target then
		pcall(function()
			(target :: any)[key] = value
		end)
	end
end

-- 글에 넣는 이름: 글자 꾸밈 꼬리표로 읽히지 않게
local function plain(text: string): string
	return (text:gsub("[&<>\"']", { ["&"] = "&amp;", ["<"] = "&lt;", [">"] = "&gt;", ['"'] = "&quot;", ["'"] = "&apos;" }))
end
Chat.plain = plain

-- 그 글의 앞머리: 「[파티] 이름:」 — 이름은 그 사람이 하고 있는 캐릭터의 이름(서버가 사람에게 적어 둔 LuneName). 아직 캐릭터를 고르지 않은 사람이면 nil(Roblox의 기본 앞머리 그대로)
function Chat.prefix(charName: any, party: boolean): string?
	if typeof(charName) ~= "string" or charName == "" then
		return nil
	end
	local head = if party then ("<font color='%s'>%s</font> "):format(K.party.color, plain(K.party.tag)) else ""
	return ("%s<font color='%s'>%s:</font>"):format(head, if party then K.party.color else K.nameColor, plain(charName))
end

-- 입력줄에 글을 치는 중인가(그동안 게임의 키를 받지 않는다 — input.luau)
function Chat.focused(): boolean
	local ok, on = pcall(function()
		return bar ~= nil and (bar :: any).IsFocused == true
	end)
	return ok and on == true
end

-- 알림 글(내 화면에만 뜬다)
function Chat.note(text: string)
	task.spawn(function()
		pcall(function()
			local channels = TextChatService:WaitForChild("TextChannels", 5)
			local channel = channels and (channels:FindFirstChild("RBXSystem") or channels:FindFirstChild("RBXGeneral"))
			if channel then
				(channel :: any):DisplaySystemMessage(text)
			end
		end)
	end)
end

-- 채팅 화면이 차지한 자리의 아래 끝을 다시 잰다(창과 입력줄을 합친 네모 — 문서의 본보기와 같은 법). 화면 틀의 점으로
local function measure()
	local ok, y = pcall(function()
		local low = 0
		for _, c in { window, bar } do
			if c and (c :: any).Enabled then
				local pos, size = (c :: any).AbsolutePosition, (c :: any).AbsoluteSize
				if size.Y > 0 then
					low = math.max(low, pos.Y + size.Y)
				end
			end
		end
		if low <= 0 or not Stage.ui then
			return 0
		end
		return math.max(0, math.ceil((low - Stage.ui.AbsolutePosition.Y) / Stage.uiScale))
	end)
	local now = if ok then y else 0
	if now ~= Chat.bottom then
		Chat.bottom = now
		if Chat.onMoved then
			Chat.onMoved()
		end
	end
end
Chat.measure = measure

function Chat.init()
	window = config("ChatWindowConfiguration")
	bar = config("ChatInputBarConfiguration")
	local tabs = config("ChannelTabsConfiguration")

	-- ① 기본 화면을 켜고 게임의 색에 맞춘다
	local W = K.window
	set(window, "Enabled", true)
	set(window, "BackgroundColor3", color(W.back))
	set(window, "BackgroundTransparency", W.alpha)
	set(window, "TextColor3", color(W.text))
	set(window, "WidthScale", W.width)
	set(window, "HeightScale", W.height)
	set(bar, "Enabled", true)
	set(bar, "BackgroundColor3", color(W.back))
	set(bar, "BackgroundTransparency", W.alpha)
	set(bar, "TextColor3", color(W.text))
	set(bar, "PlaceholderColor3", color(W.dim))
	-- 채널 탭: 「General」(둘레 — 같은 맵) · 「파티」
	set(tabs, "Enabled", K.tabs)
	set(tabs, "BackgroundColor3", color(W.back))
	set(tabs, "BackgroundTransparency", W.alpha)
	set(tabs, "TextColor3", color(W.dim))
	set(tabs, "SelectedTabTextColor3", color(K.nameColor))

	-- ② 이름은 캐릭터의 이름으로(이 함수는 기다리지 않는다 — 문서: 콜백은 멈추지 않아야 한다)
	pcall(function()
		TextChatService.OnIncomingMessage = function(message: TextChatMessage)
			local props = Instance.new("TextChatMessageProperties")
			local source = message.TextSource
			if source then
				local player = Players:GetPlayerByUserId(source.UserId)
				local channel = message.TextChannel
				local prefix = Chat.prefix(if player then player:GetAttribute("LuneName") else nil, channel ~= nil and channel.Name == K.party.channel)
				if prefix then
					props.PrefixText = prefix
				end
			end
			return props
		end
	end)

	-- ④ 창이 차지한 자리(바뀔 때마다 다시 잰다 — 창 크기 · 창을 여닫을 때)
	for _, c in { window, bar } do
		if c then
			pcall(function()
				c:GetPropertyChangedSignal("AbsoluteSize"):Connect(measure)
				c:GetPropertyChangedSignal("AbsolutePosition"):Connect(measure)
				c:GetPropertyChangedSignal("Enabled"):Connect(measure)
			end)
		end
	end
	Stage.onResize(measure)
	task.delay(2, measure) -- 채팅 화면이 뜬 뒤(문서의 본보기도 잠깐 기다렸다가 잰다)
	measure()
end

return Chat

end
MODULES['Client/lune/chooser'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- ※ 2026-10-10부터 쓰지 않는다 — 처음 화면은 title.luau다. 이 파일은 화면을 RunService.RenderStepped 이벤트에서 고쳐서, 캐릭터의 그림과 틀의 크기가 한 장 어긋나 그려지는 잘못이 있다(title.luau의 「돌리기」에 적은 것). 다시 쓰려면 BindToRenderStep으로 바꿀 것.
-- 직업 고르기 — 처음 온 사람에게 한 번 나온다. 달 아래 다섯 영웅이 나란히 서 있고, 하나를 고르면 그 영웅의 달 · 무기 · 싸우는 법이 뜬다.
--  ← → 로 고르고 Space(또는 Enter)로 정한다. 눌러서(터치) 고를 수도 있다 — 고른 영웅을 한 번 더 누르면 정해진다.
--  자료는 shared/lune/data/classes.generated.luau(공방의 전직 설계와 줄거리에서 내보낸 것). 글씨는 제 칸을 넘지 않게 폭을 준다.
--  하늘 · 영웅들은 게임 세계의 층에, 글(제목 · 이름 · 설명 판)은 화면 틀의 층(고운 격자)에 그린다 — 늘 보이는 화면과 같은 방식.
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local lune = ReplicatedStorage.shared.lune
local G = require(lune.config.game)
local CLASSES = require(lune.data["classes.generated"])
local COMBAT = require(lune.data["combat.generated"])
local SCENES = require(lune.data["scenes.generated"])
local ASSETS = require(lune.data["assets.generated"])
local Stage = require(script.Parent.stage)
local Sprite = require(script.Parent.sprite)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR
local INK = Color3.fromRGB(18, 22, 28)
local WHITE, GRAY, MINT, PINK = C.text, C.dim, C.accent, C.pink

local GROUND_Y = 124 -- 영웅들이 서는 높이(게임의 도트)
local GAP = 70 -- 영웅 사이의 간격(게임의 도트 — 이름이 겹치지 않을 만큼)
local PANEL = { w = 520, h = 86, up = 44 } -- 설명 판(화면 틀의 점): 아래 가운데에, 화면 아래에서 up만큼 위

local Chooser = {}

-- 직업을 고를 때까지 기다렸다가 고른 직업의 이름을 돌려준다
function Chooser.run(): string
	local root = Stage.group(Stage.view, "Chooser", 200)
	root.BackgroundTransparency = 0
	local town = SCENES.scenes[SCENES.start]
	root.BackgroundColor3 = Color3.fromRGB(tonumber(town.sky:sub(2, 3), 16), tonumber(town.sky:sub(4, 5), 16), tonumber(town.sky:sub(6, 7), 16))
	-- 달이 뜬 하늘과 먼 산(마을과 같은 그림)
	for i, l in town.layers do
		if i <= 2 then
			local img = Stage.image(root, "Layer" .. i, ASSETS[l.img] or "", l.w, l.h)
			img.Position = UDim2.fromOffset(0, l.y)
		end
	end
	-- 서 있는 바닥
	local floor = Instance.new("Frame")
	floor.Position = UDim2.fromOffset(0, GROUND_Y)
	floor.Size = UDim2.fromOffset(G.VIEW_W, G.VIEW_H - GROUND_Y)
	floor.BackgroundColor3 = INK
	floor.BorderSizePixel = 0
	floor.ZIndex = 3
	floor.Parent = root

	-- 글의 층(화면 틀): 제목 · 영웅의 이름 · 설명 판 · 누르는 자리
	local over = Stage.group(Stage.ui, "Chooser", 200)
	local titleBox = Stage.place(over, "Title", "tc", Stage.REF_W / 2 - 300, 22, 600, 16)
	Ui.text(titleBox, "달이 고른 자 — 누구의 뒤를 이을 것인가", 0, 0, 600, { font = "body", align = "center", outline = true })

	local order = CLASSES.order
	local n = #order
	local x0 = G.VIEW_W / 2 - GAP * (n - 1) / 2
	local slots = {}
	for i, id in order do
		local c = CLASSES.classes[id]
		local x = x0 + (i - 1) * GAP
		local sprite = Sprite.new(root, id, 5)
		local name = Ui.tag(over, c.name, WHITE, 200)
		-- 눌러서 고르는 자리(보이지 않는 단추)
		local button = Instance.new("TextButton")
		button.Name = "Pick_" .. id
		button.Text = ""
		button.BackgroundTransparency = 1
		button.ZIndex = 8
		button.Parent = over
		slots[i] = { id = id, class = c, x = x, sprite = sprite, name = name, button = button }
	end
	-- 이름과 누르는 자리는 영웅의 자리(게임의 도트)를 따라 놓는다 — 화면 틀의 배율이 바뀌면 다시 놓는다
	local function place()
		local r = Stage.ratio
		for _, s in slots do
			local cx, gy = math.floor(s.x * r + 0.5), math.floor(GROUND_Y * r + 0.5)
			s.name.Frame.Position = UDim2.fromOffset(cx - math.floor(s.name.Width / 2), gy + 6)
			s.button.Position = UDim2.fromOffset(cx - math.floor(GAP * r / 2), gy - math.floor(44 * r))
			s.button.Size = UDim2.fromOffset(math.floor(GAP * r), math.floor(44 * r) + 24)
		end
	end
	place()
	Stage.onResize(function()
		if over.Parent then
			place()
		end
	end)

	-- 고른 영웅의 설명: 아래 가운데의 판
	local holder = Stage.place(over, "Panel", "bc", Stage.REF_W / 2 - PANEL.w / 2, Stage.REF_H - PANEL.up - PANEL.h, PANEL.w, PANEL.h + 24)
	local panel = Ui.panel(holder, 0, 0, PANEL.w, PANEL.h)
	local head = Ui.text(panel, "", 18, 14, PANEL.w - 36, { font = "body", color = MINT })
	local role = Ui.text(panel, "", 18, 36, PANEL.w - 36, { lines = 3, line = 15 })
	Ui.text(holder, "← → 고르기 · Space 정하기", 0, PANEL.h + 8, PANEL.w, { align = "center", color = GRAY, outline = true })

	local picked = math.ceil(n / 2)
	local chosen: string? = nil
	local pickedAt = 0
	local clock = 0

	local function show()
		local slot = slots[picked]
		local c = slot.class
		head:color(if c.tone == "pink" then PINK else MINT)
		head:set(c.weapon) -- 무기만 적는다 — 처음에는 아무 이야기도 들려주지 않는다(사용자 2026-10-08: "처음에는 아무 스토리도 모르다가 그냥 캐릭터 키우다가")
		role:set(c.role)
		for i, s in slots do
			s.name:SetColor(if i == picked then WHITE else GRAY)
		end
		pickedAt = clock
	end
	local function pick(i: number)
		if i == picked then
			chosen = slots[i].id -- 고른 영웅을 한 번 더 누르면 정해진다
		else
			picked = i
			show()
		end
	end
	show()

	local connections = {}
	for i, s in slots do
		table.insert(connections, s.button.Activated:Connect(function()
			pick(i)
		end))
	end
	table.insert(connections, UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local key = input.KeyCode
		if key == Enum.KeyCode.Left then
			picked = (picked - 2) % n + 1
			show()
		elseif key == Enum.KeyCode.Right then
			picked = picked % n + 1
			show()
		elseif key == Enum.KeyCode.Space or key == Enum.KeyCode.Return then
			chosen = slots[picked].id
		end
	end))

	-- 고른 영웅은 사냥기를 한 번씩 써 보이고, 나머지는 서 있다(흐리게)
	local function mobSkill(id: string)
		for _, sk in COMBAT.skills do
			if sk.who == id and sk.type == "mob" then
				return sk
			end
		end
		return nil
	end
	table.insert(connections, RunService.RenderStepped:Connect(function(dt)
		clock += dt
		for i, s in slots do
			local char = s.sprite.char
			local clip, frame = "idle", Sprite.frameAt(char, "idle", clock + i * 0.2, false)
			if i == picked then
				local sk = mobSkill(s.id)
				local t = (clock - pickedAt) % 3 - 0.8 -- 0.8초 서 있다가 기술을 쓴다
				if sk and t >= 0 then
					for _, seg in sk.segs do
						if t < seg.time then
							clip, frame = seg.clip, seg.from + math.min(seg.to - seg.from, math.floor(t * seg.fps)) + 1
							break
						end
						t -= seg.time
					end
				end
			end
			s.sprite:set(clip, frame, s.x, GROUND_Y, 1)
			s.sprite.label.ImageTransparency = if i == picked then 0 else 0.45
		end
	end))

	while not chosen do
		task.wait()
	end
	for _, c in connections do
		c:Disconnect()
	end
	Chooser.root = root -- 서버의 답을 받을 때까지 화면을 그대로 둔다 — 부른 쪽이 close()로 닫는다
	Chooser.over = over
	return chosen :: string
end

function Chooser.close()
	if Chooser.root then
		Chooser.root:Destroy()
		Chooser.root = nil
	end
	if Chooser.over then
		Chooser.over:Destroy()
		Chooser.over = nil
	end
end

return Chooser

end
MODULES['Client/lune/cineView'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 퀘스트 연출(장면)의 그리기(2026-10-15) — 공방 「횡스크롤 시험」 탭의 장면(js/lune/luneTab.js의 drawCineActors · drawCineOver · paintCine)과 같은 자리 · 모양.
--  사용자 2026-10-15: "현재 메인 퀘스트 라인 너무스토리 몰입이 안됩니다 … 몰입되는 중간에 연출이 있는것도아니고 다른게임들 어떻게 스토리 진행하는지 좀 파악하고 만들어야합니다."
--  셈은 shared/lune/cine.luau(무엇이 언제 끝나나 · 누가 어디에). 여기서는 그 상태를 화면에 옮긴다:
--   세계(게임 도트): 장면이 세운 졸개 · 주민 · 쓰러질 때 흩어지는 재 / 화면 틀(고운 격자): 색 덮개 · 큰 그림 · 위아래 검은 띠 · 암전 · 장의 이름 · 보스의 이름 · 종이 · 머리 위 표시 · 「건너뛰기」
--   말은 아래의 대화창(ui/talk.luau의 Talk.cine)에 뜬다. 카메라 · 주민의 자리는 sceneView.luau가 장면의 값(camOverride · npcOver)을 읽는다.
--  boot.luau가 부른다: CineView.init(부모) · CineView.play(def, 세계) · CineView.update(dt, 세계의 층) · CineView.input("next" | "skip") · CineView.active()
--  퀘스트 동안의 맵 모습(불타는 마을의 붉은 하늘 — 장면 밖에서도): CineView.setLook(색, 비침)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local lune = ReplicatedStorage.shared.lune
local Cine = require(lune.cine)
local SCENES = require(lune.data["scenes.generated"])
local ASSETS = require(lune.data["assets.generated"])
local CHARS = require(lune.data["chars.generated"])
local Layout = require(lune.ui.layout)
local Format = require(lune.ui.format)
local Stage = require(script.Parent.stage)
local Overlay = require(script.Parent.overlay)
local Sprite = require(script.Parent.sprite)
local Ui = require(script.Parent.ui.ui)
local Talk = require(script.Parent.ui.talk)
local pixelText = require(script.Parent.Parent.modules.ui.pixelText)

local C = Ui.COLOR
local M = Ui.M
local CL = Layout.CINE
local LK = Cine.DATA.ui
local CPS = Format.DIALOG.cps
local INK = Color3.fromRGB(5, 7, 11)
local PINK = Color3.fromRGB(255, 126, 162)
local MINT = Color3.fromRGB(62, 255, 215)
local ASH = { Color3.fromRGB(201, 204, 209), Color3.fromRGB(139, 144, 152), Color3.fromRGB(74, 79, 87) }

local View = {}
View.onEnd = nil :: ((any) -> ())? -- 장면이 끝났다(def) — boot가 서버에 「봤다」를 알리고 다음 장면을 튼다

local low: Frame, high: Frame
local lookTint: Frame, tint: Frame, backdrop: Frame, picture: ImageLabel, glow: Frame, glowStroke: UIStroke
local cardBand: Frame, titleBand: Frame, barTop: Frame, barBottom: Frame, shade: Frame
local cardBox: Frame, cardText, cardSub, cardLines: { Frame }
local titleBox: Frame, titleText, titleSub, titleLine: Frame
local noteBox: Frame, notePaper: ImageLabel, noteShadow: ImageLabel, noteTitle, noteRows: { any }, noteHint, noteKey
local skipBtn, skipEsc, catcher: TextButton
local marks: { any } = {}
local session: any = nil

local function bigLabel(parent: Instance, color: Color3)
	-- 두 배 글: 틀에 UIScale 2를 걸고 그 안에 본문 글씨(테두리)를 놓는다
	local box = Ui.group(parent, 0, 0, 10, 10, "Big")
	local scale = Instance.new("UIScale")
	scale.Scale = 2
	scale.Parent = box
	local t = Ui.text(box, "", 0, 0, 400, { font = "body", outline = true, color = color })
	return box, t
end

-- 글씨(글자 그림들)의 비침 — 장의 이름 · 보스의 이름이 서서히 나타나고 사라진다
local function fadeText(root: Instance, a: number)
	for _, d in root:GetDescendants() do
		if d:IsA("ImageLabel") then
			d.ImageTransparency = 1 - a
		end
	end
end

function View.init(parent: Instance)
	low = Stage.group(parent, "CineLow", 55) -- 대화창(60) 아래: 세계를 덮는 것
	high = Stage.group(parent, "CineHigh", 70) -- 대화창 위: 글 · 단추
	low.Visible, high.Visible = false, false
	local function full(name: string, color: Color3, z: number): Frame
		local f = Ui.box(low, 0, 0, 1, 1, color, 1)
		f.Name, f.Size, f.ZIndex = name, UDim2.fromScale(1, 1), z
		return f
	end
	lookTint = Stage.group(parent, "CineLook", 54) -- 퀘스트 동안의 맵 모습(장면 밖에서도 보인다)
	lookTint.BackgroundTransparency = 1
	lookTint.BackgroundColor3 = Color3.new(1, 0, 0)
	tint = full("Tint", C.ink, 1)
	backdrop = full("Backdrop", INK, 2)
	picture = Stage.image(low, "Picture", "", 1, 1)
	picture.ZIndex = 3
	glow = Ui.box(low, 0, 0, 1, 1, MINT, 1)
	glow.ZIndex = 4
	glowStroke = Instance.new("UIStroke")
	glowStroke.Color = MINT
	glowStroke.Thickness = 2
	glowStroke.Parent = glow
	cardBand = full("CardBand", INK, 5)
	cardBand.Size = UDim2.new(1, 0, 0, 1)
	titleBand = full("TitleBand", INK, 5)
	local grad = Instance.new("UIGradient")
	grad.Transparency = NumberSequence.new(0, 1)
	grad.Parent = titleBand
	barTop = full("BarTop", Color3.new(0, 0, 0), 6)
	barBottom = full("BarBottom", Color3.new(0, 0, 0), 6)
	shade = full("Fade", Color3.new(0, 0, 0), 7)
	-- 위: 장의 이름(가운데) · 보스의 이름(왼쪽 아래) · 종이 · 머리 위 표시 · 「건너뛰기」
	catcher = Ui.hit(high) -- 화면 아무 데나 누르면 넘긴다(스마트폰 · 마우스) — 단추는 이 위에
	catcher.Name = "CineNext"
	catcher.ZIndex = 1 -- 「건너뛰기」 단추가 이 위에 온다
	catcher.Activated:Connect(function()
		View.input("next")
	end)
	cardBox = Ui.group(high, 0, 0, 10, 10, "Card")
	local cb
	cb, cardText = bigLabel(cardBox, C.text)
	cardSub = Ui.text(cardBox, "", 0, 0, 400, { color = C.dim, align = "center" })
	cardLines = { Ui.box(cardBox, 0, 0, 1, 1, C.accent), Ui.box(cardBox, 0, 0, 1, 1, C.accent) }
	cardBox:SetAttribute("big", cb.Name)
	titleBox = Ui.group(high, 0, 0, 10, 10, "BossTitle")
	local tb
	tb, titleText = bigLabel(titleBox, C.gold)
	titleSub = Ui.text(titleBox, "", 0, 0, 400, { color = PINK, outline = true })
	titleLine = Ui.box(titleBox, 0, 0, 1, 1, C.accent)
	noteBox = Ui.group(high, 0, 0, 10, 10, "Note")
	noteShadow = Ui.part(noteBox, "uBubble", 0, 3, 10, 10)
	noteShadow.ImageColor3 = Color3.fromRGB(150, 160, 170)
	notePaper = Ui.part(noteBox, "uBubble", 0, 0, 10, 10)
	noteTitle = Ui.text(noteBox, "", CL.notePad, CL.notePad, CL.noteW - CL.notePad * 2, { color = C.dim })
	noteRows = {}
	for i = 1, 8 do
		noteRows[i] = Ui.text(noteBox, "", CL.notePad, 0, CL.noteW - CL.notePad * 2, { font = "body", color = C.bubbleInk })
	end
	noteHint = Ui.text(noteBox, "닫기", 0, 0, 60, { outline = true })
	noteKey = Ui.keycap(noteBox, "↑", 0, 0)
	for i = 1, 4 do
		marks[i] = Ui.text(high, "", 0, 0, 40, { font = "body", outline = true, align = "center", color = C.text })
		marks[i]:show(false)
	end
	skipBtn = Ui.button(high, CL.skip, 0, 0, CL.skipW, function()
		View.input("skip")
	end, { h = CL.skipH })
	skipBtn.frame.ZIndex = 20
	skipEsc = Ui.text(high, "Esc", 0, 0, 30, { color = C.dim, outline = true, align = "right" })
	-- Esc: 건너뛰기(장면이 도는 동안만)
	UserInputService.InputBegan:Connect(function(input, processed)
		if session and not processed and input.KeyCode == Enum.KeyCode.Escape then
			View.input("skip")
		end
	end)
end

function View.active(): boolean
	return session ~= nil
end
function View.state(): any
	return session and session.st
end

-- 퀘스트 동안의 맵 모습: 색(nil이면 걷는다) · 비침
function View.setLook(color: Color3?, a: number)
	lookTint.BackgroundColor3 = color or Color3.new(0, 0, 0)
	lookTint.BackgroundTransparency = if color then 1 - a else 1
end

-- 이 맵에 없는 주민을 장면에 세울 때: 그 주민이 서 있는 장면의 주민 그림판 · 칸
local function npcArt(id: string)
	for _, sc in SCENES.scenes do
		if sc.npcs and sc.npcSheet then
			for _, n in sc.npcs do
				if n.id == id then
					return { image = ASSETS[sc.npcSheet] or "", cell = n.cell, nw = sc.npcCell[1], nh = sc.npcCell[2], name = n.name, cols = sc.npcCols or 999 }
				end
			end
		end
	end
	return nil
end
View.npcArt = npcArt

-- 장면을 튼다. w = 세계를 묻는 창구(shared/lune/cine.luau의 머리말) · world = 세계의 층(장면이 세운 것을 그 위에 놓는다)
function View.play(def, w, world: Frame)
	if session then
		View.stop()
	end
	session = { def = def, st = Cine.new(def, w), w = w, world = world, actors = {}, ash = {}, sayObj = nil, cardObj = nil, titleObj = nil, noteObj = nil, picShown = nil, clock = 0 }
	low.Visible, high.Visible = true, true
	return session.st
end

local function clearActors(s)
	for _, a in s.actors do
		if a.sprite then
			a.sprite:destroy()
		end
		if a.label then
			a.label:Destroy()
		end
	end
	s.actors = {}
	for _, p in s.ash do
		p.f:Destroy()
	end
	s.ash = {}
end

function View.stop()
	local s = session
	if not s then
		return
	end
	session = nil
	clearActors(s)
	Talk.cine(nil)
	low.Visible, high.Visible = false, false
	for _, m in marks do
		m:show(false)
	end
	if View.onEnd then
		View.onEnd(s.def)
	end
end

-- 누름: "next"(↑ · 스페이스 · 누르기) · "skip"(Esc · 「건너뛰기」)
function View.input(kind: string)
	local s = session
	if not s then
		return
	end
	local st = s.st
	if kind == "next" and st.wait and st.wait.input == "say" then
		if not Talk.cineFull() then
			Talk.cineReveal() -- 나오는 중이면 한 번에 다 보이고
			return
		end
		st.say.t = 1e9
	end
	Cine.input(st, kind, CPS)
end

-- 장면이 세운 것 하나를 그린다(졸개 = 그 졸개의 그림 · 주민 = 주민 그림판의 칸)
local function drawActor(s, key: string, a)
	local v = s.actors[key]
	if not v then
		v = {}
		if a.mob and CHARS.chars[a.mob] then
			v.sprite = Sprite.new(s.world, a.mob, 4)
		elseif a.npc then
			local art = npcArt(a.npc)
			if art then
				v.art = art
				v.label = Stage.image(s.world, "Cine_" .. key, art.image, art.nw, art.nh)
				v.label.ZIndex = 4
			end
		end
		s.actors[key] = v
	end
	if v.sprite then
		local char = CHARS.chars[a.mob]
		local clip = if a.clip == "death" and char.clips.death then "death" elseif a.walk and char.clips.run then "run" else "idle"
		v.sprite:set(clip, Sprite.frameAt(char, clip, a.t or 0, clip == "death"), a.x, a.y, a.dir)
		v.sprite.label.ImageTransparency = 1 - (a.alpha or 1)
		v.sprite.label.Visible = not a.hidden and v.sprite.label.Visible
		-- 쓰러지기 시작했다: 재가 흩어진다(한 번)
		if a.dying and not v.ashed then
			v.ashed = true
			for i = 1, 18 do
				local f = Ui.box(s.world, math.floor(a.x), math.floor(a.y - 12), 1, 1, ASH[(i % 3) + 1])
				f.ZIndex = 5
				local ang = math.rad(-160 + (i / 18) * 140)
				table.insert(s.ash, { f = f, x = a.x, y = a.y - 12, vx = math.cos(ang) * (14 + (i % 5) * 4), vy = math.sin(ang) * (16 + (i % 4) * 6), t = 0 })
			end
		end
	elseif v.label then
		local art = v.art
		local frame = math.floor(s.clock * (if a.walk then 8 else 1.6)) % 2
		local cols = art.cols or 999 -- 그림판을 cols칸마다 접었다(2026-10-16)
		local x, y = (art.cell % cols) * art.nw, (art.cell // cols * 2 + frame) * art.nh
		if (a.dir or 1) >= 0 then
			v.label.ImageRectOffset, v.label.ImageRectSize = Vector2.new(x, y), Vector2.new(art.nw, art.nh)
		else
			v.label.ImageRectOffset, v.label.ImageRectSize = Vector2.new(x + art.nw, y), Vector2.new(-art.nw, art.nh)
		end
		v.label.Position = UDim2.fromOffset(math.floor(a.x - art.nw / 2 + 0.5), a.y - art.nh)
		v.label.ImageTransparency = 1 - (a.alpha or 1)
		v.label.Visible = not a.hidden
	end
end

-- 매 화면: 셈을 흘리고 그린다. 장면이 끝나면 거두고 onEnd를 부른다
function View.update(dt: number)
	local s = session
	if not s then
		return
	end
	local st = s.st
	s.clock += dt
	Cine.step(st, dt)
	if st.done then
		View.stop()
		return
	end
	local W, H = Stage.uiW, Stage.uiH
	-- 세계: 장면이 세운 것 · 재
	for key, a in st.actors do
		drawActor(s, key, a)
	end
	for i = #s.ash, 1, -1 do
		local p = s.ash[i]
		p.t += dt
		p.vy += 30 * dt
		p.x += p.vx * dt
		p.y += p.vy * dt
		p.f.Position = UDim2.fromOffset(math.floor(p.x + 0.5), math.floor(p.y + 0.5))
		p.f.BackgroundTransparency = math.min(1, p.t / 1.1)
		if p.t >= 1.1 then
			p.f:Destroy()
			table.remove(s.ash, i)
		end
	end
	-- 색 덮개
	tint.BackgroundColor3 = if st.tint then Color3.fromHex(st.tint) else C.ink
	tint.BackgroundTransparency = if st.tint then 1 - st.tintA else 1
	-- 큰 그림(가운데 · 게임 도트의 크기 그대로 키운다) · 내 직업의 사람에게 빛
	local pd = st.picture and Cine.DATA.pictures[st.picture]
	backdrop.BackgroundTransparency = if pd then 0.18 else 1
	picture.Visible = pd ~= nil
	glow.Visible = false
	if pd then
		local r = Stage.ratio
		local pw, ph = math.floor(pd.w * r + 0.5), math.floor(pd.h * r + 0.5)
		local px, py = math.floor((W - pw) / 2), math.floor((H - ph) / 2 - 12 * r)
		picture.Image = ASSETS[pd.files[s.w.cls]] or ""
		picture.Position, picture.Size = UDim2.fromOffset(px, py), UDim2.fromOffset(pw, ph)
		local col = st.glow and pd.cols[s.w.cls]
		if col then
			local pulse = 0.5 + 0.5 * math.sin(st.clock * 4)
			glow.Visible = true
			glow.Position = UDim2.fromOffset(px + math.floor(col[1] * r), py + math.floor(pd.rows[1] * r))
			glow.Size = UDim2.fromOffset(math.floor((col[2] - col[1]) * r), math.floor((pd.rows[2] - pd.rows[1]) * r))
			glow.BackgroundTransparency = 1 - (0.1 + 0.1 * pulse)
			glowStroke.Transparency = 1 - (0.55 + 0.45 * pulse)
		end
	end
	-- 장의 이름의 띠 · 보스의 이름의 띠
	local cardA = if st.card then Cine.cardAlpha(st.card, LK.card) else 0
	local cy = math.floor(H * CL.cardY)
	cardBand.Position, cardBand.Size = UDim2.fromOffset(0, cy - 75), UDim2.new(1, 0, 0, 150)
	cardBand.BackgroundTransparency = 1 - 0.78 * cardA
	local titleA = if st.title then Cine.cardAlpha(st.title, LK.title) else 0
	local ty = math.floor(H * CL.titleY)
	titleBand.Position, titleBand.Size = UDim2.fromOffset(0, ty - 25), UDim2.fromOffset(math.floor(W * 0.7), 115)
	titleBand.BackgroundTransparency = 1 - 0.7 * titleA
	-- 위아래 검은 띠 · 암전
	local bh = math.floor(LK.bars * Stage.ratio * st.bars + 0.5)
	barTop.Size, barBottom.Size = UDim2.new(1, 0, 0, bh), UDim2.new(1, 0, 0, bh)
	barTop.Position, barBottom.Position = UDim2.fromOffset(0, 0), UDim2.new(0, 0, 1, -bh)
	barTop.BackgroundTransparency, barBottom.BackgroundTransparency = if bh > 0 then 0 else 1, if bh > 0 then 0 else 1
	shade.BackgroundTransparency = 1 - st.fade
	-- 장의 이름(가운데 · 두 배 글)
	cardBox.Visible = st.card ~= nil
	if st.card then
		if s.cardObj ~= st.card then
			s.cardObj = st.card
			cardText:set(st.card.text)
			cardSub:set(st.card.sub)
		end
		local tw = select(1, cardText:size()) * 2
		local lw = tw + 40
		cardBox.Position, cardBox.Size = UDim2.fromOffset(0, 0), UDim2.fromOffset(W, H)
		local big = cardBox:FindFirstChild("Big") :: Frame
		big.Position = UDim2.fromOffset(math.floor((W - tw) / 2), cy - M.body)
		cardLines[1].Position, cardLines[1].Size = UDim2.fromOffset(math.floor((W - lw) / 2), cy - M.body - 12), UDim2.fromOffset(lw, 1)
		cardLines[2].Position, cardLines[2].Size = UDim2.fromOffset(math.floor((W - lw) / 2), cy + M.body + 10), UDim2.fromOffset(lw, 1)
		cardSub:move(math.floor(W / 2) - 200, cy + M.body + 18)
		fadeText(cardBox, cardA)
		cardLines[1].BackgroundTransparency, cardLines[2].BackgroundTransparency = 1 - cardA, 1 - cardA
	end
	-- 보스의 이름(왼쪽 아래)
	titleBox.Visible = st.title ~= nil
	if st.title then
		if s.titleObj ~= st.title then
			s.titleObj = st.title
			titleText:set(st.title.text)
			titleSub:set(st.title.sub)
		end
		local tw = select(1, titleText:size()) * 2
		local big = titleBox:FindFirstChild("Big") :: Frame
		titleBox.Position, titleBox.Size = UDim2.fromOffset(0, 0), UDim2.fromOffset(W, H)
		big.Position = UDim2.fromOffset(CL.titleX, ty)
		titleLine.Position, titleLine.Size = UDim2.fromOffset(CL.titleX, ty + M.body * 2 + 8), UDim2.fromOffset(math.max(tw, Ui.measure(st.title.sub)) + 16, 1)
		titleSub:move(CL.titleX, ty + M.body * 2 + 14)
		fadeText(titleBox, titleA)
		titleLine.BackgroundTransparency = 1 - titleA
	end
	-- 종이(명령서)
	noteBox.Visible = st.note ~= nil
	if st.note and s.noteObj ~= st.note then
		s.noteObj = st.note
		local tw = CL.noteW - CL.notePad * 2
		noteTitle:set(st.note.title)
		local y = CL.notePad + M.smallLine + 10
		local row = 1
		for _, text in st.note.text do
			for _, ln in string.split(pixelText.Fit(text, tw, 2, "body"), "\n") do
				if noteRows[row] then
					noteRows[row]:set(ln)
					noteRows[row]:move(CL.notePad, y)
					noteRows[row]:show(true)
					row += 1
					y += M.bodyLine
				end
			end
			y += 4
		end
		for i = row, #noteRows do
			noteRows[i]:show(false)
		end
		local h = y - 4 + CL.notePad + 14
		local x0, y0 = math.floor((W - CL.noteW) / 2), math.floor((H - h) / 2) - 20
		noteBox.Position, noteBox.Size = UDim2.fromOffset(x0, y0), UDim2.fromOffset(CL.noteW, h + 30)
		notePaper.Size, noteShadow.Size = UDim2.fromOffset(CL.noteW, h), UDim2.fromOffset(CL.noteW, h)
		local hw = Ui.measure("닫기")
		noteHint:move(CL.noteW - CL.notePad - hw, h + 8)
		noteKey:move(CL.noteW - CL.notePad - hw - 12, h + 6)
	end
	-- 말(아래의 대화창)
	if st.say ~= s.sayObj then
		s.sayObj = st.say
		if st.say then
			Talk.cine(st.say.name, st.say.text)
		else
			Talk.cine(nil)
		end
	end
	-- 머리 위의 작은 표시(! ? …)
	for i, m in marks do
		local q = st.marks[i]
		local p = q and Cine.posOf(st, q.who)
		if q and p then
			local up = if q.who == "hero" then 26 elseif q.who == "boss" then 90 else 28
			m:set(q.kind)
			m:color(if q.kind == "!" then C.gold else C.text)
			m:move(Overlay.x(p.x) - 20, Overlay.y(p.y - up) - 16)
			m:show(true)
		else
			m:show(false)
		end
	end
	-- 「건너뛰기」(오른쪽 위)
	local sx = W - CL.skipW - CL.edge
	skipBtn.frame.Position = UDim2.fromOffset(sx, CL.edge)
	skipEsc:move(sx - 36, CL.edge + math.floor((CL.skipH - M.small) / 2))
	skipEsc:show(not UserInputService.TouchEnabled)
end

-- 이름표를 숨길 때인가(암전 · 큰 그림 — 이름표가 덮개 위로 비치지 않게)
function View.hideTags(): boolean
	local st = session and session.st
	return st ~= nil and (st.fade > 0.3 or st.picture ~= nil)
end

return View

end
MODULES['Client/lune/curtain'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 막 — 장면이 바뀔 때(문 · 마을로 돌아가기 · 관리 이동 · 게임에 들어올 때) 화면을 검게 덮고, 그 사이에 새 장면이 쓰는 그림을 다 불러온 뒤에 걷는다.
--  사용자 2026-10-11: "게임 시작시, 포탈 이용시 페이드 아웃 로딩 걸고 그 사이에 이미지 정확히 다 로드 해야합니다. 지금 그냥 포탈로 넘어간다음에 이미지들 로드 안되서 바로 안뜹니다."
--  전에는 처음에 그림의 번호(글)만 한꺼번에 미리 불러 두고, 문을 지나면 새 장면을 바로 그렸다 — 그 장면의 그림이 화면에 올라오기 전의 빈 모습이 잠깐 보였다.
--  이제는 새 장면을 막 뒤에서 그려 놓고, 거기에 실제로 쓰인 그림(ImageLabel)들이 다 불러와졌는지 보고 나서 막을 걷는다.
local ContentProvider = game:GetService("ContentProvider")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Curtain = {}
Curtain.OUT, Curtain.IN = 0.16, 0.26 -- 덮는 시간 · 걷는 시간(초)
Curtain.MAX_WAIT = 8 -- 그림을 기다리는 가장 긴 시간(초) — 끝내 오지 않는 그림이 있어도 화면은 열린다
Curtain.DOTS_AFTER = 0.5 -- 이보다 오래 걸리면 오른쪽 아래에 점 셋이 깜빡인다(불러오는 중)
Curtain.COLOR = Color3.fromRGB(11, 15, 22) -- 화면 부품의 가장 어두운 색(ui.js의 ink)
Curtain.DOT = Color3.fromRGB(143, 240, 212)

local gui: ScreenGui? = nil
local shade: Frame = nil
local dots: { Frame } = {}
local level = 0 -- 0 = 걷혀 있다 · 1 = 다 덮였다
local failed: { [string]: boolean } = {} -- 끝내 불러오지 못한 그림(다음부터는 기다리지 않는다)
Curtain.last = { images = 0, waited = 0, timedOut = 0 } -- 마지막으로 기다린 것(확인용)

function Curtain.init()
	if gui then
		return
	end
	local g = Instance.new("ScreenGui")
	g.Name = "LuneCurtain"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 1000 -- 게임 화면(LuneStage — 0)의 모든 것 위
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling -- 막(Shade — 10)이 그림 조각(Warm — 1)을 덮는다
	shade = Instance.new("Frame")
	shade.Name = "Shade"
	shade.ZIndex = 10
	shade.Size = UDim2.fromScale(1, 1)
	shade.BackgroundColor3 = Curtain.COLOR
	shade.BackgroundTransparency = 1
	shade.BorderSizePixel = 0
	shade.Visible = false
	shade.Parent = g
	for i = 1, 3 do
		local d = Instance.new("Frame")
		d.Name = "Dot" .. i
		d.Size = UDim2.fromOffset(8, 8)
		d.AnchorPoint = Vector2.new(1, 1)
		d.Position = UDim2.new(1, -28 - (3 - i) * 16, 1, -28)
		d.BackgroundColor3 = Curtain.DOT
		d.BorderSizePixel = 0
		d.Visible = false
		d.Parent = shade
		dots[i] = d
	end
	g.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = g
end

local function setLevel(k: number)
	level = math.clamp(k, 0, 1)
	shade.BackgroundTransparency = 1 - level
	shade.Visible = level > 0
	shade.Active = level > 0 -- 덮여 있는 동안은 뒤의 단추가 눌리지 않는다
end

local function showDots(on: boolean, now: number?)
	for i, d in dots do
		d.Visible = on
		if on and now then
			d.BackgroundTransparency = if math.floor(now * 3) % 3 == i - 1 then 0 else 0.7
		end
	end
end

local function fade(to: number, seconds: number)
	local from = level
	if seconds <= 0 or from == to then
		setLevel(to)
		return
	end
	local t = 0
	while t < seconds do
		t += RunService.Heartbeat:Wait()
		setLevel(from + (to - from) * math.min(1, t / seconds))
	end
	setLevel(to)
end

-- 화면을 덮는다(다 덮일 때까지 기다린다). seconds를 안 주면 Curtain.OUT
function Curtain.cover(seconds: number?)
	Curtain.init()
	fade(1, seconds or Curtain.OUT)
end

-- 막을 걷는다(다 걷힐 때까지 기다린다)
function Curtain.lift(seconds: number?)
	Curtain.init()
	showDots(false)
	fade(0, seconds or Curtain.IN)
end

function Curtain.covered(): boolean
	return level >= 1
end

-- 그 틀들 아래에서 쓰이는 그림들(그림마다 한 번씩): 보이는 것도, 숨겨져 있는 것(조금 뒤에 나타날 몬스터 · 쓰러졌을 때의 비석)도, 카메라 밖에 놓인 것도 모두
function Curtain.images(roots: { Instance }): { string }
	local seen, list = {}, {}
	for _, root in roots do
		for _, d in root:GetDescendants() do
			if d:IsA("ImageLabel") or d:IsA("ImageButton") then
				local image = (d :: any).Image
				if image ~= "" and not seen[image] and not failed[image] then
					seen[image] = true
					table.insert(list, image)
				end
			end
		end
	end
	return list
end

-- 그 틀들에 쓰인 그림이 다 불러와질 때까지 기다린다(가장 길게 timeout초). 막을 친 뒤, 새 장면을 그린 다음에 부른다.
--  로블록스는 숨겨져 있거나 화면 밖에 놓인 그림을 미리 불러와 두지 않는다(그것이 처음 그려질 때에야 올라온다 — 그래서 문을 지난 뒤 땅과 몬스터가 한 박자 늦게 떴다).
--  그래서 그림마다 작은 조각(4점짜리)을 막 뒤에 실제로 그려 놓고, 조각마다 「불러옴」(IsLoaded)이 설 때까지 기다린다 — 그 그림은 이제 바로 그려진다. 조각은 막을 걷기 전에 치운다.
--  돌려주는 것: 기다린 시간(초) · 그림의 수 · 끝내 오지 않은 수
function Curtain.load(roots: { Instance }, timeout: number?): (number, number, number)
	Curtain.init()
	local images = Curtain.images(roots)
	local warm = Instance.new("Frame")
	warm.Name = "Warm"
	warm.Size = UDim2.fromOffset(4, 4)
	warm.BackgroundTransparency = 1
	warm.BorderSizePixel = 0
	warm.ZIndex = 1 -- 막(Shade — 10)의 뒤: 막이 덮여 있는 동안은 보이지 않는다
	local pieces = {}
	for i, image in images do
		local piece = Instance.new("ImageLabel")
		piece.Name = "Piece"
		piece.Size = UDim2.fromOffset(4, 4)
		piece.Position = UDim2.fromOffset((i - 1) % 64 * 4, math.floor((i - 1) / 64) * 4)
		piece.BackgroundTransparency = 1
		piece.BorderSizePixel = 0
		piece.Image = image
		piece.Parent = warm
		pieces[i] = piece
	end
	warm.Parent = gui
	local finished = #pieces == 0
	if not finished then
		task.spawn(function()
			pcall(function()
				ContentProvider:PreloadAsync(pieces)
			end)
			finished = true
		end)
	end
	local limit = timeout or Curtain.MAX_WAIT
	local t0 = os.clock()
	local missing = 0
	local timedOut = 0
	while true do
		local now = os.clock()
		missing = 0
		for _, piece in pieces do
			if not piece.IsLoaded then
				missing += 1
			end
		end
		if finished and missing == 0 then
			break
		elseif now - t0 >= limit then
			-- 끝내 오지 않았다: 그 그림들은 다음부터 기다리지 않는다(장면이 바뀔 때마다 멈춰 서지 않게)
			for _, piece in pieces do
				if not piece.IsLoaded then
					failed[piece.Image] = true
					timedOut += 1
				end
			end
			break
		end
		showDots(now - t0 >= Curtain.DOTS_AFTER, now)
		RunService.Heartbeat:Wait()
	end
	-- 새 장면이 한 번 그려진 뒤에 걷는다(카메라가 제자리를 잡고, 장면의 그림들이 방금 불러온 것으로 그려진다)
	RunService.Heartbeat:Wait()
	RunService.Heartbeat:Wait()
	warm:Destroy()
	local waited = os.clock() - t0
	Curtain.last = { images = #images, waited = waited, timedOut = timedOut }
	-- 확인용: 마지막으로 기다린 것을 막의 속성으로 적어 둔다(Studio에서 읽어 본다) — 그림의 수 · 기다린 시간 · 끝내 오지 않은 수 · 지금까지 기다린 횟수
	if gui then
		gui:SetAttribute("Images", #images)
		gui:SetAttribute("Waited", math.floor(waited * 1000 + 0.5) / 1000)
		gui:SetAttribute("TimedOut", timedOut)
		gui:SetAttribute("Loads", (gui:GetAttribute("Loads") or 0) + 1)
	end
	return waited, #images, timedOut
end

return Curtain

end
MODULES['Client/lune/effects'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 잠깐 떴다 사라지는 것들 — 피해 숫자 · 얻은 것 알림 · 화살 · 떨어진 물건 · 대쉬의 잔상과 속도선. 모두 맵 좌표(도트)에 놓여 카메라와 함께 움직인다.
--  대쉬의 잔상 · 속도선은 공방 「횡스크롤 시험」 탭의 것 그대로다(값은 data/combat.generated.luau의 fx — dino-workshop/js/lune/fx.js의 DASHFX).
--   사용자 2026-10-07: "대쉬 이펙트가 바뀐거같은데" — 게임에는 이 효과가 없었다. 시험 탭과 같게 넣었다.
--  피해 숫자 · 화살 · 떨어진 것은 게임 세계의 그림(굵은 도트)이고, 알림 글(「+12」 · 「레벨 업!」)은 글씨의 층(화면 틀의 고운 격자 — overlay.luau)에 테두리 두른 작은 글씨로 뜬다.
--  피해 숫자는 공방 「횡스크롤 시험」 탭과 똑같이 뜬다(ui/kit.luau의 dmg — 3x5 점 숫자 · 0.7초 · 16도트 떠오름), 그 밖의 글은 작은 글씨(갈무리9)로 그린다.
--  떨어진 달돈 · 달가루는 작은 그림(8x8), 장비는 그 장비의 아이콘 그대로 떨어진다.
--  1차의 사출기 · 장치(shared/lune/sim/kit.luau)가 보이는 것도 여기서 그린다 — 작은 네모 몇 개로 찍은 점 그림(직업 색)이다:
--   따로 나가는 타(proc): 달빛 도끼가 머리 위에서 떨어진다 · 표창 · 도깨비불 · 수정 조각 · 불티가 날아간다 · 달아오름의 불꽃이 솟는다 · 수정이 번쩍인다
--   달 수정(무니) · 졸개 머리 위의 표식(리븐) · 몸 둘레를 도는 영혼(리퍼) · 머리 위의 힘 모으기 단계(액시온)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local COMBAT = require(ReplicatedStorage.shared.lune.data["combat.generated"])
local pixelText = require(script.Parent.Parent.modules.ui.pixelText)
local Sprite = require(script.Parent.sprite)
local Kit = require(script.Parent.ui.kit)
local Ui = require(script.Parent.ui.ui)
local Overlay = require(script.Parent.overlay)
local ItemCell = require(script.Parent.ui.itemCell)

local C = Kit.COLOR -- 피해 숫자의 색
local U = Ui.COLOR -- 글의 색

local Effects = {}
Effects.__index = Effects
Effects.WHITE, Effects.MINT, Effects.PINK, Effects.GOLD = U.text, U.accent, U.pink, U.gold
-- 피해 숫자의 색(시험 탭 그대로): 보통 = 흰색 · 센 타격 = 때린 사람 직업의 밝은 색(민트 · 분홍) · 사라지기 직전 = 흐린 청회색.
--  내가 받은 피해만 붉게 한다(시험 탭에는 없는 것 — 시험 탭의 캐릭터는 맞지 않는다)
Effects.DEAL, Effects.HURT, Effects.FADE = C.dmg, U.red, C.dmgFade
Effects.BIG = { mint = C.dmgBig, pink = C.dmgBigPink }
local NUM_LIFE, NUM_RISE, NUM_JITTER, NUM_POP, NUM_POP_T, NUM_FADE = 0.7, 16, 4, 2, 0.15, 0.8 -- dino-workshop/js/lune/fx.js의 num과 같은 값
local GHOST, STREAK = COMBAT.fx.dash.ghost, COMBAT.fx.dash.streak
-- 직업 색(mint · pink): n = 직업 색 · l = 밝은 색
Effects.TONE = {}
for name, t in COMBAT.fx.tones do
	Effects.TONE[name] = { n = Color3.fromRGB(t.n[1], t.n[2], t.n[3]), l = Color3.fromRGB(t.l[1], t.l[2], t.l[3]) }
end

-- layer = 게임 세계의 맨 위 층 · textLayer = 글씨의 층(화면 틀 — overlay) · heroLayer = 캐릭터들의 층(잔상은 캐릭터 뒤에 깔린다)
function Effects.new(layer: Frame, textLayer: Frame, heroLayer: Frame?)
	local self = setmetatable({}, Effects)
	self.layer = layer
	self.textLayer = textLayer
	self.heroLayer = heroLayer or layer
	self.ghosts = {} -- 잔상
	self.lines = {} -- 속도선
	self.floats = {} -- 떠오르는 글씨 · 숫자
	self.shots = {} -- [번호] = 화살
	self.drops = {} -- [번호] = 떨어진 것
	self.sprites = {} -- 잠깐 틀고 사라지는 그림(기술의 광선 등)
	self.puffs = {} -- 2단 점프의 흩어지는 점
	return self
end

-- 같은 자리에 겹치지 않게 조금씩 어긋나게 올린다(h = 게임의 도트)
function Effects:_push(item, h: number)
	for _, other in self.floats do
		if math.abs(other.x - item.x) < 60 and other.t < 0.25 then
			item.y -= h
		end
	end
	table.insert(self.floats, item)
end

-- (x, y) 위로 떠오르는 글씨
function Effects:float(text: string, x: number, y: number, color: Color3, life: number?)
	local label = pixelText.new(self.textLayer, { Text = text, Font = "small_o", Color = color, Align = "center" })
	label.Frame.ZIndex = 10
	self:_push({ frame = label.Frame, text = true, width = label.Width, x = x, y = y, t = 0, life = life or 0.7 }, 6)
end

-- 피해 숫자. (x, y) = 숫자들의 가운데 · 윗줄이 처음 뜨는 자리. big = 센 타격(처음 잠깐 두 점 더 높이 뜬다)
--  시험 탭처럼 좌우로 조금씩 흩어져 뜬다(겹쳐도 밀어 올리지 않는다).
function Effects:number(value: number, x: number, y: number, color: Color3, big: boolean?)
	local num = Kit.dmg(self.layer, tostring(math.max(0, math.floor(value + 0.5))), color)
	num.frame.ZIndex = 11
	table.insert(self.floats, {
		frame = num.frame,
		num = num,
		big = big == true,
		faded = false,
		width = num.width - 2, -- 테두리를 뺀 숫자의 폭(가운데를 맞출 때 쓴다)
		x = x + (math.random() - 0.5) * NUM_JITTER * 2,
		y = y,
		t = 0,
		life = NUM_LIFE,
	})
end

-- 캐릭터 판의 동작 하나를 (x, y)에 한 번 튼다(화염 광선처럼 기술에 딸린 그림)
function Effects:addSprite(who: string, clip: string, x: number, y: number, dir: number, life: number, fps: number)
	local sprite = Sprite.new(self.layer, who, 6)
	table.insert(self.sprites, { sprite = sprite, clip = clip, x = x, y = y, dir = dir, t = 0, life = life, fps = fps })
end

-- 캐릭터 판의 동작 하나를 그 동작의 빠르기로 튼다(보스 패턴의 이펙트 그림 — shared/lune/bossfx.luau). 공방 시험 탭의 fx.sprite와 같은 셈
--  opts: delay 늦게(음수면 그만큼 이미 흐른 데서) · back 몸들의 뒤(캐릭터들의 층 맨 아래) · loop 돌려 트는 시간(초 — 없으면 한 번 튼다) · vx 가는 빠르기(점/초)
--        lo · hi 그 밖에서는 보이지 않는다(방의 벽) · fade 끝에서 사라지는 몫(0~1)
function Effects:play(who: string, clip: string, x: number, y: number, dir: number, opts)
	opts = opts or {}
	local sprite = Sprite.new(if opts.back then self.heroLayer else self.layer, who, if opts.back then 0 else 6)
	local c = sprite.char.clips[clip]
	if not c then
		sprite:destroy() -- 그 그림이 없다(아직 싣지 않은 이펙트)
		return
	end
	sprite.label.Name = "BossFx"
	table.insert(self.sprites, {
		sprite = sprite,
		clip = clip,
		x = x,
		y = y,
		dir = dir,
		t = -(opts.delay or 0),
		life = opts.loop or (#c.frames / c.fps),
		fps = c.fps,
		loop = opts.loop ~= nil,
		vx = opts.vx or 0,
		lo = opts.lo,
		hi = opts.hi,
		fade = opts.fade or 0,
	})
end

-- 잔상: 그 캐릭터의 그 장을 한 색 실루엣으로 남긴다. 처음의 불투명도에서 곧게 옅어져 사라진다(시험 탭의 ghost)
function Effects:ghost(who: string, clip: string, frame: number, x: number, y: number, dir: number, color: Color3)
	local sprite = Sprite.new(self.heroLayer, who, 0, true)
	sprite.label.Name = "Ghost"
	sprite.label.ImageColor3 = color
	sprite.label.ImageTransparency = 1 - GHOST.alpha
	sprite:set(clip, frame, x, y, dir)
	table.insert(self.ghosts, { sprite = sprite, t = 0 })
end

-- 대쉬를 하는 동안 every초마다 잔상을 남긴다. o = 그 사람의 상태(o.ghostT에 시간을 쌓는다). 남겼으면 true
function Effects:trail(o, dt: number, who: string, clip: string, frame: number, x: number, y: number, dir: number, tone: string): boolean
	o.ghostT = (o.ghostT or 0) + dt
	if o.ghostT <= GHOST.every then
		return false
	end
	o.ghostT = 0
	self:ghost(who, clip, frame, x, y, dir, Effects.TONE[tone].n)
	return true
end

-- 속도선: 대쉬를 시작할 때 한 번. (x, y) = 발밑 · speed = 대쉬의 속도(점/초 — 빠를수록 줄이 많고 길다) · tone = 직업 색의 이름(시험 탭의 streaks)
function Effects:streaks(x: number, y: number, speed: number, dir: number, tone: string)
	local n = math.floor(STREAK.base + speed / STREAK.perSpeed + 0.5)
	local len = STREAK.len + speed / STREAK.lenPerSpeed
	for _ = 1, n do
		local frame = Kit.box(self.layer, 0, 0, 1, 1, Effects.TONE[tone].l)
		frame.Name = "Streak"
		frame.ZIndex = 5
		frame.Visible = false
		table.insert(self.lines, {
			frame = frame,
			x = x + (math.random() - 0.5) * STREAK.w,
			y = y - STREAK.up - math.random() * STREAK.h,
			len = len * (0.5 + math.random()),
			life = STREAK.life * (0.6 + math.random() * 0.6),
			t = -math.random() * STREAK.delay, -- 제각기 조금씩 늦게 뜬다
			dir = dir,
			tone = Effects.TONE[tone],
			late = false,
		})
	end
end

-- 2단 점프: 발밑에서 좌우로 흩어지며 가라앉는 밝은 점 여섯(0.3초) — 공중에서 발을 구른 자리가 보인다
local HOP = { n = 6, life = 0.3, speed = 34, drop = 14, color = Color3.fromRGB(238, 246, 246) }
function Effects:hop(x: number, y: number)
	for i = 1, HOP.n do
		local frame = Kit.box(self.layer, 0, 0, if i <= 2 then 2 else 1, 1, HOP.color)
		frame.Name = "Hop"
		frame.ZIndex = 5
		local side = if i % 2 == 0 then 1 else -1
		table.insert(self.puffs, { frame = frame, x = x + side * 2, y = y - 1, vx = side * HOP.speed * (0.35 + 0.22 * math.ceil(i / 2)), t = 0 })
	end
end

-- 화살. 쏜 졸개의 종류(s.kind)에 제 날아가는 그림(shot)이 있으면 그 그림이 날아간다(빈 투구의 덩어리) — 없으면 흰 줄(궁병의 화살)
function Effects:addShot(s, now: number)
	local def = s.kind and COMBAT.mobs[s.kind]
	if def and def.atk.shot and def.atk.shot.clip then
		local sprite = Sprite.new(self.layer, def.sprite, 8)
		self.shots[s.id] = { sprite = sprite, clip = def.atk.shot.clip, x = s.x, y = s.y, dir = s.dir, speed = s.speed, born = now, range = s.range }
		return
	end
	local frame = Kit.box(self.layer, 0, 0, 7, 1, C.white)
	frame.Name = "Arrow"
	frame.ZIndex = 8
	self.shots[s.id] = { frame = frame, x = s.x, y = s.y, dir = s.dir, speed = s.speed, born = now, range = s.range }
end

function Effects:endShot(id: number)
	local s = self.shots[id]
	if s then
		if s.sprite then
			s.sprite:destroy()
		else
			s.frame:Destroy()
		end
		self.shots[id] = nil
	end
end

-- 몬스터의 마법(몸 동작과 따로 뜨는 그림): 그 종류의 마법 그림(cast)을 (x, y)에서 한 번 튼다 — 사람들의 앞에 그린다(맞는 것은 서버가 예고 뒤에 알린다)
function Effects:addMobCast(kind: string, x: number, y: number, dir: number?)
	local def = COMBAT.mobs[kind]
	local cast = def and def.atk.cast
	if not cast then
		return
	end
	local sprite = Sprite.new(self.layer, def.sprite, 7)
	local clip = sprite.char.clips[cast.clip]
	-- 앞으로 뻗는 마법(front — 등불 해파리의 번개 줄기)은 쓴 몬스터가 보던 쪽으로 뒤집어 그린다. 나머지(발밑 · 몸)는 뒤집지 않는다
	table.insert(self.sprites, { sprite = sprite, clip = cast.clip, x = x, y = y, dir = if cast.place == "front" then dir or 1 else 1, t = 0, life = cast.life, fps = clip.fps })
end

-- 떨어진 것: 달돈 · 달가루 = 작은 그림 · 장비 = 그 장비의 아이콘(성능 단이 보통이 아니면 귀퉁이에 세모)
--  땅에 놓이는 크기: 가방의 그림(18점)을 그대로 놓으면 캐릭터(키 17점)만 하다 — DROP_SCALE배로 줄여 놓는다(18 → 11점쯤).
--   사용자 2026-10-11: "드랍되는 아이템들 크기가 너무 큽니다. 다들 평균적으로". 달돈 · 달가루는 처음부터 8점으로 그린 그림을 그대로 쓴다(줄이면 뭉개진다)
Effects.DROP_SCALE = 0.6
Effects.COIN = { frames = 4, fps = 7, scale = 0.45 } -- 떨어진 달돈이 도는 그림의 장 수 · 빠르기(1초에 몇 장 — 한 바퀴에 0.57초)
function Effects:addDrop(d)
	local frame, w, h
	if d.kind == "gear" or d.kind == "quest" or d.kind == "goods" then
		w, h = Kit.ICON, Kit.ICON
		frame = Kit.group(self.layer, 0, 0, w, h)
		if d.kind == "gear" then
			Kit.icon(frame, ItemCell.icon(d.item), 0, 0)
			local tier = ItemCell.tier(d.item)
			if tier then
				Kit.part(frame, tier, 0, 0)
			end
		else
			-- 퀘스트의 물건 · 재료 · 물약 같은 가방의 아이템: 그 물건의 그림(공방의 그림 이름 — quests.generated · items.generated의 icon)
			Kit.icon(frame, d.icon, 0, 0)
		end
		local scale = Instance.new("UIScale")
		scale.Scale = Effects.DROP_SCALE
		scale.Parent = frame
		w, h = w * Effects.DROP_SCALE, h * Effects.DROP_SCALE
	else
		-- 달돈 = 도는 주화(부품 dropCoin1~4 — Codex의 그림을 칸 그대로 옮긴 것: 테두리 · 초승달 각인 · 빛) · 달가루 = 8x8 수정(부품 dropDust). 공방 tools/build_lune_coin.mjs · build_lune_ui.mjs.
		--  달돈이 지나온 길: 손으로 찍은 어두운 금색 8x8("돈처럼 안보이고 무슨 똥같이보입니다" — 2026-10-07) → 가방의 그림 18x18("돈너무 이미지 크기가 크게나온다") → 그것을 줄인 12x12("달돈 생긴거 너무 못생겼음" — 2026-10-11: 줄이며 뭉개졌다)
		--  → 손으로 찍은 밝은 민무늬 8x8("전혀 돈 같지 않고 그냥 노랑 동그란 과자같은데" — 같은 날: 테두리도 각인도 없었다) → Codex가 그린 주화를 손대지 않고 그대로. 달돈은 내가 손으로 그리지 않는다
		frame = Kit.part(self.layer, if d.kind == "dust" then "dropDust" else "dropCoin1", 0, 0)
		w, h = frame.Size.X.Offset, frame.Size.Y.Offset
		if d.kind ~= "dust" then
			-- 주화의 그림은 가로 19 · 세로 21점으로 그려져 있다(Codex의 칸 그대로 — 테두리와 초승달 각인이 들어가려면 그만한 칸이 든다). 땅에는 COIN.scale배로 놓는다(세로 9.5점쯤 — 캐릭터 키의 절반 남짓).
			--  화면의 점은 게임 세계의 도트보다 곱절 넘게 잘아서(세계 배율 3 이상) 줄여 놓아도 그림의 칸이 빠지지 않는다
			local scale = Instance.new("UIScale")
			scale.Scale = Effects.COIN.scale
			scale.Parent = frame
			w, h = w * Effects.COIN.scale, h * Effects.COIN.scale
		end
	end
	frame.Name = "Drop" .. d.id
	frame.ZIndex = 7
	-- 달돈은 빙글 돈다(spin — 부품 dropCoin1~4를 차례로: 앞 → 비스듬히 → 옆 → 비스듬히). 주화라는 것이 한눈에 보인다
	self.drops[d.id] = { frame = frame, x = d.x, y = d.y, w = w, h = h, amount = d.amount, kind = d.kind, item = d.item, name = d.name, phase = d.id * 0.7, spin = d.kind ~= "dust" and d.kind ~= "gear" and d.kind ~= "quest" and d.kind ~= "goods" }
end

function Effects:removeDrop(id: number)
	local d = self.drops[id]
	if d then
		d.frame:Destroy()
		self.drops[id] = nil
	end
	return d
end

-- 주울 수 있는 거리 안에서 가장 가까운 것의 번호
function Effects:dropNear(x: number, y: number, reach: number): number?
	local best, bestD = nil, reach
	for id, d in self.drops do
		local dist = math.abs(d.x - x)
		if dist <= bestD and math.abs(d.y - y) <= reach + 12 then
			best, bestD = id, dist
		end
	end
	return best
end

function Effects:update(now: number, dt: number)
	for i = #self.floats, 1, -1 do
		local f = self.floats[i]
		f.t += dt
		if f.t >= f.life then
			f.frame:Destroy()
			table.remove(self.floats, i)
		else
			local k = f.t / f.life
			if f.num then
				-- 시험 탭의 num과 같은 식: 16도트를 처음엔 빠르게 · 끝에선 느리게 오르고, 마지막 20%는 흐린 색
				local rise = NUM_RISE * (1 - (1 - k) * (1 - k)) + (if f.big and k < NUM_POP_T then NUM_POP else 0)
				f.frame.Position = UDim2.fromOffset(math.floor(f.x - f.width / 2 + 0.5) - 1, math.floor(f.y - rise + 0.5) - 1)
				if k > NUM_FADE and not f.faded then
					f.faded = true
					f.num:color(Effects.FADE)
				end
			else
				-- 알림 글: 게임의 도트로 6쯤 떠오른다(화면 틀의 점으로 자리를 잡는다)
				local rise = 6 * (1 - (1 - k) * (1 - k))
				f.frame.Position = UDim2.fromOffset(Overlay.x(f.x) - math.floor(f.width / 2), Overlay.y(f.y - rise))
			end
		end
	end
	for i = #self.sprites, 1, -1 do
		local sp = self.sprites[i]
		sp.t += dt
		if sp.t >= sp.life then
			sp.sprite:destroy()
			table.remove(self.sprites, i)
		elseif sp.t < 0 then
			sp.sprite.label.Visible = false -- 아직 제 때가 아니다(늦게 뜨는 것)
		else
			local n = #sp.sprite.char.clips[sp.clip].frames
			local f = math.floor(sp.t * sp.fps)
			local x = sp.x + (sp.vx or 0) * sp.t
			if (sp.lo and x < sp.lo) or (sp.hi and x > sp.hi) then
				sp.sprite.label.Visible = false -- 방의 벽 밖
			else
				sp.sprite:set(sp.clip, if sp.loop then f % n + 1 else math.min(n, f + 1), x, sp.y, sp.dir)
				if sp.fade and sp.fade > 0 then
					local k = sp.t / sp.life
					sp.sprite.label.ImageTransparency = if k > 1 - sp.fade then 1 - math.max(0, (1 - k) / sp.fade) else 0
				end
			end
		end
	end
	for i = #self.ghosts, 1, -1 do
		local g = self.ghosts[i]
		g.t += dt
		if g.t > GHOST.life then
			g.sprite:destroy()
			table.remove(self.ghosts, i)
		else
			g.sprite.label.ImageTransparency = 1 - GHOST.alpha * (1 - g.t / GHOST.life)
		end
	end
	for i = #self.lines, 1, -1 do
		local s = self.lines[i]
		s.t += dt
		local k = s.t / s.life
		if k >= 1 then
			s.frame:Destroy()
			table.remove(self.lines, i)
		elseif k >= 0 then
			-- 뒤로 밀리며 짧아진다. 앞의 절반은 밝은 색, 뒤의 절반은 직업 색
			local l = s.len * (1 - k)
			s.frame.Position = UDim2.fromOffset(math.floor(s.x - s.dir * k * STREAK.slide - (if s.dir > 0 then l else 0) + 0.5), math.floor(s.y + 0.5))
			s.frame.Size = UDim2.fromOffset(math.max(1, math.floor(l + 0.5)), 1)
			s.frame.Visible = true
			if k >= 0.5 and not s.late then
				s.late = true
				s.frame.BackgroundColor3 = s.tone.n
			end
		end
	end
	for i = #self.puffs, 1, -1 do
		local p = self.puffs[i]
		p.t += dt
		local k = p.t / HOP.life
		if k >= 1 then
			p.frame:Destroy()
			table.remove(self.puffs, i)
		else
			-- 처음엔 빠르게, 끝에선 느리게 옆으로 퍼지며 조금 가라앉고 흐려진다
			local out = 1 - (1 - k) * (1 - k)
			p.frame.Position = UDim2.fromOffset(math.floor(p.x + p.vx * HOP.life * out + 0.5), math.floor(p.y + HOP.drop * k * k + 0.5))
			p.frame.BackgroundTransparency = k
		end
	end
	for id, s in self.shots do
		local gone = (now - s.born) * s.speed
		if gone > s.range + 20 then
			self:endShot(id)
		else
			local x = s.x + s.dir * gone
			if s.sprite then
				s.sprite:set(s.clip, Sprite.frameAt(s.sprite.char, s.clip, now - s.born, false), x, s.y, s.dir)
			else
				s.frame.Position = UDim2.fromOffset(math.floor(x - 3 + 0.5), math.floor(s.y))
			end
		end
	end
	-- 떨어진 것은 땅 바로 위에서 천천히 오르내린다
	for _, d in self.drops do
		local bob = math.floor(math.sin(now * 4 + d.phase) * 1.5 + 0.5)
		d.frame.Position = UDim2.fromOffset(math.floor(d.x - d.w / 2 + 0.5), math.floor(d.y - d.h - 2 + bob + 0.5))
		if d.spin then
			local f = math.floor(now * Effects.COIN.fps + d.phase) % Effects.COIN.frames + 1
			if f ~= d.spinAt then
				d.spinAt = f
				Kit.swap(d.frame, "dropCoin" .. f)
			end
		end
	end
end

function Effects:destroy()
	for _, f in self.floats do
		f.frame:Destroy()
	end
	-- 날아가는 것: 흰 줄(frame)이거나 제 그림으로 나는 것(sprite — 빈 투구의 덩어리)이다. 둘 다 지운다
	--  (2026-10-13 — 전에는 모두 frame이라고 보고 지워서, 그림으로 나는 것이 떠 있는 동안 문을 지나면 여기서 오류가 났고 새 장면이 그려지지 않았다)
	for _, s in self.shots do
		if s.sprite then
			s.sprite:destroy()
		else
			s.frame:Destroy()
		end
	end
	for _, d in self.drops do
		d.frame:Destroy()
	end
	for _, sp in self.sprites do
		sp.sprite:destroy()
	end
	for _, g in self.ghosts do
		g.sprite:destroy()
	end
	for _, s in self.lines do
		s.frame:Destroy()
	end
	for _, p in self.puffs do
		p.frame:Destroy()
	end
	table.clear(self.puffs)
	table.clear(self.ghosts)
	table.clear(self.lines)
	table.clear(self.sprites)
	table.clear(self.floats)
	table.clear(self.shots)
	table.clear(self.drops)
end

return Effects

end
MODULES['Client/lune/fxart'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 이펙트의 그림(Aseprite로 그린 것 — 무니의 수정): 공방이 내보낸 점 자료(data/fxart.generated.luau)를 그림판에 찍을 수 있는 꼴로 푼다.
--  FxArt[이름] = { w, h, buf(RGBA) , hi = 흰 모서리 · 반짝임만 남긴 그림(반투명으로 겹칠 때도 모서리는 또렷하게 — 시험 탭의 hiOf) }
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DATA = require(ReplicatedStorage.shared.lune.data["fxart.generated"])

local FxArt = {}
for name, e in DATA do
	local n = e.w * e.h * 4
	local buf, hi = buffer.create(n), buffer.create(n)
	local hex = e.hex
	for i = 0, n - 1 do
		buffer.writeu8(buf, i, tonumber(string.sub(hex, i * 2 + 1, i * 2 + 2), 16) or 0)
	end
	for p = 0, n - 4, 4 do
		if buffer.readu8(buf, p) > 250 and buffer.readu8(buf, p + 1) > 250 and buffer.readu8(buf, p + 2) > 250 then
			buffer.writeu32(hi, p, buffer.readu32(buf, p))
		end
	end
	FxArt[name] = { w = e.w, h = e.h, buf = buf, hi = { w = e.w, h = e.h, buf = hi } }
end

return FxArt

end
MODULES['Client/lune/gainLog'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 획득 알림 — 경험치 · 달돈 · 달가루 · 주운 것 · 레벨 업 · 퀘스트 완료를 화면 구석에 줄로 쌓는다(메이플스토리의 획득 메시지처럼).
--  2026-10-18: 얻은 것은 머리 위에 잠깐 뜨는 글뿐이라 지나가면 다시 볼 수 없었다. 머리 위의 글은 그대로 두고, 여기 줄로도 남긴다.
--  가장 아래가 새 줄. 줄마다 life초 뒤 fade초 동안 흐려져 사라진다. 같은 갈래(경험치 · 달돈 · 달가루)가 merge초 안에 이어 오면
--  새 줄을 만들지 않고 마지막 줄의 수를 더한다(사냥 중에 줄이 넘치지 않게).
--  자리 = 공방 basics.js의 HUD 「획득 알림」(PC: 오른쪽 아래 메뉴 단추 위 · 스마트폰: HUDTOUCH — 왼쪽 위 파티원 칸 아래) · 치수 = ui.js의 UILAYOUT.gainLog
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local UI = require(lune.data["ui.generated"])
local Layout = require(lune.ui.layout)
local Format = require(lune.ui.format)
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR
local L = Layout.GAINLOG

local GainLog = {}
GainLog.lines = {} :: { any } -- { text, color, age, kind, amount } — 앞이 오래된 줄
local box: Frame? = nil
local rows = {} -- 미리 만든 글 칸(아래가 새 줄)
local shown = {} -- 칸마다 지금 적힌 글 · 색(바뀔 때만 다시 그린다)
GainLog.touch = false
GainLog.covered = false

local function rect()
	local r = if GainLog.touch and UI.hudTouch.gainLog then UI.hudTouch.gainLog else UI.hud.gainLog
	return r
end

function GainLog.init(root: Frame)
	local r = UI.hud.gainLog
	box = Stage.place(root, "GainLog", r.at, r.x, r.y, r.w, r.h)
	for i = 1, L.lines do
		rows[i] = Ui.text(box, "", 0, (i - 1) * L.lineH, r.w, { outline = true })
		shown[i] = { text = "", color = nil }
	end
end

-- 스마트폰 단추가 켜졌다 · 꺼졌다: 자리를 옮긴다
function GainLog.setTouch(on: boolean)
	GainLog.touch = on
	if box then
		local r = rect()
		box.Position = Stage.atPosition(r.at, r.x, r.y)
	end
end

-- 오른쪽 창이 그 자리를 덮었다(PC) — 그동안은 감춘다
function GainLog.setCovered(on: boolean)
	GainLog.covered = on
	if box then
		box.Visible = not (on and not GainLog.touch)
	end
end

local MERGE = { xp = "경험치 +%s", money = "달돈 +%s", dust = "달가루 +%s" }
local function textOf(kind: string, amount: number): string
	return MERGE[kind]:format(if kind == "xp" then Format.comma(amount) else Format.short(amount))
end

-- 한 줄을 더한다. kind = xp · money · dust(같은 갈래가 이어 오면 합친다) · 그 밖(item · quest · level · note)은 늘 새 줄
function GainLog.add(kind: string, text: string?, color: any?, amount: number?)
	local last = GainLog.lines[#GainLog.lines]
	if MERGE[kind] then
		if last and last.kind == kind and last.age < L.merge then
			last.amount += amount or 0
			last.text = textOf(kind, last.amount)
			last.age = 0
			return
		end
		text = textOf(kind, amount or 0)
	end
	table.insert(GainLog.lines, { text = text or "", color = color or C.text, age = 0, kind = kind, amount = amount or 0 })
	while #GainLog.lines > L.lines do
		table.remove(GainLog.lines, 1)
	end
end
function GainLog.xp(n: number)
	if n > 0 then
		GainLog.add("xp", nil, C.accent, n)
	end
end
function GainLog.money(n: number)
	if n > 0 then
		GainLog.add("money", nil, C.gold, n)
	end
end
function GainLog.dust(n: number)
	if n > 0 then
		GainLog.add("dust", nil, C.accent, n)
	end
end
function GainLog.item(label: string, color: any?)
	GainLog.add("item", ("획득: %s"):format(label), color or C.text)
end
function GainLog.level(level: number)
	GainLog.add("level", ("레벨 업! Lv.%d"):format(level), C.gold)
end
function GainLog.quest(name: string)
	GainLog.add("quest", ("퀘스트 완료: %s"):format(name), C.gold)
end

-- 0(안 보임) ~ 1 — 줄의 나이로
function GainLog.alphaOf(age: number): number
	if age <= L.life then
		return 1
	end
	return math.max(0, 1 - (age - L.life) / L.fade)
end

-- 줄의 글자들과 처음 투명도(글이 바뀔 때 한 번 모은다 — 매 장면 GetDescendants · 속성을 읽지 않게 · 2026-10-18 검토)
local function glyphsOf(row): { any }
	local list = {}
	local frame = row.label and row.label.Frame
	if frame then
		for _, d in frame:GetDescendants() do
			if d:IsA("ImageLabel") then
				table.insert(list, { d = d, base = d.ImageTransparency })
			end
		end
	end
	return list
end
local function fadeRow(was, a: number)
	-- 흐림이 바뀔 때만 쓴다(다 보이는 동안은 아무것도 쓰지 않는다)
	local q = math.floor(a * 64 + 0.5) / 64
	if was.alpha == q then
		return
	end
	was.alpha = q
	for _, g in was.glyphs or {} do
		g.d.ImageTransparency = g.base + (1 - g.base) * (1 - q)
	end
end

-- 장마다: 줄의 나이를 더하고, 다 흐려진 줄을 지우고, 칸에 다시 적는다(아래 칸부터 새 줄)
function GainLog.step(dt: number)
	for i = #GainLog.lines, 1, -1 do
		local line = GainLog.lines[i]
		line.age += dt
		if GainLog.alphaOf(line.age) <= 0 then
			table.remove(GainLog.lines, i)
		end
	end
	if not box then
		return
	end
	local n = #GainLog.lines
	for i = 1, L.lines do
		local line = GainLog.lines[n - (L.lines - i)] -- 마지막 칸 = 가장 새 줄
		local row, was = rows[i], shown[i]
		local text, color = if line then line.text else "", if line then line.color else nil
		if was.text ~= text then
			row:set(text)
			was.text = text
			was.color = nil
			was.glyphs = glyphsOf(row) -- (새 글의 글자들 — 처음 투명도와 함께)
			was.alpha = nil
		end
		if color and was.color ~= color then
			row:color(color)
			was.color = color
		end
		if line then
			fadeRow(was, GainLog.alphaOf(line.age))
		end
	end
end

function GainLog.clear()
	table.clear(GainLog.lines)
end

return GainLog

end
MODULES['Client/lune/grave'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 비석 — 쓰러진 사람의 자리에 선다(사용자 2026-10-08: "죽으면 비석 세우고, 모달띄워서 마을로 갈거냐고 물어보는 딜레이를 넣읍시다").
--  그림은 사냥터의 놓는 것 가운데 묘비(공방 assetpack/lune의 props — rects.grave)를 그대로 쓴다(새 그림이 아니다).
--  쓰러지는 동작이 끝나면 몸 대신 비석이 위에서 톡 내려와 선다. 캐릭터 · 졸개의 층보다 뒤에 놓는다(놓인 것이 캐릭터를 가리지 않는다 — 장면의 Graves 층).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local data = ReplicatedStorage.shared.lune.data
local SCENES = require(data["scenes.generated"])
local ASSETS = require(data["assets.generated"])
local Stage = require(script.Parent.stage)

local SOURCE = SCENES.scenes.hunt -- 묘비 그림이 든 판
local RECT = SOURCE.rects.grave
local DROP, FROM = 0.18, 14 -- 내려와 서는 시간(초) · 그만큼 위에서(도트)

local Grave = {}

function Grave.new(layer: Instance): ImageLabel
	local label = Stage.image(layer, "Grave", ASSETS[SOURCE.props] or "", RECT.w, RECT.h)
	label.ImageRectOffset = Vector2.new(RECT.x, RECT.y)
	label.ImageRectSize = Vector2.new(RECT.w, RECT.h)
	label.Visible = false
	return label
end

-- (x, y) = 쓰러진 사람의 발밑 가운데 · t = 비석이 서기 시작한 뒤 흐른 시간(초)
function Grave.put(label: ImageLabel, x: number, y: number, t: number)
	local k = math.clamp(t / DROP, 0, 1)
	local up = math.floor(FROM * (1 - k) * (1 - k) + 0.5)
	label.Position = UDim2.fromOffset(math.floor(x + 0.5) - math.floor(RECT.w / 2), math.floor(y + 0.5) - RECT.h - up)
	label.ImageTransparency = 1 - k
	label.Visible = true
end

return Grave

end
MODULES['Client/lune/guide'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 길잡이 — 화면 가운데의 큰 알림 한 줄(「달이 부른다」 · 「2차 전직」)과, 처음 하는 사람에게 지금 누를 키를 알려 주는 안내 한 줄.
--  설계: 공방 js/lune/design/basics.js의 START("처음 쓰는 키는 화면 가운데에 크게 한 번 뜬다") · JOBFLOW("화면 가운데에 '달이 부른다'가 뜬다") · startplan.js의 차례 ②(첫 5분).
--  판 없이, 어두운 테두리를 두른 글씨를 화면 위쪽 가운데에 적는다(보스 체력 칸 아래 — 다른 늘 보이는 것과 겹치지 않는 자리). 글은 폭을 넘지 않는다(안내는 두 줄까지).
--  안내 글은 캐릭터의 지금 상태에서 그때그때 셈한다(Guide.pick) — 무엇을 봤는지 따로 저장하지 않는다: 할 일을 하면 그 안내는 저절로 사라지고, 레벨이 오르면 더 뜨지 않는다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local GuideText = require(lune.ui.guideText)
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR

local Guide = {}
Guide.HINT_W, Guide.HINT_LINES = GuideText.W, GuideText.LINES -- 안내 글의 칸(자동 검사가 글이 이 안에 들어가는지 본다)
Guide.BANNER_W = 480
Guide.HINT_Y, Guide.BANNER_Y = 50, 86 -- 화면 틀의 기준 격자(960x540)에서의 높이 — 캐릭터 머리 위로 뜨는 글(「완료」 · 「레벨 업!」)보다 위

local hintBox: Frame, bannerBox: Frame
local hint, title, sub
local hintNow = ""
local bannerLeft = 0
local queue = {} -- 기다리는 큰 알림들 { head, line, seconds }(앞의 것이 사라지면 차례로 뜬다)
Guide.QUEUE_MAX = 4

function Guide.init(root: Frame)
	hintBox = Stage.place(root, "GuideHint", "tc", (Stage.REF_W - Guide.HINT_W) / 2, Guide.HINT_Y, Guide.HINT_W, 40)
	hint = Ui.text(hintBox, "", 0, 0, Guide.HINT_W, { align = "center", outline = true, color = C.accent, lines = Guide.HINT_LINES, line = Ui.M.small + 4 })
	hintBox.Visible = false
	bannerBox = Stage.place(root, "GuideBanner", "tc", (Stage.REF_W - Guide.BANNER_W) / 2, Guide.BANNER_Y, Guide.BANNER_W, 44)
	title = Ui.text(bannerBox, "", 0, 0, Guide.BANNER_W, { font = "body", align = "center", outline = true, color = C.gold })
	sub = Ui.text(bannerBox, "", 0, Ui.M.body + 8, Guide.BANNER_W, { align = "center", outline = true, color = C.text })
	bannerBox.Visible = false
end

-- 안내 한 줄(없으면 nil · 빈 글)
function Guide.setHint(text: string?)
	local value = text or ""
	if value ~= hintNow then
		hintNow = value
		hint:set(value)
	end
	hintBox.Visible = value ~= ""
end

-- 큰 알림: 제목(노랑) + 한 줄. seconds 뒤에 사라진다
--  앞의 알림이 아직 떠 있으면 그 뒤에 줄을 세운다(덮어쓰지 않는다 — 같은 순간에 둘이 오면 뒤의 것만 보였다). 같은 제목이 이미 떠 있거나 기다리는 중이면 다시 넣지 않는다
local function show(head: string, line: string?, seconds: number?)
	title:set(head)
	sub:set(line or "")
	bannerLeft = seconds or 4
	bannerBox.Visible = true
	Guide.now = head
end
function Guide.banner(head: string, line: string?, seconds: number?)
	if bannerLeft > 0 then
		if Guide.now == head then
			show(head, line, seconds) -- 같은 알림이 다시 왔다: 글과 시간을 새로
			return
		end
		for _, q in queue do
			if q[1] == head then
				return
			end
		end
		if #queue < Guide.QUEUE_MAX then
			table.insert(queue, { head, line, seconds })
		end
		return
	end
	show(head, line, seconds)
end

function Guide.step(dt: number)
	if bannerLeft > 0 then
		bannerLeft -= dt
		if bannerLeft <= 0 then
			bannerBox.Visible = false
			Guide.now = nil
			local nextOne = table.remove(queue, 1)
			if nextOne then
				show(nextOne[1], nextOne[2], nextOne[3])
			end
		end
	end
end

function Guide.clear()
	table.clear(queue)
	Guide.now = nil
	bannerLeft = 0
	bannerBox.Visible = false
	Guide.setHint(nil)
end

-- 지금 띄울 안내를 고른다(셈은 shared/lune/ui/guideText.luau)
Guide.pick = GuideText.pick

return Guide

end
MODULES['Client/lune/hallStones'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 명예의 전당의 비석에 새긴 순위(2026-10-15).
--  사용자: "명예의 전당이 상호작용해서 나오는 방식인데 그게 아니고 그냥 비석그림위에 비석에 새겨진것처럼 보여야합니다."
--  → 비석 앞에서 ↑로 창을 여는 것을 없애고(공방 items.js의 NPCDO에서 뺐다), 비석 면(scenes.generated의 npcs[].face — 방 그림에서 잰 도트)에
--    순위 · 이름 · 값을 돌에 판 글처럼 그린다: 어두운 글 + 한 점 아래의 밝은 테두리(새긴 홈에 빛이 걸린 모양). 들어설 때 서버에서 받고(Net "Rank") 30초마다 다시 받는다.
--  줄 수 = 비석 면의 높이에 들어가는 만큼(가장 많이 Rank.TOP). 이름은 폭을 넘으면 …로 줄인다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Net = require(lune.net.net)
local Rank = require(lune.sim.rank)
local Stage = require(script.Parent.stage)
local Overlay = require(script.Parent.overlay)
local Ui = require(script.Parent.ui.ui)

local M = Ui.M
local INK = Color3.fromRGB(46, 54, 66) -- 판 홈의 그늘(비석 면 #697b90보다 어둡게)
local LIGHT = Color3.fromRGB(150, 166, 184) -- 홈 아래쪽 가장자리에 걸린 빛
local PAD = 3 -- 비석 면 안쪽 여백(화면 틀의 점)
local REFRESH = 30 -- 다시 받는 사이(초)

local HallStones = {}
HallStones.fetch = function()
	return Net.Invoke("Rank")
end

local layer: Frame? = nil
local stones = {} -- { board, face, rows = { { no, name, value } } }
local boards = nil
local nextFetch = 0
local placedKey = ""
local gen = 0

local function engraved(parent: Instance, align: string?, width: number)
	local t = Ui.text(parent, "", 0, 0, width, { color = INK, align = align or "left" })
	if t.label.SetShadow then
		t.label:SetShadow(LIGHT)
	end
	return t
end

-- 그 장면에 들어섰다: 비석 면이 있는 비석마다 글을 만든다(없으면 아무것도 하지 않는다)
function HallStones.enter(scene, parent: Instance)
	HallStones.leave()
	local list = {}
	for _, n in scene.npcs or {} do
		if n.stone and typeof(n.face) == "table" then
			table.insert(list, n)
		end
	end
	if #list == 0 then
		return
	end
	gen += 1
	layer = Stage.group(parent, "HallStones", 5)
	for _, n in list do
		local st = { board = string.match(n.id, "^hall_(%a+)$") or "level", face = n.face, rows = {} }
		for i = 1, Rank.TOP do
			st.rows[i] = { no = engraved(layer, "right", 14), name = engraved(layer, "left", 120), value = engraved(layer, "right", 60) }
		end
		table.insert(stones, st)
	end
	boards, nextFetch, placedKey = nil, 0, ""
end

function HallStones.leave()
	gen += 1
	if layer then
		layer:Destroy()
		layer = nil
	end
	stones = {}
	boards = nil
end

-- 매 화면: 때가 되면 순위를 받고, 화면 틀이 바뀌었으면 다시 놓는다
function HallStones.update()
	if not layer then
		return
	end
	local now = os.clock()
	if now >= nextFetch then
		nextFetch = now + REFRESH
		local my = gen
		task.spawn(function()
			local ok, got = pcall(HallStones.fetch)
			if ok and got and my == gen then
				boards = got
				placedKey = "" -- 글을 다시 적는다
			end
		end)
	end
	local key = ("%d:%d:%d:%d:%s"):format(Stage.uiW, Stage.uiH, Overlay.camX, Overlay.camY, tostring(boards ~= nil))
	if key == placedKey then
		return
	end
	placedKey = key
	for _, st in stones do
		-- face = 방 그림의 자리(실내의 방 그림은 화면에 붙은 층이다 — 카메라를 따라가지 않는다): 화면의 점 = 그림의 점. 세계의 자리로 바꾸려면 카메라를 더한다
		local cx, cy = Overlay.camX, Overlay.camY
		local x0, y0 = Overlay.x(st.face[1] + cx) + PAD, Overlay.y(st.face[2] + cy) + PAD + 1
		local x1, y1 = Overlay.x(st.face[3] + 1 + cx) - PAD, Overlay.y(st.face[4] + 1 + cy) - PAD
		local w = x1 - x0
		local fit = math.clamp(math.floor((y1 - y0) / M.smallLine), 0, Rank.TOP) -- 면에 들어가는 줄
		local list = boards and boards[st.board] or {}
		local valueW = 0
		for i = 1, fit do
			local it = list[i]
			if it then
				valueW = math.max(valueW, Ui.measure(it.value))
			end
		end
		for i, row in st.rows do
			local it = list[i]
			local on = i <= fit and it ~= nil
			row.no:show(on)
			row.name:show(on)
			row.value:show(on)
			if on then
				local y = y0 + (i - 1) * M.smallLine
				row.no:set(tostring(i))
				row.no:move(x0 - 2, y)
				row.value:set(it.value)
				row.value.width = valueW
				row.value:move(x1 - valueW, y)
				local nameX = x0 + 15
				local nameW = math.max(10, w - 15 - valueW - 4)
				row.name.label:SetMaxWidth(nameW, 1)
				row.name.width = nameW
				row.name:set(it.name)
				row.name:move(nameX, y)
			end
		end
	end
end

return HallStones

end
MODULES['Client/lune/hud'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 늘 보이는 화면(HUD) — 왼쪽 아래의 한 덩어리(레벨 · 이름 · 체력 바 · 경험치 줄) · 가운데 아래의 스킬 칸(물약 + 기술) · 오른쪽 아래의 창을 여는 단추.
--  산나비 계열 도트 게임의 방식(사용자 2026-10-07 "훌룡합니다. 하지만 글씨비율은 좀더 작아야합니다. 그리고 미니맵은 없애세요"):
--   늘 보이는 것은 구석에 작게, 판 없이 — 글은 어두운 테두리를 두른 작은 글씨로 게임 화면 위에 바로 적는다. 미니맵은 없다.
--  아직 없는 칸: 보스 체력(L6) · 버프와 직업 게이지(L7) — 쓸 때가 되면 생긴다(공방의 화면 규칙).
--  자리는 공방 「기본 · UI」 탭의 화면 배치(data/ui.generated.luau — 기준 격자 960x540과 붙는 구석)를 그대로 쓰고, 모양은 화면 틀의 부품(ui/ui.luau)이다.
--  글씨는 제 칸을 넘지 않게 폭을 준다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local UI = require(lune.data["ui.generated"])
local Format = require(lune.ui.format)
local Layout = require(lune.ui.layout) -- 치수는 한데 모아 둔 것을 쓴다(자동 검사가 같은 값을 본다)
local Quick = require(lune.ui.quick) -- 퀵슬롯의 셈(칸 수 · 놓는 법)
local RunService = game:GetService("RunService")
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR
local M = Ui.M
local V, K, MN = Layout.VITALS, Layout.SKILLS, Layout.MENU
local HpFx = require(lune.ui.hpFx) -- 체력이 닳고 찰 때의 효과(셈)
local SLOT = K.slot -- 스킬 칸 한 변
local KEY_UP = K.keyUp -- 칸 위의 키 딱지가 차지하는 높이
local COLS, ROWS = K.cols, K.rows -- 스킬 칸: 두 줄 x 여섯
local PIC = M.pic
-- 설명 판(버프 · 경험치 · 퀵슬롯의 설명 — 2026-10-18): 능력치의 설명과 같은 판의 치수 · 제목의 색. 판을 짓는 함수들보다 위에 둔다(퀵슬롯의 설명이 먼저 쓴다)
local TIP = Layout.STAT.tip
local TIPCOLOR = { main = C.gold, sub = C.accent, none = C.dim }
-- 손가락으로 누른 것인가(폰에서는 누를 때도 MouseEnter가 오고 MouseLeave는 오지 않는다 — 그때는 Activated로만 열고 닫는다)
local UIS = game:GetService("UserInputService")
local function touching(): boolean
	return UIS:GetLastInputType() == Enum.UserInputType.Touch
end
-- 메뉴 단추의 그림(창의 이름표 → 그림)
local MENU_PIC = { bag = "menu_bag", equip = "menu_equip", stat = "menu_stat", skill = "menu_skill", quest = "menu_quest", map = "menu_map", auction = "menu_auction", party = "menu_party", more = "menu_gear" }

local Hud = {}
Hud.COLS, Hud.ROWS = COLS, ROWS
Hud.MENU_MAX = MN.max -- 메뉴 단추는 여덟까지 놓인다(나머지는 「메뉴」 단추 안에)

-- 왼쪽 아래 덩어리 안의 자리(shared/lune/ui/layout.luau의 VITALS): 윗줄에 레벨 · 이름, 그 아래 체력 바(숫자는 바 안), 가는 경험치 줄과 %
function Hud.layout()
	local v = UI.hud.vitals
	return { nameY = V.nameY, hpY = V.hpY, hpTextW = V.barW - V.hpPad * 2, xpY = V.xpY, xpTextX = V.barW + V.xpGap, xpTextW = v.w - V.barW - V.xpGap }
end

function Hud.init()
	local root = Stage.group(Stage.ui, "Hud", 100)
	Hud.root = root

	-- 왼쪽 아래 덩어리: 레벨(노랑) · 이름 / 체력 바 — 숫자는 바 안에 / 가는 경험치 줄과 그 옆의 %
	local v = UI.hud.vitals
	local L = Hud.layout()
	local box = Stage.placeRect(root, "Vitals", v)
	Hud.vitalsBox = box
	Hud.level = Ui.text(box, "Lv.1", 0, L.nameY, 60, { color = C.gold, outline = true })
	Hud.name = Ui.text(box, "", 40, L.nameY, v.w - 40, { outline = true })
	Hud.hp = Ui.bar(box, 0, L.hpY, V.barW, V.hpH, C.hp, C.hpDark)
	-- 체력이 닳고 찰 때의 효과(사용자 2026-10-13: "체력 다는거나  회복되는게 잘 보이지않습니다. 효과가 좀 들어가야해요"):
	--  띠 안에 닳은 자리(밝은 색) · 찬 자리(풀빛)를 빨간 띠 아래에 깔고, 번쩍임을 맨 위에 덮는다. 띠 오른쪽 위에 「-23 · +60」이 떠오른다. 셈은 shared/lune/ui/hpFx.luau, 장마다 Hud.step이 그린다
	do
		local F = HpFx.F
		local function hex(h: string): Color3
			return Color3.fromRGB(tonumber(h:sub(2, 3), 16) :: number, tonumber(h:sub(4, 5), 16) :: number, tonumber(h:sub(6, 7), 16) :: number)
		end
		Hud.hpIn = { w = V.barW - 2, h = V.hpH - 2 }
		Hud.hpLag = Ui.box(Hud.hp.frame, 1, 1, 0, Hud.hpIn.h, hex(F.lagColor))
		Hud.hpLag.Name = "Lag"
		Hud.hpGain = Ui.box(Hud.hp.frame, 1, 1, 0, Hud.hpIn.h, hex(F.gainColor))
		Hud.hpGain.Name = "Gain"
		Hud.hp.fill.ZIndex = 2 -- 빨간 띠는 그 둘 위에
		Hud.hpLag.ZIndex, Hud.hpGain.ZIndex = 1, 1
		Hud.hpFlash = Ui.box(Hud.hp.frame, 1, 1, Hud.hpIn.w, Hud.hpIn.h, Color3.new(1, 1, 1))
		Hud.hpFlash.Name = "Flash"
		Hud.hpFlash.ZIndex = 3
		Hud.hpFlash.BackgroundTransparency = 1
		Hud.hpFlashHeal = hex(F.gainColor)
		Hud.hpDelta = Ui.text(box, "", 0, L.hpY - M.small - 1, V.barW, { align = "right", outline = true })
		Hud.hpFx = HpFx.new()
	end
	Hud.hpText = Ui.text(box, "", V.hpPad, L.hpY + math.floor((V.hpH - M.small) / 2), L.hpTextW, { align = "center" })
	Hud.hpText.label.Frame.ZIndex = 6
	Hud.hpTextWidth = L.hpTextW
	Hud.xp = Ui.bar(box, 0, L.xpY, V.barW, V.xpH, C.accent)
	Hud.xp.frame.Name = "Xp"
	Hud.xpText = Ui.text(box, "0.00%", L.xpTextX, L.xpY - 3, L.xpTextW, { color = C.dim, outline = true })
	-- 경험치 줄의 설명(2026-10-18 — 공방 ui.js XPTIP): 줄(과 그 옆의 %)에 마우스를 올리면(폰은 톡 — 한 번 더 톡 하면 닫힘) 덩어리 위에 지금 · 필요한 경험치와 남은 것
	local xpOver = Instance.new("TextButton")
	xpOver.Name = "XpOver"
	xpOver.Text = ""
	xpOver.BackgroundTransparency = 1
	xpOver.Position = UDim2.fromOffset(0, L.xpY - 5)
	xpOver.Size = UDim2.fromOffset(UI.hud.vitals.w, V.xpH + 10)
	xpOver.ZIndex = 8
	xpOver.Parent = box
	xpOver.MouseEnter:Connect(function()
		if not touching() then -- 손가락은 Activated로만(누를 때도 MouseEnter가 온다)
			Hud.showXpTip(box)
		end
	end)
	xpOver.MouseLeave:Connect(function()
		if not touching() then
			Hud.hideXpTip()
		end
	end)
	xpOver.Activated:Connect(function(input)
		if input and input.UserInputType == Enum.UserInputType.Touch and Hud.xpTip then
			Hud.hideXpTip()
		else
			Hud.showXpTip(box)
		end
	end)

	-- 스킬 칸: 어두운 칸에 그림 · 개수(오른쪽 아래) · 다시 쓰기까지 남은 시간(어두운 덮개와 초). 키 이름은 칸 위의 딱지에 적는다(그림을 가리지 않게).
	--  퀵슬롯이다: 칸마다 키가 하나 붙어 있고, 물약 · 스킬을 칸에 놓아 쓴다(아래의 「퀵슬롯」)
	local s = UI.hud.skills
	Hud.skillRoot = Stage.placeRect(root, "Skills", s)
	Hud.slots = {}
	for i = 1, COLS * ROWS do
		local cell = Ui.slot(Hud.skillRoot, 0, 0, SLOT)
		cell.frame.Name = "Slot" .. i
		local pad = math.floor((SLOT - PIC) / 2)
		local pic = Ui.pic(cell.frame, nil, pad, pad)
		local veil = Ui.box(cell.frame, pad, pad, PIC, PIC, C.ink, 0.35)
		veil.Name = "Veil"
		veil.ZIndex = 3
		veil.Visible = false
		-- 다시 쓰기가 끝난 순간 그림이 한 번 하얗게 번쩍인다(2026-10-18 — 시험 탭의 sk.flash와 같다 · Hud.step이 흐리게 한다)
		local ready = Ui.box(cell.frame, pad, pad, PIC, PIC, Color3.new(1, 1, 1), 1)
		ready.Name = "Ready"
		ready.ZIndex = 4
		ready.Visible = false
		local slot = { frame = cell.frame, cell = cell, back = cell.frame:FindFirstChild("uSlot") :: ImageLabel, pic = pic, veil = veil, ready = ready, readyT = 0, pad = pad, what = false :: any, id = nil :: string?, shown = nil :: string?, keyName = "" }
		-- 퀵슬롯은 자리가 늘 같다(여섯 x 두 줄 — 칸마다 키 하나)
		local px, py = Layout.slotPlace(i, COLS * ROWS)
		cell.frame.Position = UDim2.fromOffset(px, py)
		-- 누르는 자리: 칸과 그 위의 키 딱지까지. 스킬 창이 열려 있을 때 칸을 누르거나 끌어 고친다(ui/quickEdit.luau가 받는다)
		local hit = Instance.new("TextButton")
		hit.Name = "Hit"
		hit.Text = ""
		hit.BackgroundTransparency = 1
		hit.Position = UDim2.fromOffset(0, -KEY_UP)
		hit.Size = UDim2.fromOffset(SLOT, SLOT + KEY_UP)
		hit.ZIndex = 9
		hit.Parent = cell.frame
		hit.Activated:Connect(function()
			if Hud.onSlotClick then
				Hud.onSlotClick(i)
			end
		end)
		hit.InputBegan:Connect(function(input)
			if Hud.onSlotPress then
				Hud.onSlotPress(i, input)
			end
		end)
		-- 칸의 설명(2026-10-18 — 메이플처럼 · PC): 마우스를 올리면 칸 위에 그 스킬 · 물건의 이름 · 효과(스킬 창을 열어 고치는 중이거나 끄는 중에는 띄우지 않는다)
		hit.MouseEnter:Connect(function()
			if not touching() then
				Hud.showSlotTip(i)
			end
		end)
		hit.MouseLeave:Connect(function()
			if Hud.slotTipAt == i then
				Hud.hideSlotTip()
			end
		end)
		slot.key = Ui.keycap(cell.frame, "", math.floor(SLOT / 2), -KEY_UP)
		slot.count = Ui.text(cell.frame, "", 0, SLOT - 11, SLOT - 2, { align = "right", outline = true, z = 6 })
		slot.wait = Ui.text(cell.frame, "", 0, math.floor((SLOT - M.small) / 2), SLOT, { align = "center", outline = true, z = 7 })
		table.insert(Hud.slots, slot)
	end
	Hud.byId = {} -- [기술 id] = 칸
	-- 놓을 스킬을 골랐을 때 칸들 위에 뜨는 안내
	Hud.pickHint = Ui.text(Hud.skillRoot, Quick.DATA.words.pick, 0, -16, s.w, { align = "center", color = C.accent, outline = true })
	Hud.pickHint:show(false)

	Hud.menuRoot = Stage.placeRect(root, "Menu", UI.hud.menu)
	-- 화면 틀의 격자가 바뀌면 단추의 간격도 바뀐다(가장 작은 격자에서는 스킬 칸에 닿지 않게 촘촘하다)
	Stage.onResize(Hud.placeMenu)
	-- 버프 자리(오른쪽 위): 켜 둔 사출기 · 직업의 장치(영혼 · 열기 · 수정)가 그림으로, 그 아래에 수(공방 「기본 · UI」 탭의 3번 칸)
	Hud.buffRoot = Stage.placeRect(root, "Buffs", UI.hud.buffs)
	Hud.buffs = {}
	return Hud
end

-- 쓰는 칸이 n개일 때 i째 칸의 자리(스킬 칸 틀 안): 여섯까지는 아랫줄에 가운데로 모으고, 일곱째부터는 윗줄에 같은 식으로.
--  줄마다 위에 키 딱지의 자리(KEY_UP)를 둔다
Hud.KEY_UP = KEY_UP
Hud.slotPlace = Layout.slotPlace

-- ---------- 퀵슬롯 ----------  사용자 2026-10-07: "스킬키를 단축키에 등록하기 쉬워야합니다 … 중앙에 있는 퀵슬롯이랑 스킬 배치랑 쉽게 되어야해요"
--  키는 칸에 붙는다(칸마다 하나). 열두 칸(두 줄)이 늘 보이고 빈 칸은 흐리다(사용자 2026-10-07: "키 위에 edrf12 이 라인도 평소에 보여야합니다").
--  공방의 횡스크롤 시험 탭(js/lune/ui/paint.js의 paintHud)과 같은 그림이다.
Hud.touchSlotAt = nil :: ((Vector2) -> number?)? -- 스마트폰의 칸 단추: 그 자리의 칸 · 고르는 중 · 끌어 올린 칸(touch.luau가 채운다)
Hud.touchPick = nil :: ((boolean) -> ())?
Hud.touchHot = nil :: ((number?) -> ())?
Hud.countOf = nil :: ((string) -> number)? -- 가방에 든 그 소비 아이템의 수(boot.luau가 넣는다 — 칸의 숫자)
Hud.onSlotClick = nil :: ((number) -> ())? -- 칸을 눌렀다
Hud.onSlotPress = nil :: ((number, InputObject) -> ())? -- 칸을 누르기 시작했다(끌기)
Hud.edit, Hud.pick, Hud.pulse, Hud.hot, Hud.top = false, false, false, nil :: number?, false
Hud.active = {} :: { [string]: boolean } -- 켜 둔 것(온오프 사출기): 그 칸에 민트 테두리가 켜진다

-- 칸들의 모습을 다시 그린다: 보이는 줄 · 빈 칸의 흐림 · 반짝임(놓을 스킬을 골랐을 때) · 마우스가 올라간 칸
function Hud.paintSlots()
	for i, slot in Hud.slots do
		slot.frame.Visible = true
		local on = (Hud.pick and Hud.pulse) or Hud.hot == i or (slot.what ~= false and Hud.active[slot.what] == true)
		slot.cell:setOn(on)
		slot.back.ImageTransparency = if slot.what or on then 0 else 1 - Quick.DATA.emptyAlpha
		slot.key:color(if slot.what then C.text else C.dim)
	end
	Hud.pickHint:show(Hud.pick)
end

-- 가방이 바뀌었다: 소비 아이템이 놓인 칸의 숫자를 다시 적는다(다 쓰면 0 — 칸에는 남는다)
function Hud.setCounts()
	for _, slot in Hud.slots do
		if slot.item then
			local n = if Hud.countOf then Hud.countOf(slot.item) else 0
			slot.count:set(tostring(n))
			slot.count:color(if n == 0 then C.red else C.text) -- 다 쓴 소비 아이템은 붉은 0(2026-10-18)
		end
	end
end

-- 칸마다 놓인 것을 그린다. list[i] = { what = 스킬 · 소비 아이템의 이름표 · false, key = 그 칸의 키 이름 }
function Hud.setSlots(list)
	table.clear(Hud.byId)
	Hud.top = false
	for i, slot in Hud.slots do
		local it = list[i]
		local what = if it then it.what or false else false
		slot.what = what
		local goods = if what then Quick.item(what) else nil
		slot.id = if what and not goods then what else nil -- 스킬(다시 쓰기까지의 시간이 덮인다)
		slot.item = if goods then what else nil -- 소비 아이템(가방에 든 수가 적힌다)
		slot.keyName = if it then Format.keyShort(it.key) else ""
		Ui.setPic(slot.pic, if what then Quick.pic(what) else nil)
		slot.key:set(slot.keyName)
		slot.veil.Visible = false
		slot.wait:set("")
		slot.shown = nil
		local n = if slot.item and Hud.countOf then Hud.countOf(slot.item) else 0
		slot.count:set(if slot.item then tostring(n) else "")
		slot.count:color(if slot.item and n == 0 then C.red else C.text)
		if slot.id then
			Hud.byId[slot.id] = slot
		end
		if i > COLS and what then
			Hud.top = true
		end
	end
	Hud.paintSlots()
end

-- ---------- 칸의 설명(2026-10-18) ----------  글은 boot가 짓는다(Hud.slotTipOf(what) → { kind, title, tag, lines } · 없으면 띄우지 않는다)
Hud.slotTipOf = nil :: ((string) -> any)?
Hud.slotTipAt = nil :: number?
local slotTip: Frame? = nil
function Hud.hideSlotTip()
	if slotTip then
		slotTip:Destroy()
		slotTip = nil
	end
	Hud.slotTipAt = nil
end
function Hud.showSlotTip(i: number)
	Hud.hideSlotTip()
	local slot = Hud.slots[i]
	if not slot or not slot.what or Hud.edit or Hud.pick or Hud.touch or not Hud.slotTipOf then
		return
	end
	local t = Hud.slotTipOf(slot.what)
	if not t then
		return
	end
	local frame, h = Hud.tipPanel(Hud.skillRoot, t, "SlotTip")
	local px = Layout.slotPlace(i, COLS * ROWS)
	local w = UI.hud.skills.w
	frame.Position = UDim2.fromOffset(math.clamp(px + math.floor(SLOT / 2) - math.floor(TIP.w / 2), math.min(0, w - TIP.w), math.max(0, w - TIP.w)), -h - 4) -- 퀵슬롯 덩어리 위에(위 칸을 가리지 않게)
	slotTip = frame
	Hud.slotTipAt = i
end

-- 그 칸의 키 이름(딱지에 적힌 것)
function Hud.slotKey(i: number): string
	return Hud.slots[i].keyName
end

-- 고치는 중인가(스킬 창이 열려 있다): 윗줄까지 다 보인다
function Hud.setEdit(on: boolean)
	Hud.edit = on
	Hud.paintSlots()
end

-- 놓을 스킬을 골랐다 · 끌고 있다: 칸들이 반짝인다
local pulseConn: RBXScriptConnection? = nil
function Hud.setPick(on: boolean)
	if Hud.pick == on then
		return
	end
	Hud.pick = on
	if Hud.touchPick then
		Hud.touchPick(on) -- 스마트폰: 칸 단추들이 밝아진다(touch.luau)
	end
	if pulseConn then
		pulseConn:Disconnect()
		pulseConn = nil
	end
	if on then
		local half = Quick.DATA.blink / 2
		Hud.pulse = true
		pulseConn = RunService.Heartbeat:Connect(function()
			local now = math.floor(os.clock() / half) % 2 == 0
			if now ~= Hud.pulse then
				Hud.pulse = now
				Hud.paintSlots()
			end
		end)
	end
	Hud.paintSlots()
end

-- 마우스가 올라간 칸(끌고 있을 때)
function Hud.setHot(i: number?)
	if Hud.hot ~= i then
		Hud.hot = i
		if Hud.touchHot then
			Hud.touchHot(i)
		end
		Hud.paintSlots()
	end
end

-- 화면의 그 자리(입력의 자리)에 있는 칸. 키 딱지까지 그 칸으로 친다
function Hud.slotAt(at: Vector2): number?
	if Hud.touch and Hud.touchSlotAt then
		return Hud.touchSlotAt(at) -- 스마트폰: 화면의 칸 단추가 PC의 칸과 같은 것이다(touch.luau)
	end
	for i, slot in Hud.slots do
		if slot.frame.Visible and Hud.skillRoot.Visible then
			local p, size = slot.frame.AbsolutePosition, slot.frame.AbsoluteSize
			local up = size.Y * KEY_UP / SLOT
			if at.X >= p.X and at.X < p.X + size.X and at.Y >= p.Y - up and at.Y < p.Y + size.Y then
				return i
			end
		end
	end
	return nil
end

-- 기술을 다시 쓰기까지 남은 시간(초). total = 그 기술의 다시 쓰기 시간. 화면마다 불러도 된다(바뀔 때만 고쳐 그린다)
function Hud.setCooldown(id: string, remain: number, total: number)
	local slot = Hud.byId[id]
	if not slot then
		return
	end
	local rows = if remain > 0 and total > 0 then math.clamp(math.ceil(PIC * remain / total), 1, PIC) else 0
	local text = if remain >= 1 then tostring(math.ceil(remain)) else ""
	local key = rows .. ":" .. text
	if slot.shown == key then
		return
	end
	if slot.veil.Visible and rows == 0 then
		slot.readyT = Hud.READY_T -- 다시 쓰기가 끝났다: 한 번 하얗게
	end
	slot.shown = key
	slot.veil.Visible = rows > 0
	slot.veil.Position = UDim2.fromOffset(slot.pad, slot.pad + (PIC - rows))
	slot.veil.Size = UDim2.fromOffset(PIC, rows)
	slot.wait:set(text)
end

-- 메뉴 단추: 창마다 그림 단추 하나, 그 아래에 이름(그림만으로는 무엇을 여는지 모른다 — 사용자 2026-10-07 "무슨기능인지 인지가 하나도안됩니다").
-- 메뉴 단추들을 지금의 격자에 맞는 간격으로 놓는다
function Hud.placeMenu()
	for _, item in Hud.menu or {} do
		item.frame.Position = UDim2.fromOffset(Layout.menuX(item.i, item.n, Stage.uiW), 0)
	end
end

--  누르면 그 창이 열린다. list = { { id, name, key } … } — 여덟까지, 오른쪽 끝에 붙여 놓는다
function Hud.setMenu(list, onClick: (string) -> ())
	for _, old in Hud.menu or {} do
		old.frame:Destroy()
	end
	Hud.menu = {}
	local r = UI.hud.menu
	local n = math.min(#list, Hud.MENU_MAX)
	local s = MN.slot
	for i, item in list do
		if i > Hud.MENU_MAX then
			break -- 칸을 넘는 것은 그리지 않는다
		end
		local frame = Ui.group(Hud.menuRoot, Layout.menuX(i, n, Stage.uiW), 0, s, r.h, "Menu_" .. item.id)
		local cell = Ui.slot(frame, 0, 0, s)
		Ui.pic(cell.frame, MENU_PIC[item.id] or "menu_gear", math.floor((s - PIC) / 2), math.floor((s - PIC) / 2))
		-- 이름은 칸보다 넓을 수 있다(「퀘스트」) — 칸의 가운데에 맞춰 옆 칸과의 사이까지 쓴다
		local label = Ui.text(frame, Layout.menuLabel(item.id, item.name), -math.floor((MN.labelW - s) / 2), MN.labelY, MN.labelW, { align = "center", outline = true })
		-- 눈에 띄게 하는 표시: 오른쪽 위의 노란 점(찍을 점수가 남았다) · 반짝임(새로 생겼다)
		local dot = Ui.box(frame, s - 5, -1, 6, 6, C.ink)
		Ui.box(dot, 1, 1, 4, 4, C.gold)
		dot.ZIndex = 7
		dot.Visible = false
		local flash = Ui.box(frame, 1, 1, s - 2, s - 2, C.text, 0.4)
		flash.ZIndex = 8
		flash.Visible = false
		local hit = Ui.hit(frame)
		hit.Activated:Connect(function()
			onClick(item.id)
		end)
		frame.Visible = not Hud.touch
		Hud.menu[item.id] = { frame = frame, cell = cell, label = label, dot = dot, flash = flash, mark = false, i = i, n = n }
	end
	Hud.setOpen(Hud.openSet or {})
	for id, on in Hud.marks do -- 단추를 다시 지어도 점은 그대로(가방이 가득 찼다 · 찍을 점수 … — 2026-10-18)
		Hud.markMenu(id, on)
	end
end

-- 열려 있는 창의 단추는 민트(테두리와 이름). set = { [창 id] = true }
function Hud.setOpen(set)
	Hud.openSet = set
	for id, item in Hud.menu or {} do
		local on = set[id] == true
		item.cell:setOn(on)
		item.label:color(if on then C.accent else C.text)
	end
end

-- 켜 둔 것(온오프 사출기)의 이름표들: 그 칸에 테두리가 켜진다
function Hud.setActive(ids: { [string]: boolean })
	Hud.active = ids
	Hud.paintSlots()
end

-- 버프 자리를 그린다. list = { { pic = 그림(화면의 24도트 그림 이름), text = 그림 아래의 글(수 · 없으면 ""), hot = 밝게(달아오름) } … } — 오른쪽 끝부터 왼쪽으로 놓는다
local BUFF_PITCH = PIC + 6
-- ---------- 버프 그림의 설명(2026-10-18 — 공방 ui.js BUFFTIP · 시험 탭의 buffTipOf) ----------
--  그림에 마우스를 올리면(폰은 톡 — 한 번 더 톡 하면 닫힌다) 버프 줄 아래에 능력치의 설명과 같은 판이 뜬다. 글은 boot의 paintBuffs가 칸마다 지어 준다(b.tip = { kind, title, tag, lines }).
--  1초마다 칸을 다시 지어도 보던 칸의 설명은 이어서 뜬다(남은 시간이 바뀐다) — 마우스가 그 칸을 벗어났으면 닫는다
local TIP_DOWN = 31 -- 판의 윗줄(버프 줄의 위에서 — 그림 밑의 남은 시간을 가리지 않게)
Hud.buffList = {}
Hud.tipAt = nil :: number? -- 설명이 떠 있는 칸의 차례
local tipFrame: Frame? = nil
local tipTouch = false -- 손가락으로 연 설명(마우스의 자리로 닫지 않는다)

function Hud.hideBuffTip()
	if tipFrame then
		tipFrame:Destroy()
		tipFrame = nil
	end
	Hud.tipAt = nil
end

-- 설명 판 하나를 parent에 짓는다(능력치의 설명과 같은 판): t = { kind, title, tag, lines }. 돌려주는 것 = 판 · 높이(자리는 부른 쪽이 놓는다)
function Hud.tipPanel(parent: Instance, t, name: string): (Frame, number)
	local color = TIPCOLOR[t.kind] or C.accent
	local inner = TIP.w - TIP.pad * 2
	local frame = Ui.group(parent, 0, 0, TIP.w, 10, name)
	frame.ZIndex = 20
	local back = Ui.part(frame, "uTip", 0, 0, TIP.w, 10)
	local title = Ui.text(frame, t.title, TIP.pad, TIP.pad, inner, { font = "body", color = color })
	if t.tag and t.tag ~= "" then
		local tw = title:size()
		Ui.text(frame, t.tag, TIP.pad + tw + 8, TIP.pad + 2, inner - tw - 8, { color = color })
	end
	local y = TIP.pad + TIP.title
	for k, line in t.lines do
		if line ~= "" then
			local tint = if k > 1 then (if t.kind == "none" then C.dim else C.accent) elseif t.kind == "none" then C.red else C.text
			local label = Ui.text(frame, line, TIP.pad, y, inner, { lines = TIP.lines, line = TIP.line, color = tint })
			local _, lh = label:size()
			y += math.max(1, math.floor(lh / TIP.line + 0.5)) * TIP.line
		end
	end
	local h = y - (TIP.line - M.small) + TIP.pad
	frame.Size = UDim2.fromOffset(TIP.w, h)
	back.Size = UDim2.fromOffset(TIP.w, h)
	return frame, h
end

function Hud.showBuffTip(i: number)
	if tipFrame then
		tipFrame:Destroy()
		tipFrame = nil
	end
	local b = Hud.buffList[i]
	if not b or not b.tip then
		Hud.tipAt = nil
		return
	end
	Hud.tipAt = i
	local frame = Hud.tipPanel(Hud.buffRoot, b.tip, "BuffTip")
	-- 그 그림의 오른쪽 끝에 맞춘다 — 화면 왼쪽 밖으로 나가면 민다
	local left = UI.hud.buffs.w - i * BUFF_PITCH + 6 + PIC - TIP.w
	local rootX = (Hud.buffRoot.AbsolutePosition.X - Stage.ui.AbsolutePosition.X) / Stage.uiScale -- (기준 격자 안의 자리 — 넓은 화면의 검은 띠를 빼고)
	if rootX + left < 4 then
		left = 4 - rootX
	end
	frame.Position = UDim2.fromOffset(left, TIP_DOWN)
	tipFrame = frame
end

-- 마우스가 아직 그 칸 위에 있나(칸을 다시 지은 뒤 — 새 칸에는 MouseEnter가 오지 않을 수 있다)
local function stillOver(frame: GuiObject): boolean
	local at = game:GetService("UserInputService"):GetMouseLocation() - game:GetService("GuiService"):GetGuiInset()
	local p, s = frame.AbsolutePosition, frame.AbsoluteSize
	return at.X >= p.X and at.X < p.X + s.X and at.Y >= p.Y and at.Y < p.Y + s.Y
end

function Hud.setBuffs(list)
	local key = {}
	for i, b in list do
		key[i] = b.pic .. ":" .. b.text .. ":" .. tostring(b.hot == true)
	end
	local sig = table.concat(key, "|")
	Hud.buffList = list
	if Hud.buffSig == sig then
		return
	end
	Hud.buffSig = sig
	-- 보던 칸의 설명을 새 글로(그 칸이 없어졌거나 마우스가 벗어났으면 닫는다)
	local function refreshTip()
		local at = Hud.tipAt
		if at then
			local item = Hud.buffs[at]
			if item and (tipTouch or stillOver(item.frame)) then
				Hud.showBuffTip(at)
			else
				Hud.hideBuffTip()
			end
		end
	end
	-- 그림 · 차례 · 강조가 그대로면(1초마다 남은 초만 바뀐다) 칸을 다시 짓지 않고 글만 바꾼다(2026-10-18 검토 — 1초마다 칸마다 7개를 만들고 지웠다)
	local shapeKey = {}
	for i, b in list do
		shapeKey[i] = b.pic .. ":" .. tostring(b.hot == true) .. ":" .. tostring(b.text ~= "")
	end
	local shape = table.concat(shapeKey, "|")
	if Hud.buffShape == shape and #Hud.buffs == #list then
		for i, b in list do
			local item = Hud.buffs[i]
			if item.label and item.text ~= b.text then
				item.label:set(b.text)
				item.text = b.text
			end
		end
		refreshTip()
		return
	end
	Hud.buffShape = shape
	for _, item in Hud.buffs do
		item.frame:Destroy()
	end
	table.clear(Hud.buffs)
	local w = UI.hud.buffs.w
	for i, b in list do
		local frame = Ui.group(Hud.buffRoot, w - i * BUFF_PITCH + 6, 0, PIC, PIC + 14, "Buff" .. i)
		Ui.pic(frame, b.pic, 0, 0)
		if b.hot then
			local edge = Instance.new("UIStroke")
			edge.Color = C.accent
			edge.Thickness = 1
			edge.Parent = frame:FindFirstChild("Pic") or frame
		end
		local label = nil
		if b.text ~= "" then
			label = Ui.text(frame, b.text, -8, PIC + 2, PIC + 16, { align = "center", outline = true, color = if b.hot then C.gold else C.text })
		end
		-- 설명(마우스를 올리면 · 손가락으로 톡)
		local over = Instance.new("TextButton")
		over.Name = "Over"
		over.Text = ""
		over.BackgroundTransparency = 1
		over.Size = UDim2.fromOffset(PIC, PIC + 14)
		over.ZIndex = 8
		over.Parent = frame
		over.MouseEnter:Connect(function()
			if touching() then
				return -- 손가락은 Activated로만
			end
			tipTouch = false
			Hud.showBuffTip(i)
		end)
		over.MouseLeave:Connect(function()
			if Hud.tipAt == i and not tipTouch and not touching() then
				Hud.hideBuffTip()
			end
		end)
		over.Activated:Connect(function(input)
			local touch = input and input.UserInputType == Enum.UserInputType.Touch
			if touch and Hud.tipAt == i then
				Hud.hideBuffTip()
			else
				tipTouch = touch == true
				Hud.showBuffTip(i)
			end
		end)
		Hud.buffs[i] = { frame = frame, label = label, text = b.text }
	end
	refreshTip()
end

-- 스마트폰 단추가 켜지면 키가 적힌 칸(스킬 칸 · 메뉴 단추)은 숨긴다 — 그 자리에 손가락 단추가 온다
--  체력 덩어리는 아래 가운데로 옮긴다(왼쪽 아래에는 이동 패드가 온다 — data/ui.generated.luau의 hudTouch)
function Hud.setTouch(on: boolean)
	Hud.touch = on
	local v = if on and UI.hudTouch.vitals then UI.hudTouch.vitals else UI.hud.vitals
	Hud.vitalsBox.Position = Stage.atPosition(v.at, v.x, v.y)
	-- 버프 자리: 스마트폰에서는 오른쪽 위의 「메뉴」 단추만큼 왼쪽으로
	local bf = if on and UI.hudTouch.buffs then UI.hudTouch.buffs else UI.hud.buffs
	Hud.buffRoot.Position = Stage.atPosition(bf.at, bf.x, bf.y)
	Hud.skillRoot.Visible = not on and not Hud.locked
	for _, item in Hud.menu or {} do
		item.frame.Visible = not on
	end
end

-- 메뉴 단추를 눈에 띄게(찍을 점수가 남았을 때 등)
Hud.marks = {} :: { [string]: boolean } -- 단추마다 점이 켜져 있어야 하는가(단추를 다시 지을 때 되살린다)
function Hud.markMenu(id: string, on: boolean)
	Hud.marks[id] = on
	local item = Hud.menu and Hud.menu[id]
	if item and item.mark ~= on then
		item.mark = on
		item.dot.Visible = on
	end
end

-- 새로 생긴 메뉴 단추는 한 번 반짝인다(공방의 화면 규칙: 쓸 때가 되면 하나씩 생기고, 생길 때 한 번 반짝인다)
function Hud.flashMenu(id: string)
	local item = Hud.menu and Hud.menu[id]
	if not item or item.flashing then
		return
	end
	item.flashing = true
	task.spawn(function()
		for i = 1, 8 do
			if not item.frame.Parent then
				return
			end
			item.flash.Visible = i % 2 == 1
			task.wait(0.14)
		end
		item.flashing = false
		if item.frame.Parent then
			item.flash.Visible = false
		end
	end)
end

-- 왼쪽 아래 덩어리에 적는 내 이름
function Hud.setName(name: string)
	Hud.name:set(name)
end

-- 경험치의 % 글(소수 둘째 자리까지 — 메이플처럼)
function Hud.xpLabel(xp: number, need: number): string
	return ("%.2f%%"):format(math.clamp(xp / math.max(1, need), 0, 1) * 100)
end

-- 내 상태(서버가 보낸 것)를 그린다
-- 스킬 칸을 잠근다: 새 캐릭터는 사제에게 첫 기술을 배운 뒤에 칸이 생긴다(공방 basics.js의 UNLOCK — "스킬 칸: 사당을 나서면")
Hud.locked = false
function Hud.setLocked(on: boolean)
	if Hud.locked ~= on then
		Hud.locked = on
		Hud.skillRoot.Visible = not Hud.touch and not on
	end
end

-- 체력 바를 효과의 상태대로 그린다
function Hud.drawHp()
	local st, I = Hud.hpFx, Hud.hpIn
	if st.fill == nil then
		return
	end
	local function px(v: number): number
		return math.floor(I.w * math.clamp(v, 0, 1) + 0.5)
	end
	Hud.hp:set(st.fill)
	Hud.hpLag.Size = UDim2.fromOffset(if st.lag > st.fill then px(st.lag) else 0, I.h)
	Hud.hpGain.Size = UDim2.fromOffset(if st.gain > st.fill then px(st.gain) else 0, I.h)
	Hud.hpFlash.BackgroundColor3 = if st.kind == "heal" then Hud.hpFlashHeal else Color3.new(1, 1, 1)
	Hud.hpFlash.BackgroundTransparency = 1 - HpFx.F.flashA * st.flash / HpFx.F.flash
	local text, up = HpFx.deltaText(st)
	Hud.hpDelta:set(text or "")
	if text then
		Hud.hpDelta:color(if st.delta > 0 then C.green else C.red)
		Hud.hpDelta:move(0, Hud.layout().hpY - M.small - 1 - up)
	end
end

-- 장마다(boot의 그리는 고리가 부른다): 체력 바의 효과를 흘려보낸다
Hud.READY_T = 0.3 -- 다시 쓰기가 끝난 칸이 하얗게 번쩍이는 시간(초)
function Hud.step(dt: number)
	local st = Hud.hpFx
	if st and not HpFx.idle(st) then
		HpFx.step(st, dt)
		Hud.drawHp()
	end
	for _, slot in Hud.slots or {} do
		if slot.readyT > 0 then
			slot.readyT = math.max(0, slot.readyT - dt)
			slot.ready.Visible = slot.readyT > 0
			slot.ready.BackgroundTransparency = 1 - 0.6 * slot.readyT / Hud.READY_T
		end
	end
end

-- 다른 캐릭터로 들어왔다: 앞 캐릭터의 체력과 견주어 효과가 뜨지 않게 처음으로 돌린다
function Hud.resetHp()
	Hud.hpFx = HpFx.new()
	if Hud.hpDelta then
		Hud.hpDelta:set("")
		Hud.hpFlash.BackgroundTransparency = 1
		Hud.hpLag.Size = UDim2.fromOffset(0, Hud.hpIn.h)
		Hud.hpGain.Size = UDim2.fromOffset(0, Hud.hpIn.h)
	end
end

-- 경험치 줄의 설명: 덩어리(box) 위에 — 지금 / 필요한 경험치(%) · 다음 레벨까지
Hud.xpTip = nil :: Frame?
Hud.lastXp = nil :: { xp: number, need: number, level: number }?
function Hud.hideXpTip()
	if Hud.xpTip then
		Hud.xpTip:Destroy()
		Hud.xpTip = nil
	end
end
function Hud.xpTipText(xp: number, need: number, level: number)
	local W = UI.xpTip
	local pct = ("%.2f"):format(math.clamp(xp / math.max(1, need), 0, 1) * 100)
	return { kind = "main", title = W.title, tag = "Lv." .. level, lines = { Format.fill(W.now, { xp = Format.comma(xp), need = Format.comma(need), pct = pct }), Format.fill(W.left, { n = Format.comma(math.max(0, need - xp)) }) } }
end
function Hud.showXpTip(box: Instance)
	Hud.hideXpTip()
	local x = Hud.lastXp
	if not x then
		return
	end
	local frame, h = Hud.tipPanel(box, Hud.xpTipText(x.xp, x.need, x.level), "XpTip")
	frame.Position = UDim2.fromOffset(0, -h - 6)
	Hud.xpTip = frame
end

function Hud.setSelf(me)
	Hud.lastXp = { xp = me.xp, need = me.need, level = me.level }
	if Hud.xpTip then
		Hud.showXpTip(Hud.xpTip.Parent :: Instance) -- 떠 있는 동안 경험치가 오르면 새 수로
	end
	local level = "Lv." .. me.level
	Hud.level:set(level)
	Hud.name:move(Ui.measure(level) + V.nameGap, V.nameY) -- 이름은 레벨 글 바로 뒤에
	Hud.name.label:SetMaxWidth(UI.hud.vitals.w - Ui.measure(level) - V.nameGap, 1)
	Hud.hpText:set(Format.hp(me.hp, me.maxHp, Hud.hpTextWidth, Ui.measure))
	HpFx.set(Hud.hpFx, math.clamp(me.hp / math.max(1, me.maxHp), 0, 1), me.hp) -- 띠는 Hud.step이 효과와 함께 그린다
	Hud.drawHp()
	Hud.xp:set(me.xp / math.max(1, me.need))
	Hud.xpText:set(Hud.xpLabel(me.xp, me.need))
	Hud.markMenu("stat", me.ap > 0)
	Hud.markMenu("skill", me.sp > 0)
end

return Hud

end
MODULES['Client/lune/input'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 조작 입력. 기본 키는 공방 「기본 · UI」 탭의 키 표를 따른다(← → 걷기 · ↑ 문과 주민 · ↓ 아래 발판 · Space 뛰기).
--  키는 "하는 일 → 키" 표(BIND)를 거쳐 읽는다 — 유저가 키를 바꾸는 화면(키 설정)이 이 표를 고치게 된다.
--  스마트폰 단추(터치)도 같은 "하는 일" 이름으로 Input.press / Input.release를 부른다.
local UserInputService = game:GetService("UserInputService")

local Input = {}

-- 하는 일 → 기본 키
Input.BIND = {
	left = Enum.KeyCode.Left,
	right = Enum.KeyCode.Right,
	up = Enum.KeyCode.Up,
	down = Enum.KeyCode.Down,
	jump = Enum.KeyCode.Space,
	pickup = Enum.KeyCode.Z, -- 떨어진 것 줍기(누르고 있으면 차례로 줍는다)
}
-- 물약과 기술의 키는 여기에 없다 — 키는 퀵슬롯의 칸에 붙는다("slot:<칸>" — boot.luau가 묶는다). 스마트폰 단추는 "potion" · "skill:<기술 id>"를 그대로 누른다(키 없이 Input.press로)

-- 하는 일에 키를 묶는다: action = "slot:<칸>" · "win:<창>"
function Input.bind(action: string, key: Enum.KeyCode)
	Input.BIND[action] = key
end

local defaults: { [string]: Enum.KeyCode } = {}
local captureFn: ((Enum.KeyCode) -> ())? = nil

-- 다음에 누르는 키 하나를 가로챈다(키 설정 창이 쓴다). nil을 주면 그만둔다
function Input.capture(fn: ((Enum.KeyCode) -> ())?)
	captureFn = fn
end

-- 하는 일의 키를 바꾼다. 그 키를 이미 다른 일이 쓰고 있으면 둘이 자리를 바꾼다
function Input.rebind(action: string, key: Enum.KeyCode)
	local old = Input.BIND[action]
	for other, bound in Input.BIND do
		if other ~= action and bound == key then
			Input.BIND[other] = old
		end
	end
	Input.BIND[action] = key
end

-- 지금의 표를 "기본"으로 적어 둔다(기술 · 창의 키까지 다 묶은 뒤에 한 번 부른다)
function Input.markDefaults()
	defaults = table.clone(Input.BIND)
end

function Input.reset()
	for action, key in defaults do
		Input.BIND[action] = key
	end
end

-- 저장할 꼴: 기본과 다른 것만 { [하는 일] = 키 이름 }
function Input.export()
	local out = {}
	for action, key in Input.BIND do
		if defaults[action] ~= key then
			out[action] = key.Name
		end
	end
	return out
end

-- 저장된 것을 입힌다(모르는 일 · 모르는 키는 건너뛴다)
function Input.import(map)
	if typeof(map) ~= "table" then
		return
	end
	for action, name in map do
		if Input.BIND[action] ~= nil and typeof(name) == "string" then
			local ok, key = pcall(function()
				return (Enum.KeyCode :: any)[name]
			end)
			if ok and key then
				Input.rebind(action, key)
			end
		end
	end
end

local held: { [string]: boolean } = {}
local pressed: { [string]: boolean } = {} -- 누른 순간(한 번 읽으면 지워진다)

function Input.press(action: string)
	if not held[action] then
		pressed[action] = true
	end
	held[action] = true
end

function Input.release(action: string)
	held[action] = nil
end

function Input.held(action: string): boolean
	return held[action] == true
end

-- 읽지 않은 「누른 순간」을 모두 버린다(누르고 있는 것은 그대로) — 막이 걷히거나 · 일어나거나 · 장면이 끝나 조작이 돌아올 때(2026-10-18 검토:
--  문을 지나며 화면이 까만 동안 ↑를 한 번 더 누르면, 막이 걷히자마자 그 ↑로 들어온 문을 다시 지나 되돌아갔다 — 기술 · 뛰기 · 창 열기도 같았다)
function Input.flush()
	table.clear(pressed)
end

-- 누른 순간이었는가(읽으면 지운다)
function Input.take(action: string): boolean
	local was = pressed[action] == true
	pressed[action] = nil
	return was
end

function Input.axis(): number
	return (if held.right then 1 else 0) - (if held.left then 1 else 0)
end

local function actionOf(key: Enum.KeyCode): string?
	for action, bound in Input.BIND do
		if bound == key then
			return action
		end
	end
	return nil
end

-- Roblox 채팅의 입력줄에 글을 치는 중인가(boot가 chat.luau의 Chat.focused를 넣는다). 그 입력줄은 Roblox의 화면이라 GetFocusedTextBox로는 보이지 않는다 —
--  이것을 보지 않으면 채팅에 친 글자(Q · W · A …)가 스킬로 나간다(2026-10-13: 채팅을 Roblox의 기본 채팅으로 바꿨다. Enter로 열던 우리 채팅 판은 없다)
Input.typing = nil :: (() -> boolean)?
Input.paused = false -- 캐릭터 고르기 화면에 가 있는 동안에는 게임의 키를 받지 않는다(boot.luau의 toSelect)

function Input.init()
	UserInputService.InputBegan:Connect(function(input)
		-- 로블록스 기본 조작이 방향키를 먼저 가져가므로 "처리됨" 표시는 보지 않는다. 글자를 치는 중(채팅 등)에만 받지 않는다.
		if input.UserInputType ~= Enum.UserInputType.Keyboard or UserInputService:GetFocusedTextBox() or Input.paused or (Input.typing ~= nil and Input.typing()) then
			return -- paused = 캐릭터 고르기 화면에 가 있다(게임의 키를 받지 않는다)
		end
		if captureFn then
			-- 키 설정 중: 이 키를 새 키로 넘긴다(Esc와 알 수 없는 키는 받지 않는다)
			if input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode ~= Enum.KeyCode.Unknown then
				local fn = captureFn
				captureFn = nil
				fn(input.KeyCode)
			end
			return
		end
		local action = actionOf(input.KeyCode)
		if action then
			Input.press(action)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local action = actionOf(input.KeyCode)
		if action then
			Input.release(action)
		end
	end)
	-- 창이 뒤로 가면 누르고 있던 키를 모두 뗀 것으로 친다
	UserInputService.WindowFocusReleased:Connect(function()
		table.clear(held)
		table.clear(pressed)
	end)
end

return Input

end
MODULES['Client/lune/mapName'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 맵 이름 — 맵에 들어서면 화면 위 가운데에 지역 이름(작은 글)과 맵 이름(본문 글)이 잠깐 떴다가 흐려진다(메이플스토리처럼).
--  2026-10-18: 미니맵을 두지 않기로 해서(사용자 2026-10-07) 지금 어느 맵인지 알려 주는 것이 화면에 없었다 — 월드맵을 열어야만 알았다.
--  자리 = 보스 체력 칸(위 가운데 — 보스와 싸울 때만 쓰는 칸): 보스 체력이나 퀘스트 연출이 떠 있으면 맵 이름은 곧 사라진다.
--  치수 · 시간 = 공방 js/lune/design/ui.js의 UILAYOUT.mapName(시험 탭이 같은 값으로 그린다). 글자(그림)의 투명도를 바꿔 흐리게 한다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local SCENES = require(lune.data["scenes.generated"])
local WMD = require(lune.data["worldmap.generated"])
local WM = require(lune.ui.worldmap)
local Layout = require(lune.ui.layout)
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR
local L = Layout.MAPNAME

local MapName = {}
local box: Frame? = nil
local region, name
local t = -1
local lastA: number? = nil -- 마지막으로 쓴 보이는 정도(같으면 다시 쓰지 않는다)

function MapName.init(root: Frame)
	box = Stage.place(root, "MapName", "tc", math.floor((Stage.REF_W - L.w) / 2), L.y, L.w, L.h)
	region = Ui.text(box, "", 0, 0, L.w, { align = "center", outline = true, color = C.dim })
	name = Ui.text(box, "", 0, L.nameY, L.w, { font = "body", align = "center", outline = true, color = C.text })
	box.Visible = false
end

-- 장면의 이름표 → (지역 이름, 맵 이름). 지역 이름이 맵 이름과 같으면(은달 항구) 지역 줄은 비운다
function MapName.titleOf(key: string): (string, string)
	local base = string.match(key, "^(.-)#%d+$") or key
	local sc = SCENES.scenes[base]
	local mapName = if sc then sc.name or "" else ""
	local rid = WM.nodeOf(base)
	local regionName = if rid and WMD.regions[rid] then WMD.regions[rid].name else ""
	if regionName == mapName then
		regionName = ""
	end
	return regionName, mapName
end

-- 그 장면의 이름을 띄운다(장면이 바뀌고 막이 걷힌 뒤)
function MapName.show(key: string?)
	if not box or typeof(key) ~= "string" then
		return
	end
	local r, n = MapName.titleOf(key)
	if n == "" then
		MapName.hide()
		return
	end
	region:set(r)
	name:set(n)
	-- 글자의 처음 투명도(baseT)는 지우지 않는다: 같은 글이면 SetText가 글자를 다시 짓지 않아 지금의 흐려진 값이 남아 있다 — 지우면 그 흐려진 값을 처음 값으로 읽어
	--  같은 지역의 둘째 맵부터 지역 줄이 · 같은 이름의 맵에 다시 들면 맵 이름이 보이지 않았다(2026-10-18 검토). 새로 지은 글자에는 아직 baseT가 없어 fade가 처음 값을 잰다
	t = 0
	box.Visible = true
	lastA = nil -- (글자를 새로 지었을 수 있다 — 한 번은 꼭 쓴다)
	MapName.fade(0)
end

function MapName.hide()
	t = -1
	if box then
		box.Visible = false
	end
end

-- a = 0(안 보임) ~ 1(다 보임). 보이는 정도가 바뀔 때만 글자를 훑는다(다 보이는 2초 남짓 동안은 아무것도 쓰지 않는다 — 2026-10-18 검토)
function MapName.fade(a: number)
	if not box then
		return
	end
	local q = math.floor(a * 64 + 0.5) / 64
	if lastA == q then
		return
	end
	lastA = q
	for _, d in box:GetDescendants() do
		if d:IsA("ImageLabel") then
			local base = d:GetAttribute("baseT")
			if base == nil then
				base = d.ImageTransparency
				d:SetAttribute("baseT", base)
			end
			d.ImageTransparency = base + (1 - base) * (1 - a)
		end
	end
end

-- 지금 보이는 정도(0 ~ 1 · 안 떠 있으면 0) — 자동 검사가 본다
function MapName.alpha(): number
	if t < 0 then
		return 0
	end
	if t < L.fadeIn then
		return t / L.fadeIn
	elseif t < L.fadeIn + L.hold then
		return 1
	end
	return math.max(0, 1 - (t - L.fadeIn - L.hold) / L.fadeOut)
end

-- 장마다: blocked = 그 자리를 다른 것이 쓴다(보스 체력 · 퀘스트 연출) — 그러면 바로 사라진다
function MapName.step(dt: number, blocked: boolean?)
	if t < 0 then
		return
	end
	t += dt
	local a = MapName.alpha()
	if a <= 0 or blocked then
		MapName.hide()
		return
	end
	MapName.fade(a)
end

return MapName

end
