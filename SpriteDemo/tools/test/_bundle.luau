			ctx:style(g.tone.n)
			ctx:rect(x - 1, y, 3, 1)
			ctx:rect(x, y - 1, 1, 3)
			ctx:style(g.tone.w)
			ctx:rect(x, y, 1, 1)
		end
	end,
