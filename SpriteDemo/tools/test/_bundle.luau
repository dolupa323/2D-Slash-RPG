	hg.invuln = 999
	-- ㄱ) 받아 주지 않을 기술 요청으로는 자리를 옮기지 못한다(2~4차 · 버프 모두 이동 몫 안)
	local x0 = hg.x
	hg.skills.ax_execute = math.max(hg.skills.ax_execute or 0, 1)
	for _ = 1, 10 do
