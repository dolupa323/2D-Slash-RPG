	QuickSlotsUpdated = { Kind = "Event", Direction = "ServerToClient", Doc = "{ id1, id2, id3 }" },
	-- 짧은 알림(화면 위 토스트): 가방이 가득 찼어요 등
	Notify = { Kind = "Event", Direction = "ServerToClient", Doc = "text" },
}

return packets

end
MODULES['ReplicatedStorage/shared/util/setup'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 공식 SpaceFighter 예제(notreux/SpaceFighter)의 src/shared/util/setup.luau 그대로 재활용.
local exports = {}

--[[
    Retrieves all ModuleScripts from a given path and requires them.
    Returns a table mapping module names to the required module.
]]
function exports.getModulesByPath(path)
	local modules = {}
	for _, module in path:GetChildren() do
		if module:IsA("ModuleScript") then
			modules[module.Name] = require(module)
		end
	end

	return modules
end

--[[
    Iterates over a table of modules and calls the specified method on each,
    passing any additional arguments provided.
]]
function exports.run(modules, methodName, ...)
	for _, module in modules do
		if module[methodName] then
			module[methodName](...)
		end
	end
end

return exports

end
MODULES['ServerScriptService/server/lune/boot'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 「달의 계승자」(횡스크롤 MMORPG) 서버의 시작점. shared/config/features.luau의 GAME이 "lune"일 때 server/main.server.luau가 부른다.
--  server/lune/modules 아래의 모듈을 차례로 켠다. 지금은 world(사람 · 방 · 싸움) 하나다.
local World = require(script.Parent.modules.world)
local Chat = require(script.Parent.modules.chat)

local Boot = {}

function Boot.start()
	-- 이 게임의 캐릭터는 화면 위의 도트 그림이다 — Roblox 기본 캐릭터(3D)는 만들지 않는다.
	--  (만들어 두면 화살표 키로 보이지 않는 캐릭터가 같이 걷고, 스마트폰에서는 기본 조이스틱이 뜬다)
	local Players = game:GetService("Players")
	Players.CharacterAutoLoads = false
	for _, player in Players:GetPlayers() do
		if player.Character then
			player.Character:Destroy()
		end
	end
	World.start()
	Chat.start(World)
	print("[lune] 서버 시작")
end

function Boot.stop()
	World.stop() -- 서버가 닫힐 때 모두 저장한다
end

return Boot

end
MODULES['ServerScriptService/server/lune/modules/admin'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 관리자(어드민) — 누가 관리자인가. 이 파일은 서버에만 있다(ServerScriptService — 클라이언트로 복제되지 않는다).
--  사용자 2026-10-11: "저만 쓸수있는 어드민용 탭 만들어주세요 다른 유저들에게는 보이지않고, 어드민만 보이는 어드민관리탭 … 경험치 배율증가, 레벨 조정, 아이템발급 등등
--   여러 테스트용 편의 기능 … 누군가 해킹같은거해서 사용도 못해야하고 오직 어드민만 사용할수있어야합니다."
--  지키는 법:
--   ① 관리자인지는 서버가 그 사람의 로블록스 계정 번호(UserId — 로블록스가 정해 주는 값이라 클라이언트가 속일 수 없다)로만 가린다. 클라이언트가 보낸 「나는 관리자다」 같은 말은 어디에서도 듣지 않는다.
--   ② 관리자 명령(패킷 「Admin」)은 올 때마다 서버가 다시 가린다 — 관리 창을 억지로 띄우거나 패킷을 직접 쏴도, 관리자가 아니면 아무 일도 일어나지 않는다(대답도 하지 않는다).
--   ③ 명령의 값(레벨 · 수 · 아이템의 이름 · 장면의 이름)은 서버가 범위와 꼴을 다시 본다(server/lune/modules/world.luau의 onAdmin).
--   ④ 관리 창의 코드는 누구에게나 내려가지만(로블록스의 클라이언트 코드는 감출 수 없다) 창을 여는 단추는 서버가 「관리자」라고 알려 준 사람에게만 보인다. 감추는 것은 보기 좋으라고 하는 것이고, 막는 것은 ① ②다.
--  관리자를 더하려면 아래 IDS에 그 계정의 번호를 적는다(게임의 주인은 적지 않아도 관리자다).
local Admin = {}

-- 관리자의 계정 번호 → 메모(이름). 게임의 주인 dolupa95
Admin.IDS = {
	[10311679477] = "dolupa95",
}

-- 그 사람이 관리자인가(서버만 부른다)
function Admin.is(player: any): boolean
	if typeof(player) ~= "Instance" and typeof(player) ~= "table" then
		return false
	end
	local id = player.UserId
	if typeof(id) ~= "number" or id <= 0 then
		return false
	end
	if Admin.IDS[id] ~= nil then
		return true
	end
	-- 게임의 주인(개인이 주인일 때)
	local ok, owner = pcall(function()
		return game.CreatorType == Enum.CreatorType.User and game.CreatorId == id
	end)
	return ok and owner == true
end

return Admin

end
MODULES['ServerScriptService/server/lune/modules/chat'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 채팅이 누구에게 가는지 — Roblox의 채팅(TextChatService)에 얹는다. 글 거르기는 Roblox가 한다.
--  둘레(기본 채널 RBXGeneral): 같은 맵에 있는 사람에게만 간다.
--  파티(채널 「파티」): 모두가 들어 있되, 같은 파티인 사람에게만 간다(파티가 없으면 나만 본다).
--  누가 어느 맵 · 어느 파티인지는 world.luau에 묻는다.
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local Chat = {}

function Chat.start(World)
	task.spawn(function()
		local channels = TextChatService:WaitForChild("TextChannels", 15)
		if not channels then
			warn("[lune] 채팅 채널을 찾지 못했다 — 채팅은 Roblox 기본 그대로 돈다")
			return
		end
		local general = channels:WaitForChild("RBXGeneral", 15)
		if general then
			general.ShouldDeliverCallback = function(message, target)
				local from = message.TextSource
				if not from then
					return true
				end
				local a, b = World.sceneOf(from.UserId), World.sceneOf(target.UserId)
				return a == nil or b == nil or a == b
			end
		end
		local party = Instance.new("TextChannel")
		party.Name = "파티"
		party.Parent = channels
		party.ShouldDeliverCallback = function(message, target)
			local from = message.TextSource
			return from ~= nil and World.sameParty(from.UserId, target.UserId)
		end
		local function add(player)
			pcall(function()
				party:AddUserAsync(player.UserId)
			end)
		end
		Players.PlayerAdded:Connect(add)
		for _, player in Players:GetPlayers() do
			task.spawn(add, player)
		end
	end)
end

return Chat

end
MODULES['ServerScriptService/server/lune/modules/store'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 저장소(DataStore). 게임 규칙은 모른다 — 숫자와 글로 된 표를 읽고 쓸 뿐이다(저장 꼴은 sim/account.luau · sim/hero.luau의 pack · unpack).
--  셋을 다룬다:
--   계정(LuneAccount_v1, 열쇠 acct_<사람 번호>) = 그 사람의 캐릭터들과 같이 쓰는 창고. 한 열쇠에 통째로 적는다 — 캐릭터와 창고가 어긋나지 않게.
--   이름 장부(LuneNames_v1, 열쇠 = 이름) = 그 이름을 가진 사람. 캐릭터의 이름은 겹치지 않는다(사용자 2026-10-10: "중복확인을하고") — UpdateAsync로 먼저 적은 사람이 갖는다.
--   예전 저장(LuneHero_v1, 열쇠 hero_<사람 번호>) = 계정이 생기기 전의 캐릭터 하나. 읽기만 한다(계정으로 옮긴 뒤에도 지우지 않고 그대로 둔다).
--  DataStore 호출은 몇 번 다시 해 본다. Studio에서 API 접근이 꺼져 있으면 메모리에만 담아 둔다(Play를 끄면 사라진다 — 그때는 경고를 한 번 낸다).
--  아직 하지 않은 것: 같은 계정이 두 서버에 동시에 들어왔을 때의 잠금(여럿이 하는 단계에서 넣는다).
local DataStoreService = game:GetService("DataStoreService")

local NAME = { account = "LuneAccount_v1", names = "LuneNames_v1", old = "LuneHero_v1", rankInfo = "LuneRankInfo_v1" }
local RANK = { level = "LuneRankLevel_v1", power = "LuneRankPower_v1", robux = "LuneRankRobux_v1" } -- 순위판(OrderedDataStore): 열쇠 → 점수
local RETRIES = 3
local WAIT = 1

local Store = {}

local stores = {}
local memory = { account = {}, names = {} } -- DataStore를 못 쓸 때의 임시 저장
local offline = false

local function getStore(which: string)
	if stores[which] or offline then
		return stores[which]
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(NAME[which])
	end)
	if ok then
		stores[which] = result
	else
		offline = true
		warn("[lune] 저장소를 열지 못해 메모리에만 저장한다: " .. tostring(result))
	end
	return stores[which]
end

local function try(fn)
	local last
	for attempt = 1, RETRIES do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		last = result
		if attempt < RETRIES then
			task.wait(WAIT)
		end
	end
	return false, last
end

-- 읽는다. 돌려주는 것: 읽었는가, 읽은 값(없으면 nil). 읽지 못했으면(Studio에서 API 접근이 꺼져 있을 때) 그 뒤로는 메모리만 쓴다
local function read(which: string, key: string): (boolean, any)
	local ds = getStore(which)
	if ds and not offline then
		local ok, result = try(function()
			return ds:GetAsync(key)
		end)
		if ok then
			return true, result
		end
		offline = true
		warn("[lune] 저장소를 읽지 못해 메모리에만 저장한다: " .. tostring(result))
	end
	return false, nil
end

-- ---------- 계정 ----------
-- 저장된 계정을 읽는다. 없으면 nil.
function Store.loadAccount(userId: number)
	local ok, result = read("account", "acct_" .. userId)
	if ok then
		return result
	end
	return memory.account[userId]
end

-- 계정을 저장한다. 됐으면 true.
function Store.saveAccount(userId: number, data): boolean
	memory.account[userId] = data
	local ds = getStore("account")
	if not ds or offline then
		return false
	end
	local ok, err = try(function()
		ds:SetAsync("acct_" .. userId, data)
	end)
	if not ok then
		warn(("[lune] %d의 저장에 실패했다: %s"):format(userId, tostring(err)))
	end
	return ok
end

-- ---------- 계정의 잠금 ----------
-- 같은 계정이 두 서버에 동시에 들어오면, 두 서버가 제가 아는 가방을 번갈아 저장해 물건이 복사되거나 사라진다(한쪽에서 창고에 넣고 다른 쪽에서 그 전의 가방을 저장한다).
--  그래서 계정을 읽기 전에 이 서버가 그 계정을 잡는다(같은 저장소의 "lock_<번호>" = { job = 서버의 번호, at = 잡은 때 }). 다른 서버가 잡고 있으면 읽지 않는다.
--  서버는 틈틈이(저장할 때마다 — 60초) 잠금을 새로 고치고, 나갈 때 푼다. LOCK_TTL초가 지나도록 새로 고쳐지지 않은 잠금은 죽은 서버의 것으로 보고 넘겨받는다.
--  저장소를 쓸 수 없으면(Studio — 메모리에만 저장한다) 잠그지 않는다. 저장소가 잠깐 말을 듣지 않을 때에도 막지 않는다(들어오지 못하는 것보다 낫다).
local LOCK_TTL = 150
Store.LOCK_TTL = LOCK_TTL
Store.JOB = nil :: string? -- (자동 검사가 다른 서버인 척할 때 적는다)
local function jobId(): string
	if Store.JOB then
		return Store.JOB
	end
	local ok, id = pcall(function()
		return game.JobId
	end)
	return if ok and typeof(id) == "string" and id ~= "" then id else "studio"
end

-- 이 서버가 그 계정을 잡는다(이미 잡고 있으면 시간을 새로 고친다). 다른 서버가 잡고 있으면 false
function Store.lock(userId: number): boolean
	local ds = getStore("account")
	if not ds or offline then
		return true
	end
	local mine, job = true, jobId()
	local ok, err = try(function()
		ds:UpdateAsync("lock_" .. userId, function(old)
			local now = os.time()
			if typeof(old) == "table" and old.job ~= job and typeof(old.at) == "number" and now - old.at < LOCK_TTL then
				mine = false
				return nil -- 다른 서버의 것이다: 그대로 둔다
			end
			mine = true
			return { job = job, at = now }
		end)
	end)
	if not ok then
		warn(("[lune] %d의 잠금을 확인하지 못했다(막지 않는다): %s"):format(userId, tostring(err)))
		return true
	end
	return mine
end

-- 잠금을 푼다(이 서버가 잡고 있을 때만). 계정을 저장한 뒤에 부른다
function Store.unlock(userId: number)
	local ds = getStore("account")
	if not ds or offline then
		return
	end
	local job = jobId()
	try(function()
		ds:UpdateAsync("lock_" .. userId, function(old)
			if typeof(old) == "table" and old.job == job then
				return { job = job, at = 0 } -- 지난 잠금으로 적는다(다른 서버가 바로 잡을 수 있다)
			end
			return nil
		end)
	end)
end

-- 계정이 생기기 전의 저장(캐릭터 하나)을 읽는다. 없으면 nil. 쓰지도 지우지도 않는다.
function Store.loadOld(userId: number)
	local ok, result = read("old", "hero_" .. userId)
	if ok then
		return result
	end
	return nil
end

-- ---------- 이름 장부 ----------
-- 그 이름을 가진 사람의 번호. 아무도 없으면 nil. 읽지 못했으면 false(그때는 이름을 지을 수 없다고 답한다)
function Store.nameOwner(key: string): any
	if offline or not getStore("names") then
		return memory.names[key]
	end
	local ok, result = read("names", key)
	if ok then
		return if typeof(result) == "table" and result.u then result.u else nil
	end
	return if offline then memory.names[key] else false
end

-- 그 이름을 내 것으로 적는다. 비어 있거나 이미 내 것이면 true, 남의 것이면 false. 적지 못했으면 nil.
function Store.claimName(key: string, userId: number, at: number?): boolean?
	local ds = getStore("names")
	if not ds or offline then
		if memory.names[key] ~= nil and memory.names[key] ~= userId then
			return false
		end
		memory.names[key] = userId
		return true
	end
	local mine = false
	local ok, err = try(function()
		mine = false
		ds:UpdateAsync(key, function(old)
			if typeof(old) == "table" and old.u and old.u ~= userId then
				return nil -- 남의 것: 그대로 둔다
			end
			mine = true
			return { u = userId, at = at or 0 }
		end)
	end)
	if not ok then
		warn(("[lune] 이름 장부에 적지 못했다: %s"):format(tostring(err)))
		return nil
	end
	return mine
end

-- 내 이름을 장부에서 지운다(캐릭터를 지웠을 때 — 그 이름을 다른 사람이 쓸 수 있게 된다). 남의 것은 건드리지 않는다.
function Store.freeName(key: string, userId: number)
	local ds = getStore("names")
	if not ds or offline then
		if memory.names[key] == userId then
			memory.names[key] = nil
		end
		return
	end
	try(function()
		ds:UpdateAsync(key, function(old)
			if typeof(old) == "table" and old.u == userId then
				return { u = false, at = old.at } -- 빈 이름(u = false): 누구든 다시 가질 수 있다
			end
			return nil
		end)
	end)
end

-- ---------- 명예의 전당의 순위판 ----------
--  판마다 OrderedDataStore 하나(열쇠 → 점수). 이름 · 직업은 따로(rankInfo — 열쇠 → { name, class }).
--  memoryOnly = 저장소에 쓰지 않고 이 서버의 메모리에만 둔다(확인용 임시 계정 — Studio에서 판을 볼 때만 쓰인다). 읽을 때는 저장소의 것과 메모리의 것을 합친다.
local ranks = {} -- [판] = OrderedDataStore
local rankMemory = { level = {}, power = {}, robux = {} } -- [판][열쇠] = 점수(메모리에만 있는 것 · 저장소를 못 쓸 때의 것)
local infoMemory = {} -- [열쇠] = { name, class }

local function getRank(board: string)
	if ranks[board] or offline then
		return ranks[board]
	end
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(RANK[board])
	end)
	if ok then
		ranks[board] = result
	else
		offline = true
		warn("[lune] 순위판을 열지 못해 메모리에만 둔다: " .. tostring(result))
	end
	return ranks[board]
end

-- 그 판에 점수를 적는다(같은 열쇠는 덮어쓴다)
function Store.rankSet(board: string, key: string, score: number, memoryOnly: boolean?)
	if not RANK[board] then
		return
	end
	local ds = if memoryOnly then nil else getRank(board)
	if not ds or offline then
		rankMemory[board][key] = score
		return
	end
	rankMemory[board][key] = nil
	local ok, err = try(function()
		ds:SetAsync(key, score)
	end)
	if not ok then
		warn(("[lune] 순위판 %s에 적지 못했다: %s"):format(board, tostring(err)))
	end
end

function Store.rankRemove(board: string, key: string)
	if not RANK[board] then
		return
	end
	rankMemory[board][key] = nil
	local ds = getRank(board)
	if ds and not offline then
		try(function()
			ds:RemoveAsync(key)
		end)
	end
end

-- 그 판의 위에서부터 n줄: { { key, score } … }(높은 차례)
function Store.rankTop(board: string, n: number)
	local rows = {}
	if not RANK[board] then
		return rows
	end
	local ds = getRank(board)
	if ds and not offline then
		local ok, pages = try(function()
			return ds:GetSortedAsync(false, n)
		end)
		if ok and pages then
			for _, entry in pages:GetCurrentPage() do
				table.insert(rows, { key = entry.key, score = entry.value })
			end
		end
	end
	for key, score in rankMemory[board] do
		table.insert(rows, { key = key, score = score })
	end
	table.sort(rows, function(a, b)
		if a.score ~= b.score then
			return a.score > b.score
		end
		return a.key < b.key
	end)
	while #rows > n do
		table.remove(rows)
	end
	return rows
end

-- 순위판에 적힌 열쇠의 이름 · 직업
function Store.rankInfoSet(key: string, info, memoryOnly: boolean?)
	infoMemory[key] = info
	local ds = if memoryOnly then nil else getStore("rankInfo")
	if ds and not offline then
		try(function()
			ds:SetAsync(key, info)
		end)
	end
end

function Store.rankInfoGet(key: string)
	if infoMemory[key] then
		return infoMemory[key]
	end
	local ok, result = read("rankInfo", key)
	if ok and typeof(result) == "table" then
		infoMemory[key] = result
		return result
	end
	return nil
end

function Store.rankInfoRemove(key: string)
	infoMemory[key] = nil
	local ds = getStore("rankInfo")
	if ds and not offline then
		try(function()
			ds:RemoveAsync(key)
		end)
	end
end

function Store.isOffline(): boolean
	return offline
end

return Store

end
