	room:skillHit(half, COMBAT.skills.ax_slam.hits[1], half.x, half.y, 1, 1, nil, "mob", "ax_slam", { mul = 1.5, reach = 10, level = 1 })
	expect(half.pass.surge < room.time, "끝까지 모으지 않은 강타로는 켜지지 않는다")
