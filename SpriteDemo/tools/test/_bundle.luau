end

-- ---- 5) 전직 퀘스트(m106): 스승에게 받고, 전직한 뒤 다시 말을 걸면 끝 ----
Q.Index, Q.Accepted, Q.Progress = indexOf("m106"), false, 0
data[p1].Level = 10
talkTo("elder")
expect(Q.Accepted, "m106 받음")
talkTo("elder")
