exports.CHARM_CHANCE = 0.008
exports.CHARMS = {
	bamboo = { "WindCharm" },
	swamp = { "WindCharm" },
	desert = { "IronCharm" },
	snow = { "IronCharm" },
	ruins = { "SpiritCharm" },
	tower = { "SpiritCharm" },
	nest = { "SpiritCharm" },
