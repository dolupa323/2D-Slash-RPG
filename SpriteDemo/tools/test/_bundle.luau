			elseif step.type == "meet" then
				-- 만나기(2026-10-16 — 만나면 열림): 졸개가 없고, 그 사람이 어느 장면엔가 서 있다
				local stands = false
				for _, sc in SCENES.scenes do
					for _, n in sc.npcs or {} do
						stands = stands or n.id == step.npc
