-- ---- 9) 창고 ----
local k = Hero.new(10, "axion")
local thing = Items.make("suit", 1, 2)
Bag.add(k, thing)
expect(Bag.storeIn(k, thing.id), "창고에 넣는다")
eq(#k.gear, 0, "가방에서 빠진다")
