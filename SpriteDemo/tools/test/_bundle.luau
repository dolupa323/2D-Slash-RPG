MODULES['ReplicatedStorage/shared/lune/net/net'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 「달의 계승자」의 네트워크 계층 — shared/net/net.luau(닌자 게임의 것)를 그대로 가져와 리모트 폴더 이름만 바꿨다. 패킷 정의는 같은 폴더의 packets.luau.
-- 네트워크 계층. 모든 RemoteEvent/RemoteFunction은 shared/net/packets.luau의 정의로만 만들고 쓴다 — 모듈마다
-- 리모트를 제각각 만들고 이름 문자열로 찾던 구조를 대체한다.
--   서버: Net.OnServer(이름, 핸들러) — 인자 개수/타입과 요청 빈도를 검사해서 통과한 요청만 핸들러로 보낸다.
--         Net.FireClient / Net.FireAllClients
--   클라: Net.FireServer / Net.Invoke / Net.OnClient
-- 검증에 실패하거나 빈도를 넘긴 요청은 조용히 버리고(서버 로그에는 플레이어·패킷별로 몇 초에 한 번만 경고) 핸들러는
-- 호출하지 않는다. 이동 위치를 매번 거절하는 것은 엔진 공식 문서가 비권장하지만(오탐/지연), 이 계층은 "중요 행동
-- 요청이 형식에 맞는지, 폭주하지 않는지"만 본다 — 위치/내용의 타당성 검증은 각 서비스가 맡는다.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local packets = require(script.Parent.packets)

local IS_SERVER = RunService:IsServer()
local FOLDER_NAME = "LuneRemotes"

local Net = {}

local folder: Folder
if IS_SERVER then
	folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME) or Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = ReplicatedStorage
	for name, def in packets do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new(if def.Kind == "Function" then "RemoteFunction" else "RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

local function getRemote(name: string)
	assert(packets[name], ("Net: 정의되지 않은 패킷 '%s' (shared/net/packets.luau에 먼저 추가)"):format(name))
	if IS_SERVER then
		return folder:FindFirstChild(name)
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME):WaitForChild(name)
end

-- ===== 서버 =====

-- 플레이어별 패킷별 토큰 버킷: buckets[userId][name] = { tokens, last }
local buckets: { [number]: { [string]: { tokens: number, last: number } } } = {}
local lastWarn: { [string]: number } = {}

local function warnThrottled(key: string, message: string)
	local now = os.clock()
	if not lastWarn[key] or now - lastWarn[key] > 5 then
		lastWarn[key] = now
		warn(message)
	end
end

local function takeToken(player: Player, name: string, limit): boolean
	local perPlayer = buckets[player.UserId]
	if not perPlayer then
		perPlayer = {}
		buckets[player.UserId] = perPlayer
	end
	local now = os.clock()
	local bucket = perPlayer[name]
	if not bucket then
		bucket = { tokens = limit.Burst, last = now }
		perPlayer[name] = bucket
	end
	bucket.tokens = math.min(limit.Burst, bucket.tokens + (now - bucket.last) * limit.PerSecond)
	bucket.last = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

local function validArgs(def, ...): boolean
	if select("#", ...) > #def.Args then
		return false -- 정의보다 인자가 많으면 형식 위반
	end
	for i, check in def.Args do
		if not check((select(i, ...))) then
			return false
		end
	end
	return true
end

-- ClientToServer 패킷 핸들러 등록. Function 패킷이면 핸들러의 반환값이 클라이언트에 돌아간다.
function Net.OnServer(name: string, handler: (player: Player, ...any) -> ...any)
	assert(IS_SERVER, "Net.OnServer는 서버에서만 쓴다")
	local def = packets[name]
	assert(def and def.Direction == "ClientToServer", ("Net.OnServer: '%s'는 ClientToServer 패킷이 아니다"):format(name))
	local remote = getRemote(name)

	local function guarded(player: Player, ...)
		if not takeToken(player, name, def.RateLimit) then
			warnThrottled(player.UserId .. name .. "rate", ("Net: %s의 '%s' 요청이 빈도 제한을 넘어 버려졌다"):format(player.Name, name))
			return false
		end
		if not validArgs(def, ...) then
			warnThrottled(player.UserId .. name .. "arg", ("Net: %s의 '%s' 요청 인자가 형식에 맞지 않아 버려졌다"):format(player.Name, name))
			return false
		end
		return true
	end

	if def.Kind == "Function" then
		remote.OnServerInvoke = function(player: Player, ...)
			if not guarded(player, ...) then
				return nil
			end
			return handler(player, ...)
		end
	else
		remote.OnServerEvent:Connect(function(player: Player, ...)
			if guarded(player, ...) then
				handler(player, ...)
			end
		end)
	end
end

function Net.FireClient(name: string, player: Player, ...: any)
	assert(IS_SERVER)
	getRemote(name):FireClient(player, ...)
end

function Net.FireAllClients(name: string, ...: any)
	assert(IS_SERVER)
	getRemote(name):FireAllClients(...)
end

if IS_SERVER then
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		buckets[player.UserId] = nil
	end)
end

-- ===== 클라이언트 =====

function Net.FireServer(name: string, ...: any)
	assert(not IS_SERVER)
	getRemote(name):FireServer(...)
end

function Net.Invoke(name: string, ...: any): any
	assert(not IS_SERVER)
	return getRemote(name):InvokeServer(...)
end

function Net.OnClient(name: string, handler: (...any) -> ()): RBXScriptConnection
	assert(not IS_SERVER)
	return getRemote(name).OnClientEvent:Connect(handler)
end

return Net

end
MODULES['ReplicatedStorage/shared/lune/net/packets'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 「달의 계승자」의 네트워크 패킷 정의(단 하나의 출처). 짜임은 shared/net/packets.luau와 같다.
--  Direction: "ClientToServer" / "ServerToClient" · Kind: "Event" / "Function"
--  Args · RateLimit은 ClientToServer만 — net.luau가 인자 형식과 빈도를 검사한 뒤에야 핸들러를 부른다.
--  원칙: 클라이언트는 "하고 싶다"만 보낸다. 체력 · 경험치 · 돈 · 졸개 · 떨어진 것의 진실은 서버가 갖는다.
local t = {}

function t.number(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function t.string(value: any): boolean
	return typeof(value) == "string" and #value <= 64
end

function t.dir(value: any): boolean
	return value == 1 or value == -1
end

function t.table(value: any): boolean
	return typeof(value) == "table"
end

function t.any(_value: any): boolean
	return true -- 꼴은 받는 쪽이 본다(없어도 된다)
end

local packets = {
	-- ===== 클라이언트 → 서버 =====
	-- 들어와서 처음 한 번: 내 상태와 지금 방을 받는다. 돌려주는 값 { self, scene, x, y, room } — 캐릭터가 아직 없으면 { choose = true }
	Ready = { Kind = "Function", Direction = "ClientToServer", Args = {}, RateLimit = { PerSecond = 1, Burst = 3 } },
	-- 직업을 고른다(캐릭터가 없을 때만). 돌려주는 값은 Ready와 같다
	Choose = { Kind = "Function", Direction = "ClientToServer", Args = { t.string }, RateLimit = { PerSecond = 1, Burst = 2 } },
	-- 능력치에 점수를 찍는다(능력치 이름, 점수) · 남은 점수를 모두 주 능력치에
	StatAdd = { Kind = "Event", Direction = "ClientToServer", Args = { t.string, t.number }, RateLimit = { PerSecond = 10, Burst = 20 } },
	StatAuto = { Kind = "Event", Direction = "ClientToServer", Args = {}, RateLimit = { PerSecond = 2, Burst = 3 } },
	-- 스킬을 한 레벨 올린다(스킬 id) · 남은 포인트를 추천대로
	SkillUp = { Kind = "Event", Direction = "ClientToServer", Args = { t.string }, RateLimit = { PerSecond = 10, Burst = 20 } },
	SkillAuto = { Kind = "Event", Direction = "ClientToServer", Args = {}, RateLimit = { PerSecond = 2, Burst = 3 } },
	-- 물건을 다룬다: 하는 일(equip · unequip · dismantle · buy · enhance · transfer · restore · grow · storeIn · storeOut)과 그 대상 둘(번호 · 부위 · 수 등)
	Item = { Kind = "Event", Direction = "ClientToServer", Args = { t.string, t.any, t.any }, RateLimit = { PerSecond = 8, Burst = 12 } },
	-- 파티: 하는 일(invite · accept · decline · leave)과 대상(초대할 사람의 번호)
	Party = { Kind = "Event", Direction = "ClientToServer", Args = { t.string, t.any }, RateLimit = { PerSecond = 4, Burst = 6 } },
	-- 퀘스트: 하는 일(accept · complete · drop)과 퀘스트 id — 받기와 돌려주기는 그 주민 앞에서만
	Quest = { Kind = "Event", Direction = "ClientToServer", Args = { t.string, t.any }, RateLimit = { PerSecond = 4, Burst = 6 } },
	-- 바꾼 키를 저장한다 { [하는 일] = 키 이름 } — 꼴은 서버가 다시 본다
	Keys = { Kind = "Event", Direction = "ClientToServer", Args = { t.table }, RateLimit = { PerSecond = 2, Burst = 4 } },
	-- 퀵슬롯을 바꿨다: 칸들 전체 { "potion" · 스킬의 이름표 · false … } — 꼴과 놓아도 되는 스킬인지는 서버가 다시 본다. 돌려주는 값 = 서버가 가진 칸들(받아들였으면 보낸 것, 아니면 예전 것)
	Slots = { Kind = "Function", Direction = "ClientToServer", Args = { t.table }, RateLimit = { PerSecond = 4, Burst = 8 } },
	-- 스마트폰의 단추 배치를 바꿨다: 같은 꼴(칸들 전체) — PC의 퀵슬롯과 따로 저장한다. 돌려주는 값 = 서버가 가진 배치
	TouchSlots = { Kind = "Function", Direction = "ClientToServer", Args = { t.table }, RateLimit = { PerSecond = 4, Burst = 8 } },
	-- 내 자리(도트)와 보는 쪽. 움직임은 클라이언트가 셈하고 서버는 말이 되는지만 본다.
	Move = { Kind = "Event", Direction = "ClientToServer", Args = { t.number, t.number, t.dir }, RateLimit = { PerSecond = 20, Burst = 30 } },
	-- 문으로 다른 장면에 간다. 돌려주는 값 { scene, x, y, room } 또는 nil(문 앞이 아님)
	Travel = { Kind = "Function", Direction = "ClientToServer", Args = { t.string }, RateLimit = { PerSecond = 2, Burst = 3 } },
	-- 기술을 쓴다: 기술 id, 몇째 구간, 쓴 자리(x, y), 보는 쪽
	Skill = { Kind = "Event", Direction = "ClientToServer", Args = { t.string, t.number, t.number, t.number, t.dir }, RateLimit = { PerSecond = 8, Burst = 10 } },
	-- 떨어진 것을 줍는다(물건 번호)
	Pickup = { Kind = "Event", Direction = "ClientToServer", Args = { t.number }, RateLimit = { PerSecond = 10, Burst = 15 } },
	-- 확인용(Studio에서만 듣는다): "xp" 경험치를 준다 · "money" 달돈을 준다 · "hp" 체력을 정한다 · "reset" 캐릭터를 지운다(직업 고르기부터 다시)
	Debug = { Kind = "Event", Direction = "ClientToServer", Args = { t.string, t.number }, RateLimit = { PerSecond = 5, Burst = 5 } },
	-- 물약을 마신다
	Potion = { Kind = "Event", Direction = "ClientToServer", Args = {}, RateLimit = { PerSecond = 3, Burst = 3 } },

	-- ===== 서버 → 클라이언트 =====
	Self = { Kind = "Event", Direction = "ServerToClient", Doc = "내 상태(sim/hero.luau의 view)" },
	Snap = { Kind = "Event", Direction = "ServerToClient", Doc = "장면 이름, 졸개 목록 { id, x, dir, 상태, 상태가 된 뒤 흐른 시간, 체력 }" },
	Hits = { Kind = "Event", Direction = "ServerToClient", Doc = "누가(userId), 맞은 졸개 목록 { mob, dmg, hp, dead }" },
	Hurt = { Kind = "Event", Direction = "ServerToClient", Doc = "내가 맞았다 { dmg, hp, from, dead }" },
	Gain = { Kind = "Event", Direction = "ServerToClient", Doc = "경험치를 얻었다 { xp, ups, level }" },
	DropAdd = { Kind = "Event", Direction = "ServerToClient", Doc = "떨어진 것 { id, kind(money · gear · dust), amount, x, y, item }" },
	Heroes = { Kind = "Event", Direction = "ServerToClient", Doc = "장면 이름, 그 방 사람들의 자리 { id, x, y, dir, 살아 있는가 } — 초당 10번" },
	Who = { Kind = "Event", Direction = "ServerToClient", Doc = "장면 이름, 그 방 사람들의 이름표 { id, name, class, level } — 들고 날 때 · 레벨이 오를 때" },
	Act = { Kind = "Event", Direction = "ServerToClient", Doc = "다른 사람이 기술을 쓴다: 누구, 기술, 구간, x, y, 보는 쪽" },
	PartyInfo = { Kind = "Event", Direction = "ServerToClient", Doc = "내 파티 { leader, members = { { id, name, class, level, hp, maxHp, scene } … } } — 파티가 없으면 members가 비어 있다" },
	PartyAsk = { Kind = "Event", Direction = "ServerToClient", Doc = "파티 초대 { from, name } — 초대가 사라졌으면 from = false" },
	Quests = { Kind = "Event", Direction = "ServerToClient", Doc = "내 퀘스트의 상태 { [id] = { done, c = { 할 일마다의 수 } } } — 바뀔 때마다. 둘째 값 = 방금 끝낸 퀘스트의 id(없으면 nil)" },
	Bag = { Kind = "Event", Direction = "ServerToClient", Doc = "가방 · 장비 · 창고 · 달가루(sim/bag.luau의 view) — 바뀔 때마다" },
	ItemDone = { Kind = "Event", Direction = "ServerToClient", Doc = "물건을 다룬 결과 { action, ok, why, result }" },
	DropGone = { Kind = "Event", Direction = "ServerToClient", Doc = "물건 번호, 주운 사람(userId — 사라진 것이면 nil), 양" },
	Shot = { Kind = "Event", Direction = "ServerToClient", Doc = "화살 { id, x, y, dir, speed, range }" },
	ShotEnd = { Kind = "Event", Direction = "ServerToClient", Doc = "화살 번호" },
	Burst = { Kind = "Event", Direction = "ServerToClient", Doc = "폭탄병이 터짐 { mob, x, y }" },
	Revive = { Kind = "Event", Direction = "ServerToClient", Doc = "쓰러졌다가 마을에서 일어남 { scene, x, y, room }" },
}

return packets

end
MODULES['ReplicatedStorage/shared/lune/sim/bag'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 가방 · 장비 · 창고 — 캐릭터(sim/hero.luau의 표)가 가진 물건을 다루는 셈. 장비 하나의 셈은 sim/items.luau.
--  캐릭터의 표에 얹는 것: gear(가방의 장비 탭 — 차례가 곧 칸) · equip([부위] = 장비) · store(창고) · dust(달가루) · essence(보스의 정수) ·
--                        bagGrow(가방을 늘린 횟수) · nextItem(다음 장비 번호)
--  모든 함수는 되면 true(또는 결과), 안 되면 nil과 까닭(글)을 돌려준다. 어디서 할 수 있는지(주민 앞인지)는 서버(world.luau)가 본다.
local Items = require(script.Parent.items)

local D = Items.data
local BAG = D.BAG

local Bag = {}

local function stamp(h, it)
	it.id = h.nextItem
	h.nextItem += 1
	return it
end

-- 새 캐릭터: 처음 받는 차림을 입고 있다
function Bag.init(h)
	h.gear, h.equip, h.store = {}, {}, {}
	h.dust, h.essence, h.bagGrow, h.nextItem = 0, 0, 0, 1
	for _, it in Items.kit(h.class) do
		h.equip[it.slot] = stamp(h, it)
	end
end

function Bag.size(h): number
	return BAG.base + BAG.step * h.bagGrow
end

function Bag.storeSize(_h): number
	return BAG.storeBase
end

function Bag.free(h): number
	return Bag.size(h) - #h.gear
end

-- 물약을 얼마나 더 가질 수 있나(쓰는 것 탭의 칸마다 한 묶음)
function Bag.potionMax(h): number
	return BAG.potionStack * Bag.size(h)
end

-- 끼고 있는 장비들
function Bag.worn(h)
	local list = {}
	for _, it in h.equip do
		table.insert(list, it)
	end
	return list
end

-- 번호로 찾는다: 장비, 있는 곳("gear" · "equip" · "store"), 그 안의 자리(칸 번호나 부위)
function Bag.find(h, id: any)
	if typeof(id) ~= "number" then
		return nil
	end
	for i, it in h.gear do
		if it.id == id then
			return it, "gear", i
		end
	end
	for slot, it in h.equip do
		if it.id == id then
			return it, "equip", slot
		end
	end
	for i, it in h.store do
		if it.id == id then
			return it, "store", i
		end
	end
	return nil
end

-- 가방에 넣는다(주웠을 때 · 샀을 때)
function Bag.add(h, it): (boolean?, string?)
	if Bag.free(h) <= 0 then
		return nil, "가방이 가득 찼다"
	end
	table.insert(h.gear, stamp(h, it))
	return true
end

-- 낄 수 있는가
function Bag.canWear(h, it): (boolean?, string?)
	if it.broken then
		return nil, "부서진 장비다"
	elseif it.slot == "weapon" and it.who ~= h.class then
		return nil, "다른 직업의 무기다"
	elseif h.level < Items.needLevel(it) then
		return nil, ("Lv.%d부터 장착할 수 있다"):format(Items.needLevel(it))
	end
	return true
end

-- 가방의 장비를 낀다. 끼고 있던 것은 그 칸으로 들어간다
function Bag.equip(h, id: any): (boolean?, string?)
	local it, where, index = Bag.find(h, id)
	if not it or where ~= "gear" then
		return nil, "가방에 없는 장비다"
	end
	local ok, why = Bag.canWear(h, it)
	if not ok then
		return nil, why
	end
	local old = h.equip[it.slot]
	h.equip[it.slot] = it
	if old then
		h.gear[index] = old
	else
		table.remove(h.gear, index)
	end
	return true
end

function Bag.unequip(h, slot: any): (boolean?, string?)
	local it = if typeof(slot) == "string" then h.equip[slot] else nil
	if not it then
		return nil, "장착하고 있지 않다"
	elseif Bag.free(h) <= 0 then
		return nil, "가방이 가득 찼다"
	end
	h.equip[slot] = nil
	table.insert(h.gear, it)
	return true
end

-- 가방의 장비를 분해한다. 나온 달가루를 돌려준다
function Bag.dismantle(h, id: any): (number?, string?)
	local it, where, index = Bag.find(h, id)
	if not it or where ~= "gear" then
		return nil, "가방에 없는 장비다"
	end
	local dust = Items.dismantle(it)
	table.remove(h.gear, index)
	h.dust += dust
	return dust
end

-- 가방을 늘리는 값(더 못 늘리면 nil)
function Bag.growCost(h): number?
	return BAG.costs[h.bagGrow + 1]
end

function Bag.grow(h): (boolean?, string?)
	local cost = Bag.growCost(h)
	if not cost then
		return nil, "더 늘릴 수 없다"
	elseif h.money < cost then
		return nil, "달돈이 모자란다"
	end
	h.money -= cost
	h.bagGrow += 1
	return true
end

-- 상점에서 산다. n = 몇 개(장비는 하나씩)
function Bag.buy(h, stockId: any, n: any): (boolean?, string?)
	local stock = if typeof(stockId) == "string" then Items.stock(stockId) else nil
	if not stock then
		return nil, "없는 물건이다"
	end
	if typeof(n) ~= "number" or n ~= math.floor(n) or n < 1 or n > stock.max then
		return nil, "살 수 없는 수다"
	elseif h.level < stock.from then
		return nil, ("Lv.%d부터 산다"):format(stock.from)
	end
	local cost = Items.stockPrice(stock, h.level) * n
	if h.money < cost then
		return nil, "달돈이 모자란다"
	end
	if stock.id == "potion" then
		if h.potions + n > Bag.potionMax(h) then
			return nil, "물약을 더 가질 수 없다"
		end
		h.potions += n
	elseif stock.id == "dust" then
		h.dust += n
	else
		if Bag.free(h) <= 0 then
			return nil, "가방이 가득 찼다"
		end
		Bag.add(h, Items.make(stock.item.slot, stock.item.stage, D.NORMAL, h.class)) -- 상점의 것은 늘 보통
	end
	h.money -= cost
	return true
end

-- 강화를 한 번 시도한다. 결과("ok" · "fail" · "drop" · "boom")를 돌려준다
function Bag.enhance(h, id: any, rng, guard: boolean?): (string?, string?)
	local it, where = Bag.find(h, id)
	if not it or where == "store" then
		return nil, "가진 장비가 아니다"
	end
	local info = Items.enhanceInfo(it, guard)
	if not info.can then
		return nil, if info.why == "상한" then "더 붙일 수 없다" else "부서진 장비다"
	elseif h.dust < info.dust then
		return nil, "달가루가 모자란다"
	elseif h.essence < info.essence then
		return nil, "정수가 모자란다"
	end
	h.dust -= info.dust
	h.essence -= info.essence
	local result = Items.enhance(it, rng, guard)
	if result == "boom" and where == "equip" then
		-- 부서진 것은 끼고 있을 수 없다 — 가방으로(가득 찼어도 흔적은 들어간다)
		h.equip[it.slot] = nil
		table.insert(h.gear, it)
	end
	return result
end

local function take(h, where: string, index: any)
	if where == "gear" then
		table.remove(h.gear, index)
	elseif where == "equip" then
		h.equip[index] = nil
	end
end

-- 별 옮기기: from의 별(하나 낮춰)을 to로. from은 사라진다. 끼고 있던 것을 옮겼으면 새것을 낀다(낄 수 있을 때)
function Bag.transfer(h, fromId: any, toId: any): (boolean?, string?)
	local from, fromWhere, fromIndex = Bag.find(h, fromId)
	local to, toWhere = Bag.find(h, toId)
	if not from or not to or fromWhere == "store" or toWhere == "store" or from == to then
		return nil, "가진 장비가 아니다"
	elseif from.slot ~= to.slot then
		return nil, "같은 부위끼리만 옮긴다"
	elseif from.broken or to.broken then
		return nil, "부서진 장비다"
	elseif Items.transfer(from, to) <= to.star then
		return nil, "옮길 별이 없다"
	end
	to.star = Items.transfer(from, to)
	to.fails = 0
	take(h, fromWhere, fromIndex)
	if fromWhere == "equip" and toWhere == "gear" and Bag.canWear(h, to) then
		Bag.equip(h, to.id)
	end
	return true
end

-- 부서진 장비를 같은 장비 하나로 되살린다(spare는 가방에 있는 것 — 사라진다)
function Bag.restore(h, brokenId: any, spareId: any): (boolean?, string?)
	local it, where = Bag.find(h, brokenId)
	local spare, spareWhere, spareIndex = Bag.find(h, spareId)
	if not it or not spare or where ~= "gear" or spareWhere ~= "gear" or it == spare then
		return nil, "가방에 없는 장비다"
	elseif not Items.restore(it, spare) then
		return nil, "같은 장비가 아니다"
	end
	table.remove(h.gear, spareIndex)
	return true
end

function Bag.storeIn(h, id: any): (boolean?, string?)
	local it, where, index = Bag.find(h, id)
	if not it or where ~= "gear" then
		return nil, "가방에 없는 장비다"
	elseif #h.store >= Bag.storeSize(h) then
		return nil, "창고가 가득 찼다"
	end
	table.remove(h.gear, index)
	table.insert(h.store, it)
	return true
end

function Bag.storeOut(h, id: any): (boolean?, string?)
	local it, where, index = Bag.find(h, id)
	if not it or where ~= "store" then
		return nil, "창고에 없는 장비다"
	elseif Bag.free(h) <= 0 then
		return nil, "가방이 가득 찼다"
	end
	table.remove(h.store, index)
	table.insert(h.gear, it)
	return true
end

-- ---------- 저장 ----------
local function packItem(it)
	return { it.slot, it.stage, it.q, it.star, it.who or "", it.fails or 0, if it.broken then 1 else 0 }
end

local function unpackItem(row: any)
	if typeof(row) ~= "table" then
		return nil
	end
	local it = { slot = row[1], stage = row[2], q = row[3], star = row[4], who = if row[5] ~= "" then row[5] else nil, fails = row[6], broken = row[7] == 1 }
	if not Items.valid(it) or typeof(it.fails) ~= "number" or it.fails < 0 or it.fails > 9 then
		return nil
	end
	if it.slot ~= "weapon" then
		it.who = nil
	end
	return it
end

function Bag.pack(h)
	local out = { gear = {}, equip = {}, store = {}, dust = h.dust, essence = h.essence, grow = h.bagGrow }
	for i, it in h.gear do
		out.gear[i] = packItem(it)
	end
	for _, it in h.equip do
		table.insert(out.equip, packItem(it))
	end
	for i, it in h.store do
		out.store[i] = packItem(it)
	end
	return out
end

-- 저장된 것을 캐릭터에 얹는다. 저장된 것이 없으면(장비가 생기기 전의 캐릭터) 처음 차림 그대로 둔다. 꼴이 이상한 장비는 버린다.
function Bag.unpack(h, data: any)
	if typeof(data) ~= "table" or typeof(data.gear) ~= "table" or typeof(data.equip) ~= "table" then
		return
	end
	local function whole(v, min, max)
		return typeof(v) == "number" and v == math.floor(v) and v >= min and v <= max
	end
	h.gear, h.equip, h.store, h.nextItem = {}, {}, {}, 1
	h.bagGrow = if whole(data.grow, 0, BAG.times) then data.grow else 0
	h.dust = if whole(data.dust, 0, 9e15) then data.dust else 0
	h.essence = if whole(data.essence, 0, 9e9) then data.essence else 0
	for _, row in data.equip do
		local it = unpackItem(row)
		if it and not h.equip[it.slot] and not it.broken and (it.slot ~= "weapon" or it.who == h.class) then
			h.equip[it.slot] = stamp(h, it)
		end
	end
	for _, row in data.gear do
		local it = unpackItem(row)
		if it and #h.gear < Bag.size(h) then
			table.insert(h.gear, stamp(h, it))
		end
	end
	if typeof(data.store) == "table" then
		for _, row in data.store do
			local it = unpackItem(row)
			if it and #h.store < Bag.storeSize(h) then
				table.insert(h.store, stamp(h, it))
			end
		end
	end
end

-- ---------- 클라이언트에 보내는 것 ----------
local function viewItem(it)
	return { id = it.id, slot = it.slot, stage = it.stage, q = it.q, star = it.star, who = it.who, broken = it.broken, fails = it.fails or 0 }
end

function Bag.view(h)
	local out = { gear = {}, equip = {}, store = {}, size = Bag.size(h), storeSize = Bag.storeSize(h), dust = h.dust, essence = h.essence, growCost = Bag.growCost(h) or false }
	for i, it in h.gear do
		out.gear[i] = viewItem(it)
	end
	for slot, it in h.equip do
		out.equip[slot] = viewItem(it)
	end
	for i, it in h.store do
		out.store[i] = viewItem(it)
	end
	return out
end

return Bag

end
MODULES['ReplicatedStorage/shared/lune/sim/hero'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 캐릭터 한 명의 상태와 성장 셈 — 체력 · 경험치와 레벨업 · 능력치 · 스킬 레벨 · 물약 · 쓰러짐 · 저장 꼴. 화면 · 네트워크와 상관없는 셈만 한다(서버가 쓴다).
--  수치는 config/numbers.luau(숫자 뼈대), data/combat.generated.luau(싸움의 기본 수치), data/classes.generated.luau(직업과 스킬 목록)에서 온다.
local N = require(script.Parent.Parent.config.numbers)
local COMBAT = require(script.Parent.Parent.data["combat.generated"])
local CLASSES = require(script.Parent.Parent.data["classes.generated"])
local Items = require(script.Parent.items)
local Bag = require(script.Parent.bag)
local Quests = require(script.Parent.quests)
local Quick = require(script.Parent.Parent.ui.quick)
local RULES = COMBAT.rules
local STATS = N.data.STATS
local STAT_IDS = { "str", "dex", "int", "luk", "hp" }
local SAVE_VERSION = 1

local Hero = {}
Hero.STAT_IDS = STAT_IDS

-- 직업의 스킬 정의(이름 · 갈래 · 마스터 레벨). 지금은 1차만 있다.
local function skillDef(class: string, id: string)
	local c = CLASSES.classes[class]
	if not c then
		return nil
	end
	for _, s in c.skills do
		if s.id == id then
			return s
		end
	end
	return nil
end
Hero.skillDef = skillDef

-- 처음부터 주는 기술(사냥기 · 보스기 · 이동기)을 레벨 1로
local function grants(class: string)
	local out = {}
	for _, s in CLASSES.classes[class].skills do
		if table.find(CLASSES.skillRule.start, s.type) then
			out[s.id] = 1
		end
	end
	return out
end

-- 그 레벨까지 받은 스킬 포인트
local function spEarned(level: number): number
	local n = 0
	for L = 2, level do
		n += N.spAt(L)
	end
	return n
end
Hero.spEarned = spEarned

-- 능력치 효율: 다 주 능력치에 찍었을 때 1
function Hero.eff(h): number
	local pair = STATS.classes[h.class]
	local main, sub = h.stats[pair[1]], h.stats[pair[2]]
	return N.statAttack(STATS.base + main, STATS.base + sub) / N.statAttack(STATS.base + N.apAt(h.level), STATS.base)
end

-- 전투력 = 10 × (0.3 × 능력치 효율 × 1.07^레벨 + 0.7 × 장비 점수). 장비 점수 = 끼고 있는 장비의 점수를 더해 부위 가중치의 합으로 나눈 것(sim/items.luau)
function Hero.power(h): number
	return Items.power(h.level, Hero.eff(h), Bag.worn(h))
end
-- 반올림하기 전의 전투력(피해의 셈에 쓴다 — 능력치 1점도 피해에 그대로 들어가게)
function Hero.powerRaw(h): number
	return Items.powerRaw(h.level, Hero.eff(h), Bag.worn(h))
end

-- 끼고 있는 방어구가 줄여 주는 피해 %(그 레벨의 몬스터에게 맞을 때)
function Hero.cut(h, mobLv: number): number
	return Items.cut(Bag.worn(h), mobLv)
end

-- 체력 상한을 다시 셈한다(레벨 · 체력에 찍은 점수)
function Hero.recalc(h)
	h.maxHp = N.hpOf(h.class, h.level, h.stats.hp)
	h.hp = math.min(h.hp, h.maxHp)
end

-- 새 캐릭터(Lv.1)
function Hero.new(id: any, class: string)
	assert(CLASSES.classes[class], "없는 직업 " .. tostring(class))
	local h = {
		id = id,
		class = class,
		level = 1,
		xp = 0,
		ap = 0, -- 아직 찍지 않은 능력치 점수
		stats = { str = 0, dex = 0, int = 0, luk = 0, hp = 0 }, -- 찍은 점수(처음 값 4는 빼고)
		sp = 0, -- 아직 쓰지 않은 스킬 포인트
		skills = grants(class), -- [스킬 id] = 레벨
		auto = false, -- true면 레벨업 때 능력치 · 스킬을 저절로 찍는다. 기본은 직접 찍는다(사용자 결정) — 창의 「자동으로 찍기」 · 「추천대로 찍기」는 한 번씩 누르는 단추다
		keys = {}, -- 바꾼 키 { [하는 일] = 키 이름 } — 기본과 다른 것만(클라이언트가 보낸 것을 꼴만 보고 담아 둔다)
		slots = Quick.start(CLASSES.classes[class].skills), -- 퀵슬롯: 칸마다 "potion" · 스킬의 이름표 · false(빈 칸) — shared/lune/ui/quick.luau
		-- 스마트폰의 단추 배치: 같은 열두 칸이지만 PC의 것과 따로 둔다 — PC에서는 손에 익은 키(E · D …)에, 폰에서는 큰 단추에 놓고 싶은 것이 서로 다르다(2026-10-08).
		--  한쪽에서 바꿔도 다른 쪽은 그대로다. 처음 차림은 같다(물약 · 사냥기 · 보스기 · 이동기)
		tslots = Quick.start(CLASSES.classes[class].skills),
		money = 0,
		potions = RULES.startPotions,
		hp = 0,
		maxHp = 0,
		alive = true,
		x = 0,
		y = 0,
		dir = 1,
		invuln = 0, -- 맞은 뒤 무적이 남은 시간(초)
		weak = 0, -- 쓰러진 뒤 벌칙이 남은 시간(초)
		potionWait = 0,
		revive = 0, -- 쓰러진 뒤 일어나기까지 남은 시간(초)
	}
	Bag.init(h) -- 처음 받는 차림(무기와 방어구 네 부위)을 입고 있다
	h.quests = {} -- 퀘스트의 상태(sim/quests.luau의 book)
	Quests.start(h.quests, h.level) -- 첫 메인 퀘스트는 저절로 받는다
	h.maxHp = N.hpOf(class, 1)
	h.hp = h.maxHp
	return h
end

function Hero.xpNeed(h): number
	return N.xpNeed(h.level)
end

-- ---------- 능력치 ----------
-- 능력치에 n점을 찍는다. 찍었으면 true.
function Hero.addStat(h, stat: string, n: number): boolean
	if not table.find(STAT_IDS, stat) or n ~= math.floor(n) or n < 1 or n > h.ap then
		return false
	end
	h.stats[stat] += n
	h.ap -= n
	Hero.recalc(h)
	return true
end

-- 남은 점수를 모두 주 능력치에(「자동으로 찍기」)
function Hero.autoStat(h): number
	local n = h.ap
	if n > 0 then
		Hero.addStat(h, STATS.classes[h.class][1], n)
	end
	return n
end

-- ---------- 스킬 ----------
function Hero.skillLevel(h, id: string): number
	return h.skills[id] or 0
end

-- 스킬 레벨에 따른 세기(레벨 1에서 floor, 마스터에서 1). 배우지 않았으면 0.
function Hero.skillScale(lv: number, max: number): number
	if lv <= 0 then
		return 0
	end
	local floor = CLASSES.skillRule.floor
	return floor + (1 - floor) * (if max > 1 then (lv - 1) / (max - 1) else 1)
end
function Hero.scale(h, id: string): number
	local def = skillDef(h.class, id)
	return if def then Hero.skillScale(Hero.skillLevel(h, id), def.max) else 0
end

-- 스킬 포인트 1점으로 스킬을 한 레벨 올린다. 올렸으면 true.
function Hero.skillUp(h, id: string): boolean
	local def = skillDef(h.class, id)
	if not def or h.sp < 1 or Hero.skillLevel(h, id) >= def.max then
		return false
	end
	h.skills[id] = Hero.skillLevel(h, id) + 1
	h.sp -= 1
	return true
end

-- 남은 스킬 포인트를 추천 순서로 모두 쓴다(「추천대로 찍기」): 사냥기 → 보스기 → 핵심 장치 → 버프 → 나머지
local PRIORITY = { mob = 1, boss = 2, core = 3, buff = 4 }
function Hero.autoSkill(h): number
	local list = table.clone(CLASSES.classes[h.class].skills)
	local index = {}
	for i, s in list do
		index[s.id] = i
	end
	table.sort(list, function(a, b)
		local pa, pb = PRIORITY[a.type] or 9, PRIORITY[b.type] or 9
		if pa ~= pb then
			return pa < pb
		end
		return index[a.id] < index[b.id]
	end)
	local spent = 0
	for _, s in list do
		while h.sp > 0 and Hero.skillUp(h, s.id) do
			spent += 1
		end
	end
	return spent
end

-- ---------- 경험치 ----------
-- 경험치를 얻는다. 오른 레벨 수를 돌려준다.
function Hero.gainXp(h, amount: number): number
	local ups = 0
	if h.level >= N.MAX_LEVEL then
		return 0
	end
	h.xp += amount
	while h.level < N.MAX_LEVEL and h.xp >= N.xpNeed(h.level) do
		h.xp -= N.xpNeed(h.level)
		h.level += 1
		h.ap += STATS.perLevel
		h.sp += N.spAt(h.level)
		ups += 1
	end
	if h.level >= N.MAX_LEVEL then
		h.xp = 0
	end
	if ups > 0 then
		if h.auto then
			Hero.autoStat(h)
			Hero.autoSkill(h)
		end
		h.maxHp = N.hpOf(h.class, h.level, h.stats.hp)
		h.hp = h.maxHp -- 레벨이 오르면 체력이 다 찬다
	end
	return ups
end

-- 몬스터를 잡았을 때의 경험치(레벨 차이 · 쓰러진 뒤의 벌칙을 넣은 값)
function Hero.killXp(h, mobLevel: number, mobHpMul: number): number
	local xp = N.mobXp(mobLevel) * mobHpMul * N.xpRate(h.level, mobLevel) / 100
	if h.weak > 0 then
		xp *= 1 - N.data.BODY.death.cut / 100
	end
	return math.max(1, math.floor(xp + 0.5))
end

-- ---------- 맞기 · 물약 · 쓰러짐 ----------
-- 맞는다. 실제로 들어간 피해를 돌려준다(무적 중이거나 쓰러져 있으면 0).
function Hero.hurt(h, amount: number): number
	if not h.alive or h.invuln > 0 then
		return 0
	end
	local dmg = math.max(1, math.floor(amount + 0.5))
	h.hp = math.max(0, h.hp - dmg)
	h.invuln = RULES.invuln
	if h.hp <= 0 then
		h.alive = false
		h.revive = RULES.reviveWait
		-- 벌칙은 숫자 뼈대대로 정해 둔 레벨부터(그 전에는 벌칙이 없다)
		if h.level >= N.data.BODY.death.free then
			h.weak = N.deathMinutes(h.level) * 60
		end
	end
	return dmg
end

-- 물약을 마신다. 회복한 양을 돌려준다(못 마셨으면 nil).
function Hero.drink(h): number?
	if not h.alive or h.potions <= 0 or h.potionWait > 0 or h.hp >= h.maxHp then
		return nil
	end
	local potion = N.potionAt(h.level)
	local heal = math.floor(h.maxHp * potion.heal / 100 + 0.5)
	local before = h.hp
	h.hp = math.min(h.maxHp, h.hp + heal)
	h.potions -= 1
	h.potionWait = N.data.BODY.cooldown.field
	return h.hp - before
end

-- 시간이 흐른다. 쓰러져 있다가 일어날 때가 되면 true를 돌려준다(일으키는 것은 부른 쪽이 한다).
function Hero.tick(h, dt: number): boolean
	h.invuln = math.max(0, h.invuln - dt)
	h.weak = math.max(0, h.weak - dt)
	h.potionWait = math.max(0, h.potionWait - dt)
	if not h.alive then
		h.revive -= dt
		return h.revive <= 0
	end
	return false
end

function Hero.revive(h)
	h.alive = true
	h.hp = h.maxHp
	h.invuln = 2
	h.revive = 0
end

-- ---------- 퀘스트 ----------
-- 퀘스트를 돌려주고 보상을 받는다. 돌려주는 것: 보상, 오른 레벨 수(안 됐으면 nil과 까닭)
function Hero.questDone(h, id: any)
	local reward, why = Quests.complete(h.quests, id)
	if not reward then
		return nil, why
	end
	h.money += reward.money
	h.potions = math.min(h.potions + reward.potions, Bag.potionMax(h))
	local ups = Hero.gainXp(h, reward.xp)
	return reward, ups
end

-- ---------- 키 설정 ----------
-- 바꾼 키의 표를 받아 둔다. 꼴이 맞는 것만 담는다(하는 일 이름 · 키 이름은 글자와 숫자, 마흔여덟 개까지). 담았으면 true.
local function cleanKeys(map: any)
	if typeof(map) ~= "table" then
		return nil
	end
	local out, n = {}, 0
	for action, key in map do
		if typeof(action) ~= "string" or typeof(key) ~= "string" or #action > 40 or #key > 24 then
			return nil
		end
		if not string.match(action, "^[%w:_]+$") or not string.match(key, "^%w+$") then
			return nil
		end
		n += 1
		if n > 48 then
			return nil
		end
		out[action] = key
	end
	return out
end

-- 퀵슬롯에 놓아도 되는 스킬인가: 이 직업이 키로 쓰는 기술(싸움 수치가 있는 것)이고 배운 것
function Hero.canSlot(h, id: string): boolean
	local def = COMBAT.skills[id]
	return def ~= nil and def.who == h.class and (h.skills[id] or 0) > 0
end

-- 퀵슬롯을 바꾼다(클라이언트가 보낸 칸들 — 꼴과 놓아도 되는 것인지를 본다). touch = 스마트폰의 단추 배치(tslots)를 바꾼다
function Hero.setSlots(h, list: any, touch: boolean?): boolean
	local slots = Quick.clean(list, function(id)
		return Hero.canSlot(h, id)
	end)
	if not slots then
		return false
	end
	if touch then
		h.tslots = slots
	else
		h.slots = slots
	end
	return true
end

function Hero.setKeys(h, map: any): boolean
	local keys = cleanKeys(map)
	if not keys then
		return false
	end
	h.keys = keys
	return true
end

-- ---------- 저장 ----------
-- 저장할 꼴(숫자와 글만). 자리 · 체력 · 무적 같은 그때그때의 것은 넣지 않는다.
function Hero.pack(h)
	return {
		v = SAVE_VERSION,
		class = h.class,
		level = h.level,
		xp = h.xp,
		ap = h.ap,
		stats = table.clone(h.stats),
		sp = h.sp,
		skills = table.clone(h.skills),
		auto = h.auto,
		keys = table.clone(h.keys),
		slots = table.clone(h.slots),
		tslots = table.clone(h.tslots),
		money = h.money,
		potions = h.potions,
		weak = math.floor(h.weak),
		bag = Bag.pack(h),
		quests = Quests.pack(h.quests),
	}
end

local function whole(v: any, min: number, max: number): boolean
	return typeof(v) == "number" and v == math.floor(v) and v >= min and v <= max
end

-- 저장된 것에서 캐릭터를 되살린다. 꼴이 이상하면 nil(새로 골라야 한다).
--  점수가 받은 것보다 많이 찍혀 있으면(식이 바뀌었거나 자료가 깨졌을 때) 찍은 것을 모두 되돌려 준다 — 레벨과 돈은 지킨다.
function Hero.unpack(id: any, data: any)
	if typeof(data) ~= "table" or not CLASSES.classes[data.class] or not whole(data.level, 1, N.MAX_LEVEL) then
		return nil
	end
	local h = Hero.new(id, data.class)
	h.level = data.level
	h.xp = if typeof(data.xp) == "number" and data.xp >= 0 and data.xp < N.xpNeed(h.level) then math.floor(data.xp) else 0
	h.money = if whole(data.money, 0, 9e15) then data.money else 0
	h.potions = if whole(data.potions, 0, 9999) then data.potions else RULES.startPotions
	h.weak = if whole(data.weak, 0, 3600) then data.weak else 0
	h.auto = data.auto == true
	h.keys = cleanKeys(data.keys) or {}
	Bag.unpack(h, data.bag) -- 장비가 생기기 전에 저장된 캐릭터는 처음 차림을 받는다
	h.quests = Quests.unpack(data.quests)
	Quests.start(h.quests, h.level) -- 퀘스트가 생기기 전에 저장된 캐릭터도 첫 메인을 받는다

	-- 능력치: 찍은 것 + 남은 것 = 그 레벨까지 받은 것
	local earned = N.apAt(h.level)
	local used, ok = 0, typeof(data.stats) == "table"
	if ok then
		for _, s in STAT_IDS do
			if whole(data.stats[s], 0, earned) then
				h.stats[s] = data.stats[s]
				used += data.stats[s]
			else
				ok = false
			end
		end
	end
	if ok and used <= earned then
		h.ap = earned - used
	else
		h.stats = { str = 0, dex = 0, int = 0, luk = 0, hp = 0 }
		h.ap = earned
	end

	-- 스킬: 처음부터 주는 것은 늘 1 이상, 쓴 포인트는 받은 것을 넘지 않는다
	local base = grants(h.class)
	local spent, good = 0, typeof(data.skills) == "table"
	local skills = table.clone(base)
	if good then
		for sid, lv in data.skills do
			local def = skillDef(h.class, sid)
			if def and whole(lv, 0, def.max) then
				skills[sid] = math.max(lv, base[sid] or 0)
				spent += skills[sid] - (base[sid] or 0)
			else
				good = false
			end
		end
	end
	if good and spent <= spEarned(h.level) then
		h.skills = skills
		h.sp = spEarned(h.level) - spent
	else
		h.skills = base
		h.sp = spEarned(h.level)
	end
	-- 퀵슬롯: 저장된 것이 말이 되면 그대로, 아니면(퀵슬롯이 생기기 전에 저장된 캐릭터 포함) 처음 차림(Hero.new가 놓아 둔 것)
	if data.slots ~= nil then
		Hero.setSlots(h, data.slots)
	end
	-- 스마트폰의 단추 배치: 저장된 것이 말이 되면 그대로, 없으면(이것이 생기기 전에 저장된 캐릭터) 처음 차림
	if data.tslots ~= nil then
		Hero.setSlots(h, data.tslots, true)
	end

	h.maxHp = N.hpOf(h.class, h.level, h.stats.hp)
	h.hp = h.maxHp
	return h
end

-- 클라이언트에 보내는 내 상태
function Hero.view(h)
	return {
		class = h.class,
		level = h.level,
		xp = h.xp,
		need = N.xpNeed(h.level),
		hp = h.hp,
		maxHp = h.maxHp,
		money = h.money,
		potions = h.potions,
		ap = h.ap,
		stats = h.stats,
		sp = h.sp,
		skills = h.skills,
		power = Hero.power(h),
		keys = h.keys,
		slots = h.slots,
		tslots = h.tslots,
		alive = h.alive,
		weak = math.ceil(h.weak),
	}
end

return Hero

end
MODULES['ReplicatedStorage/shared/lune/sim/items'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 장비의 셈 — 이름 · 점수 · 떨어지는 것 · 강화 · 분해 · 별 옮기기. 화면도 서버도 모르는 순수한 셈이다.
--  수치는 data/items.generated.luau(공방 js/lune/design/items.js와 numbers.js · basics.js · economy.js에서 내보낸 것). 식은 공방과 같은 것을 다시 짰다 —
--  tools/test/tests/15_lune_items.luau가 공방에서 셈한 값(checks)과 맞춰 본다.
--  장비 하나 = { id(가진 사람 안에서의 번호), slot, stage(장비 단계), q(성능 단 1 낡은 … 5 빼어난), star, who(무기만: 어느 직업의 것),
--                fails(잇달아 떨어진 횟수), broken(부서져 흔적만 남았는가) }
local D = require(script.Parent.Parent.data["items.generated"])
local N = require(script.Parent.Parent.config.numbers)

local POWER = N.data.POWER
local E = D.ENHANCE

local Items = {}
Items.data = D
Items.NORMAL = D.NORMAL

local SLOT = {}
for i, s in D.SLOTS do
	SLOT[s.id] = s
	s.order = i
end
local ARMOR = {}
for _, id in D.ARMOR do
	ARMOR[id] = true
end
local STOCK = {}
for _, s in D.STOCK do
	STOCK[s.id] = s
end

local function round(v: number): number
	return math.floor(v + 0.5)
end

function Items.slot(id: string)
	return SLOT[id]
end

function Items.isArmor(id: string): boolean
	return ARMOR[id] == true
end

function Items.stock(id: string)
	return STOCK[id]
end

-- ---------- 만들기 · 꼴 ----------
function Items.make(slot: string, stage: number, q: number?, who: string?)
	assert(SLOT[slot], "없는 부위 " .. tostring(slot))
	return { slot = slot, stage = stage, q = q or D.NORMAL, star = 0, who = if slot == "weapon" then who else nil, fails = 0, broken = false }
end

-- 저장된 것 · 받은 것의 꼴이 맞는가
function Items.valid(it: any): boolean
	if typeof(it) ~= "table" or not SLOT[it.slot] then
		return false
	end
	local function whole(v, min, max)
		return typeof(v) == "number" and v == math.floor(v) and v >= min and v <= max
	end
	if not whole(it.stage, 1, 200) or not whole(it.q, 1, #D.QUALITY) or not whole(it.star, 0, E.max) then
		return false
	end
	if it.slot == "weapon" and D.KINDS[it.who] == nil then
		return false
	end
	return it.star <= Items.starCap(it.stage)
end

-- 같은 장비인가(부서진 것을 되살릴 때 쓴다): 부위 · 단계 · 무기라면 직업
function Items.same(a, b): boolean
	return a.slot == b.slot and a.stage == b.stage and a.who == b.who
end

-- 낄 수 있는 레벨(사냥 장비는 단계가 곧 레벨이다)
function Items.needLevel(it): number
	return it.need or it.stage
end

-- ---------- 이름 ----------
function Items.material(stage: number): string
	for _, m in D.MATERIAL do
		if stage < m.below then
			return m.name
		end
	end
	return D.MATERIAL[#D.MATERIAL].name
end

function Items.baseName(it): string
	if it.slot == "weapon" then
		return D.KINDS[it.who]
	end
	return Items.material(it.stage) .. " " .. SLOT[it.slot].name
end

function Items.name(it): string
	local head = if it.q == D.NORMAL then "" else D.QUALITY[it.q].name .. " "
	return ("%sLv.%d %s"):format(head, it.stage, Items.baseName(it))
end

-- ---------- 점수 · 전투력 · 방어 ----------
function Items.score(it): number
	if it.broken then
		return 0
	end
	return SLOT[it.slot].w * POWER.grow ^ it.stage * D.STAR ^ it.star * (1 + D.QUALITY[it.q].bonus / 100)
end

-- list = 끼고 있는 장비들(차례는 상관없다)
function Items.gearScore(list): number
	local sum = 0
	for _, it in list do
		sum += Items.score(it)
	end
	return sum / D.WSUM
end

function Items.power(level: number, eff: number, list): number
	return round(Items.powerRaw(level, eff, list))
end
-- 반올림하기 전의 전투력 — 피해를 셈할 때 쓴다. 화면의 전투력(정수)으로 셈하면 능력치 1점(낮은 레벨에서 +0.3쯤)이 반올림에 묻혀 피해가 그대로일 때가 있다
--  (사용자 2026-10-07: "스킬을찍거나, 스텟이 증가했을때 데미지가 증가하고있는지 확인하세요")
function Items.powerRaw(level: number, eff: number, list): number
	return POWER.base * (POWER.levelShare * eff * POWER.grow ^ level + POWER.itemShare * Items.gearScore(list))
end

-- 방어구가 줄여 주는 피해 %: 부위마다 4분의 1씩(빈 부위 · 부서진 것은 0)
function Items.cut(list, mobLv: number): number
	local sum = 0
	for _, it in list do
		if ARMOR[it.slot] and not it.broken then
			sum += N.armorCut(it.stage, mobLv)
		end
	end
	return sum / #D.ARMOR
end

function Items.starCap(stage: number): number
	for _, s in D.STARCAP do
		if stage < s.below then
			return s.cap
		end
	end
	return E.max
end

-- ---------- 처음 받는 차림 ----------
function Items.kit(who: string)
	local list = {}
	for _, slot in D.KIT.slots do
		table.insert(list, Items.make(slot, D.KIT.stage, D.NORMAL, who))
	end
	return list
end

-- ---------- 떨어지는 것 ----------
function Items.stageOf(mobLv: number): number
	if mobLv < 10 then
		return 1
	end
	return math.min(D.STAGES[#D.STAGES], math.floor(mobLv / 10) * 10)
end

function Items.rollQuality(rng): number
	local roll, acc = rng:NextNumber(0, 100), 0
	for i, q in D.QUALITY do
		acc += q.pct
		if roll < acc then
			return i
		end
	end
	return D.NORMAL
end

-- 몬스터 한 마리가 떨어뜨리는 장비(없으면 nil). who = 잡은 사람의 직업. mul = 확률에 곱하는 값(쓰러진 뒤의 벌칙 등)
function Items.rollDrop(rng, mobLv: number, who: string, mul: number?)
	local m = mul or 1
	local roll = rng:NextNumber(0, 100)
	local a, b, c = D.DROP.weapon * m, D.DROP.other * m, D.DROP.armor * m
	local stage = Items.stageOf(mobLv)
	if roll < a then
		return Items.make("weapon", stage, Items.rollQuality(rng), who)
	elseif roll < a + b then
		-- 다른 직업의 무기(넷 가운데 하나)
		local others = {}
		for class in D.KINDS do
			if class ~= who then
				table.insert(others, class)
			end
		end
		table.sort(others)
		return Items.make("weapon", stage, Items.rollQuality(rng), others[rng:NextInteger(1, #others)])
	elseif roll < a + b + c then
		return Items.make(D.ARMOR[rng:NextInteger(1, #D.ARMOR)], stage, Items.rollQuality(rng))
	end
	return nil
end

-- 달가루가 떨어지는 꼴: 확률(%)과 한 번에 떨어지는 양(소수일 수 있다). 평균 = 0.01 × (레벨/10)³
function Items.dustDrop(mobLv: number): (number, number)
	local avg = D.DUST.kill * (mobLv / 10) ^ 3
	local chance = math.min(D.DROP.dustChance / 100, avg)
	return chance * 100, avg / chance
end

-- 몬스터 한 마리가 떨어뜨리는 달가루(없으면 nil). 양의 소수 부분은 확률로 올린다 — 평균이 식과 꼭 같다
function Items.rollDust(rng, mobLv: number, mul: number?): number?
	local chance, amount = Items.dustDrop(mobLv)
	if rng:NextNumber(0, 100) >= chance * (mul or 1) then
		return nil
	end
	local whole = math.floor(amount)
	if rng:NextNumber(0, 1) < amount - whole then
		whole += 1
	end
	return math.max(1, whole)
end

-- ---------- 강화 ----------
-- star성에서 다음 별을 시도할 때 드는 달가루
function Items.enhanceDust(stage: number, star: number): number
	local unit = (stage / 10) ^ 3
	if star < E.lowBelow then
		return round(unit * (star + 1) / E.lowDiv)
	end
	return round(unit * (star + 1) ^ E.highPow / E.highDiv)
end

-- 그 별까지 한 번씩 붙었다고 본 달가루
function Items.starDust(stage: number, star: number): number
	local sum = 0
	for n = 0, star - 1 do
		sum += Items.enhanceDust(stage, n)
	end
	return sum
end

-- 다음 시도의 내용. guard = 파괴 막기를 켰는가.
--  { can(시도할 수 있는가), why, ok · fail · boom(%), dust, essence, drops(실패하면 떨어지는가), sure(반드시 성공인가), guard(파괴 막기를 쓸 수 있는 별인가) }
function Items.enhanceInfo(it, guard: boolean?)
	local s = it.star
	if it.broken then
		return { can = false, why = "부서짐" }
	end
	if s >= Items.starCap(it.stage) or s >= E.max then
		return { can = false, why = "상한" }
	end
	local row = E.table[s + 1]
	local canGuard = table.find(E.guard.stars, s + 1) ~= nil
	local useGuard = guard == true and canGuard
	local info = {
		can = true,
		ok = row[1],
		fail = row[2],
		boom = row[3],
		dust = Items.enhanceDust(it.stage, s) * (if useGuard then E.guard.cost else 1),
		essence = E.essence[s + 1],
		drops = s + 1 >= E.dropFrom and table.find(E.floors, s) == nil,
		sure = (it.fails or 0) >= E.chance,
		guard = canGuard,
	}
	if useGuard then
		info.fail += info.boom
		info.boom = 0
	end
	if info.sure then
		info.ok, info.fail, info.boom = 100, 0, 0
	end
	return info
end

-- 강화를 한 번 시도한다(값은 부른 쪽이 치른다). 결과: "ok" 붙음 · "fail" 그대로 · "drop" 한 단계 떨어짐 · "boom" 부서짐
function Items.enhance(it, rng, guard: boolean?): string
	local info = Items.enhanceInfo(it, guard)
	assert(info.can, "강화할 수 없는 장비")
	local roll = rng:NextNumber(0, 100)
	if roll < info.ok then
		it.star += 1
		it.fails = 0
		return "ok"
	elseif roll < info.ok + info.boom then
		it.star = math.min(E.boomTo, it.star)
		it.fails = 0
		it.broken = true
		return "boom"
	elseif info.drops then
		it.star -= 1
		it.fails = (it.fails or 0) + 1
		return "drop"
	end
	return "fail"
end

-- 부서진 장비를 같은 장비 하나로 되살린다(spare는 부른 쪽이 없앤다). 되살렸으면 true
function Items.restore(it, spare): boolean
	if not it.broken or spare.broken or not Items.same(it, spare) then
		return false
	end
	it.broken = false -- 별은 부서질 때 이미 12성(그보다 낮았으면 그대로)으로 내려 두었다
	it.fails = 0
	return true
end

-- ---------- 분해 · 별 옮기기 ----------
function Items.dismantle(it): number
	return round(D.DUST.dismantle * (it.stage / 10) ^ 3 + D.DUST.back / 100 * Items.starDust(it.stage, it.star))
end

-- 옛 장비의 별을 새 장비로 옮겼을 때 새 장비의 별(옛 별에서 하나를 뺀 만큼, 새 장비의 상한까지 — 이미 더 높으면 그대로)
function Items.transfer(from, to): number
	return math.max(to.star, math.min(Items.starCap(to.stage), math.max(0, from.star - 1)))
end

-- ---------- 상점 ----------
-- 그 물건의 값(물약은 내 레벨에 맞는 물약의 값)
function Items.stockPrice(stock, level: number): number
	if stock.id == "potion" then
		return N.potionAt(level).price
	end
	return stock.price
end

return Items

end
MODULES['ReplicatedStorage/shared/lune/sim/party'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 파티 — 넷까지(사용자 결정). 초대 → 받기 / 거절, 나가기, 파티장 넘기기(파티장이 나가면 먼저 들어온 사람에게), 둘 아래로 줄면 흩어진다.
--  누가 어느 파티인지만 다루는 순수한 셈이다(사람 = 번호). 경험치를 나누는 몫도 여기서 낸다:
--   같은 맵에서 함께 잡으면 몬스터의 경험치 x (1 + 보너스)를 사람 수로 고르게 나눈다(보너스: 둘 10% · 셋 15% · 넷 20% — 공방 「성장 · 장비」 탭의 XPRULE).
--   예: 둘이면 한 사람이 55%씩 — 둘이 잡으면 두 배 빨리 잡으니 혼자일 때의 110%다. 레벨 차이가 20을 넘는 파티원과는 나누지 않는다.
local N = require(script.Parent.Parent.config.numbers)

local RULE = N.data.XPRULE

local Party = {}
Party.MAX = RULE.partyMax
Party.ASK_LIFE = 30 -- 초대가 살아 있는 시간(초)
Party.LEVEL_GAP = 20 -- 이보다 레벨 차이가 크면 경험치를 나누지 않는다

-- 장부: parties[번호] = { id, leader, members = { 들어온 차례대로 } } · of[사람] = 파티 번호 · asks[받은 사람] = { from, at }
function Party.newBook()
	return { parties = {}, of = {}, asks = {}, nextId = 1 }
end

function Party.of(book, who: any)
	local id = book.of[who]
	return if id then book.parties[id] else nil
end

-- 그 사람의 파티원들(자기도 든다). 파티가 없으면 혼자
function Party.members(book, who: any): { any }
	local party = Party.of(book, who)
	return if party then table.clone(party.members) else { who }
end

function Party.same(book, a: any, b: any): boolean
	return a == b or (book.of[a] ~= nil and book.of[a] == book.of[b])
end

-- 살아 있는 초대(시간이 지난 것은 지운다)
function Party.ask(book, to: any, now: number)
	local ask = book.asks[to]
	if ask and now - ask.at > Party.ASK_LIFE then
		book.asks[to] = nil
		return nil
	end
	return ask
end

-- 초대한다. 파티가 없는 사람이 초대하면 받는 순간 파티가 생기고 초대한 사람이 파티장이 된다
function Party.invite(book, from: any, to: any, now: number): (boolean?, string?)
	if from == to then
		return nil, "자기 자신은 초대할 수 없다"
	elseif book.of[to] then
		return nil, "이미 파티가 있는 사람이다"
	end
	local party = Party.of(book, from)
	if party then
		if party.leader ~= from then
			return nil, "파티장만 초대한다"
		elseif #party.members >= Party.MAX then
			return nil, "파티가 가득 찼다"
		end
	end
	if Party.ask(book, to, now) then
		return nil, "이미 초대를 받고 있는 사람이다"
	end
	book.asks[to] = { from = from, at = now }
	return true
end

-- 초대를 받는다. 들어간 파티를 돌려준다
function Party.accept(book, to: any, now: number)
	local ask = Party.ask(book, to, now)
	if not ask then
		return nil, "받은 초대가 없다"
	end
	book.asks[to] = nil
	if book.of[to] then
		return nil, "이미 파티가 있다"
	end
	local party = Party.of(book, ask.from)
	if not party then
		party = { id = book.nextId, leader = ask.from, members = { ask.from } }
		book.nextId += 1
		book.parties[party.id] = party
		book.of[ask.from] = party.id
	end
	if #party.members >= Party.MAX then
		return nil, "파티가 가득 찼다"
	end
	table.insert(party.members, to)
	book.of[to] = party.id
	return party
end

-- 초대를 거절한다. 초대한 사람을 돌려준다(초대가 없었으면 nil)
function Party.decline(book, to: any): any
	local ask = book.asks[to]
	book.asks[to] = nil
	return if ask then ask.from else nil
end

-- 나간다(접속을 끊었을 때도). 돌려주는 것: 남은 사람들(흩어졌으면 그 마지막 한 사람까지), 흩어졌는가
function Party.leave(book, who: any): ({ any }, boolean)
	book.asks[who] = nil
	local party = Party.of(book, who)
	if not party then
		return {}, false
	end
	local index = table.find(party.members, who)
	table.remove(party.members, index)
	book.of[who] = nil
	local left = table.clone(party.members)
	if #party.members < 2 then
		for _, m in party.members do
			book.of[m] = nil
		end
		book.parties[party.id] = nil
		return left, true
	end
	if party.leader == who then
		party.leader = party.members[1]
	end
	return left, false
end

-- 함께 잡은 사람 수에 따른 보너스 %
function Party.bonus(n: number): number
	local bonus = 0
	for _, row in RULE.party do
		if n >= row.n then
			bonus = row.bonus
		end
	end
	return bonus
end

-- 함께 잡은 사람이 n이면 한 사람이 몬스터 경험치의 몇 배를 받나(혼자면 1)
function Party.share(n: number): number
	if n <= 1 then
		return 1
	end
	return (1 + Party.bonus(n) / 100) / n
end

-- 경험치를 나눌 사람들: killer의 파티원 가운데 here(같은 맵에 있는 살아 있는 사람들 { [번호] = { level } })에 있고 레벨 차이가 20 안쪽인 사람(killer도 든다)
function Party.mates(book, killer: any, here): { any }
	local me = here[killer]
	local list = {}
	for _, m in Party.members(book, killer) do
		local other = here[m]
		if m == killer or (other and me and math.abs(other.level - me.level) <= Party.LEVEL_GAP) then
			table.insert(list, m)
		end
	end
	return list
end

return Party

end
MODULES['ReplicatedStorage/shared/lune/sim/physics'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 횡스크롤 움직임 — 달리기 · 뛰기 · 떨어지기 · 발판. 화면과 상관없는 셈만 한다(클라이언트가 제 캐릭터를 움직이고, 서버가 같은 식으로 따져 본다).
--  공방 「횡스크롤 시험」 탭(dino-workshop/js/lune/luneTab.js)의 step()을 그대로 옮겼다.
--  장면의 칸(rows): "#" 막힌 칸 · "=" 아래에서 올라탈 수 있는 얇은 발판(↓를 누르면 내려간다) · "^" 가시 · "." 빈 칸.
--  body = { x, y, vx, vy, ground } — (x, y)는 발밑 가운데.  input = { mx = -1 | 0 | 1, jump = 이번 걸음에 뛰기를 눌렀나, down = ↓를 누르고 있나, speed = 빠르기 배수(없으면 1),
--          vx = 가로 빠르기를 직접 준다(대쉬 · 기술 중의 이동), float = 떨어지지 않는다(대쉬) }
local G = require(script.Parent.Parent.config.game)

local T = G.TILE
local HALF = G.BOX_W / 2

local P = {}

-- 칸 하나. 맵 위는 빈 칸, 맵 아래와 좌우 밖은 막힌 칸이다.
function P.cell(scene, tx: number, ty: number): string
	if ty < 0 then
		return "."
	end
	if ty >= scene.h or tx < 0 or tx >= scene.w then
		return "#"
	end
	return string.sub(scene.rows[ty + 1], tx + 1, tx + 1)
end

-- 발밑 가운데가 (x, y)인 몸 상자가 막힌 칸에 걸리는가.
function P.solidBox(scene, x: number, y: number): boolean
	for ty = math.floor((y - G.BOX_H) / T), math.floor((y - 1) / T) do
		for tx = math.floor((x - HALF) / T), math.floor((x + HALF - 1) / T) do
			if P.cell(scene, tx, ty) == "#" then
				return true
			end
		end
	end
	return false
end

function P.newBody(scene)
	return { x = scene.spawn.x, y = scene.spawn.y, vx = 0, vy = 0, ground = false }
end

function P.respawn(scene, body)
	body.x, body.y, body.vx, body.vy, body.ground = scene.spawn.x, scene.spawn.y, 0, 0, false
end

-- 한 걸음(dt초). 맵 아래로 떨어져 시작 자리로 돌아갔으면 "respawn"을 돌려준다.
--  가시("^")는 닿아도 아무 일도 일어나지 않는다 — 사용자 2026-10-07: "가시맞고 돌아가는거 없애세요 가시맞고 돌아간다음에 몬스터랑 전투도안되고 고장나네요"
--   (고장난 까닭: 화면에서만 시작 자리로 옮겨지고 서버는 그 순간이동을 믿지 않아, 그 뒤로 서버가 아는 자리와 어긋났다. 맵 아래로 떨어진 때를 위해 서버는 시작 자리로 온 보고는 받는다 — world.luau의 onMove)
function P.step(scene, body, input, dt: number): string?
	local mx = input.mx or 0
	body.vx = if input.vx ~= nil then input.vx else mx * G.RUN * (input.speed or 1)
	if input.jump and body.ground and not input.float then
		body.vy = -G.JUMP
		body.ground = false
	end

	local nx = body.x + body.vx * dt
	if not P.solidBox(scene, nx, body.y) then
		body.x = nx
	end

	body.vy = if input.float then 0 else math.min(body.vy + G.GRAVITY * dt, G.MAX_FALL) -- 대쉬 중에는 높이를 지킨다
	local ny = body.y + body.vy * dt
	if input.float then
		-- 떨어지지 않는다
	elseif body.vy >= 0 then
		-- 내려가는 중: 막힌 칸이나 발판 윗면에 선다
		local land: number? = nil
		local ty = math.floor(body.y / T)
		while ty <= math.floor(ny / T) and land == nil do
			for tx = math.floor((body.x - HALF) / T), math.floor((body.x + HALF - 1) / T) do
				local k = P.cell(scene, tx, ty)
				if k == "#" or (k == "=" and body.y <= ty * T and not input.down) then
					land = ty * T
					break
				end
			end
			ty += 1
		end
		if land ~= nil and ny >= land then
			body.y, body.vy, body.ground = land, 0, true
		else
			body.y, body.ground = ny, false
		end
	elseif P.solidBox(scene, body.x, ny) then
		body.vy = 0 -- 머리가 닿았다
	else
		body.y, body.ground = ny, false
	end

	if body.y > scene.h * T + G.FALL_OUT then
		P.respawn(scene, body)
		return "respawn"
	end
	return nil
end

-- 지금 보일 동작 이름(서 있기 · 달리기 · 뛰기 · 떨어지기)
function P.clipOf(body, mx: number): string
	if not body.ground then
		return if body.vy < 0 then "jump" else "fall"
	end
	return if mx ~= 0 then "run" else "idle"
end

return P

end
MODULES['ReplicatedStorage/shared/lune/sim/quests'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 퀘스트의 셈 — 받기 · 잡은 것 세기 · 다 됐는지 · 돌려주기. 화면도 서버도 모르는 순수한 셈이다.
--  자료는 data/quests.generated.luau(공방 js/lune/design/questplay.js에서 내보낸 것): 누구에게서 받고 · 무엇을 몇 개 · 누구에게 돌려주고 · 무엇을 받나.
--  사람마다의 상태(book) = { [퀘스트 id] = { done = 끝냈는가, c = { [할 일 차례] = 지금까지의 수 } } } — 받지 않은 퀘스트는 들어 있지 않다.
--  서버는 캐릭터의 표에(h.quests), 클라이언트는 서버가 보내 준 것을 그대로 갖고 같은 함수로 주민 머리 위의 표시와 알리미를 셈한다.
local D = require(script.Parent.Parent.data["quests.generated"])

local Q = {}
Q.list = D.list
Q.MAX_ACTIVE = 10 -- 한 번에 받아 둘 수 있는 수

local byId = {}
for i, def in D.list do
	byId[def.id] = def
	def.order = i
end

function Q.def(id: any)
	return if typeof(id) == "string" then byId[id] else nil
end

-- 할 일 하나를 화면에 적는 꼴: 「수습 검병 3/5」
function Q.stepText(step, have: number): string
	return ("%s %d/%d"):format(step.name, math.min(have, step.n), step.n)
end

-- 받침이 있으면 a, 없으면 b(을 · 를 / 이 · 가)를 고른다 — 한글로 끝나지 않으면 a
local function josa(word: string, a: string, b: string): string
	local last = nil
	for _, code in utf8.codes(word) do
		last = code
	end
	if last and last >= 0xAC00 and last <= 0xD7A3 and (last - 0xAC00) % 28 == 0 then
		return b
	end
	return a
end
Q.josa = josa

-- 그 일을 어디서 무엇을 잡아 하는가: 「달그림자 사냥터의 검병을 잡으면 떨어진다」 · 「마을 어귀에 있다」
--  사용자 2026-10-07: "뭘잡아야 갑옷조각이 나오는지를 자연스럽게 적어둬야 퀘스트를 진행할거아닙니까 이렇게 적으면 누가 어떻게 알아요"
function Q.stepHint(def, step): string
	local SCENES = require(script.Parent.Parent.data["scenes.generated"])
	local COMBAT = require(script.Parent.Parent.data["combat.generated"])
	local scene = def.scene and SCENES.scenes[def.scene]
	local place = if scene then scene.name else "이 근처"
	local mob = COMBAT.mobs[step.mob]
	local name = if mob then mob.name else step.name
	if step.type == "gather" then
		return ("%s의 %s%s 잡으면 떨어진다"):format(place, name, josa(name, "을", "를"))
	end
	return ("%s에 있다"):format(place)
end

-- 아직 다 하지 못한 일들의 길잡이(퀘스트 창에 적는다)
function Q.hints(book, id: string): { string }
	local def, st = byId[id], book[id]
	local out = {}
	if def and st then
		for i, step in def.steps do
			if (st.c[i] or 0) < step.n then
				table.insert(out, Q.stepHint(def, step))
			end
		end
	end
	return out
end

-- 알리미에 적는 한 줄: 모으는 일은 떨어뜨리는 졸개의 이름을 앞에 — 「검병 · 갑옷 조각 0/8」
function Q.trackText(step, have: number): string
	if step.type == "gather" then
		local COMBAT = require(script.Parent.Parent.data["combat.generated"])
		local mob = COMBAT.mobs[step.mob]
		if mob then
			return ("%s · %s"):format(mob.name, Q.stepText(step, have))
		end
	end
	return Q.stepText(step, have)
end

-- 받아 둔 퀘스트의 할 일이 다 됐는가
function Q.isReady(book, id: string): boolean
	local def, st = byId[id], book[id]
	if not def or not st or st.done then
		return false
	end
	for i, step in def.steps do
		if (st.c[i] or 0) < step.n then
			return false
		end
	end
	return true
end

-- 퀘스트의 지금 모습: "done" 끝냄 · "ready" 돌려주면 된다 · "active" 하는 중 · "open" 받을 수 있다 · "locked" 아직 못 받는다
function Q.state(book, level: number, id: string): string
	local def, st = byId[id], book[id]
	if not def then
		return "locked"
	elseif st then
		return if st.done then "done" elseif Q.isReady(book, id) then "ready" else "active"
	elseif not def.playable or level < def.lv then
		return "locked"
	elseif def.after and not (book[def.after] and book[def.after].done) then
		return "locked"
	end
	return "open"
end

local function activeCount(book): number
	local n = 0
	for _, st in book do
		if not st.done then
			n += 1
		end
	end
	return n
end

-- 받는다
function Q.accept(book, level: number, id: any): (boolean?, string?)
	local def = Q.def(id)
	if not def then
		return nil, "없는 퀘스트다"
	end
	local state = Q.state(book, level, id)
	if state == "locked" then
		return nil, if level < def.lv then ("Lv.%d부터 받는다"):format(def.lv) else "아직 받을 수 없다"
	elseif state ~= "open" then
		return nil, "이미 받은 퀘스트다"
	elseif activeCount(book) >= Q.MAX_ACTIVE then
		return nil, "퀘스트를 더 받을 수 없다"
	end
	book[id] = { done = false, c = {} }
	return true
end

-- 새 캐릭터: 저절로 받는 퀘스트(첫 메인)
function Q.start(book, level: number)
	for _, def in D.list do
		if def.auto and Q.state(book, level, def.id) == "open" then
			Q.accept(book, level, def.id)
		end
	end
end

-- 졸개를 잡았다. 바뀐 퀘스트들의 id를 돌려준다(없으면 빈 표). 잡는 일만 센다 — 모으는 물건은 땅에 떨어지고(Q.drops) 주워야 오른다(Q.onLoot)
function Q.onKill(book, mobKind: string, scene: string): { string }
	local changed = {}
	for id, st in book do
		local def = byId[id]
		if def and not st.done and def.scene == scene then
			for i, step in def.steps do
				local have = st.c[i] or 0
				if step.type == "kill" and step.mob == mobKind and have < step.n then
					st.c[i] = have + 1
					table.insert(changed, id)
				end
			end
		end
	end
	return changed
end

-- 졸개를 잡았을 때 떨어지는 퀘스트의 물건들: 아직 모으는 중인 물건마다 그 확률(pct)로 하나. { { quest, step, name, icon } … }
--  사용자 2026-10-07: "퀘스트 아이템이나 , 기타아이템들은 왜 드롭도되지않고 그림도없고 그냥 텍스트로만 오르나요?" — 잡으면 숫자만 오르던 것을, 그림이 있는 물건이 땅에 떨어지고 주워야 오르게 고쳤다
function Q.drops(book, mobKind: string, scene: string, rng)
	local out = {}
	for id, st in book do
		local def = byId[id]
		if def and not st.done and def.scene == scene then
			for i, step in def.steps do
				if step.type == "gather" and step.mob == mobKind and (st.c[i] or 0) < step.n and rng:NextNumber(0, 100) < step.pct then
					table.insert(out, { quest = id, step = i, name = step.name, icon = step.icon })
				end
			end
		end
	end
	return out
end

-- 퀘스트의 물건을 주웠다. 그 퀘스트의 숫자가 올랐으면 true(이미 다 모았거나 그만둔 퀘스트면 false — 물건은 그냥 사라진다)
function Q.onLoot(book, id: any, step: number): boolean
	local def, st = byId[id], book[id]
	local s = def and def.steps[step]
	if not st or st.done or not s or s.type ~= "gather" then
		return false
	end
	local have = st.c[step] or 0
	if have >= s.n then
		return false
	end
	st.c[step] = have + 1
	return true
end

-- 지금 모으고 있는 물건들(가방의 재료 탭에 보인다): { { name, icon, have, n } … } — 받은 퀘스트의 것만, 끝낸 퀘스트의 것은 빠진다
function Q.items(book)
	local out = {}
	for _, def in D.list do
		local st = book[def.id]
		if st and not st.done then
			for i, step in def.steps do
				if step.type == "gather" then
					table.insert(out, { name = step.name, icon = step.icon, have = st.c[i] or 0, n = step.n })
				end
			end
		end
	end
	return out
end

-- 돌려준다. 끝낸 것으로 적고 보상을 돌려준다(보상을 실제로 주는 것은 부른 쪽 — sim/hero.luau의 questDone)
function Q.complete(book, id: any)
	local def = Q.def(id)
	if not def or not book[id] then
		return nil, "받지 않은 퀘스트다"
	elseif book[id].done then
		return nil, "이미 끝낸 퀘스트다"
	elseif not Q.isReady(book, id) then
		return nil, "아직 다 하지 못했다"
	end
	book[id].done = true
	return def.reward
end

-- 그만둔다(메인은 그만둘 수 없다). 다시 받으면 처음부터다
function Q.drop(book, id: any): (boolean?, string?)
	local def = Q.def(id)
	if not def or not book[id] or book[id].done then
		return nil, "하는 중인 퀘스트가 아니다"
	elseif def.kind == "main" then
		return nil, "메인 퀘스트는 그만둘 수 없다"
	end
	book[id] = nil
	return true
end

-- 그 주민에게서 할 수 있는 것: ready = 돌려줄 것 · offer = 받을 것 · wait = 받아서 하는 중인 것(이 주민에게 돌려줄 것)
function Q.atNpc(book, level: number, npc: string)
	local out = { ready = {}, offer = {}, wait = {} }
	for _, def in D.list do
		local state = Q.state(book, level, def.id)
		if def.endNpc == npc and state == "ready" then
			table.insert(out.ready, def.id)
		elseif def.giver == npc and state == "open" and not def.auto then
			table.insert(out.offer, def.id)
		elseif def.endNpc == npc and state == "active" then
			table.insert(out.wait, def.id)
		end
	end
	return out
end

-- 주민 머리 위의 표시: "?" 돌려줄 것이 있다 · "!" 줄 것이 있다 · nil
function Q.mark(book, level: number, npc: string): string?
	local at = Q.atNpc(book, level, npc)
	return if #at.ready > 0 then "?" elseif #at.offer > 0 then "!" else nil
end

-- 하는 중인 퀘스트들(메인이 먼저, 그다음 받은 차례가 아니라 자료의 차례)
function Q.active(book): { string }
	local list = {}
	for id, st in book do
		if not st.done and byId[id] then
			table.insert(list, id)
		end
	end
	table.sort(list, function(a, b)
		local da, db = byId[a], byId[b]
		if (da.kind == "main") ~= (db.kind == "main") then
			return da.kind == "main"
		end
		return da.order < db.order
	end)
	return list
end

-- 알리미에 적는 줄들: 할 일이 남았으면 그것들, 다 됐으면 「○○에게 돌아간다」. names = 주민 id → 이름
function Q.todo(book, id: string, names): { string }
	local def, st = byId[id], book[id]
	local out = {}
	if not def or not st then
		return out
	end
	for i, step in def.steps do
		if (st.c[i] or 0) < step.n then
			table.insert(out, Q.trackText(step, st.c[i] or 0))
		end
	end
	if #out == 0 then
		table.insert(out, ("%s에게 간다"):format((names and names[def.endNpc]) or "주민"))
	end
	return out
end

-- 클라이언트에 보내는 꼴(수의 표를 빈 데 없이 채운다 — 빈 데가 있으면 보낼 때 잘린다)
function Q.view(book)
	local out = {}
	for id, st in book do
		local def = byId[id]
		if def then
			local counts = {}
			for i in def.steps do
				counts[i] = st.c[i] or 0
			end
			out[id] = { done = st.done, c = counts }
		end
	end
	return out
end

-- ---------- 저장 ----------
function Q.pack(book)
	local out = {}
	for id, st in book do
		if byId[id] then
			local counts = {}
			for i, step in byId[id].steps do
				counts[i] = math.min(st.c[i] or 0, step.n)
			end
			out[id] = { d = if st.done then 1 else 0, c = counts }
		end
	end
	return out
end

-- 저장된 것을 되살린다(모르는 퀘스트 · 이상한 수는 버린다)
function Q.unpack(data: any)
	local book = {}
	if typeof(data) ~= "table" then
		return book
	end
	for id, row in data do
		local def = Q.def(id)
		if def and typeof(row) == "table" then
			local st = { done = row.d == 1, c = {} }
			if typeof(row.c) == "table" then
				for i, step in def.steps do
					local n = row.c[i]
					if typeof(n) == "number" and n == math.floor(n) and n >= 0 then
						st.c[i] = math.min(n, step.n)
					end
				end
			end
			book[id] = st
		end
	end
	return book
end

return Q

end
MODULES['ReplicatedStorage/shared/lune/sim/room'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 맵 한 곳의 싸움 — 졸개의 움직임과 공격, 기술의 판정, 잡았을 때의 보상, 떨어진 것. 화면 · 네트워크와 상관없는 셈만 한다(서버가 쓴다).
--  수치는 data/combat.generated.luau(공방 js/lune/design/combat.js)와 config/numbers.luau에서 온다.
--  졸개는 제 발판의 범위(range) 안에서만 움직인다(뛰어내리지 않는다). 좌표는 도트, (x, y)는 발밑 가운데.
--  heroes = { [id] = sim/hero.luau의 캐릭터 } — 이 방에 있는 사람들.
local N = require(script.Parent.Parent.config.numbers)
local COMBAT = require(script.Parent.Parent.data["combat.generated"])
local Hero = require(script.Parent.hero)
local Items = require(script.Parent.items)
local Bag = require(script.Parent.bag)
local Party = require(script.Parent.party)
local Physics = require(script.Parent.physics)
local RULES = COMBAT.rules

local SEE_Y = 28 -- 이만큼 높이가 다르면 알아채지 못한다(다른 층)
local BODY_W, BODY_H = 6, 14 -- 졸개의 몸(반폭, 높이)
local HERO_W, HERO_H = 5, 17
local SPAWN_TIME, DEAD_TIME = 0.8, 0.9
local BIG_HIT = 1.4 -- 센 타격: 세기 배수가 이만큼 넘는 타(대지 강타의 내려찍기 1.43 · 삼단 베기의 셋째 타 2.05 같은 것). 그 숫자는 직업의 밝은 색으로 뜬다(공방 시험 탭의 "12 넘는 피해"에 해당)

local Room = {}
Room.__index = Room

function Room.new(key: string, scene, rng)
	local self = setmetatable({}, Room)
	self.key = key
	self.scene = scene
	self.rng = rng
	self.time = 0
	self.mobs = {}
	self.shots = {}
	self.drops = {}
	self.nextId = 1
	for _, def in scene.mobs do
		local kind = COMBAT.mobs[def.kind]
		-- 피해 숫자의 배율(dmgScale)과 쓰임의 보정(targetBonus — 맞는 갈래의 기술은 피해가 그만큼 더 뜬다)만큼 체력도 크다: 맞는 기술로 잡는 타수는 그대로다
		local maxHp = math.max(1, math.floor(N.mobHp(def.lv) * kind.hp * RULES.dmgScale * (1 + RULES.targetBonus / 100) + 0.5))
		local mob = {
			id = #self.mobs + 1,
			kind = def.kind,
			def = kind,
			lv = def.lv,
			homeX = def.x,
			y = def.y,
			a = def.range[1],
			b = def.range[2],
			x = def.x,
			dir = if #self.mobs % 2 == 0 then 1 else -1,
			state = "spawn",
			t = 0,
			hp = maxHp,
			maxHp = maxHp,
			cd = 0,
			wait = rng:NextNumber(0, 1.5),
			goal = def.x,
			target = nil :: any,
			aggro = 0,
			struck = false,
			respawn = 0,
		}
		table.insert(self.mobs, mob)
	end
	return self
end

local function sign(v: number): number
	return if v > 0 then 1 elseif v < 0 then -1 else 0
end

local function canSee(mob, h, range: number): boolean
	return h.alive and math.abs(h.y - mob.y) <= SEE_Y and math.abs(h.x - mob.x) <= range
end

-- 가장 가까운, 알아챌 수 있는 사람
function Room:findTarget(mob, heroes)
	local best, bestD = nil, math.huge
	for id, h in heroes do
		local range = if mob.target == id then mob.def.see * 1.6 else mob.def.see
		if canSee(mob, h, range) then
			local d = math.abs(h.x - mob.x)
			if d < bestD then
				best, bestD = id, d
			end
		end
	end
	return best
end

-- 졸개가 사람을 친다. 들어간 피해가 있으면 일(hurt)을 적는다.
function Room:hurtHero(events, h, mob, mul: number)
	local raw = N.rawHit("mob", mob.lv) * (1 - Hero.cut(h, mob.lv) / 100) * mul -- 끼고 있는 방어구만큼 덜 아프다
	local dmg = Hero.hurt(h, raw)
	if dmg > 0 then
		table.insert(events, { type = "hurt", hero = h.id, dmg = dmg, hp = h.hp, from = mob.x, dead = not h.alive })
	end
end

function Room:stepMob(mob, heroes, dt: number, events)
	local def, atk = mob.def, mob.def.atk
	mob.t += dt
	mob.cd = math.max(0, mob.cd - dt)

	if mob.state == "gone" then
		mob.respawn -= dt
		if mob.respawn <= 0 then
			mob.state, mob.t, mob.x, mob.hp, mob.target, mob.cd = "spawn", 0, mob.homeX, mob.maxHp, nil, 0
		end
		return
	elseif mob.state == "dead" then
		if mob.t >= DEAD_TIME then
			mob.state, mob.respawn = "gone", RULES.respawn
		end
		return
	elseif mob.state == "spawn" then
		if mob.t >= SPAWN_TIME then
			mob.state, mob.t = "idle", 0
		end
		return
	elseif mob.state == "hit" then
		if mob.t >= RULES.stagger then
			mob.state, mob.t = "idle", 0
		end
		return
	elseif mob.state == "atk" then
		local target = mob.target and heroes[mob.target]
		if not mob.struck and mob.t >= atk.windup then
			mob.struck = true
			if atk.shot then
				-- 화살: 보는 쪽으로 곧게 날아간다
				local shot = { id = self.nextId, x = mob.x + mob.dir * 8, y = mob.y - 9, dir = mob.dir, speed = atk.shot.speed, left = atk.shot.range, mob = mob }
				self.nextId += 1
				table.insert(self.shots, shot)
				table.insert(events, { type = "shot", id = shot.id, x = shot.x, y = shot.y, dir = shot.dir, speed = shot.speed, range = shot.left })
			elseif atk.burst then
				-- 터진다: 둘레의 사람이 모두 맞고, 졸개는 사라진다(잡은 것으로 치지 않는다)
				for _, h in heroes do
					if h.alive and math.abs(h.x - mob.x) <= atk.burst and math.abs(h.y - mob.y) <= atk.burst then
						self:hurtHero(events, h, mob, atk.mul)
					end
				end
				mob.state, mob.t, mob.hp, mob.target = "dead", 0, 0, nil
				table.insert(events, { type = "burst", mob = mob.id, x = mob.x, y = mob.y })
				return
			elseif target and target.alive then
				local dx = (target.x - mob.x) * mob.dir
				if dx >= -6 and dx <= atk.reach + 6 and math.abs(target.y - mob.y) <= atk.up then
					self:hurtHero(events, target, mob, atk.mul)
				end
			end
		end
		if mob.t >= atk.time then
			mob.state, mob.t, mob.cd = "idle", 0, atk.cd
		end
		return
	end

	-- 서 있기 · 어슬렁 · 쫓기
	mob.aggro = math.max(0, mob.aggro - dt)
	local targetId = self:findTarget(mob, heroes)
	if not targetId and mob.aggro > 0 and mob.target and heroes[mob.target] and heroes[mob.target].alive then
		targetId = mob.target -- 맞았으면 멀리 있어도 한동안 쫓는다
	end
	mob.target = targetId
	local target = targetId and heroes[targetId]
	if target then
		local dx = target.x - mob.x
		if dx ~= 0 then
			mob.dir = sign(dx)
		end
		local sameFloor = math.abs(target.y - mob.y) <= atk.up
		if mob.cd <= 0 and sameFloor and math.abs(dx) <= atk.reach * 0.9 then
			mob.state, mob.t, mob.struck = "atk", 0, false
			return
		end
		if def.chase > 0 and math.abs(dx) > atk.reach * 0.6 then
			mob.x = math.clamp(mob.x + mob.dir * def.chase * dt, mob.a, mob.b)
			mob.state = "run"
		else
			mob.state = "idle"
		end
		return
	end
	-- 어슬렁: 잠깐 서 있다가 범위 안의 다른 자리로 걷는다
	if mob.wait > 0 then
		mob.wait -= dt
		mob.state = "idle"
		if mob.wait <= 0 then
			mob.goal = self.rng:NextNumber(mob.a, mob.b)
		end
		return
	end
	local dx = mob.goal - mob.x
	if math.abs(dx) < 1 then
		mob.wait = self.rng:NextNumber(0.6, 2.2)
		mob.state = "idle"
	else
		mob.dir = sign(dx)
		mob.x += mob.dir * math.min(def.speed * dt, math.abs(dx))
		mob.state = "run"
	end
end

-- 한 걸음. 일어난 일의 목록을 돌려준다: hurt(사람이 맞음) · shot(화살이 생김) · shotEnd · burst(폭탄병이 터짐)
function Room:step(heroes, dt: number)
	local events = {}
	self.time += dt
	for _, mob in self.mobs do
		self:stepMob(mob, heroes, dt, events)
	end
	-- 화살
	for i = #self.shots, 1, -1 do
		local s = self.shots[i]
		local move = s.speed * dt
		s.x += s.dir * move
		s.left -= move
		local done = s.left <= 0 or Physics.cell(self.scene, math.floor(s.x / 16), math.floor(s.y / 16)) == "#"
		if not done then
			for _, h in heroes do
				if h.alive and math.abs(h.x - s.x) <= HERO_W + 2 and s.y <= h.y and s.y >= h.y - HERO_H then
					self:hurtHero(events, h, s.mob, s.mob.def.atk.mul)
					done = true
					break
				end
			end
		end
		if done then
			table.insert(events, { type = "shotEnd", id = s.id })
			table.remove(self.shots, i)
		end
	end
	-- 떨어진 것: 오래되면 사라진다
	for id, d in self.drops do
		if self.time - d.born >= RULES.dropLife then
			self.drops[id] = nil
			table.insert(events, { type = "dropGone", id = id })
		end
	end
	return events
end

-- 상자(x0~x1, y0~y1)에 걸리는 살아 있는 졸개들(가까운 것부터, RULES.maxTargets마리까지)
function Room:mobsInBox(x0: number, x1: number, y0: number, y1: number, cx: number)
	local list = {}
	for _, mob in self.mobs do
		if mob.state ~= "dead" and mob.state ~= "gone" and mob.state ~= "spawn" then
			if mob.x + BODY_W >= x0 and mob.x - BODY_W <= x1 and mob.y >= y0 and mob.y - BODY_H <= y1 then
				table.insert(list, mob)
			end
		end
	end
	table.sort(list, function(p, q)
		return math.abs(p.x - cx) < math.abs(q.x - cx)
	end)
	for i = #list, RULES.maxTargets + 1, -1 do
		list[i] = nil
	end
	return list
end

-- 졸개가 맞는다. 쓰러졌으면 true.
function Room:damageMob(mob, dmg: number, fromX: number, byId: any): boolean
	mob.hp = math.max(0, mob.hp - dmg)
	mob.target, mob.aggro = byId, 5
	if mob.hp <= 0 then
		mob.state, mob.t, mob.target = "dead", 0, nil
		return true
	end
	-- 멈칫한다(터지려는 폭탄병은 멈추지 않는다) · 조금 밀린다
	if not (mob.state == "atk" and mob.def.atk.burst) then
		mob.state, mob.t = "hit", 0
	end
	mob.x = math.clamp(mob.x + sign(mob.x - fromX) * 3, mob.a, mob.b)
	return false
end

-- 기술의 한 타. hero가 (x, y)에서 dir 쪽을 보고 쓴 기술의 hit(판정 하나)를 푼다. scale = 스킬 레벨에 따른 세기(없으면 1).
--  mates = 경험치를 함께 나눌 사람들(hero도 든다 — 같은 맵의 파티원. 없으면 혼자). 떨어진 것은 그 사람들도 바로 주울 수 있다.
--  돌려주는 것: { hits = { { mob, dmg, hp, dead, big } … }, kills = { { mob, xp, ups, gains = { { hero, xp, ups, level } … }, drop, loot } … } }
--  kind = 그 기술의 갈래: 사냥기("mob")는 일반 몬스터에게, 보스기("boss")는 보스에게 피해가 targetBonus% 더 뜬다 — 맞지 않는 상대에게는 그 보정이 없다(체력은 보정만큼 크다)
--   (사용자 2026-10-07: "보스기는 보스 공격시 추가데미지, 사냥기는 일반 몹 공격시 추가 데미지 … 지금 그냥 보스기로 사냥하는게 더빠른현상이 생깁니다")
function Room:skillHit(hero, hit, x: number, y: number, dir: number, scale: number?, mates, kind: string?)
	local box = hit.box
	local xa, xb = x + dir * box[1], x + dir * box[2]
	local x0, x1 = math.min(xa, xb), math.max(xa, xb)
	local power = Hero.powerRaw(hero) -- 반올림하지 않은 전투력으로 셈한다(능력치 1점도 피해에 들어간다)
	local out = { hits = {}, kills = {} }
	for _, mob in self:mobsInBox(x0, x1, y - box[3], y + box[4], x) do
		local roll = 1 + self.rng:NextNumber(-RULES.spread, RULES.spread) / 100
		-- 가운데 타에 이미 맞은 적은 빼는 타(hit.except = 그 범위): 한 적이 같은 것을 두 번 맞지 않는다
		if hit.except then
			local e = hit.except
			local ea, eb = x + dir * e[1], x + dir * e[2]
			if mob.x + BODY_W >= math.min(ea, eb) and mob.x - BODY_W <= math.max(ea, eb) and mob.y >= y - e[3] and mob.y - BODY_H <= y + e[4] then
				continue
			end
		end
		-- 쓰임의 보정: 사냥기는 일반 몬스터에게, 보스기는 보스에게 피해가 targetBonus% 더 뜬다(다른 갈래의 기술은 누구에게나 뜬다). 맞지 않는 상대에게는 보정이 없다
		local fit = if (kind == "mob" and mob.def.boss) or (kind == "boss" and not mob.def.boss) then 1 else 1 + RULES.targetBonus / 100
		local dmg = math.max(1, math.floor(power * hit.mul * (scale or 1) * roll * RULES.dmgScale * fit + 0.5)) -- dmgScale = 피해 숫자의 배율(올린 만큼 숫자로 보이게 — 공방 combat.js)
		local dead = self:damageMob(mob, dmg, x, hero.id)
		if not dead and (hit.pull or 0) > 0 then
			-- 끌어온다: 쓴 사람 쪽으로(제 범위 안에서만)
			local toward = if mob.x > x then -1 else 1
			mob.x = math.clamp(mob.x + toward * math.min(hit.pull, math.max(0, math.abs(mob.x - x) - 10)), mob.a, mob.b)
		end
		table.insert(out.hits, { mob = mob.id, dmg = dmg, hp = mob.hp, dead = dead, big = if hit.mul >= BIG_HIT then true else nil })
		if dead then
			local list = mates or { hero }
			local share = Party.share(#list)
			local gains, myXp, myUps = {}, 0, 0
			for _, mate in list do
				-- 사람마다 제 레벨 차이 · 벌칙을 넣은 경험치에 나눈 몫을 곱한다
				local xp = math.max(1, math.floor(Hero.killXp(mate, mob.lv, mob.def.hp) * share + 0.5))
				local ups = Hero.gainXp(mate, xp)
				table.insert(gains, { hero = mate.id, xp = xp, ups = ups, level = mate.level })
				if mate == hero then
					myXp, myUps = xp, ups
				end
			end
			local drop, loot = self:dropFor(hero, mob), self:lootFor(hero, mob)
			if #list > 1 then
				local friends = {}
				for _, mate in list do
					friends[mate.id] = true
				end
				if drop then
					drop.friends = friends
				end
				for _, d in loot do
					d.friends = friends
				end
			end
			table.insert(out.kills, { mob = mob.id, kind = mob.kind, x = mob.x, y = mob.y, xp = myXp, ups = myUps, gains = gains, drop = drop, loot = loot })
		end
	end
	return out
end

-- 잡은 졸개가 떨어뜨리는 달돈(열에 여섯). 장비와 달가루는 lootFor.
function Room:dropFor(hero, mob)
	if self.rng:NextNumber(0, 100) >= N.data.COIN.chance then
		return nil
	end
	local base = N.killMoney(mob.lv) * mob.def.hp / (N.data.COIN.chance / 100)
	local amount = base * (1 + self.rng:NextNumber(-RULES.moneySpread, RULES.moneySpread) / 100)
	if hero.weak > 0 then
		amount *= 1 - N.data.BODY.death.cut / 100
	end
	local drop = { id = self.nextId, kind = "money", amount = math.max(1, math.floor(amount + 0.5)), x = mob.x, y = mob.y, owner = hero.id, born = self.time }
	self.nextId += 1
	self.drops[drop.id] = drop
	return drop
end

-- 잡은 졸개가 떨어뜨리는 장비와 달가루(없으면 빈 표). 쓰러진 뒤의 벌칙 동안에는 덜 나온다.
function Room:lootFor(hero, mob)
	local out = {}
	local mul = if hero.weak > 0 then 1 - N.data.BODY.death.cut / 100 else 1
	local item = Items.rollDrop(self.rng, mob.lv, hero.class, mul)
	if item then
		table.insert(out, self:addDrop({ kind = "gear", item = item, amount = 1 }, mob.x + (#out + 1) * 9, mob.y, hero.id))
	end
	local dust = Items.rollDust(self.rng, mob.lv, mul)
	if dust then
		table.insert(out, self:addDrop({ kind = "dust", amount = dust }, mob.x + (#out + 1) * 9, mob.y, hero.id))
	end
	return out
end

-- 물건 하나를 (x, y)에 떨어뜨린다. owner = 얼마 동안 혼자 주울 수 있는 사람
function Room:addDrop(drop, x: number, y: number, owner: any)
	drop.id, drop.x, drop.y, drop.owner, drop.born = self.nextId, x, y, owner, self.time
	self.nextId += 1
	self.drops[drop.id] = drop
	return drop
end

-- 방 사람들에게 알릴 때의 꼴(떨어진 것 하나)
function Room.dropView(d)
	return { id = d.id, kind = d.kind, amount = d.amount, x = d.x, y = d.y, name = d.name, icon = d.icon, item = if d.item then { slot = d.item.slot, stage = d.item.stage, q = d.item.q, star = d.item.star, who = d.item.who } else nil }
end

-- 줍는다. 주웠으면 그 물건을, 아니면 nil과 까닭을 돌려준다.
function Room:pickup(hero, dropId: number)
	local d = self.drops[dropId]
	if not d then
		return nil, "없음"
	end
	if not hero.alive then
		return nil, "쓰러짐"
	end
	if math.abs(d.x - hero.x) > RULES.pickup or math.abs(d.y - hero.y) > RULES.pickup + 12 then
		return nil, "멀다"
	end
	if d.owner ~= hero.id and not (d.friends and d.friends[hero.id]) and self.time - d.born < RULES.dropOwn then
		return nil, "남의 것"
	end
	-- 퀘스트의 물건은 그 퀘스트를 하는 사람의 것이다(시간이 지나도 남이 줍지 못한다). 숫자를 올리는 것은 부른 쪽(Quests.onLoot)
	if d.kind == "quest" and d.owner ~= hero.id then
		return nil, "남의 것"
	end
	if d.kind == "gear" then
		local ok, why = Bag.add(hero, d.item)
		if not ok then
			return nil, why
		end
	elseif d.kind == "dust" then
		hero.dust += d.amount
	elseif d.kind == "money" then
		hero.money += d.amount
	end
	self.drops[dropId] = nil
	return d
end

-- 지금 졸개들의 모습(화면에 그릴 것만)
function Room:snapshot()
	local list = {}
	for i, mob in self.mobs do
		list[i] = { mob.id, math.floor(mob.x * 10 + 0.5) / 10, mob.dir, mob.state, math.floor(mob.t * 100 + 0.5) / 100, mob.hp }
	end
	return list
end

-- 방에 들어온 사람에게 한 번 주는 것(졸개의 종류 · 레벨 · 체력, 떨어져 있는 것). heroId = 그 사람 — 남의 퀘스트 물건은 보여 주지 않는다
function Room:describe(heroId: any?)
	local mobs, drops = {}, {}
	for i, mob in self.mobs do
		mobs[i] = { id = mob.id, kind = mob.kind, lv = mob.lv, y = mob.y, maxHp = mob.maxHp, name = mob.def.name }
	end
	for _, d in self.drops do
		if d.kind == "quest" and d.owner ~= heroId then
			continue
		end
		table.insert(drops, Room.dropView(d))
	end
	return { key = self.key, mobs = mobs, drops = drops, snap = self:snapshot() }
end

return Room

end
MODULES['ReplicatedStorage/shared/lune/ui/format'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 화면에 적는 숫자와 글의 꼴 — 칸의 폭에 맞춰 고른다(글씨는 칸을 넘지 않는다). 화면과 상관없는 셈이라 테스트가 직접 돌린다.
--  measure(text) = 그 글의 폭(도트)을 재는 함수 — 게임에서는 pixelText.Measure.
local F = {}

-- 체력 칸 안의 자리: 레벨 글의 폭(Lv.150까지 들어가게) — 나머지가 체력 글의 폭이다
F.LEVEL_W = 48
F.LEVEL_GAP = 6

-- 큰 수를 짧게: 12,345 → 1.2만 · 123,456,789 → 1.2억
function F.short(n: number): string
	local function one(v: number, unit: string): string
		local s = string.format("%.1f", v)
		if s:sub(-2) == ".0" or #s >= 5 then
			s = string.format("%d", math.floor(v + 0.5))
		end
		return s .. unit
	end
	if n >= 1e8 then
		return one(n / 1e8, "억")
	elseif n >= 1e4 then
		return one(n / 1e4, "만")
	end
	return tostring(math.floor(n + 0.5))
end

-- 체력 글: "지금/최대"가 들어가면 그대로, 안 들어가면 짧게, 그래도 안 들어가면 지금 것만
function F.hp(cur: number, max: number, width: number, measure: (string) -> number): string
	local full = ("%d/%d"):format(cur, max)
	if measure(full) <= width then
		return full
	end
	local short = F.short(cur) .. "/" .. F.short(max)
	if measure(short) <= width then
		return short
	end
	return F.short(cur)
end

-- 키 이름을 화면에 적는 꼴
local KEYNAME = {
	LeftShift = "Shift", RightShift = "Shift", LeftControl = "Ctrl", RightControl = "Ctrl", LeftAlt = "Alt", RightAlt = "Alt", Space = "Space",
	Left = "←", Right = "→", Up = "↑", Down = "↓", Return = "Enter", Backspace = "Back", Backquote = "`", Minus = "-", Equals = "=",
	LeftBracket = "[", RightBracket = "]", Semicolon = ";", Quote = "'", Comma = ",", Period = ".", Slash = "/", BackSlash = "\\",
	Zero = "0", One = "1", Two = "2", Three = "3", Four = "4", Five = "5", Six = "6", Seven = "7", Eight = "8", Nine = "9",
}
function F.key(name: string): string
	return KEYNAME[name] or name
end

-- 주민의 말풍선(화면 틀의 고운 격자의 점): 말은 본문 글씨로 폭 textW에 lines줄까지. 말풍선은 그 주민 머리 위에 뜬다(얼굴 칸 · 이름표를 따로 두지 않는다 — 산나비처럼).
--  padX · padY = 글 둘레의 여백 · tail = 꼬리의 높이 · up = 머리 위로 띄우는 높이(게임의 도트). 값은 공방 js/lune/design/ui.js의 BUBBLE(시험 탭과 같은 값)
F.BUBBLE = require(script.Parent.Parent.data["ui.generated"]).bubble

-- 칸 위의 키 딱지에 적는 키 이름(작은 글씨): 다섯 글자까지 — 긴 이름은 줄임말로
local CAP = { PageUp = "PgUp", PageDown = "PgDn", CapsLock = "Caps", Insert = "Ins", Delete = "Del", Escape = "Esc", NEnter = "NEnt" }
function F.keyShort(name: string): string
	local text = F.key(name)
	local pad = string.match(text, "^Keypad(.+)$")
	if pad then
		text = "N" .. F.key(pad)
	end
	text = CAP[text] or text
	local out, n = "", 0
	for _, code in utf8.codes(text) do
		n += 1
		if n > 5 then
			break
		end
		out ..= utf8.char(code)
	end
	return out
end

-- 이름표에 적는 이름. 도트 글꼴에 있는 글자(한글 · 영문 · 숫자 · 몇 가지 기호)로만 된 이름은 그대로, 다른 글자가 섞였으면 대신할 이름(로블록스 아이디)을 쓴다.
--  길면 max글자에서 자른다.
local OK_EXTRA = { ["·"] = true, ["★"] = true, ["♥"] = true }
function F.safeName(display: any, fallback: string, max: number?): string
	local name = if typeof(display) == "string" and #display > 0 then display else fallback
	local ok = pcall(function()
		for _, code in utf8.codes(name) do
			local fine = (code >= 32 and code <= 126) or (code >= 0xAC00 and code <= 0xD7A3) or (code >= 0x3131 and code <= 0x3163) or OK_EXTRA[utf8.char(code)]
			assert(fine)
		end
	end)
	if not ok then
		name = fallback
	end
	local out, n = "", 0
	for _, code in utf8.codes(name) do
		n += 1
		if n > (max or 12) then
			break
		end
		out ..= utf8.char(code)
	end
	return out
end

-- 좁은 칸에 적는 키 이름: 다 들어가면 그대로, 아니면 줄임말, 그래도 안 되면 들어가는 만큼만(적어도 한 글자)
local SHORT = { Space = "Spc", Shift = "Sft", Ctrl = "Ctl", Enter = "Ent", Back = "Bk", Alt = "Alt" }
function F.fitKey(name: string, width: number, measure: (string) -> number): string
	local text = F.key(name)
	if measure(text) <= width then
		return text
	end
	local short = SHORT[text]
	if short and measure(short) <= width then
		return short
	end
	local out = ""
	for _, code in utf8.codes(text) do
		local try = out .. utf8.char(code)
		if out ~= "" and measure(try) > width then
			break
		end
		out = try
	end
	return out
end

-- 스킬 칸 · 메뉴 단추의 귀퉁이에 아주 작은 글씨(3x5 — 영문 대문자 · 숫자 · 몇 가지 기호)로 적는 키 이름. 네 글자까지.
--  화살표는 그 글씨의 < > ^ ~ 자리에 그려져 있다. 그 글씨에 없는 글자는 뺀다.
local MICRO = { Shift = "SHFT", Ctrl = "CTRL", Space = "SPC", Enter = "ENT", Back = "BACK", Alt = "ALT", Tab = "TAB", ["←"] = "<", ["→"] = ">", ["↑"] = "^", ["↓"] = "~" }
F.MICRO_CHARS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ+-/%.,:!?<>^~[];'\\=`*"
function F.keyMicro(name: string): string
	local text = F.key(name)
	if MICRO[text] then
		return MICRO[text]
	end
	local out = ""
	for i = 1, #text do
		local ch = string.upper(text:sub(i, i))
		if #out < 4 and string.find(F.MICRO_CHARS, ch, 1, true) then
			out ..= ch
		end
	end
	return out
end

-- 한 줄에 나란히 놓는 칸들의 폭: 저마다 글이 들어갈 만큼(min 이상) 잡고, 남는 폭은 고루 나눈다. 다 못 들어가면 nil.
function F.split(total: number, gap: number, needs: { number }, min: number): { number }?
	local n = #needs
	local widths, sum = {}, 0
	for i, need in needs do
		widths[i] = math.max(min, need)
		sum += widths[i]
	end
	local left = total - gap * (n - 1) - sum
	if left < 0 then
		return nil
	end
	local each = math.floor(left / n)
	for i = 1, n do
		widths[i] += each
	end
	return widths
end

-- ---------- 능력치의 설명 · 스킬 창의 글 ----------  글은 공방 js/lune/design/ui.js의 STATTIP · SKILLWORDS(data/ui.generated.luau의 statTip · skillWords)
-- 글 속의 {이름}을 o의 값으로 채운다
function F.fill(text: string, o): string
	return (text:gsub("{(%w+)}", function(k)
		local v = o[k]
		return if v == nil then "" else tostring(v)
	end))
end

-- 오르는 값을 적는 법: 100부터는 정수 · 10부터는 소수 한 자리 · 그 아래는 소수 두 자리
function F.gain(v: number): string
	if v >= 100 then
		return tostring(math.floor(v + 0.5))
	elseif v >= 10 then
		return ("%.1f"):format(v)
	end
	return ("%.2f"):format(v)
end

-- 능력치 하나의 설명(능력치 창에서 마우스를 올렸을 때): { kind(main 주 · sub 부 · none 이 직업은 안 쓴다 · hp 체력), title(능력치 이름), tag, lines }
--  사용자 2026-10-07: "능력치에 각각 스텟별로 마우스 올리면 호버로 스텟 효과를 보여줘야합니다. 뭔지알고 스텟을찍으라는건지"
--  그 직업에게 무엇을 해 주는지와, 지금 레벨에서 1점에 얼마가 오르는지를 실제 숫자로 적는다(공방 js/lune/ui/paint.js의 statTip과 같은 글 — 테스트 14가 맞춰 본다)
function F.statTip(class: string, id: string, level: number)
	local N = require(script.Parent.Parent.config.numbers)
	local CLASSES = require(script.Parent.Parent.data["classes.generated"])
	local TIP = require(script.Parent.Parent.data["ui.generated"]).statTip
	local STATS = N.data.STATS
	local pair = STATS.classes[class]
	local kind = if id == "hp" then "hp" elseif id == pair[1] then "main" elseif id == pair[2] then "sub" else "none"
	local gain = N.statGain(class, level)
	local users = {}
	for _, c in TIP.order do
		local q = STATS.classes[c]
		if q[1] == id or q[2] == id then
			table.insert(users, ("%s(%s)"):format(CLASSES.classes[c].name, if q[1] == id then TIP.marks.main else TIP.marks.sub))
		end
	end
	local o = {
		class = CLASSES.classes[class].name,
		main = STATS.names[pair[1]],
		ratio = STATS.mainW / STATS.subW,
		power = F.gain(if kind == "main" then gain.main else gain.sub),
		hp = F.gain(gain.hp),
		users = table.concat(users, " · "),
	}
	local lines = {}
	for i, text in TIP[kind].lines do
		lines[i] = F.fill(text, o)
	end
	return { kind = kind, title = STATS.names[id], tag = TIP[kind].tag, lines = lines }
end

return F

end
MODULES['ReplicatedStorage/shared/lune/ui/layout'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 늘 보이는 화면과 창의 치수 — 화면 틀의 고운 격자(1080p에서 960x540)에서의 값. 그리지는 않는다: 화면(client/lune/hud.luau · chat.luau · partyHud.luau · questHud.luau · ui/*Window.luau)과
--  자동 검사(tools/test/tests/14_lune_hud.luau · 15_lune_items.luau)가 같은 값을 쓰게 한데 모아 둔 것이다.
--  숫자는 여기서 적지 않는다 — 모두 공방에서 온다(사용자 2026-10-07: "공방에서 횡스크롤 시험 탭에서 먼저 구현해보고 느낌보고 게임에 반영하는 순서로 하겠습니다"):
--   칸의 자리(붙는 구석과 x · y · w · h) = 공방 「기본 · UI」 탭(data/ui.generated.luau의 hud) · 치수 = 공방 js/lune/design/ui.js의 UILAYOUT(ui.generated.luau의 layout —
--   공방의 횡스크롤 시험 탭이 같은 값으로 그린다) · 부품의 치수 = 공방의 부품 도구(data/kit.generated.luau의 ui.metric).
local UI = require(script.Parent.Parent.data["ui.generated"])
local KIT = require(script.Parent.Parent.data["kit.generated"])
local M = KIT.ui.metric
local D = UI.layout

local L = {}
L.GRID = UI.grid
L.M = M

-- 화면의 격자가 gw x gh일 때 그 칸의 자리(구석에서의 거리를 지킨다). r = { at, x, y, w, h }
function L.rect(r, gw: number?, gh: number?)
	local w, h = gw or UI.grid.w, gh or UI.grid.h
	local fy = if r.at:sub(1, 1) == "b" then 1 else 0
	local side = r.at:sub(2, 2)
	local fx = if side == "r" then 1 elseif side == "c" then 0.5 else 0
	return { x = r.x + math.floor((w - UI.grid.w) * fx + 0.5), y = r.y + math.floor((h - UI.grid.h) * fy + 0.5), w = r.w, h = r.h }
end

-- 게임 세계의 배율 s에서 화면 틀의 배율과 격자(client/lune/stage.luau와 같은 셈)
function L.gridFor(s: number): (number, number, number)
	local us = math.max(1, math.floor(0.4 * s + 0.5))
	return 384 * s / us, 216 * s / us, us
end

-- ---------- 늘 보이는 화면 ----------
L.VITALS = D.vitals -- 왼쪽 아래 덩어리: 윗줄에 레벨 · 이름 / 체력 바(숫자는 바 안) / 가는 경험치 줄과 그 옆의 %
L.SKILLS = D.skills -- 스킬 칸: 두 줄 x 여섯. 칸 위에 키 딱지(높이 keyUp)
L.MENU = D.menu -- 창을 여는 단추: 여섯까지, 오른쪽 끝에 붙여. 그림 아래에 이름(labels = 칸에 맞춘 짧은 이름)
L.PARTY = D.party -- 파티원 칸: 한 사람 = 이름 한 줄 + 가는 체력 줄. ask = 초대 알림(위쪽 가운데)
L.QUEST = D.quest -- 퀘스트 알리미: 이름 한 줄(본문 글씨) · 할 일 한 줄(작은 글씨) · 퀘스트 사이
L.CHAT = D.chat -- 채팅: 평소에는 채팅 칸에 마지막 몇 줄, 쓸 때는 넓은 판(open)
L.TAG = D.tag -- 이름표: 한 줄의 높이(쌓을 때) · 발밑에서 아래로 띄우는 만큼 · 가장 넓을 때
L.MOBBAR = D.mobBar -- 졸개의 체력 띠: 크기(화면 틀의 점) · 발밑에서 위로(게임의 도트)

-- 쓰는 칸이 n개일 때 i째 칸의 자리(스킬 칸 틀 안): 여섯까지는 아랫줄에 가운데로 모으고, 일곱째부터는 윗줄에 같은 식으로
function L.slotPlace(i: number, n: number): (number, number)
	local s, K = UI.hud.skills, L.SKILLS
	local pitch = K.slot + K.gap
	local row = if i <= K.cols then 1 else 2
	local inRow = if row == 1 then math.min(n, K.cols) else n - K.cols
	local k = if row == 1 then i else i - K.cols
	local left = math.floor((s.w - (inRow * pitch - K.gap)) / 2)
	return left + (k - 1) * pitch, s.h - K.slot - (row - 1) * (K.slot + K.keyUp + K.rowGap)
end

-- 메뉴 단추 아래에 적는 이름(칸에 맞춘 짧은 이름이 있으면 그것)
function L.menuLabel(id: string, name: string): string
	return L.MENU.labels[id] or name
end

-- n개 가운데 i째 단추의 x(메뉴 칸 틀 안)
function L.menuX(i: number, n: number): number
	return UI.hud.menu.w - (n - i + 1) * L.MENU.pitch + (L.MENU.pitch - L.MENU.slot)
end

-- 쓰는 중의 채팅 판의 자리(아래 끝은 채팅 칸의 아래 끝에서 dy 아래)
function L.chatOpen()
	local c, o = UI.hud.chat, L.CHAT.open
	local h = o.pad + o.lines * L.CHAT.line + 4 + L.CHAT.field + o.pad
	return { at = c.at, x = c.x + o.dx, y = c.y + c.h - h + o.dy, w = o.w, h = h }
end

-- ---------- 창(화면 오른쪽 · 왼쪽의 옆 판) ----------
L.WIN = D.win -- 판에서 속까지: 옆으로 pad, 위로 head(제목 줄), 아래로 foot. edge · top = 화면 끝에서 띄우는 폭
L.BAG = D.bag -- 가방: 칸 여섯 x 넷. 탭 줄(gridY) 아래에 칸, 그 아래 infoH에 이름 · 설명 · 단추 셋(같은 폭 — 사이 gap) · 돈
L.EQUIP = D.equip -- 장비 창: 왼쪽 = 칸 하나 + 글(textW), 오른쪽 = 장신구 네 칸
L.SHOP = D.shop -- 상점: 물건 이름(본문 글씨) · 값 · 사는 단추(들)
L.STAT = D.stat -- 능력치 창: 속의 폭 · 줄(top부터 row씩) · 주/부의 자리 · 값의 오른쪽 끝 · + 단추의 폭 · tip = 능력치에 마우스를 올렸을 때 창 옆에 뜨는 설명 판
L.SKILL = D.skill -- 스킬 창: 차수 탭 · 안내 줄 · 스킬들(cols줄 x rows) · 오른쪽의 설명

-- 능력치 창의 속(폭 · 높이). n = 능력치의 수
function L.statBody(n: number): (number, number)
	return L.STAT.w, L.STAT.top + n * L.STAT.row + 8 + M.button + 14 + 20
end

-- 스킬 창의 속(폭 · 높이)과 스킬 목록의 폭
function L.skillBody(): (number, number, number)
	local K = L.SKILL
	local listW = K.cols * K.colW + (K.cols - 1) * K.colGap
	return listW + K.gap + K.detailW, K.top + K.rows * K.row, listW
end

-- 장비 칸의 한 변: 장비 그림(게임의 굵은 도트 18개)에 사방으로 여백을 둔 크기. ratio = 게임 도트 하나가 화면 틀의 몇 점인가(1080p에서 2.5 → 50)
function L.cellFor(ratio: number): number
	return math.floor(KIT.icon * ratio + 0.5) + 5
end

-- 가방의 속(폭 · 높이)과 단추 셋의 폭
function L.bagBody(ratio: number): (number, number)
	local s = L.cellFor(ratio)
	return L.BAG.cols * s, L.BAG.gridY + L.BAG.rows * s + L.BAG.infoH
end

function L.bagButtonW(bodyW: number): number
	return math.floor((bodyW - L.BAG.gap * 2) / 3)
end

-- 장비 창의 속(폭 · 높이)과 오른쪽 덩이의 왼쪽 끝
function L.equipBody(ratio: number): (number, number, number)
	local s = L.cellFor(ratio)
	local rx = s + L.EQUIP.gap + L.EQUIP.textW + L.EQUIP.gap
	return rx + L.EQUIP.accCols * s, math.max(5 * (s + 2) - 2, 2 * s + 150), rx
end

return L

end
MODULES['ReplicatedStorage/shared/lune/ui/quick'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 퀵슬롯의 셈 — 화면 가운데 아래의 스킬 칸(여섯 x 두 줄). 그리지는 않는다: 화면(client/lune/hud.luau · boot.luau)과 서버(sim/hero.luau), 테스트가 같이 쓴다.
--  사용자 2026-10-07: "스킬키를 단축키에 등록하기 쉬워야합니다. … 드래그앤 드랍으로 배치도 되어야하고, 스킬탭에서 스킬아이콘을 꾹누르거나 클릭하면 퀵슬롯쪽이 반짝거리고 거기서 퀵슬롯을 누르면 배치된다던가"
--  키는 스킬이 아니라 칸에 붙는다(칸마다 키 하나). 칸에는 물약("potion")이나 스킬의 이름표가 놓인다. 빈 칸은 false.
--  값과 놓는 법은 공방 js/lune/design/ui.js의 QUICK · quickPlace · quickClear · quickStart(횡스크롤 시험 탭이 같은 셈으로 논다) — data/ui.generated.luau의 quick.
local UI = require(script.Parent.Parent.data["ui.generated"])

local Q = {}
Q.DATA = UI.quick
Q.N = UI.quick.n -- 칸의 수
Q.COLS = UI.quick.cols -- 한 줄
Q.POTION = "potion"

-- 칸에 놓인 것의 그림 이름(화면의 그림 24x24 — 공방의 아이콘 이름)
function Q.pic(what: string): string
	if what == Q.POTION then
		return "slot_potion"
	end
	return "skill_" .. what
end

local function copy(slots)
	local out = table.create(Q.N, false)
	for i = 1, Q.N do
		out[i] = slots[i] or false
	end
	return out
end

local function find(slots, what): number?
	for i = 1, Q.N do
		if slots[i] == what then
			return i
		end
	end
	return nil
end
Q.find = find

-- 칸에 놓는다: what(스킬의 이름표 · "potion")을 j째 칸에. 이미 다른 칸에 있던 것이면 두 칸이 자리를 바꾼다.
--  창(스킬 창 · 가방)에서 온 것이면 그 칸에 있던 것은 빠진다. 새 칸들을 돌려준다(못 놓으면 nil)
function Q.place(slots, what: string, j: number)
	if typeof(what) ~= "string" or what == "" or j < 1 or j > Q.N or j % 1 ~= 0 then
		return nil
	end
	local out = copy(slots)
	local i = find(out, what)
	if i == j then
		return out
	end
	local old = out[j]
	out[j] = what
	if i then
		out[i] = old
	end
	return out
end

-- 칸에서 뺀다(물약도 빠진다 — 가방의 소비 탭에서 다시 끌어다 놓는다)
function Q.clear(slots, i: number)
	if i < 1 or i > Q.N then
		return nil
	end
	local out = copy(slots)
	out[i] = false
	return out
end

-- 새 캐릭터의 칸: start의 차례대로(물약 · 사냥기 · 보스기 · 이동기 — 스킬은 그 갈래의 첫 스킬). skills = { { id, type } … }
function Q.start(skills)
	local out = table.create(Q.N, false)
	for k, kind in UI.quick.start do
		if kind == Q.POTION then
			out[k] = Q.POTION
		else
			for _, s in skills do
				if s.type == kind then
					out[k] = s.id
					break
				end
			end
		end
	end
	return out
end

-- 밖에서 온 칸들(클라이언트가 보낸 것 · 저장된 것)을 살핀다: 꼭 N칸, 칸마다 false · "potion" · 놓아도 되는 스킬(ok(id)가 참), 겹치는 것 없이(물약도 한 칸까지 — 없어도 된다).
--  말이 되면 깨끗한 칸들을, 아니면 nil을 돌려준다
function Q.clean(list: any, ok: (string) -> boolean)
	if typeof(list) ~= "table" then
		return nil
	end
	local out = table.create(Q.N, false)
	local seen = {}
	local potions = 0
	for k in list do
		if typeof(k) ~= "number" or k < 1 or k > Q.N or k % 1 ~= 0 then
			return nil
		end
	end
	for i = 1, Q.N do
		local v = list[i]
		if v == nil or v == false then
			out[i] = false
		elseif typeof(v) == "string" and #v <= 40 and not seen[v] and (v == Q.POTION or ok(v)) then
			seen[v] = true
			out[i] = v
			if v == Q.POTION then
				potions += 1
			end
		else
			return nil
		end
	end
	if potions > 1 then
		return nil
	end
	return out
end

-- 윗줄(둘째 줄)에 놓인 것이 있는가 — 있으면 윗줄도 늘 보인다
function Q.usesTop(slots): boolean
	for i = Q.COLS + 1, Q.N do
		if slots[i] then
			return true
		end
	end
	return false
end

return Q

end
MODULES['ReplicatedStorage/shared/lune/ui/tags'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 이름표와 채팅 줄의 셈(그리지는 않는다). 테스트 14가 본다.
local T = {}

-- 이름표가 겹칠 때: 아무것도 옮기지 않는다 — 이름은 늘 제 주인의 발밑 그 자리에 있다.
--  사용자 2026-10-07: "닉네임이 npc랑 지나갈때 npc이름 아래로 낑겨버리는데 … 이건 말도 안되는 상황입니다" → 겹치면 밀어서 쌓던 것(stack)을 없앴다.
--  list = 앞선 차례대로(내 것 → 다른 사람 → 주민 · 문 → 졸개) { x(왼쪽), y(위), w(폭) }. h = 한 줄의 높이 · gap = 옆으로 이만큼보다 가까우면 겹친 것으로 본다.
--  앞선 것이 보이고, 그것과 겹치는 뒤의 것은 겹치는 동안 숨는다(글씨끼리 포개져 못 읽게 되지 않게). 돌려주는 것 = 보이는가의 차례표.
--  공방의 횡스크롤 시험 탭(js/lune/ui/paint.js의 tagsVisible)과 같은 셈이다.
function T.visible(list, h: number, gap: number?): { boolean }
	local near = gap or 4
	local shown = {}
	local out = {}
	for i, t in list do
		local hit = false
		for _, q in shown do
			if t.x < q.x + q.w + near and q.x < t.x + t.w + near and math.abs(q.y - t.y) < h then
				hit = true
				break
			end
		end
		if not hit then
			table.insert(shown, t)
		end
		out[i] = not hit
	end
	return out
end

-- 채팅 한 줄: 「이름: 글」. 채널이 파티면 앞에 [파티]
function T.chatLine(channel: string, name: string?, text: string): string
	local head = if channel == "party" then "[파티] " else ""
	if not name or name == "" then
		return head .. text
	end
	return ("%s%s: %s"):format(head, name, text)
end

-- 보내기 전에 다듬는다: 앞뒤 빈칸을 떼고, 줄바꿈을 빈칸으로, max글자까지만. 빈 글이면 nil
function T.chatClean(text: any, max: number?): string?
	if typeof(text) ~= "string" then
		return nil
	end
	local s = string.gsub(text, "[\r\n\t]", " ")
	s = string.match(s, "^%s*(.-)%s*$") or ""
	if s == "" then
		return nil
	end
	local out, n = "", 0
	local ok = pcall(function()
		for _, code in utf8.codes(s) do
			n += 1
			if n > (max or 80) then
				break
			end
			out ..= utf8.char(code)
		end
	end)
	if not ok or out == "" then
		return nil
	end
	return out
end

return T

end
MODULES['ReplicatedStorage/shared/net/net'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 네트워크 계층. 모든 RemoteEvent/RemoteFunction은 shared/net/packets.luau의 정의로만 만들고 쓴다 — 모듈마다
-- 리모트를 제각각 만들고 이름 문자열로 찾던 구조를 대체한다.
--   서버: Net.OnServer(이름, 핸들러) — 인자 개수/타입과 요청 빈도를 검사해서 통과한 요청만 핸들러로 보낸다.
--         Net.FireClient / Net.FireAllClients
--   클라: Net.FireServer / Net.Invoke / Net.OnClient
-- 검증에 실패하거나 빈도를 넘긴 요청은 조용히 버리고(서버 로그에는 플레이어·패킷별로 몇 초에 한 번만 경고) 핸들러는
-- 호출하지 않는다. 이동 위치를 매번 거절하는 것은 엔진 공식 문서가 비권장하지만(오탐/지연), 이 계층은 "중요 행동
-- 요청이 형식에 맞는지, 폭주하지 않는지"만 본다 — 위치/내용의 타당성 검증은 각 서비스가 맡는다.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local packets = require(script.Parent.packets)

local IS_SERVER = RunService:IsServer()
local FOLDER_NAME = "Remotes"

local Net = {}

local folder: Folder
if IS_SERVER then
	folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME) or Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = ReplicatedStorage
	for name, def in packets do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new(if def.Kind == "Function" then "RemoteFunction" else "RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

local function getRemote(name: string)
	assert(packets[name], ("Net: 정의되지 않은 패킷 '%s' (shared/net/packets.luau에 먼저 추가)"):format(name))
	if IS_SERVER then
		return folder:FindFirstChild(name)
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME):WaitForChild(name)
end

-- ===== 서버 =====

-- 플레이어별 패킷별 토큰 버킷: buckets[userId][name] = { tokens, last }
local buckets: { [number]: { [string]: { tokens: number, last: number } } } = {}
local lastWarn: { [string]: number } = {}

local function warnThrottled(key: string, message: string)
	local now = os.clock()
	if not lastWarn[key] or now - lastWarn[key] > 5 then
		lastWarn[key] = now
		warn(message)
	end
end

local function takeToken(player: Player, name: string, limit): boolean
	local perPlayer = buckets[player.UserId]
	if not perPlayer then
		perPlayer = {}
		buckets[player.UserId] = perPlayer
	end
	local now = os.clock()
	local bucket = perPlayer[name]
	if not bucket then
		bucket = { tokens = limit.Burst, last = now }
		perPlayer[name] = bucket
	end
	bucket.tokens = math.min(limit.Burst, bucket.tokens + (now - bucket.last) * limit.PerSecond)
	bucket.last = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

local function validArgs(def, ...): boolean
	if select("#", ...) > #def.Args then
		return false -- 정의보다 인자가 많으면 형식 위반
	end
	for i, check in def.Args do
		if not check((select(i, ...))) then
			return false
		end
	end
	return true
end

-- ClientToServer 패킷 핸들러 등록. Function 패킷이면 핸들러의 반환값이 클라이언트에 돌아간다.
function Net.OnServer(name: string, handler: (player: Player, ...any) -> ...any)
	assert(IS_SERVER, "Net.OnServer는 서버에서만 쓴다")
	local def = packets[name]
	assert(def and def.Direction == "ClientToServer", ("Net.OnServer: '%s'는 ClientToServer 패킷이 아니다"):format(name))
	local remote = getRemote(name)

	local function guarded(player: Player, ...)
		if not takeToken(player, name, def.RateLimit) then
			warnThrottled(player.UserId .. name .. "rate", ("Net: %s의 '%s' 요청이 빈도 제한을 넘어 버려졌다"):format(player.Name, name))
			return false
		end
		if not validArgs(def, ...) then
			warnThrottled(player.UserId .. name .. "arg", ("Net: %s의 '%s' 요청 인자가 형식에 맞지 않아 버려졌다"):format(player.Name, name))
			return false
		end
		return true
	end

	if def.Kind == "Function" then
		remote.OnServerInvoke = function(player: Player, ...)
			if not guarded(player, ...) then
				return nil
			end
			return handler(player, ...)
		end
	else
		remote.OnServerEvent:Connect(function(player: Player, ...)
			if guarded(player, ...) then
				handler(player, ...)
			end
		end)
	end
end

function Net.FireClient(name: string, player: Player, ...: any)
	assert(IS_SERVER)
	getRemote(name):FireClient(player, ...)
end

function Net.FireAllClients(name: string, ...: any)
	assert(IS_SERVER)
	getRemote(name):FireAllClients(...)
end

if IS_SERVER then
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		buckets[player.UserId] = nil
	end)
end

-- ===== 클라이언트 =====

function Net.FireServer(name: string, ...: any)
	assert(not IS_SERVER)
	getRemote(name):FireServer(...)
end

function Net.Invoke(name: string, ...: any): any
	assert(not IS_SERVER)
	return getRemote(name):InvokeServer(...)
end

function Net.OnClient(name: string, handler: (...any) -> ()): RBXScriptConnection
	assert(not IS_SERVER)
	return getRemote(name).OnClientEvent:Connect(handler)
end

return Net

end
MODULES['ReplicatedStorage/shared/net/packets'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 네트워크 패킷(RemoteEvent/RemoteFunction) 정의의 "단 하나의 출처". 공식 멀티플레이 데모(shared/packets.luau,
-- Remo + t 라이브러리)와 같은 개념 — 리모트 이름/방향/인자 타입/요청 빈도 제한을 여기에만 적는다. 서버는 이 정의로
-- 리모트를 만들고, 클라이언트→서버 패킷은 net.luau가 인자 타입과 빈도를 자동으로 검사한 뒤에야 핸들러를 부른다.
--
-- Direction: "ClientToServer"(클라가 서버에 요청/보고) / "ServerToClient"(서버가 클라에 통지).
-- Kind: "Event"(RemoteEvent) / "Function"(RemoteFunction, 서버 핸들러가 값을 돌려줌).
-- Args: ClientToServer 패킷만 사용 — 위치 인자 검증 함수 목록(개수도 정확히 맞아야 통과).
-- RateLimit: ClientToServer 패킷만 사용 — 플레이어별 토큰 버킷(PerSecond: 초당 보충량, Burst: 최대 적립량).
-- ServerToClient의 Doc은 인자 설명용(검증하지 않음).
local scenes = require(script.Parent.Parent.config.scenes)

local t = {}

-- 유한한 숫자만(NaN/무한대는 좌표 조작에 쓰일 수 있어 거른다).
function t.number(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function t.string(value: any): boolean
	return typeof(value) == "string" and #value <= 64
end

function t.oneOf(...: string)
	local allowed = {}
	for _, value in { ... } do
		allowed[value] = true
	end
	return function(value: any): boolean
		return typeof(value) == "string" and allowed[value] == true
	end
end

function t.optional(check)
	return function(value: any): boolean
		return value == nil or check(value)
	end
end

function t.either(a, b)
	return function(value: any): boolean
		return a(value) or b(value)
	end
end

local packets = {
	-- ===== 클라이언트 -> 서버 =====
	-- 위치와 씬은 클라이언트가 보고하지 않는다 — 서버가 캐릭터 복제 요청(ReplicationRequest)의 내용에서 직접 읽는다.
	-- 씬 이동은 서버가 승인한다: 클라이언트는 "이 씬으로 가고 싶다"고 요청만 하고, 서버가 지금 씬/포탈 위치를 검증해서
	-- TravelApproved로 승인해야 실제로 이동한다. 플레이어가 어느 씬에 있는지의 진실은 서버가 갖는다.
	RequestTravel = {
		Kind = "Event",
		Direction = "ClientToServer",
		-- 목적지 씬 이름. 탑다운 씬이 여러 개라 이름 목록을 고정하지 않고, 실제로 갈 수 있는지는 서버 travelService가 포탈 위치로 검증한다.
		Args = { t.string },
		RateLimit = { PerSecond = 2, Burst = 3 },
	},
	EquipAction = {
		Kind = "Event",
		Direction = "ClientToServer",
		Args = { t.oneOf("Equip", "Unequip"), t.either(t.number, t.string) }, -- 동작, 인벤토리 슬롯 번호 또는 장비 슬롯 이름
		RateLimit = { PerSecond = 5, Burst = 5 },
	},
	-- ===== 탑다운 씬(온라인 공유) =====
	-- 지금 씬의 몬스터·월드 드랍 전체 목록(씬에 들어왔을 때 한 번). 돌려주는 값: { scene, monsters, drops }
	GetTownState = {
		Kind = "Function",
		Direction = "ClientToServer",
		Args = {},
		RateLimit = { PerSecond = 2, Burst = 4 },
	},
	-- 기본 공격: 바라보는 방향만 보낸다(공격 동작의 판정 프레임에). 위치는 서버가 아는 위치, 간격도 서버가 검증한다.
	-- 펫(M3): 상자 번호에 대한 행동 — Add(함께 다니기) · Remove(상자로) · Lead(대표로 = 파티 1번) · Release(놓아주기, 사라짐)
	PetAction = {
		Kind = "Event",
		Direction = "ClientToServer",
		Args = { t.oneOf("Add", "Remove", "Lead", "Release"), t.number },
