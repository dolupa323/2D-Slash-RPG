-- ---------- 그림을 빌려 쓰는 몬스터의 겉모습(look) ----------
local GLOW_AT = { { -1, 0 }, { 1, 0 }, { 0, -1 }, { 0, 1 } } -- 윤곽의 빛: 한 점씩 비낀 네 자리
local EMBER_X = { -9, -4, 1, 6, 10 } -- 불티 다섯이 피어오르는 자리(몸의 가운데에서 옆으로)
local EMBER_BIG = 0.45 -- 피어오르는 길의 이만큼까지는 두 점, 그 뒤로는 한 점(한 점짜리 셋은 화면에서 보이지 않았다 — 2026-10-11 Play)
local function rgbOf(c): Color3
	-- 「#rrggbb」 글도 받는다(토벌 · 사냥터 정예의 겉모습 — city.js RIFT.elite.look은 글로 적혀 있다. 2026-10-18 검토: 배열로만 읽어 윤곽 · 불티가 검게 나왔다)
	if typeof(c) == "string" then
		local r, g, b = string.match(c, "^#?(%x%x)(%x%x)(%x%x)$")
		if r then
			return Color3.fromRGB(tonumber(r, 16) :: number, tonumber(g, 16) :: number, tonumber(b, 16) :: number)
		end
		return Color3.fromRGB(255, 255, 255)
	end
	return Color3.fromRGB(c[1], c[2], c[3])
end
-- 윤곽의 빛(흰 실루엣 넷) — look.aura가 있을 때만
function MobsView.glowOf(layer: Instance, def)
	if not (def.look and def.look.aura) then
		return nil
	end
	local list = {}
	for i = 1, #GLOW_AT do
		local sp = Sprite.new(layer, def.sprite, 1, true)
		sp.label.ImageColor3 = rgbOf(def.look.aura)
		list[i] = sp
	end
	return list
end
-- 스토리 보스의 예고 윤곽(분홍 실루엣 넷 — 예고하는 동안만 보인다. 끝으로 갈수록 빨리 깜박인다): 공방 시험 탭의 drawStory와 같다
local WARN = Color3.fromRGB(255, 62, 159)
function MobsView.warnOf(layer: Instance, def)
	if not def.story then
		return nil
	end
	local list = {}
	for i = 1, #GLOW_AT do
		local sp = Sprite.new(layer, def.sprite, 1, true)
		sp.label.ImageColor3 = WARN
		list[i] = sp
	end
	return list
end
-- 불티(다섯) — look.embers가 있을 때만
function MobsView.embersOf(layer: Instance, def)
	if not (def.look and def.look.embers) then
		return nil
	end
	local list = {}
	for i = 1, #EMBER_X do
		local e = Stage.image(layer, "Ember", "", 1, 1)
		e.BackgroundColor3 = rgbOf(def.look.embers)
		e.BackgroundTransparency = 0
		e.ZIndex = 4
		e.Visible = false
		list[i] = e
	end
	return list
end
-- 그 장의 겉모습을 그린다: 몸의 그림에 색을 곱하고(눈 · 뿔 · 날이 그 색이 된다), 윤곽의 빛은 숨 쉬듯 밝아졌다 어두워지고, 불티는 1.3초에 걸쳐 스무 점 떠오르며 사라진다
function MobsView.drawLook(m, show: boolean, clip: string, frame: number, now: number)
	local look = m.def.look
	if not look then
		return
	end
	if look.tint and not m.tinted then
		m.tinted = true
		m.sprite.label.ImageColor3 = rgbOf(look.tint)
	end
	local y = m.info.y - m.alt
	if m.glow then
		local fade = 0.45 + 0.25 * math.sin(now * 4 + m.info.id)
		for i, sp in m.glow do
			if show then
				sp:set(clip, frame, (m.px or m.x) + GLOW_AT[i][1], y + GLOW_AT[i][2], m.dir)
				sp.label.ImageTransparency = fade
			else
				sp.label.Visible = false
			end
		end
	end
	if m.embers then
		for i, e in m.embers do
			local k = (now / 1.3 + i / #m.embers + m.info.id * 0.37) % 1
			e.Visible = show
			if show then
				local size = if k < EMBER_BIG then 2 else 1
				e.Size = UDim2.fromOffset(size, size)
				e.Position = UDim2.fromOffset(math.floor(m.x + EMBER_X[i] + math.sin(k * 6.28 + i) * 1.5), math.floor(y - 4 - k * 20))
				e.BackgroundTransparency = k
			end
		end
	end
end

-- 맞았다(타격감 — 공방 combat.js의 hit): 하얗게 번쩍이고, 때린 쪽의 반대(dir)로 조금 밀렸다가 돌아온다(그림만 — 자리와 판정은 서버의 것 그대로). now = 화면의 시계
local HIT = COMBAT.rules.hit
function MobsView.hit(m, now: number, dir: number)
	m.hitAt, m.pushDir = now, dir
end

-- 서버가 보낸 모습을 받아 적는다. now = 받은 때(클라이언트 시계)
function MobsView:apply(list, now: number)
	for _, row in list do
		local m = self.mobs[row[1]]
		if m then
			m.fromX = if m.state == "gone" then row[2] else m.x
			m.toX, m.dir, m.at = row[2], row[3], now
			m.state, m.t, m.hp = row[4], row[5], row[6]
			m.pat = row[9] or 0
			m.aim, m.chain, m.quick = row[10] or 0, row[11] or 0, row[12] == 1 -- 스토리 보스: 겨눈 자리(도약 · 불씨) · 연속기의 차례(0이면 아니다) · 지금 패턴이 연속기의 빠른 것인가
			-- 묶인 · 넘어진 시간(서버의 것). 화면이 방금 어림으로 묶은 직후(cast.luau의 g.bind)에는 그보다 먼저 떠난 0을 받지 않는다
			if (row[7] or 0) > 0 or os.clock() - (m.bindAt or -9) > 0.6 then
				m.bind = row[7] or 0
			end
			m.stun = row[8] or 0
		end
	end
end

function MobsView:get(id: number)
	return self.mobs[id]
end

-- 스토리 보스가 지금 하는 패턴: 연속기(chain)의 둘째부터는 예고 · 굳는 시간이 그 quick배로 줄어든 것을 돌려준다(화면의 그림 · 동작의 박자가 서버의 시간과 맞게). 없으면 nil
local QUICK = {} :: { [any]: { [number]: any } }
function MobsView.patOf(m)
	local S = m.def.story
	local p = S.patterns[m.pat or 0]
	local c = S.patterns[m.chain or 0]
	if not p or not m.quick or not c or not c.quick or c.quick == 1 then
		return p
	end
	local cache = QUICK[p]
	if not cache then
		cache = {}
		QUICK[p] = cache
	end
	local q = cache[c.quick]
	if not q then
		q = table.clone(p)
		q.tell, q.act = BossPat.tell(p, c.quick), BossPat.act(p, c.quick)
		cache[c.quick] = q
	end
	return q
end

-- 그 졸개의 머리 위 높이(발밑에서 위로, 게임의 도트): 병사 16 · 새 몬스터 = 뜬 높이 + 몸의 높이 + 2. 피해 숫자가 뜨는 자리
function MobsView.topOf(m): number
	local def = m.def
	if def.body then
		return (def.lift or 0) + (m.alt or 0) + def.body[2] + 2
	end
	return if def.boss then 30 else 16
end

-- 나는 몬스터의 지금 높이: 서버(sim/room.luau)와 같은 식 — 덮칠 때는 내려왔다 올라가고, 그 밖에는 제 높이에서 조금씩 오르내린다(오르내림은 보이기만 한다)
local function altOf(m, t: number, now: number): number
	local fly = m.def.fly
	if not fly then
		return 0
	end
	if m.state == "atk" then
		local atk = m.def.atk
		local k = if t < atk.windup then t / atk.windup else math.max(0, 1 - (t - atk.windup) / (atk.time - atk.windup))
		return fly.alt - (fly.alt - fly.low) * (k * k * (3 - 2 * k))
	end
	return fly.alt + math.sin(now * 3 + m.info.id) * fly.bob
end

function MobsView:update(now: number)
	local dt = math.clamp(now - (self.now or now), 0, 0.1)
	self.now = now
	for _, m in self.mobs do
		local k = math.clamp((now - m.at) / LERP, 0, 1)
		m.x = m.fromX + (m.toX - m.fromX) * k
		local t = m.t + (now - m.at)
		local char = m.sprite.char
		local clip, frame = "idle", 1
		local show = true
		local bare = m.def.bare == true
		local fade, flash = 0, false -- 그림 없는 동작: 투명한 정도(0 = 또렷) · 흰 번쩍임
		local poseX, poseY = 0, 0 -- 스토리 보스: 대기 그림을 움직이는 만큼(앞으로 · 위로)
		m.tNow = t -- 지금 상태가 된 뒤 흐른 시간(보스의 예고가 얼마나 찼는가 — bossView가 읽는다)
		m.alt = altOf(m, t, now)
		if m.state == "gone" then
			show = false
		elseif m.state == "dead" and m.def.story and char.clips.death and m.def.story.anim.fall then
			-- 스토리 보스가 쓰러진다(쓰러지는 동작 그림이 있는 보스): 그 동작을 한 번 틀고 누운 채 잠깐 있다가 사라진다(BossFx.fall) — 그동안 서버는 보스를 치우지 않는다(story.fall초)
			local c, f, a = BossFx.fall(t, char.clips, m.def.story.anim)
			clip, frame = c :: string, f
			fade = 1 - a
			show = a > 0
			m.tail = nil
		elseif bare and m.state == "dead" then
			frame = Sprite.frameAt(char, "idle", now + m.info.id * 0.3, false)
			fade = math.clamp(t / FADE, 0, 1)
			show = fade < 1
		elseif bare and m.state == "spawn" then
			frame = Sprite.frameAt(char, "idle", now + m.info.id * 0.3, false)
			fade = 1 - math.clamp(t / FADE, 0, 1)
		elseif m.def.story then
			-- 스토리 보스: 받은 동작 그림(idle · run · attack — 사용자가 만든다)을 패턴의 시간에 맞춰 튼다(BossFx.body). 그림이 없는 동작(sweep · shout)은 대기 그림을 움직여 대신한다
			local S = m.def.story
			local p = MobsView.patOf(m) -- 지금 하는 패턴(연속기 안에서는 예고 · 굳는 시간이 줄어든 것)
			m.jump = if p and m.state == "act" then BossPat.leapAlt(p, t) else 0 -- 도약: 뛰어오른 높이(서버와 같은 식)
			-- 친 뒤에 남은 장: 굳어 있는 동안(act)의 동작을 적어 두었다가, 그 뒤 서 있는 동안 이어서 끝까지 튼다(걷거나 다음 패턴을 예고하면 그만둔다)
			if m.state == "act" and p and not p.dash then
				m.tail = { clip = p.clip, act = p.act, t = t }
			elseif m.state == "idle" and m.tail then
				m.tail.t = m.tail.act + t
			else
				m.tail = nil
			end
			local stand
			clip, frame, stand = BossFx.body(m.state, p, t, now, char.clips, S.anim, m.tail)
			if stand then
				poseX, poseY = BossFx.pose(m.state, p, t)
			end
		elseif bare and m.state == "hit" then
			frame = Sprite.frameAt(char, "idle", now + m.info.id * 0.3, false)
			flash = t < FLASH
		elseif m.state == "dead" then
			clip = "death"
			frame = math.min(#char.clips.death.frames, math.floor(t * char.clips.death.fps) + 1)
		elseif m.state == "spawn" then
			clip = "spawn"
			frame = math.min(#char.clips.spawn.frames, math.floor(t * char.clips.spawn.fps) + 1)
		elseif m.state == "atk" then
			clip = "atk"
			frame = math.min(#char.clips.atk.frames, math.floor(t * m.def.atk.fps) + 1)
		elseif m.state == "hit" then
			clip = "hit"
			frame = math.min(#char.clips.hit.frames, math.floor(t * char.clips.hit.fps) + 1)
		elseif m.state == "run" then
			clip = "run"
			frame = Sprite.frameAt(char, "run", now, false)
		else
			frame = Sprite.frameAt(char, "idle", now + m.info.id * 0.3, false)
		end
		-- 타격감: 방금 맞았으면 하얗게 번쩍이고(HIT.flash초), 때린 쪽의 반대로 밀렸다가 돌아온다(HIT.pushT초 — 처음에 크게, 끝으로 갈수록 작게). 그리는 자리(px)만 옮긴다
		local hitAge = now - (m.hitAt or -9)
		if hitAge >= 0 and hitAge < HIT.flash and m.state ~= "gone" and m.state ~= "spawn" then
			flash = true
		end
		local px = m.x
		if hitAge >= 0 and hitAge < HIT.pushT and m.state ~= "gone" then
			local k = 1 - hitAge / HIT.pushT
			px += math.floor((m.pushDir or 0) * (if m.def.boss or m.info.boss then HIT.pushBoss else HIT.push) * k * k + 0.5)
		end
		px += m.dir * poseX
		local py = m.info.y - m.alt - poseY - math.floor((m.jump or 0) + 0.5)
		m.px = px
		if m.under then
			-- 터진 장부터(atk.frame 다음)는 서 있는 몸을 밑에 그린다
			if show and m.state == "atk" and clip == "atk" and frame > m.def.atk.frame then
				m.under:set("idle", 1, px, m.info.y - m.alt, m.dir)
			else
				m.under.label.Visible = false
			end
		end
		MobsView.drawLook(m, show and m.state ~= "dead" and m.state ~= "spawn", clip, frame, now)
		if show then
			m.sprite:set(clip, frame, px, py, m.dir)
			if bare then
				m.sprite.label.ImageTransparency = fade
			end
		else
			m.sprite.label.Visible = false
		end
		if m.white then
			if show and flash then
				m.white:set(clip, frame, px, py, m.dir)
			else
				m.white.label.Visible = false
			end
		end
		if m.warn then
			local p = m.def.story.patterns[m.pat]
			local on = show and m.state == "tell" and p ~= nil
			local see = if on then 1 - (0.35 + 0.45 * math.abs(math.sin(t * (6 + 14 * t / p.tell)))) else 1
			for i, sp in m.warn do
				if on then
					sp:set(clip, frame, px + GLOW_AT[i][1], py + GLOW_AT[i][2], m.dir)
					sp.label.ImageTransparency = see
				else
					sp.label.Visible = false
				end
			end
		end
		-- 체력 띠와 이름표: 다친 졸개에게만
		local alive = m.state ~= "gone" and m.state ~= "dead" and m.state ~= "spawn"
		m.hurt = alive and m.hp < m.info.maxHp and not m.def.story -- 스토리 보스의 체력은 화면 위 가운데의 넓은 바에 뜬다(bossView.luau) — 머리 위의 띠 · 발밑의 이름표는 없다
		-- 띠의 효과: 맞으면 닳은 자리가 밝게 남았다가 따라 줄어들고 띠가 희게 번쩍인다(플레이어의 체력 바와 같다).
		--  없는 동안 · 나타나는 동안에는 처음으로 돌려 둔다(가득 찬 채로 — 다시 나타났을 때 「차오르는」 효과가 뜨지 않게, 첫 타에도 닳은 자리가 보이게)
		if m.state == "gone" or m.state == "spawn" then
			if not m.fresh then
				m.fresh = true
				m.barFx:reset()
				m.barFx:set(1, m.info.maxHp)
				m.shownHp = m.info.maxHp
			end
		else
			m.fresh = false
			if m.shownHp ~= m.hp then
				if m.shownHp == -1 then
					m.barFx:reset() -- 처음 본 몬스터(이미 다쳐 있을 수 있다): 효과 없이 그대로
				end
				m.shownHp = m.hp
				m.barFx:set(math.max(0, m.hp) / m.info.maxHp, math.max(0, m.hp))
			end
			m.barFx:step(dt)
		end
		-- 쓰러뜨린 마지막 타: 띠가 비워지는 것이 보이게, 효과가 끝날 때까지는 띠를 남겨 둔다(쓰러지는 동안)
		local last = m.state == "dead" and not m.def.story and m.barFx:busy()
		m.bar.frame.Visible = m.hurt or last
		m.tag.Frame.Visible = m.hurt -- 자리는 boot가 정한다(이름표끼리 겹치지 않게 쌓는다 — tags())
		if m.hurt or last then
			m.bar.frame.Position = UDim2.fromOffset(Overlay.x(m.x) - BAR_W / 2, Overlay.y(m.info.y - math.max(BAR_UP, MobsView.topOf(m) + 7))) -- 큰 몬스터 · 떠 있는 몬스터는 머리 위로 올린다
		end
	end
end

-- 떠 있는 이름표들: { x(왼쪽), y(위), w, frame } — 화면 틀의 점. 번호 차례(늘 같은 차례로 쌓이게)
function MobsView:tags()
	local out = {}
	for id, m in self.mobs do
		if m.hurt then
			table.insert(out, { id = id, x = Overlay.x(m.x) - math.floor(m.tag.Width / 2), y = Overlay.y(m.info.y) + TAG_DOWN, w = m.tag.Width, frame = m.tag.Frame })
		end
	end
	table.sort(out, function(a, b)
		return a.id < b.id
	end)
	return out
end

function MobsView:destroy()
	for _, m in self.mobs do
		m.sprite:destroy()
		if m.white then
			m.white:destroy()
		end
		for _, sp in m.warn or {} do
			sp:destroy()
		end
		m.bar.frame:Destroy()
		m.tag:Destroy()
	end
	table.clear(self.mobs)
end

return MobsView

end
MODULES['Client/lune/music'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 음악 — 장면마다의 배경 음악과 짧은 징글(레벨 업 · 전직), 효과음(줍기 · 완료 · 수락 …).
--  때릴 때 · 맞을 때 · 대쉬의 소리는 없다(사용자 2026-10-14: "플레이어랑 몬스터 때릴 때 나는 소리랑 맞을때 나는 소리 전부 빼겠습니다. 대쉬 소리 빼겠습니다.") · 뛰기 소리도 없다("점프소리도 제거하세요").
--  다만 내 타의 데미지 숫자가 뜰 때마다 「damage」가 한 번씩 난다(사용자가 고른 소리 — 틈 0: 여러 마리 · 여러 타가 겹쳐도 하나하나 난다).
--  2026-10-14 사용자가 소리를 다시 골라 올렸다 — 퀘스트 완료 · 사망 · 숨은 방에는 징글이 없고(배경 음악을 줄이지 않는다) 효과음만 난다.
--  사용자 2026-10-10: "소리는 … 뮤직에셋 가져왔습니다. 이걸 알맞게 배치해보고 추후 제가 어색한게있으면 말해드릴게요"
--  어느 곡을 어디에 트는지 · 곡마다의 크기는 shared/lune/data/music.generated.luau(공방의 js/lune/design/music.js — 배치는 모두 제안이다).
--  배경 음악: 장면이 바뀌면 그 장면의 곡으로 천천히(fade초) 넘어간다. 같은 곡이면 끊지 않고 이어 튼다(마을 → 건물 안).
--  징글: 배경 음악을 잠깐 줄이고(duck) 한 번 튼다.
--  크기: 배경 음악과 효과음(타격 · 줍기 · 징글)을 따로 0~steps칸으로(한 칸 10%) — 메뉴 → 「소리 설정」(ui/soundWindow.luau). 계정에 저장된다.
--   사용자 2026-10-13: "소리조절 있어야합니다." — 그 앞에는 「소리 끄기 / 켜기」뿐이었고 저장되지 않았다.
--  올린 오디오의 번호(id)가 아직 없는 곡은 조용히 건너뛴다 — 오디오는 사용자가 로블록스에 올린다(공방의 tools/build_lune_music.mjs).
local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MUSIC = require(ReplicatedStorage.shared.lune.data["music.generated"])
local SOUND = require(ReplicatedStorage.shared.lune.data["ui.generated"]).layout.sound -- 칸 수(steps) · 처음 크기(start)

local Music = {}
Music.on = true -- 모두 켰는가(소리 설정의 「모두 끄기 / 켜기」)
Music.MAX = SOUND.steps
Music.level = { music = SOUND.start, sfx = SOUND.start } -- 크기(0~MAX칸): music = 배경 음악 · sfx = 효과음과 징글
Music.now = nil :: string? -- 지금 트는 곡의 이름표

local folder: Folder? = nil
local playing = {} -- [이름표] = { sound, want(가려는 크기 0~1), at(지금 크기 0~1), base(그 곡의 크기) }
local duckT = 0 -- 징글이 끝날 때까지 남은 시간(초)

-- 그 갈래의 크기(0~1): 모두 껐으면 0
local function gain(kind: string): number
	return if Music.on then Music.level[kind] / Music.MAX else 0
end
Music.gain = gain

local function ensure()
	if folder then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "LuneMusic"
	f.Parent = SoundService
	folder = f
	-- 크기를 장마다 조금씩 옮긴다(넘어가기 · 징글 동안 줄이기)
	RunService.Heartbeat:Connect(function(dt)
		duckT = math.max(0, duckT - dt)
		local duck = if duckT > 0 then MUSIC.duck else 1
		local master = gain("music")
		for key, p in playing do
			local step = dt / MUSIC.fade
			if p.at < p.want then
				p.at = math.min(p.want, p.at + step)
			elseif p.at > p.want then
				p.at = math.max(p.want, p.at - step)
			end
			p.sound.Volume = p.base * p.at * duck * master
			if p.want == 0 and p.at == 0 then
				p.sound:Destroy()
				playing[key] = nil
			end
		end
	end)
end

-- 그 이름표의 곡을 배경 음악으로 튼다(nil이면 끈다). 번호가 없는 곡이면 지금 곡만 잦아든다
function Music.play(key: string?)
	ensure()
	if key == Music.now then
		return
	end
	Music.now = key
	for k, p in playing do
		p.want = if k == key then 1 else 0
	end
	local def = if key then MUSIC.tracks[key] else nil
	if not key or not def or def.id == "" or playing[key] then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = key
	sound.SoundId = def.id
	sound.Looped = true
	sound.Volume = 0
	sound.Parent = folder
	sound:Play()
	playing[key] = { sound = sound, want = 1, at = 0, base = def.volume }
end

-- 그 장면의 곡을 튼다
function Music.scene(sceneKey: string)
	Music.play(MUSIC.scene[sceneKey] or MUSIC.scene[string.match(sceneKey, "^(.-)#%d+$") or ""]) -- 토벌의 방(rf1#3)은 그 장면(rf1)의 곡
end

-- 짧은 징글을 한 번 튼다(배경 음악은 그동안 줄인다)
function Music.jingle(key: string)
	ensure()
	local def = MUSIC.jingles[key]
	if not def or def.id == "" or gain("sfx") <= 0 then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = "Jingle_" .. key
	sound.SoundId = def.id
	sound.Volume = def.volume * gain("sfx")
	sound.Parent = folder
	sound.Ended:Connect(function()
		sound:Destroy()
	end)
	sound:Play()
	duckT = math.max(duckT, def.sec)
end

-- 효과음을 한 번 낸다(줍기 · 완료 · 수락 … — 공방 music.js의 sfx). 올린 번호가 없으면 아무 소리도 나지 않는다.
--  같은 소리는 gap초 안에 다시 내지 않는다(연타 · 여럿을 한꺼번에 칠 때 뭉개지지 않게). 돌려주는 것: 소리를 냈는가
--  whole = upto가 있는 소리도 끝까지 튼다(데미지 소리: 줄마다는 짧게 다다다다, 그 타의 마지막 줄만 끝까지 — 사용자 2026-10-14)
local sfxAt: { [string]: number } = {}
function Music.sfx(key: string, whole: boolean?): boolean
	local def = MUSIC.sfx and MUSIC.sfx[key]
	if not def or def.id == "" or gain("sfx") <= 0 then
		return false
	end
	local now = os.clock()
	if now - (sfxAt[key] or -9) < def.gap then
		return false
	end
	sfxAt[key] = now
	ensure()
	local sound = Instance.new("Sound")
	sound.Name = "Sfx_" .. key
	sound.SoundId = def.id
	sound.Volume = def.volume * gain("sfx")
	if def.upto and not whole then
		-- 앞에서부터 upto초까지만 튼다(데미지 소리 — 사용자 2026-10-14: "이 음성파일의 절반 만 재생합니다")
		sound.PlaybackRegionsEnabled = true
		sound.PlaybackRegion = NumberRange.new(0, def.upto)
		task.delay(def.upto + 0.5, function()
			if sound.Parent then
				sound:Destroy() -- 구간 끝에서 Ended가 오지 않아도 치운다
			end
		end)
	end
	sound.Parent = folder
	sound.Ended:Connect(function()
		sound:Destroy()
	end)
	sound:Play()
	return true
end

-- 모두 켜고 끈다(소리 설정). 돌려주는 것: 지금 켜져 있는가
function Music.toggle(): boolean
	ensure()
	Music.on = not Music.on
	return Music.on
end

-- 그 갈래("music" · "sfx")의 크기를 n칸으로. 돌려주는 것: 바뀌었는가(범위 밖 · 같은 값이면 false)
function Music.setLevel(kind: string, n: number): boolean
	if typeof(n) ~= "number" or Music.level[kind] == nil or n ~= math.floor(n) or n < 0 or n > Music.MAX or Music.level[kind] == n then
		return false
	end
	Music.level[kind] = n
	return true
end

-- 저장된 설정을 얹는다(서버가 준 계정의 것 — 꼴은 서버가 이미 봤다) · 저장할 꼴로 내놓는다
function Music.import(sound: any)
	if typeof(sound) ~= "table" then
		return
	end
	Music.setLevel("music", sound.music)
	Music.setLevel("sfx", sound.sfx)
	Music.on = sound.on ~= false
end
function Music.export()
	return { music = Music.level.music, sfx = Music.level.sfx, on = Music.on }
end

return Music

end
MODULES['Client/lune/naviArrow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 길찾기의 화살표 — 캐릭터 머리 위에 가야 할 쪽을 가리킨다(셈은 shared/lune/ui/navi.luau).
--  사용자 2026-10-13: "그 버튼 누르면  길찾기 되면서 가야하는 방향 캐릭터 머리위에 화살표로 알려주는 기능 추가하세요" → 같은 날 "퀘스트 길찾기  캐릭터 머리위에 화살표 퀄리티 더 올리고"
--  그림: 처음에는 내가 네모로 짠 한 색 화살표였다 → Codex가 그린 민트 수정 화살표(밝은 윗면 · 어두운 아랫면 · 흰 빛 · 어두운 테두리)를 칸 그대로 옮긴 부품 넷
--   (naviUp · naviRight · naviDown · naviLeft — 공방 tools/build_lune_navi.mjs → build_lune_ui.mjs → 부품 그림 한 장). 여기서 모양을 따로 그리지 않는다.
--  왼쪽 · 오른쪽 · 위 · 아래의 그림 넷을 만들어 두고 하나만 보인다. 가리키는 쪽으로 조금씩 오간다. 문 · 주민 앞에 다 오면 위쪽 화살표가 빠르게 오간다(↑를 누른다).
--  화면 틀의 격자에 그린다(그림의 한 점 = 화면 틀의 SCALE점 — 정수 배라 도트가 뭉개지지 않는다. 게임 세계의 자리는 Overlay가 옮겨 준다).
local Overlay = require(script.Parent.overlay)
local Kit = require(script.Parent.ui.kit)

local NaviArrow = {}
NaviArrow.UP = 44 -- 발밑에서 화살표 가운데까지(게임의 도트 — 머리 위)
NaviArrow.SCALE = 2 -- 그림의 한 점이 화면 틀의 몇 점인가
NaviArrow.PART = { up = "naviUp", right = "naviRight", down = "naviDown", left = "naviLeft" }
NaviArrow.WAVE = { slow = 6, fast = 12, reach = 4 } -- 오가는 빠르기(가는 중 · 다 왔다) · 오가는 폭(화면 틀의 점)

function NaviArrow.new()
	local self = setmetatable({}, { __index = NaviArrow })
	local layer = Overlay.layer("Navi", 14)
	self.frames, self.size = {}, {}
	for dir, part in NaviArrow.PART do
		local w, h = Kit.partSize(part)
		local f = Kit.part(layer, part, 0, 0)
		f.Name = "Arrow_" .. dir
		f.Size = UDim2.fromOffset(w * NaviArrow.SCALE, h * NaviArrow.SCALE)
		f.Visible = false
		self.frames[dir] = f
		self.size[dir] = { w * NaviArrow.SCALE, h * NaviArrow.SCALE }
	end
	self.shown = nil :: string?
	return self
end

-- dir = "left" | "right" | "up" | "down" | "enter" | "none" | nil · (wx, wy) = 캐릭터의 발밑(게임 세계) · clock = 흐른 시간(초)
function NaviArrow:set(dir: string?, wx: number, wy: number, clock: number)
	local face = if dir == "enter" then "up" elseif dir == "none" then nil else dir
	if face ~= self.shown then
		for name, f in self.frames do
			f.Visible = name == face
		end
		self.shown = face
	end
	if not face then
		return
	end
	local f, size = self.frames[face], self.size[face]
	-- 가리키는 쪽으로 오간다(다 왔으면 빠르게 — ↑를 누르라는 뜻). 한 점씩 딱딱 움직인다(도트 그림이라 반 점에 걸치지 않게)
	local W = NaviArrow.WAVE
	local wave = math.floor((math.sin(clock * (if dir == "enter" then W.fast else W.slow)) + 1) / 2 * W.reach + 0.5)
	local ox = if face == "left" then -wave elseif face == "right" then wave else 0
	local oy = if face == "up" then -wave elseif face == "down" then wave else 0
	f.Position = UDim2.fromOffset(Overlay.x(wx) - math.floor(size[1] / 2) + ox, Overlay.y(wy - NaviArrow.UP) - math.floor(size[2] / 2) + oy)
end

function NaviArrow:hide()
	self:set(nil, 0, 0, 0)
end

return NaviArrow

end
MODULES['Client/lune/othersView'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 같은 맵에 있는 다른 사람들 — 서버가 알려 준 이름표(Who)와 자리(Heroes · 초당 10번)를 받아 그린다. 자리 사이는 이어서 그린다.
--  동작은 움직임에서 짐작한다: 옆으로 움직이면 달리기, 위아래로 움직이면 뛰기, 아니면 서 있기. 기술은 서버가 알려 준 것(Act)을 그 구간 동안 튼다.
--  발밑에 이름표(메이플처럼 이름만) — 파티원은 민트색이다. 이름표는 글씨의 층(화면 틀 — overlay.luau)에 그린다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local COMBAT = require(ReplicatedStorage.shared.lune.data["combat.generated"])
local CLASSES = require(ReplicatedStorage.shared.lune.data["classes.generated"])
local Kitset = require(ReplicatedStorage.shared.lune.kitset)
local CHARS = require(ReplicatedStorage.shared.lune.data["chars.generated"])
local Sprite = require(script.Parent.sprite)
local Grave = require(script.Parent.grave)
local Ui = require(script.Parent.ui.ui)
local Overlay = require(script.Parent.overlay)

local WHITE = Ui.COLOR.text
local MINT = Ui.COLOR.accent
local LERP = 0.12 -- 자리 보고 사이를 이만큼에 걸쳐 잇는다(초)
local TAG_DOWN = 4 -- 이름표: 발밑에서 이만큼 아래(화면 틀의 점)

local Others = {}
Others.__index = Others
Others.TAG_DOWN = TAG_DOWN

-- 이름표에 적는 글: 이름만(레벨은 파티원 칸 · 파티 창에서 본다)
function Others.tagText(_level: number, name: string): string
	return name
end

function Others.new(heroLayer: Frame, tagLayer: Frame, myId: any, ladders: any)
	local self = setmetatable({}, Others)
	self.ladders = ladders or {} -- 이 장면의 사다리(사다리 위에 있으면 오르기 동작 — 2026-10-16 밤)
	self.heroLayer, self.tagLayer, self.myId = heroLayer, tagLayer, myId
	self.list = {} -- [번호] = 한 사람
	self.fx = nil :: any -- 효과(effects.luau) — boot가 넣어 준다. 대쉬의 잔상 · 속도선을 여기에 그린다
	self.graveLayer = nil :: any -- 비석을 놓는 층 — boot가 넣어 준다(장면의 Graves 층)
	self.last = 0 -- 지난번 update의 때(잔상의 간격을 잰다)
	return self
end

local function drop(o)
	o.sprite:destroy()
	o.tag:Destroy()
	if o.grave then
		o.grave:Destroy()
	end
end

-- 방 사람들의 이름표: 새로 온 사람은 만들고, 나간 사람은 지운다
function Others:setWho(roster)
	local seen = {}
	for _, w in roster do
		if w.id ~= self.myId then
			seen[w.id] = true
			local o = self.list[w.id]
			if o and o.class ~= w.class then
				drop(o)
				o = nil
			end
			if not o then
				o = {
					id = w.id,
					class = w.class,
					sprite = Sprite.new(self.heroLayer, w.class, 4),
					tag = Ui.tag(self.tagLayer, "", WHITE, 220, true), -- 플레이어의 이름표: 민트 테두리를 두른 판
					x = 0,
					y = 0,
					fromX = 0,
					fromY = 0,
					toX = 0,
					toY = 0,
					at = -1,
					dir = 1,
					alive = true,
					placed = false,
					moveT = -9,
					airT = -9,
					act = nil :: any,
				}
				o.sprite.label.Visible = false
				o.tag.Frame.Visible = false
				self.list[w.id] = o
			end
			if o.name ~= w.name or o.level ~= w.level then
				o.name, o.level = w.name, w.level
				o.tag:SetText(Others.tagText(w.level, w.name))
			end
		end
	end
	for id, o in self.list do
		if not seen[id] then
			drop(o)
			self.list[id] = nil
		end
	end
end

-- 자리: { { id, x, y, dir, 살아 있는가 } … }
function Others:apply(list, now: number)
	for _, row in list do
		local o = self.list[row[1]]
		if o then
			if not o.placed then
				o.x, o.y = row[2], row[3]
				o.placed = true
			end
			o.fromX, o.fromY = o.x, o.y
			o.toX, o.toY, o.dir, o.at = row[2], row[3], row[4], now
			if math.abs(o.toX - o.fromX) > 0.5 then
				o.moveT = now
			end
			if math.abs(o.toY - o.fromY) > 1.5 then
				o.airT = now
			end
			if row[5] and not o.alive then
				o.act = nil
			end
			if not row[5] and o.alive then
				o.deadAt = now
			end
			o.alive = row[5]
		end
	end
end

-- 2~4차의 쓰는 스킬(직업 묶음의 그 스킬)의 동작: 구간마다 서버가 알려 준다(next) — 되풀이 구간(누르고 있는 것 · 모으는 것 · 조건을 기다리는 것)은 끝 장을 넘으면 loopFrom으로 돌아간다
local KITDEF = {}
local function kitDef(skillId: string)
	local def = KITDEF[skillId]
	if def == nil then
		local skill, kit = Kitset.skill(skillId)
		def = false
		if skill and kit and skill.segs and COMBAT.cast[skillId] then
			local segs = {}
			for i, s in skill.segs do
				local clip = CHARS.chars[kit.who].clips[s.clip]
				local from, to = s.from or 0, s.to or (if clip then #clip.frames - 1 else 0)
				local fps = s.fps or 14
				local loops = s.loop or s.hold or s.charge or s.till
				local time = if s.loop then s.dur elseif s.hold then s.max or 3 elseif s.charge then (to - from + 1) / fps + 1 elseif s.till then s.max or 1.5 else (to - from + 1) / fps
				segs[i] = { clip = s.clip, from = from, to = to, fps = fps, time = time, next = true, loops = loops == true, loopFrom = s.loopFrom or from }
			end
			def = { type = "cast", segs = segs }
		end
		KITDEF[skillId] = def
	end
	return def or nil
end

-- 그 사람이 기술의 한 구간을 쓴다
function Others:act(id: any, skillId: string, seg: number, x: number, y: number, dir: number, now: number)
	local o = self.list[id]
	local def = COMBAT.skills[skillId] or kitDef(skillId)
	if not o or not def or not def.segs[seg] then
		return
	end
	o.act = { def = def, seg = seg, t0 = now }
	o.dir = dir
	if not o.placed then
		o.x, o.y, o.toX, o.toY, o.fromX, o.fromY, o.placed = x, y, x, y, x, y, true
	end
	-- 대쉬를 시작했다: 속도선(잔상은 update가 가는 동안 남긴다)
	if def.type == "move" and seg == 1 and self.fx then
		self.fx:streaks(x, y, def.speed, dir, CLASSES.classes[o.class].tone)
	end
end

-- party = 내 파티원 { [번호] = true }
function Others:update(now: number, party)
	local dt = math.clamp(now - self.last, 0, 0.1)
	self.last = now
	for id, o in self.list do
		if not o.placed then
			continue
		end
		local k = math.clamp((now - o.at) / LERP, 0, 1)
		o.x = o.fromX + (o.toX - o.fromX) * k
		o.y = o.fromY + (o.toY - o.fromY) * k
		local char = o.sprite.char
		local clip, frame = "idle", Sprite.frameAt(char, "idle", now + (id % 7) * 0.3, false)
		local act = o.act
		if act then
			local segDef = act.def.segs[act.seg]
			local t = now - act.t0
			if t >= segDef.time then
				-- 저절로 이어지는 다음 구간(한 번 더 눌러 잇는 구간은 서버가 따로 알려 준다)
				local nextDef = act.def.segs[act.seg + 1]
				if nextDef and not nextDef.next then
					act.seg += 1
					act.t0 += segDef.time
					segDef, t = nextDef, now - act.t0
				else
					o.act, act = nil, nil
				end
			end
			if act then
				local f = segDef.from + math.floor(t * segDef.fps)
				if f > segDef.to then
					f = if segDef.loops then segDef.loopFrom + ((f - segDef.to - 1) % (segDef.to - segDef.loopFrom + 1)) else segDef.to
				end
				clip, frame = segDef.clip, f + 1
				-- 대쉬로 가는 동안: 잔상
				if act.def.type == "move" and t < act.def.dist / act.def.speed and self.fx and o.alive then
					self.fx:trail(o, dt, o.class, clip, frame, o.x, o.y, o.dir, CLASSES.classes[o.class].tone)
				end
			end
		end
		if not o.alive then
			local n = #char.clips.death.frames
			clip, frame = "death", math.min(n, math.floor((now - (o.deadAt or now)) * char.clips.death.fps) + 1)
		elseif not act then
			local onLadder = false
			for _, l in self.ladders do
				onLadder = onLadder or (math.abs(o.x - l.x) <= 1 and o.y > l.top + 0.5 and o.y < l.bottom - 0.5)
			end
			if onLadder then
				-- 사다리 위: 오르내리는 중이면 장이 넘어가고, 멈춰 있으면 첫 장
				clip, frame = "climb", if now - o.airT < 0.25 then Sprite.frameAt(char, "climb", now, false) else 1
			elseif now - o.airT < 0.25 then
				clip, frame = "jump", Sprite.frameAt(char, "jump", (now - o.airT) + 0.2, true)
			elseif now - o.moveT < 0.25 then
				clip, frame = "run", Sprite.frameAt(char, "run", now, false)
			end
		end
		o.sprite:set(clip, frame, o.x, o.y, o.dir)
		o.clip, o.frame = clip, frame -- 지금의 동작과 장(boot가 버프의 모습을 그 위에 입힌다 — cast.luau의 look)
		-- 쓰러진 사람: 쓰러지는 동작이 끝나면 몸 대신 비석이 선다(마을로 돌아가거나 소생을 받을 때까지)
		local downFor = if o.alive then -1 else now - (o.deadAt or now) - #char.clips.death.frames / char.clips.death.fps
		o.fallen = downFor >= 0
		if o.fallen and self.graveLayer then
			o.grave = o.grave or Grave.new(self.graveLayer)
			Grave.put(o.grave, o.x, o.y, downFor)
			o.sprite.label.Visible = false
		elseif o.grave then
			o.grave.Visible = false
		end
		o.tag.Frame.Visible = true -- 자리는 boot가 정한다(이름표끼리 겹치지 않게 쌓는다 — tags())
		local color = if party and party[id] then MINT else WHITE
		if o.tagColor ~= color then
			o.tagColor = color
			o.tag:SetColor(color)
		end
	end
end

-- 이름표들: { x(왼쪽), y(위), w, frame } — 화면 틀의 점. 번호 차례(늘 같은 차례로 쌓이게)
function Others:tags()
	local out = {}
	for id, o in self.list do
		if o.placed then
			table.insert(out, { id = id, x = Overlay.x(o.x) - math.floor(o.tag.Width / 2), y = Overlay.y(o.y) + TAG_DOWN, w = o.tag.Width, frame = o.tag.Frame })
		end
	end
	table.sort(out, function(a, b)
		return a.id < b.id
	end)
	return out
end

-- 지금 방에 있는 다른 사람들(파티 창의 초대 목록이 쓴다)
function Others:roster()
	local out = {}
	for id, o in self.list do
		table.insert(out, { id = id, name = o.name, level = o.level, class = o.class })
	end
	table.sort(out, function(a, b)
		return a.id < b.id
	end)
	return out
end

function Others:destroy()
	for _, o in self.list do
		drop(o)
	end
	table.clear(self.list)
end

return Others

end
MODULES['Client/lune/overlay'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 게임 세계의 자리에 붙는 화면 글씨 — 발밑의 이름표 · 졸개의 체력 띠 · 주민의 말풍선 · 떠오르는 알림 글.
--  이것들은 글씨라서 화면 틀의 고운 격자에 그리지만(client/lune/stage.luau의 ui 층), 놓이는 자리는 게임 세계의 도트다.
--  그래서 화면마다 "게임 도트 → 화면 틀의 점"으로 바꿔 자리를 다시 잡는다(카메라가 움직이면 같이 움직인다).
--  게임 도트 하나는 화면 틀의 2.5점(1080p)이라 반 점에 걸릴 수 있다 — 가까운 점으로 맞춘다(화면에서 1픽셀 안쪽의 어긋남).
local Stage = require(script.Parent.stage)

local Overlay = {}
Overlay.camX, Overlay.camY = 0, 0

function Overlay.init()
	Overlay.root = Stage.group(Stage.ui, "Over", 20)
	return Overlay
end

-- 장면마다의 층(장면을 바꿀 때 통째로 지운다). z = 겹치는 차례
function Overlay.layer(name: string, z: number): Frame
	return Stage.group(Overlay.root, name, z)
end

-- 카메라(게임 도트)를 알린다 — 장면을 그릴 때마다
function Overlay.setCamera(camX: number, camY: number)
	Overlay.camX, Overlay.camY = camX, camY
end

-- 게임 세계의 (wx, wy) → 화면 틀의 점
function Overlay.x(wx: number): number
	return math.floor((wx - Overlay.camX) * Stage.ratio + 0.5)
end

function Overlay.y(wy: number): number
	return math.floor((wy - Overlay.camY) * Stage.ratio + 0.5)
end

-- 게임 도트의 길이 → 화면 틀의 점(가까운 점으로)
function Overlay.len(dots: number): number
	return math.floor(dots * Stage.ratio + 0.5)
end

return Overlay

end
MODULES['Client/lune/partyHud'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 파티원 칸 — 늘 보이는 화면의 왼쪽 위(공방 「기본 · UI」 탭의 화면 배치, data/ui.generated.luau의 hud.party). 파티가 없으면 안 보인다.
--  파티원(나를 뺀 셋까지)마다 이름(판 없이 테두리 두른 글)과 그 아래 가는 체력 줄. 다른 맵에 있는 사람은 이름이 흐리다. 사람 수만큼 아래로 쌓인다.
--  초대를 받으면 화면 위쪽 가운데에 「○○ — 파티에 초대했다 · 받기 · 거절」이 뜬다(30초 뒤에 저절로 사라진다).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local UI = require(lune.data["ui.generated"])
local Layout = require(lune.ui.layout)
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR
local P = Layout.PARTY -- 치수(자동 검사가 같은 값을 본다)
local ROW = P.row -- 한 사람: 이름 한 줄 + 체력 줄 + 사이

local PartyHud = {}
PartyHud.ROW = ROW
PartyHud.ASK_TEXT = P.askText
PartyHud.ASK = P.ask -- 초대 알림의 자리(위쪽 가운데 — 보스 체력 칸 아래)

function PartyHud.init(root: Frame, send)
	local r = UI.hud.party
	local box = Stage.placeRect(root, "Party", r)
	box.Visible = false
	PartyHud.box = box
	PartyHud.rows = {}
	PartyHud.send = send
	PartyHud.root = root
end

-- Roblox의 채팅 창은 화면 왼쪽 위에 선다 — 파티원 칸의 자리다. PC에서는 파티원 칸을 그 창의 아래 끝(top — 화면 틀의 점. 모르거나 폰이면 0)에서 조금 띄워 그 아래에 놓는다.
--  창이 너무 길어 파티원 칸이 체력 덩어리 쪽으로 밀리게 되면(화면 아래에 keep만큼은 남긴다) 제자리에 둔다. 치수는 공방 ui.js의 CHATUI(gap · keep)
function PartyHud.setTop(top: number)
	local box = PartyHud.box
	if not box then
		return
	end
	local r = UI.hud.party
	local base = Stage.atPosition(r.at, r.x, r.y)
	local y = base.Y.Offset
	local want = top + UI.chatUi.gap
	if top > 0 and want > y and want + r.h <= Stage.uiH - UI.chatUi.keep then
		y = want
	end
	box.Position = UDim2.new(base.X.Scale, base.X.Offset, base.Y.Scale, y)
end

-- info = 서버가 보낸 파티의 모습 { leader, members = { { id, name, class, level, hp, maxHp, scene } … } } · myId = 나 · scene = 내가 있는 맵
function PartyHud.set(info, myId: any, scene: string)
	if not PartyHud.rows then
		return -- 아직 화면을 짓기 전에 서버의 파티 소식이 먼저 왔다(시작할 때) — 장면에 들어갈 때 boot가 다시 부른다
	end
	local r = UI.hud.party
	for _, row in PartyHud.rows do
		row.frame:Destroy()
	end
	table.clear(PartyHud.rows)
	local n = 0
	for _, m in (info and info.members) or {} do
		if m.id ~= myId and n < P.max then
			local frame = Ui.group(PartyHud.box, 0, n * ROW, r.w, ROW, "Member")
			local here = m.scene == scene
			Ui.text(frame, m.name, 0, 0, r.w, { color = if here then C.accent else C.dim, outline = true })
			local bar = Ui.bar(frame, 0, P.barY, P.barW, P.barH, C.hp)
			bar:set(if here then m.hp / math.max(1, m.maxHp) else 0)
			table.insert(PartyHud.rows, { frame = frame })
			n += 1
		end
	end
	PartyHud.box.Visible = n > 0
end

-- 초대 알림. ask = { from, name } — from이 false면 지운다
function PartyHud.ask(ask)
	if PartyHud.prompt then
		PartyHud.prompt:Destroy()
		PartyHud.prompt = nil
	end
	if not ask or not ask.from then
		return
	end
	local a = PartyHud.ASK
	local holder = Stage.place(PartyHud.root, "PartyAsk", a.at, a.x, a.y, a.w, a.h)
	holder.ZIndex = 30
	local panel = Ui.panel(holder, 0, 0, a.w, a.h)
	Ui.text(panel, ask.name, a.pad, 12, a.w - a.pad * 2, { font = "body", color = C.gold })
	Ui.text(panel, PartyHud.ASK_TEXT, a.pad, 32, a.w - a.pad * 2)
	local bw = math.floor((a.w - a.pad * 2 - 8) / 2)
	Ui.button(panel, "받기", a.pad, 52, bw, function()
		PartyHud.send("Party", "accept")
		PartyHud.ask(nil)
	end, { main = true }).frame.Name = "Accept"
	Ui.button(panel, "거절", a.pad + bw + 8, 52, bw, function()
		PartyHud.send("Party", "decline")
		PartyHud.ask(nil)
	end).frame.Name = "Decline"
	PartyHud.prompt = holder
	task.delay(30, function()
		if PartyHud.prompt == holder then
			PartyHud.ask(nil)
		end
	end)
end

return PartyHud

end
MODULES['Client/lune/questHud'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 퀘스트 알리미 — 늘 보이는 화면의 오른쪽 위(공방 「기본 · UI」 탭의 화면 배치, data/ui.generated.luau의 hud.quest).
--  사용자 2026-10-11: "지금 우측 상단에 있는 퀘스트 퀘스트라는 인식이 되지가 않아요 ui 만들어서 퀘스트처럼 보이게하세요" — 전에는 판 없이 글만 오른쪽에 붙여 적었다.
--  이제는 창과 같은 어두운 판 위에(메이플스토리의 퀘스트 알리미처럼):
--   ① 머리줄: 「!」 그림 + 「퀘스트」 + 오른쪽에 「진행 N」
--   ② 하는 중인 퀘스트(전직 → 메인 → 부탁): 갈래의 표(「메인」 노랑 · 「전직」 민트 · 「부탁」 회색) + 이름 / 할 일마다 왼쪽에 글 · 오른쪽에 「3/8」 · 그 아래 진행 띠.
--      다 했으면 「?」 그림 + 「샛별에게 간다」(풀빛)
--   ③ 받을 수 있는 퀘스트(길잡이 — sim/quests.luau의 Q.guide): 가르는 줄 아래에 「받을 수 있는 퀘스트」, 「! 이름」과 「샛별에게 받는다 · 초승달 마을」(레벨이 모자라면 흐리게 「Lv.4부터 받는다」)
--  ④ 길찾기 단추(사용자 2026-10-13: "각각 퀘스트마다  간단한 화살표 버튼 생기게해서  그 버튼 누르면  길찾기"): 퀘스트마다 이름 줄의 오른쪽 끝에 작은 화살표 단추.
--      누르면 그 퀘스트의 길찾기가 켜지고(민트 — 다시 누르면 꺼진다 · 한 번에 하나) 캐릭터 머리 위에 가야 할 쪽의 화살표가 뜬다(셈 shared/lune/ui/navi.luau · 그림 naviArrow.luau)
--  판의 높이는 적은 만큼만이다. 칸의 높이에 들어가는 데까지만 적는다(스마트폰은 손가락 단추에 닿지 않게 더 낮다). 글은 모두 판 안쪽 폭에 들어간다.
--  줄의 차례 · 높이 · 폭의 셈은 shared/lune/ui/questPanel.luau(자동 검사 27이 본다) — 여기서는 그리기만 한다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local UI = require(lune.data["ui.generated"])
local Quests = require(lune.sim.quests)
local Panel = require(lune.ui.questPanel) -- 줄의 차례 · 높이 · 폭의 셈
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)
local Kit = require(script.Parent.ui.kit)

local C = Ui.COLOR
local LINE = Panel.LINE

local QuestHud = {}
QuestHud.W = Panel.W
QuestHud.H = Panel.H
QuestHud.MARK = { new = UI.questMark.new, done = UI.questMark.done } -- 「!」 · 「?」 그림(주민 머리 위의 것과 같다)

QuestHud.touch, QuestHud.buffs = false, false -- 스마트폰 단추가 켜졌는가 · 버프가 떠 있는가
QuestHud.covered = false -- 오른쪽 창이 이 자리를 덮고 있는가(덮인 동안은 그리지 않는다)
QuestHud.shown, QuestHud.guided = 0, 0
QuestHud.any = false -- 적을 것이 있는가(어느 모습에서든 — 없으면 판이 없다)
QuestHud.navi = nil :: string? -- 길찾기를 켠 줄(퀘스트의 이름표 · 일일 의뢰의 이름표)
QuestHud.onNavi = nil :: any -- 길찾기 단추를 눌렀을 때 (이름표)
QuestHud.NAV_ARROW = { { 0, 2, 5, 3 }, { 5, 0, 1, 7 }, { 6, 1, 1, 5 }, { 7, 2, 1, 3 }, { 8, 3, 1, 1 } } -- 단추 안의 오른쪽 화살표(9x7 — 네모들 { x, y, w, h })
QuestHud.size = Panel.SIZE_FIRST -- 알리미의 크기: 최소(머리줄만) · 중간(중요한 것만 — 처음) · 최대(모두). 머리줄의 「−」 · 「+」로 한 단계씩. 이번 접속 동안 이어진다
QuestHud.list = nil :: any -- 스크롤하는 칸
QuestHud.scrollY = 0 -- 스크롤한 자리(다시 그려도 — 몬스터를 잡아 숫자가 오를 때마다 다시 그린다 — 그 자리에 머문다)
QuestHud.total = 0 -- 받은 것의 수(퀘스트 + 일일 의뢰)
QuestHud.glow = nil :: Frame? -- 켠 길찾기 단추의 빛(QuestHud.step이 밝기를 오르내린다)
QuestHud.GLOW = { speed = 5, min = 0.15, max = 0.75 } -- 빛의 빠르기 · 가장 진할 때와 옅을 때의 비침
local last = nil :: any -- 마지막으로 그린 것(접기 단추 · 격자가 바뀌었을 때 다시 그린다)

-- 자리: 버프(바로 위의 칸)가 없으면 그 자리로 올라붙고, 버프가 뜨면 제자리로 내려간다(공방 「기본 · UI」 탭의 4번 칸: "버프가 없으면 그 자리로 올라붙는다").
--  스마트폰 단추가 켜지면 메뉴 단추(오른쪽 위) 아래(data/ui.generated.luau의 hudTouch) — 거기서는 버프가 메뉴 단추의 왼쪽에 떠서 겹치지 않는다
local function place()
	local r = UI.hud.quest
	local t = UI.hudTouch.quest
	if not QuestHud.box then
		return
	end
	if QuestHud.touch and t then
		QuestHud.box.Position = Stage.atPosition(t.at, t.x, t.y)
	else
		QuestHud.box.Position = Stage.atPosition(r.at, r.x, if QuestHud.buffs then r.y else UI.hud.buffs.y)
	end
end

function QuestHud.init(root: Frame)
	local r = UI.hud.quest
	local box = Stage.place(root, "Quests", r.at, r.x, UI.hud.buffs.y, r.w, r.h)
	box.Visible = false
	QuestHud.box = box
	place()
	-- 창 크기가 바뀌어 격자가 달라지면 판이 쓸 수 있는 높이도 달라진다
	if Stage.onResize then
		Stage.onResize(function()
			QuestHud.redraw()
		end)
	end
end

-- 마지막에 그린 것을 다시 그린다(접기 · 펴기 · 격자가 바뀜)
function QuestHud.redraw()
	if last then
		QuestHud.set(last[1], last[2], last[3], last[4])
	end
end

-- 켠 길찾기 단추가 빛난다(그리는 고리가 장마다 부른다 — clock = 흐른 시간)
function QuestHud.step(clock: number)
	local glow = QuestHud.glow
	if glow and glow.Parent then
		local g = QuestHud.GLOW
		glow.BackgroundTransparency = g.min + (g.max - g.min) * (math.sin(clock * g.speed) + 1) / 2
	end
end

function QuestHud.setTouch(on: boolean)
	QuestHud.touch = on
	place()
end

-- 오른쪽 끝에 창이 떴다 · 닫혔다: 창의 바탕이 살짝 비쳐서(ui.js의 panelAlpha) 알리미의 글이 창의 글 뒤로 비쳐 보인다 — 덮인 동안은 감춘다
function QuestHud.setCovered(on: boolean)
	QuestHud.covered = on
	if QuestHud.box then
		QuestHud.box.Visible = not on and QuestHud.any == true
	end
end

-- 버프가 뜨고 사라졌다(켜 둔 사출기 · 영혼 · 열기)
function QuestHud.setBuffs(on: boolean)
	if QuestHud.buffs ~= on then
		QuestHud.buffs = on
		place()
	end
end

-- 길찾기 단추: 줄(y)의 오른쪽 끝에. 꺼져 있으면 어두운 바탕에 밝은 화살표(원래 색).
--  켜면 빛난다(사용자 2026-10-13: "길찾기 활성화되면  빛나고   다시눌러서 비활성화하면 원래색으로 되는형식"): 민트 바탕 + 위쪽의 밝은 줄 + 어두운 화살표, 둘레에 밝은 빛이 번지고 그 빛이 밝아졌다 옅어졌다 한다.
--  누르는 자리는 그림보다 넓다(손가락)
local function naviButton(panel: Instance, y: number, key: string)
	local on = QuestHud.navi == key
	local x = Panel.PAD + Panel.INNER - Panel.NAV_W
	if on then
		local glow = Ui.box(panel, x - 2, y - 2, Panel.NAV_W + 4, Panel.NAV_H + 4, C.accentHot, QuestHud.GLOW.min)
		glow.Name = "NaviGlow"
		QuestHud.glow = glow
	end
	local btn = Ui.box(panel, x, y, Panel.NAV_W, Panel.NAV_H, if on then C.accent else C.panel2)
	btn.Name = "Navi_" .. key
	if on then
		Ui.box(btn, 0, 0, Panel.NAV_W, 2, C.accentHot).Name = "Shine"
	end
	local ox, oy = math.floor((Panel.NAV_W - 9) / 2), math.floor((Panel.NAV_H - 7) / 2)
	for _, r in QuestHud.NAV_ARROW do
		Ui.box(btn, ox + r[1], oy + r[2], r[3], r[4], if on then C.ink else C.text).Name = "Arrow"
	end
	local hit = Ui.group(panel, x - 4, y - 3, Panel.NAV_W + 8, Panel.NAV_H + 6, "NaviHit")
	hit.ZIndex = 8
	Ui.hit(hit).Activated:Connect(function()
		if QuestHud.onNavi then
			QuestHud.onNavi(key)
		end
	end)
end

-- 크기를 바꾸는 단추 둘: 머리줄의 오른쪽 끝에 「−」 · 「+」. 「−」 = 한 단계 줄인다(최대 → 중간 → 최소), 「+」 = 한 단계 늘린다(최소 → 중간 → 최대).
--  더 줄일 · 늘릴 수 없는 쪽의 단추는 흐리게 남는다(자리가 바뀌지 않게 — 잇달아 누르기 쉽다)
local function sizeButton(panel: Instance, plus: boolean)
	local x = Panel.PAD + Panel.INNER - Panel.FOLD_W - (if plus then 0 else Panel.FOLD_W + Panel.FOLD_BETWEEN)
	local y = math.floor((Panel.HEAD - Panel.FOLD_H) / 2) + 1
	local can = if plus then QuestHud.size < Panel.MAX else QuestHud.size > Panel.MIN
	local btn = Ui.box(panel, x, y, Panel.FOLD_W, Panel.FOLD_H, C.panel2)
	btn.Name = if plus then "FoldPlus" else "FoldMinus"
	local ink = if can then C.text else C.line
	local cx, cy = math.floor(Panel.FOLD_W / 2), math.floor(Panel.FOLD_H / 2)
	Ui.box(btn, cx - 3, cy, 7, 1, ink).Name = if can then "Bar" else "BarOff"
	if plus then
		Ui.box(btn, cx, cy - 3, 1, 7, ink).Name = if can then "Bar" else "BarOff"
	end
	if not can then
		return
	end
	-- 누르는 자리: 위아래로는 넉넉히, 옆으로는 두 단추가 겹치지 않게 사이의 절반까지만
	local side = math.floor(Panel.FOLD_BETWEEN / 2)
	local hit = Ui.group(panel, x - (if plus then side else Panel.FOLD_HIT.x), y - Panel.FOLD_HIT.y, Panel.FOLD_W + side + Panel.FOLD_HIT.x, Panel.FOLD_H + Panel.FOLD_HIT.y * 2, if plus then "PlusHit" else "MinusHit")
	hit.ZIndex = 8
	Ui.hit(hit).Activated:Connect(function()
		QuestHud.size = math.clamp(QuestHud.size + (if plus then 1 else -1), Panel.MIN, Panel.MAX)
		QuestHud.scrollY = 0 -- 크기를 바꾸면 맨 위부터
		if QuestHud.list then
			QuestHud.list.CanvasPosition = Vector2.new(0, 0)
		end
		QuestHud.redraw()
	end)
end

-- book = 내 퀘스트의 상태 · names = 주민 id → 이름 · level = 내 레벨(길잡이를 셈한다 — 안 주면 길잡이를 적지 않는다) · daily = 받아 둔 일일 의뢰들(sim/daily.luau의 tracked)
function QuestHud.set(book, names, level: number?, daily: any?)
	local box = QuestHud.box
	-- 스크롤한 자리를 기억해 둔다(아래에서 다시 그린 뒤 그 자리로)
	if QuestHud.list and QuestHud.list.Parent then
		QuestHud.scrollY = QuestHud.list.CanvasPosition.Y
	end
	QuestHud.list = nil
	for _, child in box:GetChildren() do
		child:Destroy()
	end
	last = { book, names, level, daily }
	QuestHud.glow = nil
	local maxH = Panel.maxH(Stage.uiH, QuestHud.touch)
	local rows, height, shown, guided, info = Panel.layout(book or {}, names, level, maxH, daily, QuestHud.size)
	QuestHud.shown = shown
	QuestHud.guided = guided
	QuestHud.total = info.total
	-- 적을 것이 하나도 없으면(어느 크기에서든) 판도 없다. 최소이거나, 중간인데 부탁만 받아 두었으면 머리줄(「진행 N」 · 단추)만 남는다
	QuestHud.any = info.any
	box.Visible = info.any and not QuestHud.covered
	if not info.any then
		return
	end
	local W, PAD, INNER = Panel.W, Panel.PAD, Panel.INNER
	local panel = Ui.panel(box, 0, 0, W, info.view)
	-- ① 머리줄
	local mark = Kit.part(panel, QuestHud.MARK.new, PAD, 0)
	mark.Position = UDim2.fromOffset(PAD, math.floor((Panel.HEAD - mark.Size.Y.Offset) / 2) + 1)
	local headX = PAD + mark.Size.X.Offset + 5
	Ui.text(panel, "퀘스트", headX, 5, INNER - (headX - PAD), { font = "body", color = C.gold })
	if info.total > 0 then
		Ui.text(panel, ("진행 %d"):format(info.total), PAD, 7, INNER - Panel.FOLD_W * 2 - Panel.FOLD_BETWEEN - Panel.FOLD_GAP, { align = "right", color = C.dim })
	end
	sizeButton(panel, false)
	sizeButton(panel, true)
	if shown + guided == 0 then
		return
	end
	Ui.box(panel, PAD, Panel.HEAD, INNER, 1, C.lineHot).Name = "HeadLine"
	-- ② · ③ 스크롤하는 칸 안에(적은 것이 판보다 길 때만 스크롤한다 — 오른쪽 끝에 가는 막대)
	local top = Panel.LIST_TOP
	local winH, allH = info.view - top - Panel.LIST_BOTTOM, height - top - Panel.LIST_BOTTOM
	local list = Ui.scroll(panel, 0, top, W, winH, allH, Panel.SCROLL_W)
	QuestHud.list = list
	QuestHud.scrollY = math.clamp(QuestHud.scrollY, 0, math.max(0, allH - winH))
	list.CanvasPosition = Vector2.new(0, QuestHud.scrollY)
	for _, row in rows do
		local ry = row.y - top
		if row.kind == "quest" then
			local tint = if row.tag == "main" then C.gold elseif row.tag == "job" then C.accent else C.lineHot
			local chip = Ui.box(list, PAD, ry + 1, Panel.TAG_W, 13, tint)
			chip.Name = "Tag"
			Ui.text(chip, Panel.TAGS[row.tag] or "부탁", 0, 1, Panel.TAG_W, { align = "center", color = if row.tag == "side" then C.text else C.ink })
			local nameX = PAD + Panel.TAG_W + Panel.TAG_GAP
			Ui.text(list, row.name, nameX, ry, if row.key then Panel.NAME_W else INNER - Panel.TAG_W - Panel.TAG_GAP, { font = "body", color = if row.tag == "main" then C.gold elseif row.tag == "job" then C.accent else C.text })
			if row.key then
				naviButton(list, ry, row.key)
			end
		elseif row.kind == "step" then
			Ui.text(list, row.text, PAD + 2, ry, INNER - 2 - Panel.COUNT_W, { color = C.text })
			Ui.text(list, row.count, PAD, ry, INNER, { align = "right", color = C.accent })
			local bar = Ui.bar(list, PAD + 2, ry + LINE - 1, INNER - 2, Panel.BAR_H, C.accent, C.panel2)
			bar:set(row.have / math.max(1, row.n))
		elseif row.kind == "ready" then
			local done = Kit.part(list, QuestHud.MARK.done, PAD + 2, ry)
			done.Position = UDim2.fromOffset(PAD + 2, ry + math.floor((LINE - done.Size.Y.Offset) / 2))
			local tx = PAD + 2 + done.Size.X.Offset + 4
			Ui.text(list, row.text, tx, ry, INNER - (tx - PAD), { color = C.green })
		elseif row.kind == "label" then
			if row.line then
				Ui.box(list, PAD, ry, INNER, 1, C.line).Name = "GuideLine"
			end
			Ui.text(list, "받을 수 있는 퀘스트", PAD, ry + (if row.line then 5 else 1), INNER, { color = C.dim })
		elseif row.kind == "guide" then
			-- 받을 수 있는 전직 퀘스트(job)는 민트(「전직」 표의 색) · 다음 메인(open)은 금빛 · 부탁(side)은 흰색 · 레벨이 모자란 것(level)은 흐리게
			Ui.text(list, row.text, PAD, ry, if row.key then Panel.GUIDE_W else INNER, { font = "body", color = if row.tone == "job" then C.accent elseif row.tone == "open" then C.gold elseif row.tone == "side" then C.text else C.dim })
			if row.key then
				naviButton(list, ry, row.key)
			end
		elseif row.kind == "where" then
			Ui.text(list, row.text, PAD + 2, ry, INNER - 2, { color = if row.tone == "level" then C.dim else C.accent })
		end
	end
end

return QuestHud

end
MODULES['Client/lune/riftView'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 수정 틈 토벌 중의 화면(2026-10-16 — 공방 시험 탭의 P.paintRiftHud · P.paintRiftEnd와 같은 자리 · 모양).
--  화면 위 가운데의 판: 윗줄 = 단계의 이름(금색)과 남은 시간(1분 아래면 빨강) · 아랫줄 = 「물결 2/4 · 남은 몬스터 6」(마지막 물결은 「정예」) · 「곧 몰려온다」 · 「토벌 완료」 · 「시간이 다 됐다」.
--  끝나면 가운데의 판: 「토벌 완료」와 받은 것(경험치 · 달돈 · 달가루 · 장비) — 오늘 보상을 다 받았으면 그 말 / 「시간이 다 됐다」 · 아래 「n초 뒤 광장으로」.
--  무엇이 언제 바뀌는지는 서버가 정한다(sim/rift.luau — RiftView · RiftPay). 여기서는 받은 것을 그리고, 시계만 받은 뒤로 흐르게 한다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Rift = require(lune.sim.rift)
local Layout = require(lune.ui.layout)
local Format = require(lune.ui.format)
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR
local M = Ui.M
local D = Rift.DATA
local W = D.words
local ROWS = 4 -- 끝의 판의 줄(경험치 · 달돈 · 달가루 · 장비)

local RiftView = {}
RiftView.view = nil -- 서버가 마지막으로 알린 상태(Rift.view) — 토벌의 방에 있을 때만
RiftView.since = 0 -- 그것을 받은 뒤로 흐른 시간(초)
RiftView.paid = nil -- 완료의 보상(RiftPay)

function RiftView.init(root: Frame)
	local H = Layout.RIFT_HUD
	local box = Stage.place(root, "Rift", "tc", math.floor((Stage.REF_W - H.w) / 2), H.y, H.w, H.h)
	box.Visible = false
	Ui.panel(box, 0, 0, H.w, H.h)
	RiftView.box = box
	RiftView.name = Ui.text(box, "", 10, 6, H.w - 70, { color = C.gold })
	RiftView.clock = Ui.text(box, "", 10, 6, H.w - 20, { align = "right" })
	RiftView.what = Ui.text(box, "", 10, 21, H.w - 20)
	-- 끝의 판(완료 · 실패)
	local E = Layout.RIFT_END
	local eh = E.pad * 2 + M.body + 8 + ROWS * E.row + M.small + 6
	local eb = Stage.place(root, "RiftEnd", "tc", math.floor((Stage.REF_W - E.w) / 2), math.floor((Stage.REF_H - eh) / 2) - 20, E.w, eh)
	eb.Visible = false
	RiftView.endBox, RiftView.endH = eb, eh
	RiftView.endPanel = Ui.panel(eb, 0, 0, E.w, eh)
	RiftView.title = Ui.text(eb, "", 0, E.pad, E.w, { font = "body", align = "center" })
	RiftView.rows = {}
	for i = 1, ROWS do
		local ry = E.pad + M.body + 8 + (i - 1) * E.row
		local icon = Ui.smallIcon(eb, "coin", E.pad - 3, ry - 4)
		icon.Visible = false
		RiftView.rows[i] = { icon = icon, text = Ui.text(eb, "", E.pad, ry, E.w - E.pad * 2, { color = C.gold }), y = ry }
	end
	RiftView.back = Ui.text(eb, "", 0, eh - E.pad - M.small + 2, E.w, { align = "center", color = C.dim })
end

-- 토벌의 방에 들어섰다 · 나왔다(view = 방의 rift — 없으면 숨긴다)
function RiftView.enter(view: any)
	RiftView.view, RiftView.since, RiftView.paid = view, 0, nil
	RiftView.box.Visible = view ~= nil
	RiftView.endBox.Visible = false
	RiftView.draw()
end
-- 서버가 상태를 알렸다
function RiftView.set(view: any)
	if not RiftView.view then
		return
	end
	RiftView.view, RiftView.since = view, 0
	RiftView.draw()
end
-- 완료의 보상이 왔다
function RiftView.pay(p: any)
	RiftView.paid = p
	RiftView.draw()
end

local function row(i: number, icon: string?, text: string, color: Color3?)
	local r = RiftView.rows[i]
	r.icon.Visible = icon ~= nil
	if icon then
		Ui.setWorldIcon(r.icon, icon)
	end
	r.text:move(Layout.RIFT_END.pad + (if icon then 16 else 0), r.y)
	r.text:set(text)
	r.text:color(color or C.gold)
end

-- 그린다(받았을 때 · 1초마다 — 시계와 「n초 뒤」)
function RiftView.draw()
	local v = RiftView.view
	if not v then
		return
	end
	local t = Rift.tier(v.tier)
	local run = v.state == "run"
	local rest = math.max(0, v.time - (v.t + (if run then RiftView.since else 0)))
	RiftView.name:set(if t then t.name else "")
	RiftView.clock:set(("%d:%02d"):format(math.floor(rest / 60), math.floor(rest % 60)))
	RiftView.clock:color(if rest < 60 then C.red else C.text)
	local what
	if v.state == "wait" then
		what = W.ready
	elseif v.state == "clear" then
		what = W.clear
	elseif v.state == "fail" then
		what = W.fail
	else
		what = (if v.wave >= v.waves then W.eliteWave else Format.fill(W.wave, { a = v.wave, b = v.waves })) .. " · " .. Format.fill(W.mobs, { n = v.left })
	end
	RiftView.what:set(what)
	RiftView.what:color(if v.state == "clear" then C.green elseif v.state == "fail" then C.red else C.text)
	-- 끝의 판
	local over = v.state == "clear" or v.state == "fail"
	RiftView.endBox.Visible = over
	if not over then
		return
	end
	RiftView.title:set(if v.state == "clear" then W.clear else W.fail)
	RiftView.title:color(if v.state == "clear" then C.green else C.red)
	for i = 1, ROWS do
		row(i, nil, "")
	end
	local p = RiftView.paid
	if v.state == "clear" and p then
		if p.none then
			row(1, nil, W.noPay, C.dim)
		else
			row(1, nil, ("경험치 %s"):format(Format.short(p.xp)))
			row(2, "coin", Format.short(p.money))
			row(3, "dust", Format.short(p.dust))
			if p.gear then
				row(4, nil, p.gearName or "")
			else
				row(4, nil, if p.full then W.full else W.nogear, C.dim)
			end
		end
	end
	local wait = (if v.state == "clear" then D.back else Rift.FAIL_BACK) - (v.after + RiftView.since)
	RiftView.back:set(Format.fill(W.back, { n = math.max(0, math.ceil(wait)) }))
end

-- 매 장면(boot의 LuneFrame): 받은 뒤로 흐른 시간 — 초가 바뀔 때만 다시 그린다
function RiftView.update(dt: number)
	if not RiftView.view then
		return
	end
	local before = math.floor(RiftView.since)
	RiftView.since += dt
	if math.floor(RiftView.since) ~= before then
		RiftView.draw()
	end
end

return RiftView

end
MODULES['Client/lune/sceneView'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 장면 한 개를 그린다 — 하늘색, 멀리서 덜 따라오는 배경 층, 뒤에 놓인 것, 바닥, 주민, (졸개 · 주인공 자리).
--  맵에 놓는 물건은 모두 캐릭터 뒤다(앞에 놓는 것은 캐릭터를 가린다 — 사용자 2026-10-08. 장면 자료의 front는 늘 비어 있다).
--  장면의 갈래: 보통 맵(땅의 윗면이 늘 화면의 같은 높이) · tall(층이 있는 마을 — 카메라가 선 층을 따라 위아래로도 움직인다) · indoor(건물의 실내 — 한 화면, 방 그림 한 장).
--  자료는 shared/lune/data/scenes.generated.luau(공방에서 내보낸 그대로). 좌표는 도트. 놓인 것과 주민은 발밑 가운데가 (x, y)다.
--  이름표는 메이플처럼 발밑에 단다(주민 · 사람 · 몬스터). 그 자리를 내려고 땅의 윗면이 화면의 Kit.GROUND(150) 높이에 오게 장면을 올려 그린다.
--  이름표 · 문 위의 글은 글씨의 층(화면 틀의 고운 격자 — overlay.luau)에 그리고, 화면마다 제 자리(게임 세계의 도트)를 따라가게 한다. 머리 위의 퀘스트 표시(! · ?)는 게임 세계의 그림이다.
--  이름표 · 문 위의 글은 글씨의 층(화면 틀의 고운 격자 — overlay.luau)에 그리고, 화면마다 제 자리(게임 세계의 도트)를 따라가게 한다. 머리 위의 퀘스트 표시(! · ?)는 게임 세계의 그림이다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local G = require(lune.config.game)
local ASSETS = require(lune.data["assets.generated"])
local UI = require(lune.data["ui.generated"])
local SCENES = require(lune.data["scenes.generated"])
local PORTAL = require(lune.data["portal.generated"])
local Stage = require(script.Parent.stage)
local Canvas = require(script.Parent.canvas)
local Kit = require(script.Parent.ui.kit)
local Ui = require(script.Parent.ui.ui)
local Overlay = require(script.Parent.overlay)

local C = Ui.COLOR

local SceneView = {}
SceneView.__index = SceneView
SceneView.TAG_DOWN = 4 -- 이름표: 발밑에서 이만큼 아래(화면 틀의 점)
-- 주민 머리 위의 퀘스트 표시: "!" 받을 수 있는 퀘스트가 있다 · "?" 다 해서 돌려줄 퀘스트가 있다 — 글자 그대로의 작은 표시(게임 세계의 굵은 도트).
--  사용자 2026-10-07: "퀘스트가 있는건 표시가 받을수있는퀘스트는 ! , 완료된퀘스트는 ? 표시였는데 왜 갑자기 전구모양이 생긴건지" → 전구 · 책 그림을 걷어 내고 되돌렸다.
--  부품 이름과 띄우는 높이는 공방에서 온다(data/ui.generated.luau의 questMark — 공방 시험 탭에서 먼저 보고 정한 것. "크기 너무 큽니다" → 피해 숫자만 한 점 글자).
SceneView.MARK = { ["!"] = UI.questMark.new, ["?"] = UI.questMark.done }
SceneView.MARK_UP = UI.questMark.up
SceneView.DOOR_MARK_UP = 9 -- 문 위의 퀘스트 표시: 문의 이름표(글씨 한 줄) 위로 이만큼(게임의 도트)

local function round(v: number): number
	return math.floor(v + 0.5)
end

local function hexColor(hex: string): Color3
	return Color3.fromRGB(tonumber(hex:sub(2, 3), 16), tonumber(hex:sub(4, 5), 16), tonumber(hex:sub(6, 7), 16))
end

-- view = 게임 세계의 층 · tagLayer = 이름표의 층(화면 틀 — overlay)
function SceneView.new(view: Frame, key: string, scene, tagLayer: Frame)
	local self = setmetatable({}, SceneView)
	self.key = key
	self.scene = scene
	self.width = scene.w * G.TILE
	self.height = scene.h * G.TILE
	view.BackgroundColor3 = hexColor(scene.sky)

	local root = Stage.group(view, "Scene_" .. key, 1)
	self.root = root

	-- 배경 층: 그림을 가로로 이어 붙여 화면을 채운다(멀수록 덜 따라온다)
	self.layers = {}
	for i, l in scene.layers do
		local holder = Stage.group(root, "Layer" .. i, i)
		local copies = math.ceil(G.VIEW_W / l.w) + 1
		local labels = {}
		for c = 1, copies do
			labels[c] = Stage.image(holder, "Tile" .. c, ASSETS[l.img] or "", l.w, l.h)
		end
		self.layers[i] = { def = l, labels = labels }
	end

	-- 맵 틀: 카메라만큼 통째로 민다
	local world = Stage.group(root, "World", 10)
	world.Size = UDim2.fromOffset(self.width, self.height)
	self.world = world
	local back = Stage.group(world, "Back", 10)
	local ground = Stage.group(world, "Ground", 20)
	self.portalLayer = Stage.group(world, "Portals", 22) -- 포탈의 그림(땅 위 · 주민과 캐릭터 뒤)
	self.npcLayer = Stage.group(world, "Npcs", 30)
	self.graveLayer = Stage.group(world, "Graves", 35) -- 쓰러진 사람의 비석(졸개 · 캐릭터보다 뒤 — 놓인 것이 캐릭터를 가리지 않는다)
	self.mobLayer = Stage.group(world, "Mobs", 40)
	self.heroLayer = Stage.group(world, "Heroes", 50)
	self.fxLayer = Stage.group(world, "Fx", 55)
	-- 이펙트의 점 그림판(client/lune/canvas.luau): 뒤의 것은 땅과 주민 사이 · 앞의 것은 캐릭터 위 — 시험 탭이 그리는 차례와 같다
	self.fxBack, self.fxFront = Canvas.attach(world, 25, 56)
	self.shakeX, self.shakeY = 0, 0 -- 화면 흔들림(cast.luau가 장마다 넣는다)
	local front = Stage.group(world, "Front", 60)
	self.topLayer = Stage.group(world, "Top", 70) -- 이름표 · 피해 숫자처럼 모든 것 위에 뜨는 것

	local function put(holder: Frame, list)
		local sheet = ASSETS[scene.props] or ""
		for i, p in list do
			local r = scene.rects[p.id]
			if r then
				local label = Stage.image(holder, p.id .. i, sheet, r.w, r.h)
				label.ImageRectOffset = Vector2.new(r.x, r.y)
				label.ImageRectSize = Vector2.new(r.w, r.h)
				label.Position = UDim2.fromOffset(round(p.x - r.w / 2), p.y - r.h)
			end
		end
	end
	put(back, scene.back)
	put(front, scene.front)
	-- 사다리(2026-10-16 밤 — scene.ladders: x · top · bottom 도트): 16점 한 칸을 세로로 쌓는다(땅 앞 · 문 · 주민 · 캐릭터 뒤). 꼭대기는 발판 위로 반 칸 솟는다
	local ladderLayer = Stage.group(world, "Ladders", 21)
	for i, l in scene.ladders or {} do
		local top = l.top - 8
		for k = 0, math.ceil((l.bottom - top) / 16) - 1 do
			local h = math.min(16, l.bottom - top - k * 16)
			local piece = Stage.image(ladderLayer, ("Ladder%d_%d"):format(i, k), ASSETS[scene.ladderImg] or "", 16, h)
			piece.ImageRectSize = Vector2.new(16, h)
			piece.Position = UDim2.fromOffset(round(l.x - 8), top + k * 16)
		end
	end

	for i, g in scene.ground do
		local label = Stage.image(ground, "Ground" .. i, ASSETS[g.img] or "", g.w, g.h)
		label.Position = UDim2.fromOffset(g.x, 0)
	end
	-- 장면을 올려 그려서 화면 아래에 남는 데는 땅속 색으로 메운다
	local deep = Kit.box(ground, 0, self.height, self.width, G.VIEW_H, hexColor(scene.deep or scene.sky))
	deep.Name = "Deep"

	-- 주민: 그림판의 가로 칸 = 누구, 세로 칸 = 서 있는 동작 두 장
	self.npcs = {}
	if scene.npcs then
		local nw, nh = scene.npcCell[1], scene.npcCell[2]
		for i, n in scene.npcs do
			local label = Stage.image(self.npcLayer, n.id, ASSETS[scene.npcSheet] or "", nw, nh)
			label.Position = UDim2.fromOffset(round(n.x - nw / 2), n.y - nh)
			label.Visible = not n.stone -- 비석(명예의 전당): 방 그림에 그려져 있다 — 이름표와 말만 있다
			self.npcs[i] = { def = n, label = label, nw = nw, nh = nh, shown = "" }
		end
	end

	-- 이름표: 주민의 발밑에 구실과 이름(노랑), 문 위에 어디로 가는지(민트). 자리는 update가 화면마다 잡는다
	self.tags = {} -- { label, wx, wy(게임 세계의 자리), dy(거기서 화면 틀의 점으로 얼마나 아래), portal(문의 이름표면 그 문) }
	self.tagOut = {} -- tagList가 돌려주는 표(장마다 다시 채운다)
	self.tagRects = {} -- 주민 · 문의 이름표들의 자리 { x, y, w }(화면 틀의 점)
	local function tag(text: string, wx: number, wy: number, dy: number, color: Color3, portal: any?)
		local label = Ui.tag(tagLayer, text, color, 260)
		table.insert(self.tags, { label = label, wx = wx, wy = wy, dy = dy, portal = portal })
		return label
	end
	for _, npc in self.npcs do
		local n = npc.def
		npc.tag = tag(("%s %s"):format(n.role, n.name), n.x, n.y, SceneView.TAG_DOWN, C.gold)
		-- 퀘스트 표시: 머리 위의 ! (받을 수 있다) · ? (돌려줄 수 있다) — 게임 세계의 그림(굵은 도트)
		npc.mark = Kit.part(self.topLayer, SceneView.MARK["!"], 0, 0) -- 자리는 update가 잡는다(! 와 ? 의 폭이 다르다)
		npc.mark.Visible = false
		npc.mark.Name = "Mark_" .. n.id
		npc.mark.ZIndex = 6
	end
	-- 문 위의 퀘스트 표시: 그 문 안(건물의 실내)에 있는 주민에게 받을 · 돌려줄 퀘스트가 있으면 문 위에 ! · ? 를 띄운다 — 주민이 건물 안에 있어 밖에서는 머리 위의 표시가 보이지 않는다
	--  포탈: 모든 문 · 건물 입구에 같은 그림(빛의 타원 안에서 소용돌이가 돈다)이 놓인다 — 글씨가 아니라 이 그림이 포탈임을 알려 준다(사용자 2026-10-10).
	--   어디로 가는지의 글(↑ 마을 어귀로)은 그 앞에 섰을 때만 보인다(tagList)
	self.doorMarks = {}
	self.portals = {}
	for i, p in scene.portals do
		local glow = Stage.image(self.portalLayer, "Portal_" .. tostring(p.id or p.to), ASSETS[PORTAL.img] or "", PORTAL.w, PORTAL.h) -- 이름표(id)가 없는 문도 있다(새로 지은 맵의 문 — 가는 곳으로 부른다)
		glow.ImageRectSize = Vector2.new(PORTAL.w, PORTAL.h)
		glow.Position = UDim2.fromOffset(round(p.x - PORTAL.w / 2), p.y - PORTAL.h)
		self.portals[i] = { label = glow, phase = i * 0.37, frame = -1, def = p, open = true } -- open = 지나갈 수 있는가(그 퀘스트를 받아야 열리는 문 — setPortals)
		tag("↑ " .. p.label, p.x, p.y - math.max(p.h or 60, PORTAL.h), -(Ui.TAG_H + 2), C.accent, p)
		local dest = SCENES.scenes[p.to]
		if dest and dest.indoor and dest.npcs then
			local ids = {}
			for _, n in dest.npcs do
				table.insert(ids, n.id)
			end
			local mark = Kit.part(self.topLayer, SceneView.MARK["!"], 0, 0)
			mark.Visible = false
			mark.Name = "DoorMark_" .. p.to
			mark.ZIndex = 6
			table.insert(self.doorMarks, { portal = p, ids = ids, mark = mark })
		end
	end

	-- 간이 포탈(2026-10-15 — 사용자: "사냥터 안에서 끝에서 끝으로 이동하는 간이 포탈 거의 투명하게"): 문과 같은 그림을 거의 투명하게 · 앞에 서면 「↑ 오른쪽 끝으로」.
	--  다른 맵으로 가는 문(scene.portals)과 따로다(scene.warps — 공방 maps.js의 warpsFor). 그림은 문과 함께 돌린다(self.portals에 warp = true로 넣는다)
	for i, w in scene.warps or {} do
		local glow = Stage.image(self.portalLayer, "Warp_" .. w.id, ASSETS[PORTAL.img] or "", PORTAL.w, PORTAL.h)
		glow.ImageRectSize = Vector2.new(PORTAL.w, PORTAL.h)
		glow.ImageTransparency = 1 - (scene.warpAlpha or 0.28)
		glow.Position = UDim2.fromOffset(round(w.x - PORTAL.w / 2), w.y - PORTAL.h)
		table.insert(self.portals, { label = glow, phase = i * 0.5, frame = -1, def = w, open = true, warp = true })
		tag("↑ " .. w.label, w.x, w.y - PORTAL.h, -(Ui.TAG_H + 2), C.accent, w)
	end

	self.camX, self.camY = 0, 0
	self.camYf = nil -- 세로 카메라(소수까지) — 첫 update에서 주인공 자리로 잡는다
	self.lastClock = nil
	return self
end

-- 주인공 자리로 카메라를 맞추고(맵 끝에서 멈춘다), 배경 층과 주민을 고친다.
--  보통 맵: 세로는 따라가지 않는다 — 땅의 윗면이 늘 화면의 같은 높이(Kit.GROUND)에 온다. 뛸 때마다 화면이 출렁이지 않는다.
--  층이 있는 맵(scene.tall): 선 층의 발밑이 화면의 Kit.GROUND에 오게 부드럽게 따라간다 — 땅을 딛고 있을 때의 높이만 따르고(뛸 때마다 출렁이지 않게),
--   화면 밖으로 나가려 하면 바로 따라간다. 공방 시험 탭(luneTab.js의 followCam)과 같은 식이다.
-- camOverride = 장면(퀘스트 연출 — cineView.luau)이 카메라를 옮겨 둔 가로 자리(없으면 캐릭터) · npcOver = 장면이 옮긴 주민 { [id] = { x, dir, hidden, walk } }
function SceneView:update(heroX: number, heroY: number, clock: number, grounded: boolean?)
	local cx = round(math.clamp((self.camOverride or heroX) - G.VIEW_W / 2, 0, math.max(0, self.width - G.VIEW_W)))
	local cy = G.GROUND_Y - Kit.GROUND
	if self.scene.tall then
		local top = math.max(0, self.height - Kit.GROUND - (G.GROUND_Y - Kit.GROUND)) -- 카메라가 내려갈 수 있는 끝
		local dt = if self.lastClock then math.clamp(clock - self.lastClock, 0, 0.1) else 0
		self.lastClock = clock
		if not self.camYf then
			self.camYf = math.clamp(heroY - Kit.GROUND, 0, top)
		end
		local want = self.camYf
		if grounded then
			want = heroY - Kit.GROUND
		elseif heroY - self.camYf > G.VIEW_H - 36 then
			want = heroY - (G.VIEW_H - 36)
		elseif heroY - self.camYf < 48 then
			want = heroY - 48
		end
		want = math.clamp(want, 0, top)
		self.camYf += (want - self.camYf) * math.min(1, dt * (if grounded then 7 else 14))
		cy = round(self.camYf)
	end
	self.camX, self.camY = cx, cy
	self.heroX, self.heroY = heroX, heroY
	-- 포탈의 그림을 돌린다
	for _, pt in self.portals do
		local frame = math.floor((clock + pt.phase) * PORTAL.fps) % PORTAL.frames
		if frame ~= pt.frame then
			pt.frame = frame
			pt.label.ImageRectOffset = Vector2.new(frame * PORTAL.w, 0)
		end
	end
	self.world.Position = UDim2.fromOffset(-cx + self.shakeX, -cy + self.shakeY)
	Overlay.setCamera(cx, cy)
	for i, t in self.tags do
		local left, top = Overlay.x(t.wx) - math.floor(t.label.Width / 2), Overlay.y(t.wy) + t.dy
		t.label.Frame.Position = UDim2.fromOffset(left, top)
		local r = self.tagRects[i]
		if not r then
			r = {}
			self.tagRects[i] = r
		end
		r.x, r.y, r.w = left, top, t.label.Width
	end

	for _, layer in self.layers do
		local l = layer.def
		-- f 2 = 맵과 똑같이 움직이는 벽(망루 · 종탑의 안 — 세로로 쌓인 벽 / 회랑 — 가로로 이어 붙는 벽): 카메라와 1:1로 민다
		local lock = l.f >= 2
		local ox = if lock then -(cx % l.w) else -(round(cx * l.f) % l.w)
		if l.d then
			ox = -((round(cx * l.f) - math.floor(clock * l.d)) % l.w) -- 흘러가는 겹(배의 갑판 뒤의 바다 — d = 1초에 미는 점, 음수면 왼쪽으로 · 2026-10-16)
		end
		-- 층이 있는 맵 · 실내는 공방 시험 탭의 식 그대로(멀수록 세로로도 덜 따라온다 — 실내의 방 그림은 f = 0이라 화면에 붙어 있다)
		local oy = if lock then l.y - cy elseif self.scene.tall or self.scene.indoor then round(l.y - cy * l.f * 0.5) else l.y - cy
		for c, label in layer.labels do
			label.Position = UDim2.fromOffset(ox + (c - 1) * l.w, oy)
		end
	end

	-- 주민: 가까이 오면 주인공 쪽을 본다(그림은 오른쪽을 본다)
	for i, npc in self.npcs do
		local n = npc.def
		local o = self.npcOver and self.npcOver[n.id]
		local dir = n.dir
		if o and o.dir then
			dir = o.dir
		elseif math.abs(n.x - heroX) < 70 and heroX ~= n.x then
			dir = if heroX > n.x then 1 else -1
		end
		-- 장면이 옮긴 주민: 그 자리에(걷는 동안은 두 장을 빨리 돌린다) · 숨긴 주민은 보이지 않는다. 장면이 끝나면 제자리로
		local nx = if o and o.x then o.x else n.x
		if npc.atX ~= nx then
			npc.atX = nx
			npc.label.Position = UDim2.fromOffset(round(nx - npc.nw / 2), n.y - npc.nh)
		end
		npc.label.Visible = not n.stone and not (o and o.hidden)
		local frame = math.floor(clock * (if o and o.walk then 8 else 1.6) + (i - 1) * 0.4) % 2
		local key = dir .. ":" .. frame
		if npc.shown ~= key then
			npc.shown = key
			local cols = self.scene.npcCols or 999 -- 그림판을 cols칸마다 접었다(2026-10-16) — 줄마다 서 있는 동작 2장
			local x, y = (n.cell % cols) * npc.nw, (n.cell // cols * 2 + frame) * npc.nh
			if dir >= 0 then
				npc.label.ImageRectOffset = Vector2.new(x, y)
				npc.label.ImageRectSize = Vector2.new(npc.nw, npc.nh)
			else
				npc.label.ImageRectOffset = Vector2.new(x + npc.nw, y)
				npc.label.ImageRectSize = Vector2.new(-npc.nw, npc.nh)
			end
		end
		-- 퀘스트 표시는 천천히 위아래로 떠 있다
		if npc.mark.Visible then
			local mw, mh = npc.mark.Size.X.Offset, npc.mark.Size.Y.Offset
			npc.mark.Position = UDim2.fromOffset(round(n.x - mw / 2), n.y - n.h - mh - SceneView.MARK_UP + (if math.floor(clock * 2 + i) % 2 == 0 then 0 else 1))
		end
	end
	-- 문 위의 퀘스트 표시: 문의 이름표 바로 위에서 같은 식으로 떠 있다
	for i, d in self.doorMarks do
		if d.mark.Visible then
			local p = d.portal
			local mw, mh = d.mark.Size.X.Offset, d.mark.Size.Y.Offset
			d.mark.Position = UDim2.fromOffset(round(p.x - mw / 2), p.y - (p.h or 60) - mh - SceneView.DOOR_MARK_UP + (if math.floor(clock * 2 + i) % 2 == 0 then 0 else 1))
		end
	end
end

-- 주민 · 문의 이름표들: { x(왼쪽), y(위), w, frame }(화면 틀의 점) — 자리는 update가 이미 잡았다. 겹칠 때 보일지는 boot가 정한다
--  문의 이름표(어디로 가는지)는 캐릭터가 그 문 앞에 섰을 때만 넣는다 — 멀리 있는 문의 글은 숨긴다
function SceneView:tagList()
	local out = self.tagOut
	table.clear(out)
	local hx, hy = self.heroX or 0, self.heroY or 0
	for i, r in self.tagRects do
		local t = self.tags[i]
		r.frame = t.label.Frame
		local p = t.portal
		if p and (not self:portalOpen(p) or math.abs(p.x - hx) > PORTAL.near.x or math.abs(p.y - hy) > PORTAL.near.y) then
			r.frame.Visible = false
		else
			table.insert(out, r)
		end
	end
	return out
end

-- 그 퀘스트를 받아야 열리는 문(문의 need — 달의 사당 안의 「사당 지하」)을 열고 닫는다. openOf(문) → 지나갈 수 있는가.
--  닫힌 문은 포탈의 그림도 「↑ 어디로」도 없고, 앞에서 ↑를 눌러도 지나가지 못한다(서버도 같은 것을 본다 — world.luau의 onTravel)
function SceneView:setPortals(openOf: (any) -> boolean)
	for _, pt in self.portals do
		pt.open = pt.warp == true or openOf(pt.def) == true -- 간이 포탈은 늘 열려 있다
		pt.label.Visible = pt.open
	end
end
function SceneView:portalOpen(p: any): boolean
	for _, pt in self.portals do
		if pt.def == p then
			return pt.open
		end
	end
	return true
end

-- 주민 머리 위의 퀘스트 표시를 고친다. markOf(주민 id) → "!" · "?" · nil
function SceneView:setMarks(markOf: (string) -> string?)
	for _, npc in self.npcs do
		local mark = markOf(npc.def.id)
		npc.markText = mark
		Kit.setPart(npc.mark, if mark then SceneView.MARK[mark] else nil)
		if npc.def.id == self.talking then
			npc.mark.Visible = false
		end
	end
	-- 문 위: 그 안의 주민들 가운데 돌려줄 것("?")이 있으면 그것을, 아니면 받을 것("!")을 보인다
	for _, d in self.doorMarks do
		local best: string? = nil
		for _, id in d.ids do
			local mark = markOf(id)
			if mark == "?" or (mark == "!" and best == nil) then
				best = mark
			end
		end
		Kit.setPart(d.mark, if best then SceneView.MARK[best] else nil)
	end
end

-- 말풍선이 떠 있는 주민의 표시는 그동안 숨긴다(말풍선이 그 자리에 뜬다). npcId = nil이면 다시 보인다
function SceneView:setTalking(npcId: string?)
	self.talking = npcId
	for _, npc in self.npcs do
		Kit.setPart(npc.mark, if npc.markText and npc.def.id ~= npcId then SceneView.MARK[npc.markText] else nil)
	end
end

-- 주인공 가까이에 있는 주민(없으면 nil)
function SceneView:npcNear(x: number, y: number)
	local best, bestD = nil, 30
	for _, npc in self.npcs do
		local d = math.abs(npc.def.x - x)
		if d < bestD and math.abs(npc.def.y - y) < 24 and not npc.def.stone then -- 명예의 전당의 비석은 말을 걸지 않는다(순위는 비석에 새겨져 있다 — hallStones.luau)
			best, bestD = npc.def, d
		end
	end
	return best
end

-- 주인공 가까이에 있는 문(없으면 nil)
function SceneView:portalNear(x: number, y: number)
	for _, p in self.scene.portals do
		-- 문 가운데에서 26도트 안(서버는 28까지 받는다). 맵 끝의 문은 벽에 붙어 서서도 들어갈 수 있어야 한다 — 16으로 두었더니 벽까지 달려간 뒤에는 들어가지 못했다
		if math.abs(p.x - x) < 26 and math.abs(p.y - y) < 4 and self:portalOpen(p) then
			return p
		end
	end
	return nil
end

-- 주인공 가까이에 있는 간이 포탈(없으면 nil) — 앞에서 ↑를 누르면 같은 맵의 짝으로(boot.luau → 서버 Hop)
function SceneView:warpNear(x: number, y: number)
	for _, w in self.scene.warps or {} do
		if math.abs(w.x - x) < 16 and math.abs(w.y - y) < 24 then
			return w
		end
	end
	return nil
end

function SceneView:destroy()
	Canvas.detach() -- 그림판은 다음 장면이 다시 쓴다(맵 틀과 같이 없애지 않는다)
	self.root:Destroy()
	for _, t in self.tags do
		t.label:Destroy()
	end
end

return SceneView

end
MODULES['Client/lune/sprite'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 캐릭터 · 졸개 한 몸의 그림. 동작(clip)과 장 번호를 주면 캐릭터 판에서 그 장을 잘라 발밑 가운데 (x, y)에 맞춰 놓는다.
--  판의 그림은 오른쪽을 본다. 왼쪽을 볼 때는 자르는 폭을 음수로 줘서 뒤집는다(그림을 따로 두지 않는다).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local data = ReplicatedStorage.shared.lune.data
local CHARS = require(data["chars.generated"])
local ASSETS = require(data["assets.generated"])
local Stage = require(script.Parent.stage)

local Sprite = {}
Sprite.__index = Sprite
-- 고운 그림의 미리보기 배율(관리 창 「전투 → 보스 크기」): 동작에 k가 적힌 그림(스토리 보스)을 이 배만큼 더 크게 · 작게 그려 본다. 그림만 바뀐다(맞는 자리 · 몸의 판정은 설계값 그대로)
Sprite.preview = 1

-- mask = true면 같은 자리의 흰 실루엣 판(CHARS.masks)으로 그린다 — label.ImageColor3로 색을 입혀 한 색 실루엣을 만든다(대쉬의 잔상)
function Sprite.new(parent: Instance, who: string, z: number?, mask: boolean?)
	local char = CHARS.chars[who]
	assert(char, "없는 캐릭터 " .. tostring(who))
	local self = setmetatable({}, Sprite)
	self.who = who
	self.char = char
	self.pages = if mask then CHARS.masks else CHARS.pages
	self.label = Stage.image(parent, who, "", 1, 1)
	self.label.ZIndex = z or 1
	self.label.Visible = false
	self.page = 0
	return self
end

-- 동작의 장 번호(1부터). once = 한 번만 틀고 마지막 장에서 멈춘다
function Sprite.frameAt(char, clip: string, t: number, once: boolean?): number
	local c = char.clips[clip]
	local n = #c.frames
	local i = math.floor(t * c.fps)
	return (if once then math.min(n - 1, i) else i % n) + 1
end

-- scale = 몸의 크기(거신의 두 배 — 발밑 가운데를 그대로 두고 커진다. 없으면 1)
function Sprite:set(clip: string, frame: number, x: number, y: number, dir: number, scale: number?)
	local char = self.char
	local c = char.clips[clip]
	local f = c and c.frames[frame]
	local label = self.label
	if not f then
		label.Visible = false -- 빈 장
		self.lastF = nil
		return
	end
	if self.page ~= f[1] then
		self.page = f[1]
		label.Image = ASSETS[self.pages[f[1]]] or ""
	end
	local w, h, dx, dy = f[4], f[5], f[6], f[7]
	local px, py = math.floor(x + 0.5), math.floor(y + 0.5)
	-- 기준점: 캐릭터 동작은 발밑 가운데(ox, oy). 칸 크기가 따로인 동작(날아가는 그림)은 왼쪽 가운데다
	-- 제 기준점이 적힌 동작(몬스터의 마법 그림 = 발밑 가운데 · 날아가는 그림 = 한가운데)은 그것을 쓴다
	local ox, oy = char.ox, char.oy
	if c.ox then
		ox, oy = c.ox, c.oy
	elseif c.fw then
		ox, oy = 0, c.fh / 2
	end
	-- 고운 그림(c.k — 스토리 보스: 사용자가 만든 동작 그림을 받은 화소 그대로 싣고 작게 그린다. k = 그림 한 화소가 세계의 몇 점인가):
	--  부드럽게 줄여 그리고(도트 그림은 점이 또렷하게 — Pixelated) 자리와 크기를 점의 소수 자리까지 둔다. 사용자 2026-10-11: "게임에서 표현되어지는 크기를 줄이라는거에요 스프라이트를 건드리라는게아니라"
	local fine = c.k ~= nil
	local s = (scale or 1) * (if fine then c.k * Sprite.preview else 1)
	if self.fine ~= fine then
		self.fine = fine
		label.ResampleMode = if fine then Enum.ResamplerMode.Default else Enum.ResamplerMode.Pixelated
	end
	-- 지난번과 같은 장 · 같은 자리 · 같은 쪽 · 같은 크기면 다시 쓰지 않는다(폰에서 매 장면 몬스터 · 사람마다 다섯 값을 새로 쓰던 것 — 2026-10-18 검토).
	--  보이기만은 늘 맞춘다(부르는 쪽이 잠깐 숨겼다가 다시 그릴 때)
	local flip = dir >= 0
	if self.lastF == f and self.lastX == px and self.lastY == py and self.lastFlip == flip and self.lastS == s and self.lastOx == ox and self.lastOy == oy then
		if not label.Visible then
			label.Visible = true
		end
		return
	end
	self.lastF, self.lastX, self.lastY, self.lastFlip, self.lastS, self.lastOx, self.lastOy = f, px, py, flip, s, ox, oy
	local function R(v: number): number
		return if fine then v else math.floor(v + 0.5)
	end
	label.Size = UDim2.fromOffset(R(w * s), R(h * s))
	if dir >= 0 then
		label.ImageRectOffset = Vector2.new(f[2], f[3])
		label.ImageRectSize = Vector2.new(w, h)
		label.Position = UDim2.fromOffset(px - R((ox - dx) * s), py - R((oy - dy) * s))
	else
		label.ImageRectOffset = Vector2.new(f[2] + w, f[3])
		label.ImageRectSize = Vector2.new(-w, h)
		label.Position = UDim2.fromOffset(px + R((ox - dx - w) * s), py - R((oy - dy) * s))
	end
	label.Visible = true
end

function Sprite:destroy()
	self.label:Destroy()
end

return Sprite

end
MODULES['Client/lune/stage'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 게임 화면의 틀. 층이 둘이다(사용자 2026-10-07: 산나비 계열 도트 게임의 방식 — "훌룡합니다. 하지만 글씨비율은 좀더 작아야합니다"):
--   view = 게임 세계. 384x216도트를 화면에 들어가는 가장 큰 정수 배율로 키워 가운데에 놓는다(도트가 뭉개지지 않게).
--   ui   = 화면의 글씨와 틀. 게임의 도트보다 고운 격자에 따로 그린다 — 1080p에서 960x540(한 점이 화면 2픽셀. 게임의 도트는 5픽셀).
--          격자의 크기는 창 크기에 따라 768x432부터 1152x648까지 달라진다. 그래서 그 안의 것은 화면의 구석(위 · 아래 / 왼쪽 · 가운데 · 오른쪽)에 붙여 놓는다.
--  배율은 층마다 UIScale 하나로 건다 — 그 아래의 모든 것은 그 층의 좌표(1 = 한 점)를 그대로 쓴다.
--  작은 화면(스마트폰): 게임 세계를 정수 배율로만 키우면 화면 높이가 432보다 낮은 폰에서는 1배(384x216)가 되고, 화면 틀의 격자도 384x216이 되어
--   960x540을 기준으로 짠 화면의 칸들이 서로 겹쳐 화면을 다 덮는다(사용자 2026-10-08: "모바일에서 거의 플레이가 불가능한 수준 … ui가 전면을 다가리는").
--   그래서 2배가 안 되는 화면에서는 정수 배율을 버리고 화면에 꽉 차게 키운다 — 화면 틀의 격자는 가장 작은 격자(768x432) 그대로다(화면 틀의 한 점 = 게임 도트의 반).
--  Studio에서 스마트폰 화면을 흉내 내려면 화면 틀(LuneStage)의 속성 Screen = "844x390"처럼 준다(그 크기의 화면인 것처럼 가운데에 그린다). 손가락 단추는 속성 Touch = true.
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local G = require(ReplicatedStorage.shared.lune.config.game)
local UI = require(ReplicatedStorage.shared.lune.data["ui.generated"])

local Stage = {}
Stage.scale = 1 -- 게임 세계의 배율(화면 픽셀 / 게임 도트)
Stage.uiScale = 1 -- 화면 틀의 배율(화면 픽셀 / 화면 틀의 한 점)
Stage.ratio = 1 -- 게임 도트 하나가 화면 틀의 몇 점인가(1080p에서 2.5)
Stage.uiW, Stage.uiH = UI.grid.w, UI.grid.h -- 지금 화면 틀의 격자
Stage.REF_W, Stage.REF_H = UI.grid.w, UI.grid.h -- 자리를 적을 때의 기준 격자(960x540)
Stage.insetTop = 0 -- 화면 왼쪽 위의 Roblox 기본 단추(메뉴 · 채팅)가 가리는 높이(화면 틀의 점) — 왼쪽 위에 붙는 것은 이만큼 내려 놓는다

local resized = {} -- 격자가 바뀌었을 때 부를 것들

-- 게임 세계의 배율 s에서 화면 틀의 배율: 격자의 높이가 540에 가장 가깝게(s 2 · 3 → 1, 4 · 5 · 6 → 2, 7 · 8 → 3 …)
function Stage.uiScaleFor(s: number): number
	return math.max(1, math.floor(0.4 * s + 0.5))
end

-- 화면 크기(w x h)에서의 두 배율: 게임 세계의 배율, 화면 틀의 배율.
--  2배 이상 들어가는 화면: 게임 세계는 들어가는 가장 큰 정수 배율(도트가 뭉개지지 않게), 화면 틀은 uiScaleFor.
--  그보다 작은 화면(스마트폰): 게임 세계를 화면에 꽉 차게(소수 배율), 화면 틀의 격자는 가장 작은 격자 그대로(게임 도트 하나 = 화면 틀의 두 점).
function Stage.scalesFor(w: number, h: number): (number, number)
	local fitScale = math.min(w / G.VIEW_W, h / G.VIEW_H)
	if fitScale >= 2 then
		local s = math.floor(fitScale)
		return s, Stage.uiScaleFor(s)
	end
	local s = math.max(0.5, fitScale)
	return s, s * G.VIEW_W / UI.grid.min.w
end

function Stage.init()
	-- Roblox가 기본으로 띄우는 것 가운데 이 게임이 쓰지 않는 것을 끈다.
	--  참가자 목록은 보이지 않을 때에도 화면 오른쪽 위를 덮어 그 자리의 단추(스마트폰 메뉴 · 창의 닫기)를 가로챈다.
	--  기본 조이스틱 · 뛰기 단추는 우리 터치 단추(touch.luau)와 겹친다. 채팅은 그대로 둔다.
	pcall(function()
		for _, kind in { Enum.CoreGuiType.PlayerList, Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.EmotesMenu } do
			StarterGui:SetCoreGuiEnabled(kind, false)
		end
		GuiService.TouchControlsEnabled = false
		-- 스마트폰은 가로 화면으로만 쓴다(세로로 세우면 게임 화면이 화면 폭에 맞춰 아주 작아진다)
		Players.LocalPlayer:WaitForChild("PlayerGui").ScreenOrientation = Enum.ScreenOrientation.LandscapeSensor
	end)

	local gui = Instance.new("ScreenGui")
	gui.Name = "LuneStage"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 0
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	-- 게임 화면 밖(배율이 딱 맞지 않을 때의 가장자리)은 검게 덮는다
	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(18, 22, 28)
	back.BorderSizePixel = 0
	back.Parent = gui

	-- 틀(holder)은 화면의 정수 점 자리에 놓는다(가운데가 반 점에 걸리면 도트가 어긋난다). 그 안의 층에만 배율을 건다
	local holder = Instance.new("Frame")
	holder.Name = "Holder"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.ClipsDescendants = true
	holder.Parent = gui

	local view = Instance.new("Frame")
	view.Name = "View"
	view.Size = UDim2.fromOffset(G.VIEW_W, G.VIEW_H)
	view.BorderSizePixel = 0
	view.Parent = holder

	local viewScale = Instance.new("UIScale")
	viewScale.Parent = view

	local ui = Instance.new("Frame")
	ui.Name = "Ui"
	ui.BackgroundTransparency = 1
	ui.BorderSizePixel = 0
	ui.ZIndex = 10
	ui.Parent = holder

	local uiScale = Instance.new("UIScale")
	uiScale.Parent = ui

	local function fit()
		local real = gui.AbsoluteSize
		local size = real
		local fake = gui:GetAttribute("Screen")
		if typeof(fake) == "string" then
			local fw, fh = fake:match("^(%d+)x(%d+)$")
			if fw and fh then
				size = Vector2.new(math.min(real.X, tonumber(fw) :: number), math.min(real.Y, tonumber(fh) :: number))
			end
		end
		local s, us = Stage.scalesFor(size.X, size.Y)
		local changed = s ~= Stage.scale or us ~= Stage.uiScale
		Stage.scale, Stage.uiScale, Stage.ratio = s, us, s / us
		Stage.uiW, Stage.uiH = G.VIEW_W * s / us, G.VIEW_H * s / us
		viewScale.Scale = s
		uiScale.Scale = us
		ui.Size = UDim2.fromOffset(Stage.uiW, Stage.uiH)
		local hw, hh = math.floor(G.VIEW_W * s + 0.5), math.floor(G.VIEW_H * s + 0.5)
		holder.Size = UDim2.fromOffset(hw, hh)
		local top = math.floor((real.Y - hh) / 2)
		holder.Position = UDim2.fromOffset(math.floor((real.X - hw) / 2), top)
		-- Roblox 기본 단추의 띠(화면 위 58픽셀쯤)가 게임 화면의 위쪽을 얼마나 덮는가
		local okInset, inset = pcall(function()
			return GuiService:GetGuiInset()
		end)
		Stage.insetTop = if okInset then math.max(0, math.ceil((inset.Y - top) / us)) else 0
		if changed then
			for _, fn in resized do
				fn()
			end
		end
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	gui:GetAttributeChangedSignal("Screen"):Connect(fit)
	fit()

	Stage.gui = gui
	Stage.view = view
	Stage.ui = ui
	return Stage
end

-- 화면 틀의 격자가 바뀌면(창 크기가 바뀌어 배율이 달라지면) fn을 부른다
-- 돌려주는 것: 그 함수를 빼는 함수(화면을 닫을 때 — 2026-10-18 검토: 캐릭터 고르기를 열 때마다 하나씩 쌓여 닫힌 화면을 붙들고 있었다)
function Stage.onResize(fn: () -> ()): () -> ()
	table.insert(resized, fn)
	return function()
		local i = table.find(resized, fn)
		if i then
			table.remove(resized, i)
		end
	end
end

-- 도트 좌표에 놓는 그림 한 장(도트 그림용 설정)
function Stage.image(parent: Instance, name: string, image: string, w: number, h: number): ImageLabel
	local label = Instance.new("ImageLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.ResampleMode = Enum.ResamplerMode.Pixelated
	label.ScaleType = Enum.ScaleType.Stretch
	label.Size = UDim2.fromOffset(w, h)
	label.Image = image
	label.Parent = parent
	return label
end

-- 그림을 담는 빈 틀(겹치는 차례를 틀 단위로 정한다)
function Stage.group(parent: Instance, name: string, z: number): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Size = UDim2.fromScale(1, 1)
	frame.ZIndex = z
	frame.Parent = parent
	return frame
end

-- 화면 틀의 층에 놓는 자리. at = 붙는 구석("tl" · "tc" · "tr" · "bl" · "bc" · "br"), (x, y) = 기준 격자(960x540)에서의 자리.
--  격자가 달라져도 그 구석에서의 거리가 같게 놓인다. 돌려주는 틀 안에서는 (0, 0)부터 그대로 쓴다.
function Stage.atPosition(at: string, x: number, y: number): UDim2
	local fy = if at:sub(1, 1) == "b" then 1 else 0
	local side = at:sub(2, 2)
	local fx = if side == "r" then 1 elseif side == "c" then 0.5 else 0
	-- 왼쪽 위에 붙는 것은 Roblox 기본 단추 아래로 내린다
	local down = if at == "tl" then Stage.insetTop else 0
	return UDim2.new(fx, x - Stage.REF_W * fx, fy, y - Stage.REF_H * fy + down)
end

function Stage.place(parent: Instance, name: string, at: string, x: number, y: number, w: number, h: number): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Position = Stage.atPosition(at, x, y)
	frame.Size = UDim2.fromOffset(w, h)
	frame.Parent = parent
	return frame
end

-- 화면 칸(data/ui.generated.luau의 hud.*)의 자리에 놓는 틀
function Stage.placeRect(parent: Instance, name: string, r): Frame
	return Stage.place(parent, name, r.at, r.x, r.y, r.w, r.h)
end

return Stage

end
MODULES['Client/lune/title'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 처음 화면 — 「달의 계승자」 로딩 화면 → START → 캐릭터 고르기(만들기 · 삭제 · 들어가기).
--  사용자 2026-10-10: "맨처음에 게임을 접속할때 로딩화면을 멋있게 구현해야하고, 그 로딩화면에서 스타트 누르면 캐릭터 선택창 나오고 거기에 캐릭터 만들기도 있고,
--   캐릭터 삭제도 있고, 내가 만든 캐릭터 중 하나를 선택해서 접속하는 방식", "캐릭터 이름은 처음에 생성할때 캐릭터 이름을 짓습니다. 중복확인을하고".
--  바탕(큰 달의 하늘 · 흘러가는 구름 · 떠오르는 달가루 · 언덕 · 제목)은 처음부터 끝까지 그대로 있고, 그 위의 것만 단계마다 바뀐다:
--   로딩   = 달 앞에 다섯 영웅의 실루엣. 그림을 다 불러오면 START 단추가 뜬다(Enter · Space · 화면을 눌러도 된다).
--   고르기 = 내 캐릭터들이 언덕에 서 있다. ← → 로 고르고 Enter(또는 「게임 시작」)로 들어간다. 「캐릭터 만들기」 · 「캐릭터 삭제」.
--   만들기 = 다섯 직업 가운데 하나를 고르고(외형은 정해져 있다), 이름을 적어 「중복 확인」을 받은 뒤 「만들기」.
--   삭제   = 캐릭터의 이름을 그대로 적어야 지워진다. 이름 짓기 = 이름이 없는 캐릭터(계정이 생기기 전의 캐릭터)에 이름을 지어 준다.
--  그림 · 자리 · 글은 shared/lune/data/title.generated.luau(공방의 js/lune/design/title.js · tools/build_lune_title.mjs).
--  하늘 · 언덕 · 캐릭터는 게임 세계의 층에, 글 · 단추 · 판은 화면 틀의 층(고운 격자)에 그린다. 이름을 적는 칸은 Roblox의 글자 입력 칸이다(채팅과 같다).
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local lune = ReplicatedStorage.shared.lune
local G = require(lune.config.game)
local T = require(lune.data["title.generated"])
local CLASSES = require(lune.data["classes.generated"])
local COMBAT = require(lune.data["combat.generated"])
local ASSETS = require(lune.data["assets.generated"])
local Account = require(lune.sim.account)
local Stage = require(script.Parent.stage)
local Sprite = require(script.Parent.sprite)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR
local TXT = T.text
local WHITE, GRAY, OFF, MINT, PINK = C.text, C.dim, C.off, C.accent, C.pink
local GROUND = T.ground
local CLOUD_SPEED = 2.2 -- 구름이 흘러가는 빠르기(도트/초)
local DUST = 18 -- 떠오르는 달가루의 수
local FADE = 0.22 -- 단계를 바꿀 때 어두워졌다 밝아지는 시간(초)
local NAME_MAX = 12 -- 이름 칸에 적을 수 있는 글자 수(한글은 여섯 자까지 — 셈은 sim/account.luau)

local Title = {}

local function hexColor(hex: string): Color3
	return Color3.fromRGB(tonumber(hex:sub(2, 3), 16) :: number, tonumber(hex:sub(4, 5), 16) :: number, tonumber(hex:sub(6, 7), 16) :: number)
end

-- 이름을 적는 칸(틀 + Roblox의 글자 입력 칸). 돌려주는 것: 입력 칸
local function nameField(parent: Instance, x: number, y: number, w: number, h: number, placeholder: string): TextBox
	local field = Ui.group(parent, x, y, w, h, "Field")
	Ui.part(field, "uField", 0, 0, w, h)
	local box = Instance.new("TextBox")
	box.Name = "Input"
	box.BackgroundTransparency = 1
	box.Position = UDim2.fromOffset(6, 0)
	box.Size = UDim2.new(1, -12, 1, 0)
	box.Font = Enum.Font.SourceSans
	box.TextSize = 12
	box.TextColor3 = C.text
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = C.off
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.ClearTextOnFocus = false
	box.Text = ""
	box.ZIndex = 6
	box.Parent = field
	-- 띄어쓰기는 적히지 않는다(이름에 쓸 수 없다 — 끝에 딸려 들어온 빈칸 때문에 중복 확인이 안 되는 일이 없게). 너무 길게도 적히지 않는다(자세한 규칙은 중복 확인이 알려 준다)
	box:GetPropertyChangedSignal("Text"):Connect(function()
		local bare = string.gsub(box.Text, "%s", "")
		if bare ~= box.Text then
			box.Text = bare
			return
		end
		local n = utf8.len(box.Text)
		if n and n > NAME_MAX then
			box.Text = string.sub(box.Text, 1, (utf8.offset(box.Text, NAME_MAX + 1) :: number) - 1)
		end
	end)
	return box
end

-- 처음 화면을 띄우고, 캐릭터로 들어갈 때까지 기다린다. 돌려주는 것 = 서버가 준 내 상태와 방(Ready가 주던 것과 같다).
--  select = 서버가 준 고르기 화면의 표({ chars, max, last }) · io.invoke(하는 일, a, b) = 서버에 묻는다(Chars 패킷) · io.preload(알림) = 그림을 불러온다(알림(끝난 수, 모두))
--  io.skipLoading = 로딩 화면 없이 고르기 화면부터(게임 안에서 메뉴 → 캐릭터 선택으로 돌아왔을 때)
function Title.run(select, io)
	local view = select
	-- ---------- 바탕(게임 세계의 층) ----------
	local root = Stage.group(Stage.view, "Title", 200)
	root.BackgroundTransparency = 0
	root.BackgroundColor3 = Color3.fromRGB(90, 106, 130)
	root.ClipsDescendants = true
	Stage.image(root, "Sky", ASSETS[T.img.sky] or "", G.VIEW_W, G.VIEW_H).ZIndex = 1
	local clouds = {}
	for i = 1, 2 do
		local c = Stage.image(root, "Clouds" .. i, ASSETS[T.img.clouds] or "", T.clouds.w, T.clouds.h)
		c.ZIndex = 2
		clouds[i] = c
	end
	local dust = {}
	local rng = Random.new(20261010)
	for i = 1, DUST do
		local f = Instance.new("Frame")
		f.Name = "Dust"
		f.Size = UDim2.fromOffset(1, 1)
		f.BorderSizePixel = 0
		f.BackgroundColor3 = if i % 3 == 0 then Color3.fromRGB(62, 255, 215) else Color3.fromRGB(207, 221, 230)
		f.ZIndex = 3
		f.Parent = root
		dust[i] = { frame = f, x = rng:NextNumber(0, G.VIEW_W), y = rng:NextNumber(20, GROUND), speed = rng:NextNumber(3, 8), sway = rng:NextNumber(0, 6.28), life = rng:NextNumber(0, 1) }
	end
	local ridge = Stage.image(root, "Ridge", ASSETS[T.img.ridge] or "", G.VIEW_W, T.ridge.h)
	ridge.Position = UDim2.fromOffset(0, T.ridge.y)
	ridge.ZIndex = 5
	local actors = Stage.group(root, "Actors", 6)
	local logo = Stage.image(root, "Logo", ASSETS[T.img.logo] or "", T.logo.w, T.logo.h)
	logo.Position = UDim2.fromOffset(math.floor((G.VIEW_W - T.logo.w) / 2), T.logo.y)
	logo.ZIndex = 7
	logo.ImageTransparency = 1

	-- ---------- 글의 층(화면 틀) ----------
	local over = Stage.group(Stage.ui, "Title", 200)
	local shade = Instance.new("Frame") -- 단계를 바꿀 때 잠깐 덮는 어둠
	shade.Name = "Shade"
	shade.Size = UDim2.fromScale(1, 1)
	shade.BackgroundColor3 = C.ink
	shade.BorderSizePixel = 0
	shade.ZIndex = 90
	shade.Parent = over

	local clock = 0
	local result = nil
	local busy = false
	local sv: Frame? = nil -- 지금 단계의 것(게임 세계의 층)
	local su: Frame? = nil -- 지금 단계의 것(화면 틀의 층)
	local stageStep: ((number) -> ())? = nil
	local stageKey: ((Enum.KeyCode) -> ())? = nil
	local stagePlace: (() -> ())? = nil -- 화면 틀의 배율이 바뀌면 다시 놓을 것
	local shadeFrom, shadeTo, shadeT = 1, 0, 0 -- 처음에는 어둠에서 밝아진다

	local function open(): (Frame, Frame)
		if sv then
			sv:Destroy()
		end
		if su then
			su:Destroy()
		end
		stageStep, stageKey, stagePlace = nil, nil, nil
		local a, b = Stage.group(actors, "Stage", 1), Stage.group(over, "Stage", 1)
		sv, su = a, b
		return a, b
	end

	-- 어두워졌다가(그 사이에 화면을 바꾸고) 밝아진다
	local function switch(build: () -> ())
		shadeFrom, shadeTo, shadeT = shade.BackgroundTransparency, 0, 0
		task.delay(FADE, function()
			if root.Parent then
				build()
				shadeFrom, shadeTo, shadeT = 0, 1, 0
			end
		end)
	end

	-- 서버에 묻는다(답을 기다리는 동안에는 다른 것을 누를 수 없다). 답이 없으면 nil
	local function ask(action: string, a: any, b: any): any
		if busy then
			return nil
		end
		busy = true
		local ok, res = pcall(io.invoke, action, a, b)
		busy = false
		return if ok then res else nil
	end

	local showSelect, showCreate

	-- 게임 세계의 도트 자리(x, y)를 화면 틀의 자리로
	local function toUi(x: number, y: number): (number, number)
		return math.floor(x * Stage.ratio + 0.5), math.floor(y * Stage.ratio + 0.5)
	end

	-- 캐릭터 만들기에서 고른 직업이 써 보이는 기술(공방의 title.js의 show — 몸 동작만으로도 무엇을 하는지 보이는 것).
	--  돌려주는 것: 그 기술, 이 화면에서 한 번 트는 데 걸리는 시간(초 — 게임 안보다 조금 느리게 보여 준다)
	local SHOW = T.show
	local function showOf(id: string)
		local sk = COMBAT.skills[SHOW.skill[id]]
		local total = 0
		if sk then
			for _, seg in sk.segs do
				total += seg.time / SHOW.speed
			end
		end
		return sk, total
	end

	-- ---------- 로딩 ----------
	local function showLoading()
		local a, b = open()
		local order = CLASSES.order
		local n = #order
		local tint = hexColor(T.heroes.tint)
		local sil = {}
		for i, id in order do
			local sp = Sprite.new(a, id, 1, true) -- 흰 그림(mask)에 색을 입히면 실루엣이 된다
			sp.label.ImageColor3 = tint
			sil[i] = { sprite = sp, x = T.moon.x + (i - (n + 1) / 2) * T.heroes.gap }
		end
		local holder = Stage.place(b, "Load", "bc", Stage.REF_W / 2 - 160, Stage.REF_H - 96, 320, 80)
		local label = Ui.text(holder, TXT.loading, 0, 6, 320, { align = "center", outline = true })
		local bar = Ui.bar(holder, 60, 24, 200, 6, MINT, C.panel)
		bar:set(0)
		local loaded = false
		local done, total, shown = 0, 1, -1
		local start = nil
		local hint = nil
		local function go()
			if loaded and not result then
				loaded = false -- 한 번만
				switch(function()
					showSelect(nil)
				end)
			end
		end
		-- 화면 어디를 눌러도 시작한다(START 단추 아래에 깔린 누르는 자리)
		local anywhere = Instance.new("TextButton")
		anywhere.Name = "Anywhere"
		anywhere.Text = ""
		anywhere.BackgroundTransparency = 1
		anywhere.Size = UDim2.fromScale(1, 1)
		anywhere.ZIndex = 1
		anywhere.Parent = b
		anywhere.Activated:Connect(go)
		task.spawn(function()
			io.preload(function(d: number, t: number)
				done, total = d, t
			end)
			if not root.Parent then
				return
			end
			label:show(false)
			bar.frame.Visible = false
			start = Ui.button(holder, TXT.start, 80, 8, 160, go, { main = true, h = 30 })
			start.frame.Name = "Start"
			if UserInputService.KeyboardEnabled then
				hint = Ui.text(holder, TXT.startHint, 0, 48, 320, { align = "center", outline = true, color = GRAY })
			end
			loaded = true
		end)
		stageStep = function(_dt)
			for i, s in sil do
				local frame = Sprite.frameAt(s.sprite.char, "idle", clock + i * 0.23, false)
				s.sprite:set("idle", frame, s.x, GROUND, 1)
			end
			if start == nil and done ~= shown then
				shown = done
				bar:set(done / math.max(1, total))
				label:set(("%s  %d / %d"):format(TXT.loading, done, total))
			end
			if hint then
				hint:show(clock % 1.6 < 1.1) -- 천천히 깜빡인다
			end
		end
		stageKey = function(key)
			if key == Enum.KeyCode.Return or key == Enum.KeyCode.Space or key == Enum.KeyCode.KeypadEnter then
				go()
			end
		end
	end

	-- ---------- 이름을 적는 상자(삭제 · 이름 짓기가 같이 쓴다): 가운데의 판과 그 뒤의 어둠 ----------
	local function modal(parent: Instance, w: number, h: number): (Frame, TextButton)
		local dim = Instance.new("TextButton") -- 뒤의 것을 누르지 못하게 덮는다
		dim.Name = "Dim"
		dim.Text = ""
		dim.AutoButtonColor = false
		dim.Size = UDim2.fromScale(1, 1)
		dim.BackgroundColor3 = C.ink
		dim.BackgroundTransparency = 0.45
		dim.BorderSizePixel = 0
		dim.ZIndex = 40
		dim.Parent = parent
		local holder = Stage.place(dim, "Box", "tc", Stage.REF_W / 2 - w / 2, 150, w, h)
		holder.ZIndex = 41
		return Ui.panel(holder, 0, 0, w, h), dim
	end

	-- ---------- 캐릭터 고르기 ----------
	local picked = 1
	for i, c in view.chars do
		if c.id == view.last then
			picked = i -- 마지막으로 하던 캐릭터가 골라져 있다
		end
	end
	-- 화면의 머리글(왼쪽 위): 지금 무엇을 하는 화면인지
	local function header(parent: Instance, title: string, hint: string?)
		local box = Stage.place(parent, "Header", "tl", 22, 18, 300, 40)
		Ui.text(box, title, 0, 0, 300, { font = "body", outline = true, color = MINT })
		if hint and UserInputService.KeyboardEnabled then
			Ui.text(box, hint, 0, 20, 300, { outline = true, color = GRAY })
		end
	end
	showSelect = function(note: string?)
		local a, b = open()
		local chars, max = view.chars, view.max
		if #chars == 0 then
			showCreate() -- 캐릭터가 없으면 만들기부터
			return
		end
		picked = math.clamp(picked, 1, #chars)
		header(b, TXT.select, TXT.selectHint)
		local slots = {}
		for i = 1, max do
			local c = chars[i]
			local x = G.VIEW_W / 2 + (i - (max + 1) / 2) * T.slots.gap
			local slot = { x = x, char = c }
			if c then
				slot.sprite = Sprite.new(a, c.class, 2)
				slot.name = Ui.tag(b, if c.name ~= "" then c.name else "이름 없음", WHITE, 130, true)
				slot.sub = Ui.tag(b, ("Lv.%d %s"):format(c.level, CLASSES.classes[c.class].name), GRAY, 130)
				local hit = Instance.new("TextButton")
				hit.Name = "Pick" .. i
				hit.Text = ""
				hit.BackgroundTransparency = 1
				hit.ZIndex = 8
				hit.Parent = b
				slot.hit = hit
			else
				slot.name = Ui.tag(b, TXT.empty, OFF, 130)
			end
			slots[i] = slot
		end
		-- 고른 캐릭터의 머리 위에 민트 세모
		local mark = Stage.group(a, "Mark", 5)
		for row = 0, 2 do
			local f = Instance.new("Frame")
			f.Size = UDim2.fromOffset(5 - row * 2, 1)
			f.Position = UDim2.fromOffset(row, row)
			f.BackgroundColor3 = MINT
			f.BorderSizePixel = 0
			f.Parent = mark
		end
		mark.Size = UDim2.fromOffset(5, 3)

		local bottom = Stage.place(b, "Bottom", "bc", Stage.REF_W / 2 - 220, Stage.REF_H - 76, 440, 76)
		local status = Ui.text(bottom, note or "", 0, 0, 440, { align = "center", outline = true, color = PINK })
		local enterButton, createButton, removeButton
		local function refresh()
			local c = chars[picked]
			for i, s in slots do
				if s.char then
					s.name:SetColor(if i == picked then WHITE else GRAY)
					s.sprite.label.ImageColor3 = if i == picked then Color3.new(1, 1, 1) else Color3.fromRGB(150, 160, 178)
				end
			end
			enterButton:setText(if c.name == "" then TXT.giveName else TXT.enter)
			createButton:setEnabled(#chars < max)
		end
		local function place()
			for _, s in slots do
				local cx, gy = toUi(s.x, GROUND)
				s.name.Frame.Position = UDim2.fromOffset(cx - math.floor(s.name.Width / 2), gy + 7)
				if s.sub then
					s.sub.Frame.Position = UDim2.fromOffset(cx - math.floor(s.sub.Width / 2), gy + 7 + Ui.TAG_H + 3)
				end
				if s.hit then
					local w, h = toUi(T.slots.gap, 44)
					s.hit.Position = UDim2.fromOffset(cx - math.floor(w / 2), gy - h)
					s.hit.Size = UDim2.fromOffset(w, h + 34)
				end
			end
		end
		stagePlace = place

		-- 이름 짓기(이름이 없는 캐릭터)
		local function openName(c)
			local panel, dim = modal(b, 360, 150)
			Ui.text(panel, TXT.nameTitle, 16, 14, 328, { font = "body", color = MINT })
			Ui.text(panel, TXT.nameRule, 16, 38, 328, { color = GRAY })
			local box = nameField(panel, 16, 56, 228, 24, TXT.namePlaceholder)
			local say = Ui.text(panel, TXT.needCheck, 16, 86, 328, { lines = 2, line = 12, color = GRAY })
			local okName: string? = nil
			local setButton
			local function check()
				if busy then
					return
				end
				local name = box.Text
				okName = nil
				setButton:setEnabled(false)
				say:color(GRAY)
				say:set(TXT.checking)
				local res = ask("check", name, nil)
				if not dim.Parent then
					return
				end
				if res and res.ok then
					okName = name
					say:color(MINT)
					say:set(TXT.nameFree)
					setButton:setEnabled(true)
				else
					say:color(PINK)
					say:set(if res then res.why or TXT.failed else TXT.failed)
				end
			end
			Ui.button(panel, TXT.check, 250, 56, 94, check, { h = 24 })
			setButton = Ui.button(panel, TXT.setName, 16, 114, 200, function()
				if busy or not okName or okName ~= box.Text then
					return
				end
				local res = ask("name", c.id, okName)
				if res and res.ok then
					view = res.select
					showSelect(nil)
				elseif dim.Parent then
					say:color(PINK)
					say:set(if res then res.why or TXT.failed else TXT.failed)
					setButton:setEnabled(false)
				end
			end, { main = true })
			setButton:setEnabled(false)
			Ui.button(panel, TXT.cancel, 224, 114, 120, function()
				dim:Destroy()
			end)
			box:GetPropertyChangedSignal("Text"):Connect(function()
				if okName and box.Text ~= okName then
					okName = nil
					setButton:setEnabled(false)
					say:color(GRAY)
					say:set(TXT.needCheck)
				end
			end)
			box.FocusLost:Connect(function(enter: boolean)
				if enter and box.Text ~= "" then
					check()
				end
			end)
			box:CaptureFocus()
		end

		local function enter()
			local c = chars[picked]
			if not c or result or busy then
				return
			end
			if c.name == "" then
				openName(c)
				return
			end
			status:color(GRAY)
			status:set(TXT.wait)
			local res = ask("enter", c.id, nil)
			if res and res.self then
				result = res
			elseif res and res.select then
				view = res.select -- 이름을 더 쓸 수 없게 된 캐릭터: 서버가 이름을 비웠다 — 다시 지어야 들어간다
				showSelect(res.why)
			elseif status.label.Frame.Parent then
				status:color(PINK)
				status:set(if res then res.why or TXT.failed else TXT.failed)
			end
		end

		-- 삭제: 이름을 그대로 적어야 지워진다(이름이 없는 캐릭터는 적을 것이 없다)
		local function openRemove()
			local c = chars[picked]
			if not c then
				return
			end
			local named = c.name ~= ""
			local panel, dim = modal(b, 380, if named then 186 else 132)
			Ui.text(panel, TXT.removeTitle, 16, 14, 348, { font = "body", color = PINK })
			Ui.text(panel, ("%s  ·  Lv.%d %s"):format(if named then c.name else "이름 없음", c.level, CLASSES.classes[c.class].name), 16, 38, 348, { color = WHITE })
			Ui.text(panel, TXT.removeWarn, 16, 56, 348, { lines = 2, line = 12, color = GRAY })
			local y = 86
			local box: TextBox? = nil
			local doButton
			if named then
				Ui.text(panel, TXT.removeAsk, 16, y, 348, { color = GRAY })
				box = nameField(panel, 16, y + 16, 348, 24, c.name)
				y += 50
			end
			local say = Ui.text(panel, "", 16, y - 8, 348, { color = PINK })
			doButton = Ui.button(panel, TXT.removeDo, 16, y + 8, 170, function()
				if busy or (named and (not box or box.Text ~= c.name)) then
					return
				end
				local res = ask("delete", c.id, if named then c.name else nil)
				if res and res.ok then
					view = res.select
					picked = math.max(1, picked - 1)
					showSelect(nil)
				elseif dim.Parent then
					say:set(if res then res.why or TXT.failed else TXT.failed)
				end
			end)
			Ui.button(panel, TXT.cancel, 194, y + 8, 170, function()
				dim:Destroy()
			end, { main = true })
			if box then
				local field = box
				doButton:setEnabled(false)
				field:GetPropertyChangedSignal("Text"):Connect(function()
					doButton:setEnabled(field.Text == c.name)
				end)
				field:CaptureFocus()
			end
		end

		enterButton = Ui.button(bottom, TXT.enter, 0, 16, 160, enter, { main = true })
		enterButton.frame.Name = "Enter"
		createButton = Ui.button(bottom, TXT.create, 168, 16, 132, function()
			if #chars < max and not busy then
				switch(showCreate)
			end
		end)
		createButton.frame.Name = "Create"
		removeButton = Ui.button(bottom, TXT.remove, 308, 16, 132, openRemove)
		removeButton.frame.Name = "Remove"
		for i, s in slots do
			if s.hit then
				s.hit.Activated:Connect(function()
					if i == picked then
						enter() -- 고른 캐릭터를 한 번 더 누르면 들어간다
					else
						picked = i
						refresh()
					end
				end)
			end
		end
		refresh()
		place()
		stageStep = function(_dt)
			for i, s in slots do
				if s.sprite then
					local frame = if i == picked then Sprite.frameAt(s.sprite.char, "idle", clock, false) else 1
					s.sprite:set("idle", frame, s.x, GROUND, 1)
				end
			end
			local s = slots[picked]
			mark.Position = UDim2.fromOffset(math.floor(s.x) - 2, GROUND - 30 + math.floor(math.sin(clock * 3) + 0.5))
		end
		stageKey = function(key)
			if b:FindFirstChild("Dim") then
				return -- 상자가 떠 있다
			end
			if key == Enum.KeyCode.Left then
				picked = (picked - 2) % #chars + 1
				refresh()
			elseif key == Enum.KeyCode.Right then
				picked = picked % #chars + 1
				refresh()
			elseif key == Enum.KeyCode.Return or key == Enum.KeyCode.KeypadEnter then
				enter()
			end
		end
	end

	-- ---------- 캐릭터 만들기 ----------
	showCreate = function()
		local a, b = open()
		local order = CLASSES.order
		local n = #order
		local slots = {}
		for i, id in order do
			local slot = { id = id, class = CLASSES.classes[id], x = G.VIEW_W / 2 + (i - (n + 1) / 2) * T.create.gap }
			slot.sprite = Sprite.new(a, id, 2)
			slot.show, slot.showTime = showOf(id)
			slot.name = Ui.tag(b, slot.class.name, WHITE, 140)
			local hit = Instance.new("TextButton")
			hit.Name = "Class_" .. id
			hit.Text = ""
			hit.BackgroundTransparency = 1
			hit.ZIndex = 8
			hit.Parent = b
			slot.hit = hit
			slots[i] = slot
		end
		header(b, TXT.createTitle, TXT.createHint)
		local W, H = 600, 100
		local holder = Stage.place(b, "Panel", "bc", Stage.REF_W / 2 - W / 2, Stage.REF_H - H - 8, W, H)
		local panel = Ui.panel(holder, 0, 0, W, H)
		-- 왼쪽: 고른 직업
		local head = Ui.text(panel, "", 14, 11, 272, { font = "body", color = MINT })
		local weapon = Ui.text(panel, "", 14, 13, 272, { align = "right", color = GRAY })
		local role = Ui.text(panel, "", 14, 32, 272, { lines = 2, line = 14 })
		Ui.box(panel, 300, 12, 1, H - 24, C.line)
		-- 오른쪽: 이름
		Ui.text(panel, TXT.nameLabel, 314, 11, 60, { color = WHITE })
		Ui.text(panel, TXT.nameRule, 314, 11, 272, { align = "right", color = OFF })
		local box = nameField(panel, 314, 28, 176, 24, TXT.namePlaceholder)
		local say = Ui.text(panel, TXT.needCheck, 314, 58, 272, { lines = 2, line = 12, color = GRAY })
		local chosen = math.ceil(n / 2)
		local chosenAt = 0
		local okName: string? = nil
		local makeButton
		-- 적고 있는 이름을 고른 직업의 머리 위에 이름표로 보여 준다(게임 안에서 보일 글씨 그대로 — 글꼴에 없는 글자는 "?"로 보인다)
		local preview = Ui.tag(b, "", WHITE, 140, true)
		local function placePreview()
			local cx, top = toUi(slots[chosen].x, GROUND - 27)
			preview.Frame.Position = UDim2.fromOffset(cx - math.floor(preview.Width / 2), top - Ui.TAG_H)
		end
		local function show()
			local slot = slots[chosen]
			local c = slot.class
			head:color(if c.tone == "pink" then PINK else MINT)
			head:set(c.name)
			weapon:set(c.weapon)
			role:set(c.role)
			for i, s in slots do
				s.name:SetColor(if i == chosen then WHITE else GRAY)
				s.sprite.label.ImageColor3 = if i == chosen then Color3.new(1, 1, 1) else Color3.fromRGB(150, 160, 178)
			end
			chosenAt = clock
			placePreview()
		end
		local function place()
			for _, s in slots do
				local cx, gy = toUi(s.x, GROUND)
				s.name.Frame.Position = UDim2.fromOffset(cx - math.floor(s.name.Width / 2), gy + 7)
				local w, h = toUi(T.create.gap, 44)
				s.hit.Position = UDim2.fromOffset(cx - math.floor(w / 2), gy - h)
				s.hit.Size = UDim2.fromOffset(w, h + 22)
			end
			placePreview()
		end
		stagePlace = place
		local function fail(res)
			say:color(PINK)
			say:set(if res then res.why or TXT.failed else TXT.failed)
		end
		local function check()
			if busy then
				return
			end
			local name = box.Text
			okName = nil
			makeButton:setEnabled(false)
			say:color(GRAY)
			say:set(TXT.checking)
			local res = ask("check", name, nil)
			if not panel.Parent then
				return
			end
			if res and res.ok then
				okName = name
				say:color(MINT)
				say:set(TXT.nameFree)
				makeButton:setEnabled(true)
			else
				fail(res)
			end
		end
		Ui.button(panel, TXT.check, 496, 28, 90, check, { h = 24 }).frame.Name = "Check"
		local backButton = Ui.button(panel, TXT.back, 14, 66, 100, function()
			if #view.chars > 0 and not busy then
				switch(function()
					showSelect(nil)
				end)
			end
		end)
		backButton.frame.Name = "BackButton"
		backButton.frame.Visible = #view.chars > 0 -- 첫 캐릭터를 만들 때는 돌아갈 고르기 화면이 없다
		makeButton = Ui.button(panel, TXT.make, 122, 66, 164, function()
			if busy or not okName or okName ~= box.Text or result then
				return
			end
			say:color(GRAY)
			say:set(TXT.wait)
			local res = ask("create", okName, slots[chosen].id)
			if not (res and res.ok) then
				if panel.Parent then
					fail(res)
					makeButton:setEnabled(false)
					okName = nil
				end
				return
			end
			-- 만든 캐릭터로 바로 들어간다
			view = res.select
			local entered = ask("enter", res.id, nil)
			if entered and entered.self then
				result = entered
			else
				view = if entered and entered.select then entered.select else view -- 서버가 준 목록으로(그 사이 이름이 비워졌으면 그것이 보이게 — 2026-10-18 검토)
				picked = #view.chars
				showSelect(if entered then entered.why else TXT.failed)
			end
		end, { main = true })
		makeButton.frame.Name = "Make"
		makeButton:setEnabled(false)
		box:GetPropertyChangedSignal("Text"):Connect(function()
			preview:SetText(box.Text)
			placePreview()
			if okName and box.Text ~= okName then
				okName = nil
				makeButton:setEnabled(false)
				say:color(GRAY)
				say:set(TXT.needCheck)
			end
		end)
		box.FocusLost:Connect(function(enter: boolean)
			if enter and box.Text ~= "" then
				check()
			end
		end)
		for i, s in slots do
			s.hit.Activated:Connect(function()
				if chosen ~= i then
					chosen = i
					show()
				end
			end)
		end
		show()
		place()
		-- 고른 직업은 기술을 써 보이고, 나머지는 서 있다.
		--  고른 직업: 서 있다가(lead초) 기술을 한 번 쓰고, 다시 서 있다가(rest초) 또 쓴다. 서 있는 동작은 그때마다 첫 장부터 튼다 —
		--   고른 순간과 기술이 끝난 순간에 서 있는 동작의 중간 장으로 건너뛰지 않게(사용자 2026-10-10: "자연스럽지가 않고")
		stageStep = function(_dt)
			for i, s in slots do
				local char = s.sprite.char
				local clip, frame = "idle", Sprite.frameAt(char, "idle", clock + i * 0.2, false)
				if i == chosen then
					local t = clock - chosenAt
					local sk, total = s.show, s.showTime
					if sk and total > 0 and t >= SHOW.lead then
						t = (t - SHOW.lead) % (total + SHOW.rest)
						if t < total then
							local at = t * SHOW.speed -- 게임 안의 시간으로
							for _, seg in sk.segs do
								if at < seg.time then
									clip, frame = seg.clip, seg.from + math.min(seg.to - seg.from, math.floor(at * seg.fps)) + 1
									break
								end
								at -= seg.time
							end
						else
							frame = Sprite.frameAt(char, "idle", t - total, false)
						end
					else
						frame = Sprite.frameAt(char, "idle", t, false)
					end
				end
				s.sprite:set(clip, frame, s.x, GROUND, 1)
			end
		end
		stageKey = function(key)
			if key == Enum.KeyCode.Left then
				chosen = (chosen - 2) % n + 1
				show()
			elseif key == Enum.KeyCode.Right then
				chosen = chosen % n + 1
				show()
			end
		end
	end

	-- ---------- 돌리기 ----------
	-- 화면은 BindToRenderStep으로 고친다(게임 화면 boot.luau와 같은 때). RunService.RenderStepped 이벤트에서 고치면 안 된다:
	--  그 이벤트는 Roblox가 그 장의 틀 크기를 이미 셈한 뒤에 불려서, 캐릭터 그림의 자리(ImageRect)는 이번 장에 · 틀의 크기(Size)는 다음 장에 적용된다.
	--  그러면 동작의 장이 바뀔 때마다 한 장씩 「새 그림이 앞 장의 크기로 늘어나거나 눌린 채」 그려진다 — 크기가 크게 다른 장 사이(기술이 끝나 서는 자세로 돌아올 때)에서 크게 튄다.
	--  (사용자 2026-10-10의 영상 bug.mp4: "애니메이션 종료시점이랑 돌아오는게 연결이 안되서 엄청나게 이상하게 튕기는 현상". 시험으로 확인: 같은 값을 RenderStepped에서 넣으면 어긋나고 BindToRenderStep에서 넣으면 맞는다.)
	local connections = {}
	local STEP_NAME = "LuneTitle"
	pcall(function()
		RunService:UnbindFromRenderStep(STEP_NAME)
	end)
	RunService:BindToRenderStep(STEP_NAME, Enum.RenderPriority.Camera.Value - 1, function(dt)
		clock += dt
		-- 구름: 왼쪽으로 흘러가고, 한 장이 지나가면 뒤에 이어 붙는다
		local off = (clock * CLOUD_SPEED) % T.clouds.w
		clouds[1].Position = UDim2.fromOffset(-math.floor(off), 0)
		clouds[2].Position = UDim2.fromOffset(T.clouds.w - math.floor(off), 0)
		-- 달가루: 천천히 떠오르며 흔들리고, 위에서 사라졌다가 땅에서 다시 생긴다
		for _, d in dust do
			d.y -= d.speed * dt
			d.life += dt * 0.25
			if d.y < 8 then
				d.y = GROUND - 2
				d.x = rng:NextNumber(0, G.VIEW_W)
				d.life = 0
			end
			d.frame.Position = UDim2.fromOffset(math.floor(d.x + math.sin(clock * 0.8 + d.sway) * 3), math.floor(d.y))
			d.frame.BackgroundTransparency = 0.25 + 0.5 * math.abs(math.sin(clock * 1.3 + d.sway))
		end
		-- 제목은 처음에 천천히 나타난다
		logo.ImageTransparency = math.clamp(1 - (clock - 0.3) / 1.2, 0, 1)
		-- 단계를 바꿀 때의 어둠
		if shadeT < 1 then
			shadeT = math.min(1, shadeT + dt / (if shadeTo == 1 then FADE * 1.6 else FADE))
			shade.BackgroundTransparency = shadeFrom + (shadeTo - shadeFrom) * shadeT
		end
		if stageStep then
			stageStep(dt)
		end
	end)
	table.insert(connections, UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard or UserInputService:GetFocusedTextBox() or busy then
			return
		end
		if stageKey then
			stageKey(input.KeyCode)
		end
	end))
	local unResize = Stage.onResize(function()
		if over.Parent and stagePlace then
			stagePlace()
		end
	end)
	table.insert(connections, { Disconnect = function() unResize() end }) -- (닫을 때 함께 뺀다)

	shadeFrom, shadeTo, shadeT = 0, 1, 0
	shade.BackgroundTransparency = 0
	if io.skipLoading then
		showSelect(nil) -- 게임 안에서 돌아온 것: 불러올 것이 없다
	else
		showLoading()
	end
	while not result do
		task.wait()
	end
	for _, c in connections do
		c:Disconnect()
	end
	RunService:UnbindFromRenderStep(STEP_NAME)
	Title.root, Title.over = root, over -- 게임 화면이 그려질 때까지 그대로 둔다 — 부른 쪽이 close()로 닫는다
	return result
end

function Title.close()
	if Title.root then
		Title.root:Destroy()
		Title.root = nil
	end
	if Title.over then
		Title.over:Destroy()
		Title.over = nil
	end
end

return Title

end
MODULES['Client/lune/touch'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 스마트폰(터치) 단추 — 공방 「기본 · UI」 탭의 스마트폰 화면 배치(data/ui.generated.luau의 touch)를 그대로 그린다.
--  「채팅」 단추는 없다(2026-10-13): 채팅은 Roblox의 기본 채팅이고, 폰에서는 화면 위의 Roblox 채팅 단추로 연다(chat.luau).
--  사용자 결정(2026-10-06): 스마트폰 터치 조작을 지원한다. 터치 화면이면 저절로 켜진다(Studio에서는 화면 틀의 속성 Touch = true로 켜 볼 수 있다).
--  사용자 2026-10-08(폰에서 해 보고): "모바일버튼을 누르고 거기에 배치할수있는 선택지가 나오고 그걸선택하면 그버튼에 배치되는식 … 소비템이던, 스킬이던
--    현재 사냥,보스,대쉬이렇게 글씨로 적혀있는것도 드래그앤 드랍으로 바꿀수있어야 … 이동형 터치패드도 동그라미만 있는게 아니라 그 가운데 잡고 돌리는 동그라미가 하나 더
--    … ...말고 메뉴라고 적혀있는 탭 … 모바일에서는 위로가는 게 포탈을타거나 상호작용이 안되게하고, 상호작용키를 하나 두는걸로 … 버튼들 퀄리티도 높여야 … 쿨타임 표기도 … 항상 크로스플랫폼을 고려하여"
--
--  칸 단추(slot): PC의 퀵슬롯 열두 칸 바로 그것이다 — 누르면 Input의 "slot:<칸>"을 누른 것과 같다(게임은 키로 눌렀는지 손가락으로 눌렀는지 모른다).
--    칸에 놓인 것의 그림 · 남은 수(물약) · 다시 쓰기까지 남은 시간이 단추에 뜬다. 공격 스킬은 누르고 있으면 이어서 쓴다.
--    놓는 법: ① 빈 단추를 누르거나 메뉴의 「단추 배치」 → 놓을 것의 목록(배운 스킬 · 물약)이 뜨고, 고르면 고른 단추에 놓인다. 배치 중에는 단추를 끌어 서로 자리를 바꾼다.
--            ② 스킬 창 · 가방에서 스킬 · 물약을 누르고(또는 끌어) 단추를 누른다 — PC와 같은 법(ui/quickEdit.luau가 한다. 단추의 자리는 Hud.touchSlotAt으로 알려 준다).
--  조이스틱: 바깥 원 + 가운데 손잡이. 좌우 = 걷기, 아래로 민 채 「점프」 = 발판에서 내려오기(하단 점프 — PC의 ↓ + 뛰기와 같다). 위로 미는 것은 아무 일도 없다(문 · 주민 · 줍기는 상호작용 단추).
--  단추의 자리는 게임 화면(384x216)의 도트로 적혀 있다. 그리는 곳은 화면 틀의 층(고운 격자)이라, 그 자리에 Stage.ratio를 곱해 놓는다.
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UI = require(ReplicatedStorage.shared.lune.data["ui.generated"])
local Quick = require(ReplicatedStorage.shared.lune.ui.quick)
local Stage = require(script.Parent.stage)
local Input = require(script.Parent.input)
local Hud = require(script.Parent.hud)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR
local PIC = 24 -- 그림 한 장(화면 틀의 점)
local HOLD_FIRST, HOLD_NEXT = 0.3, 0.12 -- 공격 스킬을 누르고 있을 때: 처음 다시 누르기까지 · 그 뒤의 간격(초)
local DRAG = Quick.DATA.drag -- 이만큼 움직이면 끌기로 본다(화면 틀의 점)
local ACT_WORDS = { pickup = "줍기", portal = "들어가기", npc = "말 걸기", spot = "살펴보기", vista = "둘러보기" } -- spot = 맵에 놓인 것 앞(퀘스트의 자리) · vista = 경관의 자리(성의 테라스 — 2026-10-18)

local Touch = {}
Touch.on = false
Touch.arranging = false

local opts = nil
local root: Frame = nil
local buttons = {} -- 누르는 단추들 { t, frame, stroke, hit, … }
local slotButtons = {} -- [칸] = 단추
local actButton = nil
local menuDot: Frame? = nil -- 「메뉴」 단추 오른쪽 위의 노란 점(받을 출석 · 업적이 있다 — 2026-10-15)
local pad = nil -- 조이스틱 { frame, knob, radius }
local chooser: Frame? = nil -- 놓을 것의 목록
local selected: number? = nil -- 배치 중에 고른 칸
local held = {} -- [칸] = { input, t, next } — 누르고 있는 칸 단추
local drag = nil -- 배치 중에 끄는 것 { from, input, start, moved, ghost }
local state = { slots = {}, cds = {}, potions = 0, act = nil :: string?, pick = false, hot = nil :: number? }

local function isPress(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1
end

local function sameFinger(input: InputObject, began: InputObject): boolean
	return input == began or (began.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)
end

local function moved(input: InputObject, began: InputObject): boolean
	return input == began or (began.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
end

local function corner(frame: Instance, radius: UDim?)
	local c = Instance.new("UICorner")
	c.CornerRadius = radius or UDim.new(1, 0)
	c.Parent = frame
end

local function ring(frame: Instance, color: Color3, thickness: number, alpha: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = alpha or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = frame
	return s
end

-- ---------- 단추의 모습 ----------
--  어두운 판 + 바깥 테두리(강조색) + 안쪽의 가는 테두리. 누르고 있으면 밝아진다. 가운데에 그림이나 글.
local function paintButton(b)
	local t = b.t
	local slotOn = t.slot and state.slots[t.slot]
	local active = slotOn and Hud.active[slotOn] == true -- 켜 둔 사출기: 테두리가 켜지고 판에 민트가 옅게 깔린다(큰 단추는 테두리가 늘 민트라 판으로 가린다)
	local main = t.kind == "big" or t.kind == "pad"
	local edge = if main then C.accent else C.lineHot
	local alpha = if main then 0 else 0.15
	if t.slot then
		if Touch.arranging then
			edge, alpha = (if selected == t.slot then C.text else C.accent), 0
		elseif state.pick or state.hot == t.slot or active then
			edge, alpha = C.accent, 0 -- 고르는 중 · 놓을 칸 · 켜 둔 사출기
		elseif not slotOn then
			alpha = 0.55 -- 빈 칸은 흐리게
		end
	elseif t.act == "interact" then
		edge, alpha = (if state.act then C.accent else C.lineHot), (if state.act then 0 else 0.4)
	end
	b.stroke.Color = edge
	b.stroke.Transparency = alpha
	b.frame.BackgroundColor3 = if b.down or active then C.accent else C.ink
	b.frame.BackgroundTransparency = if b.down then 0.55 elseif active then 0.72 elseif t.slot and not slotOn and not Touch.arranging then 0.7 else 0.4
end

local function paintAll()
	for _, b in buttons do
		paintButton(b)
	end
end

-- 칸 단추에 놓인 것을 그린다: 그림 · 남은 수 · 다시 쓰기까지 남은 시간
local function paintSlot(b)
	local what = state.slots[b.t.slot]
	Ui.setPic(b.pic, if what then Quick.pic(what) else nil)
	b.plus:show(not what)
	if what and Quick.item(what) then
		local n = if Hud.countOf then Hud.countOf(what) else 0
		b.count:set(tostring(n)) -- 소비 아이템: 가방에 든 수
		b.count:color(if n == 0 then Ui.COLOR.red else Ui.COLOR.text) -- 다 쓰면 붉은 0(2026-10-18)
		b.count:show(true)
	else
		b.count:show(false)
	end
	local cd = if what and not Quick.item(what) then state.cds[what] else nil
	local remain = if cd then cd.remain else 0
	b.veil.Visible = remain > 0
	if remain > 0 then
		b.wait:set(if remain >= 10 then tostring(math.ceil(remain)) elseif remain >= 1 then tostring(math.ceil(remain)) else ("%.1f"):format(remain))
		b.wait:show(true)
	else
		b.wait:show(false)
	end
	paintButton(b)
end

local function paintSlots()
	for _, b in slotButtons do
		paintSlot(b)
	end
end

-- 상호작용 단추: 가까이에 있는 것에 따라 글이 바뀌고 밝아진다
local function paintAct()
	if actButton then
		actButton.label:set(if state.act then ACT_WORDS[state.act] else "상호작용")
		actButton.label:color(if state.act then C.text else C.dim)
		paintButton(actButton)
	end
end

-- ---------- 배치(놓을 것의 목록) ----------
local function closeChooser()
	if chooser then
		chooser:Destroy()
		chooser = nil
	end
end

local function apply(next)
	if next then
		opts.apply(next)
	end
end

-- 놓을 것의 목록을 그 칸에 맞춰 다시 그린다
local function openChooser()
	closeChooser()
	if not Touch.arranging then
		return
	end
	local list = opts.choices() -- { { what, name } … } — 물약과 배운(쓸 수 있는) 스킬
	local cols, cell, gap, pad0 = 5, 44, 6, 12
	local rows = math.max(1, math.ceil(#list / cols))
	local w = pad0 * 2 + cols * cell + (cols - 1) * gap
	local h = 34 + rows * (cell + 16) + 44
	local holder = Stage.place(Stage.ui, "TouchChooser", "tc", 480 - w / 2, 54, w, h)
	holder.ZIndex = 170
	local panel = Ui.panel(holder, 0, 0, w, h)
	local hold = Instance.new("TextButton") -- 판을 눌러도 뒤의 것이 눌리지 않게
	hold.Text = ""
	hold.BackgroundTransparency = 1
	hold.Size = UDim2.fromScale(1, 1)
	hold.ZIndex = 1
	hold.Parent = panel
	local title = if selected then "밝게 뜬 단추에 놓을 것을 고르세요" else "바꿀 단추를 누르세요 · 끌면 자리를 바꿉니다"
	Ui.text(panel, title, pad0, 10, w - pad0 * 2, { font = "body", color = if selected then C.accent else C.text })
	for i, item in list do
		local col, row = (i - 1) % cols, math.floor((i - 1) / cols)
		local x, y = pad0 + col * (cell + gap), 34 + row * (cell + 16)
		local slot = Ui.slot(panel, x, y, cell)
		slot.frame.ZIndex = 2
		local now = selected and state.slots[selected] == item.what
		slot:setOn(now == true)
		local pic = Ui.pic(slot.frame, Quick.pic(item.what), math.floor((cell - PIC) / 2), math.floor((cell - PIC) / 2))
		pic.ZIndex = 2
		local placed = Quick.find(state.slots, item.what) ~= nil
		Ui.text(panel, item.name, x - 3, y + cell + 2, cell + 6, { align = "center", color = if placed then C.accent else C.text, outline = true }) -- 이미 어느 단추에 놓여 있는 것은 민트
		local hit = Ui.hit(slot.frame)
		hit.Activated:Connect(function()
			if selected then
				apply(Quick.place(state.slots, item.what, selected))
			end
		end)
	end
	local by = h - 38
	local bw = math.floor((w - pad0 * 2 - 8) / 2)
	Ui.button(panel, "비우기", pad0, by, bw, function()
		if selected then
			apply(Quick.clear(state.slots, selected))
		end
	end, { h = 28 }).frame.ZIndex = 2
	Ui.button(panel, "완료", pad0 + bw + 8, by, bw, function()
		Touch.arrange(false)
	end, { h = 28, main = true }).frame.ZIndex = 2
	chooser = holder
end

-- 배치를 시작한다 · 끝낸다. slot = 처음부터 고른 칸(빈 단추를 눌렀을 때)
function Touch.arrange(on: boolean, slot: number?)
	if not Touch.on then
		on = false
	end
	Touch.arranging = on
	selected = if on then slot else nil
	for i in held do
		Input.release("tslot:" .. i)
	end
	table.clear(held)
	if drag and drag.ghost then
		drag.ghost:Destroy()
	end
	drag = nil
	if on then
		openChooser()
	else
		closeChooser()
	end
	paintAll()
end

-- 화면의 그 자리에 있는 칸 단추(없으면 nil)
function Touch.slotAt(at: Vector2): number?
	for i, b in slotButtons do
		local p, size = b.frame.AbsolutePosition, b.frame.AbsoluteSize
		local c = p + size / 2
		if (at - c).Magnitude <= size.X / 2 + 4 then
			return i
		end
	end
	return nil
end

-- ---------- 그리기 ----------
local function px(v: number): number
	return math.floor(v * Stage.ratio + 0.5)
end

local function makeButton(t)
	local size = px(t.w)
	local frame = Instance.new("Frame")
	frame.Name = "T" .. t.no
	frame.Position = UDim2.fromOffset(px(t.x), px(t.y))
	frame.Size = UDim2.fromOffset(px(t.w), px(t.h))
	frame.BackgroundColor3 = C.ink
	frame.BackgroundTransparency = 0.4
	frame.BorderSizePixel = 0
	frame.Parent = root
	local round = t.w == t.h -- 동그란 단추 / 글이 적힌 길쭉한 단추(메뉴 · 채팅)
	corner(frame, if round then nil else UDim.new(0, 6))
	local stroke = ring(frame, C.accent, 2)
	-- 안쪽의 가는 테두리 한 줄(겹테)
	local inner = Instance.new("Frame")
	inner.Name = "Inner"
	inner.BackgroundTransparency = 1
	inner.Position = UDim2.fromOffset(4, 4)
	inner.Size = UDim2.new(1, -8, 1, -8)
	inner.Parent = frame
	corner(inner, if round then nil else UDim.new(0, 4))
	ring(inner, C.text, 1, 0.82)
	-- 가운데 틀: 그림 · 글은 단추의 한가운데에
	local mid = Instance.new("Frame")
	mid.Name = "Mid"
	mid.BackgroundTransparency = 1
	mid.Position = UDim2.fromScale(0.5, 0.5)
	mid.Size = UDim2.fromOffset(0, 0)
	mid.ZIndex = 2
	mid.Parent = frame
	local hit = Instance.new("TextButton")
	hit.Name = "Hit"
	hit.Text = ""
	hit.BackgroundTransparency = 1
	hit.Position = UDim2.fromOffset(-4, -4) -- 손가락이 조금 벗어나도 눌리게
	hit.Size = UDim2.new(1, 8, 1, 8)
	hit.ZIndex = 9
	hit.Parent = frame
	local b = { t = t, frame = frame, stroke = stroke, hit = hit, mid = mid, size = size, down = false }
	table.insert(buttons, b)
	return b
end

-- 칸 단추: 그림(큰 단추는 두 배) · 빈 칸의 "+" · 남은 수 · 다시 쓰기 덮개와 남은 초
local function makeSlot(t)
	local b = makeButton(t)
	local k = if b.size >= 64 then 2 else 1
	local side = PIC * k
	b.pic = Ui.pic(b.mid, nil, -side / 2, -side / 2)
	b.pic.Size = UDim2.fromOffset(side, side)
	b.plus = Ui.text(b.mid, "+", -20, -7, 40, { font = "body", align = "center", color = C.dim })
	b.count = Ui.text(b.mid, "", -side / 2, side / 2 - 10, side + 4, { align = "right", outline = true, z = 6 })
	local veil = Instance.new("Frame")
	veil.Name = "Veil"
	veil.BackgroundColor3 = C.ink
	veil.BackgroundTransparency = 0.3
	veil.BorderSizePixel = 0
	veil.Size = UDim2.fromScale(1, 1)
	veil.ZIndex = 4
	veil.Visible = false
	veil.Parent = b.frame
	corner(veil)
	b.veil = veil
	b.wait = Ui.text(b.mid, "", -30, -7, 60, { font = "body", align = "center", outline = true, z = 7 })
	b.wait.label.Frame.ZIndex = 7
	slotButtons[t.slot] = b

	local i = t.slot
	b.hit.InputBegan:Connect(function(input)
		if not isPress(input) then
			return
		end
		local what = state.slots[i]
		if Touch.arranging then
			-- 배치 중: 누르면 그 칸을 고르고, 끌면 자리를 바꾼다
			selected = i
			drag = { from = i, input = input, start = Vector2.new(input.Position.X, input.Position.Y), moved = false, ghost = nil }
			openChooser()
			paintAll()
		elseif state.pick then
			-- 스킬 창 · 가방에서 놓을 것을 골라 둔 채다: 이 칸에 놓는다(ui/quickEdit.luau)
			if Hud.onSlotClick then
				Hud.onSlotClick(i)
			end
		elseif not what then
			Touch.arrange(true, i) -- 빈 단추: 놓을 것의 목록을 띄운다
		else
			b.down = true
			Input.press("tslot:" .. i)
			held[i] = { input = input, t = 0, next = HOLD_FIRST }
			paintButton(b)
		end
	end)
	return b
end

local function makeAct(t)
	local b = makeButton(t)
	if t.act == "jump" then
		b.label = Ui.text(b.mid, "점프", -40, -7, 80, { font = "body", align = "center", outline = true })
	elseif t.act == "interact" then
		b.label = Ui.text(b.mid, "상호작용", -40, -6, 80, { align = "center", outline = true })
		actButton = b
	elseif t.act == "menu" then
		b.label = Ui.text(b.mid, "메뉴", -40, -7, 80, { font = "body", align = "center", outline = true })
		local dot = Ui.box(b.mid, math.floor(t.w / 2) - 8, -math.floor(t.h / 2) + 2, 6, 6, Ui.COLOR.ink)
		Ui.box(dot, 1, 1, 4, 4, Ui.COLOR.gold)
		dot.Name = "Dot"
		dot.ZIndex = 12
		dot.Visible = false
		menuDot = dot
	end
	local finger: InputObject? = nil
	b.hit.InputBegan:Connect(function(input)
		if not isPress(input) or finger then
			return
		end
		if Touch.arranging then
			Touch.arrange(false) -- 다른 단추를 누르면 배치를 끝낸다
		end
		finger = input
		b.down = true
		paintButton(b)
		if t.act == "jump" then
			Input.press("jump")
		elseif t.act == "interact" then
			opts.onAct(true)
		elseif t.act == "menu" then
			opts.onMenu()
		end
	end)
	b.release = function(input: InputObject)
		if finger and sameFinger(input, finger) then
			finger = nil
			b.down = false
			paintButton(b)
			if t.act == "jump" then
				Input.release("jump")
			elseif t.act == "interact" then
				opts.onAct(false)
			end
		end
	end
	return b
end

-- 조이스틱: 바깥 원(자리는 그대로) + 가운데 손잡이(손가락을 따라 원 안에서 움직인다)
local function makePad(t)
	local size = px(t.w)
	local base = Instance.new("Frame")
	base.Name = "Pad"
	base.Position = UDim2.fromOffset(px(t.x), px(t.y))
	base.Size = UDim2.fromOffset(size, size)
	base.BackgroundColor3 = C.ink
	base.BackgroundTransparency = 0.55
	base.BorderSizePixel = 0
	base.Parent = root
	corner(base)
	local stroke = ring(base, C.accent, 2, 0.15)
	local inner = Instance.new("Frame")
	inner.Name = "Inner"
	inner.BackgroundTransparency = 1
	inner.Position = UDim2.fromOffset(5, 5)
	inner.Size = UDim2.new(1, -10, 1, -10)
	inner.Parent = base
	corner(inner)
	ring(inner, C.text, 1, 0.85)
	-- 좌우의 작은 세모(어느 쪽으로 미는지): 가는 막대 셋으로 그린다(글꼴에 화살표 글자가 없다)
	for _, side in { -1, 1 } do
		for k = 0, 2 do
			local bar = Instance.new("Frame")
			bar.Name = "Arrow"
			bar.BackgroundColor3 = C.text
			bar.BackgroundTransparency = 0.6
			bar.BorderSizePixel = 0
			bar.Size = UDim2.fromOffset(2, 2 + k * 4)
			bar.Position = UDim2.fromOffset(math.floor(size / 2) + side * (math.floor(size * 0.4) - k * 2) - 1, math.floor(size / 2) - 1 - k * 2)
			bar.Parent = base
		end
	end
	local ks = math.floor(size * 0.44)
	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.fromScale(0.5, 0.5)
	knob.Size = UDim2.fromOffset(ks, ks)
	knob.BackgroundColor3 = C.accent
	knob.BackgroundTransparency = 0.45
	knob.BorderSizePixel = 0
	knob.ZIndex = 3
	knob.Parent = base
	corner(knob)
	ring(knob, C.text, 1, 0.3)
	local hit = Instance.new("TextButton")
	hit.Name = "Hit"
	hit.Text = ""
	hit.BackgroundTransparency = 1
	hit.Position = UDim2.fromScale(-0.2, -0.2) -- 원보다 조금 넓게 받는다
	hit.Size = UDim2.fromScale(1.4, 1.4)
	hit.ZIndex = 9
	hit.Parent = base
	pad = { frame = base, knob = knob, stroke = stroke, finger = nil :: InputObject? }

	local function set(action: string, on: boolean)
		if on then
			Input.press(action)
		else
			Input.release(action)
		end
	end
	local function aim(pos: Vector3)
		local center = base.AbsolutePosition + base.AbsoluteSize / 2
		local radius = base.AbsoluteSize.X / 2
		local v = Vector2.new(pos.X - center.X, pos.Y - center.Y)
		local reach = radius * 0.62 -- 손잡이가 나갈 수 있는 끝
		if v.Magnitude > reach then
			v = v.Unit * reach
		end
		local s = Stage.uiScale
		knob.Position = UDim2.new(0.5, v.X / s, 0.5, v.Y / s)
		set("left", v.X < -radius * 0.2)
		set("right", v.X > radius * 0.2)
		set("down", v.Y > radius * 0.42) -- 아래로 민 채 「점프」를 누르면 발판에서 내려온다(하단 점프 — sim/physics.luau)
		-- 위로 밀면 사다리만 오른다("climb" — 문 · 주민은 그대로 상호작용 단추: 사용자 2026-10-08 「위로 미는 것은 아무 일도 없다」).
		--  2026-10-17: 사다리를 넣으며 폰의 오르기를 빠뜨렸었다(조이스틱으로는 사다리를 탈 수 없었다)
		set("climb", v.Y < -radius * 0.42)
	end
	pad.stop = function()
		pad.finger = nil
		knob.Position = UDim2.fromScale(0.5, 0.5)
		knob.BackgroundTransparency = 0.45
		for _, a in { "left", "right", "down", "climb" } do
			Input.release(a)
		end
	end
	hit.InputBegan:Connect(function(input)
		if isPress(input) and not pad.finger then
			pad.finger = input
			knob.BackgroundTransparency = 0.2
			aim(input.Position)
		end
	end)
	pad.aim = aim
end

local function build()
	for _, c in root:GetChildren() do
		c:Destroy()
	end
	table.clear(buttons)
	table.clear(slotButtons)
	actButton, pad = nil, nil
	for _, t in UI.touch do
		if t.kind == "pad" then
			makePad(t)
		elseif t.slot then
			makeSlot(t)
		elseif t.act then
			makeAct(t)
		end
	end
	-- 스킬 창 · 가방에서 놓을 것을 골랐을 때의 안내(아래 가운데, 체력 덩어리 위)
	local hint = Stage.place(root, "PickHint", "tc", 480 - 150, 50, 300, 16)
	Touch.hint = Ui.text(hint, "놓을 단추를 누르세요", 0, 0, 300, { align = "center", color = C.accent, outline = true })
	Touch.hint:show(false)
	paintSlots()
	paintAct()
	paintAll()
end

-- ---------- 밖에서 알려 주는 것 ----------
-- 칸들에 놓인 것(PC의 퀵슬롯과 같은 열두 칸)
-- 단추 하나의 틀(튜토리얼의 꿈이 그 단추를 반짝이게 한다 — 2026-10-14): name = "pad"(조이스틱) · "jump" · "interact" · "menu" · "slot"(arg = 칸 번호)
function Touch.frameOf(name: string, arg: number?): GuiObject?
	if name == "pad" then
		return if pad then pad.frame else nil
	end
	for _, b in buttons do
		if (name == "slot" and b.t.slot == arg) or (name ~= "slot" and b.t.act == name) then
			return b.frame
		end
	end
	return nil
end

function Touch.setSlots(slots)
	state.slots = slots or {}
	if root then
		paintSlots()
		if Touch.arranging then
			openChooser()
		end
	end
end

-- 기술을 다시 쓰기까지 남은 시간(초). 화면마다 불러도 된다(보이는 글이 바뀔 때만 고쳐 그린다)
function Touch.setCooldown(id: string, remain: number, total: number)
	remain = math.max(0, remain)
	local cd = state.cds[id]
	if not cd then
		cd = { remain = 0, shown = "" }
		state.cds[id] = cd
	end
	cd.remain = remain
	local shown = if remain <= 0 then "" elseif remain >= 1 then tostring(math.ceil(remain)) else ("%.1f"):format(remain)
	if shown ~= cd.shown then
		cd.shown = shown
		local i = Quick.find(state.slots, id)
		if i and slotButtons[i] then
			paintSlot(slotButtons[i])
		end
	end
end

-- 단추들의 모습을 다시 그린다(켜 둔 사출기가 바뀌었을 때 — Hud.active)
function Touch.refresh()
	paintAll()
end

-- 가방이 바뀌었다: 소비 아이템이 놓인 단추의 숫자를 다시 적는다
function Touch.setCounts()
	for i, b in slotButtons do
		local what = state.slots[i]
		if what and Quick.item(what) then
			paintSlot(b)
		end
	end
end

-- 상호작용 단추가 할 일: "pickup"(떨어진 물건) · "portal"(문) · "npc"(주민) · nil(가까이에 아무것도 없다)
-- 「메뉴」 단추의 점(PC의 「메뉴」 단추와 같은 노란 점 — 받을 출석 칸 · 업적 보상이 있을 때)
function Touch.markMenu(on: boolean)
	if menuDot then
		menuDot.Visible = on
	end
end

function Touch.setAct(kind: string?)
	if state.act ~= kind then
		state.act = kind
		paintAct()
	end
end

function Touch.init(options)
	opts = options
	root = Stage.group(Stage.ui, "Touch", 120)
	root.Visible = false
	Touch.root = root
	build()
	Stage.onResize(function()
		-- 단추를 새로 짓기 전에 누르고 있던 것을 놓는다(2026-10-18 검토: 화면을 돌리면 막대 · 뛰기 · 상호작용이 눌린 채 남아 캐릭터가 계속 걸었다)
		if pad and pad.stop then
			pad.stop()
		end
		Input.release("jump")
		opts.onAct(false)
		for i in held do
			Input.release("tslot:" .. i)
		end
		table.clear(held)
		Touch.arrange(false)
		build()
	end)

	-- 스킬 창 · 가방에서 고르거나 끌 때: 칸 단추가 PC의 칸 노릇을 한다(ui/quickEdit.luau · hud.luau)
	Hud.touchSlotAt = Touch.slotAt
	Hud.touchPick = function(on: boolean)
		state.pick = on
		if Touch.hint then
			Touch.hint:show(on and Touch.on)
		end
		paintAll()
	end
	Hud.touchHot = function(i: number?)
		state.hot = i
		paintAll()
	end

	UserInputService.InputChanged:Connect(function(input)
		if pad and pad.finger and moved(input, pad.finger) then
			pad.aim(input.Position)
		end
		local d = drag
		if d and moved(input, d.input) then
			local at = Vector2.new(input.Position.X, input.Position.Y)
			if not d.moved and (at - d.start).Magnitude > DRAG * Stage.uiScale and state.slots[d.from] then
				d.moved = true
				local ghost = Ui.group(Stage.ui, 0, 0, PIC + 8, PIC + 8, "TouchGhost")
				ghost.ZIndex = 400
				Ui.slot(ghost, 0, 0, PIC + 8):setOn(true)
				Ui.pic(ghost, Quick.pic(state.slots[d.from]), 4, 4).ZIndex = 2
				d.ghost = ghost
			end
			if d.moved and d.ghost then
				local origin = Stage.ui.AbsolutePosition
				local half = (PIC + 8) / 2
				d.ghost.Position = UDim2.fromOffset(math.floor((at.X - origin.X) / Stage.uiScale - half + 0.5), math.floor((at.Y - origin.Y) / Stage.uiScale - half + 0.5))
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if not isPress(input) then
			return
		end
		if pad and pad.finger and sameFinger(input, pad.finger) then
			pad.stop()
		end
		for i, h in held do
			if sameFinger(input, h.input) then
				held[i] = nil
				Input.release("tslot:" .. i)
				local b = slotButtons[i]
				if b then
					b.down = false
					paintButton(b)
				end
			end
		end
		for _, b in buttons do
			if b.release then
				b.release(input)
			end
		end
		local d = drag
		if d and sameFinger(input, d.input) then
			drag = nil
			if d.ghost then
				d.ghost:Destroy()
			end
			if d.moved then
				-- 다른 칸 단추 위에 놓았다: 자리를 바꾼다
				local j = Touch.slotAt(Vector2.new(input.Position.X, input.Position.Y))
				local what = state.slots[d.from]
				if j and j ~= d.from and what then
					selected = j
					apply(Quick.place(state.slots, what, j))
				end
			end
		end
	end)
	-- 누르고 있는 공격 스킬은 이어서 쓴다(손가락으로 연타하지 않아도 되게 — 물약 · 그 밖의 스킬은 한 번만)
	RunService.Heartbeat:Connect(function(dt)
		for i, h in held do
			h.t += dt
			if h.t >= h.next then
				h.next = h.t + HOLD_NEXT
				local what = state.slots[i]
				if what and not Quick.item(what) and opts.repeats(what) then
					Input.release("tslot:" .. i)
					Input.press("tslot:" .. i)
				end
			end
		end
	end)

	local function decide()
		local forced = Stage.gui:GetAttribute("Touch")
		local on = forced == true or (forced == nil and UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)
		Touch.on = on
		root.Visible = on
		if not on then
			Touch.arrange(false)
			if pad then
				pad.stop()
			end
		end
		if opts.onToggle then
			opts.onToggle(on)
		end
	end
	Stage.gui:GetAttributeChangedSignal("Touch"):Connect(decide)
	decide()
end

return Touch

end
MODULES['Client/lune/tutorial'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 튜토리얼 「달빛 꿈」의 화면(2026-10-14) — 화면 위 가운데의 미션 판과, 화면만 아는 미션(걷기 · 뛰기 · 두 번 뛰기 · 내려가기 · 말 걸기 · 기술 · 창)이 끝났는지 보는 일.
--  사용자: "처음 게임을 시작하고 별도의 스타트맵을만들어서 거기서 조작을 알려주는 튜토리얼이 필요해 메이플스토리의 테라블링크를 예로들면 되겠다"
--  판: 첫 줄 = 「달빛 꿈 3/13 · 두 번 뛰기」(노랑) + 샛별의 말(흐린 글씨) · 둘째 줄 = 지금 누를 것(흰 글씨 — PC는 그 사람의 키 이름, 스마트폰은 단추 이름).
--  미션을 깨면 판의 오른쪽에 「완료!」(민트)가 잠깐 뜨고 다음 미션으로 바뀐다. 이 계정이 꿈을 한 번 끝냈으면 판 오른쪽에 「건너뛰기」 단추.
--  셈(무엇이 끝났나 · 글)은 shared/lune/sim/tutorial.luau, 진행의 진실은 서버가 갖는다(Net "Tut" — 화면은 "n째를 끝냈다"고만 알린다).
--  둘째 판(사용자: "인벤토리 열기이면 가방버튼이 반짝 반짝 빛나서 어디를 누르면 되는지 알려줘야하는거고 능력치,스킬도 마찬가지 모바일은 모바일 버튼 기준으로"):
--   미션마다 눌러야 할 단추 위에 민트 고리가 깜빡인다(point — design/tutorial.js). 창을 여는 미션은 창이 열리면 그 안의 「자동으로 찍기 · 추천대로 찍기」로 옮겨 가고,
--   스마트폰은 「메뉴」 단추 → 열린 메뉴의 그 줄 → 창 안의 단추 차례로 짚는다. 단추를 찾는 일은 boot.luau가 준다(c.find(이름) → 그 단추의 틀).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Tutorial = require(ReplicatedStorage.shared.lune.sim.tutorial)
local Net = require(ReplicatedStorage.shared.lune.net.net)
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)
local Music = require(script.Parent.music)

local C = Ui.COLOR
local M = Ui.M
local D = Tutorial.DATA
local P = D.panel

local View = {}
View.talked = nil :: string? -- 꿈에서 말을 끝낸 주민(Talk가 알려 준다)
View.dropped = false -- 얇은 발판을 내려왔다(↓ + 뛰기 — boot.luau가 알려 준다)
View.cast = false -- 첫 사냥기를 썼다(boot.luau의 trySkill)
View.startX = nil :: number? -- 꿈에 들어왔을 때 선 자리(걷기 미션)
View.onSkip = nil :: (() -> ())? -- 「건너뛰기」를 눌렀다(boot.luau가 서버에 묻고 장면을 바꾼다)

local root: Frame
local panel: Frame
local head, say, line, doneText
local skipBtn
local pending = false -- 서버에 "끝냈다"를 보내고 대답을 기다리는 중
local flash = 0 -- 「완료!」가 남은 시간
local shownStep = -1
local ring: Frame -- 반짝이는 고리(눌러야 할 단추 위)
local clock = 0

function View.init(parent: Instance)
	root = Stage.group(parent, "Tutorial", 90)
	root.Visible = false
	local h = 8 + M.bodyLine + M.smallLine + 8
	panel = Ui.panel(root, 0, 0, P.w, h)
	head = Ui.text(panel, "", 12, 8, 200, { font = "body", color = C.gold })
	say = Ui.text(panel, "", 0, 10, P.w - 24, { color = C.dim })
	line = Ui.text(panel, "", 12, 8 + M.bodyLine, P.w - 24, { color = C.text })
	doneText = Ui.text(panel, D.words.done, P.w - 60, 8, 48, { font = "body", color = C.accent, align = "right" })
	doneText:show(false)
	skipBtn = Ui.button(root, D.words.skip, 0, 0, 72, function()
		if View.onSkip then
			View.onSkip()
		end
	end, { h = 22 })
	skipBtn.frame.Visible = false
	ring = Instance.new("Frame")
	ring.Name = "TutRing"
	ring.BackgroundColor3 = C.accent
	ring.BackgroundTransparency = 0.82
	ring.BorderSizePixel = 0
	ring.ZIndex = 250
	ring.Visible = false
	local stroke = Instance.new("UIStroke")
	stroke.Color = C.accent
	stroke.Thickness = 2
	stroke.Parent = ring
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 5)
	corner.Parent = ring
	ring.Parent = parent
end

-- 이 미션에서 반짝일 단추: c.find(이름) → 그 단추의 틀(보이는 것만)
local function targetOf(def, c): GuiObject?
	local point = def.point
	if not point or not c.find then
		return nil
	end
	local spec = if c.touch then point.touch else point.pc
	if not spec then
		return nil
	end
	local function shown(name: string): GuiObject?
		local f = c.find(name)
		if f and f.Parent and f.Visible and f.AbsoluteSize.X > 0 then
			return f
		end
		return nil
	end
	local win = string.match(spec, "^menu:(.+)$")
	if win then
		if c.windows and c.windows[win] then
			return if point.inside then shown("inside:" .. win) else nil -- 창이 열렸다: 그 안의 단추로
		end
		if c.touch then
			return shown("touchmenu:" .. win) or shown("touch:menu") -- 스마트폰: 「메뉴」 → 그 줄
		end
		return shown("menu:" .. win)
	end
	return shown((if c.touch then "touch:" else "pc:") .. spec)
end

-- 고리를 그 단추 위에 놓는다(화면 틀의 점으로 바꿔서 — 단추가 움직여도 따라간다)
local function drawRing(target: GuiObject?, dt: number)
	if not target then
		ring.Visible = false
		return
	end
	clock += dt
	local parent = ring.Parent :: GuiObject
	local scale = parent.AbsoluteSize.X / math.max(1, Stage.uiW)
	local pos = (target.AbsolutePosition - parent.AbsolutePosition) / scale
	local size = target.AbsoluteSize / scale
	local grow = 3 + math.floor((math.sin(clock * 7) + 1) * 1.5) -- 숨 쉬듯 커졌다 작아진다
	ring.Position = UDim2.fromOffset(pos.X - grow, pos.Y - grow)
	ring.Size = UDim2.fromOffset(size.X + grow * 2, size.Y + grow * 2)
	ring.Visible = math.floor(clock * 3) % 3 ~= 2 -- 깜빡인다
end

local function place()
	local x = math.floor((Stage.uiW - P.w) / 2)
	root.Position = UDim2.fromOffset(x, P.top)
	root.Size = UDim2.fromOffset(P.w + 80, 60)
	skipBtn.frame.Position = UDim2.fromOffset(P.w + 6, 4)
end

-- 다른 캐릭터로 들어왔다: 앞 캐릭터의 꿈에서 쌓인 것(내려옴 · 말을 끝냄 · 보낸 「끝냈다」)을 지운다(2026-10-18 검토 — 둘 다 꿈에 있으면 새 캐릭터의 미션이 바로 끝났다)
function View.reset()
	View.startX, View.talked, View.dropped, View.cast, pending, shownStep = nil, nil, false, false, false, -1
end

-- 매 화면. c = { tut(서버가 보낸 진행), skip(건너뛸 수 있나), scene(장면 이름표), zones(장면의 tut), body, touch, key(하는 일 → 키 이름), skill(첫 사냥기 「키 · 이름」), potion(물약 칸의 키), windows({ [id] = true }), dt, find(이름) → 반짝일 단추 }
function View.update(c)
	local t = c.tut
	local on = c.scene == Tutorial.SCENE and t ~= nil and not t.done
	root.Visible = on
	if not on then
		View.startX, View.talked, View.dropped, View.cast, pending, shownStep = nil, nil, false, false, false, -1
		ring.Visible = false
		return
	end
	place()
	if View.startX == nil and c.body then
		View.startX = c.body.x
	end
	local def = Tutorial.current(t)
	if not def then
		ring.Visible = false
		return
	end
	drawRing(targetOf(def, c), c.dt or 0)
	-- 미션이 바뀌었다: 「완료!」를 잠깐 띄운다(처음 들어왔을 때는 띄우지 않는다)
	if shownStep ~= t.step then
		if shownStep > 0 then
			flash = P.done
			Music.sfx("success") -- 미션을 깼다(퀘스트 완료와 같은 소리)
		end
		shownStep = t.step
		View.cast = false -- 「기술 쓰기」는 그 미션의 차례에 쓴 것만 센다
	end
	flash = math.max(0, flash - (c.dt or 0))
	doneText:show(flash > 0)
	-- 글
	local count = Tutorial.count(t)
	local headText = Tutorial.head(t) .. " · " .. def.title .. (if count then " " .. count else "")
	head:set(headText)
	local hw = Ui.measure(headText, "body")
	say:move(12 + hw + 10, 10)
	say:set(def.say)
	line:set(Tutorial.line(def, c.touch, c.key, c.skill, c.potion))
	skipBtn.frame.Visible = c.skip == true
	-- 화면만 아는 미션이 끝났는가 → 서버에 알린다(대답이 오면 서버가 보낸 내 상태로 판이 바뀐다)
	if pending or not Tutorial.CLIENT[Tutorial.kind(def)] or not c.body then
		return
	end
	local s = {
		walked = math.abs(c.body.x - (View.startX or c.body.x)),
		zone = Tutorial.zoneAt(c.zones, c.body.x, c.body.y, c.body.ground),
		drop = View.dropped,
		talked = View.talked,
		skill = View.cast,
		windows = c.windows,
	}
	if Tutorial.met(def, s) then
		pending = true
		local step = t.step
		task.spawn(function()
			pcall(Net.Invoke, "Tut", "done", step)
			pending = false
		end)
	end
end

return View

end
MODULES['Client/lune/ui/achieveWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 업적 창 — 메뉴 → 「업적」(2026-10-15 · 사용자: "출석보상, 업적 만들어야합니다" — 목록 · 점수 · 등급 · 보상은 제 제안).
--  모양은 공방 시험 탭의 js/lune/ui/paint.js(paintAchieve)와 같다: 「업적 점수 n」 · 등급 · 다음 등급까지의 띠 · 탭 여섯 ·
--   줄마다 이름과 등급의 꼬리표 / 할 일 / 진행 띠와 n/N · 오른쪽에 「받기」(해냈으면) · 「받음」 · 보상(작은 그림 + 수) · 아래 「모두 받기」.
--  줄의 차례: 받을 것 → 하는 중 → 받은 것. 앞 단계를 해내지 않은 단계는 보이지 않고, 숨김 업적은 해낼 때까지 「???」.
--  받는 것은 서버가 한다(ctx.achDo → Achieve "claim" · "all"). 셈은 shared/lune/sim/achieve.luau. 화면 오른쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Achieve = require(lune.sim.achieve)
local Gift = require(lune.sim.gift)
local Items = require(lune.sim.items)
local Format = require(lune.ui.format)
local Layout = require(lune.ui.layout)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local S = Layout.ACHIEVE
local D = Achieve.DATA
local W = Achieve.WORDS

local AchieveWindow = {}
AchieveWindow.ORDER = { [2] = 0, [1] = 1, [3] = 2 } -- 받을 것 · 하는 중 · 받은 것
local TONE = { normal = "dim", rare = "accent", epic = "gold" }

-- 한 탭에 업적이 가장 많은 수(줄을 그만큼 만들어 둔다)
local MOST = 0
do
	local per = {}
	for _, def in D.list do
		per[def.tab] = (per[def.tab] or 0) + 1
		MOST = math.max(MOST, per[def.tab])
	end
end

function AchieveWindow.size(): (number, number)
	return S.w, S.listY + S.rows * S.row + S.footY + Ui.M.button
end

-- 그 탭의 줄들(보이는 것만 · 받을 것 → 하는 중 → 받은 것 · 같은 것끼리는 목록의 차례)
function AchieveWindow.rows(view, tab: string)
	local out = {}
	for _, def in D.list do
		local r = view and view.rows[def.id]
		if def.tab == tab and r and r.st > 0 then
			table.insert(out, { def = def, have = r.have, need = r.need, st = r.st })
		end
	end
	table.sort(out, function(a, b)
		local oa, ob = AchieveWindow.ORDER[a.st], AchieveWindow.ORDER[b.st]
		if oa ~= ob then
			return oa < ob
		end
		return a.def.order < b.def.order
	end)
	return out
end

-- 점수 → 등급의 이름 · 다음 등급까지(남은 점수) · 띠의 비율
function AchieveWindow.gradeOf(score: number): (string?, string?, number, number)
	local now, nextOne = Achieve.grade(score)
	local prev = 0
	for _, g in D.grades do
		if g.name == now then
			prev = g.from
		end
	end
	if not nextOne then
		return now, nil, 0, 1
	end
	return now, nextOne.name, nextOne.from - score, (score - prev) / (nextOne.from - prev)
end

-- 보상의 작은 그림들 { { icon, num } } (둘까지 · 물약은 그 캐릭터의 레벨의 것)
function AchieveWindow.rewards(r, level: number)
	local out = {}
	for _, k in { "dust", "money", "scroll", "potion" } do
		if (r[k] or 0) > 0 and #out < 2 then
			local icon = if k == "money" then "coin" elseif k == "potion" then "potion_s" else k
			if k == "potion" then
				local g = Items.goods(Items.potionFor(level).id)
				icon = if g and g.icon then g.icon else icon
			end
			table.insert(out, { icon = icon, num = Format.short(r[k]) })
		end
	end
	return out
end

function AchieveWindow.build(body: Frame, ctx, w: number, _h: number)
	local view = {}
	local tab = 1
	local note, noteTone = nil, nil
	local waiting = false -- 답을 기다리는 중(두 번 눌러 두 번 가지 않게 — 2026-10-18 검토: 둘째의 「이미 받았다」가 첫째의 성공 글을 덮었다)
	local score = Ui.text(body, "", 0, 0, w, { font = "body", color = C.gold })
	local grade = Ui.text(body, "", 0, 2, w, { align = "right", color = C.accent })
	local gradeBar = Ui.bar(body, 0, S.barY, w, S.barH, C.accent, C.panel2)
	local nextText = Ui.text(body, "", 0, S.barY + S.barH + 3, w, { align = "right", color = C.dim })
	local tabs = {}
	local tx = 0
	local list: ScrollingFrame
	for i, t in D.tabs do
		local item = Ui.tab(body, t[2], tx, S.tabY, function()
			if tab ~= i then
				tab = i
				note = nil
				list.CanvasPosition = Vector2.zero -- 다른 탭은 맨 위부터
				view.refresh()
			end
		end)
		item.frame.Name = "Tab_" .. t[1]
		tabs[i] = item
		tx += item.width + 14
	end
	Ui.line(body, 0, S.listY - 6, w)
	-- 줄들: 스크롤 틀(rows개가 보이고 나머지는 민다 — 마우스 휠 · 손가락으로 밀기). 막대는 판의 오른쪽 여백에
	list = Ui.scroll(body, 0, S.listY, w + 10, S.rows * S.row, MOST * S.row, S.scrollW)
	list.Name = "List"
	local textW = w - S.sideW - 8
	local rowsUi = {}
	for i = 1, MOST do
		local f = Ui.group(list, 0, (i - 1) * S.row, w, S.row, "Row" .. i)
		local r = { frame = f }
		r.name = Ui.text(f, "", 0, 2, textW - 40, { font = "body" })
		r.tag = Ui.text(f, "", 0, 4, 60, {})
		r.text = Ui.text(f, "", 0, 19, textW, { color = C.dim })
		r.bar = Ui.bar(f, 0, 34, S.barW, 4, C.accent, C.panel2)
		r.count = Ui.text(f, "", S.barW + 6, 31, 80, { color = C.dim })
		r.taken = Ui.text(f, W.taken, 0, 8, w, { align = "right", color = C.green })
		r.take = Ui.button(f, W.take, w - S.btnW, 2, S.btnW, function()
			if r.id and not waiting then
				waiting = true
				local res = ctx.achDo("claim", r.id)
				waiting = false
				note, noteTone = nil, nil
				if res and res.why then
					note, noteTone = res.why, C.red
				elseif res and (res.got or 0) > 0 then
					note, noteTone = W.got, C.green
				end
				view.refresh()
			end
		end, { main = true, h = 22 })
		r.take.frame.Name = "Take"
		r.gifts = {}
		for g = 1, 2 do
			r.gifts[g] = { icon = Ui.smallIcon(f, "coin", 0, 27), num = Ui.text(f, "", 0, 31, 60, { color = C.gold }) }
		end
		rowsUi[i] = r
	end
	local fy = S.listY + S.rows * S.row + S.footY
	Ui.line(body, 0, fy - 5, w)
	local all = Ui.button(body, W.takeAll, 0, fy, S.allW, function()
		if waiting then
			return
		end
		waiting = true
		local res = ctx.achDo("all")
		waiting = false
		note, noteTone = nil, nil
		if res and res.why then
			note, noteTone = W.full, C.red
		elseif res and (res.got or 0) > 0 then
			note, noteTone = W.got, C.green
		end
		view.refresh()
	end, { main = true })
	all.frame.Name = "TakeAll"
	local noteText = Ui.text(body, "", S.allW + 10, fy + math.floor((Ui.M.button - Ui.M.small) / 2), w - S.allW - 10, { color = C.dim })

	function view.refresh()
		local v = ctx.ach()
		local me = ctx.me and ctx.me()
		local level = if me then me.level else 1
		local points = if v then v.score else 0
		score:set(Format.fill(W.score, { n = points }))
		local now, nextName, left, ratio = AchieveWindow.gradeOf(points)
		grade:set(if now then Format.fill(W.grade, { name = now }) else W.noGrade)
		grade:color(if now then C.accent else C.dim)
		gradeBar:set(ratio)
		nextText:set(if nextName then Format.fill(W.next, { name = nextName, n = left }) else W.top)
		for i, t in tabs do
			t:setOn(i == tab)
		end
		local rows = AchieveWindow.rows(v, D.tabs[tab][1])
		local ready = 0
		if v then
			for _, r in v.rows do
				if r.st == 2 then
					ready += 1
				end
			end
		end
		for i, ru in rowsUi do
			local r = rows[i]
			ru.frame.Visible = r ~= nil
			ru.id = r and r.def.id
			if r then
				local hide = r.def.hidden and r.st < 2
				ru.name:set(if hide then W.hidden else r.def.name)
				ru.name:color(if r.st == 3 then C.dim else C.text)
				local nw = Ui.measure(if hide then W.hidden else r.def.name, "body")
				ru.tag:set(D.gradeName[r.def.grade])
				ru.tag:color(C[TONE[r.def.grade]] or C.dim)
				ru.tag:move(nw + 6, 4)
				ru.text:set(if hide then W.hiddenText else r.def.text)
				ru.bar:set(if r.need > 0 then r.have / r.need else 0)
				ru.bar:setColor(if r.st >= 2 then C.green else C.accent)
				ru.count:set(("%s/%s"):format(Format.comma(r.have), Format.comma(r.need)))
				ru.count:color(if r.st >= 2 then C.green else C.dim)
				ru.take.frame.Visible = r.st == 2
				ru.taken:show(r.st == 3)
				-- 보상: 오른쪽 끝에서부터(그림 + 수)
				local gifts = AchieveWindow.rewards(r.def.reward, level)
				local ix = w
				for g = 2, 1, -1 do
					local gu = ru.gifts[g]
					local it = gifts[g]
					gu.icon.Visible = it ~= nil
					gu.num:show(it ~= nil)
					if it then
						gu.num:set(it.num)
						gu.num:color(if r.st == 3 then C.dim else C.gold)
						local tw = Ui.measure(it.num)
						gu.num:move(ix - tw, 31)
						ix -= tw + 2
						Ui.setWorldIcon(gu.icon, it.icon)
						gu.icon.Position = UDim2.fromOffset(ix - 16, 27)
						ix -= 22
					end
				end
			end
		end
		list.CanvasSize = UDim2.fromOffset(0, math.max(S.rows, #rows) * S.row)
		list.ScrollingEnabled = #rows > S.rows
		list.ScrollBarThickness = if #rows > S.rows then S.scrollW else 0
		all:setEnabled(ready > 0)
		noteText:set(note or "")
		noteText:color(noteTone or C.dim)
	end
	if ctx.achFetch then
		ctx.achFetch() -- 열 때 서버의 지금 것을 받아 온다(받으면 다시 그린다)
	end
	view.refresh()
	return view
end

return AchieveWindow

end
MODULES['Client/lune/ui/adminWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 관리 창 — 관리자(게임의 주인)에게만 보이는 시험용 창. 「메뉴」 안의 「관리」로 연다.
--  사용자 2026-10-11: "저만 쓸수있는 어드민용 탭 만들어주세요 다른 유저들에게는 보이지않고, 어드민만 보이는 어드민관리탭 … 경험치 배율증가, 레벨 조정, 아이템발급 등등
--   여러 테스트용 편의 기능 … 누군가 해킹같은거해서 사용도 못해야하고 오직 어드민만 사용할수있어야합니다."
--  이 창은 단추를 누르면 서버에 「Admin」 패킷으로 부탁만 한다. 들어줄지는 서버가 보낸 사람의 계정 번호로 정한다(server/lune/modules/admin.luau) —
--   관리자가 아닌 사람이 이 창을 억지로 띄워 단추를 눌러도 서버는 아무 일도 하지 않는다. 그래서 창을 감추는 것(메뉴에 「관리」가 안 보인다)은 보기 좋으라고 하는 것이다.
--  탭 넷: 성장(경험치 배율 · 레벨 · 차수 · 스킬과 능력치 · 퀘스트) · 아이템(달돈 · 달가루 · 장비 한 벌 · 소비와 기타 아이템 · 경매장의 시험 물건) · 이동(맵을 골라 옮겨 간다) · 전투(체력 · 무적 · 피해 배율)
--  아래 줄에 서버의 대답이 뜬다(「Lv.30 · 1차」 · 「없는 단계다」).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local SCENES = require(lune.data["scenes.generated"])
local WORLDMAP = require(lune.data["worldmap.generated"])
local ITEMS = require(lune.data["items.generated"])
local N = require(lune.config.numbers)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR

local AdminWindow = {}
AdminWindow.W, AdminWindow.H = 356, 300
AdminWindow.TABS = { { id = "grow", name = "성장" }, { id = "item", name = "아이템" }, { id = "move", name = "이동" }, { id = "fight", name = "전투" } }
AdminWindow.XP = { 1, 2, 5, 10, 50, 100 } -- 경험치 배율(서버가 같은 표로 다시 본다)
AdminWindow.DMG = { 1, 5, 20, 100 } -- 피해 배율
AdminWindow.BOSS_SHOW = { 100, 75, 60, 50, 40 } -- 보스의 그림 크기 미리보기(서 있는 그림의 몇 %)
AdminWindow.LEVELS = { 10, 20, 30, 60, 100, 150 } -- 바로 가는 레벨
AdminWindow.STAGES = { 1, 10, 20, 30, 60, 100 } -- 한 벌을 받는 장비의 단계
AdminWindow.PER_PAGE = 15 -- 이동 탭의 한 쪽(세 줄 x 다섯)

function AdminWindow.size(): (number, number)
	return AdminWindow.W, AdminWindow.H
end

-- 맵의 묶음(이동 탭): 지역마다의 장면들 — 월드맵의 지역 차례, 그 밖(실내 · 숨은 방)은 「그 밖」
function AdminWindow.places()
	local groups, seen = {}, {}
	for _, rid in WORLDMAP.order do
		local region = WORLDMAP.regions[rid]
		local list = {}
		for _, n in region.nodes do
			for _, key in n.scenes do
				if SCENES.scenes[key] and not seen[key] then
					seen[key] = true
					table.insert(list, { key = key, name = SCENES.scenes[key].name })
				end
			end
		end
		table.insert(groups, { id = rid, name = region.name, list = list })
	end
	local rest = {}
	for key, sc in SCENES.scenes do
		if not seen[key] then
			table.insert(rest, { key = key, name = sc.name })
		end
	end
	table.sort(rest, function(a, b)
		return a.key < b.key
	end)
	table.insert(groups, { id = "etc", name = "그 밖", list = rest })
	return groups
end

-- 받을 수 있는 소비 · 기타 아이템(퀘스트의 물건은 뺀다 — 그것은 「퀘스트의 할 일 채우기」로)
function AdminWindow.goods()
	local out = {}
	for _, g in ITEMS.GOODS do
		if not g.quest then
			table.insert(out, { id = g.id, name = g.short or g.name, n = if g.kind == "potion" then 50 elseif g.kind == "scroll" then 10 else 50 })
		end
	end
	return out
end

function AdminWindow.build(body: Frame, ctx, w: number, h: number)
	local view = {}
	local tab = "grow"
	local page: Frame? = nil
	local alive = true
	local quality, star = 3, 0 -- 받을 장비의 성능(1 낡은 ~ 5 빼어난) · 별
	local placeGroup, placePage = 1, 1
	local goodsPage = 1
	local tabs = {}
	local tx = 0
	for _, t in AdminWindow.TABS do
		local item
		item = Ui.tab(body, t.name, tx, 0, function()
			tab = t.id
			view.draw()
		end)
		if item.frame then
			item.frame.Name = "Tab_" .. t.id -- 탭마다 이름(Play에서 가려 누를 수 있게)
		end
		tabs[t.id] = item
		tx += item.width + 16
	end
	Ui.line(body, 0, 20, w)
	Ui.line(body, 0, h - 20, w)
	local status = Ui.text(body, "관리자에게만 보이는 창이다", 0, h - 15, w, { color = C.dim })

	-- 서버에 부탁한다(대답이 오면 아래 줄에 적는다)
	local function ask(what: string, a: any, b: any, c: any)
		status:set("…")
		status:color(C.dim)
		task.spawn(function()
			local got = ctx.admin(what, a, b, c)
			if not alive then
				return
			end
			if typeof(got) ~= "table" then
				status:set("서버가 듣지 않았다(관리자가 아니다)")
				status:color(C.red)
			else
				status:set(tostring(got.msg or ""))
				status:color(if got.ok then C.green else C.red)
			end
		end)
	end

	-- 한 줄: 왼쪽에 이름, 그 옆에 단추들. 돌려주는 것: 다음 줄의 y
	local function row(parent: Frame, y: number, label: string, buttons, bw: number?)
		Ui.text(parent, label, 0, y + 6, 78, { color = C.dim })
		local x = 82
		local width = bw or 40
		for _, b in buttons do
			local bwidth = b.w or width
			Ui.button(parent, b.text, x, y, bwidth, b.on, { h = 22, main = b.main == true }).frame.Name = "Do_" .. (b.id or b.text)
			x += bwidth + 4
		end
		return y + 28
	end

	function view.draw()
		if page then
			page:Destroy()
		end
		for id, t in tabs do
			t:setOn(id == tab)
		end
		local p = Ui.group(body, 0, 28, w, h - 52, "Page")
		page = p
		local me = ctx.me()
		local on = (me and me.admin) or { xp = 1, dmg = 1, god = false }
		local level = if me then me.level else 1
		local y = 0
		if tab == "grow" then
			local xs = {}
			for _, v in AdminWindow.XP do
				table.insert(xs, { text = "x" .. v, id = "xp" .. v, main = on.xp == v, on = function() ask("xp", v) end })
			end
			y = row(p, y, "경험치 배율", xs)
			y = row(p, y, ("레벨(지금 %d)"):format(level), {
				{ text = "-10", id = "lvm10", on = function() ask("level", math.max(1, level - 10)) end },
				{ text = "-1", id = "lvm1", on = function() ask("level", math.max(1, level - 1)) end },
				{ text = "+1", id = "lvp1", on = function() ask("level", math.min(N.MAX_LEVEL, level + 1)) end },
				{ text = "+10", id = "lvp10", on = function() ask("level", math.min(N.MAX_LEVEL, level + 10)) end },
			})
			local ls = {}
			for _, v in AdminWindow.LEVELS do
				table.insert(ls, { text = tostring(v), id = "lv" .. v, main = level == v, on = function() ask("level", v) end })
			end
			y = row(p, y, "레벨로 바로", ls)
			local js = {}
			for j = 1, 4 do
				table.insert(js, { text = j .. "차", id = "job" .. j, main = me ~= nil and me.job == j, on = function() ask("job", j) end })
			end
			y = row(p, y, "차수", js)
			y = row(p, y, "스킬", {
				{ text = "모두 마스터", id = "skmax", w = 86, on = function() ask("skills", "max") end },
				{ text = "되돌리기", id = "skreset", w = 70, on = function() ask("skills", "reset") end },
			})
			y = row(p, y, "능력치", { { text = "되돌리기", id = "streset", w = 70, on = function() ask("stats", "reset") end } })
			y = row(p, y, "퀘스트", { { text = "하는 중인 것의 할 일 채우기", id = "qfill", w = 170, on = function() ask("quests", "fill") end } })
			-- 스토리 보스 · 사당 지하를 바로 해 볼 때: 그 메인을 받은 것으로 한다(앞의 메인은 끝낸 것으로 · 레벨이 모자라면 올린다) → 「이동」 탭에서 망루 꼭대기로(「불타는 마을」은 마을의 달의 사당으로)
			y = row(p, y, "보스 퀘스트", {
				{ text = "성벽 거인", id = "qboss1", w = 76, on = function() ask("quests", "to", "r1m7") end }, -- 2026-10-15 보스의 새 이름(망루의 부관 → 성벽 거인 · 정찰대장 → 쇠사슬 간수)
				{ text = "쇠사슬 간수", id = "qboss2", w = 88, on = function() ask("quests", "to", "r1m8") end },
				{ text = "불타는 마을", id = "qcellar", w = 86, on = function() ask("quests", "to", "r1m9") end }, -- 사당 지하(달의 사당 안의 포탈로 내려간다 — 2026-10-13)
			})
			Ui.text(p, "레벨 · 차수를 바꾸면 능력치와 스킬을 다시 찍는다.", 0, y + 4, w, { color = C.off })
		elseif tab == "item" then
			y = row(p, y, "달돈", {
				{ text = "+1만", id = "m1", w = 56, on = function() ask("money", 10000) end },
				{ text = "+100만", id = "m2", w = 64, on = function() ask("money", 1000000) end },
				{ text = "+1억", id = "m3", w = 56, on = function() ask("money", 100000000) end },
			})
			y = row(p, y, "달가루", {
				{ text = "+100", id = "d1", w = 56, on = function() ask("dust", 100) end },
				{ text = "+1만", id = "d2", w = 56, on = function() ask("dust", 10000) end },
				{ text = "+100만", id = "d3", w = 64, on = function() ask("dust", 1000000) end },
			})
			-- 장비 한 벌: 성능과 별을 고르고 단계를 누른다
			local qname = ITEMS.QUALITY[quality].name
			y = row(p, y, "장비의 성능 · 별", {
				{ text = qname, id = "q", w = 70, on = function()
					quality = quality % #ITEMS.QUALITY + 1
					view.draw()
				end },
				{ text = ("별 %d"):format(star), id = "star", w = 56, on = function()
					star = if star >= 20 then 0 else star + 5
					view.draw()
				end },
			})
			local ss = {}
			for _, v in AdminWindow.STAGES do
				table.insert(ss, { text = "Lv." .. v, id = "g" .. v, w = 42, on = function() ask("gear", v, quality, star) end })
			end
			y = row(p, y, "장비 한 벌 받기", ss)
			-- 소비 · 기타 아이템: 한 쪽에 여덟(두 줄 x 넷)
			local goods = AdminWindow.goods()
			local pages = math.max(1, math.ceil(#goods / 8))
			goodsPage = math.clamp(goodsPage, 1, pages)
			Ui.text(p, ("소비 · 기타(%d/%d)"):format(goodsPage, pages), 0, y + 6, 78, { color = C.dim })
			Ui.button(p, "다음", w - 44, y, 44, function()
				goodsPage = goodsPage % pages + 1
				view.draw()
			end, { h = 22 }).frame.Name = "Do_goodsNext"
			y += 28
			for i = 1, 8 do
				local g = goods[(goodsPage - 1) * 8 + i]
				if g then
					local col, line = (i - 1) % 4, math.floor((i - 1) / 4)
					Ui.button(p, ("%s %d"):format(g.name, g.n), col * 90, y + line * 26, 86, function()
						ask("goods", g.id, g.n)
					end, { h = 22, font = "small" }).frame.Name = "Do_goods_" .. g.id
				end
			end
			-- 경매장을 혼자서 해 볼 때: 「시험 판매자」의 물건 셋(내 직업의 무기 · 모자 · 물약)을 올린다 → 은달 항구의 경매사에게서 산다. 다 보면 치운다
			row(p, y + 56, "경매장 시험", {
				{ text = "시험 물건 올리기", id = "mkfill", w = 112, on = function() ask("market", "fill") end },
				{ text = "치우기", id = "mkclear", w = 56, on = function() ask("market", "clear") end },
			})
		elseif tab == "move" then
			local groups = AdminWindow.places()
			placeGroup = math.clamp(placeGroup, 1, #groups)
			-- 지역의 단추들: 창의 폭을 넘으면 다음 줄로 넘긴다
			local gx, gy = 0, 0
			for i, g in groups do
				local bwidth = Ui.measure(g.name) + 12
				if gx + bwidth > w then
					gx, gy = 0, gy + 23
				end
				Ui.button(p, g.name, gx, gy, bwidth, function()
					placeGroup, placePage = i, 1
					view.draw()
				end, { h = 20, font = "small", main = i == placeGroup }).frame.Name = "Do_group_" .. g.id
				gx += bwidth + 3
			end
			local top = gy + 28
			local list = groups[placeGroup].list
			local per = AdminWindow.PER_PAGE
			local pages = math.max(1, math.ceil(#list / per))
			placePage = math.clamp(placePage, 1, pages)
			for i = 1, per do
				local at = list[(placePage - 1) * per + i]
				if at then
					local col, line = (i - 1) % 3, math.floor((i - 1) / 3)
					Ui.button(p, at.name, col * 119, top + line * 26, 116, function()
						ask("goto", at.key)
					end, { h = 22, font = "small" }).frame.Name = "Do_goto_" .. at.key
				end
			end
			if pages > 1 then
				Ui.text(p, ("%d / %d"):format(placePage, pages), 0, top + 5 * 26 + 6, 60, { color = C.dim })
				Ui.button(p, "다음 쪽", w - 60, top + 5 * 26, 60, function()
					placePage = placePage % pages + 1
					view.draw()
				end, { h = 22, font = "small" }).frame.Name = "Do_placeNext"
			end
		else
			y = row(p, y, "체력", { { text = "가득 채우기(쓰러졌으면 일어난다)", id = "heal", w = 200, on = function() ask("heal") end } })
			y = row(p, y, "무적", {
				{ text = "켜기", id = "godOn", w = 56, main = on.god == true, on = function() ask("god", true) end },
				{ text = "끄기", id = "godOff", w = 56, main = on.god ~= true, on = function() ask("god", false) end },
			})
			local ds = {}
			for _, v in AdminWindow.DMG do
				table.insert(ds, { text = "x" .. v, id = "dmg" .. v, main = on.dmg == v, on = function() ask("dmg", v) end })
			end
			y = row(p, y, "피해 배율", ds)
			-- 보스의 그림 크기 미리보기(화면 쪽만 — 서버에 묻지 않는다): 받은 동작 그림을 작게 그릴수록 또렷하다. 고른 크기를 알려 주면 설계값(공방 bosses.js의 BOSS_SHOW)으로 굳힌다
			local now = ctx.bossShow and ctx.bossShow() -- 고운 그림이 없으면 nil(이 줄을 그리지 않는다)
			if now then
				local bs = {}
				for _, v in AdminWindow.BOSS_SHOW do
					table.insert(bs, { text = v .. "%", id = "boss" .. v, w = 44, main = now == v, on = function()
						ctx.bossShow(v)
						view.draw()
					end })
				end
				y = row(p, y, "보스 크기", bs)
			end
			Ui.text(p, "배율과 무적은 저장되지 않는다(다시 들어오면 꺼져 있다).", 0, y + 4, w, { color = C.off })
			Ui.text(p, "피해 배율은 보이는 전투력과 순위를 바꾸지 않는다.", 0, y + 18, w, { color = C.off })
			if now then
				Ui.text(p, "보스 크기는 그림만 바꿔 본다(맞는 자리는 그대로).", 0, y + 32, w, { color = C.off })
			end
		end
	end

	-- 내 상태가 오면(레벨 · 배율이 바뀌었다) 다시 그린다
	local last = ""
	function view.refresh(me)
		local a = (me and me.admin) or {}
		local sig = table.concat({ tostring(me and me.level), tostring(me and me.job), tostring(a.xp), tostring(a.dmg), tostring(a.god) }, "|")
		if sig ~= last then
			last = sig
			view.draw()
		end
	end

	function view.destroy()
		alive = false
		if page then
			page:Destroy()
			page = nil
		end
	end
	view.refresh(ctx.me())
	return view
end

return AdminWindow

end
MODULES['Client/lune/ui/attendWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 출석 창 — 메뉴 → 「출석」 · 그날 처음 들어오면 한 번 뜬다(2026-10-15 · 사용자: "출석보상, 업적 만들어야합니다" — 판 · 보상은 제 제안).
--  모양은 공방 시험 탭의 js/lune/ui/paint.js(paintAttend)와 같다: 머리글(「10월 출석 12/28」 · 「자정에 하루」) · 칸 7 x 4(날 · 보상 그림 · 수 · 큰 칸 ★ · 받은 칸 「받음」) ·
--   받을 것 한 줄(받을 칸들을 더한 것 — 칸을 누르면 그 칸의 것) · 안내와 「받기」.
--  받는 것은 서버가 한다(ctx.attendDo → Attend "claim"). 셈은 shared/lune/sim/attend.luau. 화면 오른쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Attend = require(lune.sim.attend)
local Gift = require(lune.sim.gift)
local Items = require(lune.sim.items)
local Format = require(lune.ui.format)
local Layout = require(lune.ui.layout)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local S = Layout.ATTEND
local D = Attend.DATA
local W = Attend.WORDS

local AttendWindow = {}

function AttendWindow.size(): (number, number)
	return S.w, S.top + S.rows * S.cell + (S.rows - 1) * S.gap + S.lineY + S.rowH + Ui.M.button
end

-- 칸의 그림 · 수(물약은 그 캐릭터의 레벨의 것)
function AttendWindow.cell(r, level: number): (string, string)
	local icon, n = Gift.icon(r)
	if icon == "potion_s" then
		local g = Items.goods(Items.potionFor(level).id)
		icon = if g and g.icon then g.icon else icon
	end
	return icon, Format.short(n)
end

-- 받을 것 한 줄: 이름표 · 보여 줄 칸 · 받을 칸들을 말하는가(공방의 attendLabel과 같다)
function AttendWindow.label(v, sel: number?): (string, number, boolean)
	local ready = v.n - v.got
	local show = sel or (if ready > 0 then v.got + 1 else math.min(v.days, v.n + 1))
	local label = if sel then Format.fill(W.day, { n = show }) elseif ready > 0 then Format.fill(W.ready, { n = ready }) elseif v.n < v.days then W.next else W.none
	return label, show, ready > 0 and sel == nil
end

-- 받을 칸들을 더한 꾸러미
function AttendWindow.sum(v)
	local out = {}
	for k = v.got + 1, v.n do
		for key, n in D.rewards[k] do
			out[key] = (out[key] or 0) + n
		end
	end
	return out
end

function AttendWindow.build(body: Frame, ctx, w: number, _h: number)
	local view = {}
	local sel: number? = nil
	local note, noteTone = nil, nil
	local head = Ui.text(body, "", 0, 2, w, { color = C.gold })
	Ui.text(body, W.reset, 0, 2, w, { align = "right", color = C.dim })
	local cells = {}
	for k = 1, D.days do
		local col, row = (k - 1) % S.cols, math.floor((k - 1) / S.cols)
		local c = {}
		c.slot = Ui.slot(body, col * (S.cell + S.gap), S.top + row * (S.cell + S.gap), S.cell)
		c.slot.frame.Name = "Day" .. k
		c.day = Ui.text(c.slot.frame, tostring(k), 3, 2, S.cell - 6, { color = C.dim })
		if table.find(D.big, k) then
			Ui.smallIcon(c.slot.frame, "star", S.cell - 14, 1)
		end
		c.pic = Ui.pic(c.slot.frame, nil, math.floor((S.cell - 24) / 2), 11)
		c.num = Ui.text(c.slot.frame, "", 3, S.cell - 12, S.cell - 6, { align = "right", outline = true })
		c.taken = Ui.text(c.slot.frame, W.taken, 0, math.floor((S.cell - Ui.M.small) / 2) + 3, S.cell, { align = "center", color = C.green })
		Ui.hit(c.slot.frame).Activated:Connect(function()
			sel = if sel == k then nil else k -- 칸을 누르면 그 칸의 보상이 아래에(한 번 더 누르면 받을 것으로)
			view.refresh()
		end)
		cells[k] = c
	end
	local y = S.top + S.rows * S.cell + (S.rows - 1) * S.gap + S.lineY
	Ui.line(body, 0, y - 4, w)
	local label = Ui.text(body, "", 0, y + 2, w, { color = C.dim })
	local gift = Ui.text(body, "", 0, y + 2, w, { color = C.gold })
	local by = y + S.rowH
	local noteText = Ui.text(body, W.note, 0, by + math.floor((Ui.M.button - Ui.M.small) / 2), w - S.btnW - 8, { color = C.dim })
	local take = Ui.button(body, W.take, w - S.btnW, by, S.btnW, function()
		local res = ctx.attendDo("claim")
		if res and res.view then
			if res.why then
				note, noteTone = Format.fill(W.full, { n = res.view.n - res.view.got }), C.red
			elseif (res.got or 0) > 0 then
				note, noteTone = W.got, C.green
			end
			sel = nil
		end
		view.refresh()
	end, { main = true })
	take.frame.Name = "Take"

	function view.refresh()
		local v = ctx.attend()
		local me = ctx.me and ctx.me()
		local level = if me then me.level else 1
		if not v then
			head:set("")
			take:setEnabled(false)
			return
		end
		head:set(Format.fill(W.head, { month = v.month, n = v.n, days = v.days }))
		for k, c in cells do
			local taken, ready = k <= v.got, k > v.got and k <= v.n
			c.slot:setOn(ready or sel == k)
			c.day:color(if ready then C.accent else C.dim)
			c.taken:show(taken)
			c.pic.Visible = not taken
			c.num:show(not taken)
			if not taken then
				local icon, num = AttendWindow.cell(D.rewards[k], level)
				Ui.setPic(c.pic, icon)
				c.num:set(num)
			end
		end
		local text, show, hot = AttendWindow.label(v, sel)
		label:set(text)
		label:color(if hot then C.accent else C.dim)
		local lw = Ui.measure(text)
		gift.label:SetMaxWidth(math.max(10, w - lw - 8), 1) -- 한 줄로(둘째 인자를 빼면 줄 수가 풀려 아래 줄로 넘쳤다 — 2026-10-18 검토)
		gift:move(lw + 8, y + 2)
		gift:set(if hot then Gift.text(AttendWindow.sum(v), W) else Gift.text(D.rewards[show] or {}, W))
		noteText:set(note or W.note)
		noteText:color(noteTone or C.dim)
		local ready = v.n - v.got
		take:setEnabled(ready > 0)
	end
	if ctx.attendFetch then
		ctx.attendFetch() -- 열 때 서버의 지금 판을 받아 온다(받으면 다시 그린다)
	end
	view.refresh()
	return view
end

return AttendWindow

end
MODULES['Client/lune/ui/auctionWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 경매장 창 — 메뉴의 「경매장」(Y)으로 어디서나 연다. 은달 항구의 경매사 「금송」에게 말을 걸어도 열린다(넓은 창 — 혼자 쓴다).
--  사용자 2026-10-06: "경매장으로 전부 거래가능하게 할겁니다" · 2026-10-13: "경매장 부터 진행합시다.  알아서 조사하고 판단하고 해서  경매장 구현 해보세요"
--  **사용자 2026-10-13(처음 만든 것을 보고): "메이플 식 경매장을 말하는거긴합니다."** — 메이플스토리의 메이플 옥션 방식이다. 탭 넷:
--   구매 = 분류(무기 — 직업마다 · 모자 · 옷 · 장갑 · 신발 · 소비 · 기타) · 이름으로 찾기 · 차례(가격 낮은 순 / 남은 시간 순). 줄의 「구매」를 누르면 아래에서 한 번 더 묻는다 — 묶음은 수를 골라 낱개로 산다.
--          산 것은 「완료」에 「낙찰」로 들어온다.
--   판매 = 판매 중인 것들(「취소」)과 「판매 등록」 → 등록 화면: 왼쪽에 가방의 올릴 수 있는 물건, 오른쪽에 양식(수량 · 가격(묶음은 개당 가격) · 기간 · 수수료 · 보증금 · 받는 금액 · 「등록」).
--   완료 = 낙찰 → 「수령」 · 판매 완료 → 「대금 수령」 · 미판매 → 「반환」 「재등록」 · 아래에 「모두 받기」.
--   시세 = 그 분류에서 최근에 거래된 것들(이름 · 언제 · 개당 값).
--  사고 올리고 받는 것은 모두 서버가 정한다(ctx.market → Market — server/lune/modules/world.luau의 onMarket). 적는 글과 셈은 shared/lune/ui/auctionView.luau(자동 검사가 같은 것을 본다),
--  낱말과 숫자는 공방 js/lune/design/economy.js의 AUCTION, 치수는 UILAYOUT.auction. 아이템과 달돈은 늘 그림과 함께 적는다(사용자 2026-10-13).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Market = require(lune.sim.market)
local Format = require(lune.ui.format)
local Layout = require(lune.ui.layout)
local View = require(lune.ui.auctionView)
local Ui = require(script.Parent.ui)
local ItemCell = require(script.Parent.itemCell)
local ItemDetail = require(script.Parent.itemDetail)

local C = Ui.COLOR
local S = Layout.AUCTION
local M = Market.DATA
local W = Market.WORDS

local AuctionWindow = { wide = true }

function AuctionWindow.size(): (number, number)
	return S.w, S.h
end

-- [그림 칸] 하나(목록의 줄 · 양식의 위): 칸과 그 안의 그림
local function iconCell(parent: Instance, x: number, y: number)
	local cell = Ui.slot(parent, x, y, S.icon)
	cell.frame.Name = "Icon"
	local icon = Ui.smallIcon(cell.frame, "coin", 3, 3)
	icon.Visible = false
	return cell, icon
end

local function clear(frame: Instance)
	for _, child in frame:GetChildren() do
		child:Destroy()
	end
end

-- 적는 칸을 보이거나 감춘다(칸의 틀째로)
local function showField(box, on: boolean)
	local holder = box.Parent
	if holder then
		holder.Visible = on
	else
		box.Visible = on
	end
end

function AuctionWindow.build(body: Frame, ctx, w: number, h: number)
	local view = {}
	local dead = false
	local me0 = ctx.me()
	local tab = "buy"
	local cat, class = "weapon", if me0 then me0.class else "axion"
	local rows, trades = {}, {} -- 구매 탭의 목록 · 시세(서버가 준 것)
	local mine = {} -- 내 것(판매 · 완료 탭이 나눠 쓴다)
	local used, max = 0, M.slots
	local serverNow, gotAt = os.time(), os.clock() -- 서버의 시계(남은 시간은 이것으로 센다)
	local busy = false
	local note, noteTone = "", "dim"
	local query, sort = "", View.SORTS[1]
	local ask, askQty = nil, 1 :: number? -- 사려고 묻는 중인 줄 · 그 수(수량 칸이 비었으면 nil)
	local detail = nil -- 상세를 보는 줄(구매 목록에서 누른 것)
	local sellView = "list" -- 판매 탭: "list" 판매 중인 것들 · "form" 등록 화면
	local pick = nil :: { tab: string, slot: number }? -- 등록 화면에서 고른 가방의 칸
	local count, priceText, hours = 1, "", M.hours[1]
	local sellKey = "" -- 가방의 올릴 수 있는 것들이 달라졌는지 견주는 글

	local pageH = h - S.top - S.footH
	local function now(): number
		return serverNow + math.floor(os.clock() - gotAt)
	end
	local function board(): string
		return View.board(cat, class)
	end

	local paint -- 아래에서 정한다: 단추의 쓸 수 있음 · 지갑 · 알림 줄
	local fillBuy, fillLog, fillSelling, fillBag, fillDone, paintForm

	-- 서버에 부탁한다(한 번에 하나). after(res) = 답이 온 뒤에 할 일
	local function call(action: string, a: any, b: any, c: any, d: any, after: ((any) -> ())?)
		if busy then
			return
		end
		busy = true
		note, noteTone = W.wait, "dim"
		paint()
		task.spawn(function()
			local res = ctx.market(action, a, b, c, d)
			busy = false
			if dead then
				return
			end
			if res then
				if typeof(res.now) == "number" then
					serverNow, gotAt = res.now, os.clock()
				end
				if typeof(res.used) == "number" then
					used, max = res.used, res.max or max
				end
				if res.rows and res.board == board() then
					rows, trades = res.rows, res.trades or trades
					fillBuy()
					fillLog()
				end
				if res.mine then
					mine = res.mine
					fillSelling()
					fillDone()
				end
				note, noteTone = res.msg or res.why or "", if res.ok then "accent" else "red"
			else
				note, noteTone = W.why.off, "red"
			end
			if after then
				after(res)
			end
			paint()
			-- 답을 기다리는 사이에 탭을 바꿨다(그때의 부탁은 busy라 버려졌다): 그 탭의 것을 이어서 받아 온다(2026-10-18 검토 — 판매 · 완료가 빈 목록으로 남았다)
			if (tab == "sell" or tab == "done") and action ~= "mine" and not (res and res.mine) then
				call("mine", false)
			elseif (tab == "buy" or tab == "log") and action == "mine" then
				call("browse", board(), false)
			end
		end)
	end

	-- ---------- 위: 탭 · 판매한 수 · 지갑 ----------
	local tabs = {}
	local pages = {}
	local header -- 구매 · 시세가 같이 쓰는 머리(분류 · 찾기)
	local function showPages()
		for key, page in pages do
			page.Visible = key == tab
		end
		header.Visible = tab == "buy" or tab == "log"
	end
	local function setTab(id: string)
		if tab == id then
			return
		end
		tab, ask = id, nil
		showPages()
		if not busy then
			note = ""
		end
		if id == "buy" or id == "log" then
			fillBuy()
			fillLog()
			call("browse", board(), false)
		else
			sellView = "list"
			call("mine", false)
		end
		paint()
	end
	local tx = 0
	for i, id in View.TABS do
		tabs[i] = Ui.tab(body, W.tabs[i], tx, 0, function()
			setTab(id)
		end)
		tx += tabs[i].width + 16
	end
	Ui.smallIcon(body, "coin", w - S.purseW, -3)
	local money = Ui.text(body, "", w - S.purseW + 21, 1, S.purseW - 21, { color = C.gold })
	local slots = Ui.text(body, "", w - S.purseW - 8 - S.slotsW, 1, S.slotsW, { align = "right", color = C.dim })
	Ui.line(body, 0, 20, w)

	-- ---------- 아래: 알림 한 줄 — 살 때는 묻는 글 · (묶음이면) 수를 고치는 단추 · 「구매 · 취소」 ----------
	local fy = h - S.footH
	Ui.line(body, 0, fy + 2, w)
	local noteText = Ui.text(body, "", 0, fy + 12, w, { color = C.dim })
	local askBox = Ui.group(body, 0, fy + 7, w, S.btnH, "Ask")
	local yesX = w - S.askW * 2 - 6
	local ofX = yesX - 8 - S.ofW -- 「/ 10개」
	local qtyX = ofX - 6 - S.qtyField -- 수량을 적는 칸
	local qtyLabelX = qtyX - 4 - S.qtyLabelW -- 「수량」
	local askGear = Ui.text(askBox, "", 0, 5, yesX - 8, { color = C.gold }) -- 장비: 수를 고르지 않는다(글이 넓다)
	local askStack = Ui.text(askBox, "", 0, 5, qtyLabelX - 8, { color = C.gold })
	local askLabel = Ui.text(askBox, W.count, qtyLabelX, 5, S.qtyLabelW, { color = C.dim })
	-- 수량은 적는다(사용자 2026-10-13: "경매장  수량도 입력하는걸로 처리하는방향으로 해주세요") — 올라온 수를 넘으면 그 수로
	local askBoxQty = Ui.field(askBox, qtyX, 0, S.qtyField, S.btnH, "1")
	local askOf = Ui.text(askBox, "", ofX, 5, S.ofW, { color = C.dim })
	askBoxQty:GetPropertyChangedSignal("Text"):Connect(function()
		if not ask then
			return
		end
		local text, n = View.count(askBoxQty.Text, ask.l or 1)
		if text ~= askBoxQty.Text then
			askBoxQty.Text = text
			return
		end
		askQty = n
		paint()
	end)
	local askYes = Ui.button(askBox, W.buy, yesX, 0, S.askW, function()
		local r, q = ask, askQty
		if r and q then
			ask = nil
			call("buy", board(), r.id, q, r.p)
		end
	end, { main = true, h = S.btnH })
	Ui.button(askBox, W.cancel, w - S.askW, 0, S.askW, function()
		ask = nil
		paint()
	end, { h = S.btnH })

	-- ---------- 구매 · 시세의 머리: 분류 · 직업 · 새로 고침 · 찾는 칸 · 차례 ----------
	header = Ui.group(body, 0, S.top, w, S.listTop - S.top, "Header")
	local catButtons = {}
	local cats = View.cats()
	local function reload(force: boolean?)
		ask, rows, trades = nil, if force then rows else {}, if force then trades else {}
		if not force then
			fillBuy()
			fillLog()
		end
		call("browse", board(), force == true)
	end
	for i, c in cats do
		catButtons[i] = Ui.button(header, c.name, (i - 1) * (S.catW + S.catGap), 0, S.catW, function()
			if cat ~= c.id then
				cat = c.id
				reload(false)
			end
		end, { h = S.catH })
	end
	local classButton
	classButton = Ui.button(header, View.className(class), #cats * (S.catW + S.catGap), 0, S.classW, function()
		class = View.nextClass(class)
		classButton:setText(View.className(class))
		reload(false)
