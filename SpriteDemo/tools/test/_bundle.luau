	return per * Kit.chargeLevels(h)
end

-- 그 단계로 쳤을 때의 피해의 배수 · 더 닿는 거리(서버가 단계를 따로 정했을 때 — 넘치는 힘)
function Kit.chargeAt(h, level: number): (number, number)
	local core = KIT[h.class].core
	return 1 + level * Kit.chargeBonus(h.skills[core.id] or 0, SKILL[core.id].max), level * (core.reach or 0)
end

-- ---------- 맞혔을 때 · 쓰러뜨렸을 때(방이 부른다) ----------
-- 영혼을 하나 얻는다(리퍼). 늘었으면 true
function Kit.gainSoul(h): boolean
	if h.class ~= "reaper" or Kit.level(h, "core") < 1 then
		return false
	end
	local k = h.kit
	k.soulT = 0
	if k.souls >= Kit.soulMax(h) then
		return false
	end
	k.souls += 1
	return true
end

-- 주먹이 맞았다: 열기가 오른다(살라맨더). 맞힌 뒤에 달아올라 있는지를 돌려준다
function Kit.gainHeat(h): boolean
	if h.class ~= "salamander" or Kit.level(h, "core") < 1 then
		return false
	end
	local core, k = KIT.salamander.core, h.kit
	local fx, s = pass(h, "sl_heat2") -- 끓는 피: 더 빨리 오른다
	k.heat = math.min(core.max, k.heat + core.gain * (1 + (if fx then fx.gain * s else 0)))
	k.heatT = 0
	return k.heat >= Kit.hotAt(h)
end

-- ---------- 한 걸음 ----------
-- 시간이 흐른다: 영혼이 흩어지고, 열기가 식고, 체력이 찬다. 돌려주는 것: 장치의 모습이 바뀌었는가(화면에 알린다) · 되찾은 체력(없으면 0)
function Kit.tick(h, dt: number): (boolean, number)
	local k = h.kit
	local changed, healed = false, 0
	if h.class == "reaper" and k.souls > 0 then
		k.soulT += dt
		if k.soulT >= KIT.reaper.core.decay then
			k.soulT = 0
			k.souls -= 1
			changed = true
		end
	elseif h.class == "salamander" then
		local core = KIT.salamander.core
		if k.heat > 0 then
			k.heatT += dt
			if k.heatT > core.cool then
				local before = k.heat
				local fx, s = pass(h, "sl_heat2") -- 끓는 피: 천천히 식는다
				local hot = Kit.hotAt(h)
				k.heat = math.max(0, k.heat - core.decay * (1 - (if fx then fx.slow * s else 0)) * math.min(dt, k.heatT - core.cool)) -- cool초를 넘긴 만큼만 식는다
				-- 화면의 숫자(5 단위) · 달아오름이 바뀔 때만 알린다
				changed = math.floor(before / 5) ~= math.floor(k.heat / 5) or (before >= hot) ~= (k.heat >= hot)
			end
		end
		-- 뜨거운 피: 초마다 최대 체력의 regen%
		local s = Kit.scale(h, "passive")
		if s > 0 and h.alive and h.hp < h.maxHp then
			k.regen += h.maxHp * KIT.salamander.passive.regen / 100 * s * dt
			if k.regen >= 1 then
				healed = math.min(math.floor(k.regen), h.maxHp - h.hp)
				k.regen -= math.floor(k.regen)
				h.hp += healed
			end
		else
			k.regen = 0
		end
	end
	return changed, healed
end

-- ---------- 화면에 보내는 것 ----------
-- on = 사출기를 켰는가 · souls = 영혼 · heat = 열기(정수) · hot = 달아올랐는가
function Kit.view(h)
	local k = h.kit
	return { on = k.on, souls = k.souls, heat = math.floor(k.heat), hot = Kit.hot(h) }
end

return Kit

end
MODULES['ReplicatedStorage/shared/lune/sim/party'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 파티 — 넷까지(사용자 결정). 초대 → 받기 / 거절, 나가기, 파티장 넘기기(파티장이 나가면 먼저 들어온 사람에게), 둘 아래로 줄면 흩어진다.
--  누가 어느 파티인지만 다루는 순수한 셈이다(사람 = 번호). 경험치를 나누는 몫도 여기서 낸다:
--   같은 맵에서 함께 잡으면 몬스터의 경험치 x (1 + 보너스)를 사람 수로 고르게 나눈다(보너스: 둘 10% · 셋 15% · 넷 20% — 공방 「성장 · 장비」 탭의 XPRULE).
--   예: 둘이면 한 사람이 55%씩 — 둘이 잡으면 두 배 빨리 잡으니 혼자일 때의 110%다. 레벨 차이가 20을 넘는 파티원과는 나누지 않는다.
local N = require(script.Parent.Parent.config.numbers)

local RULE = N.data.XPRULE

local Party = {}
Party.MAX = RULE.partyMax
Party.ASK_LIFE = 30 -- 초대가 살아 있는 시간(초)
Party.LEVEL_GAP = 20 -- 이보다 레벨 차이가 크면 경험치를 나누지 않는다

-- 장부: parties[번호] = { id, leader, members = { 들어온 차례대로 } } · of[사람] = 파티 번호 · asks[받은 사람] = { from, at }
function Party.newBook()
	return { parties = {}, of = {}, asks = {}, nextId = 1 }
end

function Party.of(book, who: any)
	local id = book.of[who]
	return if id then book.parties[id] else nil
end

-- 그 사람의 파티원들(자기도 든다). 파티가 없으면 혼자
function Party.members(book, who: any): { any }
	local party = Party.of(book, who)
	return if party then table.clone(party.members) else { who }
end

function Party.same(book, a: any, b: any): boolean
	return a == b or (book.of[a] ~= nil and book.of[a] == book.of[b])
end

-- 살아 있는 초대(시간이 지난 것은 지운다)
function Party.ask(book, to: any, now: number)
	local ask = book.asks[to]
	if ask and now - ask.at > Party.ASK_LIFE then
		book.asks[to] = nil
		return nil
	end
	return ask
end

-- 초대한다. 파티가 없는 사람이 초대하면 받는 순간 파티가 생기고 초대한 사람이 파티장이 된다
function Party.invite(book, from: any, to: any, now: number): (boolean?, string?)
	if from == to then
		return nil, "자기 자신은 초대할 수 없다"
	elseif book.of[to] then
		return nil, "이미 파티가 있는 사람이다"
	end
	local party = Party.of(book, from)
	if party then
		if party.leader ~= from then
			return nil, "파티장만 초대한다"
		elseif #party.members >= Party.MAX then
			return nil, "파티가 가득 찼다"
		end
	end
	if Party.ask(book, to, now) then
		return nil, "이미 초대를 받고 있는 사람이다"
	end
	book.asks[to] = { from = from, at = now }
	return true
end

-- 초대를 받는다. 들어간 파티를 돌려준다
function Party.accept(book, to: any, now: number)
	local ask = Party.ask(book, to, now)
	if not ask then
		return nil, "받은 초대가 없다"
	end
	book.asks[to] = nil
	if book.of[to] then
		return nil, "이미 파티가 있다"
	end
	local party = Party.of(book, ask.from)
	if not party then
		party = { id = book.nextId, leader = ask.from, members = { ask.from } }
		book.nextId += 1
		book.parties[party.id] = party
		book.of[ask.from] = party.id
	end
	if #party.members >= Party.MAX then
		return nil, "파티가 가득 찼다"
	end
	table.insert(party.members, to)
	book.of[to] = party.id
	return party
end

-- 초대를 거절한다. 초대한 사람을 돌려준다(초대가 없었으면 nil)
function Party.decline(book, to: any): any
	local ask = book.asks[to]
	book.asks[to] = nil
	return if ask then ask.from else nil
end

-- 나간다(접속을 끊었을 때도). 돌려주는 것: 남은 사람들(흩어졌으면 그 마지막 한 사람까지), 흩어졌는가
function Party.leave(book, who: any): ({ any }, boolean)
	book.asks[who] = nil
	local party = Party.of(book, who)
	if not party then
		return {}, false
	end
	local index = table.find(party.members, who)
	table.remove(party.members, index)
	book.of[who] = nil
	local left = table.clone(party.members)
	if #party.members < 2 then
		for _, m in party.members do
			book.of[m] = nil
		end
		book.parties[party.id] = nil
		return left, true
	end
	if party.leader == who then
		party.leader = party.members[1]
	end
	return left, false
end

-- 함께 잡은 사람 수에 따른 보너스 %
function Party.bonus(n: number): number
	local bonus = 0
	for _, row in RULE.party do
		if n >= row.n then
			bonus = row.bonus
		end
	end
	return bonus
end

-- 함께 잡은 사람이 n이면 한 사람이 몬스터 경험치의 몇 배를 받나(혼자면 1)
function Party.share(n: number): number
	if n <= 1 then
		return 1
	end
	return (1 + Party.bonus(n) / 100) / n
end

-- 경험치를 나눌 사람들: killer의 파티원 가운데 here(같은 맵에 있는 살아 있는 사람들 { [번호] = { level } })에 있고 레벨 차이가 20 안쪽인 사람(killer도 든다)
function Party.mates(book, killer: any, here): { any }
	local me = here[killer]
	local list = {}
	for _, m in Party.members(book, killer) do
		local other = here[m]
		if m == killer or (other and me and math.abs(other.level - me.level) <= Party.LEVEL_GAP) then
			table.insert(list, m)
		end
	end
	return list
end

return Party

end
MODULES['ReplicatedStorage/shared/lune/sim/passives'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 2~4차의 패시브(사출기 강화 말고의 것) — 공방 js/lune/design/combat.js의 PASSIVE → data/combat.generated.luau의 passive.
--  사용자 2026-10-08: "작업 이어서 하세요"(남은 2~4차). 패시브 = { who · job · max · fx(세기 — 마스터했을 때의 값) }.
--  세기에는 그 스킬의 레벨에 따른 배수(레벨 1에서 40% → 마스터 100%)를 곱한다. 개수 · 시간 · 기준(단계 · 영혼 · 수정의 수 …)은 배우기만 하면 그 값이다.
--  여기서는 셈만 한다(방 · 캐릭터의 셈이 부른다):
--    주는 피해 — atk(공격력에 늘 곱한다) · vs(그 적에게만 붙는 것: 넘어진 적 · 체력이 많은/적은 적 · 먼 거리 · 이어 맞히기 · 모은 단계 · 옛 사냥기)
--    받는 피해 — cut · dodge(회피 +) · rekindle(쓰러질 피해를 버틴다)
--    표식 치명타(리븐) — crit · 닿는 거리 — reach · 그 밖의 값은 get(캐릭터, 열쇠)로 읽는다(단계 · 영혼 · 수정 · 표식의 수 …)
--  캐릭터에 얹는 그때그때의 상태(저장하지 않는다): h.pass = { streak · streakAt(이어 맞힌 수 · 마지막으로 맞힌 때) · press · pressN · pressAt(이어 때리는 적 · 수 · 때) ·
--    sure(피했다 — 다음 베기가 반드시 치명타) · surge(이때까지 다음 강타가 높은 단계에서 시작한다) · rekindle(다시 버틸 수 있는 때) · edge(대검이 맞은 횟수) · venom(독이 다음에 드는 때) · extended(폭주가 늘어난 시간) }
local COMBAT = require(script.Parent.Parent.data["combat.generated"])
local CLASSES = require(script.Parent.Parent.data["classes.generated"])
local Kit = require(script.Parent.kit)

local PASS = COMBAT.passive
local RULES = COMBAT.rules
local FLOOR = CLASSES.skillRule.floor

-- 직업마다: 그 열쇠가 든 패시브들 { [직업] = { [열쇠] = { 스킬 … } } }
local BY = {}
for id, def in PASS do
	BY[def.who] = BY[def.who] or {}
	for key in def.fx do
		BY[def.who][key] = BY[def.who][key] or {}
		table.insert(BY[def.who][key], id)
	end
end
for _, keys in BY do
	for _, list in keys do
		table.sort(list)
	end
end

local Passives = {}
Passives.data = PASS

function Passives.is(id: any): boolean
	return typeof(id) == "string" and PASS[id] ~= nil
end

function Passives.init(h)
	h.pass = { streak = 0, streakAt = -1e9, press = nil, pressN = 0, pressAt = -1e9, sure = false, surge = -1e9, rekindle = -1e9, edge = 0, venom = 0, extended = 0 }
end

-- 그 패시브의 세기(레벨의 배수 — 배우지 않았으면 0)
local function scaleOf(h, id: string): number
	local def = PASS[id]
	local lv = h.skills[id] or 0
	if lv <= 0 or def.who ~= h.class then
		return 0
	end
	return FLOOR + (1 - FLOOR) * (if def.max > 1 then (lv - 1) / (def.max - 1) else 1)
end
Passives.scale = scaleOf

-- 그 열쇠의 값 x 세기를 그 직업의 패시브에서 모두 더한다
local function sum(h, key: string): number
	local list = BY[h.class] and BY[h.class][key]
	if not list then
		return 0
	end
	local total = 0
	for _, id in list do
		local s = scaleOf(h, id)
		if s > 0 then
			total += PASS[id].fx[key] * s
		end
	end
	return total
end
Passives.sum = sum

-- 그 열쇠가 든 패시브를 배웠으면 그 패시브의 값들(fx)과 세기 — 여럿이면 처음 것(배우지 않았으면 nil)
function Passives.get(h, key: string)
	local list = BY[h.class] and BY[h.class][key]
	if list then
		for _, id in list do
			local s = scaleOf(h, id)
			if s > 0 then
				return PASS[id].fx, s
			end
		end
	end
	return nil, 0
end

-- 세기와 상관없는 값(단계 · 영혼 · 수정 · 표식 · 망령 · 수호령의 수 …): 배웠으면 그 값, 아니면 base
function Passives.count(h, key: string, base: number): number
	local fx = Passives.get(h, key)
	return if fx then fx[key] else base
end

-- ---------- 주는 피해 ----------
-- 공격력에 늘 곱하는 것: 공격력 + · 최종 피해 + · 피의 계약(잃은 체력만큼)
function Passives.atk(h): number
	local mul = (1 + sum(h, "atk")) * (1 + sum(h, "final"))
	local pact = sum(h, "pact")
	if pact > 0 and h.maxHp > 0 then
		mul *= 1 + pact * math.clamp(1 - h.hp / h.maxHp, 0, 1)
	end
	return mul
end

-- 그 적에게만 붙는 것. info = { skill 그 기술 · charge 모은 단계 · now 방의 시간 }
function Passives.vs(h, mob, info): number
	local class = BY[h.class]
	if not class then
		return 1
	end
	local mul = 1
	if class.stunned and ((mob.stun or 0) > 0 or (mob.bind or 0) > 0) then
		mul *= 1 + sum(h, "stunned")
	end
	if class.healthy then
		local fx, s = Passives.get(h, "healthy")
		if fx then
			if mob.hp >= mob.maxHp * fx.healthyAt then
				mul *= 1 + fx.healthy * s
			end
			if info and (info.charge or 0) > 0 then
				mul *= 1 + fx.perCharge * s * info.charge
			end
		end
	end
	if class.low then
		local fx, s = Passives.get(h, "low")
		if fx and mob.hp < mob.maxHp * fx.lowAt then
			mul *= 1 + fx.low * s
		end
	end
	if class.far then
		local fx, s = Passives.get(h, "far")
		if fx and math.abs(mob.x - h.x) >= fx.farAt then
			mul *= 1 + fx.far * s
		end
	end
	local p = h.pass
	if class.streak and p then
		local fx, s = Passives.get(h, "streak")
		if fx and p.streak > 0 and info and info.now - p.streakAt <= fx.streakTime then
			mul *= 1 + fx.streak * s * math.min(p.streak, fx.streakMax)
		end
	end
	if class.press and p then
		local fx, s = Passives.get(h, "press")
		if fx and p.press == mob and info and info.now - p.pressAt <= fx.pressTime then
			mul *= 1 + fx.press * s * math.min(p.pressN, fx.pressMax)
		end
	end
	-- 옛 사냥기의 피해 +
	if class.skills and info and info.skill then
		for _, id in class.skills do
			local s = scaleOf(h, id)
			if s > 0 and table.find(PASS[id].fx.skills, info.skill) then
				mul *= 1 + PASS[id].fx.boost * s
			end
		end
	end
	return mul
end

-- 기술의 한 타가 그 적에게 맞았다: 이어 맞힌 수 · 이어 때린 수를 센다(살라맨더)
function Passives.onHit(h, mob, now: number)
	local p = h.pass
	local class = BY[h.class]
	if not p or not class then
		return
	end
	if class.streak then
		local fx = Passives.get(h, "streak")
		if fx then
			p.streak = if now - p.streakAt <= fx.streakTime then math.min(fx.streakMax, p.streak + 1) else 1
			p.streakAt = now
		end
	end
	if class.press then
		local fx = Passives.get(h, "press")
		if fx then
			p.pressN = if p.press == mob and now - p.pressAt <= fx.pressTime then math.min(fx.pressMax, p.pressN + 1) else 1
			p.press, p.pressAt = mob, now
		end
	end
end

-- 치명타(사용자 2026-10-08: "치명타 확률과 치명타 터지는건 만들겁니다"): 모든 직업의 기술 타가 확률로 치명타가 된다.
--  돌려주는 것: 확률(%) · 피해의 배수 · 반드시 치명타인가(리븐의 흘리기 — 피한 직후. 쓰면 사라진다). marked = 그 적에게 내 표식이 있는가(리븐)
--   확률 = 기본(RULES.critChance) + 패시브(창 숙련) + 표식이 있는 적이면 표식의 것 · 배수 = 기본(RULES.critMul) + 패시브(달인) + 표식이 있는 적이면 급소
function Passives.crit(h, marked: boolean?): (number, number, boolean)
	local chance, mul = RULES.critChance + sum(h, "crit"), RULES.critMul + sum(h, "critMul")
	if marked and h.class == "riven" then
		chance += COMBAT.kit.riven.core.crit * Kit.scale(h, "core")
		mul += sum(h, "markCritMul")
	end
	return chance, mul, h.pass ~= nil and h.pass.sure == true
end

-- 기술이 닿는 거리의 배수(리퍼: 낫 숙련 · 영혼이 많을 때의 영혼 주머니)
function Passives.reach(h): number
	local class = BY[h.class]
	if not class or not class.reach then
		return 1
	end
	local add = 0
	for _, id in class.reach do
		local s = scaleOf(h, id)
		local fx = PASS[id].fx
		if s > 0 and (not fx.reachAt or h.kit.souls >= fx.reachAt) then
			add += fx.reach * s
		end
	end
	return 1 + add
end

-- ---------- 받는 피해 ----------
-- 받는 피해의 배수. casting = 기술을 쓰는 중인가(굳센 자세)
function Passives.cut(h, casting: boolean?): number
	local class = BY[h.class]
	if not class then
		return 1
	end
	local mul = 1
	if class.cut then
		local fx, s = Passives.get(h, "cut")
		if fx then
			mul *= 1 - (if casting then fx.cutCast else fx.cut) * s
		end
	end
	if class.cutHot and Kit.hot(h) then
		mul *= 1 - sum(h, "cutHot")
	end
	return mul
end

-- 회피에 더하는 것(0~1)
function Passives.dodge(h): number
	return sum(h, "dodge") / 100
end

-- 피했다: 흘리기를 배웠으면 다음 베기가 반드시 표식 치명타
function Passives.dodged(h)
	local fx = Passives.get(h, "sure")
	if fx and h.pass then
		h.pass.sure = true
	end
end

-- 쓰러질 피해를 받았다(살라맨더의 재점화): 버틸 수 있으면 열기를 모두 태우고, 남길 체력을 돌려준다(못 버티면 nil). now = 방의 시간
function Passives.rekindle(h, now: number): number?
	local fx, s = Passives.get(h, "rekindle")
	if not fx or not h.pass or now < h.pass.rekindle then
		return nil
	end
	h.pass.rekindle = now + fx.cd
	h.kit.heat = 0
	return math.max(1, math.floor(h.maxHp * fx.rekindle * s + 0.5))
end

return Passives

end
MODULES['ReplicatedStorage/shared/lune/sim/physics'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 횡스크롤 움직임 — 달리기 · 뛰기 · 떨어지기 · 발판. 화면과 상관없는 셈만 한다(클라이언트가 제 캐릭터를 움직이고, 서버가 같은 식으로 따져 본다).
--  공방 「횡스크롤 시험」 탭(dino-workshop/js/lune/luneTab.js)의 step()을 그대로 옮겼다.
--  장면의 칸(rows): "#" 막힌 칸 · "=" 아래에서 올라탈 수 있는 얇은 발판(↓를 누른 채 뛰기를 누르면 내려간다 — 하단 점프) · "^" 가시 · "." 빈 칸.
--  body = { x, y, vx, vy, ground, air = 땅을 떠난 뒤 공중에서 뛴 수(2단 점프 — 땅에 닿으면 0) } — (x, y)는 발밑 가운데.  input = { mx = -1 | 0 | 1, jump = 이번 걸음에 뛰기를 눌렀나, down = ↓를 누르고 있나, speed = 빠르기 배수(없으면 1),
--          vx = 가로 빠르기를 직접 준다(대쉬 · 기술 중의 이동), float = 떨어지지 않는다(대쉬) }
local G = require(script.Parent.Parent.config.game)
local COMBAT = require(script.Parent.Parent.data["combat.generated"])
-- 바닷속(scene.sea): 걷기는 조금 느리고, 뛰면 느리게 높이 떴다가 천천히 가라앉는다(공방 combat.js의 sea — 시험 탭과 같은 숫자)
local SEA = COMBAT.rules.sea

local T = G.TILE
local HALF = G.BOX_W / 2

local P = {}

-- 칸 하나. 맵 위는 빈 칸, 맵 아래와 좌우 밖은 막힌 칸이다.
function P.cell(scene, tx: number, ty: number): string
	if ty < 0 then
		return "."
	end
	if ty >= scene.h or tx < 0 or tx >= scene.w then
		return "#"
	end
	return string.sub(scene.rows[ty + 1], tx + 1, tx + 1)
end

-- 발밑 가운데가 (x, y)인 몸 상자가 막힌 칸에 걸리는가.
function P.solidBox(scene, x: number, y: number): boolean
	for ty = math.floor((y - G.BOX_H) / T), math.floor((y - 1) / T) do
		for tx = math.floor((x - HALF) / T), math.floor((x + HALF - 1) / T) do
			if P.cell(scene, tx, ty) == "#" then
				return true
			end
		end
	end
	return false
end

-- 가시(^)에 닿아 있는가: 발이 놓인 칸이 가시일 때(몸 폭에서 양옆 두 점씩 뺀 안쪽 — 스치기만 한 것은 치지 않는다). 가시 위로 뛰어넘는 동안에는 닿지 않는다.
--  닿으면 약한 피해를 입는다(서버 — sim/room.luau의 step. 사용자 2026-10-08: "맵에 가시 있잖아요 그거 닿으면 데미지 입게 약한데미지 입게하세요")
function P.onSpike(scene, x: number, y: number): boolean
	local ty = math.floor((y - 1) / T)
	for tx = math.floor((x - HALF + 2) / T), math.floor((x + HALF - 3) / T) do
		if P.cell(scene, tx, ty) == "^" then
			return true
		end
	end
	return false
end

-- 발밑이 얇은 발판(=)뿐인가 — 하단 점프를 할 수 있는 자리. 몸 폭 안의 발밑 칸에 막힌 칸(#)이 하나라도 있으면 아니다(그 칸이 받친다)
function P.onPlatform(scene, body): boolean
	local ty = math.floor(body.y / T)
	if body.y ~= ty * T then
		return false
	end
	local found = false
	for tx = math.floor((body.x - HALF) / T), math.floor((body.x + HALF - 1) / T) do
		local k = P.cell(scene, tx, ty)
		if k == "#" then
			return false
		elseif k == "=" then
			found = true
		end
	end
	return found
end

function P.newBody(scene)
	return { x = scene.spawn.x, y = scene.spawn.y, vx = 0, vy = 0, ground = false }
end

function P.respawn(scene, body)
	body.x, body.y, body.vx, body.vy, body.ground = scene.spawn.x, scene.spawn.y, 0, 0, false
	body.air = 0
end

-- 한 걸음(dt초). 맵 아래로 떨어져 시작 자리로 돌아갔으면 "respawn"을 돌려준다.
--  가시("^")는 닿아도 시작 자리로 돌려보내지 않는다 — 사용자 2026-10-07: "가시맞고 돌아가는거 없애세요 가시맞고 돌아간다음에 몬스터랑 전투도안되고 고장나네요"
--   (2026-10-08부터는 닿으면 약한 피해를 입는다 — 위의 onSpike. 움직임은 그대로다)
--   (고장난 까닭: 화면에서만 시작 자리로 옮겨지고 서버는 그 순간이동을 믿지 않아, 그 뒤로 서버가 아는 자리와 어긋났다. 맵 아래로 떨어진 때를 위해 서버는 시작 자리로 온 보고는 받는다 — world.luau의 onMove)
function P.step(scene, body, input, dt: number): string?
	local mx = input.mx or 0
	local sea = if scene.sea then SEA else nil
	-- body.run · body.jump = 걸음 · 뛰는 힘의 배수(패시브 — 리븐의 날랜 몸 · 살라맨더의 뜨거운 피. 없으면 1)
	body.vx = if input.vx ~= nil then input.vx else mx * G.RUN * (input.speed or 1) * (body.run or 1) * (if sea then sea.run else 1)
	if input.jump and not body.ground and not input.float and (body.air or 0) < G.AIR_JUMPS then
		-- 2단 점프: 공중에서 뛰기를 한 번 더 누르면 그 자리에서 다시 뛰어오른다(전 직업 — 사용자 2026-10-11). 발판에서 걸어 떨어진 뒤에도 한 번 된다.
		--  땅에 닿으면 다시 센다. 바닷속에서도 같다(뛰는 힘만 바닷속의 것)
		body.air = (body.air or 0) + 1
		body.vy = -G.JUMP * G.JUMP2 * (body.jump or 1) * (if sea then sea.jump else 1)
	elseif input.jump and body.ground and not input.float then
		body.air = 0
		if input.down and P.onPlatform(scene, body) then
			-- 하단 점프: 발판 위에서 ↓ 를 누른 채 뛰기를 누르면 그 발판을 지나 내려간다(↓ 만으로는 내려가지 않는다).
			--  사용자 2026-10-08: "하단점프가 지금 그냥 아래키만 누르면 지금 하단점프인데 아래방향+점프키 여야 하단점프되어야합니다."
			--  발을 발판의 윗면 바로 아래로 옮긴다 — 그 발판은 더 받치지 않고, 그 아래의 발판 · 땅에는 평소처럼 선다
			body.y += 1
			body.vy = 0
			body.ground = false
		else
			body.vy = -G.JUMP * (body.jump or 1) * (if sea then sea.jump else 1)
			body.ground = false
		end
	end

	local nx = body.x + body.vx * dt
	if not P.solidBox(scene, nx, body.y) then
		body.x = nx
	end

	body.vy = if input.float then 0 else math.min(body.vy + G.GRAVITY * (if sea then sea.grav else 1) * dt, if sea then sea.fall else G.MAX_FALL) -- 대쉬 중에는 높이를 지킨다
	local ny = body.y + body.vy * dt
	if input.float then
		-- 떨어지지 않는다
	elseif body.vy >= 0 then
		-- 내려가는 중: 막힌 칸이나 발판 윗면에 선다
		local land: number? = nil
		local ty = math.floor(body.y / T)
		while ty <= math.floor(ny / T) and land == nil do
			for tx = math.floor((body.x - HALF) / T), math.floor((body.x + HALF - 1) / T) do
				local k = P.cell(scene, tx, ty)
				if k == "#" or (k == "=" and body.y <= ty * T) then
					land = ty * T
					break
				end
			end
			ty += 1
		end
		if land ~= nil and ny >= land then
			body.y, body.vy, body.ground = land, 0, true
			body.air = 0 -- 땅에 닿았다: 2단 점프를 다시 쓴다
		else
			body.y, body.ground = ny, false
		end
	elseif P.solidBox(scene, body.x, ny) then
		body.vy = 0 -- 머리가 닿았다
	else
		body.y, body.ground = ny, false
	end

	if body.y > scene.h * T + G.FALL_OUT then
		P.respawn(scene, body)
		return "respawn"
	end
	return nil
end

-- 지금 보일 동작 이름(서 있기 · 달리기 · 뛰기 · 떨어지기)
function P.clipOf(body, mx: number): string
	if not body.ground then
		return if body.vy < 0 then "jump" else "fall"
	end
	return if mx ~= 0 then "run" else "idle"
end

return P

end
MODULES['ReplicatedStorage/shared/lune/sim/quests'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 퀘스트의 셈 — 받기 · 잡은 것 세기 · 다 됐는지 · 돌려주기. 화면도 서버도 모르는 순수한 셈이다.
--  자료는 data/quests.generated.luau(공방 js/lune/design/questplay.js에서 내보낸 것): 누구에게서 받고 · 무엇을 몇 개 · 누구에게 돌려주고 · 무엇을 받나.
--  사람마다의 상태(book) = { [퀘스트 id] = { done = 끝냈는가, c = { [할 일 차례] = 지금까지의 수 } } } — 받지 않은 퀘스트는 들어 있지 않다.
--  서버는 캐릭터의 표에(h.quests), 클라이언트는 서버가 보내 준 것을 그대로 갖고 같은 함수로 주민 머리 위의 표시와 알리미를 셈한다.
local D = require(script.Parent.Parent.data["quests.generated"])

local Q = {}
Q.list = D.list
Q.MAX_ACTIVE = 10 -- 한 번에 받아 둘 수 있는 수

local byId = {}
for i, def in D.list do
	byId[def.id] = def
	def.order = i
end

function Q.def(id: any)
	return if typeof(id) == "string" then byId[id] else nil
end

-- 할 일 하나를 화면에 적는 꼴: 「수습 검병 3/5」
function Q.stepText(step, have: number): string
	return ("%s %d/%d"):format(step.name, math.min(have, step.n), step.n)
end

-- 받침이 있으면 a, 없으면 b(을 · 를 / 이 · 가)를 고른다 — 한글로 끝나지 않으면 a
local function josa(word: string, a: string, b: string): string
	local last = nil
	for _, code in utf8.codes(word) do
		last = code
	end
	if last and last >= 0xAC00 and last <= 0xD7A3 and (last - 0xAC00) % 28 == 0 then
		return b
	end
	return a
end
Q.josa = josa

-- 그 일을 어디서 무엇을 잡아 하는가: 「달그림자 사냥터의 검병을 잡으면 떨어진다」 · 「마을 어귀에 있다」
--  사용자 2026-10-07: "뭘잡아야 갑옷조각이 나오는지를 자연스럽게 적어둬야 퀘스트를 진행할거아닙니까 이렇게 적으면 누가 어떻게 알아요"
function Q.stepHint(def, step): string
	local SCENES = require(script.Parent.Parent.data["scenes.generated"])
	local COMBAT = require(script.Parent.Parent.data["combat.generated"])
	local scene = def.scene and SCENES.scenes[def.scene]
	local place = if scene then scene.name else "이 근처"
	local mob = COMBAT.mobs[step.mob]
	local name = if mob then mob.name else step.name
	if step.type == "gather" then
		return ("%s의 %s%s 잡으면 떨어진다"):format(place, name, josa(name, "을", "를"))
	elseif step.type == "use" then
		return ("%s — %s 앞에서 ↑"):format(place, step.place) -- 맵에 놓인 것 앞에서 ↑를 누르는 일
	end
	return ("%s에 있다"):format(place)
end

-- 아직 다 하지 못한 일들의 길잡이(퀘스트 창에 적는다)
function Q.hints(book, id: string): { string }
	local def, st = byId[id], book[id]
	local out = {}
	if def and st then
		for i, step in def.steps do
			if (st.c[i] or 0) < step.n then
				table.insert(out, Q.stepHint(def, step))
			end
		end
	end
	return out
end

-- 알리미에 적는 한 줄: 모으는 일은 떨어뜨리는 졸개의 이름을 앞에 — 「검병 · 갑옷 조각 0/8」
function Q.trackText(step, have: number): string
	if step.type == "gather" then
		local COMBAT = require(script.Parent.Parent.data["combat.generated"])
		local mob = COMBAT.mobs[step.mob]
		if mob then
			return ("%s · %s"):format(mob.name, Q.stepText(step, have))
		end
	end
	return Q.stepText(step, have)
end

-- 받아 둔 퀘스트의 할 일이 다 됐는가
function Q.isReady(book, id: string): boolean
	local def, st = byId[id], book[id]
	if not def or not st or st.done then
		return false
	end
	for i, step in def.steps do
		if (st.c[i] or 0) < step.n then
			return false
		end
	end
	return true
end

-- 퀘스트의 지금 모습: "done" 끝냄 · "ready" 돌려주면 된다 · "active" 하는 중 · "open" 받을 수 있다 · "locked" 아직 못 받는다
function Q.state(book, level: number, id: string): string
	local def, st = byId[id], book[id]
	if not def then
		return "locked"
	elseif st then
		return if st.done then "done" elseif Q.isReady(book, id) then "ready" else "active"
	elseif not def.playable or level < def.lv then
		return "locked"
	elseif def.after and not (book[def.after] and book[def.after].done) then
		return "locked"
	end
	return "open"
end

local function activeCount(book): number
	local n = 0
	for _, st in book do
		if not st.done then
			n += 1
		end
	end
	return n
end

-- 받는다
function Q.accept(book, level: number, id: any): (boolean?, string?)
	local def = Q.def(id)
	if not def then
		return nil, "없는 퀘스트다"
	end
	local state = Q.state(book, level, id)
	if state == "locked" then
		return nil, if level < def.lv then ("Lv.%d부터 받는다"):format(def.lv) else "아직 받을 수 없다"
	elseif state ~= "open" then
		return nil, "이미 받은 퀘스트다"
	elseif activeCount(book) >= Q.MAX_ACTIVE then
		return nil, "퀘스트를 더 받을 수 없다"
	end
	book[id] = { done = false, c = {} }
	return true
end

-- 저절로 받는 퀘스트(자료의 auto) — 지금은 하나도 없다: 모든 퀘스트는 주는 주민에게 말을 걸어 받는다
--  (사용자 2026-10-11: "퀘스트를 부여해주는 npc 랑 말을하고 퀘스트를 수락해야 퀘스트가 수락되고 … 정석적으로". 전에는 새 캐릭터의 「첫 기술」과 전직 퀘스트를 여기서 저절로 받았다.)
--  공방의 검사가 auto를 막는다. 이 함수는 빈 표를 돌려준다(부르는 곳들은 그대로 둔다)
function Q.start(book, level: number): { string }
	local got = {}
	for _, def in D.list do
		if def.auto and Q.state(book, level, def.id) == "open" then
			if Q.accept(book, level, def.id) then
				table.insert(got, def.id)
			end
		end
	end
	return got
end

-- 새 캐릭터가 서는 곳: 첫 퀘스트(「첫 기술」)를 끝내기 전에는 그것을 주는 사제의 사당 안(공방 questplay.js의 FIRST) — 끝낸 뒤에는 nil(마을의 시작 자리).
--  Lv.1일 때만이다: 첫 퀘스트를 건너뛰고 자란 예전 캐릭터(이 규칙이 생기기 전 — 2026-10-10)는 하던 대로 마을에서 시작하고 기술도 그대로 쓴다.
--  받기 전(사제에게 아직 말을 걸지 않았다)이든 받은 뒤든, 끝내기 전이면 새 캐릭터다
Q.FIRST = D.first
function Q.isNew(book, level: number): boolean
	local st = book[D.first.quest]
	return level <= 1 and not (st ~= nil and st.done)
end
function Q.firstScene(book, level: number): string?
	return if Q.isNew(book, level) then D.first.scene else nil
end

-- 그 차수로 올려 주는 전직 퀘스트(없으면 nil — 그 차수는 레벨만 되면 오른다)
function Q.jobQuest(job: number)
	for _, def in D.list do
		if def.kind == "job" and def.playable and def.reward.job == job then
			return def
		end
	end
	return nil
end

-- 이미 닿은 차수의 전직 퀘스트는 끝낸 것으로 적는다(전직 퀘스트가 생기기 전의 캐릭터 · 확인용 캐릭터가 다시 받지 않게)
function Q.jobsDone(book, job: number)
	for _, def in D.list do
		if def.kind == "job" and def.reward.job and def.reward.job <= job then
			book[def.id] = { done = true, c = {} }
		end
	end
end

-- 졸개를 잡았다. 바뀐 퀘스트들의 id를 돌려준다(없으면 빈 표). 잡는 일만 센다 — 모으는 물건은 땅에 떨어지고(Q.drops) 주우면 가방에 들어가며, 가방에 든 수가 곧 숫자다(Q.sync)
function Q.onKill(book, mobKind: string, scene: string): { string }
	local changed = {}
	for id, st in book do
		local def = byId[id]
		if def and not st.done and def.scene == scene then
			for i, step in def.steps do
				local have = st.c[i] or 0
				if step.type == "kill" and step.mob == mobKind and have < step.n then
					st.c[i] = have + 1
					table.insert(changed, id)
				end
			end
		end
	end
	return changed
end

-- 그 장면의 그 몬스터를 아직 잡아야 하는가(하는 중인 퀘스트의 못 다 한 잡기). 스토리 보스는 이것이 참인 사람이 방에 있을 때만 서 있다(sim/room.luau)
-- 그 퀘스트에 닿았는가: 받았거나(하는 중) 끝냈다 — 그 퀘스트를 받아야 열리는 문(장면의 portals의 need — 사당 지하)이 쓴다
function Q.reached(book, id: any): boolean
	return book ~= nil and typeof(id) == "string" and book[id] ~= nil
end

function Q.wantsKill(book, mobKind: string, scene: string): boolean
	if not book then
		return false
	end
	for id, st in book do
		local def = byId[id]
		if def and not st.done and def.scene == scene then
			for i, step in def.steps do
				if step.type == "kill" and step.mob == mobKind and (st.c[i] or 0) < step.n then
					return true
				end
			end
		end
	end
	return false
end

-- ---------- 맵에 놓인 것 앞에서 ↑를 누르는 일(type "use") ----------
Q.USE_REACH = { x = 30, y = 24 } -- 그 자리에서 이만큼 안에 서야 한다(게임의 도트 — 주민에게 말을 걸 때와 같은 폭)

-- 그 장면에서 지금 ↑를 누를 수 있는 자리들: 하는 중인 퀘스트의 아직 못 한 일. { { quest, step, x, y, up(「!」의 높이), place, act } … }(자료의 차례)
function Q.spotsIn(book, scene: string)
	local out = {}
	for _, def in D.list do
		local st = book[def.id]
		if st and not st.done and def.scene == scene then
			for i, step in def.steps do
				if step.type == "use" and (st.c[i] or 0) < step.n then
					table.insert(out, { quest = def.id, step = i, x = step.x, y = step.y, up = step.up, place = step.place, act = step.act })
				end
			end
		end
	end
	return out
end

-- 그 자리 앞에서 ↑를 눌렀다: 그 퀘스트의 아직 못 한 일 가운데 가까이에 있는 것의 숫자가 하나 오른다. 됐으면 true(아니면 nil과 까닭)
function Q.use(book, id: any, scene: string, x: number, y: number): (boolean?, string?)
	local def = Q.def(id)
	local st = def and book[id]
	if not def or not st or st.done then
		return nil, "하는 중인 퀘스트가 아니다"
	elseif def.scene ~= scene then
		return nil, "여기가 아니다"
	end
	for i, step in def.steps do
		if step.type == "use" and (st.c[i] or 0) < step.n then
			if math.abs(step.x - x) <= Q.USE_REACH.x and math.abs(step.y - y) <= Q.USE_REACH.y then
				st.c[i] = (st.c[i] or 0) + 1
				return true
			end
			return nil, "그 자리 앞이 아니다"
		end
	end
	return nil, "여기서 할 일이 없다"
end

-- 졸개를 잡았을 때 떨어지는 퀘스트의 물건들: 아직 모으는 중인 물건마다 그 확률(pct)로 하나. { { quest, step, name, icon } … }
--  사용자 2026-10-07: "퀘스트 아이템이나 , 기타아이템들은 왜 드롭도되지않고 그림도없고 그냥 텍스트로만 오르나요?" — 잡으면 숫자만 오르던 것을, 그림이 있는 물건이 땅에 떨어지고 주워야 오르게 고쳤다
function Q.drops(book, mobKind: string, scene: string, rng)
	local out = {}
	for id, st in book do
		local def = byId[id]
		if def and not st.done and def.scene == scene then
			for i, step in def.steps do
				if step.type == "gather" and step.mob == mobKind and (st.c[i] or 0) < step.n and rng:NextNumber(0, 100) < step.pct then
					table.insert(out, { quest = id, step = i, name = step.name, icon = step.icon, goods = step.item })
				end
			end
		end
	end
	return out
end

-- 모으는 일의 숫자를 가방에 맞춘다 — 모으는 물건은 가방의 기타 탭에 놓이는 진짜 아이템이고, 가방에 든 수가 곧 퀘스트의 숫자다
--  (사용자 2026-10-08: "품목이 고정되어있고 거기서 수량 1/8 이런식으로 표기하는게 인벤토리가 아닙니다" — 숫자를 따로 세던 것을 고쳤다. 버리면 숫자도 준다).
--  count(이름표) → 가방에 든 수. 바뀐 것이 있으면 true(부른 쪽이 화면에 알린다)
function Q.sync(book, count: (string) -> number): boolean
	local changed = false
	for id, st in book do
		local def = byId[id]
		if def and not st.done then
			for i, step in def.steps do
				if step.type == "gather" and step.item then
					local have = math.min(step.n, count(step.item))
					if (st.c[i] or 0) ~= have then
						st.c[i] = have
						changed = true
					end
				end
			end
		end
	end
	return changed
end

-- 그 퀘스트가 모으게 하는 물건들 { { item = 이름표, n = 모을 수 } … }(돌려줄 때 가방에서 빠진다)
function Q.takes(id: any)
	local out = {}
	local def = byId[id]
	for _, step in if def then def.steps else {} do
		if step.type == "gather" and step.item then
			table.insert(out, { item = step.item, n = step.n })
		end
	end
	return out
end

-- 하는 중인 퀘스트 가운데 그 물건을 모으는 것이 있는가(except = 빼고 볼 퀘스트)
function Q.wants(book, item: string, except: string?): boolean
	for id, st in book do
		local def = byId[id]
		if def and not st.done and id ~= except then
			for _, step in def.steps do
				if step.type == "gather" and step.item == item then
					return true
				end
			end
		end
	end
	return false
end

-- 돌려준다. 끝낸 것으로 적고 보상을 돌려준다(보상을 실제로 주는 것은 부른 쪽 — sim/hero.luau의 questDone)
function Q.complete(book, id: any)
	local def = Q.def(id)
	if not def or not book[id] then
		return nil, "받지 않은 퀘스트다"
	elseif book[id].done then
		return nil, "이미 끝낸 퀘스트다"
	elseif not Q.isReady(book, id) then
		return nil, "아직 다 하지 못했다"
	end
	book[id].done = true
	return def.reward
end

-- 그만둔다(메인은 그만둘 수 없다). 다시 받으면 처음부터다
function Q.drop(book, id: any): (boolean?, string?)
	local def = Q.def(id)
	if not def or not book[id] or book[id].done then
		return nil, "하는 중인 퀘스트가 아니다"
	elseif def.kind ~= "side" then
		return nil, if def.kind == "job" then "전직 퀘스트는 그만둘 수 없다" else "메인 퀘스트는 그만둘 수 없다"
	end
	book[id] = nil
	return true
end

-- 그 주민에게서 할 수 있는 것: ready = 돌려줄 것 · offer = 받을 것 · wait = 받아서 하는 중인 것(이 주민에게 돌려줄 것)
--  region = 그 주민이 서 있는 맵의 지역(장면 자료의 region). 여러 맵에 서는 주민(샛별 · 반달 · 하늬 …)은 제가 선 지역의 퀘스트만 준다 — 돌려받는 것은 어디서든 한다. 주지 않으면(nil) 가리지 않는다
function Q.atNpc(book, level: number, npc: string, region: any?)
	local out = { ready = {}, offer = {}, wait = {} }
	for _, def in D.list do
		local state = Q.state(book, level, def.id)
		if def.endNpc == npc and state == "ready" then
			table.insert(out.ready, def.id)
		elseif def.giver == npc and state == "open" and not def.auto and (region == nil or def.region == region or def.kind == "job") then -- 전직 퀘스트는 사제가 어디서든 준다
			table.insert(out.offer, def.id)
		elseif def.endNpc == npc and state == "active" then
			table.insert(out.wait, def.id)
		end
	end
	return out
end

-- 주민 머리 위의 표시: "?" 돌려줄 것이 있다 · "!" 줄 것이 있다 · nil
function Q.mark(book, level: number, npc: string, region: any?): string?
	local at = Q.atNpc(book, level, npc, region)
	return if #at.ready > 0 then "?" elseif #at.offer > 0 then "!" else nil
end

-- ---------- 길잡이(알리미가 적는다 — 메이플스토리의 전구 구실) ----------
-- 다음에 할 메인: 아직 받지 않은 첫 메인. 돌려주는 것: 퀘스트, "open"(지금 받을 수 있다) · "level"(레벨이 모자란다). 앞의 메인을 하는 중이면 nil
function Q.nextMain(book, level: number)
	for _, def in D.list do
		if def.kind == "main" and def.playable and not book[def.id] then
			if Q.state(book, level, def.id) == "open" then
				return def, "open"
			elseif level < def.lv and (not def.after or (book[def.after] ~= nil and book[def.after].done)) then
				return def, "level"
			end
			return nil
		end
	end
	return nil
end

-- 지금 받을 수 있는 전직 퀘스트들(레벨이 됐다 — 그믐 사제에게 가서 받는다)
function Q.openJobs(book, level: number)
	local out = {}
	for _, def in D.list do
		if def.kind == "job" and def.playable and not def.auto and Q.state(book, level, def.id) == "open" then
			table.insert(out, def)
		end
	end
	return out
end

-- 지금 받을 수 있는 주민의 부탁들(자료의 차례)
function Q.openSides(book, level: number)
	local out = {}
	for _, def in D.list do
		if def.kind == "side" and not def.auto and Q.state(book, level, def.id) == "open" then
			table.insert(out, def)
		end
	end
	return out
end

-- 퀘스트 창의 「시작 가능」(메이플스토리의 퀘스트 창처럼): 지금 받을 수 있는 것(메인 먼저 · 그다음 부탁 — 자료의 차례), 맨 끝에 레벨이 모자란 다음 메인 하나(그 줄은 Q.state가 "locked"다)
function Q.listOpen(book, level: number): { string }
	local out = {}
	for _, def in Q.openJobs(book, level) do
		table.insert(out, def.id) -- 전직 퀘스트가 맨 위
	end
	for _, def in D.list do
		if def.kind == "main" and not def.auto and Q.state(book, level, def.id) == "open" then
			table.insert(out, def.id)
		end
	end
	for _, def in Q.openSides(book, level) do
		table.insert(out, def.id)
	end
	local main, why = Q.nextMain(book, level)
	if main and why == "level" then
		table.insert(out, main.id)
	end
	return out
end

-- 퀘스트 창의 「완료」: 끝낸 것(자료의 차례 — 전직 · 메인 · 부탁)
function Q.listDone(book): { string }
	local out = {}
	for _, def in D.list do
		local st = book[def.id]
		if st and st.done then
			table.insert(out, def.id)
		end
	end
	return out
end

-- 그 퀘스트를 주는 주민이 서 있는 맵의 이름 — 그 퀘스트의 지역 안에서(주민은 제가 선 지역의 퀘스트만 준다).
--  여러 맵에 서 있으면(샛별 · 반달 · 하늬) 그 퀘스트를 하는 맵에서 문으로 가장 가까운 곳 — 같으면 몬스터가 없는 맵, 그다음은 이름표의 차례. 못 찾으면 nil
local placeOf = {}
-- 그 주민이 서 있는 장면의 이름표(월드맵이 그 맵에 ! 를 찍는다). 못 찾으면 nil
function Q.npcScene(def, npcId: string): string?
	local cacheKey = def.id .. "|" .. npcId
	if placeOf[cacheKey] ~= nil then
		return placeOf[cacheKey] or nil
	end
	local SCENES = require(script.Parent.Parent.data["scenes.generated"])
	-- 퀘스트를 하는 맵에서 문을 몇 번 지나야 닿는가
	local dist = {}
	if def.scene and SCENES.scenes[def.scene] then
		dist[def.scene] = 0
		local queue, at = { def.scene }, 1
		while queue[at] do
			local key = queue[at]
			at += 1
			for _, p in SCENES.scenes[key].portals or {} do
				if SCENES.scenes[p.to] and dist[p.to] == nil then
					dist[p.to] = dist[key] + 1
					table.insert(queue, p.to)
				end
			end
		end
	end
	local keys = {}
	for key, sc in SCENES.scenes do
		if sc.region == def.region then
			for _, n in sc.npcs or {} do
				if n.id == npcId then
					table.insert(keys, key)
					break
				end
			end
		end
	end
	table.sort(keys, function(a, b)
		local da, db = dist[a] or math.huge, dist[b] or math.huge
		if da ~= db then
			return da < db
		end
		local qa, qb = #(SCENES.scenes[a].mobs or {}) == 0, #(SCENES.scenes[b].mobs or {}) == 0
		if qa ~= qb then
			return qa
		end
		return a < b
	end)
	placeOf[cacheKey] = keys[1] or false
	return keys[1]
end
-- 그 퀘스트를 주는 주민이 선 장면 · 돌려받는 주민이 선 장면
function Q.giverScene(def): string?
	return Q.npcScene(def, def.giver)
end
function Q.endScene(def): string?
	return Q.npcScene(def, def.endNpc)
end

-- 이야기를 따라갈 때 지금 가야 할 곳(월드맵이 거기까지의 길을 그린다 — 메이플스토리의 월드맵이 가는 길을 보여 주듯):
--  하는 중인 전직 · 메인 퀘스트가 있으면 그 퀘스트를 하는 맵(다 했으면 돌려받는 주민이 선 곳), 없으면 지금 받을 수 있는 다음 메인을 주는 주민이 선 곳.
--  { def, scene, kind = "do"(하러) · "back"(돌려주러) · "take"(받으러) } — 갈 곳이 없으면 nil(레벨이 모자라 다음 메인을 못 받을 때)
function Q.goal(book, level: number)
	for _, id in Q.active(book) do
		local def = byId[id]
		if def.kind == "job" or def.kind == "main" then
			if Q.state(book, level, id) == "ready" then
				local scene = Q.endScene(def)
				if scene then
					return { def = def, scene = scene, kind = "back" }
				end
			elseif def.scene then
				return { def = def, scene = def.scene, kind = "do" }
			end
		end
	end
	-- 받을 수 있는 전직 퀘스트가 있으면 그것을 주는 사제에게 먼저
	for _, job in Q.openJobs(book, level) do
		local scene = Q.giverScene(job)
		if scene then
			return { def = job, scene = scene, kind = "take" }
		end
	end
	local def, why = Q.nextMain(book, level)
	if def and why == "open" and not def.auto then
		local scene = Q.giverScene(def)
		if scene then
			return { def = def, scene = scene, kind = "take" }
		end
	end
	return nil
end

function Q.giverPlace(def): string?
	local key = Q.giverScene(def)
	return if key then require(script.Parent.Parent.data["scenes.generated"]).scenes[key].name else nil
end

-- 알리미의 길잡이 줄들: { { title, line, kind = "job" | "open" | "level" | "side" } … } — 받을 수 있는 전직 퀘스트 · 다음 메인 하나 · 받을 수 있는 부탁 둘까지. names = 주민 id → 이름
function Q.guide(book, level: number, names)
	local out = {}
	local function who(def): string
		return (names and names[def.giver]) or "주민"
	end
	for _, def in Q.openJobs(book, level) do
		local place = Q.giverPlace(def)
		table.insert(out, { title = "! " .. def.name, line = if place then ("%s에게 받는다 · %s"):format(who(def), place) else ("%s에게 받는다"):format(who(def)), kind = "job" })
	end
	local main, why = Q.nextMain(book, level)
	if main and why == "open" then
		local place = Q.giverPlace(main)
		table.insert(out, { title = "! " .. main.name, line = if place then ("%s에게 받는다 · %s"):format(who(main), place) else ("%s에게 받는다"):format(who(main)), kind = "open" })
	elseif main then
		table.insert(out, { title = main.name, line = ("Lv.%d부터 받는다"):format(main.lv), kind = "level" })
	end
	local sides = Q.openSides(book, level)
	for i = 1, math.min(2, #sides) do
		local def = sides[i]
		local place = Q.giverPlace(def)
		table.insert(out, { title = "! " .. def.name, line = if place then ("%s에게 받는다 · %s"):format(who(def), place) else ("%s에게 받는다"):format(who(def)), kind = "side" })
	end
	return out
end

-- 하는 중인 퀘스트들(전직 퀘스트가 맨 위 · 메인 · 그다음은 받은 차례가 아니라 자료의 차례)
local KIND_ORDER = { job = 1, main = 2, side = 3 }
function Q.active(book): { string }
	local list = {}
	for id, st in book do
		if not st.done and byId[id] then
			table.insert(list, id)
		end
	end
	table.sort(list, function(a, b)
		local da, db = byId[a], byId[b]
		local ka, kb = KIND_ORDER[da.kind] or 9, KIND_ORDER[db.kind] or 9
		if ka ~= kb then
			return ka < kb
		end
		return da.order < db.order
	end)
	return list
end

-- 알리미에 적는 줄들: 할 일이 남았으면 그것들, 다 됐으면 「○○에게 돌아간다」. names = 주민 id → 이름
function Q.todo(book, id: string, names): { string }
	local def, st = byId[id], book[id]
	local out = {}
	if not def or not st then
		return out
	end
	for i, step in def.steps do
		if (st.c[i] or 0) < step.n then
			table.insert(out, Q.trackText(step, st.c[i] or 0))
		end
	end
	if #out == 0 then
		table.insert(out, ("%s에게 간다"):format((names and names[def.endNpc]) or "주민"))
	end
	return out
end

-- 클라이언트에 보내는 꼴(수의 표를 빈 데 없이 채운다 — 빈 데가 있으면 보낼 때 잘린다)
function Q.view(book)
	local out = {}
	for id, st in book do
		local def = byId[id]
		if def then
			local counts = {}
			for i in def.steps do
				counts[i] = st.c[i] or 0
			end
			out[id] = { done = st.done, c = counts }
		end
	end
	return out
end

-- ---------- 저장 ----------
function Q.pack(book)
	local out = {}
	for id, st in book do
		if byId[id] then
			local counts = {}
			for i, step in byId[id].steps do
				counts[i] = math.min(st.c[i] or 0, step.n)
			end
			out[id] = { d = if st.done then 1 else 0, c = counts }
		end
	end
	return out
end

-- 저장된 것을 되살린다(모르는 퀘스트 · 이상한 수는 버린다)
function Q.unpack(data: any)
	local book = {}
	if typeof(data) ~= "table" then
		return book
	end
	for id, row in data do
		local def = Q.def(id)
		if def and typeof(row) == "table" then
			local st = { done = row.d == 1, c = {} }
			if typeof(row.c) == "table" then
				for i, step in def.steps do
					local n = row.c[i]
					if typeof(n) == "number" and n == math.floor(n) and n >= 0 then
						st.c[i] = math.min(n, step.n)
					end
				end
			end
			book[id] = st
		end
	end
	return book
end

return Q

end
MODULES['ReplicatedStorage/shared/lune/sim/rank'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 명예의 전당 — 순위판 셋(레벨 · 전투력 · 후원)의 셈.
--  사용자 2026-10-10: "대형 마을마다 명예의 전당 건물 을 만들어서 최대 로벅스 결제자, 전투력 랭킹, 레벨 랭킹 이렇게 캐릭터 닉네임 보여주는 명예의 전당을 만듭니다."
--  여기는 셈만 한다(점수 · 열쇠 · 화면에 보낼 꼴). 순위의 저장(OrderedDataStore)은 서버의 store.luau, 올리고 읽는 때는 world.luau.
--   level = 캐릭터의 레벨 순위(같은 레벨이면 경험치가 많은 쪽이 위) · power = 캐릭터의 전투력 순위 · robux = 계정이 게임에 쓴 로벅스의 순위(이름은 그때 하던 캐릭터).
--  ※ 판에 올리는 수(TOP) · 다시 읽는 간격(REFRESH)은 내 제안이다.
local Rank = {}
Rank.BOARDS = { "level", "power", "robux" }
Rank.NAMES = { level = "레벨", power = "전투력", robux = "후원" }
Rank.TOP = 10 -- 판마다 보이는 수
Rank.REFRESH = 60 -- 서버가 순위를 다시 읽는 간격(초)
local XP_STEPS = 1000000 -- 같은 레벨 안에서 경험치를 가르는 눈금

-- 레벨 순위의 점수: 레벨이 먼저, 그다음 그 레벨에서 모은 경험치의 비율
function Rank.levelScore(level: number, xp: number, need: number): number
	local part = if need > 0 then math.clamp(xp / need, 0, 0.999999) else 0
	return level * XP_STEPS + math.floor(part * XP_STEPS)
end

function Rank.levelOf(score: number): number
	return score // XP_STEPS
end

-- 순위판의 열쇠: 캐릭터(레벨 · 전투력) = "c<사람 번호>_<캐릭터 번호>" · 계정(후원) = "u<사람 번호>"
function Rank.charKey(userId: number, cid: number): string
	return ("c%d_%d"):format(userId, cid)
end
function Rank.userKey(userId: number): string
	return ("u%d"):format(userId)
end

-- 판에 적는 값의 글(레벨은 Lv.N · 전투력과 후원은 숫자)
function Rank.valueText(board: string, score: number): string
	if board == "level" then
		return ("Lv.%d"):format(Rank.levelOf(score))
	end
	return tostring(score)
end

-- 화면에 보낼 판 하나: rows = { { key, score } … }(높은 차례) · infoOf(key) = { name, class } 또는 nil(이름을 모르는 줄은 뺀다)
function Rank.view(board: string, rows, infoOf)
	local out = {}
	for _, row in rows do
		local info = infoOf(row.key)
		if info and typeof(info.name) == "string" and info.name ~= "" then
			table.insert(out, { name = info.name, class = info.class, value = Rank.valueText(board, row.score), score = row.score })
			if #out >= Rank.TOP then
				break
			end
		end
	end
	return out
end

return Rank

end
MODULES['ReplicatedStorage/shared/lune/sim/room'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 맵 한 곳의 싸움 — 졸개의 움직임과 공격, 기술의 판정, 잡았을 때의 보상, 떨어진 것. 화면 · 네트워크와 상관없는 셈만 한다(서버가 쓴다).
--  수치는 data/combat.generated.luau(공방 js/lune/design/combat.js)와 config/numbers.luau에서 온다.
--  졸개는 제 발판의 범위(range) 안에서만 움직인다(뛰어내리지 않는다). 좌표는 도트, (x, y)는 발밑 가운데.
--  heroes = { [id] = sim/hero.luau의 캐릭터 } — 이 방에 있는 사람들.
local N = require(script.Parent.Parent.config.numbers)
local COMBAT = require(script.Parent.Parent.data["combat.generated"])
local Hero = require(script.Parent.hero)
local Items = require(script.Parent.items)
local Bag = require(script.Parent.bag)
local Party = require(script.Parent.party)
local Physics = require(script.Parent.physics)
local Kit = require(script.Parent.kit)
local Buffs = require(script.Parent.buffs)
local Caster = require(script.Parent.caster) -- 2~4차의 쓰는 스킬(직업 묶음의 그 스킬을 방이 돌린다)
local Passives = require(script.Parent.passives) -- 2~4차의 패시브
local Quests = require(script.Parent.quests) -- 스토리 보스: 그 퀘스트를 하는 사람이 있을 때만 선다
local BossPat = require(script.Parent.bosspat) -- 스토리 보스: 표시된 자리 · 도약 · 물결의 자리와 시간(화면과 같은 셈)
local RULES = COMBAT.rules
local CASTRULE = COMBAT.castRule
local KIT = COMBAT.kit
local UP = COMBAT.kitUp -- 사출기 강화(2~4차 패시브)
local PLACED = COMBAT.placed -- 설치 · 소환 -- 1차의 온오프 사출기 · 핵심 장치 · 패시브(직업마다 — sim/kit.luau)

local SEE_Y = 28 -- 이만큼 높이가 다르면 알아채지 못한다(다른 층)
local BODY_W, BODY_H = 6, 14 -- 졸개의 몸(반폭, 높이) — 병사
-- 새 몬스터는 종류마다 몸이 다르다(def.body = { 폭, 높이 } · def.lift = 그림이 땅에서 뜬 높이). 나는 몬스터는 지금 높이(mob.alt)만큼 더 떠 있다.
-- 돌려주는 것: 반폭, 몸의 아래 끝이 발밑(y)에서 위로 얼마, 몸의 높이
local function bodyOf(mob): (number, number, number)
	local b = mob.def.body
	if b then
		return b[1] / 2, (mob.def.lift or 0) + (mob.alt or 0), b[2]
	end
	return BODY_W, 0, BODY_H
end
local HERO_W, HERO_H = 5, 17
local SPAWN_TIME, DEAD_TIME = 0.8, 0.9
local STEP_TIME = 0.25 -- 스토리 보스가 치면서 내딛는 걸음에 걸리는 시간(초)
local BIG_HIT = 1.4 -- 센 타격: 세기 배수가 이만큼 넘는 타(대지 강타의 내려찍기 1.43 · 삼단 베기의 셋째 타 2.05 같은 것). 그 숫자는 직업의 밝은 색으로 뜬다(공방 시험 탭의 "12 넘는 피해"에 해당)

local Room = {}
Room.__index = Room
Room.bodyOf = bodyOf

function Room.new(key: string, scene, rng)
	local self = setmetatable({}, Room)
	self.key = key
	self.scene = scene
	self.rng = rng
	self.lootRng = Random.new(#key * 7919 + 101) -- 재료 · 귀한 드롭을 굴리는 난수(졸개의 움직임을 굴리는 난수와 따로 — 드롭을 더해도 싸움의 흐름이 달라지지 않는다)
	self.time = 0
	self.mobs = {}
	self.shots = {}
	self.casts = {} -- 몬스터의 마법(몸 동작과 따로 뜨는 것): { id, x, y, t, mob, def = atk.cast, done }
	self.drops = {}
	self.crystals = {} -- 무니의 달 수정 { id, owner, x, y, till } — 세운 차례대로
	self.nextId = 1
	self.caster = Caster.new(self) -- 2~4차의 쓰는 스킬을 돌리는 것(sim/caster.luau)
	for _, def in scene.mobs do
		local kind = COMBAT.mobs[def.kind]
		-- 피해 숫자의 배율(dmgScale)과 쓰임의 보정(targetBonus — 맞는 갈래의 기술은 피해가 그만큼 더 뜬다)만큼 체력도 크다: 맞는 기술로 잡는 타수는 그대로다
		local maxHp = math.max(1, math.floor(N.mobHp(def.lv) * kind.hp * RULES.dmgScale * (1 + RULES.targetBonus / 100) + 0.5))
		local mob = {
			id = #self.mobs + 1,
			kind = def.kind,
			def = kind,
			lv = def.lv,
			homeX = def.x,
			y = def.y,
			a = def.range[1],
			b = def.range[2],
			x = def.x,
			dir = if #self.mobs % 2 == 0 then 1 else -1,
			state = "spawn",
			t = 0,
			hp = maxHp,
			maxHp = maxHp,
			cd = 0,
			wait = rng:NextNumber(0, 1.5),
			goal = def.x,
			target = nil :: any,
			aggro = 0,
			struck = false,
			respawn = 0,
			alt = if kind.fly then kind.fly.alt else nil, -- 나는 몬스터: 지금 땅에서 뜬 높이(덮칠 때 내려왔다 올라간다)
		}
		if scene.story then
			mob.state, mob.away = "gone", true -- 이야기의 방(사당 지하): 그 퀘스트를 하는 사람이 올 때까지 없다(Room:stepStory)
		end
		table.insert(self.mobs, mob)
	end
	-- 스토리 보스(장면의 bosses — 공방 design/bosses.js의 STORYBOSS): 졸개의 목록 끝에 자리를 잡아 둔다(번호가 바뀌지 않게). 처음에는 없다(state "gone" · away) —
	--  그 퀘스트를 하는 사람이 방에 있을 때만 나타난다(Room:stepPresence). 부르는 졸개(호령)의 자리도 미리 잡아 둔다(away — 불릴 때 나온다)
	local function hpOf(lv: number, kind): number
		return math.max(1, math.floor(N.mobHp(lv) * kind.hp * RULES.dmgScale * (1 + RULES.targetBonus / 100) + 0.5))
	end
	for _, def in scene.bosses or {} do
		local kind = COMBAT.mobs[def.kind]
		local maxHp = hpOf(def.lv, kind)
		local boss = {
			id = #self.mobs + 1, kind = def.kind, def = kind, lv = def.lv, homeX = def.x, y = def.y, a = def.range[1], b = def.range[2], x = def.x, dir = -1,
			state = "gone", t = 0, hp = maxHp, maxHp = maxHp, cd = 0, wait = 0, goal = def.x, target = nil :: any, aggro = 0, struck = false, respawn = math.huge,
			boss = true, away = true, pat = 0, rest = 0, used = {}, adds = {},
		}
		table.insert(self.mobs, boss)
		self.bosses = self.bosses or {}
		table.insert(self.bosses, boss)
		for _, p in kind.story.patterns do
			if p.summon then
				local ak = COMBAT.mobs[p.summon.kind]
				local hp = hpOf(p.summon.lv, ak)
				for i = 1, p.summon.max do
					local x = p.summon.at[(i - 1) % #p.summon.at + 1]
					local add = {
						id = #self.mobs + 1, kind = p.summon.kind, def = ak, lv = p.summon.lv, homeX = x, y = def.y, a = def.range[1], b = def.range[2], x = x, dir = 1,
						state = "gone", t = 0, hp = hp, maxHp = hp, cd = 0, wait = 0, goal = x, target = nil :: any, aggro = 0, struck = false, respawn = math.huge,
						add = true, away = true,
					}
					table.insert(self.mobs, add)
					table.insert(boss.adds, add)
				end
			end
		end
	end
	return self
end

local function sign(v: number): number
	return if v > 0 then 1 elseif v < 0 then -1 else 0
end

local function canSee(mob, h, range: number): boolean
	return h.alive and math.abs(h.y - mob.y) <= SEE_Y and math.abs(h.x - mob.x) <= range
end

-- 가장 가까운, 알아챌 수 있는 사람
function Room:findTarget(mob, heroes)
	local best, bestD = nil, math.huge
	for id, h in heroes do
		local range = if mob.target == id then mob.def.see * 1.6 else mob.def.see
		if canSee(mob, h, range) and not Buffs.stealth(h) then -- 연막 안의 사람은 놓친다
			local d = math.abs(h.x - mob.x)
			if d < bestD then
				best, bestD = id, d
			end
		end
	end
	return best
end

-- 졸개가 사람을 친다. 들어간 피해가 있으면 일(hurt)을 적는다.
function Room:hurtHero(events, h, mob, mul: number)
	-- 리븐의 날랜 몸: 확률로 피한다(맞을 수 있을 때만 굴린다 — 피한 뒤에도 맞은 뒤처럼 잠깐은 다시 맞지 않는다)
	local dodge = Kit.dodge(h) + Passives.dodge(h) -- 흘리기(4차): 회피 +
	if dodge > 0 and h.alive and h.invuln <= 0 and self.rng:NextNumber(0, 1) < dodge then
		h.invuln = RULES.invuln
		Passives.dodged(h) -- 흘리기: 피하면 다음 베기가 반드시 표식 치명타
		table.insert(events, { type = "dodge", hero = h.id })
		return
	end
	-- 생존기(버티기 · 그림자 숨기 · 저승 걸음 · 맞불): 그동안은 피해를 받지 않는다
	if Buffs.guard(h) then
		return
	end
	-- 끼고 있는 방어구만큼 덜 아프다. 무니의 지키는 마음은 거기에 더 줄인다(제 수정 곁에서는 두 배). 버프(달의 축복 · 수정 방벽 · 달의 성역)도 줄인다
	-- 패시브(굳센 자세 — 기술을 쓰는 동안에는 더 · 달궈진 몸 — 달아오름 동안)도 줄인다
	local casting = (h.actUntil or 0) > self.time or self.caster:acting(h)
	local raw = N.rawHit("mob", mob.lv) * (1 - Hero.cut(h, mob.lv) / 100) * mul * Kit.cut(h, self:nearCrystal(h)) * Buffs.cut(h) * Passives.cut(h, casting)
	-- 죽음의 가호: 쓰러질 피해를 한 번 버틴다(체력 1로 남는다)
	if h.alive and h.invuln <= 0 and raw >= h.hp and Buffs.ward(h) then
		local lost = h.hp - 1
		h.hp, h.invuln = 1, RULES.invuln
		table.insert(events, { type = "ward", hero = h.id })
		if lost > 0 then
			table.insert(events, { type = "hurt", hero = h.id, dmg = lost, hp = 1, from = mob.x, dead = false })
		end
		return
	end
	-- 재점화(살라맨더 4차): 쓰러질 피해를 받으면 열기를 모두 태워 버틴다(오래에 한 번)
	if h.alive and h.invuln <= 0 and raw >= h.hp then
		local left = Passives.rekindle(h, self.time)
		if left then
			local lost = math.max(0, h.hp - left)
			h.hp, h.invuln = left, RULES.invuln
			table.insert(events, { type = "self", hero = h.id })
			table.insert(events, { type = "hurt", hero = h.id, dmg = lost, hp = h.hp, from = mob.x, dead = false })
			return
		end
	end
	local dmg = Hero.hurt(h, raw)
	if dmg > 0 then
		table.insert(events, { type = "hurt", hero = h.id, dmg = dmg, hp = h.hp, from = mob.x, dead = not h.alive })
	end
end

function Room:stepMob(mob, heroes, dt: number, events)
	if mob.boss then
		return self:stepBoss(mob, heroes, dt, events)
	end
	local def, atk = mob.def, mob.def.atk
	mob.t += dt
	mob.cd = math.max(0, mob.cd - dt)
	-- 묶였거나(바인드 — 저승 사슬 · 수정 감옥) 넘어져 있으면(지진) 움직이지도 치지도 못한다 — 맞고 멈칫하는 동작만 마저 한다
	if ((mob.bind or 0) > 0 or (mob.stun or 0) > 0) and mob.state ~= "gone" and mob.state ~= "dead" and mob.state ~= "spawn" then
		if mob.state ~= "hit" or mob.t >= RULES.stagger then
			mob.state, mob.struck = "idle", false
		end
		return
	end

	if mob.state == "gone" then
		if mob.away then
			return -- 보스가 부르는 졸개: 불릴 때까지 없다
		end
		mob.respawn -= dt
		if mob.respawn <= 0 then
			mob.state, mob.t, mob.x, mob.hp, mob.target, mob.cd = "spawn", 0, mob.homeX, mob.maxHp, nil, 0
			mob.marks = nil
			mob.bind, mob.bindImm, mob.stun, mob.rend, mob.cracks = 0, 0, 0, 0, 0
		end
		return
	elseif mob.state == "dead" then
		if mob.t >= DEAD_TIME then
			mob.state, mob.respawn = "gone", RULES.respawn
			if mob.add then
				mob.away = true -- 불려 나온 졸개는 저절로 다시 나오지 않는다
			end
		end
		return
	elseif mob.state == "spawn" then
		if mob.t >= SPAWN_TIME then
			mob.state, mob.t = "idle", 0
		end
		return
	elseif mob.state == "hit" then
		if mob.t >= RULES.stagger then
			mob.state, mob.t = "idle", 0
		end
		return
	elseif mob.state == "atk" then
		local target = mob.target and heroes[mob.target]
		if def.fly then
			-- 나는 몬스터의 덮치기: 내려오는 동안(windup) 덮칠 자리로 다가가며 낮아지고, 그 뒤 time까지 다시 올라간다. 높이는 상태와 시간에서만 나온다(화면도 같은 식으로 셈한다 — mobsView)
			local k = if mob.t < atk.windup then mob.t / atk.windup else math.max(0, 1 - (mob.t - atk.windup) / (atk.time - atk.windup))
			mob.alt = def.fly.alt - (def.fly.alt - def.fly.low) * (k * k * (3 - 2 * k))
			if mob.t < atk.windup then
				mob.x += ((mob.diveX or mob.x) - mob.x) * math.min(1, dt * 7)
			end
		end
		if not mob.struck and mob.t >= atk.windup then
			mob.struck = true
			if atk.shot then
				-- 화살: 보는 쪽으로 곧게 날아간다. 새 몬스터는 나오는 자리(dx · dy)와 크기(w · h)가 따로 있다(빈 투구의 덩어리)
				local shot = { id = self.nextId, x = mob.x + mob.dir * (atk.shot.dx or 8), y = mob.y - (atk.shot.dy or 9), dir = mob.dir, speed = atk.shot.speed, left = atk.shot.range, mob = mob }
				-- 나오는 자리가 몸에서 먼 것(빈 투구의 덩어리는 27점 앞에서 생긴다): 몸과 그 자리 사이에 바짝 붙어 선 사람은 쏘는 순간 맞는다 — 붙어 서면 안 맞는 빈 곳이 없게(2026-10-09 Play에서 찾음). 맞혔으면 덩어리는 날아가지 않는다
				local point = false
				if atk.shot.dx then
					local hh = (atk.shot.h or 0) / 2
					for _, h in heroes do
						local dx = (h.x - mob.x) * mob.dir
						if h.alive and dx >= -HERO_W and dx < atk.shot.dx and shot.y - hh <= h.y and shot.y + hh >= h.y - HERO_H then
							self:hurtHero(events, h, mob, atk.mul)
							point = true
						end
					end
				end
				if not point then
					self.nextId += 1
					table.insert(self.shots, shot)
					table.insert(events, { type = "shot", id = shot.id, x = shot.x, y = shot.y, dir = shot.dir, speed = shot.speed, range = shot.left, kind = mob.kind })
				end
			elseif atk.cast then
				-- 마법: 몸 동작과 따로, 그때 겨눈 사람의 자리에 뜬다(발밑 = 몬스터와 같은 층의 땅 · 몸 = 그 사람의 몸 가운데). 예고(wait) 뒤에 그 안에 있는 사람이 맞는다 — 비키면 맞지 않는다(아래 Room:step)
				if target and target.alive then
					-- 앞(front) = 몬스터의 앞에 붙는다(등불 해파리의 번개 줄기): 앞에 있으면 맞고 뒤로 돌아가면 안 맞는다
					local front = atk.cast.place == "front"
					local cast = {
						id = self.nextId,
						x = if front then mob.x + mob.dir * atk.cast.from[1] else target.x,
						y = if front then mob.y - atk.cast.from[2] elseif atk.cast.place == "feet" then mob.y else target.y - 10,
						t = 0,
						mob = mob,
						def = atk.cast,
						done = false,
						dir = mob.dir,
					}
					self.nextId += 1
					table.insert(self.casts, cast)
					table.insert(events, { type = "cast", id = cast.id, kind = mob.kind, x = cast.x, y = cast.y, dir = cast.dir })
				end
			elseif atk.burst then
				-- 터뜨린다(폭탄병 · 포자 주머니): 둘레의 사람이 모두 맞는다. 터뜨려도 사라지지 않는다 — 동작이 끝나면 cd를 기다렸다가 또 터뜨리고, 잡히면 경험치와 물건을 준다
				--  (사용자 2026-10-11: "폭탄병 지혼자 터져서 없어지는거 없어야합니다. 공격하고 사냥당하는 일반 몬스터여야하는거에요")
				for _, h in heroes do
					if h.alive and math.abs(h.x - mob.x) <= atk.burst and math.abs(h.y - mob.y) <= atk.burst then
						self:hurtHero(events, h, mob, atk.mul)
					end
				end
			elseif target and target.alive then
				-- both = 앞뒤 모두 닿는다(바위 게의 집게 · 굴 두더지 · 덮치는 박쥐)
				local dx = (target.x - mob.x) * mob.dir
				if (if atk.both or def.fly then math.abs(dx) <= atk.reach + 6 else dx >= -6 and dx <= atk.reach + 6) and math.abs(target.y - mob.y) <= atk.up then
					self:hurtHero(events, target, mob, atk.mul)
				end
			end
		end
		if mob.t >= atk.time then
			mob.state, mob.t, mob.cd = "idle", 0, atk.cd
		end
		return
	end

	-- 서 있기 · 어슬렁 · 쫓기
	if def.fly then
		mob.alt = def.fly.alt -- 덮치는 동안이 아니면 제 높이에 떠 있다
	end
	mob.aggro = math.max(0, mob.aggro - dt)
	local targetId = self:findTarget(mob, heroes)
	if not targetId and mob.aggro > 0 and mob.target and heroes[mob.target] and heroes[mob.target].alive then
		targetId = mob.target -- 맞았으면 멀리 있어도 한동안 쫓는다
	end
	mob.target = targetId
	local target = targetId and heroes[targetId]
	if target then
		local dx = target.x - mob.x
		if dx ~= 0 then
			mob.dir = sign(dx)
		end
		if def.fly then
			-- 나는 몬스터: 사람이 좌우 fly.see 안(같은 층)에 들면 그 자리로 덮친다. 쫓지는 않는다 — 덮치지 않을 때는 아래의 어슬렁대로 오간다
			if mob.cd <= 0 and math.abs(dx) <= def.fly.see and math.abs(target.y - mob.y) <= SEE_Y then
				mob.state, mob.t, mob.struck, mob.diveX = "atk", 0, false, math.clamp(target.x, mob.a, mob.b)
				return
			end
		else
			local sameFloor = math.abs(target.y - mob.y) <= atk.up
			if mob.cd <= 0 and sameFloor and math.abs(dx) <= atk.reach * 0.9 then
				mob.state, mob.t, mob.struck = "atk", 0, false
				return
			end
			if def.chase > 0 and math.abs(dx) > atk.reach * 0.6 then
				mob.x = math.clamp(mob.x + mob.dir * def.chase * dt, mob.a, mob.b)
				mob.state = "run"
			else
				mob.state = "idle"
			end
			return
		end
	end
	-- 제자리 몬스터(굴 두더지): 오가지 않는다
	if def.speed <= 0 then
		mob.state = "idle"
		return
	end
	-- 어슬렁: 잠깐 서 있다가 범위 안의 다른 자리로 걷는다
	if mob.wait > 0 then
		mob.wait -= dt
		mob.state = "idle"
		if mob.wait <= 0 then
			mob.goal = self.rng:NextNumber(mob.a, mob.b)
		end
		return
	end
	local dx = mob.goal - mob.x
	if math.abs(dx) < 1 then
		mob.wait = self.rng:NextNumber(0.6, 2.2)
		mob.state = "idle"
	else
		mob.dir = sign(dx)
		mob.x += mob.dir * math.min(def.speed * dt, math.abs(dx))
		mob.state = "run"
	end
end

-- ---------- 스토리 보스(공방 design/bosses.js의 STORYBOSS → COMBAT.mobs[보스].story) ----------
--  사용자 2026-10-11: "리워드 없는 스토리보스로 … 그냥 이야기에서 지나치는 스토리보스로" · "패턴, 스킬 이펙트는 따로 만드셔야해요"
--  상태: gone(없다) → spawn(나타남) → idle · run(쉬며 다가옴) → tell(예고 — 맞을 자리가 바닥에 그려진다) → act(친다) / dash(내달린다) → idle(굳어 있다 = rest) … → dead → gone
--  pat = 지금 하는 패턴의 차례(없으면 0 — 화면에 같이 보낸다: snapshot의 아홉째). 맞아도 멈칫하지 않고 밀리지 않는다. 묶이거나(바인드) 넘어지면 하던 것을 그만둔다.
--  2026-10-12 밤(사용자: "패턴이 너무적습니다. 뻔하고 … 패턴좀 멋있게 만드세요" → 시험 탭에서 먼저 만든 뒤 "추가 패턴 적용하고 …"): 패턴을 다시 짰다 — 시험 탭 luneTab.js의 stepStory를 옮긴 것.
--   · 고르기: 겨눈 사람과의 거리(reach 안 · far 밖)와 체력(from) · 쉬는 시간(every)으로 쓸 수 있는 것을 추리고, 그 가운데 몫(w)대로 뽑는다. 방금 쓴 것은 다른 것이 있으면 뽑지 않는다.
--   · 연속기(chain): 적힌 패턴들을 쉬지 않고 잇는다(첫 번째는 제 예고대로 · 둘째부터 예고 · 굳는 시간이 quick배 · 칠 때마다 chainStep만큼 다가선다). only = 연속기 안에서만 쓰는 패턴.
--   · 표시된 자리(spots): 예고가 시작될 때 바닥의 자리들이 정해지고(self.blasts), 예고가 끝나면(자리마다 더 기다린 뒤) 터진다 — 그 위에 선 사람이 맞는다.
--   · 도약(leap): 예고가 끝나면 뛰어올라 time초 뒤 겨눈 자리(mob.aim — 뛰기 0.25초 전까지 겨눈 사람을 따라간다)에 내려앉으며 친다.
--   · 물결(wave): dir = "front"면 보는 쪽으로만 · n개를 gap초 간격으로(검기 · 연속 검기).
--   · 체력 구간(story.phase): 체력이 at 아래로 내려가면 한 번 포효한다(roar — time초 동안 치지 않는다). 그 뒤로 쉬는 시간이 rage배 · 걸음이 1.15배.
--  화면에 더 보내는 것(snapshot의 열째 ~ 열두째): 겨눈 자리(aim) · 연속기의 차례(chainPat — 0이면 연속기가 아니다) · 지금 패턴이 빠른가(quick).

-- 보스를 치운다(그 퀘스트를 하는 사람이 없어졌다 · 쓰러진 뒤). 부른 졸개와 물결도 같이 사라진다
function Room:bossAway(mob)
	mob.state, mob.t, mob.away, mob.pat, mob.target = "gone", 0, true, 0, nil
	mob.bind, mob.bindImm, mob.stun, mob.rend, mob.cracks, mob.marks = 0, 0, 0, 0, 0, nil
	for _, add in mob.adds do
		add.state, add.t, add.away, add.target = "gone", 0, true, nil
		add.bind, add.bindImm, add.stun, add.rend, add.cracks, add.marks = 0, 0, 0, 0, 0, nil
	end
	if self.waves then
		for i = #self.waves, 1, -1 do
			if self.waves[i].mob == mob then
				table.remove(self.waves, i)
			end
		end
	end
	self:bossSpotsOff(mob)
	mob.chain, mob.chainPat, mob.quick, mob.aim, mob.alt = nil, 0, 1, 0, 0
end

-- 그 보스가 표시해 둔 자리들을 거둔다(묶여서 예고가 끊겼다 · 쓰러졌다 · 사라졌다)
function Room:bossSpotsOff(mob)
	if self.blasts then
		for i = #self.blasts, 1, -1 do
			if self.blasts[i].mob == mob then
				table.remove(self.blasts, i)
			end
		end
	end
end

-- 방에 아무도 없다(서버가 알린다): 서 있던 보스를 치운다 — 다시 들어오면 체력이 가득한 채 새로 선다
function Room:idle()
	for _, mob in self.bosses or {} do
		if not mob.away then
			self:bossAway(mob)
		end
	end
end

-- 이야기의 방(scene.story — 사당 지하 · 메인 「불타는 마을」): 졸개는 그 졸개를 잡는 퀘스트를 하는 중인 사람이 방에 있을 때만 나온다.
--  그런 사람이 오면 하나씩 차례로 나타나고(쓰러뜨리면 여느 졸개처럼 다시 나온다 — 밀려드는 병사), 다 잡았거나 그런 사람이 없으면 모두 사라진다.
--  사용자 2026-10-13: "사당지하 개발 해야합니다." — 퀘스트를 끝낸 뒤의 지하는 병사가 없는 조용한 방이다(비석을 읽을 수 있다)
Room.STORY_STAGGER = 0.5 -- 졸개가 하나씩 나타나는 간격(초)
function Room:stepStory(heroes)
	local want = false
	for _, h in heroes do
		for _, mob in self.mobs do
			if not mob.def.story and not mob.add and Quests.wantsKill(h.quests, mob.kind, self.key) then
				want = true
				break
			end
		end
		if want then
			break
		end
	end
	local n = 0
	for _, mob in self.mobs do
		if not mob.def.story and not mob.add then
			n += 1
			if want and mob.away then
				mob.away = false
				mob.state, mob.t, mob.respawn = "gone", 0, Room.STORY_STAGGER * n
			elseif not want and not mob.away then
				mob.away = true
				mob.state, mob.t, mob.target = "gone", 0, nil
				mob.bind, mob.bindImm, mob.stun, mob.rend, mob.cracks, mob.marks = 0, 0, 0, 0, 0, nil
			end
		end
	end
end

-- 누가 서야 하는가: 이야기의 차례로, 그 보스를 잡는 퀘스트를 하는 중인 사람이 방에 있는 첫 보스 하나. 나머지는 없다
function Room:stepPresence(heroes)
	local want = nil
	for _, mob in self.bosses do
		if not want then
			for _, h in heroes do
				if Quests.wantsKill(h.quests, mob.kind, self.key) then
					want = mob
					break
				end
			end
		end
	end
	for _, mob in self.bosses do
		if mob == want then
			if mob.away then
				mob.away = false
				mob.state, mob.t, mob.x, mob.hp, mob.dir, mob.target = "spawn", 0, mob.homeX, mob.maxHp, -1, nil
				mob.pat, mob.rest, mob.used = 0, 0, {}
				mob.raged, mob.lastPat, mob.chain, mob.chainPat, mob.quick, mob.aim, mob.alt = false, 0, nil, 0, 1, 0, 0
			end
		elseif not mob.away and mob.state ~= "dead" then
			self:bossAway(mob)
		end
	end
end

-- 그 자리(바닥 mob.y · 가로 lo~hi · 바닥에서 위로 up)에 그 사람의 발이 걸리는가 — 발이 up보다 높이 떠 있으면 걸리지 않는다(낮은 것은 뛰어서 넘는다)
local function inZone(mob, h, lo: number, hi: number, up: number): boolean
	return h.alive and h.x >= lo - HERO_W and h.x <= hi + HERO_W and mob.y - h.y < up and h.y <= mob.y + 4
end

-- 예고가 끝났다(도약은 내려앉았다): 친다
function Room:bossStrike(mob, p, heroes, events)
	if p.zone then
		local x0, x1 = mob.x + mob.dir * p.zone.from, mob.x + mob.dir * p.zone.to
		local lo, hi = math.min(x0, x1), math.max(x0, x1)
		for _, h in heroes do
			if inZone(mob, h, lo, hi, p.zone.up) then
				self:hurtHero(events, h, mob, p.mul)
			end
		end
	end
	if p.wave then
		-- 물결이 바닥을 따라 간다(Room:step이 옮기고 맞힌다 — 한 사람은 한 물결에 한 번): 내려찍은 자리에서 양쪽으로(땅 울림) · 보는 쪽으로만(검기) · 여럿이 잇달아(연속 검기 — wait초 뒤에 떠난다)
		self.waves = self.waves or {}
		for _, w in BossPat.waves(p, mob.dir) do
			table.insert(self.waves, { mob = mob, x = mob.x + mob.dir * p.wave.at, y = mob.y, dir = w[1], wait = w[2], left = p.wave.range, def = p.wave, mul = p.mul, hit = {} })
		end
	end
	if p.summon then
		-- 호령: 서 있지 않은 자리의 졸개를 n까지 방의 양 끝에서 내보낸다
		local out = 0
		for _, add in mob.adds do
			if out < p.summon.n and add.away then
				out += 1
				add.away = false
				add.state, add.t, add.x, add.hp, add.target, add.cd, add.aggro = "spawn", 0, add.homeX, add.maxHp, nil, 0, 0
				add.dir = if add.homeX < mob.x then 1 else -1
				add.goal, add.wait = mob.x, 0
				add.bind, add.bindImm, add.stun, add.rend, add.cracks, add.marks = 0, 0, 0, 0, 0, nil
			end
		end
	end
end

-- 그 패턴을 지금 쓸 수 있는가(겨눈 사람과의 거리 dist)
function Room:bossCan(mob, p, dist: number): boolean
	local ok = not p.only and (not p.from or mob.hp <= mob.maxHp * p.from) and (not p.every or self.time - (mob.used[p.id] or -math.huge) >= p.every)
		and (not p.reach or dist <= p.reach) and (not p.far or dist >= p.far)
	if ok and p.summon then
		ok = false
		for _, add in mob.adds do
			if add.away then
				ok = true -- 부를 자리가 남아 있다
				break
			end
		end
	end
	return ok
end

-- 다음에 쓸 패턴: 쓸 수 있는 것 가운데 몫(w — 없으면 1)대로 하나. 방금 쓴 것은 다른 것이 있으면 뽑지 않는다. 없으면 nil(더 다가간다)
function Room:bossPick(mob, dist: number)
	local P = mob.def.story.patterns
	local pool, fresh = {}, {}
	for i, p in P do
		if self:bossCan(mob, p, dist) then
			table.insert(pool, i)
			if i ~= mob.lastPat then
				table.insert(fresh, i)
			end
		end
	end
	if #fresh > 0 then
		pool = fresh
	end
	if #pool == 0 then
		return nil, 0
	end
	local total = 0
	for _, i in pool do
		total += P[i].w or 1
	end
	local r = self.rng:NextNumber(0, total)
	local pick = pool[#pool]
	for _, i in pool do
		r -= P[i].w or 1
		if r <= 0 then
			pick = i
			break
		end
	end
	return P[pick], pick
end

local function patIndex(S, id: string): number
	for i, p in S.patterns do
		if p.id == id then
			return i
		end
	end
	error("스토리 보스: 없는 패턴 " .. id)
end

-- 그 패턴을 예고부터 시작한다. quick = 연속기 안에서 예고 · 굳는 시간을 줄이는 비율(없으면 1) · target = 겨눈 사람(없어도 된다 — 그러면 보는 쪽 앞을 겨눈다)
function Room:bossBegin(mob, i: number, quick: number?, target)
	local S = mob.def.story
	local p = S.patterns[i]
	mob.state, mob.t, mob.pat, mob.quick = "tell", 0, i, quick or 1
	mob.landed, mob.alt = false, 0
	mob.slide = if quick then mob.chainStep or 0 else 0
	if target then
		local dx = target.x - mob.x
		if dx ~= 0 then
			mob.dir = sign(dx)
		end
	end
	mob.aim = if target then target.x else mob.x + mob.dir * ((p.leap and p.leap.aim or 0) + 30)
	if p.spots then
		-- 표시되는 자리들이 지금 정해진다 — 예고가 끝나면(자리마다 더 기다린 뒤) 터진다
		self.blasts = self.blasts or {}
		local lo, hi = BossPat.bounds(self.scene)
		local tell = BossPat.tell(p, mob.quick)
		for _, sp in BossPat.spots(p, mob.aim, lo, hi) do
			table.insert(self.blasts, { mob = mob, x = sp[1], y = mob.y, t = tell + sp[2], def = p.spots, mul = p.mul })
		end
	end
	return p
end

-- 쉬는 틈의 배율: 포효한 뒤에는 짧아진다
local function rageOf(mob, S): number
	return if mob.raged and S.phase then S.phase.rage or 1 else 1
end

-- 고른 패턴(i째)을 쓴다: 연속기면 그 첫 패턴부터(첫 번째는 제 예고대로 — 둘째부터 quick배: bossDone), 아니면 그 패턴을. 쓴 때와 차례를 적는다(every · 방금 쓴 것 피하기)
function Room:bossStart(mob, i: number, target)
	local S = mob.def.story
	local pick = S.patterns[i]
	mob.used[pick.id] = self.time
	mob.lastPat = i
	if pick.chain then
		mob.chain = table.clone(pick.chain)
		mob.chainQuick, mob.chainStep, mob.chainPat = pick.quick, pick.chainStep or 0, i
		mob.chainRest = 1.8 * rageOf(mob, S) -- 다 끝나면 길게 쉰다(때릴 틈)
		return self:bossBegin(mob, patIndex(S, table.remove(mob.chain, 1)), nil, target)
	end
	mob.chain, mob.chainRest, mob.chainPat = nil, nil, 0
	return self:bossBegin(mob, i, nil, target)
end
-- 그 패턴이 끝났다: 연속기면 쉬지 않고 다음 것으로, 아니면 쉰다
function Room:bossDone(mob, p, heroes)
	local S = mob.def.story
	if mob.chain and #mob.chain > 0 then
		local id = table.remove(mob.chain, 1)
		self:bossBegin(mob, patIndex(S, id), mob.chainQuick, if mob.target then heroes[mob.target] else nil)
		return
	end
	mob.state, mob.t, mob.pat, mob.rest = "idle", 0, 0, mob.chainRest or p.rest * rageOf(mob, S)
	mob.chain, mob.chainRest, mob.chainPat, mob.quick, mob.alt = nil, nil, 0, 1, 0
end

function Room:stepBoss(mob, heroes, dt: number, events)
	local S = mob.def.story
	mob.t += dt
	if mob.state == "gone" then
		return
	elseif mob.state == "dead" then
		-- 쓰러지는 동작 그림이 있는 보스(S.fall초 — 그 동작 + 누워 있는 시간 + 사라지는 시간)는 그 그림이 다 보일 때까지 치우지 않는다
		if mob.t >= (S.fall or DEAD_TIME) then
			self:bossAway(mob)
		end
		return
	elseif mob.state == "spawn" then
		if mob.t >= SPAWN_TIME then
			mob.state, mob.t, mob.rest = "idle", 0, S.pause
		end
		return
	end
	-- 묶였거나 넘어져 있다: 하던 것을 그만두고 선다(풀리면 잠깐 뒤에 다시 고른다). 예고하던 중이면 표시해 둔 자리도 거둔다. 뛰어오른 중이면 그 자리에 내려선다
	if (mob.bind or 0) > 0 or (mob.stun or 0) > 0 then
		if mob.state ~= "idle" then
			if mob.state == "tell" then
				self:bossSpotsOff(mob)
			end
			mob.state, mob.t, mob.pat = "idle", 0, 0
			mob.chain, mob.chainRest, mob.chainPat, mob.quick, mob.alt = nil, nil, 0, 1, 0
		end
		mob.rest = math.max(mob.rest, 0.4)
		return
	end
	if mob.state == "roar" then
		-- 체력 구간의 포효: 그동안은 치지 않는다(때릴 틈)
		if mob.t >= S.phase.time then
			mob.state, mob.t, mob.rest = "idle", 0, 0.5
		end
		return
	end
	local p = S.patterns[mob.pat]
	local quick = mob.quick or 1
	if mob.state == "tell" then
		local tell = BossPat.tell(p, quick)
		local target = if mob.target then heroes[mob.target] else nil
		if (mob.slide or 0) > 0 then
			-- 연속기: 예고하면서 한 걸음 다가선다(서는 거리 keep 안으로는 들어가지 않는다)
			if target and target.alive then
				local dx = target.x - mob.x
				local mv = math.min(mob.slide, 130 * dt, math.max(0, math.abs(dx) - S.keep))
				mob.x = math.clamp(mob.x + sign(dx) * mv, mob.a, mob.b)
			end
			mob.slide -= 130 * dt
		end
		if p.leap and mob.t < tell - 0.25 and target and target.alive then
			mob.aim = target.x -- 도약: 뛰기 0.25초 전까지 겨눈 사람을 따라간다
		end
		if mob.t >= tell then
			mob.t = 0
			if p.leap then
				-- 뛰어오른다 — 내려앉을 때 친다
				mob.leapFrom = mob.x
				mob.leapTo, mob.dir = BossPat.leapTo(p, mob.x, mob.dir, mob.aim, mob.a, mob.b)
				mob.landed = false
			else
				self:bossStrike(mob, p, heroes, events)
			end
			if p.dash then
				mob.state, mob.dashHit = "dash", {}
			else
				mob.state = "act"
			end
		end
		return
	elseif mob.state == "act" then
		if p.leap and not mob.landed then
			local k = math.min(1, mob.t / p.leap.time)
			mob.x = mob.leapFrom + (mob.leapTo - mob.leapFrom) * k
			mob.alt = BossPat.leapAlt(p, mob.t)
			if k >= 1 then
				mob.landed, mob.alt = true, 0
				self:bossStrike(mob, p, heroes, events)
			end
		end
		-- 치면서 한 걸음 내디딘다: 처음 STEP_TIME초 안에 다 간다(act = 친 뒤에 굳어 있는 시간 — 받은 공격 그림의 길이에 맞춰 길다. 그동안 걷지도 돌아서지도 않는다)
		local act = BossPat.act(p, quick)
		local stepT = math.min(act, STEP_TIME)
		if p.step and stepT > 0 then
			local part = math.min(mob.t, stepT) - math.min(mob.t - dt, stepT)
			if part > 0 then
				mob.x = math.clamp(mob.x + mob.dir * p.step * part / stepT, mob.a, mob.b)
			end
		end
		if mob.t >= act then
			self:bossDone(mob, p, heroes)
		end
		return
	elseif mob.state == "dash" then
		-- 내달리기: 보는 쪽의 끝까지. 달리는 몸에 닿은 사람은 한 번 맞는다(발이 up보다 높이 떠 있으면 넘어간다)
		local hw = bodyOf(mob)
		mob.x = math.clamp(mob.x + mob.dir * p.dash.speed * dt, mob.a, mob.b)
		for id, h in heroes do
			if not mob.dashHit[id] and inZone(mob, h, mob.x - hw, mob.x + hw, p.dash.up) then
				mob.dashHit[id] = true
				self:hurtHero(events, h, mob, p.mul)
			end
		end
		if mob.x <= mob.a or mob.x >= mob.b then
			mob.dashHit = nil
			self:bossDone(mob, p, heroes)
		end
		return
	end
	-- 쉬며 다가온다: 가장 가까운 살아 있는 사람을 본다(연막 안의 사람은 놓친다)
	mob.rest = math.max(0, mob.rest - dt)
	local target, bestD = nil, math.huge
	for id, h in heroes do
		if h.alive and not Buffs.stealth(h) then
			local d = math.abs(h.x - mob.x)
			if d < bestD then
				target, bestD = h, d
				mob.target = id
			end
		end
	end
	if not target then
		mob.state, mob.target = "idle", nil
		return
	end
	local dx = target.x - mob.x
	if dx ~= 0 then
		mob.dir = sign(dx)
	end
	-- 체력 구간: 한 번 포효한다 — 그 뒤로 새 패턴이 열리고(from) 쉬는 틈이 짧아진다
	if S.phase and not mob.raged and mob.hp <= mob.maxHp * S.phase.at then
		mob.raged = true
		mob.state, mob.t, mob.pat = "roar", 0, 0
		mob.chain, mob.chainPat = nil, 0
		return
	end
	if mob.rest <= 0 then
		local pick, i = self:bossPick(mob, math.abs(dx))
		if pick then
			self:bossStart(mob, i, target)
			return
		end
	end
	if math.abs(dx) > S.keep then
		mob.x = math.clamp(mob.x + mob.dir * mob.def.speed * (if mob.raged then 1.15 else 1) * dt, mob.a, mob.b)
		mob.state = "run"
	else
		mob.state = "idle"
	end
end

-- 한 걸음. 일어난 일의 목록을 돌려준다: hurt(사람이 맞음) · shot(화살이 생김) · shotEnd
function Room:step(heroes, dt: number)
	local events = {}
	self.time += dt
	self.heroes = heroes -- 지금 방에 있는 사람들(스토리 보스를 쓰러뜨리면 모두에게 잡은 것으로 친다 — Room:strike)
	if self.bosses then
		self:stepPresence(heroes)
	end
	if self.scene and self.scene.story then
		self:stepStory(heroes)
	end
	for _, mob in self.mobs do
		-- 졸개에 걸린 것이 풀려 간다: bind 묶임 · bindImm 다시 묶이지 않는 시간 · stun 넘어짐 · rend 갈라짐(받는 피해 +)
		if (mob.bind or 0) > 0 then
			mob.bind = math.max(0, mob.bind - dt)
		end
		if (mob.bindImm or 0) > 0 then
			mob.bindImm = math.max(0, mob.bindImm - dt)
		end
		if (mob.stun or 0) > 0 then
			mob.stun = math.max(0, mob.stun - dt)
		end
		if (mob.rend or 0) > 0 then
			mob.rend = math.max(0, mob.rend - dt)
		end
		self:stepMob(mob, heroes, dt, events)
	end
	-- 화살
	for i = #self.shots, 1, -1 do
		local s = self.shots[i]
		local move = s.speed * dt
		s.x += s.dir * move
		s.left -= move
		local done = s.left <= 0 or Physics.cell(self.scene, math.floor(s.x / 16), math.floor(s.y / 16)) == "#"
		if not done then
			for _, h in heroes do
				local sd = s.mob.def.atk.shot
				local hw, hh = (sd.w or 4) / 2, (sd.h or 0) / 2 -- 날아가는 것의 반폭 · 반높이(화살은 점이다)
				if h.alive and math.abs(h.x - s.x) <= HERO_W + hw and s.y - hh <= h.y and s.y + hh >= h.y - HERO_H then
					self:hurtHero(events, h, s.mob, s.mob.def.atk.mul)
					done = true
					break
				end
			end
		end
		if done then
			table.insert(events, { type = "shotEnd", id = s.id })
			table.remove(self.shots, i)
		end
	end
	-- 몬스터의 마법: 뜬 자리에 고정되어 예고(wait)가 지나면 그 안의 사람이 모두 맞는다. 끝(life)까지 남았다가 사라진다
	for i = #self.casts, 1, -1 do
		local c = self.casts[i]
		c.t += dt
		local front = c.def.place == "front"
		if front then
			-- 몬스터를 따라 붙는다. 쓴 몬스터가 쓰러졌으면 사라진다
			if c.mob.state == "dead" then
				table.remove(self.casts, i)
				continue
			end
			c.x, c.y = c.mob.x + c.dir * c.def.from[1], c.mob.y - c.def.from[2]
		end
		if not c.done and c.t >= c.def.wait then
			c.done = true
			for _, h in heroes do
				if not h.alive then
					continue
				end
				local inside = false
				if front then
					local dx = (h.x - c.x) * c.dir
					inside = dx >= -HERO_W and dx <= c.def.w + HERO_W and math.abs(h.y - 10 - c.y) <= c.def.h + 10
				elseif math.abs(h.x - c.x) <= c.def.w + HERO_W + 1 then
					inside = if c.def.place == "feet" then h.y > c.y - c.def.h and h.y - HERO_H < c.y + 2 else math.abs(h.y - 10 - c.y) <= c.def.h + 10
				end
				if inside then
					self:hurtHero(events, h, c.mob, c.mob.def.atk.mul)
				end
			end
		end
		if c.t >= c.def.life then
			table.remove(self.casts, i)
		end
	end
	-- 스토리 보스의 물결(땅 울림): 바닥을 따라 가며, 닿은 사람은 한 번 맞는다(발이 up보다 높이 떠 있으면 넘어간다)
	if self.waves then
		for i = #self.waves, 1, -1 do
			local w = self.waves[i]
			if (w.wait or 0) > 0 then
				w.wait -= dt -- 연속 검기: 차례를 기다린다
				continue
			end
			local move = w.def.speed * dt
			w.x += w.dir * move
			w.left -= move
			for id, h in heroes do
				if not w.hit[id] and h.alive and math.abs(h.x - w.x) <= w.def.w + HERO_W and w.y - h.y < w.def.up and h.y <= w.y + 4 then
					w.hit[id] = true
					self:hurtHero(events, h, w.mob, w.mul)
				end
			end
			if w.left <= 0 or Physics.cell(self.scene, math.floor(w.x / 16), math.floor((w.y - 1) / 16)) == "#" then
				table.remove(self.waves, i)
			end
		end
	end
	-- 스토리 보스가 표시한 자리(불씨 뿌리기 · 봉화 불기둥): 때가 되면 터진다 — 그 위에 선 사람이 맞는다(발이 up보다 높이 떠 있으면 안 맞는다). 보스가 쓰러지면 사라진다
	if self.blasts then
		for i = #self.blasts, 1, -1 do
			local b = self.blasts[i]
			if b.mob.state == "dead" or b.mob.state == "gone" then
				table.remove(self.blasts, i)
				continue
			end
			b.t -= dt
			if b.t <= 0 then
				for _, h in heroes do
					if h.alive and math.abs(h.x - b.x) <= b.def.r + HERO_W and b.y - h.y < b.def.up and h.y <= b.y + 4 then
						self:hurtHero(events, h, b.mob, b.mul)
					end
				end
				table.remove(self.blasts, i)
			end
		end
	end
	-- 설치 · 소환
	if self.placed and #self.placed > 0 then
		self:stepPlaced(heroes, dt, events)
	end
	-- 조금 뒤에 넣기로 한 타(붙는 불): 때가 된 것을 풀어 그 사람의 일로 알린다
	if self.laters then
		for i = #self.laters, 1, -1 do
			local job = self.laters[i]
			if self.time >= job.at then
				table.remove(self.laters, i)
				local result = { hits = {}, kills = {} }
				job.fn(result)
				if #result.hits > 0 then
					table.insert(events, { type = "kit", hero = job.hero.id, result = result })
				end
			end
		end
	end
	-- 가시: 닿아 있으면 약한 피해 — 최대 체력의 spike%. 맞은 뒤 잠깐(invuln)은 다시 맞지 않아, 닿아 있는 동안 그 간격으로 한 번씩 든다.
	--  사용자 2026-10-08: "맵에 가시 있잖아요 그거 닿으면 데미지 입게 약한데미지 입게하세요". 피해를 받지 않는 버프(버티기 …) 동안에는 들지 않는다
	if self.scene then
		for _, h in heroes do
			if h.alive and h.invuln <= 0 and Physics.onSpike(self.scene, h.x, h.y) and not Buffs.guard(h) then
				local dmg = Hero.hurt(h, math.max(1, h.maxHp * RULES.spike / 100))
				if dmg > 0 then
					table.insert(events, { type = "hurt", hero = h.id, dmg = dmg, hp = h.hp, from = h.x, dead = not h.alive })
				end
			end
		end
	end
	-- 쉬는 곳(쉼터 · 작은 마을 · 마을 — 장면의 rest): 그 자리에 wait초 가만히 서 있으면 every초마다 최대 체력의 heal%가 찬다. 움직이거나 맞으면 처음부터 다시 센다.
	--  승인받은 맵 배치 계획의 "쉼터 · 작은 마을에서 쉬면 체력이 찬다"(숫자는 [제안] — combat.js의 COMBAT.rest). h.rest = { t = 가만히 선 시간, x, y = 그 자리, hp = 그때의 체력 }
	if self.scene and self.scene.rest then
		local R = RULES.rest
		for _, h in heroes do
			local r = h.rest
			if not r or not h.alive or math.abs(h.x - r.x) > 0.5 or math.abs(h.y - r.y) > 0.5 or h.hp < r.hp then
				h.rest = { t = 0, x = h.x, y = h.y, hp = h.hp }
			elseif h.hp >= h.maxHp then
				r.t, r.hp = 0, h.hp
			else
				local before = r.t
				r.t += dt
				if r.t >= R.wait + R.every and math.floor((r.t - R.wait) / R.every) > math.floor((before - R.wait) / R.every) then
					local gain = math.min(h.maxHp - h.hp, math.max(1, math.floor(h.maxHp * R.heal / 100 + 0.5)))
					h.hp += gain
					table.insert(events, { type = "healed", hero = h.id, amount = gain })
				end
				r.hp = h.hp
			end
		end
	end
	-- 2~4차의 쓰는 스킬: 구간의 타 · 늦게 터지는 것 · 날아가는 것
	self.caster:step(heroes, dt, events)
	-- 스미는 독(리븐 3차): 표식이 있는 적은 초마다 독 피해를 받는다 — 표식 수만큼 세다
	for _, hero in heroes do
		if hero.class == "riven" and hero.alive and hero.pass then
			local fx, s = Passives.get(hero, "venom")
			if fx and self.time >= hero.pass.venom then
				hero.pass.venom = self.time + 1
				local result = nil
				local power = Hero.powerRaw(hero) * Kit.attack(hero) * Buffs.dmg(hero) * Passives.atk(hero)
				for _, mob in self.mobs do
					local n = self:marksOf(hero, mob)
					if n > 0 and mob.state ~= "dead" and mob.state ~= "gone" and mob.state ~= "spawn" then
						result = result or { hits = {}, kills = {} }
						self:proc(hero, mob, power * N.data.POWER.dps * fx.venom * s * n * RULES.dmgScale * (1 + RULES.targetBonus / 100), "venom", mob.x, mob.y - 12, nil, result)
					end
				end
				if result then
					table.insert(events, { type = "kit", hero = hero.id, result = result })
				end
			end
		end
	end
	-- 달 수정: 때가 되면 사라진다
	for i = #self.crystals, 1, -1 do
		local c = self.crystals[i]
		if self.time >= c.till then
			table.remove(self.crystals, i)
			table.insert(events, { type = "crystalGone", id = c.id })
		end
	end
	-- 떨어진 것: 오래되면 사라진다
	for id, d in self.drops do
		if self.time - d.born >= RULES.dropLife then
			self.drops[id] = nil
			table.insert(events, { type = "dropGone", id = id })
		end
	end
	return events
end

-- 상자(x0~x1, y0~y1)에 걸리는 살아 있는 졸개들(가까운 것부터, RULES.maxTargets마리까지)
function Room:mobsInBox(x0: number, x1: number, y0: number, y1: number, cx: number)
	local list = {}
	for _, mob in self.mobs do
		if mob.state ~= "dead" and mob.state ~= "gone" and mob.state ~= "spawn" then
			local hw, up, hh = bodyOf(mob)
			if mob.x + hw >= x0 and mob.x - hw <= x1 and mob.y - up >= y0 and mob.y - up - hh <= y1 then
				table.insert(list, mob)
			end
		end
	end
	table.sort(list, function(p, q)
		return math.abs(p.x - cx) < math.abs(q.x - cx)
	end)
	for i = #list, RULES.maxTargets + 1, -1 do
		list[i] = nil
	end
	return list
end

-- 졸개가 맞는다. 쓰러졌으면 true.
function Room:damageMob(mob, dmg: number, fromX: number, byId: any): boolean
	mob.hp = math.max(0, mob.hp - dmg)
	mob.target, mob.aggro = byId, 5
	if mob.hp <= 0 then
		mob.state, mob.t, mob.target = "dead", 0, nil
		mob.bind, mob.stun, mob.rend, mob.cracks = 0, 0, 0, 0
		return true
	end
	if mob.boss then
		return false -- 스토리 보스는 맞아도 하던 동작을 멈추지 않고 밀리지 않는다
	end
	-- 멈칫한다 · 조금 밀린다(폭탄병도 다른 몬스터처럼 맞으면 터뜨리던 것을 멈춘다)
	mob.state, mob.t = "hit", 0
	if mob.def.speed > 0 then -- 제자리 몬스터(굴 두더지)는 밀리지 않는다
		mob.x = math.clamp(mob.x + sign(mob.x - fromX) * 3, mob.a, mob.b)
	end
	return false
end

-- 그 졸개가 살아서 맞을 수 있는가
local function alive(mob): boolean
	return mob.state ~= "dead" and mob.state ~= "gone" and mob.state ~= "spawn"
end

-- (x, y)에서 가장 가까운, 살아 있는 졸개(range 안 — except는 빼고). 사출기가 날아갈 곳을 찾는다
function Room:nearestMob(x: number, y: number, range: number, except: any)
	local best, bestD = nil, math.huge
	for _, mob in self.mobs do
		if mob ~= except and alive(mob) and math.abs(mob.y - y) <= 60 then
			local d = math.abs(mob.x - x)
			if d <= range and d < bestD then
				best, bestD = mob, d
			end
		end
	end
	return best
end

-- 졸개 하나에게 피해를 넣고 일을 적는다(out.hits — 쓰러지면 out.kills에 경험치 · 떨어지는 것까지). 쓰러졌으면 true.
--  extra = 그 타에 붙는 표시: proc(사출기 · 장치의 이름 — "echo" · "star" · "wisp" · "shard" · "ember" · "flame" · "reson") · sx · sy(그것이 날아오는 자리) · crit(치명타) · big(센 타)
function Room:strike(hero, mob, dmg: number, fromX: number, mates, out, extra): boolean
	-- 갈라짐(액시온의 쪼개기)이 걸린 적은 누구에게 맞든 더 아프다
	if (mob.rend or 0) > 0 then
		dmg = math.max(1, math.floor(dmg * (1 + CASTRULE.rend) + 0.5))
	end
	local dead = self:damageMob(mob, dmg, fromX, hero.id)
	local entry = { mob = mob.id, dmg = dmg, hp = mob.hp, dead = dead }
	if extra then
		for k, v in extra do
			entry[k] = v
		end
	end
	table.insert(out.hits, entry)
	if dead then
		mob.marks = nil
		-- 리퍼의 영혼: 쓰러뜨리면 하나
		if Kit.gainSoul(hero) then
			out.kit = true
		end
		-- 꺼지지 않는 불(살라맨더 4차): 폭주 중에 쓰러뜨리면 폭주가 늘어난다
		local burst = hero.buffs.sl_overheat
		if burst and hero.pass then
			local fx = Passives.get(hero, "extend")
			if fx and hero.pass.extended < fx.extendMax then
				local add = math.min(fx.extend, fx.extendMax - hero.pass.extended)
				burst.t += add
				burst.dur += add
				hero.pass.extended += add
				out.buffs = true
			end
		end
		-- 저승문 곁에서 쓰러진 적은 영혼을 더 준다
		for _, p in self.placed or {} do
			if p.owner == hero and p.def.souls and math.abs(p.x - mob.x) <= p.def.near then
				for _ = 2, p.def.souls do
					Kit.gainSoul(hero)
				end
			end
		end
		-- 스토리 보스와 그가 부른 졸개: 경험치도 물건도 주지 않는다(보상은 그 메인 퀘스트의 것뿐). 보스는 방에 있는 모두에게 잡은 것으로 친다 — 서버가 gains의 사람마다 퀘스트를 센다
		if mob.boss or mob.add then
			local gains = {}
			if mob.boss then
				for _, h in self.heroes or { hero } do
					table.insert(gains, { hero = h.id, xp = 0, ups = 0, level = h.level })
				end
			end
			table.insert(out.kills, { mob = mob.id, kind = mob.kind, x = mob.x, y = mob.y, xp = 0, ups = 0, gains = gains, loot = {} })
			return dead
		end
		local list = mates or { hero }
		local share = Party.share(#list)
		local gains, myXp, myUps = {}, 0, 0
		for _, mate in list do
			-- 사람마다 제 레벨 차이 · 벌칙을 넣은 경험치에 나눈 몫을 곱한다
			local xp = math.max(1, math.floor(Hero.killXp(mate, mob.lv, mob.def.hp) * share + 0.5))
			local ups = Hero.gainXp(mate, xp)
			table.insert(gains, { hero = mate.id, xp = xp, ups = ups, level = mate.level })
			if mate == hero then
				myXp, myUps = xp, ups
			end
		end
		local drop, loot = self:dropFor(hero, mob), self:lootFor(hero, mob)
		if #list > 1 then
			local friends = {}
			for _, mate in list do
				friends[mate.id] = true
			end
			if drop then
				drop.friends = friends
			end
			for _, d in loot do
				d.friends = friends
			end
		end
		table.insert(out.kills, { mob = mob.id, kind = mob.kind, x = mob.x, y = mob.y, xp = myXp, ups = myUps, gains = gains, drop = drop, loot = loot })
	end
	return dead
end

-- 사출기 · 장치가 따로 넣는 한 타(그 졸개 하나에게). (sx, sy) = 그것이 날아오는 자리(화면이 그린다)
--  tag = 그 타에 더 붙는 표시(i 몇째 발 · n 한 번에 나간 수 · hop 튕긴 것 · up 배운 강화(화면이 그 모습으로 그린다))
function Room:proc(hero, mob, dmg: number, kind: string, sx: number, sy: number, mates, out, tag)
	local extra = { proc = kind, sx = math.floor(sx + 0.5), sy = math.floor(sy + 0.5) }
	if tag then
		for k, v in tag do
			extra[k] = v
		end
	end
	self:strike(hero, mob, math.max(1, math.floor(dmg + 0.5)), hero.x, mates, out, extra)
end

-- 설치 · 소환(COMBAT.placed — 공방 design/combat.js의 PLACED)을 놓는다. pow = 세기(그 스킬 레벨의 배수). 달 수정을 심는 것은 out에 적힌다(Crystal로 알린다).
--  놓인 것 = { skill, def, owner(그 사람), x, y, till(사라지는 때), next(다음에 치는 때), pow } — 따라다니는 것은 같은 것을 하나만 둔다(다시 쓰면 새것으로 바뀐다)
function Room:place(hero, id: string, pow: number, out)
	local def = PLACED[id]
	local x, y = hero.x + hero.dir * (def.ahead or 0), hero.y
	if def.kind == "crystal" then
		self:addCrystal(hero, x, y, out)
		return nil
	end
	if not (def.tick or def.every or def.pull or def.heat) then
		return nil -- 버프만 거는 것(연막탄)
	end
	self.placed = self.placed or {}
	if def.kind == "follow" then
		-- 따라다니는 것은 같은 것을 하나만 둔다 — 망령 군단 · 수호령 각성(4차)을 배웠으면 그 수까지(넘치면 먼저 부른 것이 사라진다)
		local keep = if id == "rp_ghost" then Passives.count(hero, "ghosts", 1) elseif id == "mn_guard" then Passives.count(hero, "guards", 1) else 1
		local have = 0
		for i = #self.placed, 1, -1 do
			local q = self.placed[i]
			if q.owner == hero and q.skill == id then
				have += 1
				if have >= keep then
					table.remove(self.placed, i)
				end
			end
		end
	end
	local p = { skill = id, def = def, owner = hero, x = x, y = y, till = self.time + def.life, next = self.time + (def.tick or def.every or 0), pow = pow }
	table.insert(self.placed, p)
	return p
end

-- 놓인 것들의 한 걸음: 태우고(field의 tick) · 치고(follow의 every) · 끌어당기고 · 열기를 올린다. 때가 됐거나 주인이 방에 없으면 사라진다
function Room:stepPlaced(heroes, dt: number, events)
	local here = {}
	for _, h in heroes do
		here[h] = true
	end
	local fit = RULES.dmgScale * (1 + RULES.targetBonus / 100)
	for i = #self.placed, 1, -1 do
		local p = self.placed[i]
		local def, hero = p.def, p.owner
		if self.time >= p.till or not here[hero] or not hero.alive then
			table.remove(self.placed, i)
			continue
		end
		if def.kind == "follow" then
			p.x, p.y = hero.x - hero.dir * def.back, hero.y
		end
		local result = nil
		local power = Hero.powerRaw(hero) * Kit.attack(hero) * Buffs.dmg(hero) * Passives.atk(hero)
		if self.time >= p.next and (def.tick or def.every) then
			local gap = def.tick or def.every
			p.next += gap
			local targets = if def.tick then self:mobsInBox(p.x - def.w / 2, p.x + def.w / 2, p.y - def.h, p.y + 6, p.x) else { self:nearestMob(p.x, p.y, def.range, nil) }
			for _, mob in targets do
				result = result or { hits = {}, kills = {} }
				local roll = 1 + self.rng:NextNumber(-RULES.spread, RULES.spread) / 100
				self:proc(hero, mob, power * def.mul * gap * p.pow * fit * roll, if def.tick then "field" else "summon", p.x, p.y - 12, nil, result)
			end
		end
		if def.pull then
			for _, mob in self.mobs do
				local dx = p.x - mob.x
				if alive(mob) and not mob.def.boss and math.abs(dx) < def.reach and math.abs(dx) > 4 and math.abs(mob.y - p.y) <= 60 then
					mob.x = math.clamp(mob.x + sign(dx) * def.pull * dt, mob.a, mob.b)
				end
			end
		end
		if def.heat and hero.class == "salamander" and Kit.level(hero, "core") > 0 and math.abs(hero.x - p.x) <= def.near then
			local kit, max = hero.kit, KIT.salamander.core.max
			local before = kit.heat
			kit.heat, kit.heatT = math.min(max, kit.heat + def.heat * dt), 0 -- 곁에 있으면 식지 않고 오른다
			if math.floor(before / 5) ~= math.floor(kit.heat / 5) then
				table.insert(events, { type = "self", hero = hero.id })
			end
		end
		if result then
			table.insert(events, { type = "kit", hero = hero.id, result = result })
		end
	end
end

-- 조금 뒤에 넣을 타(붙는 불 — 도깨비불이 붙어서 초마다 태운다): after초 뒤에 fn(out)을 부른다. 방의 한 걸음(step)이 때가 된 것을 풀어 "kit" 일로 알린다
function Room:later(hero, after: number, fn)
	self.laters = self.laters or {}
	table.insert(self.laters, { at = self.time + after, hero = hero, fn = fn })
end

-- 표식을 남긴다(리븐): 그 졸개에게 time초. 그 졸개가 이번에 맞은 기록에 mark(남은 초)를 적어 화면에 알린다
--  깊은 표식(3차)을 배웠으면 겹친다(marks까지) — 그 졸개의 기록에 markN(겹친 수)도 적는다
function Room:mark(hero, mob, out)
	local time = KIT.riven.core.time
	local n = math.min(Passives.count(hero, "marks", 1), self:marksOf(hero, mob) + 1)
	mob.marks = mob.marks or {}
	mob.markN = mob.markN or {}
	mob.marks[hero.id] = self.time + time
	mob.markN[hero.id] = n
	for i = #out.hits, 1, -1 do
		if out.hits[i].mob == mob.id then
			out.hits[i].mark = time
			out.hits[i].markN = n
			break
		end
	end
end

-- 그 사람이 그 졸개에 남긴 표식의 수(없으면 0)
function Room:marksOf(hero, mob): number
	if mob.marks and (mob.marks[hero.id] or 0) > self.time then
		return (mob.markN and mob.markN[hero.id]) or 1
	end
	return 0
end

-- 달 수정을 세운다(무니): 내 다른 수정과 apart보다 가까우면 세우지 않고, max개가 넘으면 가장 오래된 것이 사라진다. 생긴 것 · 사라진 것을 out.crystals · out.crystalGone에 적는다
function Room:addCrystal(hero, x: number, y: number, out)
	local core = KIT.mooni.core
	local mine = {}
	for _, c in self.crystals do
		if c.owner == hero.id then
			if math.abs(c.x - x) < core.apart and math.abs(c.y - y) < 20 then
				return
			end
			table.insert(mine, c)
		end
	end
	if #mine >= Passives.count(hero, "crystals", core.max) then -- 수정 군락(3차): 넷까지
		local old = mine[1] -- 먼저 세운 것이 앞에 있다
		table.remove(self.crystals, table.find(self.crystals, old))
		out.crystalGone = out.crystalGone or {}
		table.insert(out.crystalGone, old.id)
	end
	local grove, groveS = Passives.get(hero, "crystals") -- 수정 군락: 지속 +
	local c = { id = self.nextId, owner = hero.id, x = math.floor(x + 0.5), y = y, till = self.time + core.life * (1 + (if grove then grove.life * groveS else 0)) }
	self.nextId += 1
	table.insert(self.crystals, c)
	out.crystals = out.crystals or {}
	table.insert(out.crystals, Room.crystalView(c, self.time))
end

function Room.crystalView(c, now: number)
	return { id = c.id, owner = c.owner, x = c.x, y = c.y, life = math.max(0, c.till - now) }
end

-- 그 사람이 제 수정 곁에 있는가(무니의 지키는 마음)
function Room:nearCrystal(h): boolean
	if h.class ~= "mooni" then
		return false
	end
	local near = KIT.mooni.core.near
	for _, c in self.crystals do
		if c.owner == h.id and math.abs(c.x - h.x) <= near and math.abs(c.y - h.y) <= 50 then
			return true
		end
	end
	return false
end

-- 기술의 한 타. hero가 (x, y)에서 dir 쪽을 보고 쓴 기술의 hit(판정 하나)를 푼다. scale = 스킬 레벨에 따른 세기(없으면 1).
--  mates = 경험치를 함께 나눌 사람들(hero도 든다 — 같은 맵의 파티원. 없으면 혼자). 떨어진 것은 그 사람들도 바로 주울 수 있다.
--  돌려주는 것: { hits = { { mob, dmg, hp, dead, big, crit, proc, sx, sy, mark } … }, kills = { { mob, xp, ups, gains = { { hero, xp, ups, level } … }, drop, loot } … },
--				 kit(장치의 모습이 바뀌었다) · heal(되찾은 체력) · crystals · crystalGone(생긴 · 사라진 수정) }
--  kind = 그 기술의 갈래: 사냥기("mob")는 일반 몬스터에게, 보스기("boss")는 보스에게 피해가 targetBonus% 더 뜬다 — 맞지 않는 상대에게는 그 보정이 없다(체력은 보정만큼 크다)
--   (사용자 2026-10-07: "보스기는 보스 공격시 추가데미지, 사냥기는 일반 몹 공격시 추가 데미지 … 지금 그냥 보스기로 사냥하는게 더빠른현상이 생깁니다")
--  skillId = 그 기술(1차의 사출기 · 장치가 따라붙는 기술이면 맞힌 뒤에 그것들이 나간다 — sim/kit.luau) · opts = { mul 피해의 배수, reach 더 닿는 거리 }(힘 모으기)
function Room:skillHit(hero, hit, x: number, y: number, dir: number, scale: number?, mates, kind: string?, skillId: string?, opts)
	local box = hit.box
	local reach = if opts then opts.reach or 0 else 0
	local boost = if opts then opts.mul or 1 else 1
	-- 반올림하지 않은 전투력으로 셈한다(능력치 1점도 피해에 들어간다). 리퍼의 영혼은 공격력에 곱한다
	local power = Hero.powerRaw(hero) * Kit.attack(hero) * Buffs.dmg(hero) * Passives.atk(hero) -- 버프(달의 함성 · 만월 · 월식 …) · 패시브(숙련 · 달인 · 최종 피해)는 주는 피해에 곱한다
	local info = { skill = skillId, charge = if opts then opts.level or 0 else 0, now = self.time }
	local _, _, sure = Passives.crit(hero) -- 흘리기(리븐): 피한 뒤의 첫 베기는 반드시 치명타
	local out = { hits = {}, kills = {} }
	local follows = skillId ~= nil and Kit.follows(skillId) and COMBAT.skills[skillId].who == hero.class
	local landed = {} -- 이 타(제 범위)에 맞은 것들 { mob, dmg, dead }
	local big = Buffs.big(hero) * Passives.reach(hero) -- 거신 · 낫 숙련 · 영혼 주머니: 기술이 닿는 거리(앞 · 위)가 그만큼 는다
	-- 상자 하나를 (cx, cy)에서 푼다. share = 피해의 몫(수정의 공명은 그 일부) · tag = 그 타에 붙는 표시(없으면 기술의 제 타)
	local function sweep(cx: number, cy: number, share: number, tag)
		local xa, xb = cx + dir * box[1] * big, cx + dir * (box[2] + reach) * big
		local x0, x1 = math.min(xa, xb), math.max(xa, xb)
		for _, mob in self:mobsInBox(x0, x1, cy - box[3] * big, cy + box[4], cx) do
			local roll = 1 + self.rng:NextNumber(-RULES.spread, RULES.spread) / 100
			-- 가운데 타에 이미 맞은 적은 빼는 타(hit.except = 그 범위): 한 적이 같은 것을 두 번 맞지 않는다
			if hit.except then
				local e = hit.except
				local ea, eb = cx + dir * e[1] * big, cx + dir * (e[2] + reach) * big
				local hw, up, hh = bodyOf(mob)
				if mob.x + hw >= math.min(ea, eb) and mob.x - hw <= math.max(ea, eb) and mob.y - up >= cy - e[3] * big and mob.y - up - hh <= cy + e[4] then
					continue
				end
			end
			-- 쓰임의 보정: 사냥기는 일반 몬스터에게, 보스기는 보스에게 피해가 targetBonus% 더 뜬다(다른 갈래의 기술은 누구에게나 뜬다). 맞지 않는 상대에게는 보정이 없다
			local fit = if (kind == "mob" and mob.def.boss) or (kind == "boss" and not mob.def.boss) then 1 else 1 + RULES.targetBonus / 100
			local mul = hit.mul * (scale or 1) * boost * share * Passives.vs(hero, mob, info)
			-- 치명타: 모든 직업의 기술 타가 확률로(기본 + 패시브 + 리븐의 표식이 있는 적). 흘리기 = 피한 뒤의 첫 베기는 반드시
			local critChance, critMul = Passives.crit(hero, self:marksOf(hero, mob) > 0)
			local crit = sure or (critChance > 0 and self.rng:NextNumber(0, 100) < critChance)
			if crit then
				mul *= critMul
			end
			local dmg = math.max(1, math.floor(power * mul * roll * RULES.dmgScale * fit + 0.5)) -- dmgScale = 피해 숫자의 배율(올린 만큼 숫자로 보이게 — 공방 combat.js)
			local extra = if tag then table.clone(tag) else {}
			if hit.mul * boost * share >= BIG_HIT or crit then
				extra.big = true
			end
			if crit then
				extra.crit = true
			end
			local dead = self:strike(hero, mob, dmg, cx, mates, out, extra)
			if not tag then
				Passives.onHit(hero, mob, self.time) -- 이어 맞힌 수 · 이어 때린 수(살라맨더의 주먹 숙련 · 몰아붙이기)
				if not dead and (hit.pull or 0) > 0 then
					-- 끌어온다: 쓴 사람 쪽으로(제 범위 안에서만)
					local toward = if mob.x > x then -1 else 1
					mob.x = math.clamp(mob.x + toward * math.min(hit.pull, math.max(0, math.abs(mob.x - x) - 10)), mob.a, mob.b)
				end
				table.insert(landed, { mob = mob, dmg = dmg, dead = dead })
			end
		end
	end
	sweep(x, y, 1, nil)
	if sure and #landed > 0 and hero.pass then
		hero.pass.sure = false -- 흘리기의 반드시 치명타는 한 번 쓰면 사라진다
	end
	-- 넘치는 힘(액시온 4차): 끝까지 모은 강타를 맞히면 잠깐 동안 다음 강타가 높은 단계에서 시작한다
	if opts and not opts.surged and (opts.level or 0) > 0 and opts.level >= Kit.chargeLevels(hero) and #landed > 0 and hero.pass then
		local surge = Passives.get(hero, "surge")
		if surge then
			hero.pass.surge = self.time + surge.surge
		end
	end
	if follows then
		self:kitAfter(hero, landed, x, y, sweep, power, mates, out)
		-- 그림자 분신(리븐의 버프): 분신이 내 베기를 조금 뒤에 따라 벤다 — 맞은 적마다 그 타 피해의 일부. 표식을 남기는 베기였으면 분신의 것도 남긴다
		local share, after = Buffs.echo(hero)
		if share > 0 and #landed > 0 then
			local marks = hero.class == "riven" and Kit.level(hero, "core") > 0
			local fromX, fromY = x - dir * 13, y - 12
			self:later(hero, after, function(res)
				for _, l in landed do
					if alive(l.mob) then
						self:proc(hero, l.mob, l.dmg * share, "clone", fromX, fromY, mates, res)
						if marks and alive(l.mob) then
							self:mark(hero, l.mob, res)
						end
					end
				end
			end)
		end
	end
	return out
end

-- 1차의 사출기 · 장치 · 패시브가 따라 나간다(그 직업의 도끼질 · 베기 · 낫질 · 대검 · 주먹의 한 타 뒤에). landed = 그 타에 맞은 것들 · sweep = 같은 상자를 다른 자리에서 푸는 함수(수정의 공명)
--  opts = 2~4차의 스킬(sim/caster.luau)이 부를 때: sweep이 없다(수정에서 한 번 더 나가는 것은 그 스킬의 묶음이 제 손으로 한다) · mark = 표식을 남기는 타인가(묶음이 타마다 정한다)
function Room:kitAfter(hero, landed, x: number, y: number, sweep, power: number, mates, out, opts)
	local class, st, kit = hero.class, hero.kit, KIT[hero.class]
	local now = self.time
	-- 무니 · 수정 공명: 수정 곁에서 쓴 대검은 수정에서도 같은 범위로 한 번 더 나간다(제 타가 맞든 안 맞든)
	if sweep and class == "mooni" and Kit.level(hero, "core") > 0 then
		local share = kit.core.share * Kit.scale(hero, "core")
		for _, c in table.clone(self.crystals) do
			if c.owner == hero.id and math.abs(c.x - x) <= kit.core.near and math.abs(c.y - y) <= 50 then
				sweep(c.x, c.y, share, { proc = "reson", sx = c.x, sy = c.y })
			end
		end
	end
	if #landed == 0 then
		return
	end
	local first = landed[1].mob
	if class == "reaper" then
		-- 생기 흡수: 낫 기술의 한 타가 맞을 때마다(몇 마리가 맞든 한 번)
		local s = Kit.scale(hero, "passive")
		if s > 0 and hero.alive and hero.hp < hero.maxHp then
			-- 깊은 흡수(3차): 되찾는 체력 + · 영혼이 가득하면 그 배
			local deep, deepS = Passives.get(hero, "drain")
			local more = if deep then (1 + deep.drain * deepS) * (if hero.kit.souls >= Kit.soulMax(hero) then deep.fullMul else 1) else 1
			local heal = math.min(hero.maxHp - hero.hp, math.max(1, math.floor(hero.maxHp * kit.passive.heal / 100 * s * more + 0.5)))
			hero.hp += heal
			out.heal = (out.heal or 0) + heal
		end
	elseif class == "riven" then
		-- 표식: 베기에 맞은 적에게
		if Kit.level(hero, "core") > 0 and (not opts or opts.mark) then
			for _, l in landed do
				if not l.dead then
					self:mark(hero, l.mob, out)
				end
			end
		end
	elseif class == "mooni" then
		-- 수정이 맺힌다: 맞은 적의 발밑에
		if Kit.level(hero, "core") > 0 and self.rng:NextNumber(0, 100) < kit.core.chance then
			self:addCrystal(hero, first.x, first.y, out)
		end
		-- 달빛 칼날(3차): 대검이 맞은 횟수가 every번째일 때마다 그 타 피해의 일부가 둘레로 번진다
		local edge, edgeS = Passives.get(hero, "edge")
		if edge and hero.pass then
			for _, l in landed do
				hero.pass.edge += 1
				if hero.pass.edge % edge.every == 0 then
					for _, o in self.mobs do
						if alive(o) and math.abs(o.x - l.mob.x) <= edge.range + BODY_W and math.abs(o.y - l.mob.y) <= 20 then
							self:proc(hero, o, l.dmg * edge.edge * edgeS, "edge", l.mob.x, l.mob.y - 8, mates, out)
						end
					end
				end
			end
		end
	elseif class == "salamander" and Kit.level(hero, "core") > 0 then
		-- 열기가 오르고, 달아올라 있으면 맞은 적마다 불꽃이 한 번 더
		out.kit = true
		if Kit.gainHeat(hero) then
			local share = kit.core.share * Kit.scale(hero, "core")
			for _, l in landed do
				if alive(l.mob) then
					self:proc(hero, l.mob, l.dmg * share, "flame", l.mob.x, l.mob.y, mates, out)
				end
			end
		end
	end
	-- 온오프 사출기(켜 두었을 때). 2~4차의 강화 패시브(COMBAT.kitUp)가 하나 더 내보내고 · 번지고 튕기고 · 더 자주 더 세게 한다
	if not Kit.firing(hero) then
		return
	end
	local tg, s = kit.toggle, Kit.scale(hero, "toggle")
	local fit = RULES.dmgScale * (1 + RULES.targetBonus / 100) -- 사냥기도 보스기도 아닌 것은 누구에게나 보정이 붙은 숫자로 뜬다(skillHit과 같은 법)
	local ups = UP[class]
	-- 그 강화의 자료와 세기(배우지 않았으면 0)
	local function up(role: string)
		local def = ups[role]
		return def, if def then Hero.skillScale(hero.skills[def.id] or 0, def.max) else 0
	end
	local two, twoS = up("two")
	local fast, fastS = up("fast")
	-- 화면에 알리는 것: 배운 강화(1 = 하나 더 · 2 = 셋째 갈래 · 4 = 넷째 갈래) — 남의 화면도 그 모습으로 그린다
	local third = ups.splash or ups.hop or ups.burn or ups.pierce
	local thirdS = Hero.skillScale(hero.skills[third.id] or 0, third.max)
	local bits = (if twoS > 0 then 1 else 0) + (if thirdS > 0 then 2 else 0) + (if fastS > 0 then 4 else 0)
	local more = 1 + (fast.more or 0) * fastS
	if class == "axion" then
		-- 메아리 도끼: 도끼질이 맞은 횟수가 every번째일 때마다 그 적 머리 위에서. 겹 메아리 = 하나 더 · 울리는 메아리 = 떨어진 자리 둘레로 번진다 · 달 그림자 도끼 = 두 번째 타마다 · 더 세게
		local every = if fastS > 0 then fast.every else tg.every
		for _, l in landed do
			st.n += 1
			if st.n % every == 0 and alive(l.mob) then
				local base = l.dmg * tg.share * s * more
				self:proc(hero, l.mob, base, "echo", l.mob.x, l.mob.y - 60, mates, out, { i = 0, up = bits })
				if twoS > 0 and alive(l.mob) then
					self:proc(hero, l.mob, base * two.share * twoS, "echo", l.mob.x, l.mob.y - 60, mates, out, { i = 1, up = bits })
				end
				if thirdS > 0 then
					for _, o in self.mobs do
						if o ~= l.mob and alive(o) and math.abs(o.x - l.mob.x) <= third.range + BODY_W and math.abs(o.y - l.mob.y) <= 20 then
							self:proc(hero, o, base * third.share * thirdS, "splash", l.mob.x, l.mob.y, mates, out)
						end
					end
				end
			end
		end
	elseif class == "riven" then
		-- 그림자 표창: 확률로, 가까운 다른 적(없으면 그 적)에게 — 표식을 남긴다. 쌍표창 = 맞은 적에게도 하나 · 되돌아오는 표창 = 한 번 튕긴다 · 피의 표창 = 확률이 오르고 표식이 있는 적에게 더 세다
		local chance = tg.chance + (if fastS > 0 then (fast.chance - tg.chance) * fastS else 0)
		local function throw(target, dmg: number, i: number, fromX: number, fromY: number)
			local marked = target.marks ~= nil and (target.marks[hero.id] or 0) > self.time
			local hit = dmg * (if marked then 1 + fast.marked * fastS else 1)
			self:proc(hero, target, hit, "star", fromX, fromY, mates, out, { i = i, up = bits })
			if alive(target) and Kit.level(hero, "core") > 0 then
				self:mark(hero, target, out)
			end
			if thirdS > 0 then
				local nextOne = self:nearestMob(target.x, target.y, third.range, target)
				if nextOne then
					self:proc(hero, nextOne, hit * third.share * thirdS, "star", target.x, target.y - 10, mates, out, { i = i, hop = true, up = bits })
					if alive(nextOne) and Kit.level(hero, "core") > 0 then
						self:mark(hero, nextOne, out)
					end
				end
			end
		end
		for _, l in landed do
			if self.rng:NextNumber(0, 100) < chance then
				local base = l.dmg * tg.share * s
				local target = self:nearestMob(l.mob.x, l.mob.y, tg.range, l.mob) or (if alive(l.mob) then l.mob else nil)
				if target then
					throw(target, base, 0, hero.x, hero.y - 12)
				end
				if twoS > 0 and alive(l.mob) then
					throw(l.mob, base * two.share * twoS, 1, hero.x, hero.y - 6)
				end
			end
		end
	elseif class == "salamander" then
		-- 불티: 맞을 때마다, 가까운 다른 적(없으면 그 적)에게. 겹불티 = 달아오름 동안 하나 더 · 옮겨붙는 불티 = 옆의 적으로 한 번 · 불새 = 더 세게
		local function throw(target, dmg: number, i: number, fromX: number, fromY: number)
			self:proc(hero, target, dmg, "ember", fromX, fromY, mates, out, { i = i, up = bits })
			if thirdS > 0 then
				local nextOne = self:nearestMob(target.x, target.y, third.range, target)
				if nextOne then
					self:proc(hero, nextOne, dmg * third.share * thirdS, "ember", target.x, target.y - 10, mates, out, { i = i, hop = true, up = bits })
				end
			end
		end
		for _, l in landed do
			local target = self:nearestMob(l.mob.x, l.mob.y, tg.range, l.mob) or (if alive(l.mob) then l.mob else nil)
			if target then
				local base = l.dmg * tg.share * s * more
				throw(target, base, 0, l.mob.x, l.mob.y - 10)
				if twoS > 0 and Kit.hot(hero) and alive(target) then
					throw(target, base * two.share * twoS, 1, l.mob.x, l.mob.y - 10)
				end
			end
		end
	elseif class == "reaper" then
		-- 도깨비불: cd초에 한 번, 맞은 적(쓰러졌으면 가까운 적)에게. 떼도깨비불 = 영혼 둘마다 하나 더 · 붙는 불 = 붙어서 초마다 태운다 · 원혼 = 더 자주(초당 피해는 그대로) · 더 세게
		local cd = tg.cd - (if fastS > 0 then (tg.cd - fast.cd) * fastS else 0)
		if now - st.at >= cd then
			local list = {}
			for _, mob in self.mobs do
				if alive(mob) and math.abs(mob.x - first.x) <= tg.range and math.abs(mob.y - first.y) <= 60 then
					table.insert(list, mob)
				end
			end
			table.sort(list, function(p, q)
				return math.abs(p.x - first.x) < math.abs(q.x - first.x)
			end)
			if #list > 0 then
				st.at = now
				local n = if twoS > 0 then math.min(two.max, 1 + math.floor(st.souls / 2)) else 1
				for i = 0, n - 1 do
					local target = list[i % #list + 1]
					if alive(target) then
						local roll = 1 + self.rng:NextNumber(-RULES.spread, RULES.spread) / 100
						local dmg = power * tg.mul * (cd / tg.cd) * s * more * fit * roll * (if i == 0 then 1 else two.share * twoS)
						self:proc(hero, target, dmg, "wisp", hero.x + (i - n / 2) * 6, hero.y - 20 - (i % 2) * 6, mates, out, { i = i, n = n, up = bits })
						if thirdS > 0 then
							for k = 1, third.ticks do
								self:later(hero, k, function(o2)
									if alive(target) and hero.alive then
										self:proc(hero, target, dmg * third.share * thirdS, "burn", target.x, target.y - 8, mates, o2)
									end
								end)
							end
						end
					end
				end
			end
		end
	elseif class == "mooni" then
		-- 수정 조각: cd초에 한 번, 내 수정마다 하나(수정이 없으면 대검에서 하나) — 가까운 적에게. 쌍조각 = 하나 더 · 꿰뚫는 조각 = 뒤의 적까지 · 수정 검 = 더 자주(초당 피해는 그대로) · 더 세게
		local cd = tg.cd - (if fastS > 0 then (tg.cd - fast.cd) * fastS else 0)
		if now - st.at >= cd then
			local sources = {}
			for _, c in self.crystals do
				if c.owner == hero.id then
					table.insert(sources, { c.x, c.y - 12, c.y })
				end
			end
			if #sources == 0 then
				sources = { { hero.x, hero.y - 14, hero.y } }
			end
			for _, src in sources do
				local target = self:nearestMob(src[1], src[3], tg.range, nil)
				if target then
					st.at = now
					for i = 0, if twoS > 0 then 1 else 0 do
						if not alive(target) then
							break
						end
						local roll = 1 + self.rng:NextNumber(-RULES.spread, RULES.spread) / 100
						local dmg = power * tg.mul * (cd / tg.cd) * s * more * fit * roll * (if i == 0 then 1 else two.share * twoS)
						local dirTo = if target.x >= src[1] then 1 else -1
						local tx, ty = target.x, target.y
						self:proc(hero, target, dmg, "shard", src[1], src[2], mates, out, { i = i, up = bits })
						if thirdS > 0 then
							-- 꿰뚫는다: 그 적 뒤(날아가는 쪽)의 적들
							local behind = {}
							for _, mob in self.mobs do
								if mob ~= target and alive(mob) and (mob.x - tx) * dirTo > 0 and math.abs(mob.x - tx) <= third.range and math.abs(mob.y - ty) <= 30 then
									table.insert(behind, mob)
								end
							end
							table.sort(behind, function(p, q)
								return math.abs(p.x - tx) < math.abs(q.x - tx)
							end)
							for k = 1, math.min(third.n, #behind) do
								self:proc(hero, behind[k], dmg * third.share * thirdS, "pierce", tx, ty - 10, mates, out)
							end
						end
					end
				end
			end
		end
	end
end

-- 잡은 졸개가 떨어뜨리는 달돈(열에 여섯). 장비와 달가루는 lootFor.
function Room:dropFor(hero, mob)
	if self.rng:NextNumber(0, 100) >= N.data.COIN.chance then
		return nil
	end
	local base = N.killMoney(mob.lv) * mob.def.hp / (N.data.COIN.chance / 100)
	local amount = base * (1 + self.rng:NextNumber(-RULES.moneySpread, RULES.moneySpread) / 100)
	if hero.weak > 0 then
		amount *= 1 - N.data.BODY.death.cut / 100
	end
	local drop = { id = self.nextId, kind = "money", amount = math.max(1, math.floor(amount + 0.5)), x = mob.x, y = mob.y, owner = hero.id, born = self.time }
	self.nextId += 1
	self.drops[drop.id] = drop
	return drop
end

-- 잡은 졸개가 떨어뜨리는 장비와 달가루(없으면 빈 표). 쓰러진 뒤의 벌칙 동안에는 덜 나온다.
function Room:lootFor(hero, mob)
	local out = {}
	local mul = if hero.weak > 0 then 1 - N.data.BODY.death.cut / 100 else 1
	-- 떨어지는 것은 모두 방의 드롭 난수로 굴린다(졸개의 움직임을 굴리는 난수와 따로 — 드롭의 확률을 고쳐도 싸움의 흐름이 달라지지 않는다)
	local lootRng = self.lootRng or self.rng
	local item = Items.rollDrop(lootRng, mob.lv, hero.class, mul)
	if item then
		table.insert(out, self:addDrop({ kind = "gear", item = item, amount = 1 }, mob.x + (#out + 1) * 9, mob.y, hero.id))
	end
	local dust = Items.rollDust(lootRng, mob.lv, mul)
	if dust then
		table.insert(out, self:addDrop({ kind = "dust", amount = dust }, mob.x + (#out + 1) * 9, mob.y, hero.id))
	end
	-- 재료(그 레벨대의 광석 · 가죽)와 낮은 확률의 귀한 것(물약 · 귀환 주문서): 가방에 들어가는 아이템이 제 그림 그대로 떨어진다(kind = "goods")
	local function goods(id: string)
		local g = Items.goods(id)
		if g then
			table.insert(out, self:addDrop({ kind = "goods", goods = id, amount = 1, name = g.name, icon = g.icon }, mob.x + (#out + 1) * 9, mob.y, hero.id))
		end
	end
	for _, id in Items.rollMats(lootRng, mob.lv, mul) do
		goods(id)
	end
	for _, id in Items.rollRare(lootRng, mob.lv, mul) do
		goods(id)
	end
	return out
end

-- 물건 하나를 (x, y)에 떨어뜨린다. owner = 얼마 동안 혼자 주울 수 있는 사람
function Room:addDrop(drop, x: number, y: number, owner: any)
	drop.id, drop.x, drop.y, drop.owner, drop.born = self.nextId, x, y, owner, self.time
	self.nextId += 1
	self.drops[drop.id] = drop
	return drop
end

-- 방 사람들에게 알릴 때의 꼴(떨어진 것 하나)
function Room.dropView(d)
	return { id = d.id, kind = d.kind, amount = d.amount, x = d.x, y = d.y, name = d.name, icon = d.icon, item = if d.item then { slot = d.item.slot, stage = d.item.stage, q = d.item.q, star = d.item.star, who = d.item.who } else nil }
end

-- 줍는다. 주웠으면 그 물건을, 아니면 nil과 까닭을 돌려준다.
function Room:pickup(hero, dropId: number)
	local d = self.drops[dropId]
	if not d then
		return nil, "없음"
	end
	if not hero.alive then
		return nil, "쓰러짐"
	end
	if math.abs(d.x - hero.x) > RULES.pickup or math.abs(d.y - hero.y) > RULES.pickup + 12 then
		return nil, "멀다"
	end
	if d.owner ~= hero.id and not (d.friends and d.friends[hero.id]) and self.time - d.born < RULES.dropOwn then
		return nil, "남의 것"
	end
	-- 퀘스트의 물건은 그 퀘스트를 하는 사람의 것이다(시간이 지나도 남이 줍지 못한다). 주우면 가방의 기타 탭에 들어간다 — 퀘스트의 숫자는 부른 쪽이 가방에 맞춘다(Hero.syncQuests)
	if d.kind == "quest" and d.owner ~= hero.id then
		return nil, "남의 것"
	end
	if d.kind == "quest" or d.kind == "goods" then
		local ok, why = Bag.give(hero, d.goods, d.amount)
		if not ok then
			return nil, why
		end
	elseif d.kind == "gear" then
		local ok, why = Bag.add(hero, d.item)
		if not ok then
			return nil, why
		end
	elseif d.kind == "dust" then
		hero.dust += d.amount
	elseif d.kind == "money" then
		hero.money += d.amount
	end
	self.drops[dropId] = nil
	return d
end

-- 지금 졸개들의 모습(화면에 그릴 것만)
function Room:snapshot()
	local list = {}
	for i, mob in self.mobs do
		-- 일곱째 · 여덟째 = 묶인 시간 · 넘어진 시간(초 — 없으면 0): 화면이 휘감는 기운 · 수정 감옥을 그린다
		-- 아홉째 = 스토리 보스가 지금 하는 패턴의 차례(없으면 0): 화면이 예고와 이펙트를 그린다
		-- 열째 = 겨눈 자리(도약이 내려앉을 데 · 불씨가 떨어질 데 — 없으면 0) · 열한째 = 연속기의 차례(0이면 연속기가 아니다) · 열두째 = 지금 패턴이 그 연속기의 quick배로 빠른가(1 — 연속기의 둘째부터)
		list[i] = { mob.id, math.floor(mob.x * 10 + 0.5) / 10, mob.dir, mob.state, math.floor(mob.t * 100 + 0.5) / 100, mob.hp, math.floor((mob.bind or 0) * 10 + 0.5) / 10, math.floor((mob.stun or 0) * 10 + 0.5) / 10, mob.pat or 0, math.floor((mob.aim or 0) + 0.5), mob.chainPat or 0, if (mob.quick or 1) ~= 1 then 1 else 0 }
	end
	return list
end

-- 2~4차의 스킬을 재 볼 때 쓰는 빈 방: 졸개 하나가 (x, y)에 서 있다(쓰러지지 않는다). 방과 그 졸개를 돌려준다(sim/caster.luau의 profile)
Caster.makeDry = function(x: number, y: number)
	local dry = setmetatable({ key = "dry", scene = nil, rng = Random.new(7), time = 0, mobs = {}, shots = {}, drops = {}, crystals = {}, nextId = 1 }, Room)
	local mob = { id = 1, kind = "trainee", def = COMBAT.mobs.trainee, lv = 1, homeX = x, y = y, a = x - 2000, b = x + 2000, x = x, dir = -1, state = "idle", t = 0, hp = 1e12, maxHp = 1e12, cd = 0, wait = 0, goal = x, aggro = 0, struck = false, respawn = 0 }
	dry.mobs[1] = mob
	return dry, mob
end

-- 방에 들어온 사람에게 한 번 주는 것(졸개의 종류 · 레벨 · 체력, 떨어져 있는 것). heroId = 그 사람 — 남의 퀘스트 물건은 보여 주지 않는다
function Room:describe(heroId: any?)
	local mobs, drops = {}, {}
	for i, mob in self.mobs do
		mobs[i] = { id = mob.id, kind = mob.kind, lv = mob.lv, y = mob.y, maxHp = mob.maxHp, name = mob.def.name, boss = mob.boss or nil }
	end
	for _, d in self.drops do
		if d.kind == "quest" and d.owner ~= heroId then
			continue
		end
		table.insert(drops, Room.dropView(d))
	end
	local crystals = {}
	for i, c in self.crystals do
		crystals[i] = Room.crystalView(c, self.time)
	end
	return { key = self.key, mobs = mobs, drops = drops, crystals = crystals, snap = self:snapshot() }
end

return Room

end
MODULES['ReplicatedStorage/shared/lune/ui/format'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 화면에 적는 숫자와 글의 꼴 — 칸의 폭에 맞춰 고른다(글씨는 칸을 넘지 않는다). 화면과 상관없는 셈이라 테스트가 직접 돌린다.
--  measure(text) = 그 글의 폭(도트)을 재는 함수 — 게임에서는 pixelText.Measure.
local F = {}

-- 체력 칸 안의 자리: 레벨 글의 폭(Lv.150까지 들어가게) — 나머지가 체력 글의 폭이다
F.LEVEL_W = 48
F.LEVEL_GAP = 6

-- 큰 수를 짧게: 12,345 → 1.2만 · 123,456,789 → 1.2억
function F.short(n: number): string
	local function one(v: number, unit: string): string
		local s = string.format("%.1f", v)
		if s:sub(-2) == ".0" or #s >= 5 then
			s = string.format("%d", math.floor(v + 0.5))
		end
		return s .. unit
	end
	if n >= 1e8 then
		return one(n / 1e8, "억")
	elseif n >= 1e4 then
		return one(n / 1e4, "만")
	end
	return tostring(math.floor(n + 0.5))
end

-- 체력 글: "지금/최대"가 들어가면 그대로, 안 들어가면 짧게, 그래도 안 들어가면 지금 것만
function F.hp(cur: number, max: number, width: number, measure: (string) -> number): string
	local full = ("%d/%d"):format(cur, max)
	if measure(full) <= width then
		return full
	end
	local short = F.short(cur) .. "/" .. F.short(max)
	if measure(short) <= width then
		return short
	end
	return F.short(cur)
end

-- 키 이름을 화면에 적는 꼴
local KEYNAME = {
	LeftShift = "Shift", RightShift = "Shift", LeftControl = "Ctrl", RightControl = "Ctrl", LeftAlt = "Alt", RightAlt = "Alt", Space = "Space",
	Left = "←", Right = "→", Up = "↑", Down = "↓", Return = "Enter", Backspace = "Back", Backquote = "`", Minus = "-", Equals = "=",
	LeftBracket = "[", RightBracket = "]", Semicolon = ";", Quote = "'", Comma = ",", Period = ".", Slash = "/", BackSlash = "\\",
	Zero = "0", One = "1", Two = "2", Three = "3", Four = "4", Five = "5", Six = "6", Seven = "7", Eight = "8", Nine = "9",
}
function F.key(name: string): string
	return KEYNAME[name] or name
end

-- 주민의 말풍선(화면 틀의 고운 격자의 점): 말은 본문 글씨로 폭 textW에 lines줄까지. 말풍선은 그 주민 머리 위에 뜬다(얼굴 칸 · 이름표를 따로 두지 않는다 — 산나비처럼).
--  padX · padY = 글 둘레의 여백 · tail = 꼬리의 높이 · up = 머리 위로 띄우는 높이(게임의 도트). 값은 공방 js/lune/design/ui.js의 BUBBLE(시험 탭과 같은 값)
F.BUBBLE = require(script.Parent.Parent.data["ui.generated"]).bubble

-- 칸 위의 키 딱지에 적는 키 이름(작은 글씨): 다섯 글자까지 — 긴 이름은 줄임말로
local CAP = { PageUp = "PgUp", PageDown = "PgDn", CapsLock = "Caps", Insert = "Ins", Delete = "Del", Escape = "Esc", NEnter = "NEnt" }
function F.keyShort(name: string): string
	local text = F.key(name)
	local pad = string.match(text, "^Keypad(.+)$")
	if pad then
		text = "N" .. F.key(pad)
	end
	text = CAP[text] or text
	local out, n = "", 0
	for _, code in utf8.codes(text) do
		n += 1
		if n > 5 then
			break
		end
		out ..= utf8.char(code)
	end
	return out
end

-- 이름표에 적는 이름. 도트 글꼴에 있는 글자(한글 · 영문 · 숫자 · 몇 가지 기호)로만 된 이름은 그대로, 다른 글자가 섞였으면 대신할 이름(로블록스 아이디)을 쓴다.
--  길면 max글자에서 자른다.
local OK_EXTRA = { ["·"] = true, ["★"] = true, ["♥"] = true }
function F.safeName(display: any, fallback: string, max: number?): string
	local name = if typeof(display) == "string" and #display > 0 then display else fallback
	local ok = pcall(function()
		for _, code in utf8.codes(name) do
			local fine = (code >= 32 and code <= 126) or (code >= 0xAC00 and code <= 0xD7A3) or (code >= 0x3131 and code <= 0x3163) or OK_EXTRA[utf8.char(code)]
			assert(fine)
		end
	end)
	if not ok then
		name = fallback
	end
	local out, n = "", 0
	for _, code in utf8.codes(name) do
		n += 1
		if n > (max or 12) then
			break
		end
		out ..= utf8.char(code)
	end
	return out
end

-- 좁은 칸에 적는 키 이름: 다 들어가면 그대로, 아니면 줄임말, 그래도 안 되면 들어가는 만큼만(적어도 한 글자)
local SHORT = { Space = "Spc", Shift = "Sft", Ctrl = "Ctl", Enter = "Ent", Back = "Bk", Alt = "Alt" }
function F.fitKey(name: string, width: number, measure: (string) -> number): string
	local text = F.key(name)
	if measure(text) <= width then
		return text
	end
	local short = SHORT[text]
	if short and measure(short) <= width then
		return short
	end
	local out = ""
	for _, code in utf8.codes(text) do
		local try = out .. utf8.char(code)
		if out ~= "" and measure(try) > width then
			break
		end
		out = try
	end
	return out
end

-- 스킬 칸 · 메뉴 단추의 귀퉁이에 아주 작은 글씨(3x5 — 영문 대문자 · 숫자 · 몇 가지 기호)로 적는 키 이름. 네 글자까지.
--  화살표는 그 글씨의 < > ^ ~ 자리에 그려져 있다. 그 글씨에 없는 글자는 뺀다.
local MICRO = { Shift = "SHFT", Ctrl = "CTRL", Space = "SPC", Enter = "ENT", Back = "BACK", Alt = "ALT", Tab = "TAB", ["←"] = "<", ["→"] = ">", ["↑"] = "^", ["↓"] = "~" }
F.MICRO_CHARS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ+-/%.,:!?<>^~[];'\\=`*"
function F.keyMicro(name: string): string
	local text = F.key(name)
	if MICRO[text] then
		return MICRO[text]
	end
	local out = ""
	for i = 1, #text do
		local ch = string.upper(text:sub(i, i))
		if #out < 4 and string.find(F.MICRO_CHARS, ch, 1, true) then
			out ..= ch
		end
	end
	return out
end

-- 한 줄에 나란히 놓는 칸들의 폭: 저마다 글이 들어갈 만큼(min 이상) 잡고, 남는 폭은 고루 나눈다. 다 못 들어가면 nil.
function F.split(total: number, gap: number, needs: { number }, min: number): { number }?
	local n = #needs
	local widths, sum = {}, 0
	for i, need in needs do
		widths[i] = math.max(min, need)
		sum += widths[i]
	end
	local left = total - gap * (n - 1) - sum
	if left < 0 then
		return nil
	end
	local each = math.floor(left / n)
	for i = 1, n do
		widths[i] += each
	end
	return widths
end

-- ---------- 능력치의 설명 · 스킬 창의 글 ----------  글은 공방 js/lune/design/ui.js의 STATTIP · SKILLWORDS(data/ui.generated.luau의 statTip · skillWords)
-- 글 속의 {이름}을 o의 값으로 채운다
function F.fill(text: string, o): string
	return (text:gsub("{(%w+)}", function(k)
		local v = o[k]
		return if v == nil then "" else tostring(v)
	end))
end

-- 오르는 값을 적는 법: 100부터는 정수 · 10부터는 소수 한 자리 · 그 아래는 소수 두 자리
function F.gain(v: number): string
	if v >= 100 then
		return tostring(math.floor(v + 0.5))
	elseif v >= 10 then
		return ("%.1f"):format(v)
	end
	return ("%.2f"):format(v)
end

-- 능력치 하나의 설명(능력치 창에서 마우스를 올렸을 때): { kind(main 주 · sub 부 · none 이 직업은 안 쓴다 · hp 체력), title(능력치 이름), tag, lines }
--  사용자 2026-10-07: "능력치에 각각 스텟별로 마우스 올리면 호버로 스텟 효과를 보여줘야합니다. 뭔지알고 스텟을찍으라는건지"
--  그 직업에게 무엇을 해 주는지와, 지금 레벨에서 1점에 얼마가 오르는지를 실제 숫자로 적는다(공방 js/lune/ui/paint.js의 statTip과 같은 글 — 테스트 14가 맞춰 본다)
function F.statTip(class: string, id: string, level: number)
	local N = require(script.Parent.Parent.config.numbers)
	local CLASSES = require(script.Parent.Parent.data["classes.generated"])
	local TIP = require(script.Parent.Parent.data["ui.generated"]).statTip
	local STATS = N.data.STATS
	local pair = STATS.classes[class]
	local kind = if id == "hp" then "hp" elseif id == pair[1] then "main" elseif id == pair[2] then "sub" else "none"
	local gain = N.statGain(class, level)
	local users = {}
	for _, c in TIP.order do
		local q = STATS.classes[c]
		if q[1] == id or q[2] == id then
			table.insert(users, ("%s(%s)"):format(CLASSES.classes[c].name, if q[1] == id then TIP.marks.main else TIP.marks.sub))
		end
	end
	local o = {
		class = CLASSES.classes[class].name,
		main = STATS.names[pair[1]],
		ratio = STATS.mainW / STATS.subW,
		power = F.gain(if kind == "main" then gain.main else gain.sub),
		hp = F.gain(gain.hp),
		users = table.concat(users, " · "),
	}
	local lines = {}
	for i, text in TIP[kind].lines do
		lines[i] = F.fill(text, o)
	end
	return { kind = kind, title = STATS.names[id], tag = TIP[kind].tag, lines = lines }
end

return F

end
MODULES['ReplicatedStorage/shared/lune/ui/guideText'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 조작 안내의 글 — 처음 하는 사람에게 지금 누를 키를 한 줄로 알려 준다(공방 js/lune/design/startplan.js의 차례 ② 「첫 5분」 · basics.js의 START).
--  화면을 모르는 셈이다: 캐릭터의 지금 상태에서 그때그때 고른다 — 무엇을 봤는지 따로 저장하지 않는다(할 일을 하면 그 안내는 저절로 사라진다).
--  맨 처음에만 가르친다(사용자 2026-10-11: "레벨업 했을때 능력치, 스킬 찍으라고 계속 글씨뜨는거 이거 빼세요 맨처음 튜토리얼때 가르쳐주는거지 계속적인 알림을 보내는게 아닙니다."):
--   첫 사냥 퀘스트 「마을 밖의 그림자」를 돌려주면 그 뒤로는 어떤 안내도 뜨지 않는다. 능력치 · 스킬을 찍으라는 안내는 처음 점수를 받은 Lv.2에서만 뜬다(그 뒤의 레벨업에서는 뜨지 않는다).
--  그리는 것은 client/lune/guide.luau. 자동 검사(27_lune_start)가 모든 안내 글이 칸(W x LINES줄)에 들어가는지 본다.
local Quests = require(script.Parent.Parent.sim.quests)

local Guide = {}
Guide.W, Guide.LINES = 420, 2 -- 안내 글의 칸(화면 틀의 고운 격자의 점 · 작은 글씨)
Guide.UNTIL = 5 -- 이 레벨이 지나면 조작 안내는 뜨지 않는다(퀘스트의 길잡이는 알리미가 한다)

-- 지금 띄울 안내를 고른다. s = 지금의 상태:
--  { level, quests(book), scene(장면 이름표), touch(스마트폰 단추인가), nearNpc(가까이 선 주민의 id), drop(주울 것이 발밑에 있는가), hpShare(체력 0~1), potions(가방의 물약 수),
--    ap · sp(안 찍은 점수), key = function(하는 일) → 키 이름, slotOf = function(갈래 "mob" · "boss" · "move" · "potion") → 그것이 놓인 칸의 키 이름과 이름(없으면 nil) }
--  돌려주는 것: 안내 글(없으면 nil). 화면을 모르는 셈이라 자동 검사가 그대로 부른다
function Guide.pick(s): string?
	if s.level > Guide.UNTIL then
		return nil
	end
	local book = s.quests or {}
	local key = s.key
	local first, second = book.r1m1, book.r1m2
	-- 튜토리얼(첫 기술 → 첫 사냥)이 끝났으면 더 가르치지 않는다
	if second and second.done then
		return nil
	end
	-- ① 첫 퀘스트 「첫 기술」: 사제에게 걸어가서 말을 걸어 받고, 한 번 더 말을 걸어 끝낸다(새 캐릭터 — Lv.1). 받기 전(first == nil)에도 뜬다 — 퀘스트는 저절로 받지 않는다
	if not (first and first.done) and s.level <= 1 then
		if s.scene ~= "in_shrine" then
			return "달의 사당의 그믐 사제에게 간다"
		elseif s.nearNpc == "master" then
			local what = if first then "한 번 더 말을 걸어 「첫 기술」을 끝낸다" else "그믐 사제에게 말을 걸어 「첫 기술」을 받는다"
			return if s.touch then ("「말 걸기」 단추: %s"):format(what) else ("%s 키: %s"):format(key("up"), what)
		end
		return if s.touch then "왼쪽 아래의 조이스틱으로 걷는다 — 그믐 사제에게 간다" else ("%s %s 키로 걷는다 — 그믐 사제에게 간다"):format(key("left"), key("right"))
	end
	-- ② 주울 것이 발밑에 있다
	if s.drop then
		return if s.touch then "「줍기」 단추: 떨어진 것을 줍는다" else ("%s 키: 떨어진 것을 줍는다"):format(key("pickup"))
	end
	-- ③ 체력이 절반 아래다
	if s.hpShare < 0.5 and s.potions > 0 then
		local potionKey = s.slotOf("potion")
		if potionKey then
			return if s.touch then "물약 단추: 체력을 되찾는다" else ("%s 키: 물약을 마신다"):format(potionKey)
		end
	end
	-- ④ 처음 받은 점수를 찍는다(능력치 → 스킬) — 길 안내보다 먼저: 찍지 않으면 사냥이 느리다. 처음 점수를 받은 Lv.2에서만(그 뒤의 레벨업마다 되풀이하지 않는다)
	if s.level == 2 then
		if s.ap > 0 then
			return if s.touch then "「메뉴」 → 능력치: 받은 점수를 찍는다(「자동으로 찍기」)" else ("%s 키: 능력치 창 — 받은 점수를 찍는다(「자동으로 찍기」)"):format(key("win:stat"))
		elseif s.sp > 0 then
			return if s.touch then "「메뉴」 → 스킬: 스킬 포인트로 스킬을 올린다(「추천대로 찍기」)" else ("%s 키: 스킬 창 — 스킬 포인트로 스킬을 올린다(「추천대로 찍기」)"):format(key("win:skill"))
		end
	end
	-- ⑤ 첫 사냥 「마을 밖의 그림자」: 받기 전에는 샛별에게, 받은 뒤에는 문 밖으로, 사냥터에서는 기술의 키
	if first and first.done and not (second and second.done) then
		if not second then
			if s.scene == "in_shrine" then
				return if s.touch then "문 앞에서 「들어가기」 단추: 사당 밖으로 나간다" else ("문 앞에서 %s 키: 사당 밖으로 나간다"):format(key("up"))
			elseif s.scene == "town" then
				return if s.touch
					then "「점프」로 뛴다 · 조이스틱 아래 + 「점프」로 내려간다 — 샛별은 맨 아래 길의 왼쪽"
					else ("%s 키로 뛴다 · %s + %s 키로 내려간다 — 샛별은 맨 아래 길의 왼쪽"):format(key("jump"), key("down"), key("jump"))
			end
		elseif not Quests.isReady(book, "r1m2") then
			if s.scene == "r1a1" then
				local mobKey, mobName = s.slotOf("mob")
				local moveKey, moveName = s.slotOf("move")
				if s.touch then
					return "오른쪽 아래의 기술 단추로 수습 검병을 쓰러뜨린다"
				elseif mobKey and moveKey then
					return ("수습 검병을 쓰러뜨린다 — %s 키: %s · %s 키: %s"):format(mobKey, mobName, moveKey, moveName)
				end
			elseif s.scene == "town" then
				return if s.touch then "마을 왼쪽 끝의 문 앞에서 「들어가기」 단추: 마을 어귀로 나간다" else ("마을 왼쪽 끝의 문 앞에서 %s 키: 마을 어귀로 나간다"):format(key("up"))
			end
		end
	end
	return nil
end

return Guide

end
MODULES['ReplicatedStorage/shared/lune/ui/itemInfo'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 아이템의 상세 — 가방 · 장비 창에서 고른 아이템을 창 옆의 작은 판에 적는 것(그리지는 않는다: client/lune/ui/itemDetail.luau가 그린다).
--  사용자 2026-10-08: "장비 탭에서 각각의 장비를 선택하면 그 해당장비가 장비창 옆에 작은모달이 떠서 아이템 스펙이 나와야합니다. 인벤토리에서 선택도 마찬가지입니다. 기타아이템, 소비아이템 모두 마찬가지입니다."
--  글과 차례는 공방 js/lune/design/items.js의 gearInfo · goodsInfo와 같다(낱말은 data/items.generated.luau의 WORDS) — tools/test/tests/15_lune_items.luau가 공방의 본보기(checks.info)와 맞춰 본다.
--  돌려주는 것 { name, tone(이름의 색), sub(이름 아래의 갈래), rows = { { 이름, 값, 색 } … }, notes = { { 글, 색 } … } }
--   색 = "text" · "dim" · "accent" · "red" · "gold" · "tier0"~"tier4"(성능 단: 낡은 … 빼어난)
local Items = require(script.Parent.Parent.sim.items)
local N = require(script.Parent.Parent.config.numbers)
local CLASSES = require(script.Parent.Parent.data["classes.generated"])
local Format = require(script.Parent.format)

local D = Items.data
local W = D.WORDS
local POWER = N.data.POWER

local I = {}

-- 그 장비 하나가 주는 전투력(부서진 것은 0)
function I.power(it): number
	return math.floor(POWER.base * POWER.itemShare * Items.score(it) / D.WSUM + 0.5)
end

-- 지금 장착한 것(worn — 없으면 nil)과 바꾸면 달라지는 전투력
function I.wearDiff(it, worn): number
	local raw = POWER.base * POWER.itemShare * (Items.score(it) - (if worn then Items.score(worn) else 0)) / D.WSUM
	return math.sign(raw) * math.floor(math.abs(raw) + 0.5)
end

-- 장비의 상세. me = { level, class } · worn = 같은 부위에 장착한 것(없으면 nil) · isWorn = 이 장비가 바로 장착한 그것인가(장비 창에서 골랐다)
function I.gear(it, me, worn: any, isWorn: boolean?)
	local slot, q, need = Items.slot(it.slot), D.QUALITY[it.q], Items.needLevel(it)
	local tier = "tier" .. (it.q - 1)
	local rows = { { W.need, "Lv." .. need, if me.level >= need then "text" else "red" } }
	if it.slot == "weapon" then
		table.insert(rows, { W.job, CLASSES.classes[it.who].name, if it.who == me.class then "text" else "red" })
	end
	table.insert(rows, { W.quality, if q.bonus == 0 then q.name else ("%s %s%d%%"):format(q.name, if q.bonus > 0 then "+" else "", q.bonus), tier })
	table.insert(rows, { W.star, ("+%d / %d"):format(it.star, Items.starCap(it.stage)), "text" })
	table.insert(rows, { W.power, "+" .. Format.short(I.power(it)), "gold" })
	if Items.isArmor(it.slot) then
		local cut = if it.broken then 0 else N.armorCut(it.stage, me.level) / #D.ARMOR
		table.insert(rows, { W.cut, ("%.1f%%"):format(math.floor(cut * 10 + 0.5) / 10), "text" })
	end
	local notes = {}
	if it.broken then
		table.insert(notes, { W.brokenNote, "red" })
	elseif isWorn then
		table.insert(notes, { W.worn, "accent" })
	elseif it.slot == "weapon" and it.who ~= me.class then
		table.insert(notes, { W.otherJob, "red" })
	elseif me.level < need then
		table.insert(notes, { Format.fill(W.needLv, { n = need }), "red" })
	else
		local d = I.wearDiff(it, worn)
		if d > 0 then
			table.insert(notes, { Format.fill(W.wearUp, { n = Format.short(d) }), "accent" })
		elseif d < 0 then
			table.insert(notes, { Format.fill(W.wearDown, { n = Format.short(-d) }), "red" })
		else
			table.insert(notes, { W.wearSame, "dim" })
		end
	end
	if not isWorn then
		table.insert(notes, { Format.fill(W.dust, { n = Format.short(Items.dismantle(it)) }), "dim" })
		table.insert(notes, { Format.fill(W.sell, { n = Format.short(Items.sellPrice(it)) }), "dim" })
	end
	local name = Items.name(it)
	if it.broken then
		name = name .. " " .. W.broken
	elseif it.star > 0 then
		name = ("%s +%d"):format(name, it.star)
	end
	return {
		name = name,
		tone = if it.broken then "red" else tier,
		sub = if it.slot == "weapon" then slot.kind else slot.kind .. " · " .. slot.name,
		rows = rows,
		notes = notes,
	}
end

-- 소비 · 기타 아이템의 상세. id = 이름표 · n = 가방에 든 수(모든 칸의 합)
function I.goods(id: string, me, n: number)
	local g = Items.goods(id)
	local rows = { { W.have, Format.fill(W.count, { n = n }), "text" } }
	if g.kind == "potion" then
		table.insert(rows, { W.effect, Format.fill(W.heal, { n = g.heal }), "accent" })
		table.insert(rows, { W.useLv, "Lv." .. g.lv, if me.level >= g.lv then "text" else "red" })
		table.insert(rows, { W.wait, Format.fill(W.sec, { n = N.data.BODY.cooldown.field }), "text" })
	end
	table.insert(rows, { W.stack, Format.fill(W.upTo, { n = g.stack }), "dim" })
	local notes = { { g.text, "text" } }
	if g.kind == "potion" and me.level < g.lv then
		table.insert(notes, { Format.fill(W.useNeed, { n = g.lv }), "red" })
	end
	if g.from then
		table.insert(notes, { Format.fill(W.from, { mob = g.from }), "dim" })
	end
	if g.quest then
		table.insert(notes, { Format.fill(W.quest, { quest = g.quest, n = g.need }), "dim" })
	end
	if g.sell > 0 then
		table.insert(notes, { Format.fill(W.sellEach, { n = Format.short(g.sell) }), "dim" })
	end
	return {
		name = g.name,
		tone = "text",
		sub = if g.kind == "quest" then W.tab[g.tab] .. " · " .. W.questItem else W.tab[g.tab],
		rows = rows,
		notes = notes,
	}
end

return I

end
MODULES['ReplicatedStorage/shared/lune/ui/layout'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 늘 보이는 화면과 창의 치수 — 화면 틀의 고운 격자(1080p에서 960x540)에서의 값. 그리지는 않는다: 화면(client/lune/hud.luau · chat.luau · partyHud.luau · questHud.luau · ui/*Window.luau)과
--  자동 검사(tools/test/tests/14_lune_hud.luau · 15_lune_items.luau)가 같은 값을 쓰게 한데 모아 둔 것이다.
--  숫자는 여기서 적지 않는다 — 모두 공방에서 온다(사용자 2026-10-07: "공방에서 횡스크롤 시험 탭에서 먼저 구현해보고 느낌보고 게임에 반영하는 순서로 하겠습니다"):
--   칸의 자리(붙는 구석과 x · y · w · h) = 공방 「기본 · UI」 탭(data/ui.generated.luau의 hud) · 치수 = 공방 js/lune/design/ui.js의 UILAYOUT(ui.generated.luau의 layout —
--   공방의 횡스크롤 시험 탭이 같은 값으로 그린다) · 부품의 치수 = 공방의 부품 도구(data/kit.generated.luau의 ui.metric).
local UI = require(script.Parent.Parent.data["ui.generated"])
local KIT = require(script.Parent.Parent.data["kit.generated"])
local M = KIT.ui.metric
local D = UI.layout

local L = {}
L.GRID = UI.grid
L.M = M

-- 화면의 격자가 gw x gh일 때 그 칸의 자리(구석에서의 거리를 지킨다). r = { at, x, y, w, h }
function L.rect(r, gw: number?, gh: number?)
	local w, h = gw or UI.grid.w, gh or UI.grid.h
	local fy = if r.at:sub(1, 1) == "b" then 1 else 0
	local side = r.at:sub(2, 2)
	local fx = if side == "r" then 1 elseif side == "c" then 0.5 else 0
	return { x = r.x + math.floor((w - UI.grid.w) * fx + 0.5), y = r.y + math.floor((h - UI.grid.h) * fy + 0.5), w = r.w, h = r.h }
end

-- 게임 세계의 배율 s에서 화면 틀의 배율과 격자(client/lune/stage.luau와 같은 셈)
function L.gridFor(s: number): (number, number, number)
	local us = math.max(1, math.floor(0.4 * s + 0.5))
	return 384 * s / us, 216 * s / us, us
end

-- ---------- 늘 보이는 화면 ----------
L.VITALS = D.vitals -- 왼쪽 아래 덩어리: 윗줄에 레벨 · 이름 / 체력 바(숫자는 바 안) / 가는 경험치 줄과 그 옆의 %
L.SKILLS = D.skills -- 스킬 칸: 두 줄 x 여섯. 칸 위에 키 딱지(높이 keyUp)
L.MENU = D.menu -- 창을 여는 단추: 여섯까지, 오른쪽 끝에 붙여. 그림 아래에 이름(labels = 칸에 맞춘 짧은 이름)
L.PARTY = D.party -- 파티원 칸: 한 사람 = 이름 한 줄 + 가는 체력 줄. ask = 초대 알림(위쪽 가운데)
L.DEATH = D.death -- 쓰러졌을 때 묻는 상자(위쪽 가운데): 제목 · 묻는 글 · 안내 · 단추 하나
L.QUEST = D.quest -- 퀘스트 알리미: 이름 한 줄(본문 글씨) · 할 일 한 줄(작은 글씨) · 퀘스트 사이
L.CHAT = D.chat -- 채팅: 평소에는 채팅 칸에 마지막 몇 줄, 쓸 때는 넓은 판(open)
L.TAG = D.tag -- 이름표: 한 줄의 높이(쌓을 때) · 발밑에서 아래로 띄우는 만큼 · 가장 넓을 때
L.MOBBAR = D.mobBar -- 졸개의 체력 띠: 크기(화면 틀의 점) · 발밑에서 위로(게임의 도트)
L.BOSS = D.boss -- 스토리 보스의 체력: 화면 위 가운데 — 이름(y) 아래(barY)에 넓은 바(안에 숫자 · pad = 좌우 여백), 그 아래(patY)에 패턴의 이름

-- 쓰는 칸이 n개일 때 i째 칸의 자리(스킬 칸 틀 안): 여섯까지는 아랫줄에 가운데로 모으고, 일곱째부터는 윗줄에 같은 식으로
function L.slotPlace(i: number, n: number): (number, number)
	local s, K = UI.hud.skills, L.SKILLS
	local pitch = K.slot + K.gap
	local row = if i <= K.cols then 1 else 2
	local inRow = if row == 1 then math.min(n, K.cols) else n - K.cols
	local k = if row == 1 then i else i - K.cols
	local left = math.floor((s.w - (inRow * pitch - K.gap)) / 2)
	return left + (k - 1) * pitch, s.h - K.slot - (row - 1) * (K.slot + K.keyUp + K.rowGap)
end

-- 메뉴 단추 아래에 적는 이름(칸에 맞춘 짧은 이름이 있으면 그것)
function L.menuLabel(id: string, name: string): string
	return L.MENU.labels[id] or name
end

-- n개 가운데 i째 단추의 x(메뉴 칸 틀 안)
function L.menuX(i: number, n: number): number
	return UI.hud.menu.w - (n - i + 1) * L.MENU.pitch + (L.MENU.pitch - L.MENU.slot)
end

-- 쓰는 중의 채팅 판의 자리(아래 끝은 채팅 칸의 아래 끝에서 dy 아래)
function L.chatOpen()
	local c, o = UI.hud.chat, L.CHAT.open
	local h = o.pad + o.lines * L.CHAT.line + 4 + L.CHAT.field + o.pad
	return { at = c.at, x = c.x + o.dx, y = c.y + c.h - h + o.dy, w = o.w, h = h }
end

-- ---------- 창(화면 오른쪽 · 왼쪽의 옆 판) ----------
L.WIN = D.win -- 판에서 속까지: 옆으로 pad, 위로 head(제목 줄), 아래로 foot. edge · top = 화면 끝에서 띄우는 폭
L.BAG = D.bag -- 가방: 칸 여섯 x 넷(세 탭 모두 칸). 탭 줄(gridY) 아래에 칸, 그 아래 footH에 단추 줄(정렬 · 칸 늘리기)과 지갑(달돈 · 달가루 · 정수)
L.DETAIL = D.detail -- 아이템 상세(창 옆의 작은 판): 그림 칸과 이름 · 갈래 · 줄(이름과 값) · 알림 글 · 단추
L.STORE = D.store -- 창고: 가방과 같은 짜임 — 탭 줄(gridY) 아래에 칸, 그 아래 footH에 「정렬」(sortW)과 안내 글
L.EQUIP = D.equip -- 장비 창: 왼쪽 = 칸 하나 + 글(textW), 오른쪽 = 장신구 네 칸
L.SHOP = D.shop -- 상점의 한 줄: [아이콘 칸 iconS] 이름(nameW) · [달돈 그림] 값(priceW) · 사는 단추(buyW)
L.DAILY = D.daily -- 일일 의뢰: 머리글(top) 아래 의뢰마다 한 칸(row — 맵의 이름 · 의뢰의 이름 · 오른쪽 단추 btnW · 진행 띠 barH), 가르는 줄 아래 보상 두 줄(payRow — 이름표 labelW)
L.SOUND = D.sound -- 소리 설정: 줄마다 이름(labelW) · 「−」(btn) · 칸 steps개(seg x barH · 사이 gap) · 「+」 · %(pctW). 아래 muteY에 「모두 끄기 / 켜기」(muteW)
L.CRAFT = D.craft -- 제작(대장장이): 탭(tabH) 아래에 장비마다 한 줄(row) — 윗줄 = [아이콘 칸] 이름 · [달돈] 삯(feeW) · 「제작」(makeW x makeH), 아랫줄 = 재료 둘([그림] 이름 가진 수/드는 수 — 하나에 matW)
L.STAT = D.stat -- 능력치 창: 속의 폭 · 줄(top부터 row씩) · 주/부의 자리 · 값의 오른쪽 끝 · + 단추의 폭 · tip = 능력치에 마우스를 올렸을 때 창 옆에 뜨는 설명 판
L.SKILL = D.skill -- 스킬 창: 차수 탭 · 안내 줄 · 스킬들(cols줄 x rows) · 오른쪽의 설명

-- 능력치 창의 속(폭 · 높이). n = 능력치의 수
function L.statBody(n: number): (number, number)
	return L.STAT.w, L.STAT.top + n * L.STAT.row + 8 + M.button + 14 + 20
end

-- 스킬 창의 속(폭 · 높이)과 스킬 목록의 폭
function L.skillBody(): (number, number, number)
	local K = L.SKILL
	local listW = K.cols * K.colW + (K.cols - 1) * K.colGap
	return listW + K.gap + K.detailW, K.top + K.rows * K.row, listW
end

-- 장비 칸의 한 변: 장비 그림(게임의 굵은 도트 18개)에 사방으로 여백을 둔 크기. ratio = 게임 도트 하나가 화면 틀의 몇 점인가(1080p에서 2.5 → 50)
function L.cellFor(ratio: number): number
	return math.floor(KIT.icon * ratio + 0.5) + 5
end

-- 가방의 속(폭 · 높이)
function L.bagBody(ratio: number): (number, number)
	local s = L.cellFor(ratio)
	return L.BAG.cols * s, L.BAG.gridY + L.BAG.rows * s + L.BAG.footH
end

-- 창고의 속(폭 · 높이). slots = 창고의 탭 하나의 칸 수
function L.storeBody(ratio: number, slots: number): (number, number)
	local s = L.cellFor(ratio)
	return L.BAG.cols * s, L.STORE.gridY + math.ceil(slots / L.BAG.cols) * s + L.STORE.footH
end

-- 지갑의 한 칸(달돈 · 달가루 · 정수 — 셋이 같은 폭)
function L.purseW(bodyW: number): number
	return math.floor(bodyW / 3)
end

-- 상세 판: 속의 폭 · 이름이 쓰는 폭(그림 칸의 오른쪽 — 닫기 자리는 뺀다) · 값이 쓰는 폭 · 단추 n개가 한 줄에 놓일 때의 폭
function L.detailInner(): number
	return L.DETAIL.w - L.DETAIL.pad * 2
end

function L.detailNameW(ratio: number): number
	return L.detailInner() - L.cellFor(ratio) - 8 - L.DETAIL.closeW
end

function L.detailValueW(): number
	return L.detailInner() - L.DETAIL.labelW
end

function L.detailButtonW(n: number): number
	return math.floor((L.detailInner() - L.DETAIL.btnGap * (n - 1)) / n)
end

-- 상세 판의 높이: nameLines = 이름의 줄 수 · rows = 줄 수 · noteLines = 알림 글의 줄 수(모두 더한 것) · btnRows = 단추 줄 수
function L.detailHeight(ratio: number, nameLines: number, rows: number, noteLines: number, btnRows: number): number
	local K = L.DETAIL
	local head = math.max(L.cellFor(ratio), nameLines * K.nameLine + K.subGap + M.small)
	local h = K.pad + head + K.rowTop + rows * K.rowH
	if noteLines > 0 then
		h += K.noteTop + noteLines * K.noteLine
	end
	if btnRows > 0 then
		h += K.btnTop + btnRows * M.button + (btnRows - 1) * K.btnGap
	end
	return h + K.pad
end

-- 장비 창의 속(폭 · 높이)과 오른쪽 덩이의 왼쪽 끝
function L.equipBody(ratio: number): (number, number, number)
	local s = L.cellFor(ratio)
	local rx = s + L.EQUIP.gap + L.EQUIP.textW + L.EQUIP.gap
	return rx + L.EQUIP.accCols * s, math.max(5 * (s + 2) - 2, 2 * s + 150), rx
end

return L

end
MODULES['ReplicatedStorage/shared/lune/ui/questPanel'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 퀘스트 알리미의 셈 — 화면을 모르는 셈이다(그리는 것은 client/lune/questHud.luau · 자동 검사 27이 그대로 부른다).
--  판에 적을 줄들의 차례와 높이, 글이 쓸 수 있는 폭을 정한다. 설명은 questHud.luau의 머리말.
local UI = require(script.Parent.Parent.data["ui.generated"])
local Quests = require(script.Parent.Parent.sim.quests)
local Layout = require(script.Parent.layout)

local TITLE, LINE, GAP = Layout.QUEST.title, Layout.QUEST.line, Layout.QUEST.gap -- 이름 한 줄 · 할 일 한 줄 · 퀘스트 사이

local Panel = {}
Panel.W = UI.hud.quest.w
Panel.H = UI.hud.quest.h -- PC에서 판이 쓸 수 있는 높이
Panel.H_TOUCH = if UI.hudTouch.quest then UI.hudTouch.quest.h else UI.hud.quest.h -- 스마트폰에서
Panel.PAD = 8 -- 판의 가장자리에서 글까지
Panel.HEAD = 20 -- 머리줄의 높이(가르는 줄까지)
Panel.INNER = Panel.W - Panel.PAD * 2 -- 글이 쓸 수 있는 폭
Panel.TAG_W, Panel.TAG_GAP = 26, 5 -- 갈래의 표(두 글자)의 폭 · 표와 이름 사이
Panel.COUNT_W = 34 -- 오른쪽의 「12/15」가 쓰는 폭
Panel.BAR_H = 4 -- 진행 띠의 높이
Panel.TITLE, Panel.LINE, Panel.GAP = TITLE, LINE, GAP
Panel.STEP = LINE + Panel.BAR_H + 2 -- 할 일 한 줄(글 + 띠)
Panel.TAGS = { main = "메인", side = "부탁", job = "전직", daily = "일일" }
Panel.DAILY_BACK = "게시판에 낸다" -- 다 잡은 일일 의뢰의 줄

-- 할 일 한 줄을 글과 숫자로 가른다: 「검병 · 갑옷 조각 3/8」 → 「검병 · 갑옷 조각」, 「3/8」
function Panel.split(text: string): (string, string?)
	local label, count = string.match(text, "^(.-)%s+(%d+/%d+)$")
	if label then
		return label, count
	end
	return text, nil
end

-- 알리미에 적을 것을 차례대로 셈한다(화면을 모르는 셈 — 자동 검사가 그대로 부른다). 돌려주는 것: 줄들, 판의 높이, 하는 중인 수, 길잡이 수
--  줄: { kind = "quest"(갈래 · 이름) | "step"(글 · 숫자 · 한 수 · 할 수) | "ready"(돌려줄 사람) | "label"(「받을 수 있는 퀘스트」) | "guide"(이름) | "where"(받는 곳), y, … }
--  maxH = 판이 쓸 수 있는 높이(안 주면 PC의 칸 — 스마트폰은 손가락 단추에 닿지 않게 더 낮다)
--  daily = 받아 둔 일일 의뢰들 { { name(몬스터), place(맵), n, have } … }(sim/daily.luau의 tracked) — 하는 중인 퀘스트 다음, 길잡이 앞에 「일일」 표로 적는다
function Panel.layout(book, names, level: number?, maxH: number?, daily: any?)
	local rows = {}
	local y = Panel.HEAD + 4
	local shown, guided = 0, 0
	local limit = (maxH or Panel.H) - Panel.PAD
	for _, id in Quests.active(book or {}) do
		local def = Quests.def(id)
		local st = book[id]
		local ready = Quests.isReady(book, id)
		local lines = if ready then 1 else 0
		if not ready then
			for i, step in def.steps do
				if (st.c[i] or 0) < step.n then
					lines += 1
				end
			end
		end
		local need = TITLE + (if ready then LINE + 2 else lines * Panel.STEP)
		if y + need > limit then
			break
		end
		shown += 1
		table.insert(rows, { kind = "quest", y = y, tag = def.kind, name = def.name })
		y += TITLE
		if ready then
			table.insert(rows, { kind = "ready", y = y, text = Quests.todo(book, id, names)[1] or "" })
			y += LINE + 2
		else
			for i, step in def.steps do
				local have = st.c[i] or 0
				if have < step.n then
					local label, count = Panel.split(Quests.trackText(step, have))
					table.insert(rows, { kind = "step", y = y, text = label, count = count or ("%d/%d"):format(have, step.n), have = have, n = step.n })
					y += Panel.STEP
				end
			end
		end
		y += GAP
	end
	-- 일일 의뢰(받아 둔 것): 「일일」 표 + 맵의 이름 / 「포자 주머니 12/30」과 진행 띠 — 다 잡았으면 「? 게시판에 낸다」
	for _, d in daily or {} do
		local ready = d.have >= d.n
		local need = TITLE + (if ready then LINE + 2 else Panel.STEP)
		if y + need > limit then
			break
		end
		shown += 1
		table.insert(rows, { kind = "quest", y = y, tag = "daily", name = d.place })
		y += TITLE
		if ready then
			table.insert(rows, { kind = "ready", y = y, text = Panel.DAILY_BACK })
			y += LINE + 2
		else
			table.insert(rows, { kind = "step", y = y, text = d.name, count = ("%d/%d"):format(d.have, d.n), have = d.have, n = d.n })
			y += Panel.STEP
		end
		y += GAP
	end
	-- 길잡이: 남는 높이에만
	local guides = if level then Quests.guide(book or {}, level, names) else {}
	local labelAt = nil
	for _, g in guides do
		local need = TITLE + LINE + (if guided == 0 then LINE + 6 else GAP)
		if y + need > limit then
			break
		end
		if guided == 0 then
			labelAt = y
			table.insert(rows, { kind = "label", y = y, line = shown > 0 })
			y += LINE + 6
		else
			y += GAP - 2
		end
		guided += 1
		table.insert(rows, { kind = "guide", y = y, text = g.title, tone = g.kind })
		y += TITLE
		table.insert(rows, { kind = "where", y = y, text = g.line, tone = g.kind })
		y += LINE
	end
	if shown > 0 and guided == 0 then
		y -= GAP
	end
	return rows, y + Panel.PAD, shown, guided
end

return Panel

end
MODULES['ReplicatedStorage/shared/lune/ui/quick'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 퀵슬롯의 셈 — 화면 가운데 아래의 스킬 칸(여섯 x 두 줄). 그리지는 않는다: 화면(client/lune/hud.luau · boot.luau)과 서버(sim/hero.luau), 테스트가 같이 쓴다.
--  사용자 2026-10-07: "스킬키를 단축키에 등록하기 쉬워야합니다. … 드래그앤 드랍으로 배치도 되어야하고, 스킬탭에서 스킬아이콘을 꾹누르거나 클릭하면 퀵슬롯쪽이 반짝거리고 거기서 퀵슬롯을 누르면 배치된다던가"
--  키는 스킬이 아니라 칸에 붙는다(칸마다 키 하나). 칸에는 스킬의 이름표나 소비 아이템의 이름표("potion1" … — data/items.generated.luau의 GOODS)가 놓인다. 빈 칸은 false.
--   소비 아이템은 저마다 따로 놓는다(사용자 2026-10-08 — 가방의 진짜 아이템이다): 작은 달빛 물약과 큰 달빛 물약은 다른 칸. 칸의 숫자 = 가방에 든 그 아이템의 수.
--  값과 놓는 법은 공방 js/lune/design/ui.js의 QUICK · quickPlace · quickClear · quickStart(횡스크롤 시험 탭이 같은 셈으로 논다) — data/ui.generated.luau의 quick.
local UI = require(script.Parent.Parent.data["ui.generated"])
local ITEMS = require(script.Parent.Parent.data["items.generated"])

local GOODS = {}
for _, g in ITEMS.GOODS do
	GOODS[g.id] = g
end

local Q = {}
Q.DATA = UI.quick
Q.N = UI.quick.n -- 칸의 수
Q.COLS = UI.quick.cols -- 한 줄
Q.START_POTION = UI.quick.potion -- 새 캐릭터의 첫 칸에 놓이는 물약(작은 달빛 물약)
Q.OLD_POTION = "potion" -- 예전 저장의 물약 칸(물약이 한 가지였을 때의 이름표) — Q.renew가 지금의 이름표로 바꾼다

-- 칸에 놓인 것이 소비 아이템이면 그 자료(스킬이면 nil)
function Q.item(what: any)
	return if typeof(what) == "string" then GOODS[what] else nil
end

-- 칸에 놓인 것의 그림 이름(화면의 그림 24x24 — 공방의 아이콘 이름)
function Q.pic(what: string): string
	local g = GOODS[what]
	if g then
		return g.icon
	end
	return "skill_" .. what
end

-- 예전 저장의 칸들을 지금 꼴로: "potion" → potionId(그때 마시던 물약). 꼴이 다른 것은 그대로 돌려준다(Q.clean이 걸러 낸다)
function Q.renew(list: any, potionId: string): any
	if typeof(list) ~= "table" then
		return list
	end
	local out = table.clone(list)
	for k, v in out do
		if v == Q.OLD_POTION then
			out[k] = potionId
		end
	end
	return out
end

local function copy(slots)
	local out = table.create(Q.N, false)
	for i = 1, Q.N do
		out[i] = slots[i] or false
	end
	return out
end

local function find(slots, what): number?
	for i = 1, Q.N do
		if slots[i] == what then
			return i
		end
	end
	return nil
end
Q.find = find

-- 칸에 놓는다: what(스킬 · 소비 아이템의 이름표)을 j째 칸에. 이미 다른 칸에 있던 것이면 두 칸이 자리를 바꾼다.
--  창(스킬 창 · 가방)에서 온 것이면 그 칸에 있던 것은 빠진다. 새 칸들을 돌려준다(못 놓으면 nil)
function Q.place(slots, what: string, j: number)
	if typeof(what) ~= "string" or what == "" or j < 1 or j > Q.N or j % 1 ~= 0 then
		return nil
	end
	local out = copy(slots)
	local i = find(out, what)
	if i == j then
		return out
	end
	local old = out[j]
	out[j] = what
	if i then
		out[i] = old
	end
	return out
end

-- 칸에서 뺀다(소비 아이템도 빠진다 — 가방의 소비 탭에서 다시 끌어다 놓는다)
function Q.clear(slots, i: number)
	if i < 1 or i > Q.N then
		return nil
	end
	local out = copy(slots)
	out[i] = false
	return out
end

-- 새 캐릭터의 칸: start의 차례대로(물약 · 사냥기 · 보스기 · 이동기 — 스킬은 그 갈래의 첫 스킬). skills = { { id, type } … }
function Q.start(skills)
	local out = table.create(Q.N, false)
	for k, kind in UI.quick.start do
		if kind == "potion" then
			out[k] = Q.START_POTION
		else
			for _, s in skills do
				if s.type == kind then
					out[k] = s.id
					break
				end
			end
		end
	end
	return out
end

-- 밖에서 온 칸들(클라이언트가 보낸 것 · 저장된 것)을 살핀다: 꼭 N칸, 칸마다 false · 놓아도 되는 것(ok(id)가 참 — 배운 스킬 · 소비 아이템), 겹치는 것 없이.
--  말이 되면 깨끗한 칸들을, 아니면 nil을 돌려준다
function Q.clean(list: any, ok: (string) -> boolean)
	if typeof(list) ~= "table" then
		return nil
	end
	local out = table.create(Q.N, false)
	local seen = {}
	for k in list do
		if typeof(k) ~= "number" or k < 1 or k > Q.N or k % 1 ~= 0 then
			return nil
		end
	end
	for i = 1, Q.N do
		local v = list[i]
		if v == nil or v == false then
			out[i] = false
		elseif typeof(v) == "string" and #v <= 40 and not seen[v] and ok(v) then
			seen[v] = true
			out[i] = v
		else
			return nil
		end
	end
	return out
end

-- 윗줄(둘째 줄)에 놓인 것이 있는가 — 있으면 윗줄도 늘 보인다
function Q.usesTop(slots): boolean
	for i = Q.COLS + 1, Q.N do
		if slots[i] then
			return true
		end
	end
	return false
end

return Q

end
MODULES['ReplicatedStorage/shared/lune/ui/tags'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 이름표와 채팅 줄의 셈(그리지는 않는다). 테스트 14가 본다.
local T = {}

-- 이름표가 겹칠 때: 아무것도 옮기지 않는다 — 이름은 늘 제 주인의 발밑 그 자리에 있다.
--  사용자 2026-10-07: "닉네임이 npc랑 지나갈때 npc이름 아래로 낑겨버리는데 … 이건 말도 안되는 상황입니다" → 겹치면 밀어서 쌓던 것(stack)을 없앴다.
--  list = 앞선 차례대로(내 것 → 다른 사람 → 주민 · 문 → 졸개) { x(왼쪽), y(위), w(폭) }. h = 한 줄의 높이 · gap = 옆으로 이만큼보다 가까우면 겹친 것으로 본다.
--  앞선 것이 보이고, 그것과 겹치는 뒤의 것은 겹치는 동안 숨는다(글씨끼리 포개져 못 읽게 되지 않게). 돌려주는 것 = 보이는가의 차례표.
--  공방의 횡스크롤 시험 탭(js/lune/ui/paint.js의 tagsVisible)과 같은 셈이다.
function T.visible(list, h: number, gap: number?): { boolean }
	local near = gap or 4
	local shown = {}
	local out = {}
	for i, t in list do
		local hit = false
		for _, q in shown do
			if t.x < q.x + q.w + near and q.x < t.x + t.w + near and math.abs(q.y - t.y) < h then
				hit = true
				break
			end
		end
		if not hit then
			table.insert(shown, t)
		end
		out[i] = not hit
	end
	return out
end

-- 채팅 한 줄: 「이름: 글」. 채널이 파티면 앞에 [파티]
function T.chatLine(channel: string, name: string?, text: string): string
	local head = if channel == "party" then "[파티] " else ""
	if not name or name == "" then
		return head .. text
	end
	return ("%s%s: %s"):format(head, name, text)
end

-- 보내기 전에 다듬는다: 앞뒤 빈칸을 떼고, 줄바꿈을 빈칸으로, max글자까지만. 빈 글이면 nil
function T.chatClean(text: any, max: number?): string?
	if typeof(text) ~= "string" then
		return nil
	end
	local s = string.gsub(text, "[\r\n\t]", " ")
	s = string.match(s, "^%s*(.-)%s*$") or ""
	if s == "" then
		return nil
	end
	local out, n = "", 0
	local ok = pcall(function()
		for _, code in utf8.codes(s) do
			n += 1
			if n > (max or 80) then
				break
			end
			out ..= utf8.char(code)
		end
	end)
	if not ok or out == "" then
		return nil
	end
	return out
end

return T

end
MODULES['ReplicatedStorage/shared/lune/ui/worldmap'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 월드맵의 셈 — 화면을 모르는 셈이다(그리는 것은 client/lune/ui/mapWindow.luau · 자동 검사가 그대로 부른다).
--  메이플스토리의 월드맵 · 길라잡이처럼: 그 지역의 맵들이 길로 이어진 그림에서 ① 내가 있는 곳 ② 맵마다의 레벨과 몬스터 ③ 퀘스트를 받을 곳(!) · 돌려줄 곳(?) ④ 내 레벨에 맞는 사냥터를 알려 준다.
--  자료는 data/worldmap.generated.luau(공방 js/lune/design/journey.js의 그림) · 맵의 몬스터와 주민은 data/scenes.generated.luau.
local D = require(script.Parent.Parent.data["worldmap.generated"])
local SCENES = require(script.Parent.Parent.data["scenes.generated"])
local COMBAT = require(script.Parent.Parent.data["combat.generated"])
local Quests = require(script.Parent.Parent.sim.quests)

local WM = {}
WM.data = D
WM.order = D.order
-- 그림으로 된 지도(client/lune/ui/mapWindow.luau): 그림의 크기 · 오른쪽 글 칸의 폭과 줄 수
WM.ART_W, WM.ART_H = D.artSize.w, D.artSize.h
WM.SIDE_W = 190
WM.SIDE = { mobLines = 2, npcLines = 2, routeLines = 2 }
WM.PIN = { town = 5, village = 5, rest = 4, hunt = 4, road = 3, climb = 4, dead = 3, boss = 4, out = 5 } -- 표시의 반지름(가운데에서 가장자리까지 — 점). out = 다른 지역
WM.PLATE = { padX = 4, h = 14, gap = 3 } -- 이름표: 글의 양옆 여백 · 높이 · 표시와의 사이

-- 그림이 있는 지역들(탭의 차례) — 그림이 없는 지역은 월드맵에 나오지 않는다
function WM.arted(): { string }
	local out = {}
	for _, rid in D.order do
		if D.regions[rid].art then
			table.insert(out, rid)
		end
	end
	return out
end

-- 마디를 이름표로 찾는 표: [지역][마디] = 마디
local byId = {}
for rid, region in D.regions do
	byId[rid] = {}
	for i, n in region.nodes do
		byId[rid][n.id] = n
		n.order = i
	end
end

function WM.region(rid: any)
	return if typeof(rid) == "string" then D.regions[rid] else nil
end

function WM.node(rid: string, id: string)
	return byId[rid] and byId[rid][id]
end

-- 그 장면이 어느 지역의 어느 마디인가. 마디에 없는 장면(가게 · 사당 같은 실내 · 숨은 방)은 문을 따라 가장 가까운 마디다. 못 찾으면 nil
local nodeCache = {}
function WM.nodeOf(sceneKey: any): (string?, string?)
	if typeof(sceneKey) ~= "string" or not SCENES.scenes[sceneKey] then
		return nil, nil
	end
	local hit = nodeCache[sceneKey]
	if hit ~= nil then
		if hit == false then
			return nil, nil
		end
		return hit.region, hit.node
	end
	local seen = { [sceneKey] = true }
	local queue, at = { sceneKey }, 1
	local found = nil
	while queue[at] do
		local key = queue[at]
		at += 1
		if D.sceneNode[key] then
			found = D.sceneNode[key]
			break
		end
		local next = {}
		for _, p in SCENES.scenes[key].portals or {} do
			if SCENES.scenes[p.to] and not seen[p.to] then
				seen[p.to] = true
				table.insert(next, p.to)
			end
		end
		table.sort(next) -- 차례가 늘 같게
		for _, k in next do
			table.insert(queue, k)
		end
	end
	nodeCache[sceneKey] = found or false
	if found then
		return found.region, found.node
	end
	return nil, nil
end

-- 그 마디의 몬스터 레벨(가장 낮은 · 가장 높은). 몬스터가 없으면 nil
function WM.levels(node): (number?, number?)
	local lo, hi = nil, nil
	for _, key in node.scenes do
		for _, m in SCENES.scenes[key].mobs or {} do
			lo = if lo then math.min(lo, m.lv) else m.lv
			hi = if hi then math.max(hi, m.lv) else m.lv
		end
	end
	return lo, hi
end

-- 「Lv.14~15」 · 한 레벨이면 「Lv.9」 · 몬스터가 없으면 빈 글
function WM.levelText(node): string
	local lo, hi = WM.levels(node)
	if not lo then
		return ""
	end
	return if lo == hi then ("Lv.%d"):format(lo) else ("Lv.%d~%d"):format(lo, hi :: number)
end

-- 그 마디에 나오는 몬스터의 이름들(겹치지 않게, 맵의 차례대로)
function WM.mobNames(node): { string }
	local out, seen = {}, {}
	for _, key in node.scenes do
		for _, m in SCENES.scenes[key].mobs or {} do
			local def = COMBAT.mobs[m.kind]
			local name = if def then def.name else m.kind
			if not seen[name] then
				seen[name] = true
				table.insert(out, name)
			end
		end
	end
	return out
end

-- 그 지역의 마디마다 서 있는 주민: [마디] = { [주민 id] = 이름 } — 실내의 주민은 그 건물이 선 마디에 든다
local npcCache = {}
function WM.npcs(rid: string)
	if npcCache[rid] then
		return npcCache[rid]
	end
	local out = {}
	for key, sc in SCENES.scenes do
		if sc.npcs and #sc.npcs > 0 then
			local r, id = WM.nodeOf(key)
			if r == rid and id then
				out[id] = out[id] or {}
				for _, n in sc.npcs do
					if not n.stone then -- 비석(명예의 전당)은 주민이 아니다
						out[id][n.id] = n.name
					end
				end
			end
		end
	end
	npcCache[rid] = out
	return out
end

-- 그 마디의 주민 이름들(가나다 차례)
function WM.npcNames(rid: string, nodeId: string): { string }
	local out = {}
	for _, name in WM.npcs(rid)[nodeId] or {} do
		table.insert(out, name)
	end
	table.sort(out)
	return out
end

-- 퀘스트의 표시: [마디] = "?"(돌려줄 것이 있다) · "!"(받을 것이 있다). 그 지역의 마디만.
--  돌려줄 것 = 다 한 퀘스트를 돌려받는 주민이 선 마디 · 받을 것 = 지금 받을 수 있는 퀘스트를 주는 주민이 선 마디(그 퀘스트를 하는 맵에서 가장 가까운 곳)
function WM.marks(rid: string, book, level: number): { [string]: string }
	local out = {}
	local npcs = WM.npcs(rid)
	for _, def in Quests.list do
		local state = Quests.state(book, level, def.id)
		if state == "ready" then
			for nodeId, set in npcs do
				if set[def.endNpc] then
					out[nodeId] = "?"
				end
			end
		elseif state == "open" and not def.auto then
			local key = Quests.giverScene(def)
			local r, nodeId = WM.nodeOf(key)
			if r == rid and nodeId and out[nodeId] ~= "?" then
				out[nodeId] = "!"
			end
		end
	end
	return out
end

-- 내 레벨에 맞는 사냥터(그 지역에서): 몬스터의 가장 낮은 레벨이 내 레벨을 넘지 않는 마디 가운데 그 레벨이 가장 높은 것 — 같으면 그림의 차례가 앞선 것.
--  모두 내 레벨보다 높으면 가장 낮은 마디. 사냥터가 없는 지역이면 nil
function WM.recommend(rid: string, level: number): string?
	local region = D.regions[rid]
	if not region then
		return nil
	end
	local best, bestLo, lowest, lowestLo = nil, -1, nil, math.huge
	for _, n in region.nodes do
		local lo = WM.levels(n)
		if lo then
			if lo <= level and lo > bestLo then
				best, bestLo = n.id, lo
			end
			if lo < lowestLo then
				lowest, lowestLo = n.id, lo
			end
		end
	end
	return best or lowest
end

-- ---------- 다른 지역으로 이어지는 곳 ----------
-- 그 지역의 마디에서 문 하나로 다른 지역의 마디에 닿는 것들: { { node, to(지역), toNode } … } — 그림의 차례, 같은 마디면 탭의 차례.
--  예: 초승 고개의 수비대 야영지 → 은달 항구(성문 거리) · 은달 항구의 부두 → 수정 숲(반달 나루) · 물마루 바다(물마루 마을)
local exitCache = {}
function WM.exits(rid: string)
	if exitCache[rid] then
		return exitCache[rid]
	end
	local out, seen, rank = {}, {}, {}
	for i, id in D.order do
		rank[id] = i
	end
	local region = D.regions[rid]
	for _, n in (if region then region.nodes else {}) do
		for _, key in n.scenes do
			for _, p in SCENES.scenes[key].portals or {} do
				local to = D.sceneNode[p.to]
				if to and to.region ~= rid and not seen[n.id .. ">" .. to.region] then
					seen[n.id .. ">" .. to.region] = true
					table.insert(out, { node = n.id, to = to.region, toNode = to.node })
				end
			end
		end
	end
	table.sort(out, function(a, b)
		local na, nb = byId[rid][a.node].order, byId[rid][b.node].order
		if na ~= nb then
			return na < nb
		end
		return rank[a.to] < rank[b.to]
	end)
	exitCache[rid] = out
	return out
end

-- 그 마디에서 이어지는 다른 지역들(없으면 빈 표)
function WM.exitsOf(rid: string, nodeId: string)
	local out = {}
	for _, ex in WM.exits(rid) do
		if ex.node == nodeId then
			table.insert(out, ex)
		end
	end
	return out
end

-- 마디 아래에 적는 줄들(그림): 짧은 이름 · 몬스터의 레벨(있으면) · 이어지는 지역마다 「→ 은달 항구」. { { text, kind = "name" | "level" | "exit", exit? } … }
WM.ROWS_MAX = 3 -- 그림의 아래 여백이 세 줄까지 받는다(자동 검사 28이 본다)
function WM.rows(rid: string, node)
	local rows = { { text = node.label, kind = "name" } }
	local lv = WM.levelText(node)
	if lv ~= "" then
		table.insert(rows, { text = lv, kind = "level" })
	end
	for _, ex in WM.exitsOf(rid, node.id) do
		table.insert(rows, { text = "→ " .. D.regions[ex.to].name, kind = "exit", exit = ex })
	end
	return rows
end

-- ---------- 가는 길 ----------
-- 장면에서 장면까지 문을 가장 적게 지나는 길(장면의 이름표들 — 처음과 끝을 넣어). 같은 수면 문이 놓인 차례가 앞선 쪽. 닿지 않으면 nil
function WM.path(from: any, to: any): { string }?
	if typeof(from) ~= "string" or typeof(to) ~= "string" or not SCENES.scenes[from] or not SCENES.scenes[to] then
		return nil
	end
	local prev = { [from] = from }
	local queue, at = { from }, 1
	while queue[at] and not prev[to] do
		local key = queue[at]
		at += 1
		for _, p in SCENES.scenes[key].portals or {} do
			if SCENES.scenes[p.to] and not prev[p.to] then
				prev[p.to] = key
				table.insert(queue, p.to)
			end
		end
	end
	if not prev[to] then
		return nil
	end
	local out = { to }
	while out[1] ~= from do
		table.insert(out, 1, prev[out[1]])
	end
	return out
end

-- 그 길이 지나는 마디들: { { region, node } … } — 이어서 같은 마디는 한 번만(실내 · 여러 층은 한 마디다). 닿지 않으면 nil
function WM.route(from: any, to: any)
	local path = WM.path(from, to)
	if not path then
		return nil
	end
	local out = {}
	for _, key in path do
		local r, n = WM.nodeOf(key)
		local last = out[#out]
		if r and n and (not last or last.region ~= r or last.node ~= n) then
			table.insert(out, { region = r, node = n })
		end
	end
	return out
end

-- 가는 길의 글: 지금 있는 마디의 다음부터 끝까지의 이름을 「→」로 잇는다 — 「성문 거리 → 달맞이 광장 → … → 부두 → 반달 나루」.
--  네 곳을 넘으면 앞의 하나 · … · 뒤의 둘만(오른쪽 글 칸의 두 줄에 들어가게 — 길 자체는 그림 위의 금빛 점줄이 보여 준다). 이미 그 마디에 있으면 빈 글
WM.ROUTE_MAX = 4
function WM.routeText(route): string
	if not route then
		return ""
	end
	local names = {}
	for i = 2, #route do
		local n = WM.node(route[i].region, route[i].node)
		table.insert(names, n.label)
	end
	if #names > WM.ROUTE_MAX then
		names = { names[1], "…", names[#names - 1], names[#names] }
	end
	return table.concat(names, " → ")
end

-- 지금 가야 할 곳의 한 줄(월드맵의 맨 아래 줄): 「「고갯길」 받으러 가는 길: 달그림자 사냥터 → 세 갈래 길 → …」 · 그 맵에 이미 있으면 「「고갯길」 — 지금 있는 맵에서 받는다」.
--  돌려주는 것: 글, 길(마디들 — 그림이 그 길을 금빛으로 칠한다), 갈 곳(goal). 갈 곳이 없으면 빈 글과 nil
local GOAL_WORD = { ["do"] = "하러", back = "돌려주러", take = "받으러" }
local GOAL_HERE = { ["do"] = "한다", back = "돌려준다", take = "받는다" }
function WM.goalText(goal, sceneKey: any): (string, any)
	local route = WM.route(sceneKey, goal.scene)
	if not route or #route == 0 then
		return "", nil
	end
	if #route == 1 then
		return ("「%s」 — 지금 있는 맵에서 %s"):format(goal.def.name, GOAL_HERE[goal.kind]), route
	end
	return ("「%s」 %s 가는 길: %s"):format(goal.def.name, GOAL_WORD[goal.kind], WM.routeText(route)), route
end
function WM.goalLine(book, level: number, sceneKey: any): (string, any, any)
	local goal = Quests.goal(book, level)
	if not goal then
		return "", nil, nil
	end
	local text, route = WM.goalText(goal, sceneKey)
	return text, route, goal
end

-- 내 레벨에 맞는 사냥터의 한 줄(월드맵의 셋째 줄). 돌려주는 것: 글, 그 마디(이름을 풀빛으로 칠한다 — 권할 것이 없으면 nil)
--  그 지역의 사냥터가 모두 내 레벨보다 높으면 권하지 않고 「이 지역의 사냥터는 Lv.47부터(갯바위 해변)」라고만 적는다. 사냥터가 없는 지역(은달 항구)이면 빈 글
function WM.recommendLine(rid: string, level: number): (string, string?)
	local id = WM.recommend(rid, level)
	local n = id and WM.node(rid, id)
	if not n then
		return "", nil
	end
	local lo = WM.levels(n)
	if lo and lo > level then
		return ("이 지역의 사냥터는 Lv.%d부터(%s)"):format(lo, n.name), nil
	end
	return ("Lv.%d에 맞는 사냥터: %s(%s)"):format(level, n.name, WM.levelText(n)), id
end

-- 내 레벨에 맞는 사냥터를 오른쪽 글 칸의 한 줄로: 「굽잇길 Lv.14~15」 — 그 지역이 모두 내 레벨보다 높으면 「Lv.47부터(갯바위 해변)」. 돌려주는 것: 글, 그 마디(권할 것이 없으면 nil)
function WM.recommendShort(rid: string, level: number): (string, string?)
	local id = WM.recommend(rid, level)
	local n = id and WM.node(rid, id)
	if not n then
		return "", nil
	end
	local lo = WM.levels(n)
	if lo and lo > level then
		return ("Lv.%d부터(%s)"):format(lo, n.label), nil
	end
	return ("%s %s"):format(n.label, WM.levelText(n)), id
end

-- 그 지역의 몬스터 레벨의 폭(「Lv.1~26」 — 오른쪽 글 칸의 머리줄). 몬스터가 없으면 빈 글
function WM.regionLevels(rid: string): string
	local lo, hi = nil, nil
	for _, n in D.regions[rid].nodes do
		local a, b = WM.levels(n)
		if a then
			lo = if lo then math.min(lo, a) else a
			hi = if hi then math.max(hi, b :: number) else b
		end
	end
	return if lo then ("Lv.%d~%d"):format(lo, hi :: number) else ""
end

-- 장소 하나를 고르면 오른쪽 글 칸에 적는 것: { name(이름), sub(「사냥터 · Lv.14~15」), mobs(「폭탄병 · 바위 산양」), npcs(「주모 달래 · 반달」) }
function WM.card(rid: string, nodeId: string)
	local n = WM.node(rid, nodeId)
	if not n then
		return { name = "", sub = "", link = "", mobs = "", npcs = "" }
	end
	local lv = WM.levelText(n)
	local kind = D.kinds[n.kind] or n.kind
	return {
		name = n.name,
		sub = if lv ~= "" then ("%s · %s"):format(kind, lv) else kind,
		link = WM.linkText(rid, nodeId),
		mobs = table.concat(WM.mobNames(n), " · "),
		npcs = table.concat(WM.npcNames(rid, nodeId), " · "),
	}
end

-- 그 장소에서 다른 지역으로 가는 문이 있으면 한 줄: 「은달 항구로 가는 포탈이 있다」(없으면 빈 글)
function WM.linkText(rid: string, nodeId: string): string
	local names = {}
	for _, ex in WM.exitsOf(rid, nodeId) do
		table.insert(names, D.regions[ex.to].name)
	end
	return if #names > 0 then ("%s로 가는 포탈이 있다"):format(table.concat(names, " · ")) else ""
end

-- 그림 위의 다른 지역(은달 항구)을 골랐을 때 오른쪽 글 칸에 적는 것: { name, sub(「다른 지역」), link(「수비대 야영지의 포탈로 간다」), mobs = "", npcs = "" }
function WM.outCard(rid: string, to: string)
	local from = {}
	for _, ex in WM.exits(rid) do
		if ex.to == to then
			table.insert(from, WM.node(rid, ex.node).label)
		end
	end
	return {
		name = D.regions[to].name,
		sub = "다른 지역",
		link = if #from > 0 then ("%s의 포탈로 간다"):format(table.concat(from, " · ")) else "",
		mobs = "",
		npcs = "",
	}
end

-- 이름표를 놓는다(화면을 모르는 셈 — 그림 위에서 서로, 그리고 표시와 겹치지 않게): 차례대로 아래 → 위 → 오른쪽 → 왼쪽을 대 보고 처음 맞는 자리에.
--  items = { { id, x, y, r(표시의 반지름), w(글의 폭) } … }(앞선 것이 먼저 자리를 잡는다). 돌려주는 것: [id] = { x, y, w, h }(놓을 자리가 없으면 그 이름은 빠진다)
function WM.placeLabels(items)
	local P = WM.PLATE
	local taken = {}
	for _, it in items do
		table.insert(taken, { it.x - it.r - 2, it.y - it.r - 2, it.x + it.r + 2, it.y + it.r + 2 }) -- 표시들
	end
	local function free(x: number, y: number, w: number, h: number): boolean
		if x < 1 or y < 1 or x + w > WM.ART_W - 1 or y + h > WM.ART_H - 1 then
			return false
		end
		for _, t in taken do
			if x < t[3] and x + w > t[1] and y < t[4] and y + h > t[2] then
				return false
			end
		end
		return true
	end
	local out = {}
	for _, it in items do
		local w, h = it.w + P.padX * 2, P.h
		local cx = it.x - math.floor(w / 2)
		-- 대 보는 자리의 차례: 바로 아래 · 바로 위(가운데 → 오른쪽으로 · 왼쪽으로 반씩 민 것) → 오른쪽 · 왼쪽(가운데 → 아래로 · 위로 민 것) → 한 줄 더 떨어진 아래 · 위
		local below, above = it.y + it.r + P.gap, it.y - it.r - P.gap - h
		local half, quarter = math.floor(w / 2) - it.r, math.floor(w / 4)
		local right, left = it.x + it.r + P.gap + 1, it.x - it.r - P.gap - 1 - w
		local mid = it.y - math.floor(h / 2)
		local tries = {
			{ cx, below }, { cx, above },
			{ cx + quarter, below }, { cx - quarter, below }, { cx + quarter, above }, { cx - quarter, above },
			{ cx + half, below }, { cx - half, below }, { cx + half, above }, { cx - half, above },
			{ right, mid }, { left, mid },
			{ right, mid + it.r + 3 }, { left, mid + it.r + 3 }, { right, mid - it.r - 3 }, { left, mid - it.r - 3 },
			{ cx, below + h + 1 }, { cx, above - h - 1 },
			{ cx + half, below + h + 1 }, { cx - half, below + h + 1 }, { cx + half, above - h - 1 }, { cx - half, above - h - 1 },
		}
		for _, t in tries do
			-- 옆으로 조금 밀어도 된다(그림의 가장자리에 붙은 마을)
			local x = math.clamp(t[1], 1, WM.ART_W - 1 - w)
			if free(x, t[2], w, h) then
				out[it.id] = { x = x, y = t[2], w = w, h = h }
				table.insert(taken, { x - 1, t[2] - 1, x + w + 1, t[2] + h + 1 })
				break
			end
		end
	end
	return out
end

-- 지금 가야 할 곳을 오른쪽 글 칸에 두 토막으로: title(「「고갯길」 받으러」) · text(가는 길의 이름들 — 그 맵에 있으면 「지금 있는 맵에서 받는다」).
--  갈 곳이 없으면 nil. route = 그 길의 마디들(그림이 금빛 점줄을 잇는다) · goal
local CARD_WORD = { ["do"] = "하러", back = "돌려주러", take = "받으러" }
local CARD_HERE = { ["do"] = "지금 있는 맵에서 한다", back = "지금 있는 맵에서 돌려준다", take = "지금 있는 맵에서 받는다" }
function WM.goalCardOf(goal, sceneKey: any)
	local route = WM.route(sceneKey, goal.scene)
	if not route or #route == 0 then
		return nil
	end
	return {
		title = ("「%s」 %s"):format(goal.def.name, CARD_WORD[goal.kind]),
		text = if #route == 1 then CARD_HERE[goal.kind] else WM.routeText(route),
		route = route,
		goal = goal,
	}
end
function WM.goalCard(book, level: number, sceneKey: any)
	local goal = Quests.goal(book, level)
	return if goal then WM.goalCardOf(goal, sceneKey) else nil
end

-- 마디 하나를 고르면 아래에 적는 두 줄: 「굽잇길 · 사냥터 · Lv.14~15」 / 「폭탄병 · 고갯길 염소」(주민이 있으면 「주민: 달래 · 반달」)
function WM.info(rid: string, nodeId: string): (string, string)
	local n = WM.node(rid, nodeId)
	if not n then
		return "", ""
	end
	local head = { n.name, D.kinds[n.kind] or n.kind }
	local lv = WM.levelText(n)
	if lv ~= "" then
		table.insert(head, lv)
	end
	local parts = {}
	local mobs = WM.mobNames(n)
	if #mobs > 0 then
		table.insert(parts, table.concat(mobs, " · "))
	end
	local people = WM.npcNames(rid, nodeId)
	if #people > 0 then
		table.insert(parts, "주민: " .. table.concat(people, " · "))
	end
	return table.concat(head, " · "), table.concat(parts, " / ")
end

return WM

end
MODULES['ReplicatedStorage/shared/net/net'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 네트워크 계층. 모든 RemoteEvent/RemoteFunction은 shared/net/packets.luau의 정의로만 만들고 쓴다 — 모듈마다
-- 리모트를 제각각 만들고 이름 문자열로 찾던 구조를 대체한다.
--   서버: Net.OnServer(이름, 핸들러) — 인자 개수/타입과 요청 빈도를 검사해서 통과한 요청만 핸들러로 보낸다.
--         Net.FireClient / Net.FireAllClients
--   클라: Net.FireServer / Net.Invoke / Net.OnClient
-- 검증에 실패하거나 빈도를 넘긴 요청은 조용히 버리고(서버 로그에는 플레이어·패킷별로 몇 초에 한 번만 경고) 핸들러는
-- 호출하지 않는다. 이동 위치를 매번 거절하는 것은 엔진 공식 문서가 비권장하지만(오탐/지연), 이 계층은 "중요 행동
-- 요청이 형식에 맞는지, 폭주하지 않는지"만 본다 — 위치/내용의 타당성 검증은 각 서비스가 맡는다.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local packets = require(script.Parent.packets)

local IS_SERVER = RunService:IsServer()
local FOLDER_NAME = "Remotes"

local Net = {}

local folder: Folder
if IS_SERVER then
	folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME) or Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = ReplicatedStorage
	for name, def in packets do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new(if def.Kind == "Function" then "RemoteFunction" else "RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

local function getRemote(name: string)
	assert(packets[name], ("Net: 정의되지 않은 패킷 '%s' (shared/net/packets.luau에 먼저 추가)"):format(name))
	if IS_SERVER then
		return folder:FindFirstChild(name)
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME):WaitForChild(name)
end

-- ===== 서버 =====

-- 플레이어별 패킷별 토큰 버킷: buckets[userId][name] = { tokens, last }
local buckets: { [number]: { [string]: { tokens: number, last: number } } } = {}
local lastWarn: { [string]: number } = {}

local function warnThrottled(key: string, message: string)
	local now = os.clock()
	if not lastWarn[key] or now - lastWarn[key] > 5 then
		lastWarn[key] = now
		warn(message)
	end
end

local function takeToken(player: Player, name: string, limit): boolean
	local perPlayer = buckets[player.UserId]
	if not perPlayer then
		perPlayer = {}
		buckets[player.UserId] = perPlayer
	end
	local now = os.clock()
	local bucket = perPlayer[name]
	if not bucket then
		bucket = { tokens = limit.Burst, last = now }
		perPlayer[name] = bucket
	end
	bucket.tokens = math.min(limit.Burst, bucket.tokens + (now - bucket.last) * limit.PerSecond)
	bucket.last = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

local function validArgs(def, ...): boolean
	if select("#", ...) > #def.Args then
		return false -- 정의보다 인자가 많으면 형식 위반
	end
	for i, check in def.Args do
		if not check((select(i, ...))) then
			return false
		end
	end
	return true
end

-- ClientToServer 패킷 핸들러 등록. Function 패킷이면 핸들러의 반환값이 클라이언트에 돌아간다.
function Net.OnServer(name: string, handler: (player: Player, ...any) -> ...any)
	assert(IS_SERVER, "Net.OnServer는 서버에서만 쓴다")
	local def = packets[name]
	assert(def and def.Direction == "ClientToServer", ("Net.OnServer: '%s'는 ClientToServer 패킷이 아니다"):format(name))
	local remote = getRemote(name)

	local function guarded(player: Player, ...)
		if not takeToken(player, name, def.RateLimit) then
			warnThrottled(player.UserId .. name .. "rate", ("Net: %s의 '%s' 요청이 빈도 제한을 넘어 버려졌다"):format(player.Name, name))
			return false
		end
		if not validArgs(def, ...) then
			warnThrottled(player.UserId .. name .. "arg", ("Net: %s의 '%s' 요청 인자가 형식에 맞지 않아 버려졌다"):format(player.Name, name))
			return false
		end
		return true
	end

	if def.Kind == "Function" then
		remote.OnServerInvoke = function(player: Player, ...)
			if not guarded(player, ...) then
				return nil
			end
			return handler(player, ...)
		end
	else
		remote.OnServerEvent:Connect(function(player: Player, ...)
			if guarded(player, ...) then
				handler(player, ...)
			end
		end)
	end
end

function Net.FireClient(name: string, player: Player, ...: any)
	assert(IS_SERVER)
	getRemote(name):FireClient(player, ...)
end

function Net.FireAllClients(name: string, ...: any)
	assert(IS_SERVER)
	getRemote(name):FireAllClients(...)
end

if IS_SERVER then
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		buckets[player.UserId] = nil
	end)
end

-- ===== 클라이언트 =====

function Net.FireServer(name: string, ...: any)
	assert(not IS_SERVER)
	getRemote(name):FireServer(...)
end

function Net.Invoke(name: string, ...: any): any
	assert(not IS_SERVER)
	return getRemote(name):InvokeServer(...)
end

function Net.OnClient(name: string, handler: (...any) -> ()): RBXScriptConnection
	assert(not IS_SERVER)
	return getRemote(name).OnClientEvent:Connect(handler)
end

return Net

end
MODULES['ReplicatedStorage/shared/net/packets'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 네트워크 패킷(RemoteEvent/RemoteFunction) 정의의 "단 하나의 출처". 공식 멀티플레이 데모(shared/packets.luau,
-- Remo + t 라이브러리)와 같은 개념 — 리모트 이름/방향/인자 타입/요청 빈도 제한을 여기에만 적는다. 서버는 이 정의로
-- 리모트를 만들고, 클라이언트→서버 패킷은 net.luau가 인자 타입과 빈도를 자동으로 검사한 뒤에야 핸들러를 부른다.
--
-- Direction: "ClientToServer"(클라가 서버에 요청/보고) / "ServerToClient"(서버가 클라에 통지).
-- Kind: "Event"(RemoteEvent) / "Function"(RemoteFunction, 서버 핸들러가 값을 돌려줌).
-- Args: ClientToServer 패킷만 사용 — 위치 인자 검증 함수 목록(개수도 정확히 맞아야 통과).
-- RateLimit: ClientToServer 패킷만 사용 — 플레이어별 토큰 버킷(PerSecond: 초당 보충량, Burst: 최대 적립량).
