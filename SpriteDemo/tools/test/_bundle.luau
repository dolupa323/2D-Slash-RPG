			return a.x
		end,
		y = function()
			return a.y
		end,
		dir = function()
			return a.dir
		end,
		tone = function()
			return a.tone
		end,
		ground = function()
			return a.ground
		end,
		big = function()
			return if a.scale > 1 then 1.5 else 1
		end,
		lv = function()
