		return true
	end
	if self.probe then
		self.probe(m, w, o)
		return true
	end
	if not ctx then
		return false
	end
	local power = Hero.powerRaw(hero) * Kit.attack(hero) * Buffs.dmg(hero) * Passives.atk(hero)
	local roll = 1 + room.rng:NextNumber(-RULES.spread, RULES.spread) / 100
	local fit = if (ctx.kind == "mob" and m.def.boss) or (ctx.kind == "boss" and not m.def.boss) then 1 else 1 + RULES.targetBonus / 100
	-- 패시브가 그 적에게 붙이는 것(넘어진 적 · 체력 · 거리 · 이어 맞히기 · 모은 단계 · 옛 사냥기)
	local mul, crit = Passives.vs(hero, m, { skill = ctx.id, charge = ctx.lv, now = room.time }), false
	-- 치명타: 모든 직업의 기술 타가 확률로(1차와 같은 셈 — sim/room.luau의 skillHit). 흘리기 = 피한 뒤의 첫 베기는 반드시
	-- 여러 줄로 쪼개지는 타는 줄마다 따로 굴린다(sim/room.luau의 Room:strike의 crit — 흘리기의 반드시 크리티컬은 그 베기의 줄 모두)
	local critChance, critMul, sure = Passives.crit(hero, room:marksOf(hero, m) > 0)
	local perLine = not o.proc and (ctx.lines or 1) > 1 and not sure
	if sure or (not perLine and critChance > 0 and room.rng:NextNumber(0, 100) < critChance) then
		crit = true
		mul *= critMul
		if sure then
			hero.pass.sure = false
		end
	end
	local dmg = max(1, floor(power * ctx.unit * w * roll * RULES.dmgScale * fit * mul + 0.5))
	local extra = {}
	if w >= BIG_W or crit then
		extra.big = true
	end
	if crit then
		extra.crit = true
	end
	-- 밀리는 것: 미는 타(kb)만 조금 민다 — 빠르게 여러 번 치는 기술(난도질 · 난타 · 놓인 불길)이 적을 범위 밖으로 밀어내지 않게(시험 탭도 미는 타만 민다)
	local dead, dealt = room:strike(hero, m, dmg, if o.kb then hero.x else m.x, ctx.mates, a.out, extra, if o.proc then nil else ctx.lines, if perLine then { chance = critChance, mul = critMul } else nil) -- 타수 나누기: 사출기처럼 따라 나가는 타는 한 줄
	m.dead = if dead then 0 else -1
	if dead then
		m.cracks, m.bind, m.rend, m.stun, m.mark = 0, 0, 0, 0, 0
	end
	if not o.proc then
		Passives.onHit(hero, m, room.time) -- 이어 맞힌 수 · 이어 때린 수(살라맨더)
		-- 넘치는 힘(액시온 4차): 끝까지 모은 강타를 맞히면 잠깐 동안 다음 강타가 높은 단계에서 시작한다
		if (ctx.lv or 0) > 0 and not ctx.surged and ctx.lv >= Kit.chargeLevels(hero) then
			local surge = Passives.get(hero, "surge")
			if surge then
				hero.pass.surge = room.time + surge.surge
			end
		end
	end
	table.insert(landed, { mob = m, dmg = dealt, dead = dead })
	return true
end

-- 맞힌 뒤에 따라붙는 것(사출기 · 표식 · 영혼 · 열기 · 수정): 1차와 같은 길로. o.mark = 표식을 남기는 타 · o.proc = 따라붙지 않는 타
function Caster:follow(a, landed, o)
	if self.probe or o.proc or #landed == 0 or not a.ctx then
		return
	end
	local hero, room = a.hero, self.room
	local power = Hero.powerRaw(hero) * Kit.attack(hero) * Buffs.dmg(hero) * Passives.atk(hero)
	room:kitAfter(hero, landed, hero.x, hero.y, nil, power, a.ctx.mates, a.out, { mark = o.mark == true })
	if o.mark and hero.class == "riven" then
		for _, l in landed do
			local m = l.mob
			local n = room:marksOf(hero, m)
			if n > 0 then
				m.mark, m.markWas = n, n -- 방금 남긴 표식(묶음이 이어서 읽는다)
			end
		end
	end
end

function Caster:box(a, x0: number, x1: number, y0: number, y1: number, cx: number, w: number, o)
	local list = self.room:mobsInBox(x0, x1, y0, y1, cx)
	local landed = {}
	for _, m in list do
		self:strike(a, m, w, o, landed)
	end
	self:follow(a, landed, o)
	return list
end

-- ---------- 손잡이 ----------
local function makeG(self, a)
	local hero, room = a.hero, self.room
	local g = { fx = FX, s = {}, PW = if room.scene then room.scene.w * G.TILE else 4096, art = {}, authority = true }
	local GET = {
		x = function()
			return hero.x
		end,
		y = function()
			return hero.y
		end,
		dir = function()
			return hero.dir
		end,
		tone = function()
			return TONE
		end,
		ground = function()
			return if self.dry then a.ground else true
		end,
		big = function()
			return Buffs.big(hero)
		end,
		lv = function() -- 모은 단계: 그 타가 딸린 스킬의 것(늦게 터지는 것은 다른 스킬을 쓰는 중에도 제 스킬의 단계로 친다)
			return if a.ctx then a.ctx.lv elseif a.skill then a.skill.lv else 0
		end,
		held = function()
			return if a.skill then a.skill.t else 0
		end,
		clock = function()
			return room.time
		end,
		toggle = function()
			return Kit.firing(hero)
		end,
		hero = function()
			return a.body
		end,
		cam = function()
			return { x = 0, y = 0 }
		end,
	}
	setmetatable(g, {
		__index = function(_, key)
			local get = GET[key]
			return if get then get() else nil
		end,
	})
	function g.rnd(): number
		return room.rng:NextNumber()
	end
	function g.fwd(d: number): number
		return hero.x + hero.dir * d
	end
	function g.hit(from: number, to: number, up: number, down: number, w: number, o)
		local k = Buffs.big(hero) * Passives.reach(hero) -- 거신 · 낫 숙련 · 영혼 주머니: 닿는 거리(앞 · 위)가 그만큼 는다
		local x0, x1 = hero.x + hero.dir * from * k, hero.x + hero.dir * to * k
		return self:box(a, min(x0, x1), max(x0, x1), hero.y - up * k, hero.y + down, hero.x, w or 0, o or EMPTY)
	end
	function g.hitAt(x: number, y: number, hw: number, h: number, w: number, o)
		return self:box(a, x - hw, x + hw, y - h, y + 6, x, w or 0, o or EMPTY)
	end
	function g.hurt(m, w: number, o): boolean
		local landed = {}
		local ok = self:strike(a, m, w or 0, o or EMPTY, landed)
		self:follow(a, landed, o or EMPTY)
		return ok
	end
	function g.mobs()
		local out = {}
		for _, m in room.mobs do
			if aliveMob(m) then
				out[#out + 1] = m
			end
		end
		return out
	end
	function g.nearest(range: number, o)
		local from, not_, front = (o and o.from) or hero.x, o and o["not"], o and o.front
		local best, bd = nil, range
		for _, m in room.mobs do
			if not aliveMob(m) or m == not_ or abs(m.y - hero.y) > 60 or (front and (m.x - hero.x) * hero.dir < -8) then
				continue
			end
			local d = abs(m.x - from)
			if d <= bd then
				bd, best = d, m
			end
		end
		return best
	end
	function g.boss()
		local best = nil
		for _, m in room.mobs do
			if aliveMob(m) and abs(m.x - hero.x) < 280 and (not best or m.maxHp > best.maxHp) then
				best = m
			end
		end
		return best
	end
	g.shake, g.stop, g.invert, g.dim, g.ghost, g.sprite, g.call = NOOP, NOOP, NOOP, NOOP, NOOP, NOOP, NOOP
	-- 소생(무니 4차): 쓰러져 비석이 선 파티원을 그 자리에서 일으킨다 — 최대 체력의 일부로(설계 CASTRULE.heal의 revive). 쓰러진 벌칙도 없던 일이 된다
	function g.revive()
		local ctx = a.ctx
		local def = ctx and CAST[ctx.id]
		local h = def and def.heal
		if not h or not h.revive or self.probe then
			return
		end
		local share = h.revive * Hero.skillScale(hero.skills[ctx.id] or 0, def.max)
		for _, mate in ctx.fallen or {} do
			if not mate.alive and abs(mate.x - hero.x) <= h.reach and abs(mate.y - hero.y) <= 80 then
				Hero.raise(mate, share)
				table.insert(self.events, { type = "raised", hero = mate.id, by = hero.id })
			end
		end
	end
	function g.after(d: number, fn)
		table.insert(self.timers, { t = d, fn = fn, a = a, ctx = a.ctx })
	end
	function g.shot(o)
		local p = { t = 0, acc = 0, hitSet = {}, dir = hero.dir, who = hero.class, w = 0, h = 0, dmg = 0, life = 1, a = a, ctx = a.ctx }
		for k, v in o do
			p[k] = v
		end
		table.insert(self.shots, p)
		return p
	end
	-- 몸을 옮기는 것: 걷기 · 뛰기는 화면이 하고 제 자리를 알려 온다(여기서는 재 볼 때만 흉내 낸다). 순간이동은 서버도 그 자리로 옮겨 적는다 —
	--  화면이 알려 오는 자리가 멀어도 그 스킬을 쓴 직후에는 받는다(server world.luau의 onMove — 몸을 옮기는 스킬일 때만: Caster.MOVERS · hero.warpMark)
	--  그 스킬을 처음 쓸 때 서버가 빈 방에서 한 번 재 보므로(Caster.profile — context가 부른다) 처음부터 MOVERS에 든다
	local function moved()
		local id = a.ctx and a.ctx.id or (a.skill and a.skill.id)
		if id then
			Caster.MOVERS[id] = true
		end
		if not self.dry and not self.probe then
			hero.warpMark = true
		end
	end
	function g.move(v: number, t: number)
		if self.dry then
			a.imp = { v = v * hero.dir, t = t }
		end
		moved()
	end
	function g.hop(v: number)
		if self.dry then
			a.body.vy, a.ground = -v, false
		end
	end
	function g.face(d: number)
		hero.dir = d
	end
	function g.teleport(x: number): boolean
		local scene = room.scene
		if scene then
			x = math.clamp(x, 8, scene.w * G.TILE - 8)
			if Physics.solidBox(scene, x, hero.y) then
				return false
			end
		end
		moved()
		hero.x = x
		return true
	end
	function g.drag(m, x: number)
		if not m.def.boss and aliveMob(m) then
			m.x = math.clamp(x, m.a, m.b)
		end
	end
	function g.buff(id: string)
		local def = Buffs.data[id]
		if def and (hero.skills[id] or 0) > 0 then
			Buffs.give(hero, id, Hero.skillScale(hero.skills[id], def.max), hero.x, hero.y)
			table.insert(self.events, { type = "buffs", hero = hero.id })
		end
	end
	function g.has(id: string): boolean
		return Buffs.has(hero, id)
	end
	function g.left(id: string): number
		local b = hero.buffs[id]
		return if b then b.t else 0
	end
	function g.endBuff(id: string)
		if hero.buffs[id] then
			hero.buffs[id] = nil
			table.insert(self.events, { type = "buffs", hero = hero.id })
		end
	end
	function g.resetCd(id: string)
		if hero.cds[id] then
			hero.cds[id] = nil
			table.insert(self.events, { type = "cool", hero = hero.id, skill = id })
		end
	end
	function g.sk(id: string): number
		return hero.skills[id] or 0
	end
	-- 바인드: 풀린 뒤 한동안은 다시 묶이지 않는다. 묶인 적은 그동안 움직이지도 치지도 못한다(sim/room.luau의 stepMob)
	function g.bind(m, t: number, kind: string?): boolean
		if not aliveMob(m) or (m.bindImm or 0) > 0 then
			return false
		end
		m.bind, m.bindKind, m.bindImm = t, kind, t + RULE.bindImm
		return true
	end
	-- 회복(무니의 달빛 치유): 나와 가까운 파티원의 체력을 되돌린다 — 세기는 설계(CASTRULE.heal)의 것
	function g.heal(k: number?)
		local ctx = a.ctx
		local def = ctx and CAST[ctx.id]
		local h = def and def.heal
		if not h or self.probe then
			return
		end
		local s = Hero.skillScale(hero.skills[ctx.id] or 0, def.max) * (k or 1)
		for _, mate in (if room.liveMates then room:liveMates(hero, ctx.mates) else ctx.mates or { hero }) do -- 지금 이 방에 살아 있는 파티원만(쓰기 시작할 때의 목록이라 — 2026-10-18 검토)
			if mate.alive and abs(mate.x - hero.x) <= h.reach and abs(mate.y - hero.y) <= 80 then
				local amount = min(mate.maxHp - mate.hp, floor(mate.maxHp * h.hp * s + 0.5))
				if amount > 0 then
					mate.hp += amount
					table.insert(self.events, { type = "healed", hero = mate.id, amount = amount, by = hero.id })
				end
			end
		end
	end
	function g.chargeMax(): number
		local _, levels = chargeOf(hero, EMPTY)
		return levels
	end
	return g
end

-- 묶음의 g.s 가운데 캐릭터 · 방의 것: 영혼 · 열기(sim/kit.luau의 h.kit) · 달 수정(방의 crystals)
local function bridge(self, a)
	local hero, room, s = a.hero, self.room, a.g.s
	rawset(s, "souls", nil)
	rawset(s, "heat", nil)
	rawset(s, "cr", nil)
	setmetatable(s, {
		__index = function(_, key)
			if key == "souls" then
				return hero.kit.souls
			elseif key == "heat" then
				return hero.kit.heat
			elseif key == "cr" then
				local list = {}
				for _, c in room.crystals do
					if c.owner == hero.id then
						c.t, c.life = 0, 1 -- 방에 있는 동안은 살아 있다(시간은 방이 센다)
						list[#list + 1] = c
					end
				end
				return list
			end
			return nil
		end,
		__newindex = function(t, key, value)
			if key == "souls" then
				if hero.kit.souls ~= value then
					hero.kit.souls, hero.kit.soulT = value, 0
					a.out.kit = true
				end
			elseif key == "heat" then
				if hero.kit.heat ~= value then
					hero.kit.heat, hero.kit.heatT = value, 0
					a.out.kit = true
				end
			elseif key ~= "cr" then
				rawset(t, key, value)
			end
		end,
	})
end

function Caster:actor(hero)
	local a = self.actors[hero]
	if a then
		return a
	end
	local kit = Kitset.of(hero.class)
	a = { hero = hero, kit = kit, skill = nil, ctx = nil, out = newOut(), body = { vx = 0, vy = 0, scale = 1, alpha = 1 }, ground = true, imp = nil, last = nil }
	a.g = makeG(self, a)
	if kit and kit.init then
		kit.init(a.g)
	end
	bridge(self, a)
	self.actors[hero] = a
	return a
end

-- 그 사람이 스킬을 쓰는 중인가(다른 기술을 시작하지 못한다)
function Caster:busy(hero): boolean
	local a = self.actors[hero]
	local sk = a and a.skill
	return sk ~= nil and not sk.done and sk.t < sk.need - EARLY
end

-- 그 사람이 스킬의 동작을 하는 중인가(굳센 자세 — 그동안은 받는 피해가 더 준다)
function Caster:acting(hero): boolean
	local a = self.actors[hero]
	return a ~= nil and a.skill ~= nil and not a.skill.done
end

-- 그 사람의 것을 모두 거둔다(방을 나갔다 · 쓰러졌다)
function Caster:drop(hero)
	local a = self.actors[hero]
	if not a then
		return
	end
	self.actors[hero] = nil
	for i = #self.timers, 1, -1 do
		if self.timers[i].a == a then
			table.remove(self.timers, i)
		end
	end
	for i = #self.shots, 1, -1 do
		if self.shots[i].a == a then
			table.remove(self.shots, i)
		end
	end
end

-- 구간을 닫는다: 다 틀고 넘어가는 구간이면 아직 안 터진 장의 일을 마저 터뜨리고(화면의 시계가 조금 앞섰을 때), 끝날 때의 일을 부른다
local function closeSeg(self, a)
	local sk = a.skill
	if not sk or sk.done then
		return
	end
	sk.done = true
	local s = sk.s
	if not (s.hold or s.charge or s.till) then
		for _, e in s.evs do
			if not sk.fired[e[1]] then
				sk.fired[e[1]] = true
				self:run(a, sk.ctx, e[2], a.g)
			end
		end
	end
	if s.finish then
		self:run(a, sk.ctx, s.finish, a.g)
	end
end

local function endSkill(self, a)
	local sk = a.skill
	if sk then
		closeSeg(self, a)
		a.last = { id = sk.id, i = sk.i, at = self.room.time, ctx = sk.ctx }
		if a.skill == sk then
			a.skill = nil
		end
	end
end

-- 그 스킬의 그 구간이 시작됐다(화면이 알렸다). 받았으면 true와 모은 단계.
--  첫 구간: 앞 스킬이 (거의) 끝났을 때만. 이어지는 구간: 바로 앞 구간이 제 시간을 (거의) 다 썼을 때만 — 누르고 있는 구간은 가장 짧은 시간, 조건을 기다리는 구간은 언제든.
--  info = 그 밖에 넘기는 것 { fallen = 쓰러져 있는 파티원들(소생이 일으킨다) }
function Caster:begin(hero, id: string, seg: number, mates, info): (boolean, number?)
	local def = CAST[id]
	local skill, kit = Kitset.skill(id)
	if not def or not skill or not kit or kit.who ~= hero.class or not hero.alive or seg ~= floor(seg) then
		return false, nil
	end
	local a = self:actor(hero)
	local cur = a.skill
	if skill.instant then
		if seg ~= 1 or (cur and self:busy(hero)) then
			return false, nil
		end
		self:run(a, self:context(a, id, 0, mates), skill.cast, a.g)
		return true, 0
	end
	local s = skill.segs and skill.segs[seg]
	if not s then
		return false, nil
	end
	local lv, ctx = 0, nil
	local surged = false -- 모으지 않고 얻은 단계(넘치는 힘) — 이 타로는 넘치는 힘이 다시 켜지지 않는다
	if seg == 1 then
		if cur then
			if self:busy(hero) then
				return false, nil
			end
			endSkill(self, a)
		end
		-- 「때까지」 구간(뛰어올라 떨어질 때까지 — 도약)은 서버가 끝을 알 수 없어 다음 구간을 바로 받는다: 그래서 같은 기술을 다시 시작하는 데
		--  빈 방에서 잰 한 번의 시간(Caster.profile)의 TILL_GAP배는 걸리게 한다(2026-10-18 검토 — 구간을 잇달아 보내 하늘에 있는 시간을 건너뛰면 보스에게 두세 배였다).
		--  공중에서 쓰면 짧게 끝나는 것은 그대로 둔다(다시 쓰는 데만 조금 기다린다)
		if not self.dry and hasTill(skill) then
			a.began = a.began or {}
			local at = a.began[id]
			if at and self.room.time - at < Caster.profile(id, 0).time * TILL_GAP / Buffs.haste(hero) then
				return false, nil
			end
			a.began[id] = self.room.time
		end
		ctx = self:context(a, id, 0, mates)
		ctx.fallen = info and info.fallen
	else
		local prev = skill.segs[seg - 1]
		if cur and cur.id == id and cur.i == seg - 1 then
			if cur.t < cur.need - EARLY then
				return false, nil -- 앞 구간이 아직 한창이다
			end
			if prev.charge then
				-- 모은 단계는 서버가 흐른 시간으로 셈한다(화면이 말한 단계를 믿지 않는다). 만월 동안에는 모으지 않아도 끝까지 모은 것으로 친다
				local per, levels = chargeOf(hero, prev)
				lv = if Buffs.full(hero) then levels else math.clamp(floor((cur.t - segTime(hero.class, prev)) / per + 0.08), 0, levels)
				-- 넘치는 힘(액시온 4차): 끝까지 모은 강타를 맞힌 직후에는 모으지 않아도 높은 단계에서 시작한다(한 번 쓰면 사라진다)
				local surge = Passives.get(hero, "surge")
				if surge and levels > 0 and hero.pass.surge > self.room.time and lv < surge.surgeFrom then
					lv = min(surge.surgeFrom, levels)
					hero.pass.surge = -1e9
					surged = true
				end
			end
			ctx = cur.ctx
			closeSeg(self, a)
		elseif not cur and a.last and a.last.id == id and a.last.i == seg - 1 and self.room.time - a.last.at <= GRACE + 0.2 then
			ctx = a.last.ctx -- 앞 구간이 막 끝났다(알림이 조금 늦었다)
		else
			return false, nil
		end
		if lv > 0 or not ctx then
			ctx = self:context(a, id, lv, mates)
			ctx.surged = surged
		end
	end
	local sk = { id = id, def = skill, i = seg, s = s, t = 0, lv = lv, fired = {}, acc = 0, ctx = ctx, limit = segLimit(hero, s), need = segNeed(hero, s), done = false, wait = 0 }
	a.skill = sk
	if s.start then
		self:run(a, ctx, s.start, a.g)
	end
	return true, lv
end

-- ---------- 한 걸음 ----------
function Caster:sub(h: number)
	local room = self.room
	self:syncMobs()
	-- 늦게 터지는 것
	local timers = self.timers
	for i = #timers, 1, -1 do
		local t = timers[i]
		t.t -= h
		if t.t <= 0 then
			table.remove(timers, i)
			self:run(t.a, t.ctx, t.fn)
		end
	end
	-- 쓰는 중인 스킬: 구간의 장 번호에 맞춰 일을 터뜨린다
	for hero, a in self.actors do
		local sk = a.skill
		if self.dry then
			-- 재는 중: 몸의 움직임을 흉내 낸다(밀고 나가기 · 뛰었다 떨어지기)
			if a.imp then
				hero.x += a.imp.v * h
				a.imp.t -= h
				if a.imp.t <= 0 then
					a.imp = nil
				end
			end
			if not a.ground then
				a.body.vy = min(a.body.vy + G.GRAVITY * h, G.MAX_FALL)
				hero.y += a.body.vy * h
				if a.body.vy >= 0 and hero.y >= a.floor then
					hero.y, a.body.vy, a.ground = a.floor, 0, true
				end
			end
		end
		if not sk then
			continue
		end
		if not hero.alive then
			a.skill = nil
			continue
		end
		local s = sk.s
		if sk.done then
			sk.wait += h
			if sk.wait >= GRACE then
				endSkill(self, a)
			end
			continue
		end
		local haste = if s.charge then 1 else Buffs.haste(hero) -- 공격 속도 버프: 동작 · 타격 시점 · 되풀이 타격 간격이 빨라진다(힘 모으기 구간은 그대로)
		sk.t += h * haste
		local f = (s.from or 0) + floor(sk.t * (s.fps or 14))
		for _, e in s.evs do
			if f >= e[1] and not sk.fired[e[1]] then
				sk.fired[e[1]] = true
				self:run(a, sk.ctx, e[2], a.g)
			end
		end
		if s.every and a.skill == sk then
			sk.acc += h * haste
			while sk.acc >= s.every[1] and a.skill == sk do
				sk.acc -= s.every[1]
				self:run(a, sk.ctx, s.every[2], a.g)
			end
		end
		if a.skill == sk and sk.t >= sk.limit then
			closeSeg(self, a) -- 제 시간을 다 썼다: 다음 구간의 알림을 조금 기다린다
		end
	end
	-- 날아가는 것 · 놓인 것(시험 탭의 그 줄들)
	local shots = self.shots
	for i = #shots, 1, -1 do
		local p = shots[i]
		local a = p.a
		p.t += h
		if p.target then -- 쫓아가는 것: 닿으면 onReach
			local tm = p.target
			local tx, ty = tm.x, tm.y - (if tm.def.boss then 14 else 7)
			local d = sqrt((tx - p.x) ^ 2 + (ty - p.y) ^ 2)
			if not aliveMob(tm) then
				table.remove(shots, i)
				continue
			end
			if d < 6 then
				if p.onReach then
					self:run(a, p.ctx, p.onReach, p)
				end
				table.remove(shots, i)
				continue
			end
			local sp = (p.speed or 200) * h
			p.x += ((tx - p.x) / d) * sp
			p.y += ((ty - p.y) / d) * sp + (p.curl or 0) * sin(p.t * 12) * h
		else
			if p.g then
				p.vy = (p.vy or 0) + p.g * h
			end
			p.x += (p.vx or 0) * h
			p.y += (p.vy or 0) * h
		end
		if p.update then
			self:run(a, p.ctx, p.update, p, h)
		end
		if p.every then
			p.acc += h
			while p.acc >= p.every[1] do
				p.acc -= p.every[1]
				self:run(a, p.ctx, p.every[2], p)
			end
		end
		if p.dmg ~= 0 then
			for _, m in room.mobs do
				-- 몸의 크기: 병사는 반폭 7 · 높이 12. 새 몬스터는 종류마다 다르다(def.body · lift) · 나는 몬스터는 뜬 높이만큼 위에 있다
				local hh, hw, up = if m.def.boss then 26 else 12, 7, 0
				if m.def.body then
					hw, up, hh = m.def.body[1] / 2 + 1, (m.def.lift or 0) + (m.alt or 0), m.def.body[2]
				end
				if not aliveMob(m) or abs(m.x - p.x) > p.w / 2 + hw or m.y - up < p.y - p.h / 2 - 2 or m.y - up - hh > p.y + p.h / 2 then
					continue
				end
				local was = p.hitSet[m]
				if was ~= nil and not (p.tick and p.t - was >= p.tick) then
					continue
				end
				p.hitSet[m] = p.t
				self:run(a, p.ctx, function()
					local o = p.o or EMPTY
					local landed = {}
					self:strike(a, m, p.dmg, o, landed)
					self:follow(a, landed, o)
					if p.onHit then
						p.onHit(p, m)
					end
				end)
			end
		end
		-- 벽 · 땅에 닿으면 끝난다(재는 빈 방에는 칸이 없다 — 발밑 높이를 땅으로 친다)
		local wall = ((p.vx or 0) ~= 0 or (p.vy or 0) ~= 0) and not p.ghost
		if wall then
			if room.scene then
				wall = Physics.cell(room.scene, floor(p.x / G.TILE), floor(p.y / G.TILE)) == "#"
			else
				wall = self.dry and a.floor ~= nil and p.y >= a.floor
			end
		end
		if p.dead or p.t >= p.life or wall then
			if p.finish then
				self:run(a, p.ctx, p.finish, p, wall)
			end
			table.remove(shots, i)
		end
	end
end

-- 방의 한 걸음(heroes = 지금 방에 있는 사람들 { [번호] = 캐릭터 }). 일어난 일을 events에 적는다: "kit"(맞은 것 · 잡은 것 — 그 사람의 일) · "healed" · "buffs" · "crystalGone"
function Caster:step(heroes, dt: number, events)
	local here = {}
	for _, h in heroes do
		here[h] = true
	end
	for hero in self.actors do
		if not here[hero] then
			self:drop(hero)
		end
	end
	if next(self.actors) == nil then
		return
	end
	local n = max(1, math.ceil(dt / SUB - 1e-6))
	for _ = 1, n do
		self:sub(dt / n)
	end
	self:flush(events)
end

-- 모인 결과를 일로 내보낸다(구간이 시작될 때 바로 터진 것도 여기서 나간다)
function Caster:flush(events)
	for hero, a in self.actors do
		local out = a.out
		if #out.hits > 0 or #out.kills > 0 or out.kit or out.heal or out.crystals or out.crystalGone then
			table.insert(events, { type = "kit", hero = hero.id, result = out })
			a.out = newOut()
		end
	end
	for _, e in self.events do
		table.insert(events, e)
	end
	table.clear(self.events)
end

-- ---------- 재 보기 ----------
-- 그 스킬을 빈 방에서 열 번 써 보고 잰다: time = 한 번 쓰는 데 걸리는 시간(초) · w = 붙어 있는 적 한 마리가 다 맞았을 때의 몫의 합 · hits = 맞는 횟수.
--  화면이 하는 일(구간 잇기)을 흉내 낸다: 이어 누르는 구간은 바로 누르고, 누르고 있는 구간은 가장 짧게, 모으는 구간은 lv단계까지만 모은다.
--  캐릭터는 그 스킬만 배운 모습이다(영혼 · 열기 · 표식 · 수정 없음) — 장치가 얹는 것은 여기에 들지 않는다. 설계가 따로 정한 값(CAST의 w · time)이 있으면 그것을 쓴다
local PROFILE = {}
local X0, Y0 = 2000, 176

-- 화면이 하는 일(구간 잇기)을 흉내 내어 그 스킬을 한 번 쓴다 — 재 볼 때와 테스트가 쓴다(self.dry = true인 방에서). 걸린 시간(초)을 돌려준다.
--  이어 누르는 구간은 바로 누르고, 누르고 있는 구간은 hold초(없으면 가장 짧게), 모으는 구간은 lv단계까지만 모은다. tick() = 방의 시간을 SUB만큼 흘리고 self:sub(SUB)를 부르는 함수
function Caster:dryCast(hero, id: string, lv: number, tick, hold: number?): number
	local skill = Kitset.skill(id)
	local a = self:actor(hero)
	a.floor = a.floor or hero.y
	a.ground, a.body.vy, a.imp = true, 0, nil
	if skill.instant then
		self:run(a, self:context(a, id, 0, nil), skill.cast, a.g)
		return 0
	end
	assert(self:begin(hero, id, 1, nil), "시작하지 못했다 " .. id)
	local t, st = 0, 0 -- st = 이 구간에 들어선 뒤 흐른 시간
	a.skill.limit = math.huge -- 구간을 끝내는 것은 이쪽이다
	while a.skill and t < 12 do
		tick()
		t += SUB
		st += SUB
		local sk = a.skill
		if not sk then
			break
		end
		local s = sk.s
		local over
		if s.loop then
			over = st >= s.dur
		elseif s.hold then
			over = st >= math.max(s.min or 0.15, math.min(hold or 0, s.max or 3))
		elseif s.charge then
			over = st >= segTime(hero.class, s) + (s.per or RULE.charge) * lv + (if lv > 0 then 0.02 else 0)
		elseif s.till then
			over = s.till(a.g) or st >= (s.max or 1.5)
		else
			over = st >= segTime(hero.class, s)
		end
		if over then
			local nextS = skill.segs[sk.i + 1]
			if nextS then
				-- 다음 구간: 모은 단계는 이쪽이 정한다(시간으로 세는 것은 begin의 일이다 — 따로 테스트한다)
				closeSeg(self, a)
				local ctx = sk.ctx
				if s.charge and lv > 0 then
					ctx = self:context(a, id, lv, ctx.mates)
				end
				a.skill = { id = id, def = skill, i = sk.i + 1, s = nextS, t = 0, lv = ctx.lv, fired = {}, acc = 0, ctx = ctx, limit = math.huge, need = segNeed(hero, nextS), done = false, wait = 0 }
				st = 0
				if nextS.start then
					self:run(a, ctx, nextS.start, a.g)
				end
			else
				endSkill(self, a)
			end
		end
	end
	return t
end

local function measure(id: string, lv: number)
	local def = CAST[id]
	assert(Caster.makeDry, "재 볼 방을 짓는 함수가 없다(sim/room.luau가 넣는다)")
	local at = X0 + (def.at or 14) -- 적이 서 있는 자리: 붙어 있다(몸이 나아가거나 멀리 던지는 기술은 설계가 정한 자리 — 그 타가 떨어지는 곳)
	local room, dummy = Caster.makeDry(at, Y0)
	local self = Caster.new(room)
	self.dry = true
	local total, hits = 0, 0
	self.probe = function(m, w)
		if m == dummy then
			total += w
			hits += 1
		end
	end
	local hero = Hero.new(0, def.who)
	hero.skills = { [id] = 1 }
	local time = 0
	local function tick()
		room.time += SUB
		self:sub(SUB)
	end
	for _ = 1, TRIALS do
		hero.x, hero.y, hero.dir = X0, Y0, 1
		dummy.x, dummy.stun, dummy.bind, dummy.bindImm = at, 0, 0, 0
		time += self:dryCast(hero, id, lv, tick)
	end
	-- 남은 것(늦게 터지는 것 · 놓인 불길)이 다 끝날 때까지 돌린다
	local guard = 0
	while (#self.timers > 0 or #self.shots > 0) and guard < 20 do
		tick()
		guard += SUB
	end
	return { time = time / TRIALS, w = total / TRIALS, hits = hits / TRIALS, errors = self.errors }
end

function Caster.profile(id: string, lv: number?)
	local key = id .. ":" .. tostring(lv or 0)
	local p = PROFILE[key]
	if not p then
		local def = CAST[id]
		p = measure(id, lv or 0)
		p.measured = p.w
		if def.w then
			p.w = def.w
		end
		if def.time then
			p.time = def.time
		end
		if p.w <= 0 then
			p.w = 1 -- 빈 방에서는 맞는 것이 없는 스킬(묶기만 하는 것 · 회복)
		end
		PROFILE[key] = p
	end
	return p
end

return Caster

end
MODULES['ReplicatedStorage/shared/lune/sim/daily'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 일일 의뢰의 셈 — 화면도 서버도 모르는 셈이다(서버 server/lune/modules/world.luau의 onDaily · 화면 client/lune/ui/dailyWindow.luau가 부른다).
--  사용자 2026-10-13: "일일 퀘스트 필요합니다. 게시판이랑 상호작용해서 일퀘받는거 좋습니다. 근데 좀더 간결하게 해도 될거 같습니다.  5분쯤 걸리게 / 일일 의뢰는 10부터 열죠"
--  규칙과 수는 공방의 js/lune/design/daily.js(data/daily.generated.luau):
--   · Lv.10부터 · 마을의 의뢰 게시판 앞에서 받고 낸다 · 하루 둘 — 내 레벨로 갈 수 있는 사냥터 가운데 레벨이 높은 near곳에서 그 몬스터 30마리씩
--   · 날마다 자정(한국 시간)에 새 의뢰로 바뀐다(받아 두고 못 끝낸 것 · 다 잡고 안 낸 것도 그때 사라진다)
--   · 보상은 내 레벨의 것: 의뢰 하나를 낼 때마다 경험치 · 달돈, 그날의 의뢰를 모두 내면 덤으로 달가루
--  캐릭터의 표에 얹는 것: h.daily = { [지역] = { day = 그 의뢰들의 날, tasks = { { scene, mob, n, have, st } … }, bonus = 덤을 받았는가 } }
--   st = 0 안 받음 · 1 하는 중(have가 n이 되면 낼 수 있다) · 2 냈다
local DATA = require(script.Parent.Parent.data["daily.generated"])
local Quests = require(script.Parent.quests) -- 줄의 몬스터를 피한다(Quests.lineMobs)

local Daily = {}
Daily.DATA = DATA
Daily.FROM = DATA.from
Daily.WORDS = DATA.words
Daily.REGION = "r1" -- 처음의 게시판(초승달 마을)
-- 그 장면 · 그 주민(게시판 · 의뢰 접수원)이 맡은 지역(없으면 nil) — 2026-10-16: 지역마다 게시판(은달 항구 = 수정 숲)
function Daily.regionAt(scene: string, npc: string?): string?
	for region, b in DATA.boards do
		if b.scene == scene and (npc == nil or b.npc == npc) then
			return region
		end
	end
	return nil
end
Daily.OPEN, Daily.ON, Daily.DONE = 0, 1, 2

local function whole(v: any, lo: number, hi: number): boolean
	return typeof(v) == "number" and v == math.floor(v) and v >= lo and v <= hi
end

-- 풀에서 그 장면의 그 몬스터를 찾는다(없으면 nil)
local function entry(region: string, scene: any, mob: any)
	local board = DATA.boards[region]
	for _, q in (if board then board.pool else {}) do
		if q.scene == scene and q.mob == mob then
			return q
		end
	end
	return nil
end
Daily.entry = entry

-- 그 시각(os.time)의 날짜 번호 — 자정(한국 시간)에 넘어간다 · 다음 자정까지 남은 초
function Daily.dayOf(now: number): number
	return math.floor((now + DATA.offset * 3600) / 86400)
end
function Daily.left(now: number): number
	return 86400 - (now + DATA.offset * 3600) % 86400
end

-- 그 레벨 · 그날의 의뢰들: 갈 수 있는 사냥터(그 몬스터의 가장 낮은 레벨 ≤ 내 레벨) 가운데 레벨이 높은 near곳에서 차례로 돈다(공방의 dailyPick과 같은 셈)
--  skip = 피할 몬스터(퀘스트 줄에서 아직 끝내지 않은 퀘스트의 몬스터 — Quests.lineMobs): 지나온 사냥터에서 뽑는다. 다 빠지면 예전대로(2026-10-15)
function Daily.pick(region: string, level: number, day: number, skip: { [string]: boolean }?)
	local can, top = {}, {}
	for _, q in DATA.boards[region].pool do
		if q.lv[1] <= level then
			table.insert(can, q)
			if not (skip and skip[q.mob]) then
				table.insert(top, q)
			end
		end
	end
	if #top == 0 then
		top = can
	end
	while #top > DATA.near do
		table.remove(top, 1)
	end
	local out = {}
	for i = 1, DATA.perDay do
		local q = top[(day + i - 1) % #top + 1]
		out[i] = { scene = q.scene, mob = q.mob, n = DATA.kills, have = 0, st = Daily.OPEN }
	end
	return out
end

-- 오늘의 것으로 맞춘다(처음이거나 날이 바뀌었으면 새로 뽑는다). 돌려주는 것: 그 지역의 상태(아직 열리지 않은 레벨 · 게시판이 없는 지역이면 nil), 새로 뽑았는가
function Daily.sync(h, region: string, now: number)
	local board = DATA.boards[region]
	if not board or h.level < math.max(DATA.from, board.from or 0) then -- 게시판마다 여는 레벨(은달 항구의 것은 Lv.30 — 2026-10-16)
		return nil, false
	end
	local day = Daily.dayOf(now)
	local st = h.daily[region]
	if st and st.day == day then
		-- 마릿수의 설계가 바뀌었으면 아직 내지 않은 의뢰를 새 수로 맞춘다(2026-10-13: 30 → 8 — 받아 둔 30마리짜리가 자정까지 남지 않게)
		for _, t in st.tasks do
			if t.st ~= Daily.DONE and t.n ~= DATA.kills then
				t.n = DATA.kills
				t.have = math.min(t.have, t.n)
			end
		end
		return st, false
	end
	st = { day = day, tasks = Daily.pick(region, h.level, day, Quests.lineMobs(h.quests or {}, region)), bonus = false }
	h.daily[region] = st
	return st, true
end

function Daily.isReady(t): boolean
	return t.st == Daily.ON and t.have >= t.n
end

-- 의뢰를 받는다(게시판 앞에서 — 자리는 서버가 본다). 받아야 세기 시작한다
function Daily.accept(h, region: string, i: any, now: number): (boolean?, string?)
	local st = Daily.sync(h, region, now)
	local t = st and st.tasks[i]
	if not t then
		return nil, DATA.words.early
	elseif t.st ~= Daily.OPEN then
		return nil, "이미 받은 의뢰다"
	end
	t.st, t.have = Daily.ON, 0
	return true, nil
end

-- 몬스터를 잡았다: 하는 중인 오늘의 의뢰 가운데 그 장면의 그 몬스터인 것을 하나 센다. 돌려주는 것: 센 것이 있는가
function Daily.onKill(h, mob: string, scene: string, now: number): boolean
	local day = Daily.dayOf(now)
	local changed = false
	for _, st in h.daily do
		if st.day == day then -- 날이 바뀐 뒤에는 어제의 의뢰를 세지 않는다(게시판에 가면 새 의뢰로 바뀐다)
			for _, t in st.tasks do
				if t.st == Daily.ON and t.have < t.n and t.mob == mob and t.scene == scene then
					t.have += 1
					changed = true
				end
			end
		end
	end
	return changed
end

-- 의뢰를 낸다: 달돈(과 덤의 달가루)은 여기서 얹고, 경험치는 돌려준 값을 부른 쪽이 준다(레벨 업을 알려야 한다).
--  돌려주는 것: { xp, money, dust(덤 — 그날의 의뢰를 모두 냈을 때만 0보다 크다), all = 모두 냈는가, name = 그 몬스터의 이름 } 또는 nil과 까닭
function Daily.turnIn(h, region: string, i: any, now: number)
	local st = Daily.sync(h, region, now)
	local t = st and st.tasks[i]
	if not t then
		return nil, DATA.words.early
	elseif not Daily.isReady(t) then
		return nil, DATA.words.notYet
	end
	t.st = Daily.DONE
	local level = math.clamp(h.level, 1, #DATA.pay.xp)
	local q = entry(region, t.scene, t.mob)
	local reward = { xp = DATA.pay.xp[level], money = DATA.pay.money[level], dust = 0, all = true, name = if q then q.name else "" }
	h.money += reward.money
	for _, x in st.tasks do
		reward.all = reward.all and x.st == Daily.DONE
	end
	if reward.all and not st.bonus then
		st.bonus = true
		reward.dust = DATA.pay.dust[level]
		h.dust += reward.dust
	end
	return reward, nil
end

-- 화면에 보내는 것: { from, left(다음 자정까지 초), boards = { [지역] = { tasks = { { scene, mob, name, place, n, have, st } … }, bonus, pay = { xp, money, dust }(내 레벨의 것) } } }
--  아직 열리지 않은 레벨이면 boards가 비어 있다. 날이 바뀌었으면 여기서 새 의뢰로 바뀐다(둘째 값 = 바뀌었는가 — 저장해야 한다)
function Daily.view(h, now: number)
	local out = { from = DATA.from, left = Daily.left(now), boards = {} }
	local fresh = false
	local level = math.clamp(h.level, 1, #DATA.pay.xp)
	for region in DATA.boards do
		local st, new = Daily.sync(h, region, now)
		fresh = fresh or new
		if st then
			local tasks = {}
			for i, t in st.tasks do
				local q = entry(region, t.scene, t.mob)
				tasks[i] = { scene = t.scene, mob = t.mob, name = if q then q.name else "", place = if q then q.place else "", n = t.n, have = t.have, st = t.st }
			end
			out.boards[region] = { tasks = tasks, bonus = st.bonus, pay = { xp = DATA.pay.xp[level], money = DATA.pay.money[level], dust = DATA.pay.dust[level] } }
		end
	end
	return out, fresh
end

-- 게시판 위의 표시(화면이 받은 것으로 셈한다): 낼 것이 있으면 "?" · 아직 안 받은 것이 있으면 "!" · 없으면 nil
function Daily.mark(board: any): string?
	local best: string? = nil
	for _, t in (if board then board.tasks else {}) do
		if Daily.isReady(t) then
			return "?"
		elseif t.st == Daily.OPEN then
			best = "!"
		end
	end
	return best
end

-- 알리미에 적을 것(화면이 받은 것으로): 하는 중인 의뢰들 { name, place, n, have }
function Daily.tracked(view: any)
	local out = {}
	for region in DATA.boards do
		local board = view and view.boards and view.boards[region]
		for i, t in (if board then board.tasks else {}) do
			if t.st == Daily.ON then
				table.insert(out, { name = t.name, place = t.place, n = t.n, have = t.have, region = region, i = i }) -- region · i = 길찾기가 그 의뢰를 가리킬 때 쓴다
			end
		end
	end
	return out
end

-- ---------- 저장 ----------
function Daily.pack(d)
	local out = {}
	for region, st in d do
		local tasks = {}
		for i, t in st.tasks do
			tasks[i] = { scene = t.scene, mob = t.mob, n = t.n, have = t.have, st = t.st }
		end
		out[region] = { day = st.day, tasks = tasks, bonus = st.bonus }
	end
	return out
end

-- 저장된 것을 되살린다: 꼴이 맞지 않는 지역의 것은 버린다(게시판에 가면 오늘의 의뢰를 새로 받는다 — 잃는 것은 그날의 진행뿐이다)
function Daily.unpack(data: any)
	local out = {}
	if typeof(data) ~= "table" then
		return out
	end
	for region in DATA.boards do
		local st = data[region]
		if typeof(st) == "table" and whole(st.day, 0, 1e7) and typeof(st.tasks) == "table" then
			local tasks, fine = {}, true
			for i = 1, DATA.perDay do
				local t = st.tasks[i]
				if typeof(t) == "table" and entry(region, t.scene, t.mob) and whole(t.n, 1, 9999) and whole(t.have, 0, t.n) and whole(t.st, Daily.OPEN, Daily.DONE) then
					tasks[i] = { scene = t.scene, mob = t.mob, n = t.n, have = t.have, st = t.st }
				else
					fine = false
				end
			end
			if fine then
				out[region] = { day = st.day, tasks = tasks, bonus = st.bonus == true }
			end
		end
	end
	return out
end

return Daily

end
MODULES['ReplicatedStorage/shared/lune/sim/gift'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 보상 꾸러미 { money = 달돈, dust = 달가루, potion = 그 캐릭터의 레벨에 쓰는 물약(병), scroll = 귀환 주문서(장) } 를 캐릭터에게 준다 — 출석(sim/attend.luau) · 업적(sim/achieve.luau)이 같이 쓴다(2026-10-15).
--  가방에 다 들어가지 않으면 하나도 주지 않는다(받지 못한 것은 그대로 남아 다음에 다시 받는다).
local Items = require(script.Parent.items)
local Bag = require(script.Parent.bag)
local Format = require(script.Parent.Parent.ui.format)

local Gift = {}

Gift.SCROLL = "scroll_return"

-- 꾸러미의 물건들 { { id, n } } — 그 캐릭터의 레벨로 물약을 고른다
function Gift.items(h, r): { { any } }
	local out = {}
	if (r.potion or 0) > 0 then
		table.insert(out, { Items.potionFor(h.level).id, r.potion })
	end
	if (r.scroll or 0) > 0 then
		table.insert(out, { Gift.SCROLL, r.scroll })
	end
	-- 아이템 { [id] = 수 }(2026-10-16 — 호감도 · 모험의 서의 선물). 이름 차례로(늘 같은 차례)
	if typeof(r.items) == "table" then
		local ids = {}
		for id, n in r.items do
			if typeof(n) == "number" and n > 0 then
				table.insert(ids, id)
			end
		end
		table.sort(ids)
		for _, id in ids do
			table.insert(out, { id, r.items[id] })
		end
	end
	return out
end

-- 준다. 다 들어가지 않으면 (nil, 까닭)
function Gift.give(h, r): (boolean?, string?)
	local given = {}
	for _, it in Gift.items(h, r) do
		local ok, why = Bag.give(h, it[1], it[2])
		if not ok then
			for _, back in given do
				Bag.take(h, back[1], back[2]) -- 앞에서 넣은 것을 되돌린다(하나도 주지 않는다)
			end
			return nil, why
		end
		table.insert(given, it)
	end
	h.money += r.money or 0
	h.dust += r.dust or 0
	return true
end

-- 꾸러미를 글로: 「달가루 30 · 귀환 주문서 3장」 (words = 그 창의 글 — money · dust · potion · scroll)
function Gift.text(r, words): string
	local parts = {}
	for _, k in { "money", "dust", "potion", "scroll" } do
		if (r[k] or 0) > 0 then
			table.insert(parts, Format.fill(words[k], { n = Format.short(r[k]) }))
		end
	end
	if typeof(r.items) == "table" then -- 아이템: 「들꽃 다발 3」
		local ids = {}
		for id in r.items do
			table.insert(ids, id)
		end
		table.sort(ids)
		for _, id in ids do
			local g = Items.goods(id)
			if g then
				table.insert(parts, ("%s %d"):format(g.name, r.items[id]))
			end
		end
	end
	return table.concat(parts, " · ")
end

-- 꾸러미의 첫 그림(작은 그림의 이름)과 수 — 칸에 그릴 것
function Gift.icon(r): (string, number)
	if (r.dust or 0) > 0 then
		return "dust", r.dust
	elseif (r.money or 0) > 0 then
		return "coin", r.money
	elseif (r.scroll or 0) > 0 then
		return "scroll", r.scroll
	end
	return "potion_s", r.potion or 0
end

return Gift

end
MODULES['ReplicatedStorage/shared/lune/sim/hero'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 캐릭터 한 명의 상태와 성장 셈 — 체력 · 경험치와 레벨업 · 능력치 · 스킬 레벨 · 물약 · 쓰러짐 · 저장 꼴. 화면 · 네트워크와 상관없는 셈만 한다(서버가 쓴다).
--  수치는 config/numbers.luau(숫자 뼈대), data/combat.generated.luau(싸움의 기본 수치), data/classes.generated.luau(직업과 스킬 목록)에서 온다.
local N = require(script.Parent.Parent.config.numbers)
local COMBAT = require(script.Parent.Parent.data["combat.generated"])
local CLASSES = require(script.Parent.Parent.data["classes.generated"])
local Items = require(script.Parent.items)
local Bag = require(script.Parent.bag)
local Quests = require(script.Parent.quests)
local Daily = require(script.Parent.daily)
local Bond = require(script.Parent.bond)
local Rift = require(script.Parent.rift)
local Tutorial = require(script.Parent.tutorial)
local Cash = require(script.Parent.cash) -- 유료 상품(경험치 쿠폰의 배율 · 2026-10-20)
local Kit = require(script.Parent.kit) -- 1차의 온오프 사출기 · 핵심 장치 · 패시브
local Buffs = require(script.Parent.buffs) -- 2~4차의 버프
local Passives = require(script.Parent.passives) -- 2~4차의 패시브
local Quick = require(script.Parent.Parent.ui.quick)
local RULES = COMBAT.rules
local STATS = N.data.STATS
local STAT_IDS = { "str", "dex", "int", "luk", "hp" }
local SAVE_VERSION = 1

local Hero = {}
Hero.STAT_IDS = STAT_IDS

-- 직업의 스킬 정의(이름 · 갈래 · 마스터 레벨). 지금은 1차만 있다.
-- 직업의 모든 차수의 스킬(1~4차 + 공용): [직업][스킬] = { def, job }
local ALL = {}
for class, c in CLASSES.classes do
	local map = {}
	for _, t in c.tiers do
		for _, s in t.skills do
			map[s.id] = { def = s, job = t.job }
		end
	end
	ALL[class] = map
end

local function skillDef(class: string, id: string)
	local e = ALL[class] and ALL[class][id]
	return if e then e.def else nil
end
Hero.skillDef = skillDef

-- 그 스킬의 차수(없는 스킬이면 nil)
function Hero.skillJob(class: string, id: string): number?
	local e = ALL[class] and ALL[class][id]
	return if e then e.job else nil
end

-- 그 스킬이 게임에 들어와 있는가(효과가 있는가 — COMBAT.ready: 기술 · 1차의 사출기 · 장치 · 패시브 · 수치가 있는 버프 · 사출기 강화 · 설치 · 소환).
--  아직 없는 스킬에는 포인트가 찍히지 않고, 처음부터 주는 기술로도 주지 않는다 — 찍히는데 효과가 없는 일이 없게(사용자 2026-10-08: 1차의 사출기 · 장치가 그랬다)
local READY = COMBAT.ready
function Hero.ready(id: any): boolean
	return READY[id] == true
end

-- 그 레벨에 닿을 수 있는 차수(레벨만 본 것). 실제 차수는 캐릭터가 갖고 있다(h.job) — 전직 퀘스트를 돌려줘야 오른다(2026-10-10).
--  전직 퀘스트가 아직 없는 차수(지금은 3 · 4차 — 그 지역을 다듬을 때 만든다)는 레벨만 되면 저절로 오른다
function Hero.jobAt(level: number): number
	local job = 1
	for _, j in CLASSES.jobs do
		if j.lv <= level then
			job = math.max(job, j.job)
		end
	end
	return job
end

-- 처음부터 주는 기술(사냥기 · 보스기 · 이동기)을 레벨 1로 — 그 차수까지의 것 모두(게임에 들어와 있는 것만)
local function grants(class: string, job: number?)
	local out = {}
	job = job or 1
	for _, t in CLASSES.classes[class].tiers do
		if t.job <= job then
			for _, s in t.skills do
				if READY[s.id] and table.find(CLASSES.skillRule.start, s.type) then
					out[s.id] = 1
				end
			end
		end
	end
	return out
end

-- 그 직업이 그 차수의 스킬을 모두 마스터하는 데 드는 스킬 포인트(처음부터 주는 레벨 1은 뺀다. 아직 게임에 없는 스킬의 것도 센다 — 그 스킬이 열리면 거기에 쓴다)
--  그 차수 동안 받는 포인트는 이것을 넘지 않는다: 스킬을 다 찍으면 남는 포인트가 없다.
--  사용자 2026-10-11: "스킬 전부 마스터했는데 왜 1차에 남는 스킬포인트가 12 가있는건지?" — 레벨업마다 3점씩 1차 동안 84점을 받는데 다 찍는 데는 72점이 들었다(2차 +2 · 3차 +22~27 · 4차 +4~14점씩 남았다)
local needOf: { [string]: number } = {}
local function spNeed(class: string, job: number): number
	local key = class .. ":" .. job
	local n = needOf[key]
	if n == nil then
		n = 0
		for _, t in CLASSES.classes[class].tiers do
			if t.job == job then
				for _, s in t.skills do
					n += s.max - (if READY[s.id] and table.find(CLASSES.skillRule.start, s.type) then 1 else 0)
				end
			end
		end
		needOf[key] = n
	end
	return n
end
Hero.spNeed = spNeed

-- 그 차수 동안 받은 스킬 포인트. 받은 SP는 그때의 차수 스킬에만 쓴다(설계 basics.js의 SPRULE) — 2차로 전직하면 그 뒤로 받는 SP는 2차 스킬에 쓰고, 1차에서 남긴 SP는 1차 스킬에 계속 쓴다.
--  class를 주면 그 직업이 그 차수에 드는 만큼까지만 센다(다 받았으면 그 차수의 남은 레벨에서는 더 받지 않는다). 안 주면 레벨업마다 받는 양을 그대로 더한다
local function spEarnedIn(level: number, job: number, class: string?): number
	local j = CLASSES.jobs[job]
	local n = 0
	if j then
		for L = math.max(2, j.lv), math.min(level, j["until"]) do
			n += N.spAt(L)
		end
	end
	return if class then math.min(n, spNeed(class, job)) else n
end
Hero.spEarnedIn = spEarnedIn

-- 그 레벨까지 받은 스킬 포인트(class를 주면 차수마다 그 직업이 드는 만큼까지)
local function spEarned(level: number, class: string?): number
	local n = 0
	if class then
		for _, j in CLASSES.jobs do
			n += spEarnedIn(level, j.job, class)
		end
	else
		for L = 2, level do
			n += N.spAt(L)
		end
	end
	return n
end
Hero.spEarned = spEarned

-- 그 레벨이 될 때 그 직업이 받는 스킬 포인트: 보통은 N.spAt(L) — 그 차수에 드는 만큼을 다 받았으면 0(마지막에는 모자란 만큼만)
function Hero.spGain(class: string, level: number): number
	return spEarned(level, class) - spEarned(level - 1, class)
end

-- 그 차수의 스킬에 쓴 포인트 · 남은 포인트
local function spSpentIn(class: string, mine: number, skills, job: number): number
	local base = grants(class, mine) -- mine = 그 캐릭터의 차수
	local n = 0
	for id, lv in skills do
		local e = ALL[class][id]
		if e and e.job == job then
			n += lv - (base[id] or 0)
		end
	end
	return n
end
function Hero.spLeft(h, job: number): number
	return spEarnedIn(h.level, job, h.class) - spSpentIn(h.class, h.job, h.skills, job)
end

-- ---------- 스펙(2026-10-15 — 공방 numbers.js 2-1: 메이플의 스탯 공격력 방식) ----------
--  사용자 2026-10-15: "어디는 전투력 어디는 공격력 강화하면 뭐가오르는건지 하나도 직관적이지가 않아요 … 데미지가 어떤 계산식으로 적용되는지 … 싹다 다시"
--  스탯 공격력 = (주스탯 x 4 + 부스탯) x 공격력 x (1 + 공격력%) / 100 x (1 + 데미지%) x (1 + 최종 데미지%)
--   · 주스탯 · 부스탯(그리고 화면의 힘 · 민첩 · 지능 · 운) = 처음 4 + 찍은 점수 + 장비의 올스탯 · 공격력 = 무기의 공격력(별까지) · 방어력 = 방어구의 합
--   · 공격력% = 패시브(Passives.atkPct) x 리퍼의 영혼(Kit.attack) · 데미지% = 버프(Buffs.dmg) · 최종 데미지 = 패시브(Passives.finalMul)
--  피해 = 스탯 공격력 x 스킬 % x (0.9 ~ 1.1) x (맞는 상대면 1.5) x (크리티컬이면 크리티컬 데미지) — 셈은 sim/room.luau · caster.luau(Hero.powerRaw x 영혼 x 버프 x 패시브)
function Hero.spec(h)
	local pair = STATS.classes[h.class]
	local gear = Items.sum(Bag.worn(h))
	local stats = {}
	for id, pts in h.stats do
		stats[id] = STATS.base + pts + (if id == "hp" then 0 else gear.stat)
	end
	return { main = stats[pair[1]], sub = stats[pair[2]], atk = gear.atk, def = gear.def, stats = stats, gearStat = gear.stat }
end
-- 곱하기 전의 스탯 공격력 = (주스탯 x 4 + 부스탯) x 공격력 / 100
function Hero.attackBase(h): number
	local sp = Hero.spec(h)
	return N.statAtk(sp.main, sp.sub, sp.atk)
end
-- 크리티컬의 기댓값(1 + 확률 x (데미지 배수 - 1)) — 전투력에 넣는다
local function critExp(h): number
	local chance, mul = Passives.crit(h, false)
	return 1 + chance / 100 * (mul - 1)
end
-- 전투력 = 버프를 뺀 스탯 공격력 x 크리티컬의 기댓값 — 한 숫자로 견주는 힘(명예의 전당 · 「장착하면 전투력 +n」). 영혼 · 피의 계약처럼 싸우는 동안 변하는 것은 넣지 않는다
--  sp = 이미 셈한 Hero.spec(내 상태를 보낼 때 한 번만 셈한다)
function Hero.power(h, sp: any?): number
	local s = sp or Hero.spec(h)
	return math.floor(N.statAtk(s.main, s.sub, s.atk) * (1 + Passives.atkPct(h)) * (1 + Passives.sumOf(h, "final")) * critExp(h) + 0.5)
end
-- 피해의 셈이 쓰는 값(= 곱하기 전의 스탯 공격력). 그 위에 영혼(Kit.attack) · 버프(Buffs.dmg) · 패시브(Passives.atk)를 곱한다
--  관리자의 시험용 피해 배율(h.dmgBoost — 저장하지 않는다)은 여기에만 곱한다: 보이는 전투력과 순위(Hero.power)는 그대로다
function Hero.powerRaw(h): number
	return Hero.attackBase(h) * (h.dmgBoost or 1)
end
-- 아이템 상세의 「장착하면 전투력 +n」을 셈하는 재료(화면에 보낸다 — shared/lune/ui/itemInfo.luau): 주스탯 · 부스탯 · 공격력 · k(전투력 = statAtk x k)
function Hero.specView(h, spec: any?)
	local sp = spec or Hero.spec(h)
	return { main = sp.main, sub = sp.sub, atk = sp.atk, k = (1 + Passives.atkPct(h)) * (1 + Passives.sumOf(h, "final")) * critExp(h) }
end

-- 끼고 있는 방어구가 줄여 주는 피해 %(그 레벨의 몬스터에게 맞을 때)
function Hero.cut(h, mobLv: number): number
	return Items.cut(Bag.worn(h), mobLv)
end

-- 체력 상한을 다시 셈한다(레벨 · 체력에 찍은 점수)
-- 최대 체력: 직업 · 레벨 · 찍은 체력에 패시브(액시온의 묵직한 몸)를 곱한다
local function maxHpOf(h): number
	return math.floor(N.hpOf(h.class, h.level, h.stats.hp) * Kit.maxHp(h) + 0.5)
end
Hero.maxHpOf = maxHpOf

function Hero.recalc(h)
	h.maxHp = maxHpOf(h)
	h.hp = math.min(h.hp, h.maxHp)
end

-- 새 캐릭터(Lv.1)
function Hero.new(id: any, class: string)
	assert(CLASSES.classes[class], "없는 직업 " .. tostring(class))
	local h = {
		id = id,
		class = class,
		level = 1,
		job = 1, -- 차수(1~4). 전직 퀘스트를 돌려주면 오른다(Hero.advance)
		xp = 0,
		ap = 0, -- 아직 찍지 않은 능력치 점수
		stats = { str = 0, dex = 0, int = 0, luk = 0, hp = 0 }, -- 찍은 점수(처음 값 4는 빼고)
		sp = 0, -- 아직 쓰지 않은 스킬 포인트
		skills = grants(class), -- [스킬 id] = 레벨
		auto = false, -- true면 레벨업 때 능력치 · 스킬을 저절로 찍는다. 기본은 직접 찍는다(사용자 결정) — 창의 「자동으로 찍기」 · 「추천대로 찍기」는 한 번씩 누르는 단추다
		keys = {}, -- 바꾼 키 { [하는 일] = 키 이름 } — 기본과 다른 것만(클라이언트가 보낸 것을 꼴만 보고 담아 둔다)
		slots = Quick.start(CLASSES.classes[class].skills), -- 퀵슬롯: 칸마다 스킬 · 소비 아이템의 이름표 · false(빈 칸) — shared/lune/ui/quick.luau
		-- 스마트폰의 단추 배치: 같은 열두 칸이지만 PC의 것과 따로 둔다 — PC에서는 손에 익은 키(E · D …)에, 폰에서는 큰 단추에 놓고 싶은 것이 서로 다르다(2026-10-08).
		--  한쪽에서 바꿔도 다른 쪽은 그대로다. 처음 차림은 같다(물약 · 사냥기 · 보스기 · 이동기)
		tslots = Quick.touchStart(CLASSES.classes[class].skills), -- 스마트폰의 단추 배치: 단추가 없는 칸 1의 물약은 칸 5로(ui/quick.luau의 touchFix)
		money = 0,
		forged = false, -- 강화를 해 본 적이 있는가(첫 강화는 달가루 없이 반드시 붙는다 — sim/bag.luau의 Bag.enhance)
		resets = 0, -- 공짜로 스킬을 되돌릴 수 있는 횟수(전직할 때마다 한 번 — 쌓이지 않는다. Hero.freeReset)
		last = nil :: string?, -- 마지막으로 있던 장면(다시 들어오면 거기서 시작한다 — 2026-10-16 밤, 사용자: "게임을 시작하면 항상 초승달마을에서 시작합니다". world.luau의 resumeScene)
		home = nil :: string?, -- 마지막으로 들른 마을 · 작은 마을(쓰러졌을 때 돌아가는 곳 — 없으면 시작 마을. 어느 장면이 마을인가는 scenes.generated의 homes · 서버가 본다)
		hp = 0,
		maxHp = 0,
		alive = true,
		x = 0,
		y = 0,
		dir = 1,
		invuln = 0, -- 맞은 뒤 무적이 남은 시간(초)
		weak = 0, -- 쓰러진 뒤 벌칙이 남은 시간(초)
		expLeft = 0, -- 경험치 쿠폰(유료)이 남은 시간(초) — 게임 안에 있는 동안만 준다(Hero.tick)
		potionWait = 0,
		revive = 0, -- 쓰러진 뒤 일어나기까지 남은 시간(초)
	}
	Kit.init(h) -- 사출기 · 장치의 그때그때의 상태(h.kit)
	Buffs.init(h) -- 걸린 버프 · 다시 쓰기(h.buffs · h.cds — 저장하지 않는다)
	Passives.init(h) -- 패시브의 그때그때의 상태(h.pass — 저장하지 않는다)
	Bag.init(h) -- 처음 받는 차림(무기와 방어구 네 부위)을 입고 있다
	Bag.give(h, Items.potionFor(1).id, RULES.startPotions) -- 처음 받는 물약(가방의 소비 탭 첫 칸)
	h.quests = {} -- 퀘스트의 상태(sim/quests.luau의 book)
	h.daily = {} -- 일일 의뢰의 상태(sim/daily.luau — 지역마다 그날의 의뢰들)
	h.rift = Rift.new() -- 수정 틈 토벌의 하루 보상 횟수(sim/rift.luau — 2026-10-16)
	h.bond = Bond.new() -- 2편의 만나면 열림 · 모험의 서 · 달조각 · 숨은 이야기(sim/bond.luau — 2026-10-16)
	h.tut = Tutorial.new() -- 튜토리얼 「달빛 꿈」(sim/tutorial.luau): 새 캐릭터는 꿈에서 시작한다(2026-10-14). 되살린 · 자란 캐릭터는 마친 것으로 고쳐 둔다
	h.cine = {} -- 본 퀘스트 연출(장면) { [id] = true } — 한 캐릭터에 한 번만 튼다(2026-10-15 — shared/lune/cine.luau)
	h.inCine = false -- 장면이 도는 중(맞지 않는다 — 저장하지 않는다. 서버가 90초 뒤에 저절로 푼다)
	h.played = 0 -- 이 캐릭터로 논 시간(초 · 저장한다 — 서버가 센다. 로블록스 분석의 LevelUp 값 · 2026-10-15)
	Quests.start(h.quests, h.level) -- (저절로 받는 퀘스트는 이제 없다 — 첫 퀘스트도 사제에게 말을 걸어 받는다)
	h.maxHp = maxHpOf(h)
	h.hp = h.maxHp
	return h
end

function Hero.xpNeed(h): number
	return N.xpNeed(h.level)
end

-- ---------- 능력치 ----------
-- 능력치에 n점을 찍는다. 찍었으면 true.
function Hero.addStat(h, stat: string, n: number): boolean
	if not table.find(STAT_IDS, stat) or n ~= math.floor(n) or n < 1 or n > h.ap then
		return false
	end
	h.stats[stat] += n
	h.ap -= n
	Hero.recalc(h)
	return true
end

-- 남은 점수를 모두 주 능력치에(「자동으로 찍기」)
function Hero.autoStat(h): number
	local n = h.ap
	if n > 0 then
		Hero.addStat(h, STATS.classes[h.class][1], n)
	end
	return n
end

-- ---------- 스킬 ----------
function Hero.skillLevel(h, id: string): number
	return h.skills[id] or 0
end

-- 스킬 레벨에 따른 세기(레벨 1에서 floor, 마스터에서 1). 배우지 않았으면 0.
function Hero.skillScale(lv: number, max: number): number
	if lv <= 0 then
		return 0
	end
	local floor = CLASSES.skillRule.floor
	return floor + (1 - floor) * (if max > 1 then (lv - 1) / (max - 1) else 1)
end
function Hero.scale(h, id: string): number
	local def = skillDef(h.class, id)
	return if def then Hero.skillScale(Hero.skillLevel(h, id), def.max) else 0
end

-- 스킬 포인트 1점으로 스킬을 한 레벨 올린다. 올렸으면 true.
--  게임에 들어와 있는 스킬만 · 열린 차수의 스킬만 · 그 차수의 포인트로 · 먼저 배워야 하는 스킬(needs — 사출기 강화 → 사출기)을 1이라도 찍었을 때
--  (먼저 배워야 하는 스킬이 게임에 아직 없으면 그 조건은 보지 않는다 — 만월은 깊은 호흡이 들어오기 전에도 배운다)
function Hero.skillUp(h, id: string): boolean
	local e = ALL[h.class][id]
	if not e or not READY[id] then
		return false
	end
	local def = e.def
	if e.job > h.job or Hero.spLeft(h, e.job) < 1 or Hero.skillLevel(h, id) >= def.max then
		return false
	end
	if def.needs and READY[def.needs] and Hero.skillLevel(h, def.needs) < 1 then
		return false
	end
	h.skills[id] = Hero.skillLevel(h, id) + 1
	h.sp -= 1
	if Kit.skill(id) then
		Hero.recalc(h) -- 패시브가 최대 체력을 바꾼다(묵직한 몸)
	end
	return true
end

-- 남은 스킬 포인트를 추천 순서로 모두 쓴다(「추천대로 찍기」): 사냥기 → 보스기 → 핵심 장치 → 버프 → 나머지
--  차수마다 그 차수의 포인트를 쓴다. 먼저 배워야 하는 스킬 때문에 건너뛴 것은 한 바퀴 더 돌아 찍는다
local PRIORITY = { mob = 1, boss = 2, core = 3, buff = 4 }
function Hero.autoSkill(h): number
	local spent = 0
	for _, t in CLASSES.classes[h.class].tiers do
		if t.job > h.job then
			continue
		end
		local list = table.clone(t.skills)
		local index = {}
		for i, s in list do
			index[s.id] = i
		end
		table.sort(list, function(a, b)
			local pa, pb = PRIORITY[a.type] or 9, PRIORITY[b.type] or 9
			if pa ~= pb then
				return pa < pb
			end
			return index[a.id] < index[b.id]
		end)
		for _ = 1, 2 do
			for _, s in list do
				while Hero.skillUp(h, s.id) do
					spent += 1
				end
			end
		end
	end
	return spent
end

-- 새 차수가 열렸으면 그 차수의 처음부터 주는 기술(사냥기 · 보스기)을 레벨 1로 준다
function Hero.grantJob(h)
	for id in grants(h.class, h.job) do
		if (h.skills[id] or 0) < 1 then
			h.skills[id] = 1
		end
	end
end

-- 전직 퀘스트가 없는 차수는 레벨만 되면 오른다(앞 차수를 건너뛰지는 않는다). 올랐으면 true
local function autoJobs(h): boolean
	local rose = false
	while true do
		local nextJob = CLASSES.jobs[h.job + 1]
		if not nextJob or h.level < nextJob.lv or Quests.jobQuest(nextJob.job) then
			break
		end
		h.job = nextJob.job
		rose = true
	end
	return rose
end

-- 새 차수의 사냥기 · 보스기를 앞 차수의 것이 놓여 있던 칸에 넣는다(설계 basics.js의 JOBFLOW: "사냥기와 보스기가 윗차수의 것으로 바뀌어 스킬 칸에 들어온다")
local function slotJob(h, job: number)
	for _, t in CLASSES.classes[h.class].tiers do
		if t.job == job then
			for _, s in t.skills do
				if s.replaces and (h.skills[s.id] or 0) > 0 then
					for _, slots in { h.slots, h.tslots } do
						local i = Quick.find(slots, s.replaces)
						if i and not Quick.find(slots, s.id) then
							slots[i] = s.id
						end
					end
				end
			end
		end
	end
end

-- 그 레벨이 닿을 수 있는 차수까지 전직한 것으로 친다 — 전직 퀘스트도 끝낸 것으로 적는다(확인용 캐릭터 LuneGuest = "직업:레벨" · 자동 검사가 쓴다. 진짜 캐릭터는 퀘스트로만 오른다)
function Hero.advanceAll(h)
	while h.job < Hero.jobAt(h.level) and Hero.advance(h, h.job + 1) do
	end
	Quests.jobsDone(h.quests, h.job)
end

-- 전직한다: 바로 다음 차수로, 그 차수의 레벨이 됐을 때만. 했으면 true
function Hero.advance(h, job: any): boolean
	local j = if typeof(job) == "number" then CLASSES.jobs[job] else nil
	if not j or job ~= h.job + 1 or h.level < j.lv then
		return false
	end
	local from = h.job
	h.job = job
	h.resets = 1 -- 전직하면 스킬 포인트 초기화 한 번이 공짜(설계 basics.js의 SPRULE: "전직할 때마다 한 번은 공짜로 되돌릴 수 있다" — 안 쓰고 다음 전직을 해도 한 번이다)
	autoJobs(h)
	Hero.grantJob(h)
	for at = from + 1, h.job do
		slotJob(h, at)
	end
	if h.auto then
		Hero.autoSkill(h)
	end
	return true
end

-- ---------- 관리자(어드민)의 시험용 — 서버의 관리자 명령(server/lune/modules/world.luau의 onAdmin)만 부른다 ----------
-- 레벨을 그 값으로 맞춘다(올리기도 내리기도): 능력치 · 스킬을 처음으로 되돌리고 그 레벨까지의 점수를 새로 준다(찍지 않은 채로). 가방 · 장비 · 달돈 · 퀘스트 · 키는 그대로.
--  차수: job을 주면 그 차수로(그 레벨이 닿을 수 있는 데까지), 안 주면 지금의 차수를 지킨다(레벨이 모자라면 낮아진다)
function Hero.setLevel(h, level: number, job: number?)
	level = math.clamp(math.floor(level), 1, N.MAX_LEVEL)
	local want = math.clamp(math.floor(job or h.job), 1, Hero.jobAt(level))
	h.level, h.xp = level, 0
	h.stats = { str = 0, dex = 0, int = 0, luk = 0, hp = 0 }
	h.ap = N.apAt(level)
	h.job = 1
	h.skills = grants(h.class)
	h.sp = spEarned(level, h.class)
	while h.job < want and Hero.advance(h, h.job + 1) do
	end
	Quests.jobsDone(h.quests, h.job)
	-- 지금의 차수보다 위의 전직 퀘스트는 받기 전으로 되돌린다(차수를 내렸을 때 — 그 레벨이 되면 다시 「달이 부른다」로 받는다)
	for j = h.job + 1, #CLASSES.jobs do
		local def = Quests.jobQuest(j)
		if def then
			h.quests[def.id] = nil
		end
	end
	Quests.start(h.quests, h.level)
	-- 칸에 놓인 것 가운데 이제 배우지 않은 스킬은 뺀다
	for _, slots in { h.slots, h.tslots } do
		for i, id in slots do
			if typeof(id) == "string" and not Quick.item(id) and (h.skills[id] or 0) < 1 then
				slots[i] = false
			end
		end
	end
	h.maxHp = maxHpOf(h)
	h.hp = h.maxHp
end

-- 열린 차수의 스킬(게임에 들어와 있는 것)을 모두 마스터한다 · 스킬을 처음(차수가 주는 레벨 1)으로 되돌린다 · 찍은 능력치를 모두 되돌려 받는다
function Hero.maxSkills(h)
	for _, tier in CLASSES.classes[h.class].tiers do
		if tier.job <= h.job then
			for _, sk in tier.skills do
				if Hero.ready(sk.id) then
					h.skills[sk.id] = sk.max
				end
			end
		end
	end
	h.maxHp = maxHpOf(h)
end
-- 전직하며 받은 공짜 초기화를 쓴다: 찍은 스킬을 모두 되돌려(처음부터 주는 레벨 1만 남는다) 포인트를 다시 쓴다. 됐으면 true
function Hero.freeReset(h): boolean
	if (h.resets or 0) < 1 then
		return false
	end
	h.resets -= 1
	Hero.resetSkills(h)
	return true
end

function Hero.resetSkills(h)
	h.skills = grants(h.class, h.job)
	h.sp = spEarned(h.level, h.class) -- 찍은 것이 없다: 받은 포인트가 그대로 남는다
	for _, slots in { h.slots, h.tslots } do
		for i, id in slots do
			if typeof(id) == "string" and not Quick.item(id) and (h.skills[id] or 0) < 1 then
				slots[i] = false
			end
		end
	end
	h.maxHp = maxHpOf(h)
	h.hp = math.min(h.hp, h.maxHp)
end
function Hero.resetStats(h)
	for stat, n in h.stats do
		h.ap += n
		h.stats[stat] = 0
	end
	Hero.recalc(h)
end

-- ---------- 경험치 ----------
-- 경험치를 얻는다. 오른 레벨 수를 돌려준다.
function Hero.gainXp(h, amount: number): number
	local ups = 0
	if h.level >= N.MAX_LEVEL then
		return 0
	end
	h.xp += amount * (h.xpBoost or 1) -- 관리자의 시험용 경험치 배율(저장하지 않는다 — 서버의 관리자 명령만 정한다)
	while h.level < N.MAX_LEVEL and h.xp >= N.xpNeed(h.level) do
		h.xp -= N.xpNeed(h.level)
		h.level += 1
		h.ap += STATS.perLevel
		h.sp += Hero.spGain(h.class, h.level) -- 그 차수의 스킬을 다 찍을 만큼 받았으면 더 받지 않는다
		ups += 1
	end
	if h.level >= N.MAX_LEVEL then
		h.xp = 0
	end
	if ups > 0 then
		local from = h.job
		autoJobs(h)
		Hero.grantJob(h)
		for at = from + 1, h.job do
			slotJob(h, at)
		end
		Quests.start(h.quests, h.level) -- (저절로 받는 퀘스트는 이제 없다 — 전직 퀘스트는 레벨이 되면 사제에게 가서 받는다. 화면이 "달이 부른다"로 알린다)
		if h.auto then
			Hero.autoStat(h)
			Hero.autoSkill(h)
		end
		h.maxHp = maxHpOf(h)
		if h.alive ~= false then
			h.hp = h.maxHp -- 레벨이 오르면 체력이 다 찬다(쓰러져 있으면 그대로 — 파티원이 잡은 몫으로 오를 때 · 2026-10-18 검토)
		end
	end
	return ups
end

-- 몬스터를 잡았을 때의 경험치(레벨 차이 · 쓰러진 뒤의 벌칙을 넣은 값)
function Hero.killXp(h, mobLevel: number, mobHpMul: number): number
	local xp = N.mobXp(mobLevel) * mobHpMul * N.xpRate(h.level, mobLevel) / 100
	if h.weak > 0 then
		xp *= 1 - N.data.BODY.death.cut / 100
	end
	xp *= Cash.expMul(h) -- 경험치 쿠폰(사냥 경험치만 — 2026-10-20 사용자 「경험치 쿠폰 판매해도 됩니다」)
	return math.max(1, math.floor(xp + 0.5))
end

-- ---------- 맞기 · 물약 · 쓰러짐 ----------
-- 맞는다. 실제로 들어간 피해를 돌려준다(무적 중이거나 쓰러져 있으면 0).
function Hero.hurt(h, amount: number): number
	if not h.alive or h.invuln > 0 or h.god or h.inCine then -- god = 관리자의 시험용 무적(저장하지 않는다) · inCine = 퀘스트 연출이 도는 중
		return 0
	end
	local dmg = math.max(1, math.floor(amount + 0.5))
	h.hp = math.max(0, h.hp - dmg)
	h.invuln = RULES.invuln
	if h.hp <= 0 then
		h.alive = false
		h.revive = RULES.reviveWait -- 이 시간이 지나야 마을로 돌아갈 수 있다(쓰러지는 동작 · 비석이 서는 동안)
		h.weakWas = h.weak -- 소생으로 그 자리에서 일어나면 이번 벌칙은 없던 일이 된다
		-- 벌칙은 숫자 뼈대대로 정해 둔 레벨부터(그 전에는 벌칙이 없다)
		if h.level >= N.data.BODY.death.free then
			h.weak = N.deathMinutes(h.level) * 60
		end
	end
	return dmg
end

-- 가방에 든 물약의 수(모든 단의 합)
function Hero.potions(h): number
	local n = 0
	for _, g in Items.data.GOODS do
		if g.kind == "potion" then
			n += Bag.count(h, g.id)
		end
	end
	return n
end

-- 지금 마실 수 있는 가장 좋은 물약(가방에 있고 내 레벨에 쓸 수 있는 것 — 없으면 nil)
function Hero.bestPotion(h)
	local best = nil
	for _, g in Items.data.GOODS do
		if g.kind == "potion" and g.lv <= h.level and Bag.count(h, g.id) > 0 and (not best or g.heal > best.heal) then
			best = g
		end
	end
	return best
end

-- 소비 아이템을 쓴다(지금은 물약뿐): id = 그 아이템의 이름표(안 주면 지금 마실 수 있는 가장 좋은 물약). 회복한 양을 돌려준다(못 썼으면 nil과 까닭).
function Hero.drink(h, id: any): (number?, string?)
	local def = if id == nil then Hero.bestPotion(h) else Items.goods(id)
	if not def or def.kind ~= "potion" or Bag.count(h, def.id) <= 0 then
		return nil, "가진 물약이 없다"
	elseif h.level < def.lv then
		return nil, ("Lv.%d부터 쓸 수 있다"):format(def.lv)
	elseif not h.alive or h.potionWait > 0 or h.hp >= h.maxHp then
		return nil -- 쓰러졌다 · 아직 다시 쓸 수 없다 · 체력이 가득하다(까닭을 띄우지 않는다 — 키를 누르고 있을 때마다 뜨면 시끄럽다)
	end
	local heal = math.floor(h.maxHp * def.heal / 100 + 0.5)
	local before = h.hp
	h.hp = math.min(h.maxHp, h.hp + heal)
	Bag.take(h, def.id, 1)
	h.potionWait = N.data.BODY.cooldown.field
	return h.hp - before
end

-- 시간이 흐른다. 쓰러져 있다가 일어날 때가 되면 true를 돌려준다(일으키는 것은 부른 쪽이 한다).
function Hero.tick(h, dt: number): boolean
	h.invuln = math.max(0, h.invuln - dt)
	h.weak = math.max(0, h.weak - dt)
	h.expLeft = math.max(0, (h.expLeft or 0) - dt)
	h.potionWait = math.max(0, h.potionWait - dt)
	-- 쓰러져 있는 동안: 저절로 일어나지 않는다 — 그 자리에 비석이 서고, 마을로 돌아갈지는 그 사람이 정한다(사용자 2026-10-08:
	--  "죽으면 비석 세우고, 모달띄워서 마을로 갈거냐고 물어보는 딜레이를 넣읍시다"). 그 사이에 파티원이 소생으로 일으켜 줄 수 있다
	if not h.alive then
		h.revive = math.max(0, h.revive - dt)
	end
	return false
end

-- 쓰러진 사람이 마을로 돌아갈 수 있는가(쓰러지고 조금 지난 뒤부터)
function Hero.canReturn(h): boolean
	return not h.alive and h.revive <= 0
end

-- 맵에 들어섰다: 잠깐(RULES.arrive초) 피해를 받지 않는다 — 들어서자마자 맞지 않게(문 곁에도 몬스터가 있다. 공방 combat.js의 arrive)
-- 방(맵)마다 시계가 따로다(방의 time은 0에서 시작해 사람이 있을 때만 흐르고, 토벌 방은 들 때마다 새로 짓는다).
--  캐릭터에 적힌 방의 시각들을 새 방의 시계로 옮긴다 — delta = 새 방의 시각 − 옛 방의 시각(서버 world.luau의 place가 부른다 · 2026-10-18 검토:
--  옛 방의 시계가 앞서 있으면 리퍼의 도깨비불 · 무니의 수정 조각 · 리븐의 독이 새 방의 시계가 따라잡을 때까지 멈췄고, 거꾸로면 살라맨더의 연속이 끝나지 않았다)
local CLOCK_PASS = { "streakAt", "pressAt", "surge", "rekindle", "venom" }
function Hero.shiftClock(h, delta: number)
	if delta == 0 or delta ~= delta then
		return
	end
	if h.kit and typeof(h.kit.at) == "number" then
		h.kit.at += delta
	end
	if typeof(h.actUntil) == "number" then
		h.actUntil += delta
	end
	local p = h.pass
	if p then
		for _, k in CLOCK_PASS do
			if typeof(p[k]) == "number" then
				p[k] += delta
			end
		end
	end
end

function Hero.arrive(h)
	h.invuln = math.max(h.invuln, RULES.arrive)
end

-- 마을에서 일어난다(체력이 가득)
function Hero.revive(h)
	h.alive = true
	h.hp = h.maxHp
	h.invuln = 2
	h.revive = 0
	h.weakWas = nil
end

-- 소생을 받아 그 자리에서 일어난다: 최대 체력의 share만큼으로. 쓰러지며 받은 벌칙(약해짐)은 없던 일이 된다
function Hero.raise(h, share: number)
	h.alive = true
	h.hp = math.clamp(math.floor(h.maxHp * share + 0.5), 1, h.maxHp)
	h.invuln = 2
	h.revive = 0
	if h.weakWas ~= nil then
		h.weak = h.weakWas
	end
	h.weakWas = nil
end

-- ---------- 퀘스트 ----------
-- 모으는 일의 숫자를 가방에 맞춘다(가방에 든 수가 곧 숫자다). 바뀌었으면 true
function Hero.syncQuests(h): boolean
	return Quests.sync(h.quests, function(item)
		return Bag.count(h, item)
	end)
end

-- 퀘스트를 돌려주고 보상을 받는다. 돌려주는 것: 보상, 오른 레벨 수(안 됐으면 nil과 까닭)
--  모은 물건은 가방에서 빠진다. 보상의 물약(내 레벨에 쓸 수 있는 가장 좋은 물약)이 들어갈 칸이 없으면 돌려주지 못한다
Hero.SCROLL = "scroll_return" -- 귀환 주문서(퀘스트의 보상으로 주는 것)
function Hero.questDone(h, id: any)
	local def = Quests.def(id)
	local potion = Items.potionFor(h.level)
	if def and def.reward.potions > 0 and Quests.isReady(h.quests, id) and Bag.room(h, potion.id) < def.reward.potions then
		return nil, "가방의 소비 칸이 모자란다"
	end
	-- 보상의 귀환 주문서(첫머리의 퀘스트 — 사용자 2026-10-13: "완전 초반부 퀘스트에서 마을귀환주문서를 뿌려야합니다")가 들어갈 칸이 없으면 돌려주지 못한다
	if def and (def.reward.scrolls or 0) > 0 and Quests.isReady(h.quests, id) and Bag.room(h, Hero.SCROLL) < def.reward.scrolls then
		return nil, "가방의 소비 칸이 모자란다"
	end
	-- 전직 퀘스트는 바로 다음 차수일 때만 돌려준다(2026-10-18 검토 — 끝냈는데 전직이 되지 않는 일이 없게)
	if def and def.reward.job and Quests.isReady(h.quests, id) and def.reward.job ~= h.job + 1 then
		return nil, "앞의 전직을 먼저 마쳐야 한다"
	end
	-- 보상의 장비(전직할 때 받는 무기)가 들어갈 칸이 없으면 돌려주지 못한다
	if def and def.reward.gear and Quests.isReady(h.quests, id) and Bag.free(h) <= 0 then
		return nil, Bag.FULL
	end
	local reward, why = Quests.complete(h.quests, id)
	if not reward then
		return nil, why
	end
	for _, t in Quests.takes(id) do
		Bag.take(h, t.item, math.min(t.n, Bag.count(h, t.item)))
	end
	h.money += reward.money
	if reward.potions > 0 then
		Bag.give(h, potion.id, reward.potions)
	end
	if (reward.scrolls or 0) > 0 then
		Bag.give(h, Hero.SCROLL, reward.scrolls)
	end
	if reward.gear then
		Bag.add(h, Items.make(reward.gear.slot, reward.gear.stage, Items.NORMAL, h.class)) -- 보상의 장비는 내 직업의 것 · 성능은 보통
	end
	if reward.open == "tome" then
		h.bond.open = true -- 모험의 서가 열린다(「항구의 첫날」)
	end
	Hero.syncQuests(h) -- 같은 물건을 모으는 다른 퀘스트의 숫자
	if reward.job then
		Hero.advance(h, reward.job) -- 전직 퀘스트: 다음 차수가 열린다
	end
	local ups = Hero.gainXp(h, reward.xp)
	return reward, ups
end

-- 퀘스트를 그만둔다. 모으던 물건도 사라진다(다른 퀘스트가 같은 것을 모으고 있으면 남는다) — 다시 받으면 처음부터다
function Hero.questDrop(h, id: any): (boolean?, string?)
	local ok, why = Quests.drop(h.quests, id)
	if not ok then
		return nil, why
	end
	for _, t in Quests.takes(id) do
		local have = Bag.count(h, t.item)
		if have > 0 and not Quests.wants(h.quests, t.item) then
			Bag.take(h, t.item, have)
		end
	end
	Hero.syncQuests(h)
	return true
end

-- ---------- 키 설정 ----------
-- 바꾼 키의 표를 받아 둔다. 꼴이 맞는 것만 담는다(하는 일 이름 · 키 이름은 글자와 숫자, 마흔여덟 개까지). 담았으면 true.
-- lenient = 저장된 것을 읽을 때: 맞지 않는 짝만 버리고 나머지는 지킨다(2026-10-18 검토 — 전에는 짝 하나 때문에 키 설정 전체가 처음으로 돌아갔다)
local function cleanKeys(map: any, lenient: boolean?)
	if typeof(map) ~= "table" then
		return nil
	end
	local out, n = {}, 0
	for action, key in map do
		if typeof(action) ~= "string" or typeof(key) ~= "string" or #action > 40 or #key > 24 or not string.match(action, "^[%w:_]+$") or not string.match(key, "^%w+$") then
			if lenient then
				continue
			end
			return nil
		end
		n += 1
		if n > 48 then
			return nil
		end
		out[action] = key
	end
	return out
end

-- 퀵슬롯에 놓아도 되는 스킬인가: 이 직업이 키로 쓰는 기술(싸움 수치가 있는 것)이고 배운 것
function Hero.canSlot(h, id: string): boolean
	local goods = Items.goods(id)
	if goods then
		return goods.tab == "use" -- 소비 아이템은 가진 것이 없어도 놓아 둘 수 있다(다 써도 칸에 남는다 — 숫자가 0)
	end
	if Kit.isToggle(h, id) then
		return true -- 배운 온오프 사출기(칸의 키로 켜고 끈다)
	end
	if Buffs.learned(h, id) then
		return true -- 배운 버프(칸의 키로 건다)
	end
	local placed = COMBAT.placed[id]
	if placed and placed.who == h.class and (h.skills[id] or 0) > 0 then
		return true -- 배운 설치 · 소환
	end
	local cast = COMBAT.cast[id]
	if cast and cast.who == h.class and (h.skills[id] or 0) > 0 then
		return true -- 배운 2~4차의 쓰는 스킬
	end
	local def = COMBAT.skills[id]
	return def ~= nil and def.who == h.class and (h.skills[id] or 0) > 0
end

-- 퀵슬롯을 바꾼다(클라이언트가 보낸 칸들 — 꼴과 놓아도 되는 것인지를 본다). touch = 스마트폰의 단추 배치(tslots)를 바꾼다
function Hero.setSlots(h, list: any, touch: boolean?): boolean
	local slots = Quick.clean(list, function(id)
		return Hero.canSlot(h, id)
	end)
	if not slots then
		return false
	end
	if touch then
		h.tslots = Quick.touchFix(slots) -- 단추가 없는 칸(칸 1)에 놓인 것은 단추가 있는 빈 칸으로 — 전에 저장해 둔 배치도 들어올 때 이 길로 옮겨진다
	else
		h.slots = slots
	end
	return true
end

function Hero.setKeys(h, map: any): boolean
	local keys = cleanKeys(map)
	if not keys then
		return false
	end
	h.keys = keys
	return true
end

-- ---------- 저장 ----------
-- 저장할 꼴(숫자와 글만). 자리 · 체력 · 무적 같은 그때그때의 것은 넣지 않는다.
function Hero.pack(h)
	return {
		v = SAVE_VERSION,
		class = h.class,
		level = h.level,
		job = h.job,
		xp = h.xp,
		ap = h.ap,
		stats = table.clone(h.stats),
		sp = h.sp,
		skills = table.clone(h.skills),
		auto = h.auto,
		keys = table.clone(h.keys),
		slots = table.clone(h.slots),
		tslots = table.clone(h.tslots),
		kitOn = h.kit.on, -- 온오프 사출기를 켜 두었는가(다시 들어와도 그대로다)
		money = h.money,
		forged = h.forged == true,
		home = h.home or false,
		last = (if h.alive == false then h.home else h.last) or false, -- 쓰러진 채 나가면 다시 들어올 때 마을에서(그 자리에서 가득 찬 채로 살아나지 않게 — 2026-10-18 검토)
		resets = h.resets or 0,
		weak = math.floor(h.weak),
		expLeft = math.floor(h.expLeft or 0),
		bag = Bag.pack(h),
		quests = Quests.pack(h.quests),
		daily = Daily.pack(h.daily),
		bond = Bond.pack(h.bond),
		rift = Rift.pack(h.rift),
		tut = Tutorial.pack(h.tut),
		cine = Hero.cineList(h),
		played = math.floor(h.played or 0),
	}
end

-- 본 장면의 목록(저장 · 화면에 보내는 꼴 — 글의 배열)
function Hero.cineList(h): { string }
	local list = {}
	for id in h.cine do
		table.insert(list, id)
	end
	table.sort(list)
	return list
end

local function whole(v: any, min: number, max: number): boolean
	return typeof(v) == "number" and v == math.floor(v) and v >= min and v <= max
end

-- 저장된 것에서 캐릭터를 되살린다. 꼴이 이상하면 nil(새로 골라야 한다).
--  점수가 받은 것보다 많이 찍혀 있으면(식이 바뀌었거나 자료가 깨졌을 때) 찍은 것을 모두 되돌려 준다 — 레벨과 돈은 지킨다.
function Hero.unpack(id: any, data: any)
	if typeof(data) ~= "table" or not CLASSES.classes[data.class] or not whole(data.level, 1, 1e6) then
		return nil
	end
	local h = Hero.new(id, data.class)
	h.level = math.min(data.level, N.MAX_LEVEL) -- (최고 레벨이 줄었으면 그 레벨로 — 캐릭터를 못 쓰게 되지 않게 · 2026-10-18 검토)
	-- 차수: 저장된 것(그 레벨에 닿을 수 있는 데까지). 전직 퀘스트가 생기기 전에 저장된 캐릭터(2026-10-10 이전)는 레벨만 되면 전직했으므로 그 레벨의 차수 그대로다
	h.job = if whole(data.job, 1, #CLASSES.jobs) then math.min(data.job, Hero.jobAt(h.level)) else Hero.jobAt(h.level)
	h.xp = if typeof(data.xp) == "number" and data.xp >= 0 and data.xp < N.xpNeed(h.level) then math.floor(data.xp) else 0
	h.money = if whole(data.money, 0, 9e15) then data.money else 0
	h.weak = if whole(data.weak, 0, 3600) then data.weak else 0
	h.expLeft = if whole(data.expLeft, 0, Cash.RULES.exp.cap) then data.expLeft else 0 -- 경험치 쿠폰 — 생기기 전의 저장 = 0
	-- 공짜 초기화: 이것이 생기기 전에 전직한 캐릭터(2026-10-11 이전 — 저장에 없다)는 한 번 받는다
	h.resets = if whole(data.resets, 0, 1) then data.resets elseif data.resets == nil and h.job >= 2 then 1 else 0
	h.last = if typeof(data.last) == "string" and #data.last <= 40 then data.last else nil -- 없는 장면이면 서버가 마지막 마을 · 시작 마을로(world.luau의 resumeScene)
	h.home = if typeof(data.home) == "string" then data.home else nil -- 없는 장면 · 마을이 아닌 장면이면 서버가 시작 마을로 돌려보낸다(world.luau의 onReturn). 옛 저장의 towns(걷어낸 빠른 이동)는 읽지 않는다
	h.forged = data.forged == true -- 이것이 생기기 전에 저장된 캐릭터(2026-10-11 이전)는 한 번 더 받는다(첫 강화가 공짜로 반드시 붙는다)
	h.auto = data.auto == true
	h.keys = cleanKeys(data.keys, true) or {}
	local oldBag = Bag.unpack(h, data.bag) -- 장비가 생기기 전에 저장된 캐릭터는 처음 차림을 받는다
	h.quests = Quests.unpack(data.quests)
	h.daily = Daily.unpack(data.daily) -- 일일 의뢰가 생기기 전의 저장 = 빈 것(게시판에 가면 오늘의 의뢰를 받는다)
	h.rift = Rift.unpack(data.rift) -- 토벌의 하루 보상 횟수(그 전의 저장 = 오늘 아직 안 함)
	h.bond = Bond.unpack(data.bond) -- 2편의 만나면 열림 · 모험의 서(2026-10-16 — 그 전의 저장 = 빈 것 · 예전 호감도의 점수는 버린다)
	h.tut = Tutorial.unpack(data.tut) -- 튜토리얼이 생기기 전의 캐릭터(2026-10-14 이전) = 마친 것
	h.cine = {} -- 본 장면(퀘스트 연출이 생기기 전의 저장 = 아무것도 안 봤다 — 장면은 퀘스트를 받고 · 다 하고 · 돌려줄 때 트므로 지난 퀘스트의 장면은 다시 나오지 않는다)
	if typeof(data.cine) == "table" then
		for i, id in data.cine do
			if typeof(id) == "string" and #id <= 40 and typeof(i) == "number" and i <= 400 then
				h.cine[id] = true
			end
		end
	end
	h.played = if whole(data.played, 0, 1e10) then data.played else 0 -- (이것이 생기기 전의 저장 = 0부터 센다)
	Quests.jobsDone(h.quests, h.job) -- 이미 닿은 차수의 전직 퀘스트는 끝낸 것으로(다시 받지 않게)
	autoJobs(h)
	Quests.start(h.quests, h.level) -- 퀘스트가 생기기 전에 저장된 캐릭터도 첫 메인을 받는다
	-- 소비 · 기타 칸이 생기기 전에 저장된 캐릭터(2026-10-08 이전): 숫자로만 갖고 있던 것을 가방의 아이템으로 옮긴다 — 잃는 것이 없게.
	--  물약 = 그때 마시던 물약(내 레벨의 것)으로 그 수만큼 · 퀘스트의 물건 = 하는 중인 퀘스트가 세어 둔 수만큼
	local myPotion = Items.potionFor(h.level).id
	if oldBag then
		Bag.take(h, Items.potionFor(1).id, Bag.count(h, Items.potionFor(1).id)) -- Hero.new가 넣어 둔 처음 물약 대신 저장된 수를 넣는다
		local n = if whole(data.potions, 0, 9999) then data.potions else RULES.startPotions
		if n > 0 then
			Bag.give(h, myPotion, math.min(n, Bag.room(h, myPotion)))
		end
		for id, st in h.quests do
			local def = Quests.def(id)
			if def and not st.done then
				for i, step in def.steps do
					local have = st.c[i] or 0
					if step.type == "gather" and step.item and have > 0 then
						Bag.give(h, step.item, math.min(have, Bag.room(h, step.item)))
					end
				end
			end
		end
	end
	Hero.syncQuests(h) -- 가방에 든 수가 곧 퀘스트의 숫자다

	-- 능력치: 찍은 것 + 남은 것 = 그 레벨까지 받은 것
	local earned = N.apAt(h.level)
	local used, ok = 0, typeof(data.stats) == "table"
	if ok then
		for _, s in STAT_IDS do
			if whole(data.stats[s], 0, earned) then
				h.stats[s] = data.stats[s]
				used += data.stats[s]
			else
				ok = false
			end
		end
	end
	if ok and used <= earned then
		h.ap = earned - used
	else
		h.stats = { str = 0, dex = 0, int = 0, luk = 0, hp = 0 }
		h.ap = earned
	end

	-- 스킬: 처음부터 주는 것은 늘 1 이상, 쓴 포인트는 받은 것을 넘지 않는다
	local base = grants(h.class, h.job)
	local spent, good = 0, typeof(data.skills) == "table"
	local skills = table.clone(base)
	if good then
		for sid, lv in data.skills do
			local def = skillDef(h.class, sid)
			if def and whole(lv, 0, 1e6) then
				-- 게임에 아직 없는 스킬에 찍혀 있던 것(그 스킬을 막기 전의 저장)은 포인트로 돌려준다 · 최고 레벨이 줄었으면 그 레벨까지(넘친 것은 포인트로)
				if READY[sid] then
					skills[sid] = math.max(math.min(lv, def.max), base[sid] or 0)
					spent += skills[sid] - (base[sid] or 0)
				end
			end
			-- 없어진 스킬은 그것만 빼고 포인트로 돌려준다(2026-10-18 검토 — 전에는 스킬 하나 때문에 찍은 것을 모두 되돌렸다)
		end
	end
	-- 차수마다: 열리지 않은 차수의 스킬은 없고, 그 차수에 쓴 포인트는 그 차수 동안 받은 것을 넘지 않는다
	if good then
		for _, j in CLASSES.jobs do
			local used = spSpentIn(h.class, h.job, skills, j.job)
			if used > spEarnedIn(h.level, j.job, h.class) or (j.job > h.job and used > 0) then
				good = false
			end
		end
	end
	if good and spent <= spEarned(h.level, h.class) then
		h.skills = skills
		h.sp = spEarned(h.level, h.class) - spent
	else
		h.skills = base
		h.sp = spEarned(h.level, h.class)
	end
	-- 퀵슬롯: 저장된 것이 말이 되면 그대로, 아니면(퀵슬롯이 생기기 전에 저장된 캐릭터 포함) 처음 차림(Hero.new가 놓아 둔 것)
	--  예전 저장의 물약 칸("potion" — 물약이 한 가지였을 때)은 그때 마시던 물약의 칸으로 바꾼다(놓아 둔 자리가 그대로 남는다)
	--  칸 하나가 맞지 않으면(그 스킬의 포인트를 돌려받았다 · 아이템의 이름표가 바뀌었다) 그 칸만 비운다(2026-10-18 검토 — 전에는 배치 전체가 처음 차림으로 돌아갔다)
	local function salvage(list)
		if typeof(list) ~= "table" then
			return list
		end
		local out, seen = table.create(Quick.N, false), {}
		for i = 1, Quick.N do
			local v = list[i]
			if typeof(v) == "string" and #v <= 40 and not seen[v] and Hero.canSlot(h, v) then
				seen[v] = true
				out[i] = v
			end
		end
		return out
	end
	if data.slots ~= nil then
		Hero.setSlots(h, salvage(Quick.renew(data.slots, myPotion)))
	end
	-- 스마트폰의 단추 배치: 저장된 것이 말이 되면 그대로, 없으면(이것이 생기기 전에 저장된 캐릭터) 처음 차림
	if data.tslots ~= nil then
		Hero.setSlots(h, salvage(Quick.renew(data.tslots, myPotion)), true)
	end

	h.kit.on = data.kitOn == true and Kit.level(h, "toggle") > 0
	h.maxHp = maxHpOf(h)
	h.hp = h.maxHp
	return h
end

-- 클라이언트에 보내는 내 상태
-- 장비 창의 능력치 표(2026-10-14 — 사용자: "장비 탭에 … 현재 스텟, 공격력 등 여러 수치가 다 출력되어야하고 크리티컬 확률, 크리티컬 데미지 이런것도 다 나와야합니다").
--  서버가 피해 · 맞는 피해를 셈하는 바로 그 값들이다(지금 걸린 버프 · 패시브 · 리퍼의 영혼까지):
--  (2026-10-14의 꼴 — 아래 2026-10-15 줄이 지금의 것) atk = 100% 한 타의 피해 { 작게, 크게 }(전투력 x 영혼 x 버프 x 패시브 x 피해 숫자의 배율 · 흩어짐 ±spread% — 메이플의 스탯 공격력. 사냥기 · 보스기가 맞는 상대에게는 +targetBonus%, 치명타는 그 위에 곱한다)
--  crit = 치명타 확률(%) · critDmg = 치명타 피해(%) · dmg = 주는 피해(버프 · 영혼 +%) · final = 최종 피해(패시브 +%) · haste = 공격 속도(+%)
--  cut = 받는 피해가 줄어드는 몫(버프 · 패시브 %) · guard = 방어구가 줄여 주는 피해(%, 내 레벨의 몬스터에게) · run · jump = 이동 속도 · 점프력(%)
--  2026-10-15 스펙을 다시 짜며: atk = 스탯 공격력 { 작게, 크게 }(지금 걸린 버프 · 영혼까지 — 흩어짐 ±spread%) · attack = 공격력(무기 x 공격력%) · def = 방어력 ·
--   stats = 힘 · 민첩 · 지능 · 운 · 체력(처음 4 + 찍은 점수 + 장비의 올스탯) · gearStat = 장비의 올스탯 · dmg = 데미지 % · final = 최종 데미지 % ·
--   cut = 받는 피해 감소 %(방어력 · 버프 · 패시브 · 무니의 지키는 마음 — 내 레벨의 몬스터에게 맞을 때. 피하기는 넣지 않는다)
function Hero.sheet(h, spec: any?)
	local sp = spec or Hero.spec(h)
	local attack = sp.atk * (1 + Passives.atkPct(h)) * Kit.attack(h)
	local dmg = Buffs.dmg(h)
	local final = Passives.finalMul(h)
	local base = N.statAtk(sp.main, sp.sub, attack) * dmg * final * (h.dmgBoost or 1) * RULES.dmgScale
	local chance, mul = Passives.crit(h, false)
	local run, jump = Kit.move(h)
	local guard = Items.cut(Bag.worn(h), h.level)
	return {
		atk = { math.floor(base * (1 - RULES.spread / 100) + 0.5), math.floor(base * (1 + RULES.spread / 100) + 0.5) },
		attack = math.floor(attack + 0.5),
		def = sp.def,
		stats = sp.stats,
		gearStat = sp.gearStat,
		crit = chance,
		critDmg = mul * 100,
		dmg = (dmg - 1) * 100,
		final = (final - 1) * 100,
		haste = (Buffs.haste(h) - 1) * 100,
		cut = (1 - (1 - guard / 100) * Buffs.cut(h) * Passives.cut(h, false) * Kit.cut(h, false)) * 100,
		guard = guard,
		run = run * 100,
		jump = jump * 100,
	}
end

function Hero.view(h)
	local sp = Hero.spec(h) -- 스펙은 한 번만 셈한다(전투력 · 상세의 재료 · 능력치 표가 같이 쓴다)
	return {
		cine = Hero.cineList(h), -- 본 퀘스트 연출(화면이 다시 틀지 않게)
		class = h.class,
		level = h.level,
		xp = h.xp,
		need = N.xpNeed(h.level),
		hp = h.hp,
		maxHp = h.maxHp,
		money = h.money,
		potions = Hero.potions(h), -- 가방에 든 물약의 수(모든 단의 합 — 확인용. 화면의 숫자는 가방에서 아이템마다 센다)
		ap = h.ap,
		stats = h.stats,
		sp = h.sp,
		job = h.job, -- 지금의 차수(스킬 창의 탭이 열린다)
		resets = h.resets or 0, -- 공짜로 스킬을 되돌릴 수 있는 횟수(스킬 창의 「초기화」 단추)
		forged = h.forged == true, -- 강화를 해 본 적이 있는가(아니면 강화 창이 「첫 강화」를 알린다)
		sps = { math.max(0, Hero.spLeft(h, 1)), math.max(0, Hero.spLeft(h, 2)), math.max(0, Hero.spLeft(h, 3)), math.max(0, Hero.spLeft(h, 4)) }, -- 차수마다 남은 스킬 포인트
		skills = h.skills,
		power = Hero.power(h, sp),
		spec = Hero.specView(h, sp), -- 아이템 상세의 「장착하면 전투력 +n」을 셈하는 재료(2026-10-15)
		sheet = Hero.sheet(h, sp), -- 장비 창의 능력치 표(위의 Hero.sheet)
		keys = h.keys,
		slots = h.slots,
		tslots = h.tslots,
		kit = Kit.view(h), -- 사출기를 켰는가 · 영혼 · 열기(화면의 버프 자리 · 칸의 켜진 표시)
		run = (Kit.move(h)), -- 걸음의 배수(날랜 몸 · 뜨거운 피) — 화면이 그 빠르기로 걷는다
		jump = select(2, Kit.move(h)), -- 뛰는 힘의 배수
		alive = h.alive,
		weak = math.ceil(h.weak),
		expLeft = math.ceil(h.expLeft or 0), -- 경험치 쿠폰의 남은 시간(오른쪽 위 버프 줄)
	}
end

return Hero

end
MODULES['ReplicatedStorage/shared/lune/sim/items'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 장비의 셈 — 이름 · 옵션 · 떨어지는 것 · 강화 · 분해. 화면도 서버도 모르는 순수한 셈이다(별 옮기기는 2026-10-15에 뺐다).
--  수치는 data/items.generated.luau(공방 js/lune/design/items.js와 numbers.js · basics.js · economy.js에서 내보낸 것). 식은 공방과 같은 것을 다시 짰다 —
--  tools/test/tests/15_lune_items.luau가 공방에서 셈한 값(checks)과 맞춰 본다.
--  장비 하나 = { id(가진 사람 안에서의 번호), slot, stage(장비 단계), q(성능 단 1 낡은 … 5 빼어난), star, who(무기만: 어느 직업의 것),
--                fails(잇달아 떨어진 횟수), broken(부서져 흔적만 남았는가) }
local D = require(script.Parent.Parent.data["items.generated"])
local N = require(script.Parent.Parent.config.numbers)

local POWER = N.data.POWER
local E = D.ENHANCE

local Items = {}
Items.data = D
Items.NORMAL = D.NORMAL

local SLOT = {}
for i, s in D.SLOTS do
	SLOT[s.id] = s
	s.order = i
end
local ARMOR = {}
for _, id in D.ARMOR do
	ARMOR[id] = true
end
local STOCK = {}
for _, s in D.STOCK do
	STOCK[s.id] = s
end
-- 소비 · 기타 아이템(가방의 칸에 묶음으로 놓인다 — 공방 js/lune/design/items.js의 GOODS). order = 목록의 차례(정렬할 때 쓴다)
local GOODS = {}
for i, g in D.GOODS do
	GOODS[g.id] = g
	g.order = i
end

local function round(v: number): number
	return math.floor(v + 0.5)
end

function Items.slot(id: string)
	return SLOT[id]
end

function Items.isArmor(id: string): boolean
	return ARMOR[id] == true
end

function Items.stock(id: string)
	return STOCK[id]
end

-- 소비 · 기타 아이템의 자료(없는 이름표면 nil): { id, tab("use" · "etc"), kind("potion" · "quest"), name, icon, stack, text, lv · heal(물약), from · quest · need(퀘스트의 물건) }
function Items.goods(id: any)
	return if typeof(id) == "string" then GOODS[id] else nil
end

-- 상점에 팔 때의 값(헐값 — 공방 js/lune/design/items.js의 SELL · gearSell과 같은 셈). 장비: 그 단계 몬스터 한 마리의 달돈 x (무기 · 그 밖의 몫 — D.SELL) x 20% — 성능과 별은 값에 들어가지 않는다
function Items.sellPrice(it): number
	local mult = if it.slot == "weapon" then D.SELL.weapon else D.SELL.other
	return math.max(1, math.floor(D.SELL.rate * mult * N.killMoney(it.stage) + 1e-9))
end

-- 소비 · 기타 아이템 하나를 상점에 팔 때의 값(0 = 팔 수 없다 — 퀘스트의 물건)
function Items.goodsSell(id: any): number
	local g = if typeof(id) == "string" then GOODS[id] else nil
	return if g then g.sell else 0
end

-- 그 레벨에서 쓸 수 있는 가장 좋은 물약(새 캐릭터의 물약 · 퀘스트 보상의 물약)
function Items.potionFor(level: number)
	local best = nil
	for _, g in D.GOODS do
		if g.kind == "potion" and g.lv <= level and (not best or g.lv > best.lv) then
			best = g
		end
	end
	return best
end

-- ---------- 만들기 · 꼴 ----------
function Items.make(slot: string, stage: number, q: number?, who: string?)
	assert(SLOT[slot], "없는 부위 " .. tostring(slot))
	return { slot = slot, stage = stage, q = q or D.NORMAL, star = 0, who = if slot == "weapon" then who else nil, fails = 0, broken = false }
end

-- 저장된 것 · 받은 것의 꼴이 맞는가
function Items.valid(it: any): boolean
	if typeof(it) ~= "table" or not SLOT[it.slot] then
		return false
	end
	local function whole(v, min, max)
		return typeof(v) == "number" and v == math.floor(v) and v >= min and v <= max
	end
	if not whole(it.stage, 1, 200) or not whole(it.q, 1, #D.QUALITY) or not whole(it.star, 0, E.max) then
		return false
	end
	if it.slot == "weapon" and D.KINDS[it.who] == nil then
		return false
	end
	return it.star <= Items.starCap(it.stage)
end

-- 같은 장비인가(부서진 것을 되살릴 때 쓴다): 부위 · 단계 · 무기라면 직업
function Items.same(a, b): boolean
	return a.slot == b.slot and a.stage == b.stage and a.who == b.who
end

-- 낄 수 있는 레벨(사냥 장비는 단계가 곧 레벨이다)
function Items.needLevel(it): number
	return it.need or it.stage
end

-- ---------- 이름 ----------
function Items.material(stage: number): string
	for _, m in D.MATERIAL do
		if stage < m.below then
			return m.name
		end
	end
	return D.MATERIAL[#D.MATERIAL].name
end

function Items.baseName(it): string
	if it.slot == "weapon" then
		return D.KINDS[it.who]
	end
	return Items.material(it.stage) .. " " .. SLOT[it.slot].name
end

function Items.name(it): string
	local head = if it.q == D.NORMAL then "" else D.QUALITY[it.q].name .. " "
	return ("%sLv.%d %s"):format(head, it.stage, Items.baseName(it))
end

-- ---------- 옵션 · 방어 ----------  (2026-10-15 — 공방 numbers.js 2-1 · items.js의 gearOpt와 같은 셈)
--  무기 = 공격력 · 방어구 = 올스탯 · 방어력 · 장신구 = 올스탯(방어구의 절반). 성능이 기본 옵션에 % 로, 별이 그 위에 % 로 붙는다(레벨이 높은 장비일수록 기본 옵션이 커서 별 하나에 더 오른다).
--  돌려주는 것 { base = 별 없이, total = 별까지 } — 각각 { atk } 또는 { stat, def } 또는 { stat }. 부서진 것(흔적)은 모두 0
local SPEC = N.data.SPEC
function Items.options(it)
	local q = 1 + D.QUALITY[it.q].bonus / 100
	local base
	if it.slot == "weapon" then
		base = { atk = round(N.weaponAtk(it.stage) * q) }
	elseif ARMOR[it.slot] then
		base = { stat = round(N.armorStat(it.stage) * q), def = round(N.armorDef(it.stage) * q) }
	else
		base = { stat = round(N.armorStat(it.stage) * SPEC.acc.stat * q) }
	end
	local total = {}
	if it.broken then
		for k in base do
			base[k], total[k] = 0, 0
		end
		return { base = base, total = total }
	end
	local pct = N.starPct(if it.slot == "weapon" then "weapon" else "armor", it.star) / 100
	for k, v in base do
		total[k] = round(v * (1 + pct))
	end
	return { base = base, total = total }
end

-- 끼고 있는 장비들의 옵션 합 { atk, stat, def } — 피해 · 맞는 피해마다 불리므로 장비마다 표를 만들지 않고 바로 셈한다(Items.options와 같은 셈)
function Items.sum(list)
	local atk, stat, def = 0, 0, 0
	for _, it in list do
		if not it.broken then
			local q = 1 + D.QUALITY[it.q].bonus / 100
			if it.slot == "weapon" then
				atk += round(round(N.weaponAtk(it.stage) * q) * (1 + N.starPct("weapon", it.star) / 100))
			else
				local k = 1 + N.starPct("armor", it.star) / 100
				if ARMOR[it.slot] then
					stat += round(round(N.armorStat(it.stage) * q) * k)
					def += round(round(N.armorDef(it.stage) * q) * k)
				else
					stat += round(round(N.armorStat(it.stage) * SPEC.acc.stat * q) * k)
				end
			end
		end
	end
	return { atk = atk, stat = stat, def = def }
end

-- 받는 피해 감소 %: 끼고 있는 방어구의 방어력 합으로(같은 레벨 방어구 넷 = 30% · 빈 부위 · 부서진 것은 0)
function Items.cut(list, mobLv: number): number
	return N.cutOf(Items.sum(list).def, mobLv)
end

function Items.starCap(stage: number): number
	for _, s in D.STARCAP do
		if stage < s.below then
			return s.cap
		end
	end
	return E.max
end

-- ---------- 처음 받는 차림 ----------
function Items.kit(who: string)
	local list = {}
	for _, slot in D.KIT.slots do
		table.insert(list, Items.make(slot, D.KIT.stage, D.NORMAL, who))
	end
	return list
end

-- ---------- 떨어지는 것 ----------
function Items.stageOf(mobLv: number): number
	if mobLv < 10 then
		return 1
	end
	return math.min(D.STAGES[#D.STAGES], math.floor(mobLv / 10) * 10)
end

function Items.rollQuality(rng): number
	local roll, acc = rng:NextNumber(0, 100), 0
	for i, q in D.QUALITY do
		acc += q.pct
		if roll < acc then
			return i
		end
	end
	return D.NORMAL
end

-- 몬스터 한 마리가 떨어뜨리는 장비(없으면 nil). who = 잡은 사람의 직업. mul = 확률에 곱하는 값(쓰러진 뒤의 벌칙 등)
function Items.rollDrop(rng, mobLv: number, who: string, mul: number?)
	local m = mul or 1
	local roll = rng:NextNumber(0, 100)
	local a, b, c = D.DROP.weapon * m, D.DROP.other * m, D.DROP.armor * m
	local stage = Items.stageOf(mobLv)
	if roll < a then
		return Items.make("weapon", stage, Items.rollQuality(rng), who)
	elseif roll < a + b then
		-- 다른 직업의 무기(넷 가운데 하나)
		local others = {}
		for class in D.KINDS do
			if class ~= who then
				table.insert(others, class)
			end
		end
		table.sort(others)
		return Items.make("weapon", stage, Items.rollQuality(rng), others[rng:NextInteger(1, #others)])
	elseif roll < a + b + c then
		return Items.make(D.ARMOR[rng:NextInteger(1, #D.ARMOR)], stage, Items.rollQuality(rng))
	end
	return nil
end

-- ---------- 재료 · 제작 · 낮은 확률의 귀한 드롭 ----------
--  사용자 2026-10-11: "그냥 일반몬스터들이 확률에 따라서 레벨 10 몬스터 잡다가 적은확률로 10렙제 아이템, 방어구를 드롭하는겁니다. 안뜨면 재료를 모아서 대장장이에서 만들수도 있구요.
--    … 그냥 몬스터에 간단하게 일반아이템 드롭되고, 낮은확률로 이것저것 리워드 드롭되게해서 반복사냥 mmorpg 개념으로 가야하는겁니다."
--  값은 공방 js/lune/design/items.js의 MATS · MATDROP · RECIPES · CRAFTQ · RARE(모두 제안)
local RECIPE = {}
for i, r in D.RECIPES do
	RECIPE[r.id] = r
	r.order = i
end

-- 그 레벨의 몬스터가 떨어뜨리는 재료들(가방의 기타 탭에 놓이는 아이템의 이름표 — 광석 · 가죽)
function Items.matsAt(mobLv: number): { string }
	local out = {}
	for _, m in D.MATS do
		if mobLv >= m.lv[1] and mobLv <= m.lv[2] then
			table.insert(out, m.id)
		end
	end
	return out
end

-- 몬스터 한 마리가 떨어뜨리는 재료(이름표들 — 없으면 빈 표). 재료마다 따로 굴린다(둘 다 나올 수도 있다)
function Items.rollMats(rng, mobLv: number, mul: number?): { string }
	local out = {}
	for _, id in Items.matsAt(mobLv) do
		if rng:NextNumber(0, 100) < D.MATDROP.pct * (mul or 1) then
			table.insert(out, id)
		end
	end
	return out
end

-- 낮은 확률의 귀한 것(소비 아이템의 이름표들): 그 몬스터의 레벨에 쓰는 물약 · 귀환 주문서
function Items.rollRare(rng, mobLv: number, mul: number?): { string }
	local out = {}
	for _, r in D.RARE do
		if mobLv >= (r.from or 0) and rng:NextNumber(0, 100) < r.pct * (mul or 1) then -- from = 그 레벨부터의 몬스터(선물 — 2026-10-16)
			if r.id == "potion" then
				table.insert(out, Items.potionFor(mobLv).id)
			elseif r.goods then
				table.insert(out, r.goods)
			end
		end
	end
	return out
end

-- 제작법(없는 이름표면 nil): { id, slot, stage, from(만들 수 있는 레벨), needs = { { item, n } … }, money }
function Items.recipe(id: any)
	return if typeof(id) == "string" then RECIPE[id] else nil
end

-- 만든 장비의 성능 단: 보통 이상만(D.CRAFTQ의 비율 — 떨어질 때의 보통 · 좋은 · 빼어난의 비율 그대로)
function Items.rollCraftQuality(rng): number
	local total = 0
	for _, x in D.CRAFTQ do
		total += x.pct
	end
	local roll = rng:NextNumber(0, total)
	for _, x in D.CRAFTQ do
		if roll < x.pct then
			return x.q
		end
		roll -= x.pct
	end
	return D.NORMAL
end

-- 달가루가 떨어지는 꼴: 확률(%)과 한 번에 떨어지는 양(소수일 수 있다). 평균 = 0.01 × (레벨/10)³
function Items.dustDrop(mobLv: number): (number, number)
	local avg = D.DUST.kill * (mobLv / 10) ^ 3
	local chance = math.min(D.DROP.dustChance / 100, avg)
	return chance * 100, avg / chance
end

-- 몬스터 한 마리가 떨어뜨리는 달가루(없으면 nil). 양의 소수 부분은 확률로 올린다 — 평균이 식과 꼭 같다
function Items.rollDust(rng, mobLv: number, mul: number?): number?
	local chance, amount = Items.dustDrop(mobLv)
	if rng:NextNumber(0, 100) >= chance * (mul or 1) then
		return nil
	end
	local whole = math.floor(amount)
	if rng:NextNumber(0, 1) < amount - whole then
		whole += 1
	end
	return math.max(1, whole)
end

-- ---------- 강화 ----------
-- star성에서 다음 별을 시도할 때 드는 달가루
function Items.enhanceDust(stage: number, star: number): number
	local unit = (stage / 10) ^ 3
	-- 적어도 1(2026-10-15 — 상한을 풀며 Lv.1 장비가 공짜로 22성까지 가지 않게)
	if star < E.lowBelow then
		return math.max(1, round(unit * (star + 1) / E.lowDiv))
	end
	return math.max(1, round(unit * (star + 1) ^ E.highPow / E.highDiv))
end

-- 그 별까지 한 번씩 붙었다고 본 달가루
function Items.starDust(stage: number, star: number): number
	local sum = 0
	for n = 0, star - 1 do
		sum += Items.enhanceDust(stage, n)
	end
	return sum
end

-- 다음 시도의 내용. guard = 파괴 막기를 켰는가 · first = 그 캐릭터의 첫 강화인가(달가루 없이 반드시 붙는다 — 공방 basics.js의 FORGE.first).
--  { can(시도할 수 있는가), why, ok · fail · boom(%), dust, essence, drops(실패하면 떨어지는가), sure(반드시 성공인가), guard(파괴 막기를 쓸 수 있는 별인가), first(첫 강화인가) }
-- 그 캐릭터의 첫 강화로 치는가(달가루 없이 반드시 붙는다): 강화를 해 본 적이 없고 · 별이 없는 장비이고 · 제 레벨 + 10까지의 장비.
--  서버(Bag.enhance)와 화면(대장간 창)이 같은 셈을 쓴다(2026-10-18 검토: 화면은 「+10」을 보지 않아 높은 장비에도 「첫 강화」를 보이고, 서버는 보통 강화로 달가루를 받았다)
function Items.firstFree(forged: any, level: number?, it): boolean
	return forged ~= true and it.star == 0 and it.stage <= (level or 1) + 10
end

function Items.enhanceInfo(it, guard: boolean?, first: boolean?)
	local s = it.star
	if it.broken then
		return { can = false, why = "부서짐" }
	end
	if s >= E.max then -- 모든 장비가 22성까지(사용자 2026-10-15)
		return { can = false, why = "상한" }
	end
	local row = E.table[s + 1]
	local sure = (it.fails or 0) >= E.chance -- 찬스 타임: 반드시 붙는다 — 파괴 방지가 필요 없다(2026-10-18 검토: 켜 두면 값만 세 배로 받았다)
	local canGuard = table.find(E.guard.stars, s + 1) ~= nil and not sure and not first
	local useGuard = guard == true and canGuard
	local info = {
		can = true,
		ok = row[1],
		fail = row[2],
		boom = row[3],
		dust = Items.enhanceDust(it.stage, s) * (if useGuard then E.guard.cost else 1),
		essence = E.essence[s + 1],
		drops = s + 1 >= E.dropFrom and table.find(E.floors, s) == nil,
		sure = sure,
		guard = canGuard,
	}
	if useGuard then
		info.fail += info.boom
		info.boom = 0
	end
	-- 첫 강화: 공짜로, 반드시 붙는다(파괴 막기도 필요 없다)
	if first then
		info.first = true
		info.sure = true
		info.dust, info.essence = 0, 0
	end
	if info.sure then
		info.ok, info.fail, info.boom = 100, 0, 0
	end
	return info
end

-- 강화를 한 번 시도한다(값은 부른 쪽이 치른다). 결과: "ok" 붙음 · "fail" 그대로 · "drop" 한 단계 떨어짐 · "boom" 부서짐
function Items.enhance(it, rng, guard: boolean?, first: boolean?): string
	local info = Items.enhanceInfo(it, guard, first)
	assert(info.can, "강화할 수 없는 장비")
	local roll = rng:NextNumber(0, 100)
	if roll < info.ok then
		it.star += 1
		it.fails = 0
		return "ok"
	elseif roll < info.ok + info.boom then
		it.star = math.min(E.boomTo, it.star)
		it.fails = 0
		it.broken = true
		return "boom"
	elseif info.drops then
		it.star -= 1
		it.fails = (it.fails or 0) + 1
		return "drop"
	end
	return "fail"
end

-- 부서진 장비를 같은 장비 하나로 되살린다(spare는 부른 쪽이 없앤다). 되살렸으면 true
function Items.restore(it, spare): boolean
	if not it.broken or spare.broken or not Items.same(it, spare) then
		return false
	end
	it.broken = false -- 별은 부서질 때 이미 12성(그보다 낮았으면 그대로)으로 내려 두었다
	it.fails = 0
	return true
end

-- ---------- 분해 ----------
function Items.dismantle(it): number
	-- Lv.10부터는 적어도 1(분해했는데 0이 나오지 않게 — 공방의 dismantleDust와 같은 셈)
	return math.max(if it.stage >= 10 then 1 else 0, round(D.DUST.dismantle * (it.stage / 10) ^ 3 + D.DUST.back / 100 * Items.starDust(it.stage, it.star)))
end


-- ---------- 상점 ----------
-- 그 물건의 값(물약도 단마다 따로 판다 — 값이 레벨을 따라 달라지지 않는다)
-- 상점의 값: 레벨에 따라 오르는 것(달빛 부적 · 능력치 초기화 — perLv)은 내 레벨 x perLv(2026-10-18 — 설계 economy.js의 PRICE)
function Items.stockPrice(stock, level: number?): number
	if stock.perLv then
		return stock.perLv * math.max(1, level or 1)
	end
	return stock.price
end

return Items

end
MODULES['ReplicatedStorage/shared/lune/sim/kit'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 1차의 온오프 사출기 · 핵심 장치 · 패시브 — 직업마다 셋(공방 js/lune/design/combat.js의 KIT1 → data/combat.generated.luau의 kit).
--  사용자 2026-10-08: "스킬중에 지금 온오프, 차지 이런거 구현 안된건가요" · "지금 옮기던 작업을 하다가 만거죠?" — 사냥기 · 보스기 · 이동기만 옮기고 멈춰 있던 것을 마저 옮겼다.
