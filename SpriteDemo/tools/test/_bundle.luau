	end
	for i = 1, n do
		for _, s in { -1, 1 } do
			local sx = x + s * (10 + i * 15)
			g.fx.spike(sx, y, 12, max(8, 30 - i * 3), tone, { delay = i * 0.05, lean = s * 4 })
			g.after(i * 0.05, function()
				g.hitAt(sx, y, 9, 30, 2, { lift = 150 })
