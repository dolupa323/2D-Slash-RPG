-- 글씨(글자 그림들)의 비침 — 장의 이름 · 보스의 이름이 서서히 나타나고 사라진다
local function fadeText(root: Instance, a: number)
	for _, d in root:GetDescendants() do
		if d:IsA("ImageLabel") then
			d.ImageTransparency = 1 - a
		end
	end
end

function View.init(parent: Instance)
	low = Stage.group(parent, "CineLow", 55) -- 대화창(60) 아래: 세계를 덮는 것
	high = Stage.group(parent, "CineHigh", 70) -- 대화창 위: 글 · 단추
	low.Visible, high.Visible = false, false
	local function full(name: string, color: Color3, z: number): Frame
		local f = Ui.box(low, 0, 0, 1, 1, color, 1)
		f.Name, f.Size, f.ZIndex = name, UDim2.fromScale(1, 1), z
		return f
	end
	lookTint = Stage.group(parent, "CineLook", 54) -- 퀘스트 동안의 맵 모습(장면 밖에서도 보인다)
	lookTint.BackgroundTransparency = 1
	lookTint.BackgroundColor3 = Color3.new(1, 0, 0)
	tint = full("Tint", C.ink, 1)
	backdrop = full("Backdrop", INK, 2)
	picture = Stage.image(low, "Picture", "", 1, 1)
	picture.ZIndex = 3
	glow = Ui.box(low, 0, 0, 1, 1, MINT, 1)
	glow.ZIndex = 4
	glowStroke = Instance.new("UIStroke")
	glowStroke.Color = MINT
	glowStroke.Thickness = 2
	glowStroke.Parent = glow
	cardBand = full("CardBand", INK, 5)
	cardBand.Size = UDim2.new(1, 0, 0, 1)
	titleBand = full("TitleBand", INK, 5)
	local grad = Instance.new("UIGradient")
	grad.Transparency = NumberSequence.new(0, 1)
	grad.Parent = titleBand
	barTop = full("BarTop", Color3.new(0, 0, 0), 6)
	barBottom = full("BarBottom", Color3.new(0, 0, 0), 6)
	shade = full("Fade", Color3.new(0, 0, 0), 7)
	-- 위: 장의 이름(가운데) · 보스의 이름(왼쪽 아래) · 종이 · 머리 위 표시 · 「건너뛰기」
	catcher = Ui.hit(high) -- 화면 아무 데나 누르면 넘긴다(스마트폰 · 마우스) — 단추는 이 위에
	catcher.Name = "CineNext"
	catcher.ZIndex = 1 -- 「건너뛰기」 단추가 이 위에 온다
	catcher.Activated:Connect(function()
		View.input("next")
	end)
	cardBox = Ui.group(high, 0, 0, 10, 10, "Card")
	local cb
	cb, cardText = bigLabel(cardBox, C.text)
	cardSub = Ui.text(cardBox, "", 0, 0, 400, { color = C.dim, align = "center" })
	cardLines = { Ui.box(cardBox, 0, 0, 1, 1, C.accent), Ui.box(cardBox, 0, 0, 1, 1, C.accent) }
	cardBox:SetAttribute("big", cb.Name)
	titleBox = Ui.group(high, 0, 0, 10, 10, "BossTitle")
	local tb
	tb, titleText = bigLabel(titleBox, C.gold)
	titleSub = Ui.text(titleBox, "", 0, 0, 400, { color = PINK, outline = true })
	titleLine = Ui.box(titleBox, 0, 0, 1, 1, C.accent)
	noteBox = Ui.group(high, 0, 0, 10, 10, "Note")
	noteShadow = Ui.part(noteBox, "uBubble", 0, 3, 10, 10)
	noteShadow.ImageColor3 = Color3.fromRGB(150, 160, 170)
	notePaper = Ui.part(noteBox, "uBubble", 0, 0, 10, 10)
	noteTitle = Ui.text(noteBox, "", CL.notePad, CL.notePad, CL.noteW - CL.notePad * 2, { color = C.dim })
	noteRows = {}
	for i = 1, 8 do
		noteRows[i] = Ui.text(noteBox, "", CL.notePad, 0, CL.noteW - CL.notePad * 2, { font = "body", color = C.bubbleInk })
	end
	noteHint = Ui.text(noteBox, "닫기", 0, 0, 60, { outline = true })
	noteKey = Ui.keycap(noteBox, "↑", 0, 0)
	for i = 1, 4 do
		marks[i] = Ui.text(high, "", 0, 0, 40, { font = "body", outline = true, align = "center", color = C.text })
		marks[i]:show(false)
	end
	skipBtn = Ui.button(high, CL.skip, 0, 0, CL.skipW, function()
		View.input("skip")
	end, { h = CL.skipH })
	skipBtn.frame.ZIndex = 20
	skipEsc = Ui.text(high, "Esc", 0, 0, 30, { color = C.dim, outline = true, align = "right" })
	-- Esc: 건너뛰기(장면이 도는 동안만)
	UserInputService.InputBegan:Connect(function(input, processed)
		if session and not processed and input.KeyCode == Enum.KeyCode.Escape then
			View.input("skip")
		end
	end)
end

function View.active(): boolean
	return session ~= nil
end
function View.state(): any
	return session and session.st
end

-- 퀘스트 동안의 맵 모습: 색(nil이면 걷는다) · 비침
function View.setLook(color: Color3?, a: number)
	lookTint.BackgroundColor3 = color or Color3.new(0, 0, 0)
	lookTint.BackgroundTransparency = if color then 1 - a else 1
end

-- 이 맵에 없는 주민을 장면에 세울 때: 그 주민이 서 있는 장면의 주민 그림판 · 칸
local function npcArt(id: string)
	for _, sc in SCENES.scenes do
		if sc.npcs and sc.npcSheet then
			for _, n in sc.npcs do
				if n.id == id then
					return { image = ASSETS[sc.npcSheet] or "", cell = n.cell, nw = sc.npcCell[1], nh = sc.npcCell[2], name = n.name, cols = sc.npcCols or 999 }
				end
			end
		end
	end
	return nil
end
View.npcArt = npcArt

-- 장면을 튼다. w = 세계를 묻는 창구(shared/lune/cine.luau의 머리말) · world = 세계의 층(장면이 세운 것을 그 위에 놓는다)
function View.play(def, w, world: Frame)
	if session then
		View.stop()
	end
	session = { def = def, st = Cine.new(def, w), w = w, world = world, actors = {}, ash = {}, sayObj = nil, cardObj = nil, titleObj = nil, noteObj = nil, picShown = nil, clock = 0 }
	low.Visible, high.Visible = true, true
	return session.st
end

local function clearActors(s)
	for _, a in s.actors do
		if a.sprite then
			a.sprite:destroy()
		end
		if a.label then
			a.label:Destroy()
		end
	end
	s.actors = {}
	for _, p in s.ash do
		p.f:Destroy()
	end
	s.ash = {}
end

function View.stop()
	local s = session
	if not s then
		return
	end
	session = nil
	clearActors(s)
	Talk.cine(nil)
	low.Visible, high.Visible = false, false
	for _, m in marks do
		m:show(false)
	end
	if View.onEnd then
		View.onEnd(s.def)
	end
end

-- 누름: "next"(↑ · 스페이스 · 누르기) · "skip"(Esc · 「건너뛰기」)
function View.input(kind: string)
	local s = session
	if not s then
		return
	end
	local st = s.st
	if kind == "next" and st.wait and st.wait.input == "say" then
		if not Talk.cineFull() then
			Talk.cineReveal() -- 나오는 중이면 한 번에 다 보이고
			return
		end
		st.say.t = 1e9
	end
	Cine.input(st, kind, CPS)
end

-- 장면이 세운 것 하나를 그린다(졸개 = 그 졸개의 그림 · 주민 = 주민 그림판의 칸)
local function drawActor(s, key: string, a)
	local v = s.actors[key]
	if not v then
		v = {}
		if a.mob and CHARS.chars[a.mob] then
			v.sprite = Sprite.new(s.world, a.mob, 4)
		elseif a.npc then
			local art = npcArt(a.npc)
			if art then
				v.art = art
				v.label = Stage.image(s.world, "Cine_" .. key, art.image, art.nw, art.nh)
				v.label.ZIndex = 4
			end
		end
		s.actors[key] = v
	end
	if v.sprite then
		local char = CHARS.chars[a.mob]
		local clip = if a.clip == "death" and char.clips.death then "death" elseif a.walk and char.clips.run then "run" else "idle"
		v.sprite:set(clip, Sprite.frameAt(char, clip, a.t or 0, clip == "death"), a.x, a.y, a.dir)
		v.sprite.label.ImageTransparency = 1 - (a.alpha or 1)
		v.sprite.label.Visible = not a.hidden and v.sprite.label.Visible
		-- 쓰러지기 시작했다: 재가 흩어진다(한 번)
		if a.dying and not v.ashed then
			v.ashed = true
			for i = 1, 18 do
				local f = Ui.box(s.world, math.floor(a.x), math.floor(a.y - 12), 1, 1, ASH[(i % 3) + 1])
				f.ZIndex = 5
				local ang = math.rad(-160 + (i / 18) * 140)
				table.insert(s.ash, { f = f, x = a.x, y = a.y - 12, vx = math.cos(ang) * (14 + (i % 5) * 4), vy = math.sin(ang) * (16 + (i % 4) * 6), t = 0 })
			end
		end
	elseif v.label then
		local art = v.art
		local frame = math.floor(s.clock * (if a.walk then 8 else 1.6)) % 2
		local cols = art.cols or 999 -- 그림판을 cols칸마다 접었다(2026-10-16)
		local x, y = (art.cell % cols) * art.nw, (art.cell // cols * 2 + frame) * art.nh
		if (a.dir or 1) >= 0 then
			v.label.ImageRectOffset, v.label.ImageRectSize = Vector2.new(x, y), Vector2.new(art.nw, art.nh)
		else
			v.label.ImageRectOffset, v.label.ImageRectSize = Vector2.new(x + art.nw, y), Vector2.new(-art.nw, art.nh)
		end
		v.label.Position = UDim2.fromOffset(math.floor(a.x - art.nw / 2 + 0.5), a.y - art.nh)
		v.label.ImageTransparency = 1 - (a.alpha or 1)
		v.label.Visible = not a.hidden
	end
end

-- 매 화면: 셈을 흘리고 그린다. 장면이 끝나면 거두고 onEnd를 부른다
function View.update(dt: number)
	local s = session
	if not s then
		return
	end
	local st = s.st
	s.clock += dt
	Cine.step(st, dt)
	if st.done then
		View.stop()
		return
	end
	local W, H = Stage.uiW, Stage.uiH
	-- 세계: 장면이 세운 것 · 재
	for key, a in st.actors do
		drawActor(s, key, a)
	end
	for i = #s.ash, 1, -1 do
		local p = s.ash[i]
		p.t += dt
		p.vy += 30 * dt
		p.x += p.vx * dt
		p.y += p.vy * dt
		p.f.Position = UDim2.fromOffset(math.floor(p.x + 0.5), math.floor(p.y + 0.5))
		p.f.BackgroundTransparency = math.min(1, p.t / 1.1)
		if p.t >= 1.1 then
			p.f:Destroy()
			table.remove(s.ash, i)
		end
	end
	-- 색 덮개
	tint.BackgroundColor3 = if st.tint then Color3.fromHex(st.tint) else C.ink
	tint.BackgroundTransparency = if st.tint then 1 - st.tintA else 1
	-- 큰 그림(가운데 · 게임 도트의 크기 그대로 키운다) · 내 직업의 사람에게 빛
	local pd = st.picture and Cine.DATA.pictures[st.picture]
	backdrop.BackgroundTransparency = if pd then 0.18 else 1
	picture.Visible = pd ~= nil
	glow.Visible = false
	if pd then
		local r = Stage.ratio
		local pw, ph = math.floor(pd.w * r + 0.5), math.floor(pd.h * r + 0.5)
		local px, py = math.floor((W - pw) / 2), math.floor((H - ph) / 2 - 12 * r)
		picture.Image = ASSETS[pd.files[s.w.cls]] or ""
		picture.Position, picture.Size = UDim2.fromOffset(px, py), UDim2.fromOffset(pw, ph)
		local col = st.glow and pd.cols[s.w.cls]
		if col then
			local pulse = 0.5 + 0.5 * math.sin(st.clock * 4)
			glow.Visible = true
			glow.Position = UDim2.fromOffset(px + math.floor(col[1] * r), py + math.floor(pd.rows[1] * r))
			glow.Size = UDim2.fromOffset(math.floor((col[2] - col[1]) * r), math.floor((pd.rows[2] - pd.rows[1]) * r))
			glow.BackgroundTransparency = 1 - (0.1 + 0.1 * pulse)
			glowStroke.Transparency = 1 - (0.55 + 0.45 * pulse)
		end
	end
	-- 장의 이름의 띠 · 보스의 이름의 띠
	local cardA = if st.card then Cine.cardAlpha(st.card, LK.card) else 0
	local cy = math.floor(H * CL.cardY)
	cardBand.Position, cardBand.Size = UDim2.fromOffset(0, cy - 75), UDim2.new(1, 0, 0, 150)
	cardBand.BackgroundTransparency = 1 - 0.78 * cardA
	local titleA = if st.title then Cine.cardAlpha(st.title, LK.title) else 0
	local ty = math.floor(H * CL.titleY)
	titleBand.Position, titleBand.Size = UDim2.fromOffset(0, ty - 25), UDim2.fromOffset(math.floor(W * 0.7), 115)
	titleBand.BackgroundTransparency = 1 - 0.7 * titleA
	-- 위아래 검은 띠 · 암전
	local bh = math.floor(LK.bars * Stage.ratio * st.bars + 0.5)
	barTop.Size, barBottom.Size = UDim2.new(1, 0, 0, bh), UDim2.new(1, 0, 0, bh)
	barTop.Position, barBottom.Position = UDim2.fromOffset(0, 0), UDim2.new(0, 0, 1, -bh)
	barTop.BackgroundTransparency, barBottom.BackgroundTransparency = if bh > 0 then 0 else 1, if bh > 0 then 0 else 1
	shade.BackgroundTransparency = 1 - st.fade
	-- 장의 이름(가운데 · 두 배 글)
	cardBox.Visible = st.card ~= nil
	if st.card then
		if s.cardObj ~= st.card then
			s.cardObj = st.card
			cardText:set(st.card.text)
			cardSub:set(st.card.sub)
		end
		local tw = select(1, cardText:size()) * 2
		local lw = tw + 40
		cardBox.Position, cardBox.Size = UDim2.fromOffset(0, 0), UDim2.fromOffset(W, H)
		local big = cardBox:FindFirstChild("Big") :: Frame
		big.Position = UDim2.fromOffset(math.floor((W - tw) / 2), cy - M.body)
		cardLines[1].Position, cardLines[1].Size = UDim2.fromOffset(math.floor((W - lw) / 2), cy - M.body - 12), UDim2.fromOffset(lw, 1)
		cardLines[2].Position, cardLines[2].Size = UDim2.fromOffset(math.floor((W - lw) / 2), cy + M.body + 10), UDim2.fromOffset(lw, 1)
		cardSub:move(math.floor(W / 2) - 200, cy + M.body + 18)
		fadeText(cardBox, cardA)
		cardLines[1].BackgroundTransparency, cardLines[2].BackgroundTransparency = 1 - cardA, 1 - cardA
	end
	-- 보스의 이름(왼쪽 아래)
	titleBox.Visible = st.title ~= nil
	if st.title then
		if s.titleObj ~= st.title then
			s.titleObj = st.title
			titleText:set(st.title.text)
			titleSub:set(st.title.sub)
		end
		local tw = select(1, titleText:size()) * 2
		local big = titleBox:FindFirstChild("Big") :: Frame
		titleBox.Position, titleBox.Size = UDim2.fromOffset(0, 0), UDim2.fromOffset(W, H)
		big.Position = UDim2.fromOffset(CL.titleX, ty)
		titleLine.Position, titleLine.Size = UDim2.fromOffset(CL.titleX, ty + M.body * 2 + 8), UDim2.fromOffset(math.max(tw, Ui.measure(st.title.sub)) + 16, 1)
		titleSub:move(CL.titleX, ty + M.body * 2 + 14)
		fadeText(titleBox, titleA)
		titleLine.BackgroundTransparency = 1 - titleA
	end
	-- 종이(명령서)
	noteBox.Visible = st.note ~= nil
	if st.note and s.noteObj ~= st.note then
		s.noteObj = st.note
		local tw = CL.noteW - CL.notePad * 2
		noteTitle:set(st.note.title)
		local y = CL.notePad + M.smallLine + 10
		local row = 1
		for _, text in st.note.text do
			for _, ln in string.split(pixelText.Fit(text, tw, 2, "body"), "\n") do
				if noteRows[row] then
					noteRows[row]:set(ln)
					noteRows[row]:move(CL.notePad, y)
					noteRows[row]:show(true)
					row += 1
					y += M.bodyLine
				end
			end
			y += 4
		end
		for i = row, #noteRows do
			noteRows[i]:show(false)
		end
		local h = y - 4 + CL.notePad + 14
		local x0, y0 = math.floor((W - CL.noteW) / 2), math.floor((H - h) / 2) - 20
		noteBox.Position, noteBox.Size = UDim2.fromOffset(x0, y0), UDim2.fromOffset(CL.noteW, h + 30)
		notePaper.Size, noteShadow.Size = UDim2.fromOffset(CL.noteW, h), UDim2.fromOffset(CL.noteW, h)
		local hw = Ui.measure("닫기")
		noteHint:move(CL.noteW - CL.notePad - hw, h + 8)
		noteKey:move(CL.noteW - CL.notePad - hw - 12, h + 6)
	end
	-- 말(아래의 대화창)
	if st.say ~= s.sayObj then
		s.sayObj = st.say
		if st.say then
			Talk.cine(st.say.name, st.say.text)
		else
			Talk.cine(nil)
		end
	end
	-- 머리 위의 작은 표시(! ? …)
	for i, m in marks do
		local q = st.marks[i]
		local p = q and Cine.posOf(st, q.who)
		if q and p then
			local up = if q.who == "hero" then 26 elseif q.who == "boss" then 90 else 28
			m:set(q.kind)
			m:color(if q.kind == "!" then C.gold else C.text)
			m:move(Overlay.x(p.x) - 20, Overlay.y(p.y - up) - 16)
			m:show(true)
		else
			m:show(false)
		end
	end
	-- 「건너뛰기」(오른쪽 위)
	local sx = W - CL.skipW - CL.edge
	skipBtn.frame.Position = UDim2.fromOffset(sx, CL.edge)
	skipEsc:move(sx - 36, CL.edge + math.floor((CL.skipH - M.small) / 2))
	skipEsc:show(not UserInputService.TouchEnabled)
end

-- 이름표를 숨길 때인가(암전 · 큰 그림 — 이름표가 덮개 위로 비치지 않게)
function View.hideTags(): boolean
	local st = session and session.st
	return st ~= nil and (st.fade > 0.3 or st.picture ~= nil)
end

return View

end
MODULES['Client/lune/curtain'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 막 — 장면이 바뀔 때(문 · 마을로 돌아가기 · 관리 이동 · 게임에 들어올 때) 화면을 검게 덮고, 그 사이에 새 장면이 쓰는 그림을 다 불러온 뒤에 걷는다.
--  사용자 2026-10-11: "게임 시작시, 포탈 이용시 페이드 아웃 로딩 걸고 그 사이에 이미지 정확히 다 로드 해야합니다. 지금 그냥 포탈로 넘어간다음에 이미지들 로드 안되서 바로 안뜹니다."
--  전에는 처음에 그림의 번호(글)만 한꺼번에 미리 불러 두고, 문을 지나면 새 장면을 바로 그렸다 — 그 장면의 그림이 화면에 올라오기 전의 빈 모습이 잠깐 보였다.
--  이제는 새 장면을 막 뒤에서 그려 놓고, 거기에 실제로 쓰인 그림(ImageLabel)들이 다 불러와졌는지 보고 나서 막을 걷는다.
local ContentProvider = game:GetService("ContentProvider")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Curtain = {}
Curtain.OUT, Curtain.IN = 0.16, 0.26 -- 덮는 시간 · 걷는 시간(초)
Curtain.MAX_WAIT = 8 -- 그림을 기다리는 가장 긴 시간(초) — 끝내 오지 않는 그림이 있어도 화면은 열린다
Curtain.DOTS_AFTER = 0.5 -- 이보다 오래 걸리면 오른쪽 아래에 점 셋이 깜빡인다(불러오는 중)
Curtain.COLOR = Color3.fromRGB(11, 15, 22) -- 화면 부품의 가장 어두운 색(ui.js의 ink)
Curtain.DOT = Color3.fromRGB(143, 240, 212)

local gui: ScreenGui? = nil
local shade: Frame = nil
local dots: { Frame } = {}
local level = 0 -- 0 = 걷혀 있다 · 1 = 다 덮였다
local failed: { [string]: boolean } = {} -- 끝내 불러오지 못한 그림(다음부터는 기다리지 않는다)
Curtain.last = { images = 0, waited = 0, timedOut = 0 } -- 마지막으로 기다린 것(확인용)

function Curtain.init()
	if gui then
		return
	end
	local g = Instance.new("ScreenGui")
	g.Name = "LuneCurtain"
	g.IgnoreGuiInset = true
	g.ResetOnSpawn = false
	g.DisplayOrder = 1000 -- 게임 화면(LuneStage — 0)의 모든 것 위
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling -- 막(Shade — 10)이 그림 조각(Warm — 1)을 덮는다
	shade = Instance.new("Frame")
	shade.Name = "Shade"
	shade.ZIndex = 10
	shade.Size = UDim2.fromScale(1, 1)
	shade.BackgroundColor3 = Curtain.COLOR
	shade.BackgroundTransparency = 1
	shade.BorderSizePixel = 0
	shade.Visible = false
	shade.Parent = g
	for i = 1, 3 do
		local d = Instance.new("Frame")
		d.Name = "Dot" .. i
		d.Size = UDim2.fromOffset(8, 8)
		d.AnchorPoint = Vector2.new(1, 1)
		d.Position = UDim2.new(1, -28 - (3 - i) * 16, 1, -28)
		d.BackgroundColor3 = Curtain.DOT
		d.BorderSizePixel = 0
		d.Visible = false
		d.Parent = shade
		dots[i] = d
	end
	g.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = g
end

local function setLevel(k: number)
	level = math.clamp(k, 0, 1)
	shade.BackgroundTransparency = 1 - level
	shade.Visible = level > 0
	shade.Active = level > 0 -- 덮여 있는 동안은 뒤의 단추가 눌리지 않는다
end

local function showDots(on: boolean, now: number?)
	for i, d in dots do
		d.Visible = on
		if on and now then
			d.BackgroundTransparency = if math.floor(now * 3) % 3 == i - 1 then 0 else 0.7
		end
	end
end

local function fade(to: number, seconds: number)
	local from = level
	if seconds <= 0 or from == to then
		setLevel(to)
		return
	end
	local t = 0
	while t < seconds do
		t += RunService.Heartbeat:Wait()
		setLevel(from + (to - from) * math.min(1, t / seconds))
	end
	setLevel(to)
end

-- 화면을 덮는다(다 덮일 때까지 기다린다). seconds를 안 주면 Curtain.OUT
function Curtain.cover(seconds: number?)
	Curtain.init()
	fade(1, seconds or Curtain.OUT)
end

-- 막을 걷는다(다 걷힐 때까지 기다린다)
function Curtain.lift(seconds: number?)
	Curtain.init()
	showDots(false)
	fade(0, seconds or Curtain.IN)
end

function Curtain.covered(): boolean
	return level >= 1
end

-- 그 틀들 아래에서 쓰이는 그림들(그림마다 한 번씩): 보이는 것도, 숨겨져 있는 것(조금 뒤에 나타날 몬스터 · 쓰러졌을 때의 비석)도, 카메라 밖에 놓인 것도 모두
function Curtain.images(roots: { Instance }): { string }
	local seen, list = {}, {}
	for _, root in roots do
		for _, d in root:GetDescendants() do
			if d:IsA("ImageLabel") or d:IsA("ImageButton") then
				local image = (d :: any).Image
				if image ~= "" and not seen[image] and not failed[image] then
					seen[image] = true
					table.insert(list, image)
				end
			end
		end
	end
	return list
end

-- 그 틀들에 쓰인 그림이 다 불러와질 때까지 기다린다(가장 길게 timeout초). 막을 친 뒤, 새 장면을 그린 다음에 부른다.
--  로블록스는 숨겨져 있거나 화면 밖에 놓인 그림을 미리 불러와 두지 않는다(그것이 처음 그려질 때에야 올라온다 — 그래서 문을 지난 뒤 땅과 몬스터가 한 박자 늦게 떴다).
--  그래서 그림마다 작은 조각(4점짜리)을 막 뒤에 실제로 그려 놓고, 조각마다 「불러옴」(IsLoaded)이 설 때까지 기다린다 — 그 그림은 이제 바로 그려진다. 조각은 막을 걷기 전에 치운다.
--  돌려주는 것: 기다린 시간(초) · 그림의 수 · 끝내 오지 않은 수
function Curtain.load(roots: { Instance }, timeout: number?): (number, number, number)
	Curtain.init()
	local images = Curtain.images(roots)
	local warm = Instance.new("Frame")
	warm.Name = "Warm"
	warm.Size = UDim2.fromOffset(4, 4)
	warm.BackgroundTransparency = 1
	warm.BorderSizePixel = 0
	warm.ZIndex = 1 -- 막(Shade — 10)의 뒤: 막이 덮여 있는 동안은 보이지 않는다
	local pieces = {}
	for i, image in images do
		local piece = Instance.new("ImageLabel")
		piece.Name = "Piece"
		piece.Size = UDim2.fromOffset(4, 4)
		piece.Position = UDim2.fromOffset((i - 1) % 64 * 4, math.floor((i - 1) / 64) * 4)
		piece.BackgroundTransparency = 1
		piece.BorderSizePixel = 0
		piece.Image = image
		piece.Parent = warm
		pieces[i] = piece
	end
	warm.Parent = gui
	local finished = #pieces == 0
	if not finished then
		task.spawn(function()
			pcall(function()
				ContentProvider:PreloadAsync(pieces)
			end)
			finished = true
		end)
	end
	local limit = timeout or Curtain.MAX_WAIT
	local t0 = os.clock()
	local missing = 0
	local timedOut = 0
	while true do
		local now = os.clock()
		missing = 0
		for _, piece in pieces do
			if not piece.IsLoaded then
				missing += 1
			end
		end
		if finished and missing == 0 then
			break
		elseif now - t0 >= limit then
			-- 끝내 오지 않았다: 그 그림들은 다음부터 기다리지 않는다(장면이 바뀔 때마다 멈춰 서지 않게)
			for _, piece in pieces do
				if not piece.IsLoaded then
					failed[piece.Image] = true
					timedOut += 1
				end
			end
			break
		end
		showDots(now - t0 >= Curtain.DOTS_AFTER, now)
		RunService.Heartbeat:Wait()
	end
	-- 새 장면이 한 번 그려진 뒤에 걷는다(카메라가 제자리를 잡고, 장면의 그림들이 방금 불러온 것으로 그려진다)
	RunService.Heartbeat:Wait()
	RunService.Heartbeat:Wait()
	warm:Destroy()
	local waited = os.clock() - t0
	Curtain.last = { images = #images, waited = waited, timedOut = timedOut }
	-- 확인용: 마지막으로 기다린 것을 막의 속성으로 적어 둔다(Studio에서 읽어 본다) — 그림의 수 · 기다린 시간 · 끝내 오지 않은 수 · 지금까지 기다린 횟수
	if gui then
		gui:SetAttribute("Images", #images)
		gui:SetAttribute("Waited", math.floor(waited * 1000 + 0.5) / 1000)
		gui:SetAttribute("TimedOut", timedOut)
		gui:SetAttribute("Loads", (gui:GetAttribute("Loads") or 0) + 1)
	end
	return waited, #images, timedOut
end

return Curtain

end
MODULES['Client/lune/effects'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 잠깐 떴다 사라지는 것들 — 피해 숫자 · 얻은 것 알림 · 화살 · 떨어진 물건 · 대쉬의 잔상과 속도선. 모두 맵 좌표(도트)에 놓여 카메라와 함께 움직인다.
--  대쉬의 잔상 · 속도선은 공방 「횡스크롤 시험」 탭의 것 그대로다(값은 data/combat.generated.luau의 fx — dino-workshop/js/lune/fx.js의 DASHFX).
--   사용자 2026-10-07: "대쉬 이펙트가 바뀐거같은데" — 게임에는 이 효과가 없었다. 시험 탭과 같게 넣었다.
--  피해 숫자 · 화살 · 떨어진 것은 게임 세계의 그림(굵은 도트)이고, 알림 글(「+12」 · 「레벨 업!」)은 글씨의 층(화면 틀의 고운 격자 — overlay.luau)에 테두리 두른 작은 글씨로 뜬다.
--  피해 숫자는 공방 「횡스크롤 시험」 탭과 똑같이 뜬다(ui/kit.luau의 dmg — 3x5 점 숫자 · 0.7초 · 16도트 떠오름), 그 밖의 글은 작은 글씨(갈무리9)로 그린다.
--  떨어진 달돈 · 달가루는 작은 그림(8x8), 장비는 그 장비의 아이콘 그대로 떨어진다.
--  1차의 사출기 · 장치(shared/lune/sim/kit.luau)가 보이는 것도 여기서 그린다 — 작은 네모 몇 개로 찍은 점 그림(직업 색)이다:
--   따로 나가는 타(proc): 달빛 도끼가 머리 위에서 떨어진다 · 표창 · 도깨비불 · 수정 조각 · 불티가 날아간다 · 달아오름의 불꽃이 솟는다 · 수정이 번쩍인다
--   달 수정(무니) · 졸개 머리 위의 표식(리븐) · 몸 둘레를 도는 영혼(리퍼) · 머리 위의 힘 모으기 단계(액시온)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local COMBAT = require(ReplicatedStorage.shared.lune.data["combat.generated"])
local pixelText = require(script.Parent.Parent.modules.ui.pixelText)
local Sprite = require(script.Parent.sprite)
local Kit = require(script.Parent.ui.kit)
local Ui = require(script.Parent.ui.ui)
local Overlay = require(script.Parent.overlay)
local ItemCell = require(script.Parent.ui.itemCell)

local C = Kit.COLOR -- 피해 숫자의 색
local U = Ui.COLOR -- 글의 색

local Effects = {}
Effects.__index = Effects
Effects.WHITE, Effects.MINT, Effects.PINK, Effects.GOLD = U.text, U.accent, U.pink, U.gold
-- 피해 숫자의 색(시험 탭 그대로): 보통 = 흰색 · 센 타격 = 때린 사람 직업의 밝은 색(민트 · 분홍) · 사라지기 직전 = 흐린 청회색.
--  내가 받은 피해만 붉게 한다(시험 탭에는 없는 것 — 시험 탭의 캐릭터는 맞지 않는다)
Effects.DEAL, Effects.HURT, Effects.FADE = C.dmg, U.red, C.dmgFade
Effects.BIG = { mint = C.dmgBig, pink = C.dmgBigPink }
local NUM_LIFE, NUM_RISE, NUM_JITTER, NUM_POP, NUM_POP_T, NUM_FADE = 0.7, 16, 4, 2, 0.15, 0.8 -- dino-workshop/js/lune/fx.js의 num과 같은 값
local GHOST, STREAK = COMBAT.fx.dash.ghost, COMBAT.fx.dash.streak
-- 직업 색(mint · pink): n = 직업 색 · l = 밝은 색
Effects.TONE = {}
for name, t in COMBAT.fx.tones do
	Effects.TONE[name] = { n = Color3.fromRGB(t.n[1], t.n[2], t.n[3]), l = Color3.fromRGB(t.l[1], t.l[2], t.l[3]) }
end

-- layer = 게임 세계의 맨 위 층 · textLayer = 글씨의 층(화면 틀 — overlay) · heroLayer = 캐릭터들의 층(잔상은 캐릭터 뒤에 깔린다)
function Effects.new(layer: Frame, textLayer: Frame, heroLayer: Frame?)
	local self = setmetatable({}, Effects)
	self.layer = layer
	self.textLayer = textLayer
	self.heroLayer = heroLayer or layer
	self.ghosts = {} -- 잔상
	self.lines = {} -- 속도선
	self.floats = {} -- 떠오르는 글씨 · 숫자
	self.shots = {} -- [번호] = 화살
	self.drops = {} -- [번호] = 떨어진 것
	self.sprites = {} -- 잠깐 틀고 사라지는 그림(기술의 광선 등)
	self.puffs = {} -- 2단 점프의 흩어지는 점
	return self
end

-- 같은 자리에 겹치지 않게 조금씩 어긋나게 올린다(h = 게임의 도트)
function Effects:_push(item, h: number)
	for _, other in self.floats do
		if math.abs(other.x - item.x) < 60 and other.t < 0.25 then
			item.y -= h
		end
	end
	table.insert(self.floats, item)
end

-- (x, y) 위로 떠오르는 글씨
function Effects:float(text: string, x: number, y: number, color: Color3, life: number?)
	local label = pixelText.new(self.textLayer, { Text = text, Font = "small_o", Color = color, Align = "center" })
	label.Frame.ZIndex = 10
	self:_push({ frame = label.Frame, text = true, width = label.Width, x = x, y = y, t = 0, life = life or 0.7 }, 6)
end

-- 피해 숫자. (x, y) = 숫자들의 가운데 · 윗줄이 처음 뜨는 자리. big = 센 타격(처음 잠깐 두 점 더 높이 뜬다)
--  시험 탭처럼 좌우로 조금씩 흩어져 뜬다(겹쳐도 밀어 올리지 않는다).
function Effects:number(value: number, x: number, y: number, color: Color3, big: boolean?)
	local num = Kit.dmg(self.layer, tostring(math.max(0, math.floor(value + 0.5))), color)
	num.frame.ZIndex = 11
	table.insert(self.floats, {
		frame = num.frame,
		num = num,
		big = big == true,
		faded = false,
		width = num.width - 2, -- 테두리를 뺀 숫자의 폭(가운데를 맞출 때 쓴다)
		x = x + (math.random() - 0.5) * NUM_JITTER * 2,
		y = y,
		t = 0,
		life = NUM_LIFE,
	})
end

-- 캐릭터 판의 동작 하나를 (x, y)에 한 번 튼다(화염 광선처럼 기술에 딸린 그림)
function Effects:addSprite(who: string, clip: string, x: number, y: number, dir: number, life: number, fps: number)
	local sprite = Sprite.new(self.layer, who, 6)
	table.insert(self.sprites, { sprite = sprite, clip = clip, x = x, y = y, dir = dir, t = 0, life = life, fps = fps })
end

-- 캐릭터 판의 동작 하나를 그 동작의 빠르기로 튼다(보스 패턴의 이펙트 그림 — shared/lune/bossfx.luau). 공방 시험 탭의 fx.sprite와 같은 셈
--  opts: delay 늦게(음수면 그만큼 이미 흐른 데서) · back 몸들의 뒤(캐릭터들의 층 맨 아래) · loop 돌려 트는 시간(초 — 없으면 한 번 튼다) · vx 가는 빠르기(점/초)
--        lo · hi 그 밖에서는 보이지 않는다(방의 벽) · fade 끝에서 사라지는 몫(0~1)
function Effects:play(who: string, clip: string, x: number, y: number, dir: number, opts)
	opts = opts or {}
	local sprite = Sprite.new(if opts.back then self.heroLayer else self.layer, who, if opts.back then 0 else 6)
	local c = sprite.char.clips[clip]
	if not c then
		sprite:destroy() -- 그 그림이 없다(아직 싣지 않은 이펙트)
		return
	end
	sprite.label.Name = "BossFx"
	table.insert(self.sprites, {
		sprite = sprite,
		clip = clip,
		x = x,
		y = y,
		dir = dir,
		t = -(opts.delay or 0),
		life = opts.loop or (#c.frames / c.fps),
		fps = c.fps,
		loop = opts.loop ~= nil,
		vx = opts.vx or 0,
		lo = opts.lo,
		hi = opts.hi,
		fade = opts.fade or 0,
	})
end

-- 잔상: 그 캐릭터의 그 장을 한 색 실루엣으로 남긴다. 처음의 불투명도에서 곧게 옅어져 사라진다(시험 탭의 ghost)
function Effects:ghost(who: string, clip: string, frame: number, x: number, y: number, dir: number, color: Color3)
	local sprite = Sprite.new(self.heroLayer, who, 0, true)
	sprite.label.Name = "Ghost"
	sprite.label.ImageColor3 = color
	sprite.label.ImageTransparency = 1 - GHOST.alpha
	sprite:set(clip, frame, x, y, dir)
	table.insert(self.ghosts, { sprite = sprite, t = 0 })
end

-- 대쉬를 하는 동안 every초마다 잔상을 남긴다. o = 그 사람의 상태(o.ghostT에 시간을 쌓는다). 남겼으면 true
function Effects:trail(o, dt: number, who: string, clip: string, frame: number, x: number, y: number, dir: number, tone: string): boolean
	o.ghostT = (o.ghostT or 0) + dt
	if o.ghostT <= GHOST.every then
		return false
	end
	o.ghostT = 0
	self:ghost(who, clip, frame, x, y, dir, Effects.TONE[tone].n)
	return true
end

-- 속도선: 대쉬를 시작할 때 한 번. (x, y) = 발밑 · speed = 대쉬의 속도(점/초 — 빠를수록 줄이 많고 길다) · tone = 직업 색의 이름(시험 탭의 streaks)
function Effects:streaks(x: number, y: number, speed: number, dir: number, tone: string)
	local n = math.floor(STREAK.base + speed / STREAK.perSpeed + 0.5)
	local len = STREAK.len + speed / STREAK.lenPerSpeed
	for _ = 1, n do
		local frame = Kit.box(self.layer, 0, 0, 1, 1, Effects.TONE[tone].l)
		frame.Name = "Streak"
		frame.ZIndex = 5
		frame.Visible = false
		table.insert(self.lines, {
			frame = frame,
			x = x + (math.random() - 0.5) * STREAK.w,
			y = y - STREAK.up - math.random() * STREAK.h,
			len = len * (0.5 + math.random()),
			life = STREAK.life * (0.6 + math.random() * 0.6),
			t = -math.random() * STREAK.delay, -- 제각기 조금씩 늦게 뜬다
			dir = dir,
			tone = Effects.TONE[tone],
			late = false,
		})
	end
end

-- 2단 점프: 발밑에서 좌우로 흩어지며 가라앉는 밝은 점 여섯(0.3초) — 공중에서 발을 구른 자리가 보인다
local HOP = { n = 6, life = 0.3, speed = 34, drop = 14, color = Color3.fromRGB(238, 246, 246) }
function Effects:hop(x: number, y: number)
	for i = 1, HOP.n do
		local frame = Kit.box(self.layer, 0, 0, if i <= 2 then 2 else 1, 1, HOP.color)
		frame.Name = "Hop"
		frame.ZIndex = 5
		local side = if i % 2 == 0 then 1 else -1
		table.insert(self.puffs, { frame = frame, x = x + side * 2, y = y - 1, vx = side * HOP.speed * (0.35 + 0.22 * math.ceil(i / 2)), t = 0 })
	end
end

-- 화살. 쏜 졸개의 종류(s.kind)에 제 날아가는 그림(shot)이 있으면 그 그림이 날아간다(빈 투구의 덩어리) — 없으면 흰 줄(궁병의 화살)
function Effects:addShot(s, now: number)
	local def = s.kind and COMBAT.mobs[s.kind]
	if def and def.atk.shot and def.atk.shot.clip then
		local sprite = Sprite.new(self.layer, def.sprite, 8)
		self.shots[s.id] = { sprite = sprite, clip = def.atk.shot.clip, x = s.x, y = s.y, dir = s.dir, speed = s.speed, born = now, range = s.range }
		return
	end
	local frame = Kit.box(self.layer, 0, 0, 7, 1, C.white)
	frame.Name = "Arrow"
	frame.ZIndex = 8
	self.shots[s.id] = { frame = frame, x = s.x, y = s.y, dir = s.dir, speed = s.speed, born = now, range = s.range }
end

function Effects:endShot(id: number)
	local s = self.shots[id]
	if s then
		if s.sprite then
			s.sprite:destroy()
		else
			s.frame:Destroy()
		end
		self.shots[id] = nil
	end
end

-- 몬스터의 마법(몸 동작과 따로 뜨는 그림): 그 종류의 마법 그림(cast)을 (x, y)에서 한 번 튼다 — 사람들의 앞에 그린다(맞는 것은 서버가 예고 뒤에 알린다)
function Effects:addMobCast(kind: string, x: number, y: number, dir: number?)
	local def = COMBAT.mobs[kind]
	local cast = def and def.atk.cast
	if not cast then
		return
	end
	local sprite = Sprite.new(self.layer, def.sprite, 7)
	local clip = sprite.char.clips[cast.clip]
	-- 앞으로 뻗는 마법(front — 등불 해파리의 번개 줄기)은 쓴 몬스터가 보던 쪽으로 뒤집어 그린다. 나머지(발밑 · 몸)는 뒤집지 않는다
	table.insert(self.sprites, { sprite = sprite, clip = cast.clip, x = x, y = y, dir = if cast.place == "front" then dir or 1 else 1, t = 0, life = cast.life, fps = clip.fps })
end

-- 떨어진 것: 달돈 · 달가루 = 작은 그림 · 장비 = 그 장비의 아이콘(성능 단이 보통이 아니면 귀퉁이에 세모)
--  땅에 놓이는 크기: 가방의 그림(18점)을 그대로 놓으면 캐릭터(키 17점)만 하다 — DROP_SCALE배로 줄여 놓는다(18 → 11점쯤).
--   사용자 2026-10-11: "드랍되는 아이템들 크기가 너무 큽니다. 다들 평균적으로". 달돈 · 달가루는 처음부터 8점으로 그린 그림을 그대로 쓴다(줄이면 뭉개진다)
Effects.DROP_SCALE = 0.6
Effects.COIN = { frames = 4, fps = 7, scale = 0.45 } -- 떨어진 달돈이 도는 그림의 장 수 · 빠르기(1초에 몇 장 — 한 바퀴에 0.57초)
function Effects:addDrop(d)
	local frame, w, h
	if d.kind == "gear" or d.kind == "quest" or d.kind == "goods" then
		w, h = Kit.ICON, Kit.ICON
		frame = Kit.group(self.layer, 0, 0, w, h)
		if d.kind == "gear" then
			Kit.icon(frame, ItemCell.icon(d.item), 0, 0)
			local tier = ItemCell.tier(d.item)
			if tier then
				Kit.part(frame, tier, 0, 0)
			end
		else
			-- 퀘스트의 물건 · 재료 · 물약 같은 가방의 아이템: 그 물건의 그림(공방의 그림 이름 — quests.generated · items.generated의 icon)
			Kit.icon(frame, d.icon, 0, 0)
		end
		local scale = Instance.new("UIScale")
		scale.Scale = Effects.DROP_SCALE
		scale.Parent = frame
		w, h = w * Effects.DROP_SCALE, h * Effects.DROP_SCALE
	else
		-- 달돈 = 도는 주화(부품 dropCoin1~4 — Codex의 그림을 칸 그대로 옮긴 것: 테두리 · 초승달 각인 · 빛) · 달가루 = 8x8 수정(부품 dropDust). 공방 tools/build_lune_coin.mjs · build_lune_ui.mjs.
		--  달돈이 지나온 길: 손으로 찍은 어두운 금색 8x8("돈처럼 안보이고 무슨 똥같이보입니다" — 2026-10-07) → 가방의 그림 18x18("돈너무 이미지 크기가 크게나온다") → 그것을 줄인 12x12("달돈 생긴거 너무 못생겼음" — 2026-10-11: 줄이며 뭉개졌다)
		--  → 손으로 찍은 밝은 민무늬 8x8("전혀 돈 같지 않고 그냥 노랑 동그란 과자같은데" — 같은 날: 테두리도 각인도 없었다) → Codex가 그린 주화를 손대지 않고 그대로. 달돈은 내가 손으로 그리지 않는다
		frame = Kit.part(self.layer, if d.kind == "dust" then "dropDust" else "dropCoin1", 0, 0)
		w, h = frame.Size.X.Offset, frame.Size.Y.Offset
		if d.kind ~= "dust" then
			-- 주화의 그림은 가로 19 · 세로 21점으로 그려져 있다(Codex의 칸 그대로 — 테두리와 초승달 각인이 들어가려면 그만한 칸이 든다). 땅에는 COIN.scale배로 놓는다(세로 9.5점쯤 — 캐릭터 키의 절반 남짓).
			--  화면의 점은 게임 세계의 도트보다 곱절 넘게 잘아서(세계 배율 3 이상) 줄여 놓아도 그림의 칸이 빠지지 않는다
			local scale = Instance.new("UIScale")
			scale.Scale = Effects.COIN.scale
			scale.Parent = frame
			w, h = w * Effects.COIN.scale, h * Effects.COIN.scale
		end
	end
	frame.Name = "Drop" .. d.id
	frame.ZIndex = 7
	-- 달돈은 빙글 돈다(spin — 부품 dropCoin1~4를 차례로: 앞 → 비스듬히 → 옆 → 비스듬히). 주화라는 것이 한눈에 보인다
	self.drops[d.id] = { frame = frame, x = d.x, y = d.y, w = w, h = h, amount = d.amount, kind = d.kind, item = d.item, name = d.name, phase = d.id * 0.7, spin = d.kind ~= "dust" and d.kind ~= "gear" and d.kind ~= "quest" and d.kind ~= "goods" }
end

function Effects:removeDrop(id: number)
	local d = self.drops[id]
	if d then
		d.frame:Destroy()
		self.drops[id] = nil
	end
	return d
end

-- 주울 수 있는 거리 안에서 가장 가까운 것의 번호
function Effects:dropNear(x: number, y: number, reach: number): number?
	local best, bestD = nil, reach
	for id, d in self.drops do
		local dist = math.abs(d.x - x)
		if dist <= bestD and math.abs(d.y - y) <= reach + 12 then
			best, bestD = id, dist
		end
	end
	return best
end

function Effects:update(now: number, dt: number)
	for i = #self.floats, 1, -1 do
		local f = self.floats[i]
		f.t += dt
		if f.t >= f.life then
			f.frame:Destroy()
			table.remove(self.floats, i)
		else
			local k = f.t / f.life
			if f.num then
				-- 시험 탭의 num과 같은 식: 16도트를 처음엔 빠르게 · 끝에선 느리게 오르고, 마지막 20%는 흐린 색
				local rise = NUM_RISE * (1 - (1 - k) * (1 - k)) + (if f.big and k < NUM_POP_T then NUM_POP else 0)
				f.frame.Position = UDim2.fromOffset(math.floor(f.x - f.width / 2 + 0.5) - 1, math.floor(f.y - rise + 0.5) - 1)
				if k > NUM_FADE and not f.faded then
					f.faded = true
					f.num:color(Effects.FADE)
				end
			else
				-- 알림 글: 게임의 도트로 6쯤 떠오른다(화면 틀의 점으로 자리를 잡는다)
				local rise = 6 * (1 - (1 - k) * (1 - k))
				f.frame.Position = UDim2.fromOffset(Overlay.x(f.x) - math.floor(f.width / 2), Overlay.y(f.y - rise))
			end
		end
	end
	for i = #self.sprites, 1, -1 do
		local sp = self.sprites[i]
		sp.t += dt
		if sp.t >= sp.life then
			sp.sprite:destroy()
			table.remove(self.sprites, i)
		elseif sp.t < 0 then
			sp.sprite.label.Visible = false -- 아직 제 때가 아니다(늦게 뜨는 것)
		else
			local n = #sp.sprite.char.clips[sp.clip].frames
			local f = math.floor(sp.t * sp.fps)
			local x = sp.x + (sp.vx or 0) * sp.t
			if (sp.lo and x < sp.lo) or (sp.hi and x > sp.hi) then
				sp.sprite.label.Visible = false -- 방의 벽 밖
			else
				sp.sprite:set(sp.clip, if sp.loop then f % n + 1 else math.min(n, f + 1), x, sp.y, sp.dir)
				if sp.fade and sp.fade > 0 then
					local k = sp.t / sp.life
					sp.sprite.label.ImageTransparency = if k > 1 - sp.fade then 1 - math.max(0, (1 - k) / sp.fade) else 0
				end
			end
		end
	end
	for i = #self.ghosts, 1, -1 do
		local g = self.ghosts[i]
		g.t += dt
		if g.t > GHOST.life then
			g.sprite:destroy()
			table.remove(self.ghosts, i)
		else
			g.sprite.label.ImageTransparency = 1 - GHOST.alpha * (1 - g.t / GHOST.life)
		end
	end
	for i = #self.lines, 1, -1 do
		local s = self.lines[i]
		s.t += dt
		local k = s.t / s.life
		if k >= 1 then
			s.frame:Destroy()
			table.remove(self.lines, i)
		elseif k >= 0 then
			-- 뒤로 밀리며 짧아진다. 앞의 절반은 밝은 색, 뒤의 절반은 직업 색
			local l = s.len * (1 - k)
			s.frame.Position = UDim2.fromOffset(math.floor(s.x - s.dir * k * STREAK.slide - (if s.dir > 0 then l else 0) + 0.5), math.floor(s.y + 0.5))
			s.frame.Size = UDim2.fromOffset(math.max(1, math.floor(l + 0.5)), 1)
			s.frame.Visible = true
			if k >= 0.5 and not s.late then
				s.late = true
				s.frame.BackgroundColor3 = s.tone.n
			end
		end
	end
	for i = #self.puffs, 1, -1 do
		local p = self.puffs[i]
		p.t += dt
		local k = p.t / HOP.life
		if k >= 1 then
			p.frame:Destroy()
			table.remove(self.puffs, i)
		else
			-- 처음엔 빠르게, 끝에선 느리게 옆으로 퍼지며 조금 가라앉고 흐려진다
			local out = 1 - (1 - k) * (1 - k)
			p.frame.Position = UDim2.fromOffset(math.floor(p.x + p.vx * HOP.life * out + 0.5), math.floor(p.y + HOP.drop * k * k + 0.5))
			p.frame.BackgroundTransparency = k
		end
	end
	for id, s in self.shots do
		local gone = (now - s.born) * s.speed
		if gone > s.range + 20 then
			self:endShot(id)
		else
			local x = s.x + s.dir * gone
			if s.sprite then
				s.sprite:set(s.clip, Sprite.frameAt(s.sprite.char, s.clip, now - s.born, false), x, s.y, s.dir)
			else
				s.frame.Position = UDim2.fromOffset(math.floor(x - 3 + 0.5), math.floor(s.y))
			end
		end
	end
	-- 떨어진 것은 땅 바로 위에서 천천히 오르내린다
	for _, d in self.drops do
		local bob = math.floor(math.sin(now * 4 + d.phase) * 1.5 + 0.5)
		d.frame.Position = UDim2.fromOffset(math.floor(d.x - d.w / 2 + 0.5), math.floor(d.y - d.h - 2 + bob + 0.5))
		if d.spin then
			local f = math.floor(now * Effects.COIN.fps + d.phase) % Effects.COIN.frames + 1
			if f ~= d.spinAt then
				d.spinAt = f
				Kit.swap(d.frame, "dropCoin" .. f)
			end
		end
	end
end

function Effects:destroy()
	for _, f in self.floats do
		f.frame:Destroy()
	end
	-- 날아가는 것: 흰 줄(frame)이거나 제 그림으로 나는 것(sprite — 빈 투구의 덩어리)이다. 둘 다 지운다
	--  (2026-10-13 — 전에는 모두 frame이라고 보고 지워서, 그림으로 나는 것이 떠 있는 동안 문을 지나면 여기서 오류가 났고 새 장면이 그려지지 않았다)
	for _, s in self.shots do
		if s.sprite then
			s.sprite:destroy()
		else
			s.frame:Destroy()
		end
	end
	for _, d in self.drops do
		d.frame:Destroy()
	end
	for _, sp in self.sprites do
		sp.sprite:destroy()
	end
	for _, g in self.ghosts do
		g.sprite:destroy()
	end
	for _, s in self.lines do
		s.frame:Destroy()
	end
	for _, p in self.puffs do
		p.frame:Destroy()
	end
	table.clear(self.puffs)
	table.clear(self.ghosts)
	table.clear(self.lines)
	table.clear(self.sprites)
	table.clear(self.floats)
	table.clear(self.shots)
	table.clear(self.drops)
end

return Effects

end
MODULES['Client/lune/fxart'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 이펙트의 그림(Aseprite로 그린 것 — 무니의 수정): 공방이 내보낸 점 자료(data/fxart.generated.luau)를 그림판에 찍을 수 있는 꼴로 푼다.
--  FxArt[이름] = { w, h, buf(RGBA) , hi = 흰 모서리 · 반짝임만 남긴 그림(반투명으로 겹칠 때도 모서리는 또렷하게 — 시험 탭의 hiOf) }
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DATA = require(ReplicatedStorage.shared.lune.data["fxart.generated"])

local FxArt = {}
for name, e in DATA do
	local n = e.w * e.h * 4
	local buf, hi = buffer.create(n), buffer.create(n)
	local hex = e.hex
	for i = 0, n - 1 do
		buffer.writeu8(buf, i, tonumber(string.sub(hex, i * 2 + 1, i * 2 + 2), 16) or 0)
	end
	for p = 0, n - 4, 4 do
		if buffer.readu8(buf, p) > 250 and buffer.readu8(buf, p + 1) > 250 and buffer.readu8(buf, p + 2) > 250 then
			buffer.writeu32(hi, p, buffer.readu32(buf, p))
		end
	end
	FxArt[name] = { w = e.w, h = e.h, buf = buf, hi = { w = e.w, h = e.h, buf = hi } }
end

return FxArt

end
MODULES['Client/lune/gainLog'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 획득 알림 — 경험치 · 달돈 · 달가루 · 주운 것 · 레벨 업 · 퀘스트 완료를 화면 구석에 줄로 쌓는다(메이플스토리의 획득 메시지처럼).
--  2026-10-18: 얻은 것은 머리 위에 잠깐 뜨는 글뿐이라 지나가면 다시 볼 수 없었다. 머리 위의 글은 그대로 두고, 여기 줄로도 남긴다.
--  가장 아래가 새 줄. 줄마다 life초 뒤 fade초 동안 흐려져 사라진다. 같은 갈래(경험치 · 달돈 · 달가루)가 merge초 안에 이어 오면
--  새 줄을 만들지 않고 마지막 줄의 수를 더한다(사냥 중에 줄이 넘치지 않게).
--  자리 = 공방 basics.js의 HUD 「획득 알림」(PC: 오른쪽 아래 메뉴 단추 위 · 스마트폰: HUDTOUCH — 왼쪽 위 파티원 칸 아래) · 치수 = ui.js의 UILAYOUT.gainLog
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local UI = require(lune.data["ui.generated"])
local Layout = require(lune.ui.layout)
local Format = require(lune.ui.format)
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR
local L = Layout.GAINLOG

local GainLog = {}
GainLog.lines = {} :: { any } -- { text, color, age, kind, amount } — 앞이 오래된 줄
local box: Frame? = nil
local rows = {} -- 미리 만든 글 칸(아래가 새 줄)
local shown = {} -- 칸마다 지금 적힌 글 · 색(바뀔 때만 다시 그린다)
GainLog.touch = false
GainLog.covered = false

local function rect()
	local r = if GainLog.touch and UI.hudTouch.gainLog then UI.hudTouch.gainLog else UI.hud.gainLog
	return r
end

function GainLog.init(root: Frame)
	local r = UI.hud.gainLog
	box = Stage.place(root, "GainLog", r.at, r.x, r.y, r.w, r.h)
	for i = 1, L.lines do
		rows[i] = Ui.text(box, "", 0, (i - 1) * L.lineH, r.w, { outline = true })
		shown[i] = { text = "", color = nil }
	end
end

-- 스마트폰 단추가 켜졌다 · 꺼졌다: 자리를 옮긴다
function GainLog.setTouch(on: boolean)
	GainLog.touch = on
	if box then
		local r = rect()
		box.Position = Stage.atPosition(r.at, r.x, r.y)
	end
end

-- 오른쪽 창이 그 자리를 덮었다(PC) — 그동안은 감춘다
function GainLog.setCovered(on: boolean)
	GainLog.covered = on
	if box then
		box.Visible = not (on and not GainLog.touch)
	end
end

local MERGE = { xp = "경험치 +%s", money = "달돈 +%s", dust = "달가루 +%s" }
local function textOf(kind: string, amount: number): string
	return MERGE[kind]:format(if kind == "xp" then Format.comma(amount) else Format.short(amount))
end

-- 한 줄을 더한다. kind = xp · money · dust(같은 갈래가 이어 오면 합친다) · 그 밖(item · quest · level · note)은 늘 새 줄
function GainLog.add(kind: string, text: string?, color: any?, amount: number?)
	local last = GainLog.lines[#GainLog.lines]
	if MERGE[kind] then
		if last and last.kind == kind and last.age < L.merge then
			last.amount += amount or 0
			last.text = textOf(kind, last.amount)
			last.age = 0
			return
		end
		text = textOf(kind, amount or 0)
	end
	table.insert(GainLog.lines, { text = text or "", color = color or C.text, age = 0, kind = kind, amount = amount or 0 })
	while #GainLog.lines > L.lines do
		table.remove(GainLog.lines, 1)
	end
end
function GainLog.xp(n: number)
	if n > 0 then
		GainLog.add("xp", nil, C.accent, n)
	end
end
function GainLog.money(n: number)
	if n > 0 then
		GainLog.add("money", nil, C.gold, n)
	end
end
function GainLog.dust(n: number)
	if n > 0 then
		GainLog.add("dust", nil, C.accent, n)
	end
end
function GainLog.item(label: string, color: any?)
	GainLog.add("item", ("획득: %s"):format(label), color or C.text)
end
function GainLog.level(level: number)
	GainLog.add("level", ("레벨 업! Lv.%d"):format(level), C.gold)
end
function GainLog.quest(name: string)
	GainLog.add("quest", ("퀘스트 완료: %s"):format(name), C.gold)
end

-- 0(안 보임) ~ 1 — 줄의 나이로
function GainLog.alphaOf(age: number): number
	if age <= L.life then
		return 1
	end
	return math.max(0, 1 - (age - L.life) / L.fade)
end

-- 줄의 글자들과 처음 투명도(글이 바뀔 때 한 번 모은다 — 매 장면 GetDescendants · 속성을 읽지 않게 · 2026-10-18 검토)
local function glyphsOf(row): { any }
	local list = {}
	local frame = row.label and row.label.Frame
	if frame then
		for _, d in frame:GetDescendants() do
			if d:IsA("ImageLabel") then
				table.insert(list, { d = d, base = d.ImageTransparency })
			end
		end
	end
	return list
end
local function fadeRow(was, a: number)
	-- 흐림이 바뀔 때만 쓴다(다 보이는 동안은 아무것도 쓰지 않는다)
	local q = math.floor(a * 64 + 0.5) / 64
	if was.alpha == q then
		return
	end
	was.alpha = q
	for _, g in was.glyphs or {} do
		g.d.ImageTransparency = g.base + (1 - g.base) * (1 - q)
	end
end

-- 장마다: 줄의 나이를 더하고, 다 흐려진 줄을 지우고, 칸에 다시 적는다(아래 칸부터 새 줄)
function GainLog.step(dt: number)
	for i = #GainLog.lines, 1, -1 do
		local line = GainLog.lines[i]
		line.age += dt
		if GainLog.alphaOf(line.age) <= 0 then
			table.remove(GainLog.lines, i)
		end
	end
	if not box then
		return
	end
	local n = #GainLog.lines
	for i = 1, L.lines do
		local line = GainLog.lines[n - (L.lines - i)] -- 마지막 칸 = 가장 새 줄
		local row, was = rows[i], shown[i]
		local text, color = if line then line.text else "", if line then line.color else nil
		if was.text ~= text then
			row:set(text)
			was.text = text
			was.color = nil
			was.glyphs = glyphsOf(row) -- (새 글의 글자들 — 처음 투명도와 함께)
			was.alpha = nil
		end
		if color and was.color ~= color then
			row:color(color)
			was.color = color
		end
		if line then
			fadeRow(was, GainLog.alphaOf(line.age))
		end
	end
end

function GainLog.clear()
	table.clear(GainLog.lines)
end

return GainLog

end
MODULES['Client/lune/grave'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 비석 — 쓰러진 사람의 자리에 선다(사용자 2026-10-08: "죽으면 비석 세우고, 모달띄워서 마을로 갈거냐고 물어보는 딜레이를 넣읍시다").
--  그림은 사냥터의 놓는 것 가운데 묘비(공방 assetpack/lune의 props — rects.grave)를 그대로 쓴다(새 그림이 아니다).
--  쓰러지는 동작이 끝나면 몸 대신 비석이 위에서 톡 내려와 선다. 캐릭터 · 졸개의 층보다 뒤에 놓는다(놓인 것이 캐릭터를 가리지 않는다 — 장면의 Graves 층).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local data = ReplicatedStorage.shared.lune.data
local SCENES = require(data["scenes.generated"])
local ASSETS = require(data["assets.generated"])
local Stage = require(script.Parent.stage)

local SOURCE = SCENES.scenes.hunt -- 묘비 그림이 든 판
local RECT = SOURCE.rects.grave
local DROP, FROM = 0.18, 14 -- 내려와 서는 시간(초) · 그만큼 위에서(도트)

local Grave = {}

function Grave.new(layer: Instance): ImageLabel
	local label = Stage.image(layer, "Grave", ASSETS[SOURCE.props] or "", RECT.w, RECT.h)
	label.ImageRectOffset = Vector2.new(RECT.x, RECT.y)
	label.ImageRectSize = Vector2.new(RECT.w, RECT.h)
	label.Visible = false
	return label
end

-- (x, y) = 쓰러진 사람의 발밑 가운데 · t = 비석이 서기 시작한 뒤 흐른 시간(초)
function Grave.put(label: ImageLabel, x: number, y: number, t: number)
	local k = math.clamp(t / DROP, 0, 1)
	local up = math.floor(FROM * (1 - k) * (1 - k) + 0.5)
	label.Position = UDim2.fromOffset(math.floor(x + 0.5) - math.floor(RECT.w / 2), math.floor(y + 0.5) - RECT.h - up)
	label.ImageTransparency = 1 - k
	label.Visible = true
end

return Grave

end
MODULES['Client/lune/guide'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 길잡이 — 화면 가운데의 큰 알림 한 줄(「달이 부른다」 · 「2차 전직」)과, 처음 하는 사람에게 지금 누를 키를 알려 주는 안내 한 줄.
--  설계: 공방 js/lune/design/basics.js의 START("처음 쓰는 키는 화면 가운데에 크게 한 번 뜬다") · JOBFLOW("화면 가운데에 '달이 부른다'가 뜬다") · startplan.js의 차례 ②(첫 5분).
--  판 없이, 어두운 테두리를 두른 글씨를 화면 위쪽 가운데에 적는다(보스 체력 칸 아래 — 다른 늘 보이는 것과 겹치지 않는 자리). 글은 폭을 넘지 않는다(안내는 두 줄까지).
--  안내 글은 캐릭터의 지금 상태에서 그때그때 셈한다(Guide.pick) — 무엇을 봤는지 따로 저장하지 않는다: 할 일을 하면 그 안내는 저절로 사라지고, 레벨이 오르면 더 뜨지 않는다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local GuideText = require(lune.ui.guideText)
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR

local Guide = {}
Guide.HINT_W, Guide.HINT_LINES = GuideText.W, GuideText.LINES -- 안내 글의 칸(자동 검사가 글이 이 안에 들어가는지 본다)
Guide.BANNER_W = 480
Guide.HINT_Y, Guide.BANNER_Y = 50, 86 -- 화면 틀의 기준 격자(960x540)에서의 높이 — 캐릭터 머리 위로 뜨는 글(「완료」 · 「레벨 업!」)보다 위

local hintBox: Frame, bannerBox: Frame
local hint, title, sub
local hintNow = ""
local bannerLeft = 0
local queue = {} -- 기다리는 큰 알림들 { head, line, seconds }(앞의 것이 사라지면 차례로 뜬다)
Guide.QUEUE_MAX = 4

function Guide.init(root: Frame)
	hintBox = Stage.place(root, "GuideHint", "tc", (Stage.REF_W - Guide.HINT_W) / 2, Guide.HINT_Y, Guide.HINT_W, 40)
	hint = Ui.text(hintBox, "", 0, 0, Guide.HINT_W, { align = "center", outline = true, color = C.accent, lines = Guide.HINT_LINES, line = Ui.M.small + 4 })
	hintBox.Visible = false
	bannerBox = Stage.place(root, "GuideBanner", "tc", (Stage.REF_W - Guide.BANNER_W) / 2, Guide.BANNER_Y, Guide.BANNER_W, 44)
	title = Ui.text(bannerBox, "", 0, 0, Guide.BANNER_W, { font = "body", align = "center", outline = true, color = C.gold })
	sub = Ui.text(bannerBox, "", 0, Ui.M.body + 8, Guide.BANNER_W, { align = "center", outline = true, color = C.text })
	bannerBox.Visible = false
end

-- 안내 한 줄(없으면 nil · 빈 글)
function Guide.setHint(text: string?)
	local value = text or ""
	if value ~= hintNow then
		hintNow = value
		hint:set(value)
	end
	hintBox.Visible = value ~= ""
end

-- 큰 알림: 제목(노랑) + 한 줄. seconds 뒤에 사라진다
--  앞의 알림이 아직 떠 있으면 그 뒤에 줄을 세운다(덮어쓰지 않는다 — 같은 순간에 둘이 오면 뒤의 것만 보였다). 같은 제목이 이미 떠 있거나 기다리는 중이면 다시 넣지 않는다
local function show(head: string, line: string?, seconds: number?)
	title:set(head)
	sub:set(line or "")
	bannerLeft = seconds or 4
	bannerBox.Visible = true
	Guide.now = head
end
function Guide.banner(head: string, line: string?, seconds: number?)
	if bannerLeft > 0 then
		if Guide.now == head then
			show(head, line, seconds) -- 같은 알림이 다시 왔다: 글과 시간을 새로
			return
		end
		for _, q in queue do
			if q[1] == head then
				return
			end
		end
		if #queue < Guide.QUEUE_MAX then
			table.insert(queue, { head, line, seconds })
		end
		return
	end
	show(head, line, seconds)
end

function Guide.step(dt: number)
	if bannerLeft > 0 then
		bannerLeft -= dt
		if bannerLeft <= 0 then
			bannerBox.Visible = false
			Guide.now = nil
			local nextOne = table.remove(queue, 1)
			if nextOne then
				show(nextOne[1], nextOne[2], nextOne[3])
			end
		end
	end
end

function Guide.clear()
	table.clear(queue)
	Guide.now = nil
	bannerLeft = 0
	bannerBox.Visible = false
	Guide.setHint(nil)
end

-- 지금 띄울 안내를 고른다(셈은 shared/lune/ui/guideText.luau)
Guide.pick = GuideText.pick

return Guide

end
MODULES['Client/lune/hallStones'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 명예의 전당의 비석에 새긴 순위(2026-10-15).
--  사용자: "명예의 전당이 상호작용해서 나오는 방식인데 그게 아니고 그냥 비석그림위에 비석에 새겨진것처럼 보여야합니다."
--  → 비석 앞에서 ↑로 창을 여는 것을 없애고(공방 items.js의 NPCDO에서 뺐다), 비석 면(scenes.generated의 npcs[].face — 방 그림에서 잰 도트)에
--    순위 · 이름 · 값을 돌에 판 글처럼 그린다: 어두운 글 + 한 점 아래의 밝은 테두리(새긴 홈에 빛이 걸린 모양). 들어설 때 서버에서 받고(Net "Rank") 30초마다 다시 받는다.
--  줄 수 = 비석 면의 높이에 들어가는 만큼(가장 많이 Rank.TOP). 이름은 폭을 넘으면 …로 줄인다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Net = require(lune.net.net)
local Rank = require(lune.sim.rank)
local Stage = require(script.Parent.stage)
local Overlay = require(script.Parent.overlay)
local Ui = require(script.Parent.ui.ui)

local M = Ui.M
local INK = Color3.fromRGB(46, 54, 66) -- 판 홈의 그늘(비석 면 #697b90보다 어둡게)
local LIGHT = Color3.fromRGB(150, 166, 184) -- 홈 아래쪽 가장자리에 걸린 빛
local PAD = 3 -- 비석 면 안쪽 여백(화면 틀의 점)
local REFRESH = 30 -- 다시 받는 사이(초)

local HallStones = {}
HallStones.fetch = function()
	return Net.Invoke("Rank")
end

local layer: Frame? = nil
local stones = {} -- { board, face, rows = { { no, name, value } } }
local boards = nil
local nextFetch = 0
local placedKey = ""
local gen = 0

local function engraved(parent: Instance, align: string?, width: number)
	local t = Ui.text(parent, "", 0, 0, width, { color = INK, align = align or "left" })
	if t.label.SetShadow then
		t.label:SetShadow(LIGHT)
	end
	return t
end

-- 그 장면에 들어섰다: 비석 면이 있는 비석마다 글을 만든다(없으면 아무것도 하지 않는다)
function HallStones.enter(scene, parent: Instance)
	HallStones.leave()
	local list = {}
	for _, n in scene.npcs or {} do
		if n.stone and typeof(n.face) == "table" then
			table.insert(list, n)
		end
	end
	if #list == 0 then
		return
	end
	gen += 1
	layer = Stage.group(parent, "HallStones", 5)
	for _, n in list do
		local st = { board = string.match(n.id, "^hall_(%a+)$") or "level", face = n.face, rows = {} }
		for i = 1, Rank.TOP do
			st.rows[i] = { no = engraved(layer, "right", 14), name = engraved(layer, "left", 120), value = engraved(layer, "right", 60) }
		end
		table.insert(stones, st)
	end
	boards, nextFetch, placedKey = nil, 0, ""
end

function HallStones.leave()
	gen += 1
	if layer then
		layer:Destroy()
		layer = nil
	end
	stones = {}
	boards = nil
end

-- 매 화면: 때가 되면 순위를 받고, 화면 틀이 바뀌었으면 다시 놓는다
function HallStones.update()
	if not layer then
		return
	end
	local now = os.clock()
	if now >= nextFetch then
		nextFetch = now + REFRESH
		local my = gen
		task.spawn(function()
			local ok, got = pcall(HallStones.fetch)
			if ok and got and my == gen then
				boards = got
				placedKey = "" -- 글을 다시 적는다
			end
		end)
	end
	local key = ("%d:%d:%d:%d:%s"):format(Stage.uiW, Stage.uiH, Overlay.camX, Overlay.camY, tostring(boards ~= nil))
	if key == placedKey then
		return
	end
	placedKey = key
	for _, st in stones do
		-- face = 방 그림의 자리(실내의 방 그림은 화면에 붙은 층이다 — 카메라를 따라가지 않는다): 화면의 점 = 그림의 점. 세계의 자리로 바꾸려면 카메라를 더한다
		local cx, cy = Overlay.camX, Overlay.camY
		local x0, y0 = Overlay.x(st.face[1] + cx) + PAD, Overlay.y(st.face[2] + cy) + PAD + 1
		local x1, y1 = Overlay.x(st.face[3] + 1 + cx) - PAD, Overlay.y(st.face[4] + 1 + cy) - PAD
		local w = x1 - x0
		local fit = math.clamp(math.floor((y1 - y0) / M.smallLine), 0, Rank.TOP) -- 면에 들어가는 줄
		local list = boards and boards[st.board] or {}
		local valueW = 0
		for i = 1, fit do
			local it = list[i]
			if it then
				valueW = math.max(valueW, Ui.measure(it.value))
			end
		end
		for i, row in st.rows do
			local it = list[i]
			local on = i <= fit and it ~= nil
			row.no:show(on)
			row.name:show(on)
			row.value:show(on)
			if on then
				local y = y0 + (i - 1) * M.smallLine
				row.no:set(tostring(i))
				row.no:move(x0 - 2, y)
				row.value:set(it.value)
				row.value.width = valueW
				row.value:move(x1 - valueW, y)
				local nameX = x0 + 15
				local nameW = math.max(10, w - 15 - valueW - 4)
				row.name.label:SetMaxWidth(nameW, 1)
				row.name.width = nameW
				row.name:set(it.name)
				row.name:move(nameX, y)
			end
		end
	end
end

return HallStones

end
MODULES['Client/lune/hud'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 늘 보이는 화면(HUD) — 왼쪽 아래의 한 덩어리(레벨 · 이름 · 체력 바 · 경험치 줄) · 가운데 아래의 스킬 칸(물약 + 기술) · 오른쪽 아래의 창을 여는 단추.
--  산나비 계열 도트 게임의 방식(사용자 2026-10-07 "훌룡합니다. 하지만 글씨비율은 좀더 작아야합니다. 그리고 미니맵은 없애세요"):
--   늘 보이는 것은 구석에 작게, 판 없이 — 글은 어두운 테두리를 두른 작은 글씨로 게임 화면 위에 바로 적는다. 미니맵은 없다.
--  아직 없는 칸: 보스 체력(L6) · 버프와 직업 게이지(L7) — 쓸 때가 되면 생긴다(공방의 화면 규칙).
--  자리는 공방 「기본 · UI」 탭의 화면 배치(data/ui.generated.luau — 기준 격자 960x540과 붙는 구석)를 그대로 쓰고, 모양은 화면 틀의 부품(ui/ui.luau)이다.
--  글씨는 제 칸을 넘지 않게 폭을 준다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local UI = require(lune.data["ui.generated"])
local Format = require(lune.ui.format)
local Layout = require(lune.ui.layout) -- 치수는 한데 모아 둔 것을 쓴다(자동 검사가 같은 값을 본다)
local Quick = require(lune.ui.quick) -- 퀵슬롯의 셈(칸 수 · 놓는 법)
local RunService = game:GetService("RunService")
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR
local M = Ui.M
local V, K, MN = Layout.VITALS, Layout.SKILLS, Layout.MENU
local HpFx = require(lune.ui.hpFx) -- 체력이 닳고 찰 때의 효과(셈)
local SLOT = K.slot -- 스킬 칸 한 변
local KEY_UP = K.keyUp -- 칸 위의 키 딱지가 차지하는 높이
local COLS, ROWS = K.cols, K.rows -- 스킬 칸: 두 줄 x 여섯
local PIC = M.pic
-- 설명 판(버프 · 경험치 · 퀵슬롯의 설명 — 2026-10-18): 능력치의 설명과 같은 판의 치수 · 제목의 색. 판을 짓는 함수들보다 위에 둔다(퀵슬롯의 설명이 먼저 쓴다)
local TIP = Layout.STAT.tip
local TIPCOLOR = { main = C.gold, sub = C.accent, none = C.dim }
-- 손가락으로 누른 것인가(폰에서는 누를 때도 MouseEnter가 오고 MouseLeave는 오지 않는다 — 그때는 Activated로만 열고 닫는다)
local UIS = game:GetService("UserInputService")
local function touching(): boolean
	return UIS:GetLastInputType() == Enum.UserInputType.Touch
end
-- 메뉴 단추의 그림(창의 이름표 → 그림)
local MENU_PIC = { bag = "menu_bag", equip = "menu_equip", stat = "menu_stat", skill = "menu_skill", quest = "menu_quest", map = "menu_map", auction = "menu_auction", party = "menu_party", cash = "menu_shop", more = "menu_gear" } -- cash = 달빛 상점(2026-10-21 — 단추 줄에)

local Hud = {}
Hud.COLS, Hud.ROWS = COLS, ROWS
Hud.MENU_MAX = MN.max -- 메뉴 단추는 여덟까지 놓인다(나머지는 「메뉴」 단추 안에)

-- 왼쪽 아래 덩어리 안의 자리(shared/lune/ui/layout.luau의 VITALS): 윗줄에 레벨 · 이름, 그 아래 체력 바(숫자는 바 안), 가는 경험치 줄과 %
function Hud.layout()
	local v = UI.hud.vitals
	return { nameY = V.nameY, hpY = V.hpY, hpTextW = V.barW - V.hpPad * 2, xpY = V.xpY, xpTextX = V.barW + V.xpGap, xpTextW = v.w - V.barW - V.xpGap }
end

function Hud.init()
	local root = Stage.group(Stage.ui, "Hud", 100)
	Hud.root = root

	-- 왼쪽 아래 덩어리: 레벨(노랑) · 이름 / 체력 바 — 숫자는 바 안에 / 가는 경험치 줄과 그 옆의 %
	local v = UI.hud.vitals
	local L = Hud.layout()
	local box = Stage.placeRect(root, "Vitals", v)
	Hud.vitalsBox = box
	Hud.level = Ui.text(box, "Lv.1", 0, L.nameY, 60, { color = C.gold, outline = true })
	Hud.name = Ui.text(box, "", 40, L.nameY, v.w - 40, { outline = true })
	Hud.hp = Ui.bar(box, 0, L.hpY, V.barW, V.hpH, C.hp, C.hpDark)
	-- 체력이 닳고 찰 때의 효과(사용자 2026-10-13: "체력 다는거나  회복되는게 잘 보이지않습니다. 효과가 좀 들어가야해요"):
	--  띠 안에 닳은 자리(밝은 색) · 찬 자리(풀빛)를 빨간 띠 아래에 깔고, 번쩍임을 맨 위에 덮는다. 띠 오른쪽 위에 「-23 · +60」이 떠오른다. 셈은 shared/lune/ui/hpFx.luau, 장마다 Hud.step이 그린다
	do
		local F = HpFx.F
		local function hex(h: string): Color3
			return Color3.fromRGB(tonumber(h:sub(2, 3), 16) :: number, tonumber(h:sub(4, 5), 16) :: number, tonumber(h:sub(6, 7), 16) :: number)
		end
		Hud.hpIn = { w = V.barW - 2, h = V.hpH - 2 }
		Hud.hpLag = Ui.box(Hud.hp.frame, 1, 1, 0, Hud.hpIn.h, hex(F.lagColor))
		Hud.hpLag.Name = "Lag"
		Hud.hpGain = Ui.box(Hud.hp.frame, 1, 1, 0, Hud.hpIn.h, hex(F.gainColor))
		Hud.hpGain.Name = "Gain"
		Hud.hp.fill.ZIndex = 2 -- 빨간 띠는 그 둘 위에
		Hud.hpLag.ZIndex, Hud.hpGain.ZIndex = 1, 1
		Hud.hpFlash = Ui.box(Hud.hp.frame, 1, 1, Hud.hpIn.w, Hud.hpIn.h, Color3.new(1, 1, 1))
		Hud.hpFlash.Name = "Flash"
		Hud.hpFlash.ZIndex = 3
		Hud.hpFlash.BackgroundTransparency = 1
		Hud.hpFlashHeal = hex(F.gainColor)
		Hud.hpDelta = Ui.text(box, "", 0, L.hpY - M.small - 1, V.barW, { align = "right", outline = true })
		Hud.hpFx = HpFx.new()
	end
	Hud.hpText = Ui.text(box, "", V.hpPad, L.hpY + math.floor((V.hpH - M.small) / 2), L.hpTextW, { align = "center" })
	Hud.hpText.label.Frame.ZIndex = 6
	Hud.hpTextWidth = L.hpTextW
	Hud.xp = Ui.bar(box, 0, L.xpY, V.barW, V.xpH, C.accent)
	Hud.xp.frame.Name = "Xp"
	Hud.xpText = Ui.text(box, "0.00%", L.xpTextX, L.xpY - 3, L.xpTextW, { color = C.dim, outline = true })
	-- 경험치 줄의 설명(2026-10-18 — 공방 ui.js XPTIP): 줄(과 그 옆의 %)에 마우스를 올리면(폰은 톡 — 한 번 더 톡 하면 닫힘) 덩어리 위에 지금 · 필요한 경험치와 남은 것
	local xpOver = Instance.new("TextButton")
	xpOver.Name = "XpOver"
	xpOver.Text = ""
	xpOver.BackgroundTransparency = 1
	xpOver.Position = UDim2.fromOffset(0, L.xpY - 5)
	xpOver.Size = UDim2.fromOffset(UI.hud.vitals.w, V.xpH + 10)
	xpOver.ZIndex = 8
	xpOver.Parent = box
	xpOver.MouseEnter:Connect(function()
		if not touching() then -- 손가락은 Activated로만(누를 때도 MouseEnter가 온다)
			Hud.showXpTip(box)
		end
	end)
	xpOver.MouseLeave:Connect(function()
		if not touching() then
			Hud.hideXpTip()
		end
	end)
	xpOver.Activated:Connect(function(input)
		if input and input.UserInputType == Enum.UserInputType.Touch and Hud.xpTip then
			Hud.hideXpTip()
		else
			Hud.showXpTip(box)
		end
	end)

	-- 스킬 칸: 어두운 칸에 그림 · 개수(오른쪽 아래) · 다시 쓰기까지 남은 시간(어두운 덮개와 초). 키 이름은 칸 위의 딱지에 적는다(그림을 가리지 않게).
	--  퀵슬롯이다: 칸마다 키가 하나 붙어 있고, 물약 · 스킬을 칸에 놓아 쓴다(아래의 「퀵슬롯」)
	local s = UI.hud.skills
	Hud.skillRoot = Stage.placeRect(root, "Skills", s)
	Hud.slots = {}
	for i = 1, COLS * ROWS do
		local cell = Ui.slot(Hud.skillRoot, 0, 0, SLOT)
		cell.frame.Name = "Slot" .. i
		local pad = math.floor((SLOT - PIC) / 2)
		local pic = Ui.pic(cell.frame, nil, pad, pad)
		local veil = Ui.box(cell.frame, pad, pad, PIC, PIC, C.ink, 0.35)
		veil.Name = "Veil"
		veil.ZIndex = 3
		veil.Visible = false
		-- 다시 쓰기가 끝난 순간 그림이 한 번 하얗게 번쩍인다(2026-10-18 — 시험 탭의 sk.flash와 같다 · Hud.step이 흐리게 한다)
		local ready = Ui.box(cell.frame, pad, pad, PIC, PIC, Color3.new(1, 1, 1), 1)
		ready.Name = "Ready"
		ready.ZIndex = 4
		ready.Visible = false
		local slot = { frame = cell.frame, cell = cell, back = cell.frame:FindFirstChild("uSlot") :: ImageLabel, pic = pic, veil = veil, ready = ready, readyT = 0, pad = pad, what = false :: any, id = nil :: string?, shown = nil :: string?, keyName = "" }
		-- 퀵슬롯은 자리가 늘 같다(여섯 x 두 줄 — 칸마다 키 하나)
		local px, py = Layout.slotPlace(i, COLS * ROWS)
		cell.frame.Position = UDim2.fromOffset(px, py)
		-- 누르는 자리: 칸과 그 위의 키 딱지까지. 스킬 창이 열려 있을 때 칸을 누르거나 끌어 고친다(ui/quickEdit.luau가 받는다)
		local hit = Instance.new("TextButton")
		hit.Name = "Hit"
		hit.Text = ""
		hit.BackgroundTransparency = 1
		hit.Position = UDim2.fromOffset(0, -KEY_UP)
		hit.Size = UDim2.fromOffset(SLOT, SLOT + KEY_UP)
		hit.ZIndex = 9
		hit.Parent = cell.frame
		hit.Activated:Connect(function()
			if Hud.onSlotClick then
				Hud.onSlotClick(i)
			end
		end)
		hit.InputBegan:Connect(function(input)
			if Hud.onSlotPress then
				Hud.onSlotPress(i, input)
			end
		end)
		-- 칸의 설명(2026-10-18 — 메이플처럼 · PC): 마우스를 올리면 칸 위에 그 스킬 · 물건의 이름 · 효과(스킬 창을 열어 고치는 중이거나 끄는 중에는 띄우지 않는다)
		hit.MouseEnter:Connect(function()
			if not touching() then
				Hud.showSlotTip(i)
			end
		end)
		hit.MouseLeave:Connect(function()
			if Hud.slotTipAt == i then
				Hud.hideSlotTip()
			end
		end)
		slot.key = Ui.keycap(cell.frame, "", math.floor(SLOT / 2), -KEY_UP)
		slot.count = Ui.text(cell.frame, "", 0, SLOT - 11, SLOT - 2, { align = "right", outline = true, z = 6 })
		slot.wait = Ui.text(cell.frame, "", 0, math.floor((SLOT - M.small) / 2), SLOT, { align = "center", outline = true, z = 7 })
		table.insert(Hud.slots, slot)
	end
	Hud.byId = {} -- [기술 id] = 칸
	-- 놓을 스킬을 골랐을 때 칸들 위에 뜨는 안내
	Hud.pickHint = Ui.text(Hud.skillRoot, Quick.DATA.words.pick, 0, -16, s.w, { align = "center", color = C.accent, outline = true })
	Hud.pickHint:show(false)

	Hud.menuRoot = Stage.placeRect(root, "Menu", UI.hud.menu)
	-- 화면 틀의 격자가 바뀌면 단추의 간격도 바뀐다(가장 작은 격자에서는 스킬 칸에 닿지 않게 촘촘하다)
	Stage.onResize(Hud.placeMenu)
	-- 버프 자리(오른쪽 위): 켜 둔 사출기 · 직업의 장치(영혼 · 열기 · 수정)가 그림으로, 그 아래에 수(공방 「기본 · UI」 탭의 3번 칸)
	Hud.buffRoot = Stage.placeRect(root, "Buffs", UI.hud.buffs)
	Hud.buffs = {}
	return Hud
end

-- 쓰는 칸이 n개일 때 i째 칸의 자리(스킬 칸 틀 안): 여섯까지는 아랫줄에 가운데로 모으고, 일곱째부터는 윗줄에 같은 식으로.
--  줄마다 위에 키 딱지의 자리(KEY_UP)를 둔다
Hud.KEY_UP = KEY_UP
Hud.slotPlace = Layout.slotPlace

-- ---------- 퀵슬롯 ----------  사용자 2026-10-07: "스킬키를 단축키에 등록하기 쉬워야합니다 … 중앙에 있는 퀵슬롯이랑 스킬 배치랑 쉽게 되어야해요"
--  키는 칸에 붙는다(칸마다 하나). 열두 칸(두 줄)이 늘 보이고 빈 칸은 흐리다(사용자 2026-10-07: "키 위에 edrf12 이 라인도 평소에 보여야합니다").
--  공방의 횡스크롤 시험 탭(js/lune/ui/paint.js의 paintHud)과 같은 그림이다.
Hud.touchSlotAt = nil :: ((Vector2) -> number?)? -- 스마트폰의 칸 단추: 그 자리의 칸 · 고르는 중 · 끌어 올린 칸(touch.luau가 채운다)
Hud.touchPick = nil :: ((boolean) -> ())?
Hud.touchHot = nil :: ((number?) -> ())?
Hud.countOf = nil :: ((string) -> number)? -- 가방에 든 그 소비 아이템의 수(boot.luau가 넣는다 — 칸의 숫자)
Hud.onSlotClick = nil :: ((number) -> ())? -- 칸을 눌렀다
Hud.onSlotPress = nil :: ((number, InputObject) -> ())? -- 칸을 누르기 시작했다(끌기)
Hud.edit, Hud.pick, Hud.pulse, Hud.hot, Hud.top = false, false, false, nil :: number?, false
Hud.active = {} :: { [string]: boolean } -- 켜 둔 것(온오프 사출기): 그 칸에 민트 테두리가 켜진다

-- 칸들의 모습을 다시 그린다: 보이는 줄 · 빈 칸의 흐림 · 반짝임(놓을 스킬을 골랐을 때) · 마우스가 올라간 칸
function Hud.paintSlots()
	for i, slot in Hud.slots do
		slot.frame.Visible = true
		local on = (Hud.pick and Hud.pulse) or Hud.hot == i or (slot.what ~= false and Hud.active[slot.what] == true)
		slot.cell:setOn(on)
		slot.back.ImageTransparency = if slot.what or on then 0 else 1 - Quick.DATA.emptyAlpha
		slot.key:color(if slot.what then C.text else C.dim)
	end
	Hud.pickHint:show(Hud.pick)
end

-- 가방이 바뀌었다: 소비 아이템이 놓인 칸의 숫자를 다시 적는다(다 쓰면 0 — 칸에는 남는다)
function Hud.setCounts()
	for _, slot in Hud.slots do
		if slot.item then
			local n = if Hud.countOf then Hud.countOf(slot.item) else 0
			slot.count:set(tostring(n))
			slot.count:color(if n == 0 then C.red else C.text) -- 다 쓴 소비 아이템은 붉은 0(2026-10-18)
		end
	end
end

-- 칸마다 놓인 것을 그린다. list[i] = { what = 스킬 · 소비 아이템의 이름표 · false, key = 그 칸의 키 이름 }
function Hud.setSlots(list)
	table.clear(Hud.byId)
	Hud.top = false
	for i, slot in Hud.slots do
		local it = list[i]
		local what = if it then it.what or false else false
		slot.what = what
		local goods = if what then Quick.item(what) else nil
		slot.id = if what and not goods then what else nil -- 스킬(다시 쓰기까지의 시간이 덮인다)
		slot.item = if goods then what else nil -- 소비 아이템(가방에 든 수가 적힌다)
		slot.keyName = if it then Format.keyShort(it.key) else ""
		Ui.setPic(slot.pic, if what then Quick.pic(what) else nil)
		slot.key:set(slot.keyName)
		slot.veil.Visible = false
		slot.wait:set("")
		slot.shown = nil
		local n = if slot.item and Hud.countOf then Hud.countOf(slot.item) else 0
		slot.count:set(if slot.item then tostring(n) else "")
		slot.count:color(if slot.item and n == 0 then C.red else C.text)
		if slot.id then
			Hud.byId[slot.id] = slot
		end
		if i > COLS and what then
			Hud.top = true
		end
	end
	Hud.paintSlots()
end

-- ---------- 칸의 설명(2026-10-18) ----------  글은 boot가 짓는다(Hud.slotTipOf(what) → { kind, title, tag, lines } · 없으면 띄우지 않는다)
Hud.slotTipOf = nil :: ((string) -> any)?
Hud.slotTipAt = nil :: number?
local slotTip: Frame? = nil
function Hud.hideSlotTip()
	if slotTip then
		slotTip:Destroy()
		slotTip = nil
	end
	Hud.slotTipAt = nil
end
function Hud.showSlotTip(i: number)
	Hud.hideSlotTip()
	local slot = Hud.slots[i]
	if not slot or not slot.what or Hud.edit or Hud.pick or Hud.touch or not Hud.slotTipOf then
		return
	end
	local t = Hud.slotTipOf(slot.what)
	if not t then
		return
	end
	local frame, h = Hud.tipPanel(Hud.skillRoot, t, "SlotTip")
	local px = Layout.slotPlace(i, COLS * ROWS)
	local w = UI.hud.skills.w
	frame.Position = UDim2.fromOffset(math.clamp(px + math.floor(SLOT / 2) - math.floor(TIP.w / 2), math.min(0, w - TIP.w), math.max(0, w - TIP.w)), -h - 4) -- 퀵슬롯 덩어리 위에(위 칸을 가리지 않게)
	slotTip = frame
	Hud.slotTipAt = i
end

-- 그 칸의 키 이름(딱지에 적힌 것)
function Hud.slotKey(i: number): string
	return Hud.slots[i].keyName
end

-- 고치는 중인가(스킬 창이 열려 있다): 윗줄까지 다 보인다
function Hud.setEdit(on: boolean)
	Hud.edit = on
	Hud.paintSlots()
end

-- 놓을 스킬을 골랐다 · 끌고 있다: 칸들이 반짝인다
local pulseConn: RBXScriptConnection? = nil
function Hud.setPick(on: boolean)
	if Hud.pick == on then
		return
	end
	Hud.pick = on
	if Hud.touchPick then
		Hud.touchPick(on) -- 스마트폰: 칸 단추들이 밝아진다(touch.luau)
	end
	if pulseConn then
		pulseConn:Disconnect()
		pulseConn = nil
	end
	if on then
		local half = Quick.DATA.blink / 2
		Hud.pulse = true
		pulseConn = RunService.Heartbeat:Connect(function()
			local now = math.floor(os.clock() / half) % 2 == 0
			if now ~= Hud.pulse then
				Hud.pulse = now
				Hud.paintSlots()
			end
		end)
	end
	Hud.paintSlots()
end

-- 마우스가 올라간 칸(끌고 있을 때)
function Hud.setHot(i: number?)
	if Hud.hot ~= i then
		Hud.hot = i
		if Hud.touchHot then
			Hud.touchHot(i)
		end
		Hud.paintSlots()
	end
end

-- 화면의 그 자리(입력의 자리)에 있는 칸. 키 딱지까지 그 칸으로 친다
function Hud.slotAt(at: Vector2): number?
	if Hud.touch and Hud.touchSlotAt then
		return Hud.touchSlotAt(at) -- 스마트폰: 화면의 칸 단추가 PC의 칸과 같은 것이다(touch.luau)
	end
	for i, slot in Hud.slots do
		if slot.frame.Visible and Hud.skillRoot.Visible then
			local p, size = slot.frame.AbsolutePosition, slot.frame.AbsoluteSize
			local up = size.Y * KEY_UP / SLOT
			if at.X >= p.X and at.X < p.X + size.X and at.Y >= p.Y - up and at.Y < p.Y + size.Y then
				return i
			end
		end
	end
	return nil
end

-- 기술을 다시 쓰기까지 남은 시간(초). total = 그 기술의 다시 쓰기 시간. 화면마다 불러도 된다(바뀔 때만 고쳐 그린다)
function Hud.setCooldown(id: string, remain: number, total: number)
	local slot = Hud.byId[id]
	if not slot then
		return
	end
	local rows = if remain > 0 and total > 0 then math.clamp(math.ceil(PIC * remain / total), 1, PIC) else 0
	local text = if remain >= 1 then tostring(math.ceil(remain)) else ""
	local key = rows .. ":" .. text
	if slot.shown == key then
		return
	end
	if slot.veil.Visible and rows == 0 then
		slot.readyT = Hud.READY_T -- 다시 쓰기가 끝났다: 한 번 하얗게
	end
	slot.shown = key
	slot.veil.Visible = rows > 0
	slot.veil.Position = UDim2.fromOffset(slot.pad, slot.pad + (PIC - rows))
	slot.veil.Size = UDim2.fromOffset(PIC, rows)
	slot.wait:set(text)
end

-- 메뉴 단추: 창마다 그림 단추 하나, 그 아래에 이름(그림만으로는 무엇을 여는지 모른다 — 사용자 2026-10-07 "무슨기능인지 인지가 하나도안됩니다").
-- 메뉴 단추들을 지금의 격자에 맞는 간격으로 놓는다
function Hud.placeMenu()
	for _, item in Hud.menu or {} do
		item.frame.Position = UDim2.fromOffset(Layout.menuX(item.i, item.n, Stage.uiW), 0)
	end
end

--  누르면 그 창이 열린다. list = { { id, name, key } … } — 여덟까지, 오른쪽 끝에 붙여 놓는다
function Hud.setMenu(list, onClick: (string) -> ())
	for _, old in Hud.menu or {} do
		old.frame:Destroy()
	end
	Hud.menu = {}
	local r = UI.hud.menu
	local n = math.min(#list, Hud.MENU_MAX)
	local s = MN.slot
	for i, item in list do
		if i > Hud.MENU_MAX then
			break -- 칸을 넘는 것은 그리지 않는다
		end
		local frame = Ui.group(Hud.menuRoot, Layout.menuX(i, n, Stage.uiW), 0, s, r.h, "Menu_" .. item.id)
		local cell = Ui.slot(frame, 0, 0, s)
		Ui.pic(cell.frame, MENU_PIC[item.id] or "menu_gear", math.floor((s - PIC) / 2), math.floor((s - PIC) / 2))
		-- 이름은 칸보다 넓을 수 있다(「퀘스트」) — 칸의 가운데에 맞춰 옆 칸과의 사이까지 쓴다
		local label = Ui.text(frame, Layout.menuLabel(item.id, item.name), -math.floor((MN.labelW - s) / 2), MN.labelY, MN.labelW, { align = "center", outline = true })
		-- 눈에 띄게 하는 표시: 오른쪽 위의 노란 점(찍을 점수가 남았다) · 반짝임(새로 생겼다)
		local dot = Ui.box(frame, s - 5, -1, 6, 6, C.ink)
		Ui.box(dot, 1, 1, 4, 4, C.gold)
		dot.ZIndex = 7
		dot.Visible = false
		local flash = Ui.box(frame, 1, 1, s - 2, s - 2, C.text, 0.4)
		flash.ZIndex = 8
		flash.Visible = false
		local hit = Ui.hit(frame)
		hit.Activated:Connect(function()
			onClick(item.id)
		end)
		frame.Visible = not Hud.touch
		Hud.menu[item.id] = { frame = frame, cell = cell, label = label, dot = dot, flash = flash, mark = false, i = i, n = n }
	end
	Hud.setOpen(Hud.openSet or {})
	for id, on in Hud.marks do -- 단추를 다시 지어도 점은 그대로(가방이 가득 찼다 · 찍을 점수 … — 2026-10-18)
		Hud.markMenu(id, on)
	end
end

-- 열려 있는 창의 단추는 민트(테두리와 이름). set = { [창 id] = true }
function Hud.setOpen(set)
	Hud.openSet = set
	for id, item in Hud.menu or {} do
		local on = set[id] == true
		item.cell:setOn(on)
		item.label:color(if on then C.accent else C.text)
	end
end

-- 켜 둔 것(온오프 사출기)의 이름표들: 그 칸에 테두리가 켜진다
function Hud.setActive(ids: { [string]: boolean })
	Hud.active = ids
	Hud.paintSlots()
end

-- 버프 자리를 그린다. list = { { pic = 그림(화면의 24도트 그림 이름), text = 그림 아래의 글(수 · 없으면 ""), hot = 밝게(달아오름) } … } — 오른쪽 끝부터 왼쪽으로 놓는다
local BUFF_PITCH = PIC + 6
-- ---------- 버프 그림의 설명(2026-10-18 — 공방 ui.js BUFFTIP · 시험 탭의 buffTipOf) ----------
--  그림에 마우스를 올리면(폰은 톡 — 한 번 더 톡 하면 닫힌다) 버프 줄 아래에 능력치의 설명과 같은 판이 뜬다. 글은 boot의 paintBuffs가 칸마다 지어 준다(b.tip = { kind, title, tag, lines }).
--  1초마다 칸을 다시 지어도 보던 칸의 설명은 이어서 뜬다(남은 시간이 바뀐다) — 마우스가 그 칸을 벗어났으면 닫는다
local TIP_DOWN = 31 -- 판의 윗줄(버프 줄의 위에서 — 그림 밑의 남은 시간을 가리지 않게)
Hud.buffList = {}
Hud.tipAt = nil :: number? -- 설명이 떠 있는 칸의 차례
local tipFrame: Frame? = nil
local tipTouch = false -- 손가락으로 연 설명(마우스의 자리로 닫지 않는다)

function Hud.hideBuffTip()
	if tipFrame then
		tipFrame:Destroy()
		tipFrame = nil
	end
	Hud.tipAt = nil
end

-- 설명 판 하나를 parent에 짓는다(능력치의 설명과 같은 판): t = { kind, title, tag, lines }. 돌려주는 것 = 판 · 높이(자리는 부른 쪽이 놓는다)
function Hud.tipPanel(parent: Instance, t, name: string): (Frame, number)
	local color = TIPCOLOR[t.kind] or C.accent
	local inner = TIP.w - TIP.pad * 2
	local frame = Ui.group(parent, 0, 0, TIP.w, 10, name)
	frame.ZIndex = 20
	local back = Ui.part(frame, "uTip", 0, 0, TIP.w, 10)
	local title = Ui.text(frame, t.title, TIP.pad, TIP.pad, inner, { font = "body", color = color })
	if t.tag and t.tag ~= "" then
		local tw = title:size()
		Ui.text(frame, t.tag, TIP.pad + tw + 8, TIP.pad + 2, inner - tw - 8, { color = color })
	end
	local y = TIP.pad + TIP.title
	for k, line in t.lines do
		if line ~= "" then
			local tint = if k > 1 then (if t.kind == "none" then C.dim else C.accent) elseif t.kind == "none" then C.red else C.text
			local label = Ui.text(frame, line, TIP.pad, y, inner, { lines = TIP.lines, line = TIP.line, color = tint })
			local _, lh = label:size()
			y += math.max(1, math.floor(lh / TIP.line + 0.5)) * TIP.line
		end
	end
	local h = y - (TIP.line - M.small) + TIP.pad
	frame.Size = UDim2.fromOffset(TIP.w, h)
	back.Size = UDim2.fromOffset(TIP.w, h)
	return frame, h
end

function Hud.showBuffTip(i: number)
	if tipFrame then
		tipFrame:Destroy()
		tipFrame = nil
	end
	local b = Hud.buffList[i]
	if not b or not b.tip then
		Hud.tipAt = nil
		return
	end
	Hud.tipAt = i
	local frame = Hud.tipPanel(Hud.buffRoot, b.tip, "BuffTip")
	-- 그 그림의 오른쪽 끝에 맞춘다 — 화면 왼쪽 밖으로 나가면 민다
	local left = UI.hud.buffs.w - i * BUFF_PITCH + 6 + PIC - TIP.w
	local rootX = (Hud.buffRoot.AbsolutePosition.X - Stage.ui.AbsolutePosition.X) / Stage.uiScale -- (기준 격자 안의 자리 — 넓은 화면의 검은 띠를 빼고)
	if rootX + left < 4 then
		left = 4 - rootX
	end
	frame.Position = UDim2.fromOffset(left, TIP_DOWN)
	tipFrame = frame
end

-- 마우스가 아직 그 칸 위에 있나(칸을 다시 지은 뒤 — 새 칸에는 MouseEnter가 오지 않을 수 있다)
local function stillOver(frame: GuiObject): boolean
	local at = game:GetService("UserInputService"):GetMouseLocation() - game:GetService("GuiService"):GetGuiInset()
	local p, s = frame.AbsolutePosition, frame.AbsoluteSize
	return at.X >= p.X and at.X < p.X + s.X and at.Y >= p.Y and at.Y < p.Y + s.Y
end

function Hud.setBuffs(list)
	local key = {}
	for i, b in list do
		key[i] = b.pic .. ":" .. b.text .. ":" .. tostring(b.hot == true)
	end
	local sig = table.concat(key, "|")
	Hud.buffList = list
	if Hud.buffSig == sig then
		return
	end
	Hud.buffSig = sig
	-- 보던 칸의 설명을 새 글로(그 칸이 없어졌거나 마우스가 벗어났으면 닫는다)
	local function refreshTip()
		local at = Hud.tipAt
		if at then
			local item = Hud.buffs[at]
			if item and (tipTouch or stillOver(item.frame)) then
				Hud.showBuffTip(at)
			else
				Hud.hideBuffTip()
			end
		end
	end
	-- 그림 · 차례 · 강조가 그대로면(1초마다 남은 초만 바뀐다) 칸을 다시 짓지 않고 글만 바꾼다(2026-10-18 검토 — 1초마다 칸마다 7개를 만들고 지웠다)
	local shapeKey = {}
	for i, b in list do
		shapeKey[i] = b.pic .. ":" .. tostring(b.hot == true) .. ":" .. tostring(b.text ~= "")
	end
	local shape = table.concat(shapeKey, "|")
	if Hud.buffShape == shape and #Hud.buffs == #list then
		for i, b in list do
			local item = Hud.buffs[i]
			if item.label and item.text ~= b.text then
				item.label:set(b.text)
				item.text = b.text
			end
		end
		refreshTip()
		return
	end
	Hud.buffShape = shape
	for _, item in Hud.buffs do
		item.frame:Destroy()
	end
	table.clear(Hud.buffs)
	local w = UI.hud.buffs.w
	for i, b in list do
		local frame = Ui.group(Hud.buffRoot, w - i * BUFF_PITCH + 6, 0, PIC, PIC + 14, "Buff" .. i)
		Ui.pic(frame, b.pic, 0, 0)
		if b.hot then
			local edge = Instance.new("UIStroke")
			edge.Color = C.accent
			edge.Thickness = 1
			edge.Parent = frame:FindFirstChild("Pic") or frame
		end
		local label = nil
		if b.text ~= "" then
			label = Ui.text(frame, b.text, -8, PIC + 2, PIC + 16, { align = "center", outline = true, color = if b.hot then C.gold else C.text })
		end
		-- 설명(마우스를 올리면 · 손가락으로 톡)
		local over = Instance.new("TextButton")
		over.Name = "Over"
		over.Text = ""
		over.BackgroundTransparency = 1
		over.Size = UDim2.fromOffset(PIC, PIC + 14)
		over.ZIndex = 8
		over.Parent = frame
		over.MouseEnter:Connect(function()
			if touching() then
				return -- 손가락은 Activated로만
			end
			tipTouch = false
			Hud.showBuffTip(i)
		end)
		over.MouseLeave:Connect(function()
			if Hud.tipAt == i and not tipTouch and not touching() then
				Hud.hideBuffTip()
			end
		end)
		over.Activated:Connect(function(input)
			local touch = input and input.UserInputType == Enum.UserInputType.Touch
			if touch and Hud.tipAt == i then
				Hud.hideBuffTip()
			else
				tipTouch = touch == true
				Hud.showBuffTip(i)
			end
		end)
		Hud.buffs[i] = { frame = frame, label = label, text = b.text }
	end
	refreshTip()
end

-- 스마트폰 단추가 켜지면 키가 적힌 칸(스킬 칸 · 메뉴 단추)은 숨긴다 — 그 자리에 손가락 단추가 온다
--  체력 덩어리는 아래 가운데로 옮긴다(왼쪽 아래에는 이동 패드가 온다 — data/ui.generated.luau의 hudTouch)
function Hud.setTouch(on: boolean)
	Hud.touch = on
	local v = if on and UI.hudTouch.vitals then UI.hudTouch.vitals else UI.hud.vitals
	Hud.vitalsBox.Position = Stage.atPosition(v.at, v.x, v.y)
	-- 버프 자리: 스마트폰에서는 오른쪽 위의 「메뉴」 단추만큼 왼쪽으로
	local bf = if on and UI.hudTouch.buffs then UI.hudTouch.buffs else UI.hud.buffs
	Hud.buffRoot.Position = Stage.atPosition(bf.at, bf.x, bf.y)
	Hud.skillRoot.Visible = not on and not Hud.locked
	for _, item in Hud.menu or {} do
		item.frame.Visible = not on
	end
end

-- 메뉴 단추를 눈에 띄게(찍을 점수가 남았을 때 등)
Hud.marks = {} :: { [string]: boolean } -- 단추마다 점이 켜져 있어야 하는가(단추를 다시 지을 때 되살린다)
function Hud.markMenu(id: string, on: boolean)
	Hud.marks[id] = on
	local item = Hud.menu and Hud.menu[id]
	if item and item.mark ~= on then
		item.mark = on
		item.dot.Visible = on
	end
end

-- 새로 생긴 메뉴 단추는 한 번 반짝인다(공방의 화면 규칙: 쓸 때가 되면 하나씩 생기고, 생길 때 한 번 반짝인다)
function Hud.flashMenu(id: string)
	local item = Hud.menu and Hud.menu[id]
	if not item or item.flashing then
		return
	end
	item.flashing = true
	task.spawn(function()
		for i = 1, 8 do
			if not item.frame.Parent then
				return
			end
			item.flash.Visible = i % 2 == 1
			task.wait(0.14)
		end
		item.flashing = false
		if item.frame.Parent then
			item.flash.Visible = false
		end
	end)
end

-- 왼쪽 아래 덩어리에 적는 내 이름
function Hud.setName(name: string)
	Hud.name:set(name)
end

-- 경험치의 % 글(소수 둘째 자리까지 — 메이플처럼)
function Hud.xpLabel(xp: number, need: number): string
	return ("%.2f%%"):format(math.clamp(xp / math.max(1, need), 0, 1) * 100)
end

-- 내 상태(서버가 보낸 것)를 그린다
-- 스킬 칸을 잠근다: 새 캐릭터는 사제에게 첫 기술을 배운 뒤에 칸이 생긴다(공방 basics.js의 UNLOCK — "스킬 칸: 사당을 나서면")
Hud.locked = false
function Hud.setLocked(on: boolean)
	if Hud.locked ~= on then
		Hud.locked = on
		Hud.skillRoot.Visible = not Hud.touch and not on
	end
end

-- 체력 바를 효과의 상태대로 그린다
function Hud.drawHp()
	local st, I = Hud.hpFx, Hud.hpIn
	if st.fill == nil then
		return
	end
	local function px(v: number): number
		return math.floor(I.w * math.clamp(v, 0, 1) + 0.5)
	end
	Hud.hp:set(st.fill)
	Hud.hpLag.Size = UDim2.fromOffset(if st.lag > st.fill then px(st.lag) else 0, I.h)
	Hud.hpGain.Size = UDim2.fromOffset(if st.gain > st.fill then px(st.gain) else 0, I.h)
	Hud.hpFlash.BackgroundColor3 = if st.kind == "heal" then Hud.hpFlashHeal else Color3.new(1, 1, 1)
	Hud.hpFlash.BackgroundTransparency = 1 - HpFx.F.flashA * st.flash / HpFx.F.flash
	local text, up = HpFx.deltaText(st)
	Hud.hpDelta:set(text or "")
	if text then
		Hud.hpDelta:color(if st.delta > 0 then C.green else C.red)
		Hud.hpDelta:move(0, Hud.layout().hpY - M.small - 1 - up)
	end
end

-- 장마다(boot의 그리는 고리가 부른다): 체력 바의 효과를 흘려보낸다
Hud.READY_T = 0.3 -- 다시 쓰기가 끝난 칸이 하얗게 번쩍이는 시간(초)
function Hud.step(dt: number)
	local st = Hud.hpFx
	if st and not HpFx.idle(st) then
		HpFx.step(st, dt)
		Hud.drawHp()
	end
	for _, slot in Hud.slots or {} do
		if slot.readyT > 0 then
			slot.readyT = math.max(0, slot.readyT - dt)
			slot.ready.Visible = slot.readyT > 0
			slot.ready.BackgroundTransparency = 1 - 0.6 * slot.readyT / Hud.READY_T
		end
	end
end

-- 다른 캐릭터로 들어왔다: 앞 캐릭터의 체력과 견주어 효과가 뜨지 않게 처음으로 돌린다
function Hud.resetHp()
	Hud.hpFx = HpFx.new()
	if Hud.hpDelta then
		Hud.hpDelta:set("")
		Hud.hpFlash.BackgroundTransparency = 1
		Hud.hpLag.Size = UDim2.fromOffset(0, Hud.hpIn.h)
		Hud.hpGain.Size = UDim2.fromOffset(0, Hud.hpIn.h)
	end
end

-- 경험치 줄의 설명: 덩어리(box) 위에 — 지금 / 필요한 경험치(%) · 다음 레벨까지
Hud.xpTip = nil :: Frame?
Hud.lastXp = nil :: { xp: number, need: number, level: number }?
function Hud.hideXpTip()
	if Hud.xpTip then
		Hud.xpTip:Destroy()
		Hud.xpTip = nil
	end
end
function Hud.xpTipText(xp: number, need: number, level: number)
	local W = UI.xpTip
	local pct = ("%.2f"):format(math.clamp(xp / math.max(1, need), 0, 1) * 100)
	return { kind = "main", title = W.title, tag = "Lv." .. level, lines = { Format.fill(W.now, { xp = Format.comma(xp), need = Format.comma(need), pct = pct }), Format.fill(W.left, { n = Format.comma(math.max(0, need - xp)) }) } }
end
function Hud.showXpTip(box: Instance)
	Hud.hideXpTip()
	local x = Hud.lastXp
	if not x then
		return
	end
	local frame, h = Hud.tipPanel(box, Hud.xpTipText(x.xp, x.need, x.level), "XpTip")
	frame.Position = UDim2.fromOffset(0, -h - 6)
	Hud.xpTip = frame
end

function Hud.setSelf(me)
	Hud.lastXp = { xp = me.xp, need = me.need, level = me.level }
	if Hud.xpTip then
		Hud.showXpTip(Hud.xpTip.Parent :: Instance) -- 떠 있는 동안 경험치가 오르면 새 수로
	end
	local level = "Lv." .. me.level
	Hud.level:set(level)
	Hud.name:move(Ui.measure(level) + V.nameGap, V.nameY) -- 이름은 레벨 글 바로 뒤에
	Hud.name.label:SetMaxWidth(UI.hud.vitals.w - Ui.measure(level) - V.nameGap, 1)
	Hud.hpText:set(Format.hp(me.hp, me.maxHp, Hud.hpTextWidth, Ui.measure))
	HpFx.set(Hud.hpFx, math.clamp(me.hp / math.max(1, me.maxHp), 0, 1), me.hp) -- 띠는 Hud.step이 효과와 함께 그린다
	Hud.drawHp()
	Hud.xp:set(me.xp / math.max(1, me.need))
	Hud.xpText:set(Hud.xpLabel(me.xp, me.need))
	Hud.markMenu("stat", me.ap > 0)
	Hud.markMenu("skill", me.sp > 0)
end

return Hud

end
MODULES['Client/lune/input'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 조작 입력. 기본 키는 공방 「기본 · UI」 탭의 키 표를 따른다(← → 걷기 · ↑ 문과 주민 · ↓ 아래 발판 · Space 뛰기).
--  키는 "하는 일 → 키" 표(BIND)를 거쳐 읽는다 — 유저가 키를 바꾸는 화면(키 설정)이 이 표를 고치게 된다.
--  스마트폰 단추(터치)도 같은 "하는 일" 이름으로 Input.press / Input.release를 부른다.
local UserInputService = game:GetService("UserInputService")

local Input = {}

-- 하는 일 → 기본 키
Input.BIND = {
	left = Enum.KeyCode.Left,
	right = Enum.KeyCode.Right,
	up = Enum.KeyCode.Up,
	down = Enum.KeyCode.Down,
	jump = Enum.KeyCode.Space,
	pickup = Enum.KeyCode.Z, -- 떨어진 것 줍기(누르고 있으면 차례로 줍는다)
	ride = Enum.KeyCode.N, -- 탈것 타기 · 내리기(2026-10-20 — 제가 정한 키: 다른 일이 쓰지 않는 글쇠)
}
-- 물약과 기술의 키는 여기에 없다 — 키는 퀵슬롯의 칸에 붙는다("slot:<칸>" — boot.luau가 묶는다). 스마트폰 단추는 "potion" · "skill:<기술 id>"를 그대로 누른다(키 없이 Input.press로)

-- 하는 일에 키를 묶는다: action = "slot:<칸>" · "win:<창>"
function Input.bind(action: string, key: Enum.KeyCode)
	Input.BIND[action] = key
end

local defaults: { [string]: Enum.KeyCode } = {}
local captureFn: ((Enum.KeyCode) -> ())? = nil

-- 다음에 누르는 키 하나를 가로챈다(키 설정 창이 쓴다). nil을 주면 그만둔다
function Input.capture(fn: ((Enum.KeyCode) -> ())?)
	captureFn = fn
end

-- 하는 일의 키를 바꾼다. 그 키를 이미 다른 일이 쓰고 있으면 둘이 자리를 바꾼다
function Input.rebind(action: string, key: Enum.KeyCode)
	local old = Input.BIND[action]
	for other, bound in Input.BIND do
		if other ~= action and bound == key then
			Input.BIND[other] = old
		end
	end
	Input.BIND[action] = key
end

-- 지금의 표를 "기본"으로 적어 둔다(기술 · 창의 키까지 다 묶은 뒤에 한 번 부른다)
function Input.markDefaults()
	defaults = table.clone(Input.BIND)
end

function Input.reset()
	for action, key in defaults do
		Input.BIND[action] = key
	end
end

-- 저장할 꼴: 기본과 다른 것만 { [하는 일] = 키 이름 }
function Input.export()
	local out = {}
	for action, key in Input.BIND do
		if defaults[action] ~= key then
			out[action] = key.Name
		end
	end
	return out
end

-- 저장된 것을 입힌다(모르는 일 · 모르는 키는 건너뛴다)
function Input.import(map)
	if typeof(map) ~= "table" then
		return
	end
	for action, name in map do
		if Input.BIND[action] ~= nil and typeof(name) == "string" then
			local ok, key = pcall(function()
				return (Enum.KeyCode :: any)[name]
			end)
			if ok and key then
				Input.rebind(action, key)
			end
		end
	end
end

local held: { [string]: boolean } = {}
local pressed: { [string]: boolean } = {} -- 누른 순간(한 번 읽으면 지워진다)

function Input.press(action: string)
	if not held[action] then
		pressed[action] = true
	end
	held[action] = true
end

function Input.release(action: string)
	held[action] = nil
end

function Input.held(action: string): boolean
	return held[action] == true
end

-- 읽지 않은 「누른 순간」을 모두 버린다(누르고 있는 것은 그대로) — 막이 걷히거나 · 일어나거나 · 장면이 끝나 조작이 돌아올 때(2026-10-18 검토:
--  문을 지나며 화면이 까만 동안 ↑를 한 번 더 누르면, 막이 걷히자마자 그 ↑로 들어온 문을 다시 지나 되돌아갔다 — 기술 · 뛰기 · 창 열기도 같았다)
function Input.flush()
	table.clear(pressed)
end

-- 누른 순간이었는가(읽으면 지운다)
function Input.take(action: string): boolean
	local was = pressed[action] == true
	pressed[action] = nil
	return was
end

function Input.axis(): number
	return (if held.right then 1 else 0) - (if held.left then 1 else 0)
end

local function actionOf(key: Enum.KeyCode): string?
	for action, bound in Input.BIND do
		if bound == key then
			return action
		end
	end
	return nil
end

-- Roblox 채팅의 입력줄에 글을 치는 중인가(boot가 chat.luau의 Chat.focused를 넣는다). 그 입력줄은 Roblox의 화면이라 GetFocusedTextBox로는 보이지 않는다 —
--  이것을 보지 않으면 채팅에 친 글자(Q · W · A …)가 스킬로 나간다(2026-10-13: 채팅을 Roblox의 기본 채팅으로 바꿨다. Enter로 열던 우리 채팅 판은 없다)
Input.typing = nil :: (() -> boolean)?
Input.paused = false -- 캐릭터 고르기 화면에 가 있는 동안에는 게임의 키를 받지 않는다(boot.luau의 toSelect)

function Input.init()
	UserInputService.InputBegan:Connect(function(input)
		-- 로블록스 기본 조작이 방향키를 먼저 가져가므로 "처리됨" 표시는 보지 않는다. 글자를 치는 중(채팅 등)에만 받지 않는다.
		if input.UserInputType ~= Enum.UserInputType.Keyboard or UserInputService:GetFocusedTextBox() or Input.paused or (Input.typing ~= nil and Input.typing()) then
			return -- paused = 캐릭터 고르기 화면에 가 있다(게임의 키를 받지 않는다)
		end
		if captureFn then
			-- 키 설정 중: 이 키를 새 키로 넘긴다(Esc와 알 수 없는 키는 받지 않는다)
			if input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode ~= Enum.KeyCode.Unknown then
				local fn = captureFn
				captureFn = nil
				fn(input.KeyCode)
			end
			return
		end
		local action = actionOf(input.KeyCode)
		if action then
			Input.press(action)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local action = actionOf(input.KeyCode)
		if action then
			Input.release(action)
		end
	end)
	-- 창이 뒤로 가면 누르고 있던 키를 모두 뗀 것으로 친다
	UserInputService.WindowFocusReleased:Connect(function()
		table.clear(held)
		table.clear(pressed)
	end)
end

return Input

end
MODULES['Client/lune/mapName'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 맵 이름 — 맵에 들어서면 화면 위 가운데에 지역 이름(작은 글)과 맵 이름(본문 글)이 잠깐 떴다가 흐려진다(메이플스토리처럼).
--  2026-10-18: 미니맵을 두지 않기로 해서(사용자 2026-10-07) 지금 어느 맵인지 알려 주는 것이 화면에 없었다 — 월드맵을 열어야만 알았다.
--  자리 = 보스 체력 칸(위 가운데 — 보스와 싸울 때만 쓰는 칸): 보스 체력이나 퀘스트 연출이 떠 있으면 맵 이름은 곧 사라진다.
--  치수 · 시간 = 공방 js/lune/design/ui.js의 UILAYOUT.mapName(시험 탭이 같은 값으로 그린다). 글자(그림)의 투명도를 바꿔 흐리게 한다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local SCENES = require(lune.data["scenes.generated"])
local WMD = require(lune.data["worldmap.generated"])
local WM = require(lune.ui.worldmap)
local Layout = require(lune.ui.layout)
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR
local L = Layout.MAPNAME

local MapName = {}
local box: Frame? = nil
local region, name
local t = -1
local lastA: number? = nil -- 마지막으로 쓴 보이는 정도(같으면 다시 쓰지 않는다)

function MapName.init(root: Frame)
	box = Stage.place(root, "MapName", "tc", math.floor((Stage.REF_W - L.w) / 2), L.y, L.w, L.h)
	region = Ui.text(box, "", 0, 0, L.w, { align = "center", outline = true, color = C.dim })
	name = Ui.text(box, "", 0, L.nameY, L.w, { font = "body", align = "center", outline = true, color = C.text })
	box.Visible = false
end

-- 장면의 이름표 → (지역 이름, 맵 이름). 지역 이름이 맵 이름과 같으면(은달 항구) 지역 줄은 비운다
function MapName.titleOf(key: string): (string, string)
	local base = string.match(key, "^(.-)#%d+$") or key
	local sc = SCENES.scenes[base]
	local mapName = if sc then sc.name or "" else ""
	local rid = WM.nodeOf(base)
	local regionName = if rid and WMD.regions[rid] then WMD.regions[rid].name else ""
	if regionName == mapName then
		regionName = ""
	end
	return regionName, mapName
end

-- 그 장면의 이름을 띄운다(장면이 바뀌고 막이 걷힌 뒤)
function MapName.show(key: string?)
	if not box or typeof(key) ~= "string" then
		return
	end
	local r, n = MapName.titleOf(key)
	if n == "" then
		MapName.hide()
		return
	end
	region:set(r)
	name:set(n)
	-- 글자의 처음 투명도(baseT)는 지우지 않는다: 같은 글이면 SetText가 글자를 다시 짓지 않아 지금의 흐려진 값이 남아 있다 — 지우면 그 흐려진 값을 처음 값으로 읽어
	--  같은 지역의 둘째 맵부터 지역 줄이 · 같은 이름의 맵에 다시 들면 맵 이름이 보이지 않았다(2026-10-18 검토). 새로 지은 글자에는 아직 baseT가 없어 fade가 처음 값을 잰다
	t = 0
	box.Visible = true
	lastA = nil -- (글자를 새로 지었을 수 있다 — 한 번은 꼭 쓴다)
	MapName.fade(0)
end

function MapName.hide()
	t = -1
	if box then
		box.Visible = false
	end
end

-- a = 0(안 보임) ~ 1(다 보임). 보이는 정도가 바뀔 때만 글자를 훑는다(다 보이는 2초 남짓 동안은 아무것도 쓰지 않는다 — 2026-10-18 검토)
function MapName.fade(a: number)
	if not box then
		return
	end
	local q = math.floor(a * 64 + 0.5) / 64
	if lastA == q then
		return
	end
	lastA = q
	for _, d in box:GetDescendants() do
		if d:IsA("ImageLabel") then
			local base = d:GetAttribute("baseT")
			if base == nil then
				base = d.ImageTransparency
				d:SetAttribute("baseT", base)
			end
			d.ImageTransparency = base + (1 - base) * (1 - a)
		end
	end
end

-- 지금 보이는 정도(0 ~ 1 · 안 떠 있으면 0) — 자동 검사가 본다
function MapName.alpha(): number
	if t < 0 then
		return 0
	end
	if t < L.fadeIn then
		return t / L.fadeIn
	elseif t < L.fadeIn + L.hold then
		return 1
	end
	return math.max(0, 1 - (t - L.fadeIn - L.hold) / L.fadeOut)
end

-- 장마다: blocked = 그 자리를 다른 것이 쓴다(보스 체력 · 퀘스트 연출) — 그러면 바로 사라진다
function MapName.step(dt: number, blocked: boolean?)
	if t < 0 then
		return
	end
	t += dt
	local a = MapName.alpha()
	if a <= 0 or blocked then
		MapName.hide()
		return
	end
	MapName.fade(a)
end

return MapName

end
MODULES['Client/lune/mobsView'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 졸개 그리기. 서버가 초당 열 번 보내는 모습(자리 · 보는 쪽 · 상태 · 상태가 된 뒤 흐른 시간 · 체력)을 받아, 그 사이를 이어 그린다.
--  졸개가 무엇을 하는지는 서버가 정한다 — 여기서는 보이는 것만 맞춘다.
--  다친 졸개에게만 머리 위에 체력 띠, 발밑에 이름표(「Lv.1 수습 검병」)가 뜬다 — 다 띄우면 화면이 이름표로 덮인다.
--  체력 띠와 이름표는 글씨의 층(화면 틀의 고운 격자 — overlay.luau)에 그리고, 자리만 졸개를 따라간다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local COMBAT = require(lune.data["combat.generated"])
local RiftData = require(lune.data["city.generated"]).rift -- 토벌의 정예의 겉모습(2026-10-16)
local BossFx = require(lune.bossfx) -- 스토리 보스: 동작 그림이 없을 때 대기 그림을 움직여 대신한다(pose)
local BossPat = require(lune.sim.bosspat) -- 스토리 보스: 연속기의 시간 · 도약의 높이(서버와 같은 셈)
local Sprite = require(script.Parent.sprite)
local Stage = require(script.Parent.stage) -- 불티(한 점짜리 틀)
local Ui = require(script.Parent.ui.ui)
local HpBar = require(script.Parent.ui.hpBar) -- 체력 띠의 효과(닳은 자리가 밝게 남았다 줄어든다 · 번쩍임 — 플레이어의 체력 바와 같은 셈)
local Overlay = require(script.Parent.overlay)
local Layout = require(lune.ui.layout)

local C = Ui.COLOR
local LERP = 0.1 -- 모습이 오는 간격(초) — 이 시간에 걸쳐 앞 자리에서 새 자리로 옮긴다
local BAR_W, BAR_H = Layout.MOBBAR.w, Layout.MOBBAR.h -- 체력 띠의 크기(화면 틀의 점)
local BAR_UP = Layout.MOBBAR.up -- 체력 띠: 발밑에서 이만큼 위(게임의 도트)
local TAG_DOWN = Layout.TAG.down -- 이름표: 발밑에서 이만큼 아래(화면 틀의 점)
-- 새 몬스터(def.bare): 맞음 · 나타남 · 쓰러짐 그림이 없다(사용자 2026-10-09: "death는 필요없어요 hurt 도 필요없습니다. 스폰도 필요없어요" · "박쥐처럼입니다") — 공방 시험 탭과 같게 보인다:
--  맞으면 하얗게 번쩍(FLASH초) · 나타날 때 서서히 보임(FADE초) · 쓰러지면 서서히 사라짐(FADE초)
local FLASH, FADE = 0.12, 0.45

local MobsView = {}
MobsView.__index = MobsView

function MobsView.tagText(lv: number, name: string): string
	return ("Lv.%d %s"):format(lv, name)
end

-- layer = 졸개 그림의 층(게임 세계) · room = 서버가 준 방의 모습 · tagLayer = 이름표와 체력 띠의 층(화면 틀 — overlay)
function MobsView.new(layer: Frame, room, tagLayer: Frame)
	local self = setmetatable({}, MobsView)
	self.layer = layer
	self.mobs = {}
	local top = tagLayer
	for _, info in room.mobs do
		local bar = Ui.bar(top, 0, 0, BAR_W, BAR_H, C.hp)
		bar.frame.Name = "HpBar"
		bar.frame.ZIndex = 5
		bar.frame.Visible = false
		-- 토벌의 정예(2026-10-16): 같은 그림에 정예 병사와 같은 분홍 윤곽의 빛 · 불티(Rift.DATA.elite.look) · 이름표에 「정예」
		local def = COMBAT.mobs[info.kind]
		if info.elite then
			def = setmetatable({ look = RiftData.elite.look }, { __index = def })
		end
		local name = info.name or COMBAT.mobs[info.kind].name
		local tag = Ui.tag(top, MobsView.tagText(info.lv or 1, if info.elite then RiftData.elite.name .. " " .. name else name), C.text, 260)
		tag.Frame.Visible = false
		self.mobs[info.id] = {
			info = info,
			def = def,
			sprite = Sprite.new(layer, COMBAT.mobs[info.kind].sprite, 2), -- 그림을 빌려 쓰는 졸개가 있다(수습 검병 = 검병의 그림)
			white = Sprite.new(layer, COMBAT.mobs[info.kind].sprite, 3, true), -- 맞을 때의 흰 번쩍임(같은 자리의 흰 실루엣) — 모든 몬스터(시험 탭의 flashT. 전에는 제 맞는 그림이 없는 몬스터만 번쩍였다)
			-- 터뜨리는 몬스터(폭탄병 · 포자 주머니): 터지는 그림에는 몸이 없다 — 터진 뒤의 장들에는 서 있는 몸을 밑에 그린다(터뜨려도 사라지지 않는다)
			under = if COMBAT.mobs[info.kind].atk and COMBAT.mobs[info.kind].atk.burst then Sprite.new(layer, COMBAT.mobs[info.kind].sprite, 1) else nil,
			-- 그림을 빌려 쓰는 몬스터(정예 검병 = 검병의 그림)를 가르는 겉모습(공방 combat.js의 look — 사용자 2026-10-11): 윤곽의 빛 = 흰 실루엣 넷을 한 점씩 비껴 몸 뒤에 · 불티 = 작은 점 셋
			glow = MobsView.glowOf(layer, def),
			embers = MobsView.embersOf(layer, def),
			warn = MobsView.warnOf(layer, COMBAT.mobs[info.kind]), -- 스토리 보스: 예고하는 동안 깜박이는 분홍 윤곽
			pat = 0, -- 스토리 보스가 지금 하는 패턴의 차례(서버가 보낸다 — 없으면 0)
			alt = 0, -- 지금 땅에서 뜬 높이(나는 몬스터)
			bar = bar,
			barFx = HpBar.attach(bar, BAR_W, BAR_H), -- 사용자 2026-10-13: "몬스터 체력바도  유저 체력바처럼 고도화 되어야합니다."
			fresh = false, -- 띠를 처음으로 돌려 두었는가(다시 나타날 때 한 번)
			tag = tag,
			x = 0,
			fromX = 0,
			toX = 0,
			at = 0,
			dir = 1,
			state = "gone",
			t = 0,
			hp = info.maxHp,
			shownHp = -1,
		}
	end
	if room.snap then
		self:apply(room.snap, 0)
		for _, m in self.mobs do
			m.fromX = m.toX
		end
	end
	return self
end

-- ---------- 그림을 빌려 쓰는 몬스터의 겉모습(look) ----------
local GLOW_AT = { { -1, 0 }, { 1, 0 }, { 0, -1 }, { 0, 1 } } -- 윤곽의 빛: 한 점씩 비낀 네 자리
local EMBER_X = { -9, -4, 1, 6, 10 } -- 불티 다섯이 피어오르는 자리(몸의 가운데에서 옆으로)
local EMBER_BIG = 0.45 -- 피어오르는 길의 이만큼까지는 두 점, 그 뒤로는 한 점(한 점짜리 셋은 화면에서 보이지 않았다 — 2026-10-11 Play)
local function rgbOf(c): Color3
	-- 「#rrggbb」 글도 받는다(토벌 · 사냥터 정예의 겉모습 — city.js RIFT.elite.look은 글로 적혀 있다. 2026-10-18 검토: 배열로만 읽어 윤곽 · 불티가 검게 나왔다)
	if typeof(c) == "string" then
		local r, g, b = string.match(c, "^#?(%x%x)(%x%x)(%x%x)$")
		if r then
			return Color3.fromRGB(tonumber(r, 16) :: number, tonumber(g, 16) :: number, tonumber(b, 16) :: number)
		end
		return Color3.fromRGB(255, 255, 255)
	end
	return Color3.fromRGB(c[1], c[2], c[3])
end
-- 윤곽의 빛(흰 실루엣 넷) — look.aura가 있을 때만
function MobsView.glowOf(layer: Instance, def)
	if not (def.look and def.look.aura) then
		return nil
	end
	local list = {}
	for i = 1, #GLOW_AT do
		local sp = Sprite.new(layer, def.sprite, 1, true)
		sp.label.ImageColor3 = rgbOf(def.look.aura)
		list[i] = sp
	end
	return list
end
-- 스토리 보스의 예고 윤곽(분홍 실루엣 넷 — 예고하는 동안만 보인다. 끝으로 갈수록 빨리 깜박인다): 공방 시험 탭의 drawStory와 같다
local WARN = Color3.fromRGB(255, 62, 159)
function MobsView.warnOf(layer: Instance, def)
	if not def.story then
		return nil
	end
	local list = {}
	for i = 1, #GLOW_AT do
		local sp = Sprite.new(layer, def.sprite, 1, true)
		sp.label.ImageColor3 = WARN
		list[i] = sp
	end
	return list
end
-- 불티(다섯) — look.embers가 있을 때만
function MobsView.embersOf(layer: Instance, def)
	if not (def.look and def.look.embers) then
		return nil
	end
	local list = {}
	for i = 1, #EMBER_X do
		local e = Stage.image(layer, "Ember", "", 1, 1)
		e.BackgroundColor3 = rgbOf(def.look.embers)
		e.BackgroundTransparency = 0
		e.ZIndex = 4
		e.Visible = false
		list[i] = e
	end
	return list
end
-- 그 장의 겉모습을 그린다: 몸의 그림에 색을 곱하고(눈 · 뿔 · 날이 그 색이 된다), 윤곽의 빛은 숨 쉬듯 밝아졌다 어두워지고, 불티는 1.3초에 걸쳐 스무 점 떠오르며 사라진다
function MobsView.drawLook(m, show: boolean, clip: string, frame: number, now: number)
	local look = m.def.look
	if not look then
		return
	end
	if look.tint and not m.tinted then
		m.tinted = true
		m.sprite.label.ImageColor3 = rgbOf(look.tint)
	end
	local y = m.info.y - m.alt
	if m.glow then
		local fade = 0.45 + 0.25 * math.sin(now * 4 + m.info.id)
		for i, sp in m.glow do
			if show then
				sp:set(clip, frame, (m.px or m.x) + GLOW_AT[i][1], y + GLOW_AT[i][2], m.dir)
				sp.label.ImageTransparency = fade
			else
				sp.label.Visible = false
			end
		end
	end
	if m.embers then
		for i, e in m.embers do
			local k = (now / 1.3 + i / #m.embers + m.info.id * 0.37) % 1
			e.Visible = show
			if show then
				local size = if k < EMBER_BIG then 2 else 1
				e.Size = UDim2.fromOffset(size, size)
				e.Position = UDim2.fromOffset(math.floor(m.x + EMBER_X[i] + math.sin(k * 6.28 + i) * 1.5), math.floor(y - 4 - k * 20))
				e.BackgroundTransparency = k
			end
		end
	end
end

-- 맞았다(타격감 — 공방 combat.js의 hit): 하얗게 번쩍이고, 때린 쪽의 반대(dir)로 조금 밀렸다가 돌아온다(그림만 — 자리와 판정은 서버의 것 그대로). now = 화면의 시계
local HIT = COMBAT.rules.hit
function MobsView.hit(m, now: number, dir: number)
	m.hitAt, m.pushDir = now, dir
end

-- 서버가 보낸 모습을 받아 적는다. now = 받은 때(클라이언트 시계)
function MobsView:apply(list, now: number)
	for _, row in list do
		local m = self.mobs[row[1]]
		if m then
			m.fromX = if m.state == "gone" then row[2] else m.x
			m.toX, m.dir, m.at = row[2], row[3], now
			m.state, m.t, m.hp = row[4], row[5], row[6]
			m.pat = row[9] or 0
			m.aim, m.chain, m.quick = row[10] or 0, row[11] or 0, row[12] == 1 -- 스토리 보스: 겨눈 자리(도약 · 불씨) · 연속기의 차례(0이면 아니다) · 지금 패턴이 연속기의 빠른 것인가
			-- 묶인 · 넘어진 시간(서버의 것). 화면이 방금 어림으로 묶은 직후(cast.luau의 g.bind)에는 그보다 먼저 떠난 0을 받지 않는다
			if (row[7] or 0) > 0 or os.clock() - (m.bindAt or -9) > 0.6 then
				m.bind = row[7] or 0
			end
			m.stun = row[8] or 0
		end
	end
end

function MobsView:get(id: number)
	return self.mobs[id]
end

-- 스토리 보스가 지금 하는 패턴: 연속기(chain)의 둘째부터는 예고 · 굳는 시간이 그 quick배로 줄어든 것을 돌려준다(화면의 그림 · 동작의 박자가 서버의 시간과 맞게). 없으면 nil
local QUICK = {} :: { [any]: { [number]: any } }
function MobsView.patOf(m)
	local S = m.def.story
	local p = S.patterns[m.pat or 0]
	local c = S.patterns[m.chain or 0]
	if not p or not m.quick or not c or not c.quick or c.quick == 1 then
		return p
	end
	local cache = QUICK[p]
	if not cache then
		cache = {}
		QUICK[p] = cache
	end
	local q = cache[c.quick]
	if not q then
		q = table.clone(p)
		q.tell, q.act = BossPat.tell(p, c.quick), BossPat.act(p, c.quick)
		cache[c.quick] = q
	end
	return q
end

-- 그 졸개의 머리 위 높이(발밑에서 위로, 게임의 도트): 병사 16 · 새 몬스터 = 뜬 높이 + 몸의 높이 + 2. 피해 숫자가 뜨는 자리
function MobsView.topOf(m): number
	local def = m.def
	if def.body then
		return (def.lift or 0) + (m.alt or 0) + def.body[2] + 2
	end
	return if def.boss then 30 else 16
end

-- 나는 몬스터의 지금 높이: 서버(sim/room.luau)와 같은 식 — 덮칠 때는 내려왔다 올라가고, 그 밖에는 제 높이에서 조금씩 오르내린다(오르내림은 보이기만 한다)
local function altOf(m, t: number, now: number): number
	local fly = m.def.fly
	if not fly then
		return 0
	end
	if m.state == "atk" then
		local atk = m.def.atk
		local k = if t < atk.windup then t / atk.windup else math.max(0, 1 - (t - atk.windup) / (atk.time - atk.windup))
		return fly.alt - (fly.alt - fly.low) * (k * k * (3 - 2 * k))
	end
	return fly.alt + math.sin(now * 3 + m.info.id) * fly.bob
end

function MobsView:update(now: number)
	local dt = math.clamp(now - (self.now or now), 0, 0.1)
	self.now = now
	for _, m in self.mobs do
		local k = math.clamp((now - m.at) / LERP, 0, 1)
		m.x = m.fromX + (m.toX - m.fromX) * k
		local t = m.t + (now - m.at)
		local char = m.sprite.char
		local clip, frame = "idle", 1
		local show = true
		local bare = m.def.bare == true
		local fade, flash = 0, false -- 그림 없는 동작: 투명한 정도(0 = 또렷) · 흰 번쩍임
		local poseX, poseY = 0, 0 -- 스토리 보스: 대기 그림을 움직이는 만큼(앞으로 · 위로)
		m.tNow = t -- 지금 상태가 된 뒤 흐른 시간(보스의 예고가 얼마나 찼는가 — bossView가 읽는다)
		m.alt = altOf(m, t, now)
		if m.state == "gone" then
			show = false
		elseif m.state == "dead" and m.def.story and char.clips.death and m.def.story.anim.fall then
			-- 스토리 보스가 쓰러진다(쓰러지는 동작 그림이 있는 보스): 그 동작을 한 번 틀고 누운 채 잠깐 있다가 사라진다(BossFx.fall) — 그동안 서버는 보스를 치우지 않는다(story.fall초)
			local c, f, a = BossFx.fall(t, char.clips, m.def.story.anim)
			clip, frame = c :: string, f
			fade = 1 - a
			show = a > 0
			m.tail = nil
		elseif bare and m.state == "dead" then
			frame = Sprite.frameAt(char, "idle", now + m.info.id * 0.3, false)
			fade = math.clamp(t / FADE, 0, 1)
			show = fade < 1
		elseif bare and m.state == "spawn" then
			frame = Sprite.frameAt(char, "idle", now + m.info.id * 0.3, false)
			fade = 1 - math.clamp(t / FADE, 0, 1)
		elseif m.def.story then
			-- 스토리 보스: 받은 동작 그림(idle · run · attack — 사용자가 만든다)을 패턴의 시간에 맞춰 튼다(BossFx.body). 그림이 없는 동작(sweep · shout)은 대기 그림을 움직여 대신한다
			local S = m.def.story
			local p = MobsView.patOf(m) -- 지금 하는 패턴(연속기 안에서는 예고 · 굳는 시간이 줄어든 것)
			m.jump = if p and m.state == "act" then BossPat.leapAlt(p, t) else 0 -- 도약: 뛰어오른 높이(서버와 같은 식)
			-- 친 뒤에 남은 장: 굳어 있는 동안(act)의 동작을 적어 두었다가, 그 뒤 서 있는 동안 이어서 끝까지 튼다(걷거나 다음 패턴을 예고하면 그만둔다)
			if m.state == "act" and p and not p.dash then
				m.tail = { clip = p.clip, act = p.act, t = t }
			elseif m.state == "idle" and m.tail then
				m.tail.t = m.tail.act + t
			else
				m.tail = nil
			end
			local stand
			clip, frame, stand = BossFx.body(m.state, p, t, now, char.clips, S.anim, m.tail)
			if stand then
				poseX, poseY = BossFx.pose(m.state, p, t)
			end
		elseif bare and m.state == "hit" then
			frame = Sprite.frameAt(char, "idle", now + m.info.id * 0.3, false)
			flash = t < FLASH
		elseif m.state == "dead" then
			clip = "death"
			frame = math.min(#char.clips.death.frames, math.floor(t * char.clips.death.fps) + 1)
		elseif m.state == "spawn" then
			clip = "spawn"
			frame = math.min(#char.clips.spawn.frames, math.floor(t * char.clips.spawn.fps) + 1)
		elseif m.state == "atk" then
			clip = "atk"
			frame = math.min(#char.clips.atk.frames, math.floor(t * m.def.atk.fps) + 1)
		elseif m.state == "hit" then
			clip = "hit"
			frame = math.min(#char.clips.hit.frames, math.floor(t * char.clips.hit.fps) + 1)
		elseif m.state == "run" then
			clip = "run"
			frame = Sprite.frameAt(char, "run", now, false)
		else
			frame = Sprite.frameAt(char, "idle", now + m.info.id * 0.3, false)
		end
		-- 타격감: 방금 맞았으면 하얗게 번쩍이고(HIT.flash초), 때린 쪽의 반대로 밀렸다가 돌아온다(HIT.pushT초 — 처음에 크게, 끝으로 갈수록 작게). 그리는 자리(px)만 옮긴다
		local hitAge = now - (m.hitAt or -9)
		if hitAge >= 0 and hitAge < HIT.flash and m.state ~= "gone" and m.state ~= "spawn" then
			flash = true
		end
		local px = m.x
		if hitAge >= 0 and hitAge < HIT.pushT and m.state ~= "gone" then
			local k = 1 - hitAge / HIT.pushT
			px += math.floor((m.pushDir or 0) * (if m.def.boss or m.info.boss then HIT.pushBoss else HIT.push) * k * k + 0.5)
		end
		px += m.dir * poseX
		local py = m.info.y - m.alt - poseY - math.floor((m.jump or 0) + 0.5)
		m.px = px
		if m.under then
			-- 터진 장부터(atk.frame 다음)는 서 있는 몸을 밑에 그린다
			if show and m.state == "atk" and clip == "atk" and frame > m.def.atk.frame then
				m.under:set("idle", 1, px, m.info.y - m.alt, m.dir)
			else
				m.under.label.Visible = false
			end
		end
		MobsView.drawLook(m, show and m.state ~= "dead" and m.state ~= "spawn", clip, frame, now)
		if show then
			m.sprite:set(clip, frame, px, py, m.dir)
			if bare then
				m.sprite.label.ImageTransparency = fade
			end
		else
			m.sprite.label.Visible = false
		end
		if m.white then
			if show and flash then
				m.white:set(clip, frame, px, py, m.dir)
			else
				m.white.label.Visible = false
			end
		end
		if m.warn then
			local p = m.def.story.patterns[m.pat]
			local on = show and m.state == "tell" and p ~= nil
			local see = if on then 1 - (0.35 + 0.45 * math.abs(math.sin(t * (6 + 14 * t / p.tell)))) else 1
			for i, sp in m.warn do
				if on then
					sp:set(clip, frame, px + GLOW_AT[i][1], py + GLOW_AT[i][2], m.dir)
					sp.label.ImageTransparency = see
				else
					sp.label.Visible = false
				end
			end
		end
		-- 체력 띠와 이름표: 다친 졸개에게만
		local alive = m.state ~= "gone" and m.state ~= "dead" and m.state ~= "spawn"
		m.hurt = alive and m.hp < m.info.maxHp and not m.def.story -- 스토리 보스의 체력은 화면 위 가운데의 넓은 바에 뜬다(bossView.luau) — 머리 위의 띠 · 발밑의 이름표는 없다
		-- 띠의 효과: 맞으면 닳은 자리가 밝게 남았다가 따라 줄어들고 띠가 희게 번쩍인다(플레이어의 체력 바와 같다).
		--  없는 동안 · 나타나는 동안에는 처음으로 돌려 둔다(가득 찬 채로 — 다시 나타났을 때 「차오르는」 효과가 뜨지 않게, 첫 타에도 닳은 자리가 보이게)
		if m.state == "gone" or m.state == "spawn" then
			if not m.fresh then
				m.fresh = true
				m.barFx:reset()
				m.barFx:set(1, m.info.maxHp)
				m.shownHp = m.info.maxHp
			end
		else
			m.fresh = false
			if m.shownHp ~= m.hp then
				if m.shownHp == -1 then
					m.barFx:reset() -- 처음 본 몬스터(이미 다쳐 있을 수 있다): 효과 없이 그대로
				end
				m.shownHp = m.hp
				m.barFx:set(math.max(0, m.hp) / m.info.maxHp, math.max(0, m.hp))
			end
			m.barFx:step(dt)
		end
		-- 쓰러뜨린 마지막 타: 띠가 비워지는 것이 보이게, 효과가 끝날 때까지는 띠를 남겨 둔다(쓰러지는 동안)
		local last = m.state == "dead" and not m.def.story and m.barFx:busy()
		m.bar.frame.Visible = m.hurt or last
		m.tag.Frame.Visible = m.hurt -- 자리는 boot가 정한다(이름표끼리 겹치지 않게 쌓는다 — tags())
		if m.hurt or last then
			m.bar.frame.Position = UDim2.fromOffset(Overlay.x(m.x) - BAR_W / 2, Overlay.y(m.info.y - math.max(BAR_UP, MobsView.topOf(m) + 7))) -- 큰 몬스터 · 떠 있는 몬스터는 머리 위로 올린다
		end
	end
end

-- 떠 있는 이름표들: { x(왼쪽), y(위), w, frame } — 화면 틀의 점. 번호 차례(늘 같은 차례로 쌓이게)
function MobsView:tags()
	local out = {}
	for id, m in self.mobs do
		if m.hurt then
			table.insert(out, { id = id, x = Overlay.x(m.x) - math.floor(m.tag.Width / 2), y = Overlay.y(m.info.y) + TAG_DOWN, w = m.tag.Width, frame = m.tag.Frame })
		end
	end
	table.sort(out, function(a, b)
		return a.id < b.id
	end)
	return out
end

function MobsView:destroy()
	for _, m in self.mobs do
		m.sprite:destroy()
		if m.white then
			m.white:destroy()
		end
		for _, sp in m.warn or {} do
			sp:destroy()
		end
		m.bar.frame:Destroy()
		m.tag:Destroy()
	end
	table.clear(self.mobs)
end

return MobsView

end
MODULES['Client/lune/music'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 음악 — 장면마다의 배경 음악과 짧은 징글(레벨 업 · 전직), 효과음(줍기 · 완료 · 수락 …).
--  때릴 때 · 맞을 때 · 대쉬의 소리는 없다(사용자 2026-10-14: "플레이어랑 몬스터 때릴 때 나는 소리랑 맞을때 나는 소리 전부 빼겠습니다. 대쉬 소리 빼겠습니다.") · 뛰기 소리도 없다("점프소리도 제거하세요").
--  다만 내 타의 데미지 숫자가 뜰 때마다 「damage」가 한 번씩 난다(사용자가 고른 소리 — 틈 0: 여러 마리 · 여러 타가 겹쳐도 하나하나 난다).
--  2026-10-14 사용자가 소리를 다시 골라 올렸다 — 퀘스트 완료 · 사망 · 숨은 방에는 징글이 없고(배경 음악을 줄이지 않는다) 효과음만 난다.
--  사용자 2026-10-10: "소리는 … 뮤직에셋 가져왔습니다. 이걸 알맞게 배치해보고 추후 제가 어색한게있으면 말해드릴게요"
--  어느 곡을 어디에 트는지 · 곡마다의 크기는 shared/lune/data/music.generated.luau(공방의 js/lune/design/music.js — 배치는 모두 제안이다).
--  배경 음악: 장면이 바뀌면 그 장면의 곡으로 천천히(fade초) 넘어간다. 같은 곡이면 끊지 않고 이어 튼다(마을 → 건물 안).
--  징글: 배경 음악을 잠깐 줄이고(duck) 한 번 튼다.
--  크기: 배경 음악과 효과음(타격 · 줍기 · 징글)을 따로 0~steps칸으로(한 칸 10%) — 메뉴 → 「소리 설정」(ui/soundWindow.luau). 계정에 저장된다.
--   사용자 2026-10-13: "소리조절 있어야합니다." — 그 앞에는 「소리 끄기 / 켜기」뿐이었고 저장되지 않았다.
--  올린 오디오의 번호(id)가 아직 없는 곡은 조용히 건너뛴다 — 오디오는 사용자가 로블록스에 올린다(공방의 tools/build_lune_music.mjs).
local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MUSIC = require(ReplicatedStorage.shared.lune.data["music.generated"])
local SOUND = require(ReplicatedStorage.shared.lune.data["ui.generated"]).layout.sound -- 칸 수(steps) · 처음 크기(start)

local Music = {}
Music.on = true -- 모두 켰는가(소리 설정의 「모두 끄기 / 켜기」)
Music.MAX = SOUND.steps
Music.level = { music = SOUND.start, sfx = SOUND.start } -- 크기(0~MAX칸): music = 배경 음악 · sfx = 효과음과 징글
Music.now = nil :: string? -- 지금 트는 곡의 이름표

local folder: Folder? = nil
local playing = {} -- [이름표] = { sound, want(가려는 크기 0~1), at(지금 크기 0~1), base(그 곡의 크기) }
local duckT = 0 -- 징글이 끝날 때까지 남은 시간(초)

-- 그 갈래의 크기(0~1): 모두 껐으면 0
local function gain(kind: string): number
	return if Music.on then Music.level[kind] / Music.MAX else 0
end
Music.gain = gain

local function ensure()
	if folder then
		return
	end
	local f = Instance.new("Folder")
	f.Name = "LuneMusic"
	f.Parent = SoundService
	folder = f
	-- 크기를 장마다 조금씩 옮긴다(넘어가기 · 징글 동안 줄이기)
	RunService.Heartbeat:Connect(function(dt)
		duckT = math.max(0, duckT - dt)
		local duck = if duckT > 0 then MUSIC.duck else 1
		local master = gain("music")
		for key, p in playing do
			local step = dt / MUSIC.fade
			if p.at < p.want then
				p.at = math.min(p.want, p.at + step)
			elseif p.at > p.want then
				p.at = math.max(p.want, p.at - step)
			end
			p.sound.Volume = p.base * p.at * duck * master
			if p.want == 0 and p.at == 0 then
				p.sound:Destroy()
				playing[key] = nil
			end
		end
	end)
end

-- 그 이름표의 곡을 배경 음악으로 튼다(nil이면 끈다). 번호가 없는 곡이면 지금 곡만 잦아든다
function Music.play(key: string?)
	ensure()
	if key == Music.now then
		return
	end
	Music.now = key
	for k, p in playing do
		p.want = if k == key then 1 else 0
	end
	local def = if key then MUSIC.tracks[key] else nil
	if not key or not def or def.id == "" or playing[key] then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = key
	sound.SoundId = def.id
	sound.Looped = true
	sound.Volume = 0
	sound.Parent = folder
	sound:Play()
	playing[key] = { sound = sound, want = 1, at = 0, base = def.volume }
end

-- 그 장면의 곡을 튼다
function Music.scene(sceneKey: string)
	Music.play(MUSIC.scene[sceneKey] or MUSIC.scene[string.match(sceneKey, "^(.-)#%d+$") or ""]) -- 토벌의 방(rf1#3)은 그 장면(rf1)의 곡
end

-- 짧은 징글을 한 번 튼다(배경 음악은 그동안 줄인다)
function Music.jingle(key: string)
	ensure()
	local def = MUSIC.jingles[key]
	if not def or def.id == "" or gain("sfx") <= 0 then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = "Jingle_" .. key
	sound.SoundId = def.id
	sound.Volume = def.volume * gain("sfx")
	sound.Parent = folder
	sound.Ended:Connect(function()
		sound:Destroy()
	end)
	sound:Play()
	duckT = math.max(duckT, def.sec)
end

-- 효과음을 한 번 낸다(줍기 · 완료 · 수락 … — 공방 music.js의 sfx). 올린 번호가 없으면 아무 소리도 나지 않는다.
--  같은 소리는 gap초 안에 다시 내지 않는다(연타 · 여럿을 한꺼번에 칠 때 뭉개지지 않게). 돌려주는 것: 소리를 냈는가
--  whole = upto가 있는 소리도 끝까지 튼다(데미지 소리: 줄마다는 짧게 다다다다, 그 타의 마지막 줄만 끝까지 — 사용자 2026-10-14)
local sfxAt: { [string]: number } = {}
function Music.sfx(key: string, whole: boolean?): boolean
	local def = MUSIC.sfx and MUSIC.sfx[key]
	if not def or def.id == "" or gain("sfx") <= 0 then
		return false
	end
	local now = os.clock()
	if now - (sfxAt[key] or -9) < def.gap then
		return false
	end
	sfxAt[key] = now
	ensure()
	local sound = Instance.new("Sound")
	sound.Name = "Sfx_" .. key
	sound.SoundId = def.id
	sound.Volume = def.volume * gain("sfx")
	if def.upto and not whole then
		-- 앞에서부터 upto초까지만 튼다(데미지 소리 — 사용자 2026-10-14: "이 음성파일의 절반 만 재생합니다")
		sound.PlaybackRegionsEnabled = true
		sound.PlaybackRegion = NumberRange.new(0, def.upto)
		task.delay(def.upto + 0.5, function()
			if sound.Parent then
				sound:Destroy() -- 구간 끝에서 Ended가 오지 않아도 치운다
			end
		end)
	end
	sound.Parent = folder
	sound.Ended:Connect(function()
		sound:Destroy()
	end)
	sound:Play()
	return true
end

-- 모두 켜고 끈다(소리 설정). 돌려주는 것: 지금 켜져 있는가
function Music.toggle(): boolean
	ensure()
	Music.on = not Music.on
	return Music.on
end

-- 그 갈래("music" · "sfx")의 크기를 n칸으로. 돌려주는 것: 바뀌었는가(범위 밖 · 같은 값이면 false)
function Music.setLevel(kind: string, n: number): boolean
	if typeof(n) ~= "number" or Music.level[kind] == nil or n ~= math.floor(n) or n < 0 or n > Music.MAX or Music.level[kind] == n then
		return false
	end
	Music.level[kind] = n
	return true
end

-- 저장된 설정을 얹는다(서버가 준 계정의 것 — 꼴은 서버가 이미 봤다) · 저장할 꼴로 내놓는다
function Music.import(sound: any)
	if typeof(sound) ~= "table" then
		return
	end
	Music.setLevel("music", sound.music)
	Music.setLevel("sfx", sound.sfx)
	Music.on = sound.on ~= false
end
function Music.export()
	return { music = Music.level.music, sfx = Music.level.sfx, on = Music.on }
end

return Music

end
MODULES['Client/lune/naviArrow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 길찾기의 화살표 — 캐릭터 머리 위에 가야 할 쪽을 가리킨다(셈은 shared/lune/ui/navi.luau).
--  사용자 2026-10-13: "그 버튼 누르면  길찾기 되면서 가야하는 방향 캐릭터 머리위에 화살표로 알려주는 기능 추가하세요" → 같은 날 "퀘스트 길찾기  캐릭터 머리위에 화살표 퀄리티 더 올리고"
--  그림: 처음에는 내가 네모로 짠 한 색 화살표였다 → Codex가 그린 민트 수정 화살표(밝은 윗면 · 어두운 아랫면 · 흰 빛 · 어두운 테두리)를 칸 그대로 옮긴 부품 넷
--   (naviUp · naviRight · naviDown · naviLeft — 공방 tools/build_lune_navi.mjs → build_lune_ui.mjs → 부품 그림 한 장). 여기서 모양을 따로 그리지 않는다.
--  왼쪽 · 오른쪽 · 위 · 아래의 그림 넷을 만들어 두고 하나만 보인다. 가리키는 쪽으로 조금씩 오간다. 문 · 주민 앞에 다 오면 위쪽 화살표가 빠르게 오간다(↑를 누른다).
--  화면 틀의 격자에 그린다(그림의 한 점 = 화면 틀의 SCALE점 — 정수 배라 도트가 뭉개지지 않는다. 게임 세계의 자리는 Overlay가 옮겨 준다).
local Overlay = require(script.Parent.overlay)
local Kit = require(script.Parent.ui.kit)

local NaviArrow = {}
NaviArrow.UP = 44 -- 발밑에서 화살표 가운데까지(게임의 도트 — 머리 위)
NaviArrow.SCALE = 2 -- 그림의 한 점이 화면 틀의 몇 점인가
NaviArrow.PART = { up = "naviUp", right = "naviRight", down = "naviDown", left = "naviLeft" }
NaviArrow.WAVE = { slow = 6, fast = 12, reach = 4 } -- 오가는 빠르기(가는 중 · 다 왔다) · 오가는 폭(화면 틀의 점)

function NaviArrow.new()
	local self = setmetatable({}, { __index = NaviArrow })
	local layer = Overlay.layer("Navi", 14)
	self.frames, self.size = {}, {}
	for dir, part in NaviArrow.PART do
		local w, h = Kit.partSize(part)
		local f = Kit.part(layer, part, 0, 0)
		f.Name = "Arrow_" .. dir
		f.Size = UDim2.fromOffset(w * NaviArrow.SCALE, h * NaviArrow.SCALE)
		f.Visible = false
		self.frames[dir] = f
		self.size[dir] = { w * NaviArrow.SCALE, h * NaviArrow.SCALE }
	end
	self.shown = nil :: string?
	return self
end

-- dir = "left" | "right" | "up" | "down" | "enter" | "none" | nil · (wx, wy) = 캐릭터의 발밑(게임 세계) · clock = 흐른 시간(초)
function NaviArrow:set(dir: string?, wx: number, wy: number, clock: number)
	local face = if dir == "enter" then "up" elseif dir == "none" then nil else dir
	if face ~= self.shown then
		for name, f in self.frames do
			f.Visible = name == face
		end
		self.shown = face
	end
	if not face then
		return
	end
	local f, size = self.frames[face], self.size[face]
	-- 가리키는 쪽으로 오간다(다 왔으면 빠르게 — ↑를 누르라는 뜻). 한 점씩 딱딱 움직인다(도트 그림이라 반 점에 걸치지 않게)
	local W = NaviArrow.WAVE
	local wave = math.floor((math.sin(clock * (if dir == "enter" then W.fast else W.slow)) + 1) / 2 * W.reach + 0.5)
	local ox = if face == "left" then -wave elseif face == "right" then wave else 0
	local oy = if face == "up" then -wave elseif face == "down" then wave else 0
	f.Position = UDim2.fromOffset(Overlay.x(wx) - math.floor(size[1] / 2) + ox, Overlay.y(wy - NaviArrow.UP) - math.floor(size[2] / 2) + oy)
end

function NaviArrow:hide()
	self:set(nil, 0, 0, 0)
end

return NaviArrow

end
MODULES['Client/lune/othersView'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 같은 맵에 있는 다른 사람들 — 서버가 알려 준 이름표(Who)와 자리(Heroes · 초당 10번)를 받아 그린다. 자리 사이는 이어서 그린다.
--  동작은 움직임에서 짐작한다: 옆으로 움직이면 달리기, 위아래로 움직이면 뛰기, 아니면 서 있기. 기술은 서버가 알려 준 것(Act)을 그 구간 동안 튼다.
--  발밑에 이름표(메이플처럼 이름만) — 파티원은 민트색이다. 이름표는 글씨의 층(화면 틀 — overlay.luau)에 그린다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local COMBAT = require(ReplicatedStorage.shared.lune.data["combat.generated"])
local CLASSES = require(ReplicatedStorage.shared.lune.data["classes.generated"])
local Kitset = require(ReplicatedStorage.shared.lune.kitset)
local CHARS = require(ReplicatedStorage.shared.lune.data["chars.generated"])
local Sprite = require(script.Parent.sprite)
local Grave = require(script.Parent.grave)
local Ui = require(script.Parent.ui.ui)
local Overlay = require(script.Parent.overlay)
local RideView = require(script.Parent.rideView) -- 펫 · 탈것(2026-10-20)

local WHITE = Ui.COLOR.text
local MINT = Ui.COLOR.accent
local LERP = 0.12 -- 자리 보고 사이를 이만큼에 걸쳐 잇는다(초)
local TAG_DOWN = 4 -- 이름표: 발밑에서 이만큼 아래(화면 틀의 점)

local Others = {}
Others.__index = Others
Others.TAG_DOWN = TAG_DOWN

-- 이름표에 적는 글: 이름만(레벨은 파티원 칸 · 파티 창에서 본다)
function Others.tagText(_level: number, name: string): string
	return name
end

function Others.new(heroLayer: Frame, tagLayer: Frame, myId: any, ladders: any, scene: any)
	local self = setmetatable({}, Others)
	self.ladders = ladders or {} -- 이 장면의 사다리(사다리 위에 있으면 오르기 동작 — 2026-10-16 밤)
	self.scene = scene -- 이 장면의 칸(그 사람의 펫이 걷는 땅 — rideView)
	self.heroLayer, self.tagLayer, self.myId = heroLayer, tagLayer, myId
	self.list = {} -- [번호] = 한 사람
	self.fx = nil :: any -- 효과(effects.luau) — boot가 넣어 준다. 대쉬의 잔상 · 속도선을 여기에 그린다
	self.graveLayer = nil :: any -- 비석을 놓는 층 — boot가 넣어 준다(장면의 Graves 층)
	self.last = 0 -- 지난번 update의 때(잔상의 간격을 잰다)
	return self
end

local function drop(o)
	o.sprite:destroy()
	o.rv:destroy()
	o.tag:Destroy()
	if o.grave then
		o.grave:Destroy()
	end
end

-- 방 사람들의 이름표: 새로 온 사람은 만들고, 나간 사람은 지운다
function Others:setWho(roster)
	local seen = {}
	for _, w in roster do
		if w.id ~= self.myId then
			seen[w.id] = true
			local o = self.list[w.id]
			if o and o.class ~= w.class then
				drop(o)
				o = nil
			end
			if not o then
				o = {
					id = w.id,
					class = w.class,
					sprite = Sprite.new(self.heroLayer, w.class, 4),
					tag = Ui.tag(self.tagLayer, "", WHITE, 220, true), -- 플레이어의 이름표: 민트 테두리를 두른 판
					x = 0,
					y = 0,
					fromX = 0,
					fromY = 0,
					toX = 0,
					toY = 0,
					at = -1,
					dir = 1,
					alive = true,
					placed = false,
					moveT = -9,
					airT = -9,
					act = nil :: any,
					rv = RideView.new(self.heroLayer, 4, self.scene), -- 그 사람의 펫 · 탈것(영웅의 ZIndex 4 · 펫은 이 맵의 땅 위를 걷는다)
				}
				o.sprite.label.Visible = false
				o.tag.Frame.Visible = false
				self.list[w.id] = o
			end
			o.rv:setPet(w.pet)
			o.rv:setRide(w.ride)
			if o.name ~= w.name or o.level ~= w.level then
				o.name, o.level = w.name, w.level
				o.tag:SetText(Others.tagText(w.level, w.name))
			end
		end
	end
	for id, o in self.list do
		if not seen[id] then
			drop(o)
			self.list[id] = nil
		end
	end
end

-- 자리: { { id, x, y, dir, 살아 있는가 } … }
function Others:apply(list, now: number)
	for _, row in list do
		local o = self.list[row[1]]
		if o then
			if not o.placed then
				o.x, o.y = row[2], row[3]
				o.placed = true
			end
			o.fromX, o.fromY = o.x, o.y
			o.toX, o.toY, o.dir, o.at = row[2], row[3], row[4], now
			if math.abs(o.toX - o.fromX) > 0.5 then
				o.moveT = now
			end
			if math.abs(o.toY - o.fromY) > 1.5 then
				o.airT = now
			end
			if row[5] and not o.alive then
				o.act = nil
			end
			if not row[5] and o.alive then
				o.deadAt = now
			end
			o.alive = row[5]
		end
	end
end

-- 2~4차의 쓰는 스킬(직업 묶음의 그 스킬)의 동작: 구간마다 서버가 알려 준다(next) — 되풀이 구간(누르고 있는 것 · 모으는 것 · 조건을 기다리는 것)은 끝 장을 넘으면 loopFrom으로 돌아간다
local KITDEF = {}
local function kitDef(skillId: string)
	local def = KITDEF[skillId]
	if def == nil then
		local skill, kit = Kitset.skill(skillId)
		def = false
		if skill and kit and skill.segs and COMBAT.cast[skillId] then
			local segs = {}
			for i, s in skill.segs do
				local clip = CHARS.chars[kit.who].clips[s.clip]
				local from, to = s.from or 0, s.to or (if clip then #clip.frames - 1 else 0)
				local fps = s.fps or 14
				local loops = s.loop or s.hold or s.charge or s.till
				local time = if s.loop then s.dur elseif s.hold then s.max or 3 elseif s.charge then (to - from + 1) / fps + 1 elseif s.till then s.max or 1.5 else (to - from + 1) / fps
				segs[i] = { clip = s.clip, from = from, to = to, fps = fps, time = time, next = true, loops = loops == true, loopFrom = s.loopFrom or from }
			end
			def = { type = "cast", segs = segs }
		end
		KITDEF[skillId] = def
	end
	return def or nil
end

-- 그 사람이 기술의 한 구간을 쓴다
function Others:act(id: any, skillId: string, seg: number, x: number, y: number, dir: number, now: number)
	local o = self.list[id]
	local def = COMBAT.skills[skillId] or kitDef(skillId)
	if not o or not def or not def.segs[seg] then
		return
	end
	o.act = { def = def, seg = seg, t0 = now }
	o.dir = dir
	if not o.placed then
		o.x, o.y, o.toX, o.toY, o.fromX, o.fromY, o.placed = x, y, x, y, x, y, true
	end
	-- 대쉬를 시작했다: 속도선(잔상은 update가 가는 동안 남긴다)
	if def.type == "move" and seg == 1 and self.fx then
		self.fx:streaks(x, y, def.speed, dir, CLASSES.classes[o.class].tone)
	end
end

-- party = 내 파티원 { [번호] = true }
function Others:update(now: number, party)
	local dt = math.clamp(now - self.last, 0, 0.1)
	self.last = now
	for id, o in self.list do
		if not o.placed then
			continue
		end
		local k = math.clamp((now - o.at) / LERP, 0, 1)
		o.x = o.fromX + (o.toX - o.fromX) * k
		o.y = o.fromY + (o.toY - o.fromY) * k
		local char = o.sprite.char
		local clip, frame = "idle", Sprite.frameAt(char, "idle", now + (id % 7) * 0.3, false)
		local act = o.act
		if act then
			local segDef = act.def.segs[act.seg]
			local t = now - act.t0
			if t >= segDef.time then
				-- 저절로 이어지는 다음 구간(한 번 더 눌러 잇는 구간은 서버가 따로 알려 준다)
				local nextDef = act.def.segs[act.seg + 1]
				if nextDef and not nextDef.next then
					act.seg += 1
					act.t0 += segDef.time
					segDef, t = nextDef, now - act.t0
				else
					o.act, act = nil, nil
				end
			end
			if act then
				local f = segDef.from + math.floor(t * segDef.fps)
				if f > segDef.to then
					f = if segDef.loops then segDef.loopFrom + ((f - segDef.to - 1) % (segDef.to - segDef.loopFrom + 1)) else segDef.to
				end
				clip, frame = segDef.clip, f + 1
				-- 대쉬로 가는 동안: 잔상
				if act.def.type == "move" and t < act.def.dist / act.def.speed and self.fx and o.alive then
					self.fx:trail(o, dt, o.class, clip, frame, o.x, o.y, o.dir, CLASSES.classes[o.class].tone)
				end
			end
		end
		if not o.alive then
			local n = #char.clips.death.frames
			clip, frame = "death", math.min(n, math.floor((now - (o.deadAt or now)) * char.clips.death.fps) + 1)
		elseif not act then
			local onLadder = false
			for _, l in self.ladders do
				onLadder = onLadder or (math.abs(o.x - l.x) <= 1 and o.y > l.top + 0.5 and o.y < l.bottom - 0.5)
			end
			if onLadder then
				-- 사다리 위: 오르내리는 중이면 장이 넘어가고, 멈춰 있으면 첫 장
				clip, frame = "climb", if now - o.airT < 0.25 then Sprite.frameAt(char, "climb", now, false) else 1
			elseif now - o.airT < 0.25 then
				clip, frame = "jump", Sprite.frameAt(char, "jump", (now - o.airT) + 0.2, true)
			elseif now - o.moveT < 0.25 then
				clip, frame = "run", Sprite.frameAt(char, "run", now, false)
			end
		end
		-- 탈것: 탄 동안 서기 모습으로 앉는 자리에(사다리 위 · 기술 중 · 쓰러짐에는 감춘다)
		local hx, hy = o.x, o.y
		local onRung = false
		for _, l in self.ladders do
			onRung = onRung or (math.abs(o.x - l.x) <= 1 and o.y > l.top + 0.5 and o.y < l.bottom - 0.5)
		end
		local rx, ry = o.rv:update(now, dt, o.x, o.y, o.dir, now - o.moveT < 0.25, now - o.airT < 0.25, onRung or act ~= nil or not o.alive)
		if rx then
			hx, hy = rx, ry
			clip, frame = "idle", Sprite.frameAt(char, "idle", now + (id % 7) * 0.3, false)
		end
		o.sprite:set(clip, frame, hx, hy, o.dir)
		o.clip, o.frame = clip, frame -- 지금의 동작과 장(boot가 버프의 모습을 그 위에 입힌다 — cast.luau의 look)
		-- 쓰러진 사람: 쓰러지는 동작이 끝나면 몸 대신 비석이 선다(마을로 돌아가거나 소생을 받을 때까지)
		local downFor = if o.alive then -1 else now - (o.deadAt or now) - #char.clips.death.frames / char.clips.death.fps
		o.fallen = downFor >= 0
		if o.fallen and self.graveLayer then
			o.grave = o.grave or Grave.new(self.graveLayer)
			Grave.put(o.grave, o.x, o.y, downFor)
			o.sprite.label.Visible = false
		elseif o.grave then
			o.grave.Visible = false
		end
		o.tag.Frame.Visible = true -- 자리는 boot가 정한다(이름표끼리 겹치지 않게 쌓는다 — tags())
		local color = if party and party[id] then MINT else WHITE
		if o.tagColor ~= color then
			o.tagColor = color
			o.tag:SetColor(color)
		end
	end
end

-- 이름표들: { x(왼쪽), y(위), w, frame } — 화면 틀의 점. 번호 차례(늘 같은 차례로 쌓이게)
function Others:tags()
	local out = {}
	for id, o in self.list do
		if o.placed then
			table.insert(out, { id = id, x = Overlay.x(o.x) - math.floor(o.tag.Width / 2), y = Overlay.y(o.y) + TAG_DOWN, w = o.tag.Width, frame = o.tag.Frame })
		end
	end
	table.sort(out, function(a, b)
		return a.id < b.id
	end)
	return out
end

-- 지금 방에 있는 다른 사람들(파티 창의 초대 목록이 쓴다)
function Others:roster()
	local out = {}
	for id, o in self.list do
		table.insert(out, { id = id, name = o.name, level = o.level, class = o.class })
	end
	table.sort(out, function(a, b)
		return a.id < b.id
	end)
	return out
end

function Others:destroy()
	for _, o in self.list do
		drop(o)
	end
	table.clear(self.list)
end

return Others

end
MODULES['Client/lune/overlay'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 게임 세계의 자리에 붙는 화면 글씨 — 발밑의 이름표 · 졸개의 체력 띠 · 주민의 말풍선 · 떠오르는 알림 글.
--  이것들은 글씨라서 화면 틀의 고운 격자에 그리지만(client/lune/stage.luau의 ui 층), 놓이는 자리는 게임 세계의 도트다.
--  그래서 화면마다 "게임 도트 → 화면 틀의 점"으로 바꿔 자리를 다시 잡는다(카메라가 움직이면 같이 움직인다).
--  게임 도트 하나는 화면 틀의 2.5점(1080p)이라 반 점에 걸릴 수 있다 — 가까운 점으로 맞춘다(화면에서 1픽셀 안쪽의 어긋남).
local Stage = require(script.Parent.stage)

local Overlay = {}
Overlay.camX, Overlay.camY = 0, 0

function Overlay.init()
	Overlay.root = Stage.group(Stage.ui, "Over", 20)
	return Overlay
end

-- 장면마다의 층(장면을 바꿀 때 통째로 지운다). z = 겹치는 차례
function Overlay.layer(name: string, z: number): Frame
	return Stage.group(Overlay.root, name, z)
end

-- 카메라(게임 도트)를 알린다 — 장면을 그릴 때마다
function Overlay.setCamera(camX: number, camY: number)
	Overlay.camX, Overlay.camY = camX, camY
end

-- 게임 세계의 (wx, wy) → 화면 틀의 점
function Overlay.x(wx: number): number
	return math.floor((wx - Overlay.camX) * Stage.ratio + 0.5)
end

function Overlay.y(wy: number): number
	return math.floor((wy - Overlay.camY) * Stage.ratio + 0.5)
end

-- 게임 도트의 길이 → 화면 틀의 점(가까운 점으로)
function Overlay.len(dots: number): number
	return math.floor(dots * Stage.ratio + 0.5)
end

return Overlay

end
MODULES['Client/lune/partyHud'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 파티원 칸 — 늘 보이는 화면의 왼쪽 위(공방 「기본 · UI」 탭의 화면 배치, data/ui.generated.luau의 hud.party). 파티가 없으면 안 보인다.
--  파티원(나를 뺀 셋까지)마다 이름(판 없이 테두리 두른 글)과 그 아래 가는 체력 줄. 다른 맵에 있는 사람은 이름이 흐리다. 사람 수만큼 아래로 쌓인다.
--  초대를 받으면 화면 위쪽 가운데에 「○○ — 파티에 초대했다 · 받기 · 거절」이 뜬다(30초 뒤에 저절로 사라진다).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local UI = require(lune.data["ui.generated"])
local Layout = require(lune.ui.layout)
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR
local P = Layout.PARTY -- 치수(자동 검사가 같은 값을 본다)
local ROW = P.row -- 한 사람: 이름 한 줄 + 체력 줄 + 사이

local PartyHud = {}
PartyHud.ROW = ROW
PartyHud.ASK_TEXT = P.askText
PartyHud.ASK = P.ask -- 초대 알림의 자리(위쪽 가운데 — 보스 체력 칸 아래)

function PartyHud.init(root: Frame, send)
	local r = UI.hud.party
	local box = Stage.placeRect(root, "Party", r)
	box.Visible = false
	PartyHud.box = box
	PartyHud.rows = {}
	PartyHud.send = send
	PartyHud.root = root
end

-- Roblox의 채팅 창은 화면 왼쪽 위에 선다 — 파티원 칸의 자리다. PC에서는 파티원 칸을 그 창의 아래 끝(top — 화면 틀의 점. 모르거나 폰이면 0)에서 조금 띄워 그 아래에 놓는다.
--  창이 너무 길어 파티원 칸이 체력 덩어리 쪽으로 밀리게 되면(화면 아래에 keep만큼은 남긴다) 제자리에 둔다. 치수는 공방 ui.js의 CHATUI(gap · keep)
function PartyHud.setTop(top: number)
	local box = PartyHud.box
	if not box then
		return
	end
	local r = UI.hud.party
	local base = Stage.atPosition(r.at, r.x, r.y)
	local y = base.Y.Offset
	local want = top + UI.chatUi.gap
	if top > 0 and want > y and want + r.h <= Stage.uiH - UI.chatUi.keep then
		y = want
	end
	box.Position = UDim2.new(base.X.Scale, base.X.Offset, base.Y.Scale, y)
end

-- info = 서버가 보낸 파티의 모습 { leader, members = { { id, name, class, level, hp, maxHp, scene } … } } · myId = 나 · scene = 내가 있는 맵
function PartyHud.set(info, myId: any, scene: string)
	if not PartyHud.rows then
		return -- 아직 화면을 짓기 전에 서버의 파티 소식이 먼저 왔다(시작할 때) — 장면에 들어갈 때 boot가 다시 부른다
	end
	local r = UI.hud.party
	for _, row in PartyHud.rows do
		row.frame:Destroy()
	end
	table.clear(PartyHud.rows)
	local n = 0
	for _, m in (info and info.members) or {} do
		if m.id ~= myId and n < P.max then
			local frame = Ui.group(PartyHud.box, 0, n * ROW, r.w, ROW, "Member")
			local here = m.scene == scene
			Ui.text(frame, m.name, 0, 0, r.w, { color = if here then C.accent else C.dim, outline = true })
			local bar = Ui.bar(frame, 0, P.barY, P.barW, P.barH, C.hp)
			bar:set(if here then m.hp / math.max(1, m.maxHp) else 0)
			table.insert(PartyHud.rows, { frame = frame })
			n += 1
		end
	end
	PartyHud.box.Visible = n > 0
end

-- 초대 알림. ask = { from, name } — from이 false면 지운다
function PartyHud.ask(ask)
	if PartyHud.prompt then
		PartyHud.prompt:Destroy()
		PartyHud.prompt = nil
	end
	if not ask or not ask.from then
		return
	end
	local a = PartyHud.ASK
	local holder = Stage.place(PartyHud.root, "PartyAsk", a.at, a.x, a.y, a.w, a.h)
	holder.ZIndex = 30
	local panel = Ui.panel(holder, 0, 0, a.w, a.h)
	Ui.text(panel, ask.name, a.pad, 12, a.w - a.pad * 2, { font = "body", color = C.gold })
	Ui.text(panel, PartyHud.ASK_TEXT, a.pad, 32, a.w - a.pad * 2)
	local bw = math.floor((a.w - a.pad * 2 - 8) / 2)
	Ui.button(panel, "받기", a.pad, 52, bw, function()
		PartyHud.send("Party", "accept")
		PartyHud.ask(nil)
	end, { main = true }).frame.Name = "Accept"
	Ui.button(panel, "거절", a.pad + bw + 8, 52, bw, function()
		PartyHud.send("Party", "decline")
		PartyHud.ask(nil)
	end).frame.Name = "Decline"
	PartyHud.prompt = holder
	task.delay(30, function()
		if PartyHud.prompt == holder then
			PartyHud.ask(nil)
		end
	end)
end

return PartyHud

end
MODULES['Client/lune/questHud'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 퀘스트 알리미 — 늘 보이는 화면의 오른쪽 위(공방 「기본 · UI」 탭의 화면 배치, data/ui.generated.luau의 hud.quest).
--  사용자 2026-10-11: "지금 우측 상단에 있는 퀘스트 퀘스트라는 인식이 되지가 않아요 ui 만들어서 퀘스트처럼 보이게하세요" — 전에는 판 없이 글만 오른쪽에 붙여 적었다.
--  이제는 창과 같은 어두운 판 위에(메이플스토리의 퀘스트 알리미처럼):
--   ① 머리줄: 「!」 그림 + 「퀘스트」 + 오른쪽에 「진행 N」
--   ② 하는 중인 퀘스트(전직 → 메인 → 부탁): 갈래의 표(「메인」 노랑 · 「전직」 민트 · 「부탁」 회색) + 이름 / 할 일마다 왼쪽에 글 · 오른쪽에 「3/8」 · 그 아래 진행 띠.
--      다 했으면 「?」 그림 + 「샛별에게 간다」(풀빛)
--   ③ 받을 수 있는 퀘스트(길잡이 — sim/quests.luau의 Q.guide): 가르는 줄 아래에 「받을 수 있는 퀘스트」, 「! 이름」과 「샛별에게 받는다 · 초승달 마을」(레벨이 모자라면 흐리게 「Lv.4부터 받는다」)
--  ④ 길찾기 단추(사용자 2026-10-13: "각각 퀘스트마다  간단한 화살표 버튼 생기게해서  그 버튼 누르면  길찾기"): 퀘스트마다 이름 줄의 오른쪽 끝에 작은 화살표 단추.
--      누르면 그 퀘스트의 길찾기가 켜지고(민트 — 다시 누르면 꺼진다 · 한 번에 하나) 캐릭터 머리 위에 가야 할 쪽의 화살표가 뜬다(셈 shared/lune/ui/navi.luau · 그림 naviArrow.luau)
--  판의 높이는 적은 만큼만이다. 칸의 높이에 들어가는 데까지만 적는다(스마트폰은 손가락 단추에 닿지 않게 더 낮다). 글은 모두 판 안쪽 폭에 들어간다.
--  줄의 차례 · 높이 · 폭의 셈은 shared/lune/ui/questPanel.luau(자동 검사 27이 본다) — 여기서는 그리기만 한다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local UI = require(lune.data["ui.generated"])
local Quests = require(lune.sim.quests)
local Panel = require(lune.ui.questPanel) -- 줄의 차례 · 높이 · 폭의 셈
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)
local Kit = require(script.Parent.ui.kit)

local C = Ui.COLOR
local LINE = Panel.LINE

local QuestHud = {}
QuestHud.W = Panel.W
QuestHud.H = Panel.H
QuestHud.MARK = { new = UI.questMark.new, done = UI.questMark.done } -- 「!」 · 「?」 그림(주민 머리 위의 것과 같다)

QuestHud.touch, QuestHud.buffs = false, false -- 스마트폰 단추가 켜졌는가 · 버프가 떠 있는가
QuestHud.covered = false -- 오른쪽 창이 이 자리를 덮고 있는가(덮인 동안은 그리지 않는다)
QuestHud.shown, QuestHud.guided = 0, 0
QuestHud.any = false -- 적을 것이 있는가(어느 모습에서든 — 없으면 판이 없다)
QuestHud.navi = nil :: string? -- 길찾기를 켠 줄(퀘스트의 이름표 · 일일 의뢰의 이름표)
QuestHud.onNavi = nil :: any -- 길찾기 단추를 눌렀을 때 (이름표)
QuestHud.NAV_ARROW = { { 0, 2, 5, 3 }, { 5, 0, 1, 7 }, { 6, 1, 1, 5 }, { 7, 2, 1, 3 }, { 8, 3, 1, 1 } } -- 단추 안의 오른쪽 화살표(9x7 — 네모들 { x, y, w, h })
QuestHud.size = Panel.SIZE_FIRST -- 알리미의 크기: 최소(머리줄만) · 중간(중요한 것만 — 처음) · 최대(모두). 머리줄의 「−」 · 「+」로 한 단계씩. 이번 접속 동안 이어진다
QuestHud.list = nil :: any -- 스크롤하는 칸
QuestHud.scrollY = 0 -- 스크롤한 자리(다시 그려도 — 몬스터를 잡아 숫자가 오를 때마다 다시 그린다 — 그 자리에 머문다)
QuestHud.total = 0 -- 받은 것의 수(퀘스트 + 일일 의뢰)
QuestHud.glow = nil :: Frame? -- 켠 길찾기 단추의 빛(QuestHud.step이 밝기를 오르내린다)
QuestHud.GLOW = { speed = 5, min = 0.15, max = 0.75 } -- 빛의 빠르기 · 가장 진할 때와 옅을 때의 비침
local last = nil :: any -- 마지막으로 그린 것(접기 단추 · 격자가 바뀌었을 때 다시 그린다)

-- 자리: 버프(바로 위의 칸)가 없으면 그 자리로 올라붙고, 버프가 뜨면 제자리로 내려간다(공방 「기본 · UI」 탭의 4번 칸: "버프가 없으면 그 자리로 올라붙는다").
--  스마트폰 단추가 켜지면 메뉴 단추(오른쪽 위) 아래(data/ui.generated.luau의 hudTouch) — 거기서는 버프가 메뉴 단추의 왼쪽에 떠서 겹치지 않는다
local function place()
	local r = UI.hud.quest
	local t = UI.hudTouch.quest
	if not QuestHud.box then
		return
	end
	if QuestHud.touch and t then
		QuestHud.box.Position = Stage.atPosition(t.at, t.x, t.y)
	else
		QuestHud.box.Position = Stage.atPosition(r.at, r.x, if QuestHud.buffs then r.y else UI.hud.buffs.y)
	end
end

function QuestHud.init(root: Frame)
	local r = UI.hud.quest
	local box = Stage.place(root, "Quests", r.at, r.x, UI.hud.buffs.y, r.w, r.h)
	box.Visible = false
	QuestHud.box = box
	place()
	-- 창 크기가 바뀌어 격자가 달라지면 판이 쓸 수 있는 높이도 달라진다
	if Stage.onResize then
		Stage.onResize(function()
			QuestHud.redraw()
		end)
	end
end

-- 마지막에 그린 것을 다시 그린다(접기 · 펴기 · 격자가 바뀜)
function QuestHud.redraw()
	if last then
		QuestHud.set(last[1], last[2], last[3], last[4])
	end
end

-- 켠 길찾기 단추가 빛난다(그리는 고리가 장마다 부른다 — clock = 흐른 시간)
function QuestHud.step(clock: number)
	local glow = QuestHud.glow
	if glow and glow.Parent then
		local g = QuestHud.GLOW
		glow.BackgroundTransparency = g.min + (g.max - g.min) * (math.sin(clock * g.speed) + 1) / 2
	end
end

function QuestHud.setTouch(on: boolean)
	QuestHud.touch = on
	place()
end

-- 오른쪽 끝에 창이 떴다 · 닫혔다: 창의 바탕이 살짝 비쳐서(ui.js의 panelAlpha) 알리미의 글이 창의 글 뒤로 비쳐 보인다 — 덮인 동안은 감춘다
function QuestHud.setCovered(on: boolean)
	QuestHud.covered = on
	if QuestHud.box then
		QuestHud.box.Visible = not on and QuestHud.any == true
	end
end

-- 버프가 뜨고 사라졌다(켜 둔 사출기 · 영혼 · 열기)
function QuestHud.setBuffs(on: boolean)
	if QuestHud.buffs ~= on then
		QuestHud.buffs = on
		place()
	end
end

-- 길찾기 단추: 줄(y)의 오른쪽 끝에. 꺼져 있으면 어두운 바탕에 밝은 화살표(원래 색).
--  켜면 빛난다(사용자 2026-10-13: "길찾기 활성화되면  빛나고   다시눌러서 비활성화하면 원래색으로 되는형식"): 민트 바탕 + 위쪽의 밝은 줄 + 어두운 화살표, 둘레에 밝은 빛이 번지고 그 빛이 밝아졌다 옅어졌다 한다.
--  누르는 자리는 그림보다 넓다(손가락)
local function naviButton(panel: Instance, y: number, key: string)
	local on = QuestHud.navi == key
	local x = Panel.PAD + Panel.INNER - Panel.NAV_W
	if on then
		local glow = Ui.box(panel, x - 2, y - 2, Panel.NAV_W + 4, Panel.NAV_H + 4, C.accentHot, QuestHud.GLOW.min)
		glow.Name = "NaviGlow"
		QuestHud.glow = glow
	end
	local btn = Ui.box(panel, x, y, Panel.NAV_W, Panel.NAV_H, if on then C.accent else C.panel2)
	btn.Name = "Navi_" .. key
	if on then
		Ui.box(btn, 0, 0, Panel.NAV_W, 2, C.accentHot).Name = "Shine"
	end
	local ox, oy = math.floor((Panel.NAV_W - 9) / 2), math.floor((Panel.NAV_H - 7) / 2)
	for _, r in QuestHud.NAV_ARROW do
		Ui.box(btn, ox + r[1], oy + r[2], r[3], r[4], if on then C.ink else C.text).Name = "Arrow"
	end
	local hit = Ui.group(panel, x - 4, y - 3, Panel.NAV_W + 8, Panel.NAV_H + 6, "NaviHit")
	hit.ZIndex = 8
	Ui.hit(hit).Activated:Connect(function()
		if QuestHud.onNavi then
			QuestHud.onNavi(key)
		end
	end)
end

-- 크기를 바꾸는 단추 둘: 머리줄의 오른쪽 끝에 「−」 · 「+」. 「−」 = 한 단계 줄인다(최대 → 중간 → 최소), 「+」 = 한 단계 늘린다(최소 → 중간 → 최대).
--  더 줄일 · 늘릴 수 없는 쪽의 단추는 흐리게 남는다(자리가 바뀌지 않게 — 잇달아 누르기 쉽다)
local function sizeButton(panel: Instance, plus: boolean)
	local x = Panel.PAD + Panel.INNER - Panel.FOLD_W - (if plus then 0 else Panel.FOLD_W + Panel.FOLD_BETWEEN)
	local y = math.floor((Panel.HEAD - Panel.FOLD_H) / 2) + 1
	local can = if plus then QuestHud.size < Panel.MAX else QuestHud.size > Panel.MIN
	local btn = Ui.box(panel, x, y, Panel.FOLD_W, Panel.FOLD_H, C.panel2)
	btn.Name = if plus then "FoldPlus" else "FoldMinus"
	local ink = if can then C.text else C.line
	local cx, cy = math.floor(Panel.FOLD_W / 2), math.floor(Panel.FOLD_H / 2)
	Ui.box(btn, cx - 3, cy, 7, 1, ink).Name = if can then "Bar" else "BarOff"
	if plus then
		Ui.box(btn, cx, cy - 3, 1, 7, ink).Name = if can then "Bar" else "BarOff"
	end
	if not can then
		return
	end
	-- 누르는 자리: 위아래로는 넉넉히, 옆으로는 두 단추가 겹치지 않게 사이의 절반까지만
	local side = math.floor(Panel.FOLD_BETWEEN / 2)
	local hit = Ui.group(panel, x - (if plus then side else Panel.FOLD_HIT.x), y - Panel.FOLD_HIT.y, Panel.FOLD_W + side + Panel.FOLD_HIT.x, Panel.FOLD_H + Panel.FOLD_HIT.y * 2, if plus then "PlusHit" else "MinusHit")
	hit.ZIndex = 8
	Ui.hit(hit).Activated:Connect(function()
		QuestHud.size = math.clamp(QuestHud.size + (if plus then 1 else -1), Panel.MIN, Panel.MAX)
		QuestHud.scrollY = 0 -- 크기를 바꾸면 맨 위부터
		if QuestHud.list then
			QuestHud.list.CanvasPosition = Vector2.new(0, 0)
		end
		QuestHud.redraw()
	end)
end

-- book = 내 퀘스트의 상태 · names = 주민 id → 이름 · level = 내 레벨(길잡이를 셈한다 — 안 주면 길잡이를 적지 않는다) · daily = 받아 둔 일일 의뢰들(sim/daily.luau의 tracked)
function QuestHud.set(book, names, level: number?, daily: any?)
	local box = QuestHud.box
	-- 스크롤한 자리를 기억해 둔다(아래에서 다시 그린 뒤 그 자리로)
	if QuestHud.list and QuestHud.list.Parent then
		QuestHud.scrollY = QuestHud.list.CanvasPosition.Y
	end
	QuestHud.list = nil
	for _, child in box:GetChildren() do
		child:Destroy()
	end
	last = { book, names, level, daily }
	QuestHud.glow = nil
	local maxH = Panel.maxH(Stage.uiH, QuestHud.touch)
	local rows, height, shown, guided, info = Panel.layout(book or {}, names, level, maxH, daily, QuestHud.size)
	QuestHud.shown = shown
	QuestHud.guided = guided
	QuestHud.total = info.total
	-- 적을 것이 하나도 없으면(어느 크기에서든) 판도 없다. 최소이거나, 중간인데 부탁만 받아 두었으면 머리줄(「진행 N」 · 단추)만 남는다
	QuestHud.any = info.any
	box.Visible = info.any and not QuestHud.covered
	if not info.any then
		return
	end
	local W, PAD, INNER = Panel.W, Panel.PAD, Panel.INNER
	local panel = Ui.panel(box, 0, 0, W, info.view)
	-- ① 머리줄
	local mark = Kit.part(panel, QuestHud.MARK.new, PAD, 0)
	mark.Position = UDim2.fromOffset(PAD, math.floor((Panel.HEAD - mark.Size.Y.Offset) / 2) + 1)
	local headX = PAD + mark.Size.X.Offset + 5
	Ui.text(panel, "퀘스트", headX, 5, INNER - (headX - PAD), { font = "body", color = C.gold })
	if info.total > 0 then
		Ui.text(panel, ("진행 %d"):format(info.total), PAD, 7, INNER - Panel.FOLD_W * 2 - Panel.FOLD_BETWEEN - Panel.FOLD_GAP, { align = "right", color = C.dim })
	end
	sizeButton(panel, false)
	sizeButton(panel, true)
	if shown + guided == 0 then
		return
	end
	Ui.box(panel, PAD, Panel.HEAD, INNER, 1, C.lineHot).Name = "HeadLine"
	-- ② · ③ 스크롤하는 칸 안에(적은 것이 판보다 길 때만 스크롤한다 — 오른쪽 끝에 가는 막대)
	local top = Panel.LIST_TOP
	local winH, allH = info.view - top - Panel.LIST_BOTTOM, height - top - Panel.LIST_BOTTOM
	local list = Ui.scroll(panel, 0, top, W, winH, allH, Panel.SCROLL_W)
	QuestHud.list = list
	QuestHud.scrollY = math.clamp(QuestHud.scrollY, 0, math.max(0, allH - winH))
	list.CanvasPosition = Vector2.new(0, QuestHud.scrollY)
	for _, row in rows do
		local ry = row.y - top
		if row.kind == "quest" then
			local tint = if row.tag == "main" then C.gold elseif row.tag == "job" then C.accent else C.lineHot
			local chip = Ui.box(list, PAD, ry + 1, Panel.TAG_W, 13, tint)
			chip.Name = "Tag"
			Ui.text(chip, Panel.TAGS[row.tag] or "부탁", 0, 1, Panel.TAG_W, { align = "center", color = if row.tag == "side" then C.text else C.ink })
			local nameX = PAD + Panel.TAG_W + Panel.TAG_GAP
			Ui.text(list, row.name, nameX, ry, if row.key then Panel.NAME_W else INNER - Panel.TAG_W - Panel.TAG_GAP, { font = "body", color = if row.tag == "main" then C.gold elseif row.tag == "job" then C.accent else C.text })
			if row.key then
				naviButton(list, ry, row.key)
			end
		elseif row.kind == "step" then
			Ui.text(list, row.text, PAD + 2, ry, INNER - 2 - Panel.COUNT_W, { color = C.text })
			Ui.text(list, row.count, PAD, ry, INNER, { align = "right", color = C.accent })
			local bar = Ui.bar(list, PAD + 2, ry + LINE - 1, INNER - 2, Panel.BAR_H, C.accent, C.panel2)
			bar:set(row.have / math.max(1, row.n))
		elseif row.kind == "ready" then
			local done = Kit.part(list, QuestHud.MARK.done, PAD + 2, ry)
			done.Position = UDim2.fromOffset(PAD + 2, ry + math.floor((LINE - done.Size.Y.Offset) / 2))
			local tx = PAD + 2 + done.Size.X.Offset + 4
			Ui.text(list, row.text, tx, ry, INNER - (tx - PAD), { color = C.green })
		elseif row.kind == "label" then
			if row.line then
				Ui.box(list, PAD, ry, INNER, 1, C.line).Name = "GuideLine"
			end
			Ui.text(list, "받을 수 있는 퀘스트", PAD, ry + (if row.line then 5 else 1), INNER, { color = C.dim })
		elseif row.kind == "guide" then
			-- 받을 수 있는 전직 퀘스트(job)는 민트(「전직」 표의 색) · 다음 메인(open)은 금빛 · 부탁(side)은 흰색 · 레벨이 모자란 것(level)은 흐리게
			Ui.text(list, row.text, PAD, ry, if row.key then Panel.GUIDE_W else INNER, { font = "body", color = if row.tone == "job" then C.accent elseif row.tone == "open" then C.gold elseif row.tone == "side" then C.text else C.dim })
			if row.key then
				naviButton(list, ry, row.key)
			end
		elseif row.kind == "where" then
			Ui.text(list, row.text, PAD + 2, ry, INNER - 2, { color = if row.tone == "level" then C.dim else C.accent })
		end
	end
end

return QuestHud

end
MODULES['Client/lune/rideView'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 펫 · 탈것을 그린다(2026-10-20 — 사용자: "탈것, 펫 애니메이션 만들고, 게임에 적용하고"). 나 · 같은 맵의 다른 사람이 하나씩 갖는다(boot · othersView).
--  그림 = chars.generated의 펫 · 탈것(공방 tools/build_lune_ride_made.mjs — 시안의 도트를 그대로 옮기고 부위를 옮겨 짠 서기 · 뛰기 · 점프).
--  펫(수치 · 까닭 · 출처는 공방 design/ride.js의 RIDE.pet):
--   10-20 사용자 "플레이어랑 펫이 거리가 좀 있어야하고 좀멀리서 쫓아오는 느낌이야 아이템주우면서" → 영웅의 뒤 behind점(44)에 선다 · 빠르기 = base + per x 남은 거리(멀면 빨라진다)
--    · 영웅이 서 있으면 펫은 제가 있던 쪽에 남는다(돌아설 때마다 영웅을 넘어 반대쪽으로 달려가지 않게)
--   10-21 사용자 "펫도 지형에 걸려야해요 지금 펫 지형 다뚫고 다니는데 지형에 걸려서 플레이어에게 가지 못하는 거리가 되어버리면 그때는 텔레포트 해서 붙는방식으로
--    메이플스토리에서 일반펫이 어떻게 작동하는지를 파악하고" → 펫은 영웅과 같은 땅 셈(shared sim/physics.luau)으로 1/60초씩 걷는다:
--    막힌 칸 · 발판 위에 서고 벽에 막힌다 · 벽 · 턱에 막히면 windup초 웅크렸다 뛴다 · 영웅이 위 발판에 있어도 따라 오르지 않는다(메이플의 일반 펫) · 영웅이 아래에 있으면
--    낭떠러지를 걸어 떨어지고 얇은 발판은 하단 점프로 내려간다 · 같은 높이의 건너편이면 뛰어 건넌다 · 사다리는 타지 않는다
--    순간 이동(영웅의 발밑 땅으로): 영웅이 땅에 서 있을 때 가로 warpX · 세로 warpY보다 멀면 · 가려는데 stuck초 동안 못 가고 영웅이 behind점보다 멀면 · 맵 아래로 떨어지면
--   줍기: 내 펫만(drops · onPick을 받은 것) — 영웅에게서 reach점 안 · 펫이 선 높이에서 위 lookUp · 아래 lookDown점 안의 떨어진 것에 달려가(chase) 닿으면 onPick(번호)
--    → 서버(world.luau의 onPetPick)가 확인하고 줍는다. 한 번 해 본 것 · 가다가 막힌 것은 3초 동안 다시 보지 않는다
--  탈것: 탄 동안 영웅의 발밑에 탈것을 그리고, 영웅은 서기 모습으로 앉는 자리(seat)에 · 탈것의 등(<동작>_front)을 영웅 앞에 다시 그린다(다리가 몸에 묻혀 앉은 것으로 보인다).
--   사다리 위 · 기술을 쓰는 동안은 탈것을 감춘다(사용자 10-20 「탈것은 사다리에서 감추기 좋습니다」) — 영웅은 제 동작 그대로.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RIDE = require(ReplicatedStorage.shared.lune.data["ride.generated"])
local G = require(ReplicatedStorage.shared.lune.config.game)
local Physics = require(ReplicatedStorage.shared.lune.sim.physics)
local Sprite = require(script.Parent.sprite)

local RideView = {}
RideView.__index = RideView
local MOUNT = {}
for _, m in RIDE.mounts do
	MOUNT[m.id] = m
end
RideView.MOUNT = MOUNT
local P = RIDE.pet
local STEP = 1 / 60 -- 펫의 걸음(영웅과 같은 1/60초)
local T = G.TILE
local HALF = G.BOX_W / 2

-- layer = 영웅을 그리는 층 · z = 영웅의 ZIndex(탈것 · 펫은 그 뒤, 탈것의 등은 그 앞) · scene = 이 맵의 칸(shared data의 scenes — 펫이 걷는 땅)
function RideView.new(layer: Instance, z: number, scene: any)
	return setmetatable({
		layer = layer, z = z, scene = scene, petId = nil, pet = nil, rideId = nil, mount = nil, front = nil,
		body = nil, acc = 0, pdir = 1, pmoveT = -9, goal = nil, tried = {}, nextPick = 0, windT = nil, prog = nil, warps = 0,
	}, RideView)
end

function RideView:setPet(id: any)
	id = if typeof(id) == "string" then id else nil
	if id == self.petId then
		return
	end
	if self.pet then
		self.pet:destroy()
		self.pet = nil
	end
	self.petId, self.body = id, nil
	if id then
		self.pet = Sprite.new(self.layer, id, self.z - 1)
	end
end

function RideView:setRide(id: any)
	id = if typeof(id) == "string" and MOUNT[id] then id else nil
	if id == self.rideId then
		return
	end
	for _, k in { "mount", "front" } do
		if self[k] then
			self[k]:destroy()
			self[k] = nil
		end
	end
	self.rideId = id
	if id then
		self.mount = Sprite.new(self.layer, id, self.z - 1)
		self.front = Sprite.new(self.layer, id, self.z + 1)
	end
end

function RideView:riding(): boolean
	return self.rideId ~= nil
end

-- (x, y)에서 아래로 maxDown점 안의 첫 땅(막힌 칸 · 얇은 발판의 윗면)이 있는 높이 — 몸 상자가 들어갈 자리만
local function groundBelow(scene, x: number, y: number, maxDown: number): number?
	for ty = math.floor(y / T), math.floor((y + maxDown) / T) do
		local surf = ty * T
		if surf >= y - 0.01 then
			for tx = math.floor((x - HALF) / T), math.floor((x + HALF - 1) / T) do
				local k = Physics.cell(scene, tx, ty)
				if (k == "#" or k == "=") and not Physics.solidBox(scene, x, surf) then
					return surf
				end
			end
		end
	end
	return nil
end
RideView.groundBelow = groundBelow

-- 영웅 곁의 x에 펫이 설 수 있는가: 영웅과 같은 높이의 땅이 있고 · 영웅과 그 자리 사이에 막힌 칸이 없다
local function spotOK(scene, hx: number, hy: number, x: number): boolean
	local sy = groundBelow(scene, x, hy - 4, 12)
	if not sy or math.abs(sy - hy) > 4 then
		return false
	end
	local s = if x > hx then 1 else -1
	for xx = hx, x, s * 6 do
		if Physics.solidBox(scene, xx, hy) then
			return false
		end
	end
	return not Physics.solidBox(scene, x, hy)
end
-- 펫이 설 자리: 영웅의 뒤(side 쪽) behind점 → 그 반 → 반대쪽 behind점 → 그 반 가운데 설 수 있는 첫 곳 · 없으면 영웅의 자리(벽 곁 · 좁은 발판 — 그 자리가 벽 속이면 벽 앞에서 뛰기만 했다)
local function spotFor(scene, hx: number, hy: number, side: number): number
	for _, off in { side * P.behind, side * P.behind / 2, -side * P.behind, -side * P.behind / 2 } do
		if spotOK(scene, hx, hy, hx + off) then
			return hx + off
		end
	end
	return hx
end

-- 영웅의 발밑 땅으로 옮긴다(메이플: 「lands on the ground under you」): 그 땅에서 영웅의 뒤 behind점(spotFor — 설 수 있는 곳)
function RideView:warp(x: number, y: number, dir: number)
	local scene = self.scene
	local b = self.body or { x = x, y = y, vx = 0, vy = 0, ground = false, air = 0 }
	self.body = b
	local gy = groundBelow(scene, x, y, 240) or y -- 영웅의 발밑 땅(사다리 · 공중이면 그 아래)
	local gx = spotFor(scene, x, gy, -dir)
	if Physics.solidBox(scene, gx, gy) then
		gx, gy = x, y -- 그 자리가 막힌 칸이면 영웅이 선 자리(영웅의 발밑은 늘 비어 있다)
	end
	b.x, b.y, b.vx, b.vy, b.ground, b.air, b.climb = gx, gy, 0, 0, true, 0, nil
	self.goal, self.windT, self.prog = nil, nil, nil
	self.warps += 1
end

-- 펫의 한 걸음(1/60초). hero = { x, y, dir, moving, air }
function RideView:petStep(now: number, hero, drops: any?, onPick: ((number) -> ())?)
	local scene, b = self.scene, self.body
	-- 순간 이동: 영웅이 땅에 서 있을 때 멀면(사다리 · 공중에서는 기다린다 — 영웅의 발밑 땅이 아직 정해지지 않았다)
	if not hero.air and (math.abs(hero.x - b.x) > P.warpX or math.abs(hero.y - b.y) > P.warpY) then
		self:warp(hero.x, hero.y, hero.dir)
		return
	end
	-- 주우러 갈 것: 영웅에게서 reach점 안 · 펫이 선 높이의 것(메이플: 펫의 위 50 · 아래 10px) · 펫에게서 가장 가까운 것
	local goal = if self.goal and drops then drops[self.goal] else nil
	if goal and (math.abs(goal.x - hero.x) > P.reach + P.slack or goal.y < b.y - P.lookUp or goal.y > b.y + P.lookDown) then
		goal = nil -- 영웅이 멀어졌다 · 펫이 다른 높이로 갔다
	end
	self.goal = if goal then self.goal else nil
	if not goal and drops and onPick and b.ground and now >= self.nextPick then
		local bd = math.huge
		for id, d in drops do
			if math.abs(d.x - hero.x) <= P.reach and d.y >= b.y - P.lookUp and d.y <= b.y + P.lookDown and (self.tried[id] or 0) <= now then
				local dd = math.abs(d.x - b.x)
				if dd < bd then
					self.goal, goal, bd = id, d, dd
				end
			end
		end
	end
	-- 갈 곳 · 빠르기: 주우러 가면 그것 · 아니면 영웅이 움직이면 그 뒤로, 서 있으면 펫이 있던 쪽에
	local tx, speed
	if goal then
		tx, speed = goal.x, P.chase
	else
		local side = if hero.moving then -hero.dir elseif b.x < hero.x then -1 else 1
		tx = if hero.air then hero.x + side * P.behind else spotFor(scene, hero.x, hero.y, side)
		speed = math.min(P.max, P.base + P.per * math.abs(tx - b.x))
	end
	local d = tx - b.x
	local mx = if math.abs(d) <= (if goal then 1 else 2) then 0 elseif d > 0 then 1 else -1
	local input = { mx = mx, speed = speed / G.RUN }
	local heroBelow = not hero.air and hero.y > b.y + 8
	local wantJump = false
	if b.ground and mx ~= 0 then
		if Physics.solidBox(scene, b.x + mx * 2, b.y) then
			wantJump = true -- 벽 · 턱
		elseif not groundBelow(scene, b.x + mx * (HALF + 2), b.y, 2) then
			-- 낭떠러지: 영웅이 아래면 걸어 떨어진다 · 같은 높이의 건너편이면 뛰어 건넌다 · 위면 멈춘다(메이플의 일반 펫은 다른 발판으로 오르지 않는다)
			if heroBelow then
				-- 그대로 걷는다
			elseif not hero.air and math.abs(hero.y - b.y) <= 8 then
				wantJump = true
			else
				input.mx = 0 -- 선다(걸림은 아래에서 잰다)
			end
		end
	end
	-- 하단 점프: 영웅이 아래에 있고 펫이 얇은 발판 위면(영웅 쪽으로 가까울 때)
	if b.ground and heroBelow and Physics.onPlatform(scene, b) and math.abs(hero.x - b.x) <= P.behind + 24 then
		input.down, input.jump = true, true
	elseif wantJump then
		if not self.windT then
			self.windT = now + P.windup -- 웅크린다(그 자리에 선다)
		end
		if now >= self.windT then
			input.jump, self.windT = true, nil
		else
			input.mx = 0
		end
	elseif b.ground then
		self.windT = nil
	end
	local x0 = b.x
	if Physics.step(scene, b, input, STEP) == "respawn" then
		self:warp(hero.x, hero.y, hero.dir) -- 맵 아래로 떨어졌다
		return
	end
	-- 걸림: 가려는데(mx ~= 0) stuck초 동안 갈 곳 쪽으로 4점도 다가가지 못했다 — 벽 앞에서 뛰기를 되풀이하는 것 · 낭떠러지 앞에서 선 것 모두
	--  (한 걸음씩 세면 웅크림 · 뛰기 사이에 끊겨 키보다 높은 벽에서 영영 세지 못한다)
	local far = math.abs(tx - b.x)
	if mx == 0 then
		self.prog = nil
	elseif not self.prog or far < self.prog.d - 4 then
		self.prog = { d = far, t = now }
	elseif now - self.prog.t >= P.stuck then
		self.prog = nil
		if self.goal then
			self.tried[self.goal] = now + 3 -- 막혀 못 가는 것: 3초 동안 빼고 영웅에게 돌아간다
			self.goal = nil
		elseif not hero.air and math.abs(hero.x - b.x) > P.behind then
			self:warp(hero.x, hero.y, hero.dir) -- 지형에 걸려 영웅에게 가지 못한다(영웅이 바로 위의 발판 · behind점 안이면 기다린다 — 메이플의 일반 펫)
			return
		end
	end
	if math.abs(b.x - x0) > 0.01 then
		self.pdir = if b.x > x0 then 1 else -1
		self.pmoveT = now
	elseif math.abs(hero.x - b.x) > 1 then
		self.pdir = if hero.x > b.x then 1 else -1 -- 멈추면 영웅 쪽을 본다
	end
	-- 닿았다: 줍는다
	if goal and math.abs(goal.x - b.x) <= 3 and math.abs(goal.y - b.y) <= 8 then
		local id = self.goal :: number
		self.tried[id] = now + 3
		self.goal, self.nextPick = nil, now + P.every
		if onPick then
			onPick(id)
		end
	end
end

-- 한 장 그린다. (x, y) = 영웅의 발밑 · dir = 보는 쪽 · moving · air = 옆으로 움직이는 중 · 공중(사다리 위도) · hide = 사다리 위 · 기술 중 · 쓰러짐(탈것을 감춘다)
--  drops = 땅에 떨어진 것들({ [번호] = { x, y } } — effects.luau의 drops) · onPick(번호) = 펫이 닿았다(내 펫만 — 남의 펫은 nil: 따라다니기만)
--  돌려주는 것: 탄 동안 영웅을 그릴 자리(x, y) — 그 밖에는 nil(영웅은 제자리에 제 동작으로)
function RideView:update(now: number, dt: number, x: number, y: number, dir: number, moving: boolean, air: boolean, hide: boolean, drops: any?, onPick: ((number) -> ())?): (number?, number?)
	if self.pet and self.scene then
		if not self.body then
			self:warp(x, y, dir) -- 처음 · 펫을 꺼낸 때: 영웅의 뒤
		end
		local hero = { x = x, y = y, dir = dir, moving = moving, air = air }
		-- 1/60초씩 걷는다(웅크림 · 다시 줍기의 초는 화면의 시각 now로 잰다) · 끊겼다 이어진 화면에서 한꺼번에 몰아 걷지 않게 여덟 걸음까지
		self.acc = math.min(self.acc + dt, STEP * 8)
		while self.acc >= STEP do
			self.acc -= STEP
			self:petStep(now, hero, drops, onPick)
		end
		local b = self.body
		local char = self.pet.char
		local clip = if not b.ground then "jump" elseif now - self.pmoveT < 0.15 then "run" else "idle"
		self.pet:set(clip, Sprite.frameAt(char, clip, now, clip == "jump"), math.floor(b.x + 0.5), math.floor(b.y + 0.5), self.pdir)
	end
	if not self.mount then
		return nil, nil
	end
	local show = not hide
	if not show then
		self.mount.label.Visible = false
		self.front.label.Visible = false
		return nil, nil
	end
	local m = MOUNT[self.rideId]
	local clip = if air then "jump" elseif moving then "run" else "idle"
	local f = Sprite.frameAt(self.mount.char, clip, now, clip == "jump")
	self.mount:set(clip, f, x, y, dir)
	self.front:set(clip .. "_front", f, x, y, dir)
	local bob = (m.bob[clip] and m.bob[clip][f]) or 0
	return x + m.seat.dx * dir, y + m.seat.dy + bob
end

function RideView:destroy()
	self:setPet(nil)
	self:setRide(nil)
end

return RideView

end
MODULES['Client/lune/riftView'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 수정 틈 토벌 중의 화면(2026-10-16 — 공방 시험 탭의 P.paintRiftHud · P.paintRiftEnd와 같은 자리 · 모양).
--  화면 위 가운데의 판: 윗줄 = 단계의 이름(금색)과 남은 시간(1분 아래면 빨강) · 아랫줄 = 「물결 2/4 · 남은 몬스터 6」(마지막 물결은 「정예」) · 「곧 몰려온다」 · 「토벌 완료」 · 「시간이 다 됐다」.
--  끝나면 가운데의 판: 「토벌 완료」와 받은 것(경험치 · 달돈 · 달가루 · 장비) — 오늘 보상을 다 받았으면 그 말 / 「시간이 다 됐다」 · 아래 「n초 뒤 광장으로」.
--  무엇이 언제 바뀌는지는 서버가 정한다(sim/rift.luau — RiftView · RiftPay). 여기서는 받은 것을 그리고, 시계만 받은 뒤로 흐르게 한다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Rift = require(lune.sim.rift)
local Layout = require(lune.ui.layout)
local Format = require(lune.ui.format)
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR
local M = Ui.M
local D = Rift.DATA
local W = D.words
local ROWS = 4 -- 끝의 판의 줄(경험치 · 달돈 · 달가루 · 장비)

local RiftView = {}
RiftView.view = nil -- 서버가 마지막으로 알린 상태(Rift.view) — 토벌의 방에 있을 때만
RiftView.since = 0 -- 그것을 받은 뒤로 흐른 시간(초)
RiftView.paid = nil -- 완료의 보상(RiftPay)

function RiftView.init(root: Frame)
	local H = Layout.RIFT_HUD
	local box = Stage.place(root, "Rift", "tc", math.floor((Stage.REF_W - H.w) / 2), H.y, H.w, H.h)
	box.Visible = false
	Ui.panel(box, 0, 0, H.w, H.h)
	RiftView.box = box
	RiftView.name = Ui.text(box, "", 10, 6, H.w - 70, { color = C.gold })
	RiftView.clock = Ui.text(box, "", 10, 6, H.w - 20, { align = "right" })
	RiftView.what = Ui.text(box, "", 10, 21, H.w - 20)
	-- 끝의 판(완료 · 실패)
	local E = Layout.RIFT_END
	local eh = E.pad * 2 + M.body + 8 + ROWS * E.row + M.small + 6
	local eb = Stage.place(root, "RiftEnd", "tc", math.floor((Stage.REF_W - E.w) / 2), math.floor((Stage.REF_H - eh) / 2) - 20, E.w, eh)
	eb.Visible = false
	RiftView.endBox, RiftView.endH = eb, eh
	RiftView.endPanel = Ui.panel(eb, 0, 0, E.w, eh)
	RiftView.title = Ui.text(eb, "", 0, E.pad, E.w, { font = "body", align = "center" })
	RiftView.rows = {}
	for i = 1, ROWS do
		local ry = E.pad + M.body + 8 + (i - 1) * E.row
		local icon = Ui.smallIcon(eb, "coin", E.pad - 3, ry - 4)
		icon.Visible = false
		RiftView.rows[i] = { icon = icon, text = Ui.text(eb, "", E.pad, ry, E.w - E.pad * 2, { color = C.gold }), y = ry }
	end
	RiftView.back = Ui.text(eb, "", 0, eh - E.pad - M.small + 2, E.w, { align = "center", color = C.dim })
end

-- 토벌의 방에 들어섰다 · 나왔다(view = 방의 rift — 없으면 숨긴다)
function RiftView.enter(view: any)
	RiftView.view, RiftView.since, RiftView.paid = view, 0, nil
	RiftView.box.Visible = view ~= nil
	RiftView.endBox.Visible = false
	RiftView.draw()
end
-- 서버가 상태를 알렸다
function RiftView.set(view: any)
	if not RiftView.view then
		return
	end
	RiftView.view, RiftView.since = view, 0
	RiftView.draw()
end
-- 완료의 보상이 왔다
function RiftView.pay(p: any)
	RiftView.paid = p
	RiftView.draw()
end

local function row(i: number, icon: string?, text: string, color: Color3?)
	local r = RiftView.rows[i]
	r.icon.Visible = icon ~= nil
	if icon then
		Ui.setWorldIcon(r.icon, icon)
	end
	r.text:move(Layout.RIFT_END.pad + (if icon then 16 else 0), r.y)
	r.text:set(text)
	r.text:color(color or C.gold)
end

-- 그린다(받았을 때 · 1초마다 — 시계와 「n초 뒤」)
function RiftView.draw()
	local v = RiftView.view
	if not v then
		return
	end
	local t = Rift.tier(v.tier)
	local run = v.state == "run"
	local rest = math.max(0, v.time - (v.t + (if run then RiftView.since else 0)))
	RiftView.name:set(if t then t.name else "")
	RiftView.clock:set(("%d:%02d"):format(math.floor(rest / 60), math.floor(rest % 60)))
	RiftView.clock:color(if rest < 60 then C.red else C.text)
	local what
	if v.state == "wait" then
		what = W.ready
	elseif v.state == "clear" then
		what = W.clear
	elseif v.state == "fail" then
		what = W.fail
	else
		what = (if v.wave >= v.waves then W.eliteWave else Format.fill(W.wave, { a = v.wave, b = v.waves })) .. " · " .. Format.fill(W.mobs, { n = v.left })
	end
	RiftView.what:set(what)
	RiftView.what:color(if v.state == "clear" then C.green elseif v.state == "fail" then C.red else C.text)
	-- 끝의 판
	local over = v.state == "clear" or v.state == "fail"
	RiftView.endBox.Visible = over
	if not over then
		return
	end
	RiftView.title:set(if v.state == "clear" then W.clear else W.fail)
	RiftView.title:color(if v.state == "clear" then C.green else C.red)
	for i = 1, ROWS do
		row(i, nil, "")
	end
	local p = RiftView.paid
	if v.state == "clear" and p then
		if p.none then
			row(1, nil, W.noPay, C.dim)
		else
			row(1, nil, ("경험치 %s"):format(Format.short(p.xp)))
			row(2, "coin", Format.short(p.money))
			row(3, "dust", Format.short(p.dust))
			if p.gear then
				row(4, nil, p.gearName or "")
			else
				row(4, nil, if p.full then W.full else W.nogear, C.dim)
			end
		end
	end
	local wait = (if v.state == "clear" then D.back else Rift.FAIL_BACK) - (v.after + RiftView.since)
	RiftView.back:set(Format.fill(W.back, { n = math.max(0, math.ceil(wait)) }))
end

-- 매 장면(boot의 LuneFrame): 받은 뒤로 흐른 시간 — 초가 바뀔 때만 다시 그린다
function RiftView.update(dt: number)
	if not RiftView.view then
		return
	end
	local before = math.floor(RiftView.since)
	RiftView.since += dt
	if math.floor(RiftView.since) ~= before then
		RiftView.draw()
	end
end

return RiftView

end
MODULES['Client/lune/sceneView'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 장면 한 개를 그린다 — 하늘색, 멀리서 덜 따라오는 배경 층, 뒤에 놓인 것, 바닥, 주민, (졸개 · 주인공 자리).
--  맵에 놓는 물건은 모두 캐릭터 뒤다(앞에 놓는 것은 캐릭터를 가린다 — 사용자 2026-10-08. 장면 자료의 front는 늘 비어 있다).
--  장면의 갈래: 보통 맵(땅의 윗면이 늘 화면의 같은 높이) · tall(층이 있는 마을 — 카메라가 선 층을 따라 위아래로도 움직인다) · indoor(건물의 실내 — 한 화면, 방 그림 한 장).
--  자료는 shared/lune/data/scenes.generated.luau(공방에서 내보낸 그대로). 좌표는 도트. 놓인 것과 주민은 발밑 가운데가 (x, y)다.
--  이름표는 메이플처럼 발밑에 단다(주민 · 사람 · 몬스터). 그 자리를 내려고 땅의 윗면이 화면의 Kit.GROUND(150) 높이에 오게 장면을 올려 그린다.
--  이름표 · 문 위의 글은 글씨의 층(화면 틀의 고운 격자 — overlay.luau)에 그리고, 화면마다 제 자리(게임 세계의 도트)를 따라가게 한다. 머리 위의 퀘스트 표시(! · ?)는 게임 세계의 그림이다.
--  이름표 · 문 위의 글은 글씨의 층(화면 틀의 고운 격자 — overlay.luau)에 그리고, 화면마다 제 자리(게임 세계의 도트)를 따라가게 한다. 머리 위의 퀘스트 표시(! · ?)는 게임 세계의 그림이다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local G = require(lune.config.game)
local ASSETS = require(lune.data["assets.generated"])
local UI = require(lune.data["ui.generated"])
local SCENES = require(lune.data["scenes.generated"])
local PORTAL = require(lune.data["portal.generated"])
local Stage = require(script.Parent.stage)
local Canvas = require(script.Parent.canvas)
local Kit = require(script.Parent.ui.kit)
local Ui = require(script.Parent.ui.ui)
local Overlay = require(script.Parent.overlay)

local C = Ui.COLOR

local SceneView = {}
SceneView.__index = SceneView
SceneView.TAG_DOWN = 4 -- 이름표: 발밑에서 이만큼 아래(화면 틀의 점)
-- 주민 머리 위의 퀘스트 표시: "!" 받을 수 있는 퀘스트가 있다 · "?" 다 해서 돌려줄 퀘스트가 있다 — 글자 그대로의 작은 표시(게임 세계의 굵은 도트).
--  사용자 2026-10-07: "퀘스트가 있는건 표시가 받을수있는퀘스트는 ! , 완료된퀘스트는 ? 표시였는데 왜 갑자기 전구모양이 생긴건지" → 전구 · 책 그림을 걷어 내고 되돌렸다.
--  부품 이름과 띄우는 높이는 공방에서 온다(data/ui.generated.luau의 questMark — 공방 시험 탭에서 먼저 보고 정한 것. "크기 너무 큽니다" → 피해 숫자만 한 점 글자).
SceneView.MARK = { ["!"] = UI.questMark.new, ["?"] = UI.questMark.done }
SceneView.MARK_UP = UI.questMark.up
SceneView.DOOR_MARK_UP = 9 -- 문 위의 퀘스트 표시: 문의 이름표(글씨 한 줄) 위로 이만큼(게임의 도트)

local function round(v: number): number
	return math.floor(v + 0.5)
end

local function hexColor(hex: string): Color3
	return Color3.fromRGB(tonumber(hex:sub(2, 3), 16), tonumber(hex:sub(4, 5), 16), tonumber(hex:sub(6, 7), 16))
end

-- view = 게임 세계의 층 · tagLayer = 이름표의 층(화면 틀 — overlay)
function SceneView.new(view: Frame, key: string, scene, tagLayer: Frame)
	local self = setmetatable({}, SceneView)
	self.key = key
	self.scene = scene
	self.width = scene.w * G.TILE
	self.height = scene.h * G.TILE
	view.BackgroundColor3 = hexColor(scene.sky)

	local root = Stage.group(view, "Scene_" .. key, 1)
	self.root = root

	-- 배경 층: 그림을 가로로 이어 붙여 화면을 채운다(멀수록 덜 따라온다)
	self.layers = {}
	for i, l in scene.layers do
		local holder = Stage.group(root, "Layer" .. i, i)
		local copies = math.ceil(G.VIEW_W / l.w) + 1
		local labels = {}
		for c = 1, copies do
			labels[c] = Stage.image(holder, "Tile" .. c, ASSETS[l.img] or "", l.w, l.h)
		end
		self.layers[i] = { def = l, labels = labels }
	end

	-- 맵 틀: 카메라만큼 통째로 민다
	local world = Stage.group(root, "World", 10)
	world.Size = UDim2.fromOffset(self.width, self.height)
	self.world = world
	local back = Stage.group(world, "Back", 10)
	local ground = Stage.group(world, "Ground", 20)
	self.portalLayer = Stage.group(world, "Portals", 22) -- 포탈의 그림(땅 위 · 주민과 캐릭터 뒤)
	self.npcLayer = Stage.group(world, "Npcs", 30)
	self.graveLayer = Stage.group(world, "Graves", 35) -- 쓰러진 사람의 비석(졸개 · 캐릭터보다 뒤 — 놓인 것이 캐릭터를 가리지 않는다)
	self.mobLayer = Stage.group(world, "Mobs", 40)
	self.heroLayer = Stage.group(world, "Heroes", 50)
	self.fxLayer = Stage.group(world, "Fx", 55)
	-- 이펙트의 점 그림판(client/lune/canvas.luau): 뒤의 것은 땅과 주민 사이 · 앞의 것은 캐릭터 위 — 시험 탭이 그리는 차례와 같다
	self.fxBack, self.fxFront = Canvas.attach(world, 25, 56)
	self.shakeX, self.shakeY = 0, 0 -- 화면 흔들림(cast.luau가 장마다 넣는다)
	local front = Stage.group(world, "Front", 60)
	self.topLayer = Stage.group(world, "Top", 70) -- 이름표 · 피해 숫자처럼 모든 것 위에 뜨는 것

	local function put(holder: Frame, list)
		local sheet = ASSETS[scene.props] or ""
		for i, p in list do
			local r = scene.rects[p.id]
			if r then
				local label = Stage.image(holder, p.id .. i, sheet, r.w, r.h)
				label.ImageRectOffset = Vector2.new(r.x, r.y)
				label.ImageRectSize = Vector2.new(r.w, r.h)
				label.Position = UDim2.fromOffset(round(p.x - r.w / 2), p.y - r.h)
			end
		end
	end
	put(back, scene.back)
	put(front, scene.front)
	-- 사다리(2026-10-16 밤 — scene.ladders: x · top · bottom 도트): 16점 한 칸을 세로로 쌓는다(땅 앞 · 문 · 주민 · 캐릭터 뒤). 꼭대기는 발판 위로 반 칸 솟는다
	local ladderLayer = Stage.group(world, "Ladders", 21)
	for i, l in scene.ladders or {} do
		local top = l.top - 8
		for k = 0, math.ceil((l.bottom - top) / 16) - 1 do
			local h = math.min(16, l.bottom - top - k * 16)
			local piece = Stage.image(ladderLayer, ("Ladder%d_%d"):format(i, k), ASSETS[scene.ladderImg] or "", 16, h)
			piece.ImageRectSize = Vector2.new(16, h)
			piece.Position = UDim2.fromOffset(round(l.x - 8), top + k * 16)
		end
	end

	for i, g in scene.ground do
		local label = Stage.image(ground, "Ground" .. i, ASSETS[g.img] or "", g.w, g.h)
		label.Position = UDim2.fromOffset(g.x, 0)
	end
	-- 장면을 올려 그려서 화면 아래에 남는 데는 땅속 색으로 메운다
	local deep = Kit.box(ground, 0, self.height, self.width, G.VIEW_H, hexColor(scene.deep or scene.sky))
	deep.Name = "Deep"

	-- 주민: 그림판의 가로 칸 = 누구, 세로 칸 = 서 있는 동작 두 장
	self.npcs = {}
	if scene.npcs then
		local nw, nh = scene.npcCell[1], scene.npcCell[2]
		for i, n in scene.npcs do
			local label = Stage.image(self.npcLayer, n.id, ASSETS[scene.npcSheet] or "", nw, nh)
			label.Position = UDim2.fromOffset(round(n.x - nw / 2), n.y - nh)
			label.Visible = not n.stone -- 비석(명예의 전당): 방 그림에 그려져 있다 — 이름표와 말만 있다
			self.npcs[i] = { def = n, label = label, nw = nw, nh = nh, shown = "" }
		end
	end

	-- 이름표: 주민의 발밑에 구실과 이름(노랑), 문 위에 어디로 가는지(민트). 자리는 update가 화면마다 잡는다
	self.tags = {} -- { label, wx, wy(게임 세계의 자리), dy(거기서 화면 틀의 점으로 얼마나 아래), portal(문의 이름표면 그 문) }
	self.tagOut = {} -- tagList가 돌려주는 표(장마다 다시 채운다)
	self.tagRects = {} -- 주민 · 문의 이름표들의 자리 { x, y, w }(화면 틀의 점)
	local function tag(text: string, wx: number, wy: number, dy: number, color: Color3, portal: any?)
		local label = Ui.tag(tagLayer, text, color, 260)
		table.insert(self.tags, { label = label, wx = wx, wy = wy, dy = dy, portal = portal })
		return label
	end
	for _, npc in self.npcs do
		local n = npc.def
		npc.tag = tag(("%s %s"):format(n.role, n.name), n.x, n.y, SceneView.TAG_DOWN, C.gold)
		-- 퀘스트 표시: 머리 위의 ! (받을 수 있다) · ? (돌려줄 수 있다) — 게임 세계의 그림(굵은 도트)
		npc.mark = Kit.part(self.topLayer, SceneView.MARK["!"], 0, 0) -- 자리는 update가 잡는다(! 와 ? 의 폭이 다르다)
		npc.mark.Visible = false
		npc.mark.Name = "Mark_" .. n.id
		npc.mark.ZIndex = 6
	end
	-- 문 위의 퀘스트 표시: 그 문 안(건물의 실내)에 있는 주민에게 받을 · 돌려줄 퀘스트가 있으면 문 위에 ! · ? 를 띄운다 — 주민이 건물 안에 있어 밖에서는 머리 위의 표시가 보이지 않는다
	--  포탈: 모든 문 · 건물 입구에 같은 그림(빛의 타원 안에서 소용돌이가 돈다)이 놓인다 — 글씨가 아니라 이 그림이 포탈임을 알려 준다(사용자 2026-10-10).
	--   어디로 가는지의 글(↑ 마을 어귀로)은 그 앞에 섰을 때만 보인다(tagList)
	self.doorMarks = {}
	self.portals = {}
	for i, p in scene.portals do
		local glow = Stage.image(self.portalLayer, "Portal_" .. tostring(p.id or p.to), ASSETS[PORTAL.img] or "", PORTAL.w, PORTAL.h) -- 이름표(id)가 없는 문도 있다(새로 지은 맵의 문 — 가는 곳으로 부른다)
		glow.ImageRectSize = Vector2.new(PORTAL.w, PORTAL.h)
		glow.Position = UDim2.fromOffset(round(p.x - PORTAL.w / 2), p.y - PORTAL.h)
		self.portals[i] = { label = glow, phase = i * 0.37, frame = -1, def = p, open = true } -- open = 지나갈 수 있는가(그 퀘스트를 받아야 열리는 문 — setPortals)
		tag("↑ " .. p.label, p.x, p.y - math.max(p.h or 60, PORTAL.h), -(Ui.TAG_H + 2), C.accent, p)
		local dest = SCENES.scenes[p.to]
		if dest and dest.indoor and dest.npcs then
			local ids = {}
			for _, n in dest.npcs do
				table.insert(ids, n.id)
			end
			local mark = Kit.part(self.topLayer, SceneView.MARK["!"], 0, 0)
			mark.Visible = false
			mark.Name = "DoorMark_" .. p.to
			mark.ZIndex = 6
			table.insert(self.doorMarks, { portal = p, ids = ids, mark = mark })
		end
	end

	-- 간이 포탈(2026-10-15 — 사용자: "사냥터 안에서 끝에서 끝으로 이동하는 간이 포탈 거의 투명하게"): 문과 같은 그림을 거의 투명하게 · 앞에 서면 「↑ 오른쪽 끝으로」.
	--  다른 맵으로 가는 문(scene.portals)과 따로다(scene.warps — 공방 maps.js의 warpsFor). 그림은 문과 함께 돌린다(self.portals에 warp = true로 넣는다)
	for i, w in scene.warps or {} do
		local glow = Stage.image(self.portalLayer, "Warp_" .. w.id, ASSETS[PORTAL.img] or "", PORTAL.w, PORTAL.h)
		glow.ImageRectSize = Vector2.new(PORTAL.w, PORTAL.h)
		glow.ImageTransparency = 1 - (scene.warpAlpha or 0.28)
		glow.Position = UDim2.fromOffset(round(w.x - PORTAL.w / 2), w.y - PORTAL.h)
		table.insert(self.portals, { label = glow, phase = i * 0.5, frame = -1, def = w, open = true, warp = true })
		tag("↑ " .. w.label, w.x, w.y - PORTAL.h, -(Ui.TAG_H + 2), C.accent, w)
	end

	self.camX, self.camY = 0, 0
	self.camYf = nil -- 세로 카메라(소수까지) — 첫 update에서 주인공 자리로 잡는다
	self.lastClock = nil
	return self
end

-- 주인공 자리로 카메라를 맞추고(맵 끝에서 멈춘다), 배경 층과 주민을 고친다.
--  보통 맵: 세로는 따라가지 않는다 — 땅의 윗면이 늘 화면의 같은 높이(Kit.GROUND)에 온다. 뛸 때마다 화면이 출렁이지 않는다.
--  층이 있는 맵(scene.tall): 선 층의 발밑이 화면의 Kit.GROUND에 오게 부드럽게 따라간다 — 땅을 딛고 있을 때의 높이만 따르고(뛸 때마다 출렁이지 않게),
--   화면 밖으로 나가려 하면 바로 따라간다. 공방 시험 탭(luneTab.js의 followCam)과 같은 식이다.
-- camOverride = 장면(퀘스트 연출 — cineView.luau)이 카메라를 옮겨 둔 가로 자리(없으면 캐릭터) · npcOver = 장면이 옮긴 주민 { [id] = { x, dir, hidden, walk } }
function SceneView:update(heroX: number, heroY: number, clock: number, grounded: boolean?)
	local cx = round(math.clamp((self.camOverride or heroX) - G.VIEW_W / 2, 0, math.max(0, self.width - G.VIEW_W)))
	local cy = G.GROUND_Y - Kit.GROUND
	if self.scene.tall then
		local top = math.max(0, self.height - Kit.GROUND - (G.GROUND_Y - Kit.GROUND)) -- 카메라가 내려갈 수 있는 끝
		local dt = if self.lastClock then math.clamp(clock - self.lastClock, 0, 0.1) else 0
		self.lastClock = clock
		if not self.camYf then
			self.camYf = math.clamp(heroY - Kit.GROUND, 0, top)
		end
		local want = self.camYf
		if grounded then
			want = heroY - Kit.GROUND
		elseif heroY - self.camYf > G.VIEW_H - 36 then
			want = heroY - (G.VIEW_H - 36)
		elseif heroY - self.camYf < 48 then
			want = heroY - 48
		end
		want = math.clamp(want, 0, top)
		self.camYf += (want - self.camYf) * math.min(1, dt * (if grounded then 7 else 14))
		cy = round(self.camYf)
	end
	self.camX, self.camY = cx, cy
	self.heroX, self.heroY = heroX, heroY
	-- 포탈의 그림을 돌린다
	for _, pt in self.portals do
		local frame = math.floor((clock + pt.phase) * PORTAL.fps) % PORTAL.frames
		if frame ~= pt.frame then
			pt.frame = frame
			pt.label.ImageRectOffset = Vector2.new(frame * PORTAL.w, 0)
		end
	end
	self.world.Position = UDim2.fromOffset(-cx + self.shakeX, -cy + self.shakeY)
	Overlay.setCamera(cx, cy)
	for i, t in self.tags do
		local left, top = Overlay.x(t.wx) - math.floor(t.label.Width / 2), Overlay.y(t.wy) + t.dy
		t.label.Frame.Position = UDim2.fromOffset(left, top)
		local r = self.tagRects[i]
		if not r then
			r = {}
			self.tagRects[i] = r
		end
		r.x, r.y, r.w = left, top, t.label.Width
	end

	for _, layer in self.layers do
		local l = layer.def
		-- f 2 = 맵과 똑같이 움직이는 벽(망루 · 종탑의 안 — 세로로 쌓인 벽 / 회랑 — 가로로 이어 붙는 벽): 카메라와 1:1로 민다
		local lock = l.f >= 2
		local ox = if lock then -(cx % l.w) else -(round(cx * l.f) % l.w)
		if l.d then
			ox = -((round(cx * l.f) - math.floor(clock * l.d)) % l.w) -- 흘러가는 겹(배의 갑판 뒤의 바다 — d = 1초에 미는 점, 음수면 왼쪽으로 · 2026-10-16)
		end
		-- 층이 있는 맵 · 실내는 공방 시험 탭의 식 그대로(멀수록 세로로도 덜 따라온다 — 실내의 방 그림은 f = 0이라 화면에 붙어 있다)
		local oy = if lock then l.y - cy elseif self.scene.tall or self.scene.indoor then round(l.y - cy * l.f * 0.5) else l.y - cy
		for c, label in layer.labels do
			label.Position = UDim2.fromOffset(ox + (c - 1) * l.w, oy)
		end
	end

	-- 주민: 가까이 오면 주인공 쪽을 본다(그림은 오른쪽을 본다)
	for i, npc in self.npcs do
		local n = npc.def
		local o = self.npcOver and self.npcOver[n.id]
		local dir = n.dir
		if o and o.dir then
			dir = o.dir
		elseif math.abs(n.x - heroX) < 70 and heroX ~= n.x then
			dir = if heroX > n.x then 1 else -1
		end
		-- 장면이 옮긴 주민: 그 자리에(걷는 동안은 두 장을 빨리 돌린다) · 숨긴 주민은 보이지 않는다. 장면이 끝나면 제자리로
		local nx = if o and o.x then o.x else n.x
		if npc.atX ~= nx then
			npc.atX = nx
			npc.label.Position = UDim2.fromOffset(round(nx - npc.nw / 2), n.y - npc.nh)
		end
		npc.label.Visible = not n.stone and not (o and o.hidden)
		local frame = math.floor(clock * (if o and o.walk then 8 else 1.6) + (i - 1) * 0.4) % 2
		local key = dir .. ":" .. frame
		if npc.shown ~= key then
			npc.shown = key
			local cols = self.scene.npcCols or 999 -- 그림판을 cols칸마다 접었다(2026-10-16) — 줄마다 서 있는 동작 2장
			local x, y = (n.cell % cols) * npc.nw, (n.cell // cols * 2 + frame) * npc.nh
			if dir >= 0 then
				npc.label.ImageRectOffset = Vector2.new(x, y)
				npc.label.ImageRectSize = Vector2.new(npc.nw, npc.nh)
			else
				npc.label.ImageRectOffset = Vector2.new(x + npc.nw, y)
				npc.label.ImageRectSize = Vector2.new(-npc.nw, npc.nh)
			end
		end
		-- 퀘스트 표시는 천천히 위아래로 떠 있다
		if npc.mark.Visible then
			local mw, mh = npc.mark.Size.X.Offset, npc.mark.Size.Y.Offset
			npc.mark.Position = UDim2.fromOffset(round(n.x - mw / 2), n.y - n.h - mh - SceneView.MARK_UP + (if math.floor(clock * 2 + i) % 2 == 0 then 0 else 1))
		end
	end
	-- 문 위의 퀘스트 표시: 문의 이름표 바로 위에서 같은 식으로 떠 있다
	for i, d in self.doorMarks do
		if d.mark.Visible then
			local p = d.portal
			local mw, mh = d.mark.Size.X.Offset, d.mark.Size.Y.Offset
			d.mark.Position = UDim2.fromOffset(round(p.x - mw / 2), p.y - (p.h or 60) - mh - SceneView.DOOR_MARK_UP + (if math.floor(clock * 2 + i) % 2 == 0 then 0 else 1))
		end
	end
end

-- 주민 · 문의 이름표들: { x(왼쪽), y(위), w, frame }(화면 틀의 점) — 자리는 update가 이미 잡았다. 겹칠 때 보일지는 boot가 정한다
--  문의 이름표(어디로 가는지)는 캐릭터가 그 문 앞에 섰을 때만 넣는다 — 멀리 있는 문의 글은 숨긴다
function SceneView:tagList()
	local out = self.tagOut
	table.clear(out)
	local hx, hy = self.heroX or 0, self.heroY or 0
	for i, r in self.tagRects do
		local t = self.tags[i]
		r.frame = t.label.Frame
		local p = t.portal
		if p and (not self:portalOpen(p) or math.abs(p.x - hx) > PORTAL.near.x or math.abs(p.y - hy) > PORTAL.near.y) then
			r.frame.Visible = false
		else
			table.insert(out, r)
		end
	end
	return out
end

-- 그 퀘스트를 받아야 열리는 문(문의 need — 달의 사당 안의 「사당 지하」)을 열고 닫는다. openOf(문) → 지나갈 수 있는가.
--  닫힌 문은 포탈의 그림도 「↑ 어디로」도 없고, 앞에서 ↑를 눌러도 지나가지 못한다(서버도 같은 것을 본다 — world.luau의 onTravel)
function SceneView:setPortals(openOf: (any) -> boolean)
	for _, pt in self.portals do
		pt.open = pt.warp == true or openOf(pt.def) == true -- 간이 포탈은 늘 열려 있다
		pt.label.Visible = pt.open
	end
end
function SceneView:portalOpen(p: any): boolean
	for _, pt in self.portals do
		if pt.def == p then
			return pt.open
		end
	end
	return true
end

-- 주민 머리 위의 퀘스트 표시를 고친다. markOf(주민 id) → "!" · "?" · nil
function SceneView:setMarks(markOf: (string) -> string?)
	for _, npc in self.npcs do
		local mark = markOf(npc.def.id)
		npc.markText = mark
		Kit.setPart(npc.mark, if mark then SceneView.MARK[mark] else nil)
		if npc.def.id == self.talking then
			npc.mark.Visible = false
		end
	end
	-- 문 위: 그 안의 주민들 가운데 돌려줄 것("?")이 있으면 그것을, 아니면 받을 것("!")을 보인다
	for _, d in self.doorMarks do
		local best: string? = nil
		for _, id in d.ids do
			local mark = markOf(id)
			if mark == "?" or (mark == "!" and best == nil) then
				best = mark
			end
		end
		Kit.setPart(d.mark, if best then SceneView.MARK[best] else nil)
	end
end

-- 말풍선이 떠 있는 주민의 표시는 그동안 숨긴다(말풍선이 그 자리에 뜬다). npcId = nil이면 다시 보인다
function SceneView:setTalking(npcId: string?)
	self.talking = npcId
	for _, npc in self.npcs do
		Kit.setPart(npc.mark, if npc.markText and npc.def.id ~= npcId then SceneView.MARK[npc.markText] else nil)
	end
end

-- 주인공 가까이에 있는 주민(없으면 nil)
function SceneView:npcNear(x: number, y: number)
	local best, bestD = nil, 30
	for _, npc in self.npcs do
		local d = math.abs(npc.def.x - x)
		if d < bestD and math.abs(npc.def.y - y) < 24 and not npc.def.stone then -- 명예의 전당의 비석은 말을 걸지 않는다(순위는 비석에 새겨져 있다 — hallStones.luau)
			best, bestD = npc.def, d
		end
	end
	return best
end

-- 주인공 가까이에 있는 문(없으면 nil)
function SceneView:portalNear(x: number, y: number)
	for _, p in self.scene.portals do
		-- 문 가운데에서 26도트 안(서버는 28까지 받는다). 맵 끝의 문은 벽에 붙어 서서도 들어갈 수 있어야 한다 — 16으로 두었더니 벽까지 달려간 뒤에는 들어가지 못했다
		if math.abs(p.x - x) < 26 and math.abs(p.y - y) < 4 and self:portalOpen(p) then
			return p
		end
	end
	return nil
end

-- 주인공 가까이에 있는 간이 포탈(없으면 nil) — 앞에서 ↑를 누르면 같은 맵의 짝으로(boot.luau → 서버 Hop)
function SceneView:warpNear(x: number, y: number)
	for _, w in self.scene.warps or {} do
		if math.abs(w.x - x) < 16 and math.abs(w.y - y) < 24 then
			return w
		end
	end
	return nil
end

function SceneView:destroy()
	Canvas.detach() -- 그림판은 다음 장면이 다시 쓴다(맵 틀과 같이 없애지 않는다)
	self.root:Destroy()
	for _, t in self.tags do
		t.label:Destroy()
	end
end

return SceneView

end
MODULES['Client/lune/sprite'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 캐릭터 · 졸개 한 몸의 그림. 동작(clip)과 장 번호를 주면 캐릭터 판에서 그 장을 잘라 발밑 가운데 (x, y)에 맞춰 놓는다.
--  판의 그림은 오른쪽을 본다. 왼쪽을 볼 때는 자르는 폭을 음수로 줘서 뒤집는다(그림을 따로 두지 않는다).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local data = ReplicatedStorage.shared.lune.data
local CHARS = require(data["chars.generated"])
local ASSETS = require(data["assets.generated"])
local Stage = require(script.Parent.stage)

local Sprite = {}
Sprite.__index = Sprite
-- 고운 그림의 미리보기 배율(관리 창 「전투 → 보스 크기」): 동작에 k가 적힌 그림(스토리 보스)을 이 배만큼 더 크게 · 작게 그려 본다. 그림만 바뀐다(맞는 자리 · 몸의 판정은 설계값 그대로)
Sprite.preview = 1

-- mask = true면 같은 자리의 흰 실루엣 판(CHARS.masks)으로 그린다 — label.ImageColor3로 색을 입혀 한 색 실루엣을 만든다(대쉬의 잔상)
function Sprite.new(parent: Instance, who: string, z: number?, mask: boolean?)
	local char = CHARS.chars[who]
	assert(char, "없는 캐릭터 " .. tostring(who))
	local self = setmetatable({}, Sprite)
	self.who = who
	self.char = char
	self.pages = if mask then CHARS.masks else CHARS.pages
	self.label = Stage.image(parent, who, "", 1, 1)
	self.label.ZIndex = z or 1
	self.label.Visible = false
	self.page = 0
	return self
end

-- 동작의 장 번호(1부터). once = 한 번만 틀고 마지막 장에서 멈춘다
function Sprite.frameAt(char, clip: string, t: number, once: boolean?): number
	local c = char.clips[clip]
	local n = #c.frames
	local i = math.floor(t * c.fps)
	return (if once then math.min(n - 1, i) else i % n) + 1
end

-- 줄여 그리는 캐릭터(char.size — 펫)의 크기를 지금 화면에서 한 점이 정수 화소가 되게 맞춘다(2026-10-21 사용자 "펫이 해상도가 딱 맞는 크기가 있을거야").
--  화면 화소 / 게임 도트 = Stage.scale(1080p 5 · 1440p 6 · 720p 3). 한 점 = Stage.scale x size 화소 — 소수면 점마다 2 · 3화소가 섞여 눈 · 무늬가 찌그러진다.
--  그래서 Stage.scale x size를 반올림한 화소로(0.6이면 1080p 3화소 = 0.6 · 1440p 4화소 = 0.67 · 720p 2화소 = 0.67). 화면에 꽉 차게 키우는 폰(소수 배율)은 그대로
function Sprite.sizeOn(size: number): number
	local k = Stage.scale
	if size == 1 or k < 2 or k ~= math.floor(k) then
		return size
	end
	return math.max(1, math.floor(k * size + 0.5)) / k
end

-- scale = 몸의 크기(거신의 두 배 — 발밑 가운데를 그대로 두고 커진다. 없으면 1)
function Sprite:set(clip: string, frame: number, x: number, y: number, dir: number, scale: number?)
	local char = self.char
	local c = char.clips[clip]
	local f = c and c.frames[frame]
	local label = self.label
	if not f then
		label.Visible = false -- 빈 장
		self.lastF = nil
		return
	end
	if self.page ~= f[1] then
		self.page = f[1]
		label.Image = ASSETS[self.pages[f[1]]] or ""
	end
	local w, h, dx, dy = f[4], f[5], f[6], f[7]
	local px, py = math.floor(x + 0.5), math.floor(y + 0.5)
	-- 기준점: 캐릭터 동작은 발밑 가운데(ox, oy). 칸 크기가 따로인 동작(날아가는 그림)은 왼쪽 가운데다
	-- 제 기준점이 적힌 동작(몬스터의 마법 그림 = 발밑 가운데 · 날아가는 그림 = 한가운데)은 그것을 쓴다
	local ox, oy = char.ox, char.oy
	if c.ox then
		ox, oy = c.ox, c.oy
	elseif c.fw then
		ox, oy = 0, c.fh / 2
	end
	-- 고운 그림(c.k — 스토리 보스: 사용자가 만든 동작 그림을 받은 화소 그대로 싣고 작게 그린다. k = 그림 한 화소가 세계의 몇 점인가):
	--  부드럽게 줄여 그리고(도트 그림은 점이 또렷하게 — Pixelated) 자리와 크기를 점의 소수 자리까지 둔다. 사용자 2026-10-11: "게임에서 표현되어지는 크기를 줄이라는거에요 스프라이트를 건드리라는게아니라"
	local fine = c.k ~= nil
	-- char.size = 그 캐릭터를 그리는 크기(펫 0.5 — 2026-10-20 사용자 "펫은 유저보다 작아야합니다" · 승인된 그림의 점은 그대로 두고 작게 그린다. 점은 또렷하게(Pixelated))
	local s = (scale or 1) * (if fine then c.k * Sprite.preview else 1) * Sprite.sizeOn(char.size or 1)
	local exact = fine or (char.size ~= nil and char.size ~= 1) -- 줄여 그리는 것은 자리 · 크기를 점의 소수 자리까지(반 점을 버리면 점의 크기가 고르지 않다)
	if self.fine ~= fine then
		self.fine = fine
		label.ResampleMode = if fine then Enum.ResamplerMode.Default else Enum.ResamplerMode.Pixelated
	end
	-- 지난번과 같은 장 · 같은 자리 · 같은 쪽 · 같은 크기면 다시 쓰지 않는다(폰에서 매 장면 몬스터 · 사람마다 다섯 값을 새로 쓰던 것 — 2026-10-18 검토).
	--  보이기만은 늘 맞춘다(부르는 쪽이 잠깐 숨겼다가 다시 그릴 때)
	local flip = dir >= 0
	if self.lastF == f and self.lastX == px and self.lastY == py and self.lastFlip == flip and self.lastS == s and self.lastOx == ox and self.lastOy == oy then
		if not label.Visible then
			label.Visible = true
		end
		return
	end
	self.lastF, self.lastX, self.lastY, self.lastFlip, self.lastS, self.lastOx, self.lastOy = f, px, py, flip, s, ox, oy
	local function R(v: number): number
		return if exact then v else math.floor(v + 0.5)
	end
	label.Size = UDim2.fromOffset(R(w * s), R(h * s))
	if dir >= 0 then
		label.ImageRectOffset = Vector2.new(f[2], f[3])
		label.ImageRectSize = Vector2.new(w, h)
		label.Position = UDim2.fromOffset(px - R((ox - dx) * s), py - R((oy - dy) * s))
	else
		label.ImageRectOffset = Vector2.new(f[2] + w, f[3])
		label.ImageRectSize = Vector2.new(-w, h)
		label.Position = UDim2.fromOffset(px + R((ox - dx - w) * s), py - R((oy - dy) * s))
	end
	label.Visible = true
end

function Sprite:destroy()
	self.label:Destroy()
end

return Sprite

end
MODULES['Client/lune/stage'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 게임 화면의 틀. 층이 둘이다(사용자 2026-10-07: 산나비 계열 도트 게임의 방식 — "훌룡합니다. 하지만 글씨비율은 좀더 작아야합니다"):
--   view = 게임 세계. 384x216도트를 화면에 들어가는 가장 큰 정수 배율로 키워 가운데에 놓는다(도트가 뭉개지지 않게).
--   ui   = 화면의 글씨와 틀. 게임의 도트보다 고운 격자에 따로 그린다 — 1080p에서 960x540(한 점이 화면 2픽셀. 게임의 도트는 5픽셀).
--          격자의 크기는 창 크기에 따라 768x432부터 1152x648까지 달라진다. 그래서 그 안의 것은 화면의 구석(위 · 아래 / 왼쪽 · 가운데 · 오른쪽)에 붙여 놓는다.
--  배율은 층마다 UIScale 하나로 건다 — 그 아래의 모든 것은 그 층의 좌표(1 = 한 점)를 그대로 쓴다.
--  작은 화면(스마트폰): 게임 세계를 정수 배율로만 키우면 화면 높이가 432보다 낮은 폰에서는 1배(384x216)가 되고, 화면 틀의 격자도 384x216이 되어
--   960x540을 기준으로 짠 화면의 칸들이 서로 겹쳐 화면을 다 덮는다(사용자 2026-10-08: "모바일에서 거의 플레이가 불가능한 수준 … ui가 전면을 다가리는").
--   그래서 2배가 안 되는 화면에서는 정수 배율을 버리고 화면에 꽉 차게 키운다 — 화면 틀의 격자는 가장 작은 격자(768x432) 그대로다(화면 틀의 한 점 = 게임 도트의 반).
--  Studio에서 스마트폰 화면을 흉내 내려면 화면 틀(LuneStage)의 속성 Screen = "844x390"처럼 준다(그 크기의 화면인 것처럼 가운데에 그린다). 손가락 단추는 속성 Touch = true.
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local G = require(ReplicatedStorage.shared.lune.config.game)
local UI = require(ReplicatedStorage.shared.lune.data["ui.generated"])

local Stage = {}
Stage.scale = 1 -- 게임 세계의 배율(화면 픽셀 / 게임 도트)
Stage.uiScale = 1 -- 화면 틀의 배율(화면 픽셀 / 화면 틀의 한 점)
Stage.ratio = 1 -- 게임 도트 하나가 화면 틀의 몇 점인가(1080p에서 2.5)
Stage.uiW, Stage.uiH = UI.grid.w, UI.grid.h -- 지금 화면 틀의 격자
Stage.REF_W, Stage.REF_H = UI.grid.w, UI.grid.h -- 자리를 적을 때의 기준 격자(960x540)
Stage.insetTop = 0 -- 화면 왼쪽 위의 Roblox 기본 단추(메뉴 · 채팅)가 가리는 높이(화면 틀의 점) — 왼쪽 위에 붙는 것은 이만큼 내려 놓는다

local resized = {} -- 격자가 바뀌었을 때 부를 것들

-- 게임 세계의 배율 s에서 화면 틀의 배율: 격자의 높이가 540에 가장 가깝게(s 2 · 3 → 1, 4 · 5 · 6 → 2, 7 · 8 → 3 …)
function Stage.uiScaleFor(s: number): number
	return math.max(1, math.floor(0.4 * s + 0.5))
end

-- 화면 크기(w x h)에서의 두 배율: 게임 세계의 배율, 화면 틀의 배율.
--  2배 이상 들어가는 화면: 게임 세계는 들어가는 가장 큰 정수 배율(도트가 뭉개지지 않게), 화면 틀은 uiScaleFor.
--  그보다 작은 화면(스마트폰): 게임 세계를 화면에 꽉 차게(소수 배율), 화면 틀의 격자는 가장 작은 격자 그대로(게임 도트 하나 = 화면 틀의 두 점).
function Stage.scalesFor(w: number, h: number): (number, number)
	local fitScale = math.min(w / G.VIEW_W, h / G.VIEW_H)
	if fitScale >= 2 then
		local s = math.floor(fitScale)
		return s, Stage.uiScaleFor(s)
	end
	local s = math.max(0.5, fitScale)
	return s, s * G.VIEW_W / UI.grid.min.w
end

function Stage.init()
	-- Roblox가 기본으로 띄우는 것 가운데 이 게임이 쓰지 않는 것을 끈다.
	--  참가자 목록은 보이지 않을 때에도 화면 오른쪽 위를 덮어 그 자리의 단추(스마트폰 메뉴 · 창의 닫기)를 가로챈다.
	--  기본 조이스틱 · 뛰기 단추는 우리 터치 단추(touch.luau)와 겹친다. 채팅은 그대로 둔다.
	pcall(function()
		for _, kind in { Enum.CoreGuiType.PlayerList, Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.EmotesMenu } do
			StarterGui:SetCoreGuiEnabled(kind, false)
		end
		GuiService.TouchControlsEnabled = false
		-- 스마트폰은 가로 화면으로만 쓴다(세로로 세우면 게임 화면이 화면 폭에 맞춰 아주 작아진다)
		Players.LocalPlayer:WaitForChild("PlayerGui").ScreenOrientation = Enum.ScreenOrientation.LandscapeSensor
	end)

	local gui = Instance.new("ScreenGui")
	gui.Name = "LuneStage"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 0
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	-- 게임 화면 밖(배율이 딱 맞지 않을 때의 가장자리)은 검게 덮는다
	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(18, 22, 28)
	back.BorderSizePixel = 0
	back.Parent = gui

	-- 틀(holder)은 화면의 정수 점 자리에 놓는다(가운데가 반 점에 걸리면 도트가 어긋난다). 그 안의 층에만 배율을 건다
	local holder = Instance.new("Frame")
	holder.Name = "Holder"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.ClipsDescendants = true
	holder.Parent = gui

	local view = Instance.new("Frame")
	view.Name = "View"
	view.Size = UDim2.fromOffset(G.VIEW_W, G.VIEW_H)
	view.BorderSizePixel = 0
	view.Parent = holder

	local viewScale = Instance.new("UIScale")
	viewScale.Parent = view

	local ui = Instance.new("Frame")
	ui.Name = "Ui"
	ui.BackgroundTransparency = 1
	ui.BorderSizePixel = 0
	ui.ZIndex = 10
	ui.Parent = holder

	local uiScale = Instance.new("UIScale")
	uiScale.Parent = ui

	local function fit()
		local real = gui.AbsoluteSize
		local size = real
		local fake = gui:GetAttribute("Screen")
		if typeof(fake) == "string" then
			local fw, fh = fake:match("^(%d+)x(%d+)$")
			if fw and fh then
				size = Vector2.new(math.min(real.X, tonumber(fw) :: number), math.min(real.Y, tonumber(fh) :: number))
			end
		end
		local s, us = Stage.scalesFor(size.X, size.Y)
		local changed = s ~= Stage.scale or us ~= Stage.uiScale
		Stage.scale, Stage.uiScale, Stage.ratio = s, us, s / us
		Stage.uiW, Stage.uiH = G.VIEW_W * s / us, G.VIEW_H * s / us
		viewScale.Scale = s
		uiScale.Scale = us
		ui.Size = UDim2.fromOffset(Stage.uiW, Stage.uiH)
		local hw, hh = math.floor(G.VIEW_W * s + 0.5), math.floor(G.VIEW_H * s + 0.5)
		holder.Size = UDim2.fromOffset(hw, hh)
		local top = math.floor((real.Y - hh) / 2)
		holder.Position = UDim2.fromOffset(math.floor((real.X - hw) / 2), top)
		-- Roblox 기본 단추의 띠(화면 위 58픽셀쯤)가 게임 화면의 위쪽을 얼마나 덮는가
		local okInset, inset = pcall(function()
			return GuiService:GetGuiInset()
		end)
		Stage.insetTop = if okInset then math.max(0, math.ceil((inset.Y - top) / us)) else 0
		if changed then
			for _, fn in resized do
				fn()
			end
		end
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	gui:GetAttributeChangedSignal("Screen"):Connect(fit)
	fit()

	Stage.gui = gui
	Stage.view = view
	Stage.ui = ui
	return Stage
end

-- 화면 틀의 격자가 바뀌면(창 크기가 바뀌어 배율이 달라지면) fn을 부른다
-- 돌려주는 것: 그 함수를 빼는 함수(화면을 닫을 때 — 2026-10-18 검토: 캐릭터 고르기를 열 때마다 하나씩 쌓여 닫힌 화면을 붙들고 있었다)
function Stage.onResize(fn: () -> ()): () -> ()
	table.insert(resized, fn)
	return function()
		local i = table.find(resized, fn)
		if i then
			table.remove(resized, i)
		end
	end
end

-- 도트 좌표에 놓는 그림 한 장(도트 그림용 설정)
function Stage.image(parent: Instance, name: string, image: string, w: number, h: number): ImageLabel
	local label = Instance.new("ImageLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.ResampleMode = Enum.ResamplerMode.Pixelated
	label.ScaleType = Enum.ScaleType.Stretch
	label.Size = UDim2.fromOffset(w, h)
	label.Image = image
	label.Parent = parent
	return label
end

-- 그림을 담는 빈 틀(겹치는 차례를 틀 단위로 정한다)
function Stage.group(parent: Instance, name: string, z: number): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Size = UDim2.fromScale(1, 1)
	frame.ZIndex = z
	frame.Parent = parent
	return frame
end

-- 화면 틀의 층에 놓는 자리. at = 붙는 구석("tl" · "tc" · "tr" · "bl" · "bc" · "br"), (x, y) = 기준 격자(960x540)에서의 자리.
--  격자가 달라져도 그 구석에서의 거리가 같게 놓인다. 돌려주는 틀 안에서는 (0, 0)부터 그대로 쓴다.
function Stage.atPosition(at: string, x: number, y: number): UDim2
	local fy = if at:sub(1, 1) == "b" then 1 else 0
	local side = at:sub(2, 2)
	local fx = if side == "r" then 1 elseif side == "c" then 0.5 else 0
	-- 왼쪽 위에 붙는 것은 Roblox 기본 단추 아래로 내린다
	local down = if at == "tl" then Stage.insetTop else 0
	return UDim2.new(fx, x - Stage.REF_W * fx, fy, y - Stage.REF_H * fy + down)
end

function Stage.place(parent: Instance, name: string, at: string, x: number, y: number, w: number, h: number): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Position = Stage.atPosition(at, x, y)
	frame.Size = UDim2.fromOffset(w, h)
	frame.Parent = parent
	return frame
end

-- 화면 칸(data/ui.generated.luau의 hud.*)의 자리에 놓는 틀
function Stage.placeRect(parent: Instance, name: string, r): Frame
	return Stage.place(parent, name, r.at, r.x, r.y, r.w, r.h)
end

return Stage

end
MODULES['Client/lune/title'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 처음 화면 — 「달의 계승자」 로딩 화면 → START → 캐릭터 고르기(만들기 · 삭제 · 들어가기).
