--  PC · 스마트폰이 같은 창이다: 누르기 = 톡, 끌기 = 누른 채 움직이기, 두 번 누르기 = 톡톡.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Items = require(lune.sim.items)
local Bag = require(lune.sim.bag)
local Format = require(lune.ui.format)
local ItemInfo = require(lune.ui.itemInfo)
local Layout = require(lune.ui.layout) -- 치수(자동 검사가 같은 값을 본다)
local WORDS = require(lune.data["ui.generated"]).words -- 낱말(장착 · 정렬 …) — 공방에서 정한 것
local Stage = require(script.Parent.Parent.stage)
local Ui = require(script.Parent.ui)
local ItemCell = require(script.Parent.itemCell)
local ItemDetail = require(script.Parent.itemDetail)
local Windows = require(script.Parent.windows)

local C = Ui.COLOR
local D = Items.data
local BAG = Layout.BAG
local COLS, ROWS = BAG.cols, BAG.rows
local GRID_Y = BAG.gridY -- 칸들의 윗줄
local KEYS = D.BAG.keys -- 탭의 이름표("gear" · "use" · "etc")
local DOUBLE = 0.4 -- 이 안에 같은 칸을 다시 누르면 두 번 누른 것(초)
local HOLD = 0.3 -- 스마트폰: 칸을 이만큼(초) 누르고 있다가 밀어야 아이템을 끈다(그 전에 밀면 스크롤)
local BAR = 3 -- 스크롤 막대의 두께(화면 틀의 점 — 칸의 오른쪽 끝에 겹친다)

local BagWindow = { side = "right" } -- 가방은 늘 오른쪽에 뜬다(같이 열린 창은 왼쪽으로 간다)
BagWindow.COLS, BagWindow.ROWS = COLS, ROWS

function BagWindow.size(): (number, number)
	return Layout.bagBody(Stage.ratio)
end

-- 가방을 늘리는 단추의 글
function BagWindow.growText(cost: number): string
	return ("+%d칸 %s"):format(D.BAG.step, Format.short(cost))
end

-- 그 장비를 지금 낄 수 있는가(화면의 단추를 켜고 끄는 데 쓴다 — 서버가 다시 본다)
function BagWindow.canWear(me, it): boolean
	return not it.broken and (it.slot ~= "weapon" or it.who == me.class) and me.level >= Items.needLevel(it)
end

-- 지금 낀 것보다 좋은 장비인가(2026-10-18 — 칸의 왼쪽 위에 초록 ▲): 장착할 수 있고, 장착하면 전투력이 오른다(상세 판의 「장착하면 전투력 +n」과 같은 셈)
function BagWindow.better(me, bag, it): boolean
	if not it or it.item or typeof(it.stage) ~= "number" or typeof(it.q) ~= "number" or typeof(it.star) ~= "number" or not BagWindow.canWear(me, it) then
		return false -- (장비의 꼴이 다 갖춰지지 않은 것 — 셈하지 않는다)
	end
	return ItemInfo.wearDiff(it, (bag.equip or {})[it.slot], me.spec or ItemInfo.refSpec(me.level or 1)) > 0 -- (장착한 것의 표가 없으면 빈 몸으로 셈한다)
end

-- 그림과 숫자(달돈 · 달가루 · 정수). (x, y) = 그림의 왼쪽 위 — 숫자는 그 오른쪽에
local function purse(parent: Instance, icon: string, x: number, y: number, w: number)
	Ui.smallIcon(parent, icon, x, y)
	return Ui.text(parent, "", x + 21, y + 4, w - 21)
end
BagWindow.purse = purse

function BagWindow.build(body: Frame, ctx, w: number, _h: number)
	local ui = ctx.ui
	local S = ItemCell.size()
	local tab = 1
	local sel = nil :: { tab: string, slot: number, id: any }? -- 고른 칸(id = 장비의 번호 · 묶음의 이름표 — 칸의 것이 바뀌면 고른 것을 푼다)
	local ask = nil :: { kind: string, n: number? }? -- 수를 고르는 중(버리기 · 맡기기 · 팔기 · 나누기 — 장비 팔기는 n 없이 묻기만)
	local hot: number? = nil -- 끌던 것을 놓을 칸
	local lastClick = { slot = 0, t = 0 }
	local dragEnd = 0 -- 마지막으로 끌기를 끝낸 때(그 직후에 오는 "눌렀다"는 끌기의 끝이지 누른 것이 아니다)
	local view = {}
	local gridRoot: ScrollingFrame -- 칸들의 스크롤 틀(아래에서 만든다 — 탭 단추가 맨 위로 되돌린다)

	local function key(): string
		return KEYS[tab]
	end
	local function unselect()
		sel, ask = nil, nil
	end
	-- 모든 창을 다시 그린다(상세 판은 하나뿐이라, 여기서 고르면 다른 창이 고른 것은 풀린다)
	local function redraw()
		Windows.refresh(ctx.me())
	end
	local function choose(tabKey: string, slot: number, it)
		sel = { tab = tabKey, slot = slot, id = if it.item then it.item else it.id }
		ask = nil
		ui.detail = "bag"
	end

	local tabs = {}
	local tx = 0
	for i, name in D.BAG.tabs do
		tabs[i] = Ui.tab(body, name, tx, 0, function()
			if tab ~= i then
				tab = i
				unselect()
				gridRoot.CanvasPosition = Vector2.zero -- 다른 탭은 맨 위부터
				redraw()
			end
		end)
		tx += tabs[i].width + 16
	end
	local count = Ui.text(body, "", w - BAG.countW, 0, BAG.countW, { align = "right", color = C.dim }) -- 찬 칸 / 가방의 칸

	-- 고른 칸의 것으로 할 수 있는 일(상세 판의 단추 · 두 번 누르기가 같이 쓴다)
	local function wear(it)
		ctx.send("Item", "equip", it.id)
		unselect()
	end
	local function use(entry)
		local g = Items.goods(entry.item)
		if g and g.kind == "bmRename" and ctx.openRename then
			ctx.openRename() -- 이름 바꾸기 주문서: 새 이름을 적는 칸(상점 창 — 이름이 바뀔 때 서버가 주문서를 쓴다)
			return
		end
		ctx.send("Potion", entry.item)
	end
	-- 팔 때 묻는 것: 장비는 팔지 말지만, 묶음은 몇 개를(처음에는 전부). 팔 수 없는 것(퀘스트의 물건)은 nil
	local function sellAsk(tabKey: string, entry)
		if tabKey == "gear" then
			return { kind = "sellGear" }
		elseif Items.goodsSell(entry.item) > 0 then
			return { kind = "sell", n = entry.n }
		end
		return nil
	end

	gridRoot = Ui.scroll(body, 0, GRID_Y, COLS * S, ROWS * S, ROWS * S, BAR) -- 칸들(늘린 가방은 위아래로 스크롤)
	gridRoot.Name = "Grid"
	local cells = {}
	-- 화면의 그 자리에 있는 칸(가방의 몇째 칸인가 — 없으면 nil). 끌던 것을 놓을 때 쓴다 — 스크롤 틀 밖(가려진 칸)은 아니다
	local function slotAt(at: Vector2): number?
		local bag = ctx.bag()
		if not ItemCell.over(gridRoot, at) then
			return nil
		end
		local n = ItemCell.at(cells, at)
		return if n and bag and n <= bag.size then n else nil
	end
	local function makeCell(i: number)
		local col, row = (i - 1) % COLS, math.floor((i - 1) / COLS)
		local cell
		cell = ItemCell.new(gridRoot, col * S, row * S, function(it)
			local n = i
			local now = os.clock()
			-- 끌어서 놓은 것은 누른 것이 아니다(끌기를 끝낼 때 놓은 자리의 칸에도 "눌렀다"가 온다 — 그대로 받으면 방금 옮긴 것의 고르기가 풀린다)
			if ctx.quick.dragging() or now - dragEnd < 0.2 then
				return
			end
			local twice = it ~= nil and lastClick.slot == n and now - lastClick.t < DOUBLE
			lastClick = { slot = if twice then 0 else n, t = now }
			if not it then
				unselect()
			elseif twice then
				-- 두 번 누르기: 장비는 장착, 소비 아이템은 사용
				local me = ctx.me()
				if key() == "gear" and me and BagWindow.canWear(me, it) then
					wear(it)
				elseif key() == "use" then
					use(it)
				end
			else
				choose(key(), n, it)
			end
			redraw()
		end, S)
		cells[i] = cell
		-- 끌기: 칸의 것을 누른 채 움직이면 그림이 따라온다(ui/quickEdit.luau가 끌기를 맡는다).
		--  가방의 다른 칸 = 옮긴다 · 퀵슬롯 = 소비 아이템을 그 칸에 놓는다 · 창고 창 = 맡긴다 · 상점 창 = 팔지 묻는다
		cell.hit.InputBegan:Connect(function(input)
			local it = cell.item
			if not it then
				return
			end
			local from, tabKey = i, key()
			local moved = false
			ctx.quick.press(if tabKey == "use" then it.item else nil, nil, input, {
				icon = ItemCell.icon(it),
				size = S,
				hold = HOLD, -- 스마트폰: 잠깐 누르고 있다가 밀어야 끈다(그 전에 밀면 스크롤)
				onStart = function()
					gridRoot.ScrollingEnabled = false -- 끄는 동안은 칸들이 움직이지 않는다
				end,
				onMove = function(at: Vector2)
					moved = true
					local to = slotAt(at)
					if hot ~= to then
						hot = to
						view.refresh()
					end
					if ui.storeHover then
						ui.storeHover(at, tabKey) -- 창고의 놓을 칸이 밝아진다
					end
				end,
				onDrop = function(at: Vector2): boolean
					local to = slotAt(at)
					if to and to ~= from then
						ctx.send("Item", "move", tabKey, from, to)
						-- 화면은 바로 옮긴다(서버가 가진 가방이 곧 다시 온다 — 그때 그것으로 맞춘다). 같은 묶음끼리 합치는 것은 서버의 셈을 기다린다
						local bag = ctx.bag()
						local list = if bag then bag[tabKey] else nil
						local a = if list then list[from] else nil
						local b = if list then list[to] else nil
						local merge = tabKey ~= "gear" and a and b and a.item == b.item
						if list and a and not merge then
							list[from], list[to] = b or false, a
						end
						-- 고른 것은 고른 채로 따라간다(합쳐지는 묶음이면 푼다)
						if sel and sel.tab == tabKey and (sel.slot == from or sel.slot == to) then
							if merge then
								unselect()
							else
								sel.slot = if sel.slot == from then to else from
							end
						end
					end
					if to then
						return true -- 가방의 칸에 놓았으면 여기서 끝(퀵슬롯에는 놓지 않는다)
					end
					-- 창고 창 위에 놓았다: 맡긴다(놓은 칸에 — 묶음은 전부)
					if ui.storeDrop and ui.storeDrop(at, tabKey, from) then
						if sel and sel.tab == tabKey and sel.slot == from then
							unselect()
						end
						return true
					end
					-- 대장장이 창 위에 놓았다: 그 장비를 강화할 장비로 올린다(2026-10-15 — 사용자: "강화에 드래그앤 드랍으로 둘수가 없음")
					if tabKey == "gear" and ui.forgeDrop and ui.forgeDrop(at) then
						ctx.toForge(it.id)
						return true
					end
					-- 상점 창 위에 놓았다: 그것을 고르고 팔지 묻는다(상세 판에 — 팔 수 없는 것이면 상세만 뜬다)
					if ui.shopDrop and ui.shopDrop(at) then
						choose(tabKey, from, it)
						ask = sellAsk(tabKey, it)
						redraw()
						return true
					end
					return false
				end,
				onEnd = function()
					if moved then
						dragEnd = os.clock()
					end
					view.refresh() -- 스크롤을 다시 켠다(칸이 넷 줄을 넘을 때)
					if ui.storeHover then
						ui.storeHover(nil, nil)
					end
					if hot then
						hot = nil
						view.refresh()
					end
				end,
			})
		end)
	end

	for i = 1, COLS * ROWS do
		makeCell(i)
	end

	-- 창고에서 끌어 온 것을 놓는 자리(ui/shopWindow.luau의 창고가 묻는다): 가방 창 위인가 · 그 탭의 어느 칸인가.
	--  다른 탭이 열려 있었으면 그 탭으로 넘긴다(찾은 것이 보이게)
	local panel = body.Parent :: GuiObject
	ui.bagDrop = function(at: Vector2, tabKey: string): (boolean, number?)
		if not ItemCell.over(panel, at) then
			return false, nil
		end
		local slot = if tabKey == key() then slotAt(at) else nil
		if tabKey ~= key() then
			tab = table.find(KEYS, tabKey) or tab
			gridRoot.CanvasPosition = Vector2.zero
			unselect()
		end
		return true, slot
	end
	-- 창고에서 「찾기」로 찾았을 때: 가방이 그 탭을 보여 준다(찾은 것이 보이게)
	ui.bagShow = function(tabKey: string)
		if tabKey ~= key() then
			tab = table.find(KEYS, tabKey) or tab
			gridRoot.CanvasPosition = Vector2.zero
			unselect()
		end
	end
	ui.bagHover = function(at: Vector2?, tabKey: string?)
		local to = if at and tabKey == key() then slotAt(at) else nil
		if hot ~= to then
			hot = to
			view.refresh()
		end
	end

	-- 칸 아래: 「정렬」 · 「+4칸 값」, 그 아래 지갑(달돈 · 달가루 · 정수)
	local fy = GRID_Y + ROWS * S + BAG.footY
	local sort = Ui.button(body, WORDS.sort, 0, fy, BAG.sortW, function()
		ctx.send("Item", "sort", key())
		unselect()
		view.refresh()
	end)
	sort.frame.Name = "Sort"
	local grow = Ui.button(body, "", w - BAG.growW, fy, BAG.growW, function()
		ctx.send("Item", "grow")
	end, { font = "small" })
	grow.frame.Name = "Grow"
	Ui.line(body, 0, fy + BAG.purseY - 5, w)
	local pw = Layout.purseW(w)
	local money = purse(body, "coin", -3, fy + BAG.purseY, pw)
	local dust = purse(body, "dust", pw - 3, fy + BAG.purseY, pw)
	local essence = purse(body, "orb", pw * 2 - 3, fy + BAG.purseY, pw)

	-- 고른 것의 상세 판(창 옆)
	local function detail(bag, me)
		if ui.detail ~= "bag" then
			unselect() -- 다른 창에서 골랐다
		end
		local entry = if sel then bag[sel.tab][sel.slot] else nil
		if sel and sel.tab == "gear" and (not entry or entry.id ~= sel.id) then
			-- 고른 장비가 다른 칸으로 갔으면(정렬 · 옮기기) 따라간다
			entry = nil
			for i = 1, bag.size do
				local it = bag.gear[i]
				if it and it.id == sel.id then
					sel.slot, entry = i, it
					break
				end
			end
		elseif sel and sel.tab ~= "gear" and entry and entry.item ~= sel.id then
			entry = nil -- 그 칸에 다른 것이 놓였다(정렬 · 옮기기)
		end
		if not sel or not entry then
			unselect()
			ItemDetail.hide("bag")
			return
		end
		local slot, tabKey, service = sel.slot, sel.tab, ui.service
		local spec = { item = entry, buttons = {}, onClose = function()
			unselect()
			redraw()
		end }
		local function button(text: string, onClick: () -> (), main: boolean?, off: boolean?)
			table.insert(spec.buttons, { text = text, main = main, off = off, onClick = onClick })
		end
		local function stopAsk()
			ask = nil
			view.refresh()
		end
		if tabKey == "gear" then
			local it = entry
			local worn = bag.equip[it.slot]
			local can = BagWindow.canWear(me, it)
			spec.info = ItemInfo.gear(it, me, worn, false)
			if ask and ask.kind == "sellGear" then
				spec.ask = ItemDetail.ask("sellGear", nil, 1, 1, {
					gain = function()
						return Items.sellPrice(it)
					end,
					yes = function()
						ctx.send("Item", "sell", "gear", slot)
						unselect()
						redraw()
					end,
					no = stopAsk,
				})
			elseif ask and ask.kind == "dismantle" then
				-- 분해도 한 번 묻는다(2026-10-18 — 전에는 누르면 바로 사라졌다): 「이 장비를 분해할까요?  달가루 +n」 · 분해 · 취소
				spec.ask = ItemDetail.ask("dismantle", nil, 1, 1, {
					gain = function()
						return Items.dismantle(it)
					end,
					gainWord = "gainDust",
					yes = function()
						ctx.send("Item", "dismantle", it.id)
						unselect()
						redraw()
					end,
					no = stopAsk,
				})
			else
				ask = nil
				button(WORDS.equip, function()
					wear(it)
					redraw()
				end, true, not can)
				button(WORDS.dismantle, function()
					ask = { kind = "dismantle" }
					view.refresh()
				end)
				if service == "store" then
					button(WORDS.toStore, function()
						ctx.send("Item", "storeIn", "gear", slot)
						if ui.storeShow then
							ui.storeShow("gear") -- 창고가 그 탭을 보여 준다(맡긴 것이 보이게)
						end
						unselect()
						redraw()
					end)
				elseif service == "forge" then
					button(WORDS.toForge, function()
						ctx.toForge(it.id)
					end)
				elseif service == "shop" then
					button(WORDS.sell, function()
						ask = { kind = "sellGear" }
						view.refresh()
					end)
				end
			end
			spec.key = table.concat({ "gear", it.id, it.q, it.star, tostring(it.broken), me.level, if worn then worn.id else 0, if worn then worn.star else 0, service or "-", tostring(can), if ask then ask.kind else "-" }, "|")
		else
			local def = Items.goods(entry.item)
			local have = Bag.countIn(bag, entry.item)
			spec.info = ItemInfo.goods(entry.item, me, have)
			if ask and ask.n then
				-- 수를 고른다: 버리기 · 맡기기 · 팔기는 1 ~ 그 칸의 수, 나누기는 1 ~ 하나를 남긴 수
				local kind = ask.kind
				local hi = if kind == "split" then entry.n - 1 else entry.n
				if hi < 1 then
					ask = nil
				else
					local n = math.clamp(ask.n, 1, hi)
					ask.n = n
					spec.ask = ItemDetail.ask(kind, n, 1, hi, {
						gain = if kind == "sell" then function(count: number)
							return def.sell * count
						end else nil,
						set = function(v: number)
							ask = { kind = kind, n = v }
							view.refresh()
						end,
						yes = function(count: number)
							local action = if kind == "store" then "storeIn" else kind -- "discard" · "sell" · "split"
							ctx.send("Item", action, tabKey, slot, count)
							if kind == "store" and ui.storeShow then
								ui.storeShow(tabKey)
							end
							ask = nil
							redraw()
						end,
						no = stopAsk,
					})
				end
			else
				ask = nil
			end
			if not ask then
				if tabKey == "use" then
					button(WORDS.use, function()
						use(entry)
					end, true, def.lv ~= false and me.level < def.lv)
					button(WORDS.quick, function()
						ctx.quick.pick(entry.item) -- 퀵슬롯(스마트폰: 칸 단추)이 반짝인다 — 놓을 칸을 누른다
					end)
				end
				button(WORDS.discard, function()
					ask = { kind = "discard", n = entry.n } -- 처음에는 그 칸의 묶음 전부
					view.refresh()
				end)
				if entry.n > 1 then
					button(WORDS.split, function()
						ask = { kind = "split", n = math.floor(entry.n / 2) } -- 처음에는 절반
						view.refresh()
					end)
				end
				if service == "store" and def.kind ~= "quest" then -- 퀘스트 물건은 맡길 수 없다(sim/bag.luau의 storeIn)
					button(WORDS.toStore, function()
						if entry.n == 1 then
							ctx.send("Item", "storeIn", tabKey, slot, 1)
							if ui.storeShow then
								ui.storeShow(tabKey)
							end
							unselect()
							redraw()
						else
							ask = { kind = "store", n = entry.n }
							view.refresh()
						end
					end)
				elseif service == "shop" and def.sell > 0 then
					button(WORDS.sell, function()
						ask = { kind = "sell", n = entry.n }
						view.refresh()
					end)
				end
			end
			spec.key = table.concat({ tabKey, slot, entry.item, entry.n, have, me.level, service or "-", if ask then ask.kind .. (ask.n or "") else "-" }, "|")
		end
		ItemDetail.show("bag", spec)
	end

	function view.refresh()
		local bag, me = ctx.bag(), ctx.me()
		if not bag or not me then
			return
		end
		for i, button in tabs do
			button:setOn(i == tab)
		end
		local list = bag[key()]
		-- 스크롤: 늘린 가방은 네 줄을 넘는다 — 넘는 만큼 칸을 만들고 스크롤 틀의 속을 늘린다
		local rows = math.ceil(bag.size / COLS)
		for i = #cells + 1, rows * COLS do
			makeCell(i)
		end
		local scroll = rows > ROWS
		gridRoot.CanvasSize = UDim2.fromOffset(0, math.max(ROWS, rows) * S)
		gridRoot.ScrollingEnabled = scroll and not ctx.quick.dragging()
		gridRoot.ScrollBarThickness = if scroll then BAR else 0
		local used = 0
		for i = 1, bag.size do
			if list[i] then
				used += 1
			end
		end
		count:set(("%d / %d"):format(used, bag.size))
		detail(bag, me) -- 고른 것이 사라졌으면 여기서 풀린다
		for i, cell in cells do
			cell.frame.Visible = i <= rows * COLS -- 줄여진 적은 없지만, 넘치는 칸은 숨긴다
			local item = list[i] or nil
			cell:set(item, { locked = i > bag.size, selected = sel ~= nil and sel.tab == key() and sel.slot == i, hot = hot == i, better = key() == "gear" and BagWindow.better(me, bag, item) })
		end
		-- 가방 늘리기(세 탭이 함께 늘어난다 — 값이 적혀 있다). 다 늘렸으면 단추가 없다
		grow.frame.Visible = bag.growCost ~= false
		if bag.growCost ~= false then
			grow:setText(BagWindow.growText(bag.growCost))
			grow:setEnabled(me.money >= bag.growCost)
		end
		sort:setEnabled(used > 1)
		money:set(Format.short(me.money))
		dust:set(Format.short(bag.dust))
		essence:set(Format.short(bag.essence))
	end

	function view.destroy()
		ItemDetail.hide("bag")
		if ui.detail == "bag" then
			ui.detail = nil
		end
		ui.bagDrop, ui.bagHover, ui.bagShow = nil, nil, nil
	end
	return view
end

return BagWindow

end
MODULES['Client/lune/ui/cashWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 달빛 상점 — 메뉴 → 「달빛 상점」(2026-10-20 · 사용자: "경험치 쿠폰 판매해도 됩니다. 꾸밈탈것 만들어도 됩니다. 만들어 봅시다").
--  모양은 공방 시험 탭의 js/lune/ui/paint.js(paintCash · ?lunedemo=cash)와 같다. 글 · 탭 · 상품의 차례는 공방 design/bm.js(BM_SHOP → data/bm.generated.luau의 shop).
--   안내 한 줄 · 탭 다섯(편의 · 재화 · 꾸밈 · 패스 · 보관함 — 받을 것이 있으면 「보관함」 옆에 금빛 수) · 줄의 스크롤 · 아래 「모두 받기」와 알림.
--   상품의 줄: [그림 칸] 이름 · 꼬리표(거래 가능 / 계정) / 한 줄 설명(재화 = 지금 사면 드는 양) / 횟수 · 오른쪽 = 값 · 「구매」(못 사면 「준비 중」 · 다 산 것은 꺼진 「구매」 · 가진 패스는 「보유」).
--  사는 것: 「구매」 → ctx.cashDo("buy", 상품) → 서버가 한도를 보고 로블록스의 구매 창을 띄운다(server/lune/modules/cash.luau) →
--   결제가 끝나면 서버(ProcessReceipt)가 보관함에 넣고 "CashGot"을 보낸다(boot가 알림을 띄우고 창을 고쳐 그린다). 결제를 이 창이 셈하지는 않는다.
--  보관함 → 가방: 「받기」 · 「모두 받기」 → ctx.cashDo("take", 줄?). 이름 바꾸기(arg "rename"): 가방에서 「이름 바꾸기 주문서」를 쓰면 이 창이 이름 칸으로 열린다 → ctx.cashDo("rename", 새 이름).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local BM = require(lune.data["bm.generated"])
local Items = require(lune.sim.items)
local Bag = require(lune.sim.bag)
local Format = require(lune.ui.format)
local Layout = require(lune.ui.layout)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local S = Layout.CASH
local SHOP = BM.shop
local W = SHOP.words
local NAME_MAX = 12 -- 이름 칸에 적을 수 있는 글자 수(캐릭터를 만들 때의 칸과 같다 — client/lune/title.luau)

local CashWindow = {}
CashWindow.PRODUCTS = BM.products
CashWindow.WORDS = W
CashWindow.TITLE = SHOP.title
local BY = {}
for _, p in BM.products do
	BY[p.id] = p
end
-- 줄을 만들어 둘 수: 가장 긴 탭(편의)과 보관함에 들 수 있는 아이템의 가짓수(주머니 · 상자의 레벨대 x 2 + 확장권 · 주문서 · 쿠폰 넷) 가운데 큰 것
local MOST = #BM.bands * 2 + 4
for _, ids in SHOP.rows do
	MOST = math.max(MOST, #ids)
end

function CashWindow.size(arg: any): (number, number)
	if arg == "rename" then
		return S.w, S.renameH
	end
	return S.w, S.listY + S.rows * S.row + S.footY + Ui.M.button
end
function CashWindow.title(arg: any): string
	return if arg == "rename" then W.renameTitle else SHOP.title
end

-- 달빛 패스의 칸(공방 paint.js의 passCells와 같은 셈). pv = 서버의 Pass.view({ reached(연 칸), p(받은 칸) }) — 산 때부터 30일 · 시즌 · 무료 줄은 없다(사용자 10-20)
local PD = BM.pass
local PW = PD.words
function CashWindow.passCells(pv)
	local p = {}
	for _, k in (pv and pv.p) or {} do
		p[k] = true
	end
	local reached = (pv and pv.reached) or 0
	local out = {}
	for i, pd in PD.paid do
		local open = i <= reached
		table.insert(out, { step = i, paid = pd, open = open, gotP = p[i] == true, ready = open and not p[i] })
	end
	return out
end
function CashWindow.passCellW(w: number): number
	return math.floor((w - (S.passCols - 1) * S.passGap) / S.passCols)
end
function CashWindow.passCellText(c): string
	return Format.fill(PW.cell, { n = c.step, paid = ("%s %d"):format(PD.kinds[c.paid[1]].name, c.paid[2]) })
end

-- 보관함의 수(모든 줄의 수를 더한 것)
function CashWindow.boxCount(view): number
	local n = 0
	for _, e in (view and view.box) or {} do
		n += e.n
	end
	return n
end

-- 그 탭의 줄들(공방 paint.js의 cashRows와 같은 셈). view = 서버의 Cash.view
function CashWindow.rows(view, tab: number)
	local key = SHOP.tabs[tab] and SHOP.tabs[tab][1]
	local out = {}
	if key == "box" then
		for i, e in (view and view.box) or {} do
			local g = Items.goods(e.id)
			local from = g and SHOP.boxOf[g.kind] and BY[SHOP.boxOf[g.kind]]
			local text = if from then from.line else ""
			if g and g.kind == "bmMoney" then
				text = Format.fill(W.boxMoney, { n = Format.comma(g.amount) })
			elseif g and g.kind == "bmDust" then
				text = Format.fill(W.boxDust, { n = Format.comma(g.amount) })
			end
			table.insert(out, { box = i, icon = if g and g.icon then g.icon else "bm_starter", name = if g then g.name else e.id, text = text, n = e.n })
		end
		return out
	end
	local list = {}
	for _, v in (view and view.list) or {} do
		list[v.id] = v
	end
	local band = (view and view.band) or 1
	for _, id in SHOP.rows[key] or {} do
		local p = BY[id]
		local v = list[id] or {}
		local lim = p.limit
		local bought = v.bought or 0
		local full = lim ~= false and lim ~= nil and bought >= lim.n
		local text = p.line
		if id == "money" or id == "dust" then
			local g = Items.goods(("bm_%s_%d"):format(id, band))
			if g then
				text = Format.fill(if id == "money" then W.nowMoney else W.nowDust, { n = Format.comma(g.amount), band = band })
			end
		end
		-- 가진 펫 · 탈것(2026-10-20): 값 대신 「꺼내기 · 넣기」 · 「타기 · 내리기」(펫은 하나만 꺼내 둔다 · 탈것은 고른 것을 탄다)
		local isPet, isMount = string.sub(id, 1, 4) == "pet_", string.sub(id, 1, 6) == "mount_"
		local on = if isPet then (view and view.petOut == id) elseif isMount then (view ~= nil and view.riding == true and view.mount == id) else false
		local state = if v.own and isPet then "pet" elseif v.own and isMount then "mount" elseif v.own then "own" elseif not v.ready then "soon" elseif full then "full" else "buy"
		table.insert(out, {
			id = id,
			icon = p.icon,
			name = p.name,
			tag = if p.trade then W.trade else W.account,
			tagTone = if p.trade then "accent" else "dim",
			text = text,
			price = Format.fill(W.price, { n = v.robux or p.robux }), -- 서버가 읽은 로블록스의 실제 값(없으면 설계의 값)
			state = state,
			on = on == true,
			use = if isPet then (if on then W.petOff else W.petOn) elseif isMount then (if on then W.rideOff else W.rideOn) else nil,
			count = if lim and state ~= "pet" and state ~= "mount" then Format.fill(if lim.per == "week" then W.week else W.once, { n = bought, max = lim.n }) else nil,
			full = full,
		})
	end
	return out
end

-- 이름 바꾸기의 모습: 안내 · 가진 주문서 · [이름 칸] 「변경」 · 알림
local function buildRename(body: Frame, ctx, w: number)
	local view = {}
	local note, tone = nil, nil
	local busy = false
	Ui.text(body, W.renameText, 0, 2, w, { color = C.dim })
	local have = Ui.text(body, "", 0, 18, w, {})
	local fw = w - S.btnW - 8
	local field = Ui.field(body, 0, S.renameY, fw, Ui.M.button, W.renamePh)
	local go
	go = Ui.button(body, W.renameGo, w - S.btnW, S.renameY, S.btnW, function()
		local name = field.Text
		if busy or name == "" then
			return
		end
		busy = true
		local res = ctx.cashDo("rename", name)
		busy = false
		if res and res.ok then
			note, tone = Format.fill(W.renameDone, { name = res.name or name }), C.green
			field.Text = ""
		else
			note, tone = (res and res.why) or W.renamePh, C.red
		end
		view.refresh()
	end, { main = true })
	go.frame.Name = "RenameGo"
	local noteText = Ui.text(body, "", 0, S.renameY + Ui.M.button + 8, w, { color = C.dim })
	-- 띄어쓰기는 적히지 않고 너무 길게도 적히지 않는다(캐릭터를 만들 때의 칸과 같다 — 자세한 규칙은 서버의 중복 확인이 알려 준다)
	local ok, changed = pcall(function()
		return field:GetPropertyChangedSignal("Text")
	end)
	if ok and typeof(changed) == "RBXScriptSignal" then
		changed:Connect(function()
			local bare = string.gsub(field.Text, "%s", "")
			if bare ~= field.Text then
				field.Text = bare
				return
			end
			local n = utf8.len(field.Text)
			if n and n > NAME_MAX then
				field.Text = string.sub(field.Text, 1, (utf8.offset(field.Text, NAME_MAX + 1) :: number) - 1)
				return
			end
			view.refresh()
		end)
	end
	function view.refresh()
		local n = Bag.countIn(ctx.bag(), "bm_rename")
		have:set(Format.fill(W.renameHave, { n = n }))
		have:color(if n > 0 then C.gold else C.red)
		go:setEnabled(n > 0 and field.Text ~= "" and not busy)
		noteText:set(note or "")
		noteText:color(tone or C.dim)
	end
	view.refresh()
	return view
end

function CashWindow.build(body: Frame, ctx, w: number, _h: number, arg: any)
	if arg == "rename" then
		return buildRename(body, ctx, w)
	end
	local view = {}
	local tab = 1
	local note, noteTone = nil, nil
	local waiting = false -- 답을 기다리는 중(두 번 눌러 구매 창이 둘 뜨지 않게)
	local textW = w - S.textX - S.sideW - 8
	Ui.text(body, W.head, 0, 2, w, { color = C.dim })
	local tabs = {}
	local tx = 0
	local list: ScrollingFrame
	local passBox: Frame
	for i, t in SHOP.tabs do
		local item = Ui.tab(body, t[2], tx, S.tabY, function()
			if tab ~= i then
				tab = i
				note = nil
				list.CanvasPosition = Vector2.zero -- 다른 탭은 맨 위부터
				view.refresh()
			end
		end)
		item.frame.Name = "Tab_" .. t[1]
		tabs[i] = item
		tx += item.width + 14
	end
	-- 보관함에 받을 것이 있으면 「보관함」 옆에 금빛 수(보관함 탭은 맨 끝이라 다른 탭이 밀리지 않는다)
	local boxN = Ui.text(body, "", tx - 14 + 4, S.tabY, 40, { color = C.gold })
	Ui.line(body, 0, S.listY - 6, w)

	-- 상품 · 보관함의 줄: 스크롤 틀(rows개가 보이고 나머지는 민다 — 마우스 휠 · 손가락). 막대는 판의 오른쪽 여백에
	list = Ui.scroll(body, 0, S.listY, w + 10, S.rows * S.row, MOST * S.row, S.scrollW)
	list.Name = "List"
	local empty = Ui.text(body, W.boxEmpty, 0, S.listY + 20, w, { align = "center", color = C.dim })
	local rowsUi = {}
	for i = 1, MOST do
		local f = Ui.group(list, 0, (i - 1) * S.row, w, S.row, "Row" .. i)
		local r = { frame = f }
		Ui.slot(f, 0, 2, S.iconS)
		r.icon = Ui.pic(f, nil, 2, 4)
		r.name = Ui.text(f, "", S.textX, 3, textW, { font = "body" })
		r.tag = Ui.text(f, "", S.textX, 5, 80, {})
		r.text = Ui.text(f, "", S.textX, 19, textW, { color = C.dim })
		r.count = Ui.text(f, "", S.textX, S.countY, textW, { color = C.accent })
		r.price = Ui.text(f, "", w - S.sideW, S.priceY, S.sideW, { align = "right", color = C.gold })
		r.own = Ui.text(f, W.own, w - S.sideW, S.btnY + 6, S.sideW, { align = "right", color = C.green })
		r.btn = Ui.button(f, W.buy, w - S.btnW, S.btnY, S.btnW, function()
			if waiting or not r.act then
				return
			end
			waiting = true
			local act = r.act
			local res = if act.box then ctx.cashDo("take", act.box) elseif act.pet ~= nil then ctx.cashDo("pet", act.pet) elseif act.ride ~= nil then ctx.cashDo("ride", act.ride) else ctx.cashDo("buy", act.id)
			waiting = false
			note, noteTone = nil, nil
			if res and res.why then
				note, noteTone = res.why, C.red
			elseif act.box and res and res.ok then
				note, noteTone = Format.fill(W.taken, { n = act.n }), C.green
			elseif (act.pet ~= nil or act.ride ~= nil) and res and res.ok then
				note, noteTone = nil, nil -- 꺼냈다 · 탔다(화면의 펫 · 탈것이 바로 보인다)
			elseif res and res.ok then
				note, noteTone = W.asked, C.dim
			end
			view.refresh()
		end, { main = true, h = 22 })
		r.btn.frame.Name = "Act"
		-- 펫 · 탈것의 줄: 그림 · 이름 쪽을 누르면(PC는 올려 두기만 해도) 달빛 상점의 미리보기에 내 캐릭터와 같이(2026-10-21 — 메이플 캐시샵의 미리보기. 단추 자리는 비운다)
		local pv = Ui.group(f, 0, 0, w - S.btnW - 6, S.row, "Preview")
		local hit = Ui.hit(pv)
		local function show()
			if r.preview and ctx.cashPreview then
				ctx.cashPreview(r.preview)
			end
		end
		hit.Activated:Connect(show)
		hit.MouseEnter:Connect(show)
		rowsUi[i] = r
	end

	-- 달빛 패스(개발자 상품 · 산 때부터 30일 — 2026-10-20): 그림 · 이름 · 값 · 「구매」(있으면 「보유」) / 남은 날 · 달빛 · 띠 / 칸 30(10 x 3) / 고른 칸의 보상 · 「보상 받기」
	passBox = Ui.group(body, 0, S.listY + S.passY, w, S.rows * S.row, "Pass")
	local passSel = nil
	local passRow = { cells = {} }
	do
		local PROD = BY.pass
		Ui.slot(passBox, 0, 0, S.iconS)
		Ui.pic(passBox, PROD.icon, 2, 2)
		Ui.text(passBox, PROD.name, S.textX, 1, textW, { font = "body" })
		Ui.text(passBox, if PROD.trade then W.trade else W.account, S.textX + Ui.measure(PROD.name, "body") + 6, 3, 60, { color = C.dim })
		passRow.price = Ui.text(passBox, "", S.textX, 17, textW, { color = C.gold })
		passRow.own = Ui.text(passBox, W.own, w - S.sideW, 8, S.sideW, { align = "right", color = C.green })
		passRow.buy = Ui.button(passBox, W.buy, w - S.btnW, 3, S.btnW, function()
			if waiting then
				return
			end
			waiting = true
			local res = ctx.cashDo("buy", "pass")
			waiting = false
			note, noteTone = nil, nil
			if res and res.why then
				note, noteTone = res.why, C.red
			elseif res and res.ok then
				note, noteTone = W.asked, C.dim
			end
			view.refresh()
		end, { main = true, h = 22 })
		passRow.buy.frame.Name = "PassBuy"
		passRow.season = Ui.text(passBox, "", 0, S.passInfoY, w, { color = C.dim })
		passRow.pts = Ui.text(passBox, "", 0, S.passInfoY, w, { align = "right" })
		local stepW = Ui.measure(Format.fill(PW.step, { n = PD.steps, max = PD.steps })) + 8
		passRow.bar = Ui.bar(passBox, 0, S.passBarY, w - stepW, 6, C.accent, C.panel2)
		passRow.step = Ui.text(passBox, "", 0, S.passBarY - 2, w, { align = "right" })
		local cw = CashWindow.passCellW(w)
		for i = 1, PD.steps do
			local cx = ((i - 1) % S.passCols) * (cw + S.passGap)
			local cy = S.passGridY + ((i - 1) // S.passCols) * (S.passCellH + S.passGap)
			local edge = Ui.box(passBox, cx, cy, cw, S.passCellH, C.line)
			edge.Name = "Step" .. i
			local fill = Ui.box(edge, 1, 1, cw - 2, S.passCellH - 2, C.panel2)
			fill.Name = "Fill"
			local cell = { edge = edge, fill = fill }
			cell.num = Ui.text(edge, tostring(i), 3, 2, cw - 4, {})
			cell.icon = Ui.smallIcon(edge, PD.kinds.potion.icon, math.floor((cw - 18) / 2), S.passCellH - 20)
			cell.tick = {}
			for k, d in { { 0, 2 }, { 1, 3 }, { 2, 4 }, { 3, 3 }, { 4, 2 }, { 5, 1 }, { 6, 0 } } do
				local t = Ui.box(edge, cw - 10 + d[1], S.passCellH - 9 + d[2], 1, 2, C.green)
				t.Name = "Tick" .. k
				table.insert(cell.tick, t)
			end
			Ui.hit(edge).Activated:Connect(function()
				passSel = if passSel == i then nil else i
				view.refresh()
			end)
			passRow.cells[i] = cell
		end
		local dy = S.passGridY + 3 * (S.passCellH + S.passGap) + 2
		passRow.detail = Ui.text(passBox, "", 0, dy + 6, w - S.btnW - 8, { color = C.dim })
		passRow.claim = Ui.button(passBox, PW.claim, w - S.btnW, dy, S.btnW, function()
			if waiting then
				return
			end
			waiting = true
			local res = ctx.cashDo("pass")
			waiting = false
			note, noteTone = nil, nil
			if res and res.ok then
				note, noteTone = Format.fill(PW.got, { n = res.got or 0 }), C.green
			elseif res and res.why then
				note, noteTone = res.why, C.red
			end
			view.refresh()
		end, { main = true, h = 22 })
		passRow.claim.frame.Name = "PassClaim"
	end

	local fy = S.listY + S.rows * S.row + S.footY
	Ui.line(body, 0, fy - 5, w)
	local all = Ui.button(body, W.takeAll, 0, fy, S.allW, function()
		if waiting then
			return
		end
		waiting = true
		local before = CashWindow.boxCount(ctx.cash())
		local res = ctx.cashDo("take")
		waiting = false
		note, noteTone = nil, nil
		if res and res.why then
			note, noteTone = res.why, C.red
		elseif res and res.ok then
			note, noteTone = Format.fill(W.taken, { n = before - CashWindow.boxCount(ctx.cash()) }), C.green
		end
		view.refresh()
	end, { main = true })
	all.frame.Name = "TakeAll"
	local noteText = Ui.text(body, "", S.allW + 10, fy + math.floor((Ui.M.button - Ui.M.small) / 2), w - S.allW - 10, { color = C.dim })

	function view.refresh()
		local v = ctx.cash()
		local key = SHOP.tabs[tab][1]
		for i, t in tabs do
			t:setOn(i == tab)
		end
		local n = CashWindow.boxCount(v)
		boxN:set(if n > 0 then tostring(n) else "")
		local isPass = key == "pass"
		passBox.Visible = isPass
		list.Visible = not isPass
		local rows = if isPass then {} else CashWindow.rows(v, tab)
		empty:show(not isPass and #rows == 0)
		for i, ru in rowsUi do
			local r = rows[i]
			ru.frame.Visible = r ~= nil
			ru.act = nil
			ru.preview = if r and typeof(r.id) == "string" and (string.sub(r.id, 1, 4) == "pet_" or string.sub(r.id, 1, 6) == "mount_") then r.id else nil
			if r then
				Ui.setPic(ru.icon, r.icon)
				ru.name:set(r.name)
				local nw = Ui.measure(r.name, "body")
				ru.tag:set(r.tag or "")
				ru.tag:color(C[r.tagTone or "dim"] or C.dim)
				ru.tag:move(S.textX + nw + 6, 5)
				ru.text:set(r.text)
				if r.box then
					ru.count:set("")
					ru.price:set(("x%d"):format(r.n))
					ru.price:color(C.gold)
					ru.own:show(false)
					ru.btn.frame.Visible = true
					ru.btn:setText(W.take)
					ru.btn:setEnabled(true)
					ru.btn:setMain(true)
					ru.act = { box = r.box, n = r.n }
				elseif r.state == "pet" or r.state == "mount" then
					ru.count:set("")
					ru.price:set(W.own)
					ru.price:color(C.green)
					ru.own:show(false)
					ru.btn.frame.Visible = true
					ru.btn:setText(r.use)
					ru.btn:setEnabled(true)
					ru.btn:setMain(not r.on)
					if r.state == "pet" then
						ru.act = { pet = if r.on then false else r.id }
					else
						ru.act = { ride = if r.on then false else r.id }
					end
				else
					ru.btn:setMain(true)
					ru.count:set(r.count or "")
					ru.count:color(if r.full then C.red else C.accent)
					ru.price:set(r.price)
					ru.price:color(if r.state == "soon" then C.dim else C.gold)
					ru.own:show(r.state == "own")
					ru.btn.frame.Visible = r.state ~= "own"
					ru.btn:setText(if r.state == "soon" then W.soon else W.buy)
					ru.btn:setEnabled(r.state == "buy")
					ru.act = if r.state == "buy" then { id = r.id } else nil
				end
			end
		end
		list.CanvasSize = UDim2.fromOffset(0, math.max(S.rows, #rows) * S.row)
		list.ScrollingEnabled = #rows > S.rows
		list.ScrollBarThickness = if #rows > S.rows then S.scrollW else 0
		if isPass then
			local pv = (v and v.pass) or {}
			local pr = CashWindow.rows(v, tab)[1]
			passRow.price:set(pr.price)
			passRow.price:color(if pr.state == "soon" then C.dim else C.gold)
			passRow.own:show(pv.active == true)
			passRow.buy.frame.Visible = pv.active ~= true
			passRow.buy:setText(if pr.state == "soon" then W.soon else W.buy)
			passRow.buy:setEnabled(pr.state == "buy" and pv.active ~= true)
			passRow.season:set(if pv.active then Format.fill(PW.left, { left = pv.left or 0 }) elseif pv.ended then PW.ended else PW.off)
			passRow.season:color(if pv.active then C.accent else C.dim)
			passRow.pts:set(Format.fill(PW.pts, { n = pv.pts or 0, today = pv.today or 0, cap = PD.dayCap }))
			passRow.bar:set(if (pv.reached or 0) >= PD.steps then 1 else ((pv.pts or 0) % PD.per) / PD.per)
			passRow.step:set(Format.fill(PW.step, { n = pv.reached or 0, max = PD.steps }))
			local me = ctx.me and ctx.me()
			local potion = Items.potionFor(if me then me.level else 1)
			local cells = CashWindow.passCells(pv)
			for i, c in cells do
				local cu = passRow.cells[i]
				cu.edge.BackgroundColor3 = if c.ready then C.gold elseif passSel == c.step then C.accent elseif c.open then C.accentDark else C.line
				cu.fill.BackgroundColor3 = if c.open then C.panelHot else C.panel2
				cu.num:color(if c.open then C.text else C.off)
				Ui.setWorldIcon(cu.icon, if c.paid[1] == "potion" and potion then potion.icon else PD.kinds[c.paid[1]].icon)
				cu.icon.ImageTransparency = if c.gotP then 0.6 else 0 -- 받은 칸 = 흐리게
				for _, t in cu.tick do
					t.Visible = c.gotP
				end
			end
			local sel = passSel and cells[passSel]
			passRow.detail:set(if sel then CashWindow.passCellText(sel) else PD.lines[1])
			passRow.detail:color(if sel then C.text else C.dim)
			passRow.claim:setEnabled((pv.ready or 0) > 0)
		end
		all:setEnabled(n > 0)
		noteText:set(note or (if key == "box" and n > 0 then W.boxHint else ""))
		noteText:color(noteTone or C.dim)
	end
	if ctx.cashFetch then
		ctx.cashFetch() -- 열 때 서버의 지금 것을 받아 온다(받으면 다시 그린다)
	end
	view.refresh()
	return view
end

return CashWindow

end
MODULES['Client/lune/ui/dailyWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 일일 의뢰 창 — 마을의 의뢰 게시판 앞에서 ↑를 누르면 뜬다.
--  사용자 2026-10-13: "일일 퀘스트 필요합니다. 게시판이랑 상호작용해서 일퀘받는거 좋습니다. 근데 좀더 간결하게 해도 될거 같습니다.  5분쯤 걸리게 / 일일 의뢰는 10부터 열죠"
--  머리글(「오늘의 의뢰」 · 「자정에 바뀐다」) 아래에 의뢰마다 한 칸: 맵의 이름(작게) · 「포자 주머니 30마리」 · 오른쪽에 「받는다」 → 「12/30」 → 「낸다」 → 「완료」 · 아래에 진행 띠.
--  그 아래 보상 두 줄: 의뢰 하나(경험치 · [달돈 그림]) · 둘을 다 내면([달가루 그림]) — 내 레벨의 것.
--  받기와 내기는 서버가 정한다(ctx.dailyDo → Daily). 셈은 shared/lune/sim/daily.luau, 모양은 공방 시험 탭의 js/lune/ui/paint.js(paintDaily)와 같다.
--  화면 오른쪽의 옆 판(ui/windows.luau). 게시판에서 멀어지면 닫힌다(boot.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Daily = require(lune.sim.daily)
local Format = require(lune.ui.format)
local Layout = require(lune.ui.layout)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local S = Layout.DAILY
local W = Daily.WORDS

local DailyWindow = {}
DailyWindow.ROWS = Daily.DATA.perDay

function DailyWindow.size(): (number, number)
	return S.w, S.top + DailyWindow.ROWS * S.row + S.payY + 2 * S.payRow
end

-- 의뢰의 이름: 「포자 주머니 30마리」
function DailyWindow.taskName(t): string
	return Format.fill(W.kill, { name = t.name, n = t.n })
end

function DailyWindow.build(body: Frame, ctx, w: number, _h: number, arg: any)
	local view = {}
	local region = if typeof(arg) == "string" and Daily.DATA.boards[arg] then arg else Daily.REGION -- 연 게시판의 지역(은달 항구 = 수정 숲 — 2026-10-16)
	Ui.text(body, W.head, 0, 2, w, { color = C.gold })
	Ui.text(body, W.reset, 0, 2, w, { align = "right", color = C.dim })
	local rows = {}
	local textW = w - S.btnW - 8
	for i = 1, DailyWindow.ROWS do
		local y = S.top + (i - 1) * S.row
		local by = y + 14
		local row = {}
		row.place = Ui.text(body, "", 0, y, textW, { color = C.dim })
		row.name = Ui.text(body, "", 0, y + 15, textW, { font = "body" })
		row.button = Ui.button(body, W.accept, w - S.btnW, by, S.btnW, function()
			local board = ctx.daily() and ctx.daily().boards[region]
			local t = board and board.tasks[i]
			-- 두 번 톡 하면 두 번째가 「아직 다 잡지 못했다 · 이미 받은 의뢰다」를 띄웠다(2026-10-18 검토) — 0.8초 안의 다시 누름은 받지 않는다
			local act = if t and t.st == Daily.OPEN then "accept" else "turn"
			if t and (act ~= row.act or os.clock() - (row.at or -9) > 0.8) then -- 같은 일만 막는다(수락한 뒤 바로 보상 받기는 된다)
				row.at, row.act = os.clock(), act
				ctx.dailyDo(act, region, i)
			end
		end, { main = true })
		row.count = Ui.text(body, "", w - S.btnW, by + math.floor((Ui.M.button - Ui.M.small) / 2), S.btnW, { align = "right", color = C.accent })
		row.bar = Ui.bar(body, 0, y + 34, textW, S.barH + 2, C.accent, C.panel2)
		rows[i] = row
	end
	local y = S.top + DailyWindow.ROWS * S.row
	Ui.line(body, 0, y, w)
	y += S.payY
	-- 보상: 의뢰 하나 = 경험치 · [달돈] / 둘을 다 내면 = [달가루]
	Ui.text(body, W.each, 0, y + 4, S.labelW - 4, { color = C.dim })
	local xp = Ui.text(body, "", S.labelW, y + 4, w - S.labelW, { color = C.gold })
	local coin = Ui.smallIcon(body, "coin", S.labelW, y)
	local money = Ui.text(body, "", S.labelW, y + 4, w - S.labelW, { color = C.gold })
	Ui.text(body, W.all, 0, y + S.payRow + 4, S.labelW - 4, { color = C.dim })
	Ui.smallIcon(body, "dust", S.labelW, y + S.payRow)
	local dust = Ui.text(body, "", S.labelW + 21, y + S.payRow + 4, w - S.labelW - 21, { color = C.gold })

	function view.refresh()
		local got = ctx.daily()
		local board = got and got.boards[region]
		for i, row in rows do
			local t = board and board.tasks[i]
			local ready = t ~= nil and Daily.isReady(t)
			local act = t ~= nil and (t.st == Daily.OPEN or ready)
			row.place:set(if t then t.place else "")
			row.name:set(if t then DailyWindow.taskName(t) else "")
			row.name:color(if t and t.st == Daily.DONE then C.dim else C.text)
			row.button.frame.Visible = act
			if t and act then
				row.button:setText(if t.st == Daily.OPEN then W.accept else W.turn)
			end
			row.count:set(if not t or act then "" elseif t.st == Daily.DONE then W.done else ("%d/%d"):format(math.min(t.have, t.n), t.n))
			row.count:color(if t and t.st == Daily.DONE then C.green else C.accent)
			row.bar.frame.Visible = t ~= nil
			if t then
				row.bar:set(if t.st == Daily.DONE then 1 elseif t.st == Daily.OPEN then 0 else t.have / t.n)
				row.bar:setColor(if t.st == Daily.DONE then C.green else C.accent)
			end
		end
		local pay = board and board.pay
		local xpText = if pay then ("%s %s"):format(W.xp, Format.short(pay.xp)) else ""
		xp:set(xpText)
		local mx = S.labelW + Ui.measure(xpText) + 12
		coin.Visible = pay ~= nil
		coin.Position = UDim2.fromOffset(mx, y)
		money:move(mx + 21, y + 4)
		money:set(if pay then Format.short(pay.money) else "")
		dust:set(if pay then Format.short(pay.dust) else "")
	end
	view.refresh()
	return view
end

return DailyWindow

end
MODULES['Client/lune/ui/deathBox'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 쓰러졌을 때 묻는 상자 — 「쓰러졌다 · 마을로 돌아갈까요?」와 단추 하나(공방 js/lune/design/ui.js의 UILAYOUT.death → Layout.DEATH).
--  사용자 2026-10-08: "죽으면 비석 세우고, 모달띄워서 마을로 갈거냐고 물어보는 딜레이를 넣읍시다."
--  쓰러지고 조금 뒤(싸움의 규칙 reviveWait)에 화면 위쪽 가운데에 뜬다. 단추를 누를 때까지 떠 있고(저절로 마을로 가지 않는다), 파티원이 소생으로 일으켜 주면 사라진다.
--  파티 초대 알림(partyHud.luau)과 같은 부품으로 짓는다 — PC는 마우스로, 스마트폰은 손가락으로 누른다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Layout = require(ReplicatedStorage.shared.lune.ui.layout)
local Stage = require(script.Parent.Parent.stage)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local D = Layout.DEATH

local DeathBox = {}
DeathBox.holder = nil :: Frame?

function DeathBox.shown(): boolean
	return DeathBox.holder ~= nil
end

function DeathBox.hide()
	if DeathBox.holder then
		DeathBox.holder:Destroy()
		DeathBox.holder = nil
	end
end

-- root = 늘 보이는 화면의 틀 · onReturn = 「마을로 돌아간다」를 눌렀을 때 · weakMin = 되살아난 뒤 약해짐이 남는 분(0이면 그 줄을 비운다 — Lv.10 아래는 벌칙이 없다)
function DeathBox.show(root: Instance, onReturn: () -> (), weakMin: number?)
	DeathBox.hide()
	local holder = Stage.place(root, "DeathBox", D.at, D.x, D.y, D.w, D.h)
	holder.ZIndex = 40
	local panel = Ui.panel(holder, 0, 0, D.w, D.h)
	local inner = D.w - D.pad * 2
	Ui.text(panel, D.title, D.pad, D.titleY, inner, { font = "body", color = C.gold })
	Ui.text(panel, D.text, D.pad, D.textY, inner)
	if weakMin and weakMin > 0 then -- 쓰러진 벌칙(2026-10-18 — 전에는 화면 어디에도 보이지 않았다)
		Ui.text(panel, (string.gsub(D.weak, "{m}", tostring(weakMin))), D.pad, D.weakY, inner, { color = C.red })
	end
	Ui.text(panel, D.hint, D.pad, D.hintY, inner, { color = C.dim })
	local sent = false
	Ui.button(panel, D.yes, D.pad, D.buttonY, inner, function()
		if not sent then
			sent = true -- 한 번만 보낸다(서버가 마을로 옮기면 이 상자는 사라진다)
			onReturn()
			task.delay(1.5, function()
				sent = false -- 받아들여지지 않았으면(너무 일렀다) 다시 누를 수 있다
			end)
		end
	end, { main = true }).frame.Name = "Return"
	DeathBox.holder = holder
end

return DeathBox

end
MODULES['Client/lune/ui/equipWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 장비 창 — 13부위. 왼쪽에 무기와 방어구 넷(칸 옆에 「Lv.10 +2」), 오른쪽 위에 장신구 여덟(네 칸 x 두 줄). 오른쪽 아래에 능력치 표.
--  능력치 표(2026-10-14 — 사용자: "장비 탭에 지금 전투력, 방어력만 표기되는데 여기에 현재 스텟, 공격력 등 여러 수치가 다 출력되어야하고 크리티컬 확률, 크리티컬 데미지 이런것도 다 나와야합니다."):
--   공격력 · 전투력 · 최대 체력 · 다섯 능력치 · 방어 · 치명타(확률 · 피해) · 주는 피해 · 최종 피해 · 공격 속도 · 받는 피해 · 이동 속도 · 점프력. 줄과 값의 글은 shared/lune/ui/sheet.luau
--  부위를 누르면 그 장비의 상세가 창 옆의 작은 판에 뜬다(ui/itemDetail.luau) — 「해제」로 가방에 넣고, 대장장이 앞에서는 「강화」로 강화 창에 올린다.
--   사용자 2026-10-08: "장비 탭에서 각각의 장비를 선택하면 그 해당장비가 장비창 옆에 작은모달이 떠서 아이템 스펙이 나와야합니다."
--  같은 부위를 두 번 누르면 해제(가방에서 두 번 누르면 장착인 것과 짝). 화면 오른쪽 · 왼쪽의 옆 판(ui/windows.luau). 칸의 크기는 장비 그림의 크기(화면 틀의 배율)를 따른다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Items = require(lune.sim.items)
local ItemInfo = require(lune.ui.itemInfo)
local Sheet = require(lune.ui.sheet) -- 능력치 표의 칸 · 값의 글
local Layout = require(lune.ui.layout) -- 치수(자동 검사가 같은 값을 본다)
local WORDS = require(lune.data["ui.generated"]).words
local Stage = require(script.Parent.Parent.stage)
local Ui = require(script.Parent.ui)
local ItemCell = require(script.Parent.itemCell)
local ItemDetail = require(script.Parent.itemDetail)
local Windows = require(script.Parent.windows)

local C = Ui.COLOR
local D = Items.data
local DOUBLE = 0.4 -- 이 안에 같은 칸을 다시 누르면 두 번 누른 것(초)

local EquipWindow = {}
EquipWindow.TEXT_W = Layout.EQUIP.textW -- 부위 이름이나 "Lv.140 +17"이 들어가는 폭
EquipWindow.ACC_COLS = Layout.EQUIP.accCols

-- 속의 짜임: 왼쪽 = 칸 하나 + 글, 오른쪽 = 장신구 네 칸
local function metrics()
	local w, _, rx = Layout.equipBody(Stage.ratio)
	return ItemCell.size(), rx, w
end

function EquipWindow.size(): (number, number)
	local w, h = Layout.equipBody(Stage.ratio)
	return w, h
end

function EquipWindow.build(body: Frame, ctx, w: number, _h: number)
	local ui = ctx.ui
	local S, RX = metrics()
	local nameW = w - RX
	local selected: string? = nil
	local lastClick = { slot = "", t = 0 }
	local view = {}
	local rows = {}
	local left, right = 0, 0
	local function redraw()
		Windows.refresh(ctx.me())
	end
	for _, slot in D.SLOTS do
		local isAcc = slot.kind == "장신구"
		local x, y
		if isAcc then
			x, y = RX + (right % EquipWindow.ACC_COLS) * S, math.floor(right / EquipWindow.ACC_COLS) * S
			right += 1
		else
			x, y = 0, left * (S + 2)
			left += 1
		end
		local cell = ItemCell.new(body, x, y, function(it)
			local now = os.clock()
			local twice = it ~= nil and lastClick.slot == slot.id and now - lastClick.t < DOUBLE
			lastClick = { slot = if twice then "" else slot.id, t = now }
			if twice then
				ctx.send("Item", "unequip", slot.id) -- 두 번 누르기: 해제
				selected = nil
			elseif it then
				selected = slot.id
				ui.detail = "equip"
			else
				selected = nil
			end
			redraw()
		end, S)
		-- 무기 · 방어구는 칸 옆에 한 줄(장신구는 고르면 상세 판에 이름이 뜬다)
		local text = if isAcc then nil else Ui.text(body, "", x + S + 8, y + math.floor((S - 10) / 2), EquipWindow.TEXT_W, { color = C.dim })
		rows[slot.id] = { cell = cell, text = text, slot = slot }
	end
	local ny = 2 * S + 12
	Ui.line(body, RX, ny, nameW)
	-- 능력치 표: 칸마다 이름(왼쪽 · 흐리게 — 능력치는 주 노랑 · 부 민트 · 안 쓰는 것 흐림)과 값(오른쪽)
	local sheet = {}
	for _, cell in Sheet.cells(nameW) do
		local label = Ui.text(body, Sheet.name(cell.id), RX + cell.x, ny + cell.y, cell.w, { color = C.dim })
		local value = Ui.text(body, "", RX + cell.x, ny + cell.y, cell.w, { color = if cell.id == "power" then C.gold else C.text, align = "right" })
		sheet[cell.id] = { label = label, value = value }
	end
	local TONE = { main = C.gold, sub = C.accent, none = C.dim, hp = C.text }

	-- 고른 부위의 상세 판(창 옆)
	local function detail(bag, me)
		if ui.detail ~= "equip" then
			selected = nil -- 다른 창에서 골랐다
		end
		local it = if selected then bag.equip[selected] else nil
		if not it then
			selected = nil
			ItemDetail.hide("equip")
			return
		end
		local slotId = selected
		local buttons = { { text = WORDS.unequip, main = true, onClick = function()
			ctx.send("Item", "unequip", slotId)
			selected = nil
			redraw()
		end } }
		if ui.service == "forge" then
			table.insert(buttons, { text = WORDS.toForge, onClick = function()
				ctx.toForge(it.id)
			end })
		end
		ItemDetail.show("equip", {
			key = table.concat({ "equip", it.id, it.q, it.star, tostring(it.broken), me.level, ui.service or "-" }, "|"),
			info = ItemInfo.gear(it, me, nil, true),
			item = it,
			buttons = buttons,
			onClose = function()
				selected = nil
				redraw()
			end,
		})
	end

	function view.refresh()
		local bag, me = ctx.bag(), ctx.me()
		if not bag or not me then
			return
		end
		detail(bag, me)
		for id, row in rows do
			local it = bag.equip[id]
			row.cell:set(it, { selected = id == selected })
			if row.text then
				if it then
					row.text:set(if it.star > 0 then ("Lv.%d ★%d"):format(it.stage, it.star) else ("Lv.%d"):format(it.stage)) -- 별(2026-10-15 — 「+n」에서)
					row.text:color(ItemCell.color(it))
				else
					row.text:set(row.slot.name)
					row.text:color(C.dim)
				end
			end
		end
		local values = Sheet.values(me)
		for id, cell in sheet do
			cell.value:set(values[id] or "")
			local tone = Sheet.tone(me.class, id)
			if tone then
				cell.label:color(TONE[tone])
			end
		end
	end

	function view.destroy()
		ItemDetail.hide("equip")
		if ui.detail == "equip" then
			ui.detail = nil
		end
	end
	return view
end

return EquipWindow

end
MODULES['Client/lune/ui/forgeWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 대장장이 창 — 대장장이 무쇠뿔에게 말을 걸면 가방과 나란히 뜬다. 탭 둘: 「제작」 · 「강화」.
--  사용자 2026-10-15: "대장장이에 상점이 있는게 문제임 상점 없어야함 제작, 강화만 하는곳임" · "강화에 드래그앤 드랍으로 둘수가 없음" ·
--   "제작 리스트에서 아이템 아이콘쪽 누르면 아이템 옵션이 나와야함 인벤토리에서 처럼" · "강화를 인벤토리에 있는것만 강화할수있음 장착중인건 바로 강화할수가 없음" ·
--   "별을 옮겨올 장비는 뭐에요 … 이거 없애고" · "강화가 아무런 연출없이 그냥 띡띡띡띢 이렇게 되면 안됩니다." · "아이템 이름 위에 별이 표기되는겁니다."
--  제작: 단계 탭(Lv.1 · 10 · 20) · 장비마다 한 줄([그림] 이름 · [달돈] 삯 · 「제작」 / 아랫줄 재료 둘). 그림을 누르면 창 옆에 그 장비의 상세 판(옵션 · 만들면 나오는 성능의 확률).
--  강화: 위 = 올린 장비(칸 · 그 오른쪽에 별 그림 두 줄과 이름) / 「★5 → ★6」과 성공 % · 오르는 옵션(「공격력 73 → 76」) · 실패하면 · [달가루] 드는 것 · 「파괴 방지」 · 「강화」 · 결과.
--        아래 = 고를 장비(스크롤): 첫 줄은 장착 중인 것(「장착」 표시 — 장비 창을 따로 열지 않아도 된다), 그 아래는 가방의 장비. 칸을 누르거나, 가방 창의 장비를 끌어다 이 창에 놓으면 올라간다.
--        부서진 장비를 올리면 「되살리기」 — 같은 장비를 하나 더 고른다(칸을 누른다).
--  강화 연출: 「강화」를 누르면 망치가 세 번 내려치고(칸이 번쩍이며 흔들리고 불티가 튄다) 결과가 뜬다 —
--   성공 = 금빛 테두리가 퍼지고 「강화 성공」 · 실패 = 「강화 실패」 · 떨어짐 = 붉게 「별이 하나 떨어졌다」 · 파괴 = 붉게 크게 흔들리며 「장비가 파괴되었다」.
--   그동안 단추는 잠기고, 올린 장비의 별은 결과가 뜰 때 바뀐다(서버는 바로 정한다 — 화면만 기다린다). 칸을 누르면 건너뛴다.
--  확률과 값은 shared/lune/sim/items.luau의 enhanceInfo, 오르는 옵션은 Items.options. 결과는 서버가 정한다(Item → ItemDone). 화면 왼쪽의 옆 판(ui/windows.luau — 가방이 오른쪽).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local lune = ReplicatedStorage.shared.lune
local Items = require(lune.sim.items)
local Bag = require(lune.sim.bag)
local ItemInfo = require(lune.ui.itemInfo)
local Format = require(lune.ui.format)
local Layout = require(lune.ui.layout)
local Ui = require(script.Parent.ui)
local ItemCell = require(script.Parent.itemCell)
local ItemDetail = require(script.Parent.itemDetail)

local C = Ui.COLOR
local D = Items.data
local W = 300
local CRAFT = Layout.CRAFT
local IC = Layout.SHOP.iconS -- 제작 줄의 그림 칸
local TX = IC + 6
local LINE = 16
local COST = 20

local ForgeWindow = {}
ForgeWindow.W = W
ForgeWindow.TABS = { { "craft", "제작" }, { "enhance", "강화" } }
ForgeWindow.COST, ForgeWindow.LINE = COST, LINE
-- 결과의 글과 색(연출이 끝난 뒤 결과 줄에 남는다)
ForgeWindow.RESULT = {
	ok = { "강화 성공 — 별이 하나 켜졌다", C.gold },
	fail = { "강화 실패 — 별은 그대로다", C.dim },
	drop = { "강화 실패 — 별이 하나 떨어졌다", C.red },
	boom = { "장비가 파괴되었다 — 흔적이 남았다", C.red },
	restore = { "되살렸다 — 12성", C.accent }, -- 부서진 장비를 같은 장비로 되살렸다(연출 없이 바로)
}
ForgeWindow.BIG = { ok = { "강화 성공", C.gold }, fail = { "강화 실패", C.text }, drop = { "강화 실패", C.red }, boom = { "파괴", C.red } } -- 칸 위에 크게
ForgeWindow.STRIKES = { 0.05, 0.4, 0.75 } -- 망치가 내려치는 때(초)
ForgeWindow.REVEAL = 1.05 -- 결과를 보이는 때(서버의 답이 늦으면 그때까지 기다린다)
ForgeWindow.END = 1.9 -- 연출이 끝나는 때
ForgeWindow.CRAFT_ROW, ForgeWindow.CRAFT_MATS = CRAFT.row, 2
ForgeWindow.CRAFT_MAKE_W, ForgeWindow.CRAFT_FEE_W = CRAFT.makeW, CRAFT.feeW

-- 몸의 크기(제작 · 강화가 같은 크기 — 탭을 바꿔도 창이 흔들리지 않는다)
-- 창의 제목 = 연 대장장이(「대장장이 담금」 — boot.luau가 연 때마다 적는다. 없으면 공방의 이름 「대장장이 무쇠뿔」). 2026-10-16: 은달 항구에도 대장장이가 생겼다
ForgeWindow.opener = nil :: string?
function ForgeWindow.title(_arg: any): string?
	return ForgeWindow.opener
end

function ForgeWindow.size(): (number, number)
	local S = ItemCell.size()
	return W, 24 + S + 4 + 3 * LINE + 4 + COST + 6 + Ui.M.button + 4 + LINE + 8 + 14 + 2 * S
end

local function pct(v: number): string
	return if v == math.floor(v) then ("%d%%"):format(v) else ("%.1f%%"):format(v)
end
ForgeWindow.pct = pct

-- 오르는 옵션의 글: 「공격력 73 → 76 (+3)」 · 방어구는 「올스탯 9 → 10 · 방어력 16 → 17」. it = 지금 장비
function ForgeWindow.gainText(it): string
	local now = Items.options(it).total
	local nextIt = table.clone(it)
	nextIt.star = it.star + 1
	local after = Items.options(nextIt).total
	local W2 = D.WORDS
	local parts = {}
	for _, k in { "atk", "stat", "def" } do
		if now[k] ~= nil then
			local d = after[k] - now[k]
			table.insert(parts, ("%s %s → %s%s"):format(W2[k], Format.short(now[k]), Format.short(after[k]), if d > 0 and k == "atk" then (" (+%s)"):format(Format.short(d)) else ""))
		end
	end
	return table.concat(parts, " · ")
end

-- 강화 칸에 적는 줄들(화면 없이 셈할 수 있게 따로 뺐다): { 별 · 확률(오른쪽), 오르는 옵션, 실패하면, 드는 달가루 }
function ForgeWindow.lines(it, info, bag): { string }
	if it.broken then
		return { "부서진 장비", "", "같은 장비를 하나 더 골라 「되살리기」(12성으로)", "" }
	elseif not info.can then
		return { ("★%d — 가장 높은 별이다"):format(it.star), "", "", "" }
	end
	local odds = if info.sure then "반드시 성공" else ("성공 %s"):format(pct(info.ok))
	local note = if info.first then "첫 강화 — 달가루 없이 반드시 붙는다"
		elseif info.sure then "두 번 떨어졌다 — 이번은 반드시 붙는다"
		elseif info.drops then ("실패하면 한 단계 떨어진다%s"):format(if info.boom > 0 then (" · 파괴 %s"):format(pct(info.boom)) else "")
		else "실패해도 별은 그대로다"
	return {
		("★%d → ★%d  %s"):format(it.star, it.star + 1, odds),
		ForgeWindow.gainText(it),
		note,
		("달가루 %s (가진 것 %s)"):format(Format.short(info.dust), Format.short(bag.dust)),
	}
end

-- 고를 장비의 목록: 장착 중인 것(부위 차례) · 그 다음 가방의 장비(칸 차례). { { it, worn } … }
function ForgeWindow.choices(bag)
	local out = {}
	for _, s in D.SLOTS do
		local it = bag.equip[s.id]
		if it then
			table.insert(out, { it = it, worn = true })
		end
	end
	for i = 1, #bag.gear do
		local it = bag.gear[i]
		if it then
			table.insert(out, { it = it, worn = false })
		end
	end
	return out
end

-- 가방(장착하지 않은 것)에 있는가 — 되살리기의 재료는 가방의 것만 받는다(서버의 Bag.restore와 같다 — 2026-10-18 검토)
local function inGear(bag, id: number?): boolean
	if not bag or not id then
		return false
	end
	for _, it in bag.gear do
		if it and it.id == id then
			return true
		end
	end
	return false
end

local function findIn(bag, id: number?)
	if not bag or not id then
		return nil
	end
	for _, it in bag.equip do
		if it.id == id then
			return it
		end
	end
	for _, it in bag.gear do
		if it and it.id == id then
			return it
		end
	end
	return nil
end
ForgeWindow.find = findIn

-- 제작 줄의 재료들 { { icon, text 「청동 광석 3/5」, ok } … } 와 다 모였는가
function ForgeWindow.craftParts(recipe, bag)
	local parts, enough = {}, true
	for _, need in recipe.needs do
		local have = Bag.countIn(bag, need.item)
		local g = Items.goods(need.item)
		table.insert(parts, { icon = g.icon, text = ("%s %d/%d"):format(g.name, math.min(have, 9999), need.n), ok = have >= need.n })
		enough = enough and have >= need.n
	end
	return parts, enough
end

-- 제작 줄의 상세 판: 보통 성능의 것으로 옵션을 보이고, 만들면 나오는 성능의 확률을 앞에 적는다
function ForgeWindow.craftInfo(recipe, me, bag)
	local item = Items.make(recipe.slot, recipe.stage, D.NORMAL, me.class)
	local info = ItemInfo.gear(item, { level = me.level, class = me.class, spec = me.spec }, bag and bag.equip[recipe.slot] or nil, false)
	local total = 0
	for _, x in D.CRAFTQ do
		total += x.pct
	end
	local odds = {}
	for _, x in D.CRAFTQ do
		table.insert(odds, ("%s %d%%"):format(D.QUALITY[x.q].name, math.floor(x.pct / total * 100 + 0.5)))
	end
	-- 만들기 전의 장비라 「분해하면 · 팔면」은 빼고 「만들면 성능: 보통 57% · 좋은 31% · 빼어난 11%」를 맨 앞에
	local notes = { { "만들면 성능: " .. table.concat(odds, " · "), "accent" } }
	for _, n in info.notes do
		if n[2] ~= "dim" then
			table.insert(notes, n)
		end
	end
	info.notes = notes
	return info, item
end

function ForgeWindow.build(body: Frame, ctx, w: number, h: number, arg: any)
	local ui = ctx.ui
	local S = ItemCell.size()
	local view = {}
	local panel = body.Parent :: GuiObject
	local tab = if arg == "craft" or arg == "enhance" then arg else "enhance"
	local guard = false
	local anim = nil -- 강화 연출 { t, seq(누를 때의 결과 번호), snap(누르기 전의 장비), id, revealed, result }
	local bound = false
	local craftTab = 1

	-- ---- 위: 탭 둘 · 지갑 ----
	local tabs = {}
	local tx = 0
	for i, t in ForgeWindow.TABS do
		tabs[i] = Ui.tab(body, t[2], tx, 2, function()
			if tab ~= t[1] then
				tab = t[1]
				ItemDetail.hide("forge")
				view.refresh()
			end
		end)
		tabs[i].frame.Name = "Tab_" .. t[1]
		tx += tabs[i].width + 16
	end
	local dustIcon = Ui.smallIcon(body, "dust", w - 72, -2)
	local dustText = Ui.text(body, "", w - 52, 2, 52, { align = "right", color = C.text })
	local coinIcon = Ui.smallIcon(body, "coin", w - 156, -2)
	local coinText = Ui.text(body, "", w - 136, 2, 60, { align = "right", color = C.gold })

	-- ---- 제작 ----
	local craftRoot = Ui.group(body, 0, 0, w, h, "Craft")
	local stages = {}
	for _, r in D.RECIPES do
		if not table.find(stages, r.stage) then
			table.insert(stages, r.stage)
		end
	end
	table.sort(stages)
	local me0 = ctx.me()
	for i, st in stages do
		if me0 and me0.level >= st then
			craftTab = i
		end
	end
	local stageTabs = {}
	local sx = 0
	for i, st in stages do
		stageTabs[i] = Ui.tab(craftRoot, "Lv." .. st, sx, 24, function()
			if craftTab ~= i then
				craftTab = i
				ui.craftResult = nil
				ItemDetail.hide("forge")
				view.refresh()
			end
		end)
		sx += stageTabs[i].width + 14
	end
	Ui.text(craftRoot, CRAFT.note, sx, 24, w - sx, { align = "right", color = C.dim })
	local perStage = 0
	for _, r in D.RECIPES do
		if r.stage == stages[1] then
			perStage += 1
		end
	end
	local rows = {}
	local bw, fw = CRAFT.makeW, CRAFT.feeW
	for i = 1, perStage do
		local y = 24 + CRAFT.tabH + (i - 1) * CRAFT.row
		local row = {}
		-- 윗줄: [만들 장비의 그림 — 누르면 상세 판] 이름 · [달돈] 삯 · 「제작」
		row.cell = Ui.slot(craftRoot, 0, y, IC)
		row.cell.frame.Name = "Icon"
		row.icon = Ui.smallIcon(row.cell.frame, "coin", 3, 3)
		Ui.hit(row.cell.frame).Activated:Connect(function()
			local me, bag = ctx.me(), ctx.bag()
			if row.recipe and me then
				local info, item = ForgeWindow.craftInfo(row.recipe, me, bag)
				ItemDetail.show("forge", { key = "craft:" .. row.recipe.id, info = info, item = item, buttons = {} })
			end
		end)
		row.name = Ui.text(craftRoot, "", TX, y + 5, w - TX - bw - 8 - fw - 22, { font = "body" })
		row.coin = Ui.smallIcon(craftRoot, "coin", w - bw - 8 - fw - 19, y + 3)
		row.fee = Ui.text(craftRoot, "", w - bw - 8 - fw, y + 7, fw, { align = "right", color = C.gold })
		row.make = Ui.button(craftRoot, "제작", w - bw, y + 1, bw, function()
			-- 빨리 두 번 누르면 두 번 만들어 재료를 두 번 썼다(2026-10-18 검토) — 0.8초 안의 다시 누름은 받지 않는다
			if row.recipe and os.clock() - (ForgeWindow.craftAt or -9) > 0.8 then
				ForgeWindow.craftAt = os.clock()
				ctx.send("Item", "craft", row.recipe.id)
			end
		end, { h = CRAFT.makeH })
		row.mats = {}
		for k = 1, ForgeWindow.CRAFT_MATS do
			local mx = TX + (k - 1) * CRAFT.matW
			row.mats[k] = { icon = Ui.smallIcon(craftRoot, "coin", mx, y + 25), text = Ui.text(craftRoot, "", mx + 21, y + 29, CRAFT.matW - 25, { color = C.dim }) }
		end
		row.lock = Ui.text(craftRoot, "", TX, y + 29, w - TX, { color = C.dim })
		rows[i] = row
	end
	local craftY = 24 + CRAFT.tabH + perStage * CRAFT.row + 4
	local craftResult = Ui.text(craftRoot, "", 0, craftY, w, { color = C.accent })
	Ui.text(craftRoot, CRAFT.hint, 0, craftY + 18, w, { color = C.dim })

	-- ---- 강화 ----
	local forgeRoot = Ui.group(body, 0, 0, w, h, "Enhance")
	local top = 24
	local target = ItemCell.new(forgeRoot, 0, top, function()
		if anim and not anim.revealed then
			anim.t = math.max(anim.t, ForgeWindow.REVEAL) -- 연출을 건너뛴다(결과가 왔으면 바로 보인다)
		elseif not anim then
			ui.forgeTarget, ui.forgeMat, ui.forgeResult = nil, nil, nil
			view.refresh()
		end
	end, S)
	target.frame.Name = "Target"
	local starsUi = Ui.stars(forgeRoot, S + 8, top + 1, w - S - 8)
	local name = Ui.text(forgeRoot, "", S + 8, top + 26, w - S - 8, { font = "body" })
	local y = top + S + 4
	local line1 = Ui.text(forgeRoot, "", 0, y, w, { font = "body", color = C.gold })
	local line2 = Ui.text(forgeRoot, "", 0, y + LINE + 2, w, { color = C.accent })
	local line3 = Ui.text(forgeRoot, "", 0, y + 2 * LINE + 2, w, { color = C.dim })
	y += 3 * LINE + 4
	local costIcon = Ui.smallIcon(forgeRoot, "dust", 0, y)
	local costText = Ui.text(forgeRoot, "", 21, y + 4, w - 21)
	y += COST + 6
	local shield = Ui.button(forgeRoot, "", 0, y, 120, function()
		guard = not guard
		view.refresh()
	end)
	shield.frame.Name = "Guard"
	local goW = 96
	local go = Ui.button(forgeRoot, "강화", w - goW, y, goW, function()
		local it = findIn(ctx.bag(), ui.forgeTarget)
		if not it or anim then
			return
		end
		if it.broken then
			local mat = findIn(ctx.bag(), ui.forgeMat)
			if mat then
				ctx.send("Item", "restore", it.id, mat.id)
				ui.forgeMat = nil
			end
			return
		end
		anim = { t = 0, seq = ui.forgeSeq or 0, snap = table.clone(it), id = it.id, revealed = false }
		ui.forgeResult, ui.forgeWhy = nil, nil -- 지난 「안 된 까닭」을 지운다(2026-10-18 검토)
		ctx.send("Item", "enhance", it.id, guard)
		view.startAnim()
	end, { main = true })
	go.frame.Name = "Go"
	y += Ui.M.button + 4
	local result = Ui.text(forgeRoot, "", 0, y, w)
	y += LINE + 8
	Ui.line(forgeRoot, 0, y - 4, w)
	local pickLabel = Ui.text(forgeRoot, "장착 중 · 가방의 장비 — 누르거나 끌어다 놓아 올린다", 0, y, w, { color = C.dim })
	y += 14
	local cols = math.max(1, math.floor(w / S))
	local listH = 2 * S
	local list = Ui.scroll(forgeRoot, 0, y, w + 6, listH, listH, 3)
	list.Name = "Choices"
	local picks = {}
	local function makePick(i: number)
		local col, row = (i - 1) % cols, math.floor((i - 1) / cols)
		local p = {}
		p.cell = ItemCell.new(list, col * S, row * S, function(it)
			if not it or anim then
				return
			end
			local cur = findIn(ctx.bag(), ui.forgeTarget)
			if cur and cur.broken and cur.id ~= it.id and Items.same(cur, it) and not it.broken and inGear(ctx.bag(), it.id) then
				ui.forgeMat = it.id -- 부서진 것을 되살릴 같은 장비(가방의 것만 — 장착한 것은 서버가 받지 않는다)
			else
				ui.forgeTarget, ui.forgeMat, ui.forgeResult = it.id, nil, nil
			end
			ui.forgeWhy = nil -- 다른 것을 골랐다: 지난 「안 된 까닭」을 지운다(2026-10-18 검토)
			view.refresh()
		end, S)
		p.tag = Ui.text(p.cell.frame, "장착", 3, 2, S - 6, { outline = true, color = C.accent, z = 7 })
		picks[i] = p
		return p
	end

	-- 강화 연출의 그림들(칸 위에 겹친다)
	local fx = Ui.group(forgeRoot, 0, top, S, S, "Fx")
	fx.ZIndex = 20
	local flash = Ui.box(fx, 0, 0, S, S, C.text, 1)
	flash.ZIndex = 21
	local ring = Ui.box(fx, 0, 0, S, S, C.gold, 1)
	ring.ZIndex = 20
	-- 망치: 자루가 위 · 머리가 아래(머리로 칸을 내려친다)
	local hammer = Ui.group(fx, 0, 0, 22, 22, "Hammer")
	hammer.ZIndex = 23
	local handle = Ui.box(hammer, 9, 0, 5, 13, Color3.fromRGB(110, 78, 52))
	local head = Ui.box(hammer, 0, 13, 22, 9, C.ink)
	Ui.box(head, 1, 1, 20, 7, Color3.fromRGB(150, 160, 176))
	head.ZIndex, handle.ZIndex = 24, 24
	hammer.Visible = false
	local sparks = {}
	for i = 1, 8 do
		local sp = Ui.box(fx, 0, 0, 3, 3, if i % 2 == 0 then C.gold else C.text)
		sp.ZIndex = 22
		sp.Visible = false
		sparks[i] = sp
	end
	local BIGX, BIGW = -24, S + 48 -- 큰 글은 칸의 가운데에(창 가운데면 이름 · 별과 겹친다)
	local big = Ui.text(forgeRoot, "", BIGX, top + math.floor(S / 2) - 8, BIGW, { font = "body", align = "center", outline = true, z = 25 })
	big:show(false)

	-- 연출 한 장(dt만큼 흐른다). 다 끝나면 false
	function view.step(dt: number): boolean
		if not anim then
			return false
		end
		anim.t += dt
		local t = anim.t
		-- 망치 세 번: 내려치기 전에 들고(위로), 치는 순간 칸이 번쩍 · 흔들림 · 불티
		local strike, since = 0, 99
		for i, at in ForgeWindow.STRIKES do
			if t >= at then
				strike, since = i, t - at
			end
		end
		local beforeReveal = not anim.revealed
		hammer.Visible = beforeReveal and t < ForgeWindow.REVEAL
		if hammer.Visible then
			local nextAt = ForgeWindow.STRIKES[strike + 1]
			local lift = if since < 0.1 then 0 elseif nextAt then math.min(1, (t - ForgeWindow.STRIKES[strike] - 0.1) / math.max(0.05, nextAt - ForgeWindow.STRIKES[strike] - 0.15)) else 1
			hammer.Position = UDim2.fromOffset(math.floor(S / 2) - 11, math.floor(-6 - 14 * lift)) -- 치는 순간 머리가 칸의 윗쪽에 닿는다
		end
		flash.BackgroundTransparency = if beforeReveal and since < 0.12 then 0.35 + since * 5 else 1
		local shake = if beforeReveal and since < 0.1 then (if math.floor(t * 60) % 2 == 0 then 2 else -2) else 0
		target.frame.Position = UDim2.fromOffset(shake, top)
		for i, sp in sparks do
			local life = since
			sp.Visible = beforeReveal and life < 0.3 and strike > 0
			if sp.Visible then
				local a = (i / #sparks) * math.pi * 2 + strike
				local r = 6 + life * 70
				sp.Position = UDim2.fromOffset(math.floor(S / 2 + math.cos(a) * r), math.floor(S / 2 + math.sin(a) * r - life * 20))
			end
		end
		-- 결과: 서버의 답이 왔고 때가 됐으면 보인다(답이 오지 않으면 4초 뒤 그친다)
		local arrived = (ui.forgeSeq or 0) > anim.seq
		if beforeReveal and t >= ForgeWindow.REVEAL and arrived then
			anim.revealed = true
			anim.result = ui.forgeResult
			anim.t0 = t
			view.refresh()
		elseif beforeReveal and t >= 4 then
			anim = nil
			view.stopAnim()
			view.refresh()
			return false
		end
		if anim.revealed then
			local r = anim.result
			local k = t - anim.t0
			local show = r and ForgeWindow.BIG[r]
			big:show(show ~= nil)
			if show then
				big:set(show[1])
				big:color(show[2])
				big:move(BIGX, top + math.floor(S / 2) - 8 - math.floor(math.min(k, 0.3) * 20))
			end
			-- 성공: 금빛 테두리가 퍼진다 · 떨어짐 · 파괴: 붉게 번쩍 · 파괴는 크게 흔들린다
			if r == "ok" then
				local g = math.min(1, k / 0.6)
				ring.Size = UDim2.fromOffset(math.floor(S * (1 + g * 0.5)), math.floor(S * (1 + g * 0.5)))
				ring.Position = UDim2.fromOffset(math.floor(-S * g * 0.25), math.floor(-S * g * 0.25))
				ring.BackgroundTransparency = 0.4 + 0.6 * g
				ring.BackgroundColor3 = C.gold
			elseif r == "drop" or r == "boom" then
				flash.BackgroundColor3 = C.red
				flash.BackgroundTransparency = math.min(1, 0.3 + k * 1.5)
				if r == "boom" and k < 0.4 then
					target.frame.Position = UDim2.fromOffset(if math.floor(k * 50) % 2 == 0 then 4 else -4, top)
				end
			end
			if t >= ForgeWindow.END then
				anim = nil
				view.stopAnim()
				view.refresh()
				return false
			end
		end
		return true
	end
	function view.startAnim()
		view.refresh()
		if bound then
			return
		end
		local ok = pcall(function()
			RunService:BindToRenderStep("LuneForge", Enum.RenderPriority.Last.Value, function(dt)
				view.step(dt)
			end)
		end)
		bound = ok
	end
	function view.stopAnim()
		if bound then
			pcall(function()
				RunService:UnbindFromRenderStep("LuneForge")
			end)
			bound = false
		end
		hammer.Visible = false
		flash.BackgroundTransparency = 1
		flash.BackgroundColor3 = C.text
		ring.BackgroundTransparency = 1
		ring.Size = UDim2.fromOffset(S, S)
		ring.Position = UDim2.fromOffset(0, 0)
		big:show(false)
		target.frame.Position = UDim2.fromOffset(0, top)
		for _, sp in sparks do
			sp.Visible = false
		end
	end
	function view.animating(): boolean
		return anim ~= nil
	end

	-- 가방 창의 장비를 끌어다 이 창에 놓으면 강화할 장비로 올린다(가방 창이 묻는다 — ui/bagWindow.luau)
	ui.forgeDrop = function(at: Vector2): boolean
		return ItemCell.over(panel, at)
	end

	function view.refresh()
		local bag, me = ctx.bag(), ctx.me()
		if not bag or not me then
			return
		end
		if ui.forgeTab then -- 다른 창에서 장비를 올렸다(가방 · 장비 창의 「강화」 · 끌어다 놓기) — 강화 탭으로
			tab, ui.forgeTab = ui.forgeTab, nil
			ItemDetail.hide("forge")
		end
		for i, t in tabs do
			t:setOn(ForgeWindow.TABS[i][1] == tab)
		end
		coinText:set(Format.short(me.money))
		dustText:set(Format.short(bag.dust))
		craftRoot.Visible = tab == "craft"
		forgeRoot.Visible = tab == "enhance"
		-- 제작
		for i, t in stageTabs do
			t:setOn(i == craftTab)
		end
		local k = 0
		for _, r in D.RECIPES do
			if r.stage == stages[craftTab] then
				k += 1
				local row = rows[k]
				if row then
					row.recipe = r
					local open = me.level >= r.from
					local item = Items.make(r.slot, r.stage, D.NORMAL, me.class)
					Ui.setWorldIcon(row.icon, ItemCell.icon(item))
					row.name:set(Items.name(item))
					row.name:color(if open then C.text else C.dim)
					local parts, enough = ForgeWindow.craftParts(r, bag)
					for j, m in row.mats do
						local q = if open then parts[j] else nil
						Ui.setWorldIcon(m.icon, if q then q.icon else nil)
						m.text:set(if q then q.text else "")
						m.text:color(if q and q.ok then C.green else C.dim)
					end
					row.lock:set(if open then "" else ("Lv.%d부터 만든다"):format(r.from))
					row.fee:set(if open then Format.short(r.money) else "")
					row.coin.Visible = open
					row.make.frame.Visible = open
					row.make:setEnabled(enough and me.money >= r.money)
				end
			end
		end
		local made = ui.craftResult
		craftResult:set(if made then ("%s — 만들었다"):format(ItemCell.label(made)) else "")
		if made then
			craftResult:color(ItemCell.color(made))
		end
		-- 강화
		local open = me.level >= D.OPEN.forge
		local list0 = ForgeWindow.choices(bag)
		for i = #picks + 1, math.max(#list0, cols * 2) do
			makePick(i)
		end
		local rowsN = math.max(2, math.ceil(#list0 / cols))
		list.CanvasSize = UDim2.fromOffset(0, rowsN * S)
		list.ScrollBarThickness = if rowsN > 2 then 3 else 0
		for i, p in picks do
			local c = list0[i]
			p.cell.frame.Visible = i <= rowsN * cols
			p.cell:set(if c then c.it else nil, { selected = c ~= nil and (c.it.id == ui.forgeTarget or c.it.id == ui.forgeMat) })
			p.tag:show(c ~= nil and c.worn)
		end
		local it = findIn(bag, ui.forgeTarget)
		if not it then
			ui.forgeTarget = nil
		end
		-- 연출 중에는 누르기 전의 장비를 보인다(별은 결과가 뜰 때 바뀐다)
		local shown = if anim and not anim.revealed and it and it.id == anim.id then anim.snap else it
		target:set(shown)
		if not open then
			starsUi:set(0, 0)
			name:set(("강화는 Lv.%d부터"):format(D.OPEN.forge))
			name:color(C.dim)
			line1:set("")
			line2:set("")
			line3:set("")
			costText:set("")
			costIcon.Visible = false
			go:setEnabled(false)
			shield.frame.Visible = false
			result:set("")
			return
		end
		if not shown then
			starsUi:set(0, 0)
			name:set("강화할 장비를 아래에서 고른다")
			name:color(C.dim)
			line1:set("")
			line2:set("")
			line3:set("")
			costText:set("")
			costIcon.Visible = false
			go:setEnabled(false)
			go:setText("강화")
			shield.frame.Visible = false
			result:set("")
			return
		end
		starsUi:set(shown.star, D.ENHANCE.max)
		name:set(ItemCell.label(shown))
		name:color(ItemCell.color(shown))
		local info = Items.enhanceInfo(shown, guard, Items.firstFree(me.forged, me.level, shown)) -- 첫 강화(별이 없는 제 레벨 + 10까지의 장비의 첫 별)는 공짜로 반드시 붙는다 — 서버와 같은 셈
		local texts = ForgeWindow.lines(shown, info, bag)
		line1:set(texts[1])
		line2:set(texts[2])
		line3:set(texts[3])
		costText:set(texts[4])
		costIcon.Visible = texts[4] ~= ""
		if shown.broken then
			local mat = findIn(bag, ui.forgeMat)
			go:setText("되살리기")
			go:setEnabled(mat ~= nil and not anim)
			shield.frame.Visible = false
		else
			go:setText("강화")
			go:setEnabled(info.can and bag.dust >= info.dust and not anim)
			shield.frame.Visible = info.can and info.guard == true
			shield:setText(if guard then "파괴 방지 켬" else "파괴 방지 끔")
			shield:setMain(guard)
		end
		local last = if anim and not anim.revealed then nil else ui.forgeResult
		local show = last and ForgeWindow.RESULT[last]
		result:set(if show then show[1] elseif ui.forgeWhy then ui.forgeWhy else "")
		result:color(if show then show[2] else C.red)
	end

	function view.destroy()
		ui.forgeDrop = nil
		view.stopAnim()
		ItemDetail.hide("forge")
		ui.craftResult = nil
	end
	view.refresh()
	return view
end

-- 장비를 올린다(가방 · 장비 창의 상세 판 「강화」 · 끌어다 놓기): 강화할 장비로. 부서진 것을 올려 둔 채 같은 장비를 올리면 되살릴 재료로
function ForgeWindow.put(ui, id: number, bag: any)
	local cur = findIn(bag, ui.forgeTarget)
	local it = findIn(bag, id)
	if cur and it and cur.broken and cur.id ~= it.id and Items.same(cur, it) and not it.broken and inGear(bag, id) then
		ui.forgeMat = id
	else
		ui.forgeTarget, ui.forgeMat = id, nil
	end
	ui.forgeResult, ui.forgeWhy = nil, nil
	ui.forgeTab = "enhance"
end

return ForgeWindow

end
MODULES['Client/lune/ui/hallWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 명예의 전당 창 — 순위판 셋(후원 · 전투력 · 레벨)의 위 열 줄. 명예의 전당 건물 안의 비석 앞에서 ↑를 누르면 그 비석의 판이 뜬다(탭으로 다른 판을 본다).
--  사용자 2026-10-10: "대형 마을마다 명예의 전당 건물 을 만들어서 최대 로벅스 결제자, 전투력 랭킹, 레벨 랭킹 이렇게 캐릭터 닉네임 보여주는 명예의 전당을 만듭니다."
--  순위는 서버가 준다(ctx.rank() — 서버는 1분마다 한 번 읽어 둔 것을 준다). 이름은 캐릭터의 이름(만들 때 지은 것).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local CLASSES = require(lune.data["classes.generated"])
local Rank = require(lune.sim.rank)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local ROW = 20 -- 한 줄의 높이
local TOP = 30 -- 탭 아래 첫 줄의 자리
-- 판의 차례와 머리글(값의 이름)
local TABS = { { id = "robux", name = "후원", value = "쓴 로벅스" }, { id = "power", name = "전투력", value = "전투력" }, { id = "level", name = "레벨", value = "레벨" } }

local HallWindow = {}

function HallWindow.size(): (number, number)
	return 300, TOP + 16 + Rank.TOP * ROW + 8
end

function HallWindow.build(body: Frame, ctx, w: number, _h: number, arg: any)
	local board = if typeof(arg) == "string" then arg else "level"
	local boards = nil -- 서버가 준 판들(아직이면 nil)
	local failed = false -- 서버가 답하지 않았다(너무 자주 물음 · 잠깐의 오류) — 「기록이 없다」와 가른다(2026-10-18 검토)
	local alive = true
	local tabs = {}
	local x = 0
	for _, t in TABS do
		local tab
		tab = Ui.tab(body, t.name, x, 2, function()
			board = t.id
			HallWindow.redraw()
		end)
		tabs[t.id] = tab
		x += tab.width + 18
	end
	Ui.line(body, 0, 22, w)
	local headName = Ui.text(body, "이름", 34, TOP, 120, { color = C.dim })
	local headValue = Ui.text(body, "", 0, TOP, w, { color = C.dim, align = "right" })
	local note = Ui.text(body, "불러오는 중 …", 0, TOP + 16 + 40, w, { color = C.dim, align = "center" })
	local rows = {}
	for i = 1, Rank.TOP do
		local y = TOP + 16 + (i - 1) * ROW
		rows[i] = {
			no = Ui.text(body, tostring(i), 0, y, 26, { align = "right", color = if i <= 3 then C.gold else C.dim }),
			name = Ui.text(body, "", 34, y, 96, { font = "small" }),
			class = Ui.text(body, "", 134, y, 82, { color = C.dim }),
			value = Ui.text(body, "", 0, y, w, { align = "right", color = C.accent }),
		}
	end

	function HallWindow.redraw()
		if not alive then
			return
		end
		for _, t in TABS do
			tabs[t.id]:setOn(t.id == board)
			if t.id == board then
				headValue:set(t.value)
			end
		end
		local list = if boards then boards[board] or {} else nil
		note:show(list == nil or #list == 0)
		note:set(if list ~= nil then "아직 기록이 없습니다" elseif failed then "불러오지 못했습니다 · 다시 불러오는 중" else "불러오는 중 …")
		headName:show(list ~= nil and #list > 0)
		headValue:show(list ~= nil and #list > 0)
		for i, row in rows do
			local it = if list then list[i] else nil
			row.no:show(it ~= nil)
			row.name:set(if it then it.name else "")
			row.class:set(if it and it.class and CLASSES.classes[it.class] then CLASSES.classes[it.class].name else "")
			row.value:set(if it then it.value else "")
		end
	end
	HallWindow.redraw()
	task.spawn(function()
		-- 답이 없으면(빠르기의 한도 · 잠깐의 오류) 「기록이 없다」로 보이지 않게 몇 번 더 묻는다
		for _ = 1, 4 do
			local got = ctx.rank()
			if not alive then
				return
			end
			if got then
				boards, failed = got, false
				HallWindow.redraw()
				return
			end
			failed = true
			HallWindow.redraw()
			task.wait(1.5)
		end
	end)

	return {
		destroy = function()
			alive = false
		end,
	}
end

return HallWindow

end
MODULES['Client/lune/ui/hpBar'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 체력 띠의 효과를 띠(Ui.bar)에 붙인다 — 몬스터 머리 위의 띠 · 보스의 넓은 바(플레이어의 체력 바는 hud.luau가 같은 셈으로 그린다).
--  사용자 2026-10-13: "몬스터 체력바도  유저 체력바처럼 고도화 되어야합니다."
--  셈은 shared/lune/ui/hpFx.luau(플레이어의 것과 같다 · 수는 공방의 UILAYOUT.vitals.fx):
--   닳을 때 = 빨간 띠는 바로 줄고, 닳은 만큼이 밝은 색으로 잠깐 남았다가 따라 줄어든다 + 띠가 희게 번쩍인다
--   찰 때   = 찬 만큼이 풀빛으로 먼저 보이고 빨간 띠가 차오른다 + 풀빛으로 번쩍인다
--  몬스터에게는 「-23」 같은 글을 띄우지 않는다(피해 숫자가 이미 몬스터 위에 뜬다).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local HpFx = require(lune.ui.hpFx)
local Ui = require(script.Parent.ui)

local HpBar = {}
HpBar.__index = HpBar

local function hex(h: string): Color3
	return Color3.fromRGB(tonumber(h:sub(2, 3), 16) :: number, tonumber(h:sub(4, 5), 16) :: number, tonumber(h:sub(6, 7), 16) :: number)
end

-- bar = Ui.bar가 만든 띠 · w · h = 그 띠의 크기(테두리까지)
function HpBar.attach(bar, w: number, h: number)
	local F = HpFx.F
	local self = setmetatable({ bar = bar, w = w - 2, h = h - 2, st = HpFx.new() }, HpBar)
	self.lag = Ui.box(bar.frame, 1, 1, 0, self.h, hex(F.lagColor))
	self.lag.Name = "Lag"
	self.gain = Ui.box(bar.frame, 1, 1, 0, self.h, hex(F.gainColor))
	self.gain.Name = "Gain"
	bar.fill.ZIndex = 2 -- 빨간 띠는 그 둘 위에
	self.lag.ZIndex, self.gain.ZIndex = 1, 1
	self.flash = Ui.box(bar.frame, 1, 1, self.w, self.h, Color3.new(1, 1, 1))
	self.flash.Name = "Flash"
	self.flash.ZIndex = 3
	self.flash.BackgroundTransparency = 1
	self.heal = hex(F.gainColor)
	return self
end

function HpBar:draw()
	local st = self.st
	if st.fill == nil then
		return
	end
	local function px(v: number): number
		return math.floor(self.w * math.clamp(v, 0, 1) + 0.5)
	end
	self.bar:set(st.fill)
	self.lag.Size = UDim2.fromOffset(if st.lag > st.fill then px(st.lag) else 0, self.h)
	self.gain.Size = UDim2.fromOffset(if st.gain > st.fill then px(st.gain) else 0, self.h)
	self.flash.BackgroundColor3 = if st.kind == "heal" then self.heal else Color3.new(1, 1, 1)
	self.flash.BackgroundTransparency = 1 - HpFx.F.flashA * st.flash / HpFx.F.flash
end

-- 새 체력(ratio 0~1 · hp = 숫자). 처음(또는 reset 뒤)에는 효과 없이 그대로 놓는다
function HpBar:set(ratio: number, hp: number)
	HpFx.set(self.st, ratio, hp)
	self:draw()
end

-- 장마다: 효과를 흘려보낸다
function HpBar:step(dt: number)
	if not HpFx.idle(self.st) then
		HpFx.step(self.st, dt)
		self:draw()
	end
end

-- 효과가 아직 보이는가(닳은 자리가 줄어드는 중 · 번쩍이는 중)
function HpBar:busy(): boolean
	return not HpFx.idle(self.st)
end

-- 처음으로(다시 나타난 몬스터 · 다른 보스): 다음 set은 효과 없이 놓인다
function HpBar:reset()
	self.st = HpFx.new()
	self.lag.Size = UDim2.fromOffset(0, self.h)
	self.gain.Size = UDim2.fromOffset(0, self.h)
	self.flash.BackgroundTransparency = 1
end

return HpBar

end
MODULES['Client/lune/ui/itemCell'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 아이템 한 칸 — 가방 · 장비 창 · 창고 · 강화 창 · 상세 판이 같이 쓴다. 칸에 놓이는 것 = 장비({ slot, stage, q, star … }) 또는 소비 · 기타 아이템의 묶음({ item = 이름표, n = 수 }).
--  묶음은 그 아이템의 그림과 오른쪽 아래의 수(사용자 2026-10-08: 소비 · 기타 아이템도 장비처럼 칸에 놓인다).
--  어두운 칸에 그 장비의 그림(땅에 떨어진 것과 같은 그림 — 게임의 굵은 도트 그대로). 오른쪽 아래의 +숫자 = 별, 부서진 것은 어둡게 하고 빨간 ×.
--  고른 칸은 민트 테두리. 등급(성능 단)은 칸에 표시하지 않는다 — 이름의 글자색으로만 보인다(던그리드처럼. 낡은 갈색 · 허름한 회색 · 보통 흰색 · 좋은 하늘색 · 빼어난 노랑).
--  그림은 공방의 아이콘(tools/build_lune_icons.mjs): 무기는 직업마다 하나, 방어구는 부위 x 재질(가죽 · 수정 · 무쇠 · 달빛), 장신구는 부위마다 하나.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Items = require(lune.sim.items)
local KIT = require(lune.data["kit.generated"])
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local D = Items.data
local ICONS = KIT.parts.icons.icons

local ItemCell = {}
-- 칸의 한 변(화면 틀의 배율을 따른다 — 1080p에서 50). 창을 지을 때마다 다시 묻는다
function ItemCell.size(): number
	return Ui.cellSize()
end
-- 성능 단의 글자색: 낡은 · 허름한 · 보통 · 좋은 · 빼어난
ItemCell.QUALITY = { C.tier0, C.tier1, C.tier2, C.tier3, C.tier4 }
local WEAPON = { axion = "w_axe", riven = "w_spear", reaper = "w_scythe", mooni = "w_sword", salamander = "w_fist" }

function ItemCell.color(it): Color3
	if it.broken then
		return C.red
	end
	return ItemCell.QUALITY[it.q] or C.text
end

-- 방어구의 재질 번호(1 가죽 · 2 수정 · 3 무쇠 · 4 달빛) — 장비 단계로 정해진다
function ItemCell.material(stage: number): number
	for i, m in D.MATERIAL do
		if stage < m.below then
			return i
		end
	end
	return #D.MATERIAL
end

-- 소비 · 기타 아이템의 묶음인가
function ItemCell.isStack(it: any): boolean
	return it ~= nil and it.item ~= nil
end

-- 그 아이템의 아이콘 이름
function ItemCell.icon(it): string
	if it.item then
		local g = Items.goods(it.item)
		return if g then g.icon else ""
	end
	if it.slot == "weapon" then
		return WEAPON[it.who] or "w_sword"
	end
	local armor = ("a_%s%d"):format(it.slot, ItemCell.material(it.stage))
	if ICONS[armor] then
		return armor
	end
	return "acc_" .. it.slot
end

-- 땅에 떨어진 장비의 귀퉁이 표시(게임 세계의 그림 — client/lune/effects.luau가 쓴다): 보통이면 nil
local TIER = { "tier0", "tier1", nil, "tier3", "tier4" }
function ItemCell.tier(it): string?
	return TIER[it.q]
end

-- 글로 적는 장비(한 줄): 이름(2026-10-15부터 「+별」을 붙이지 않는다 — 별은 상세 판의 이름 위에 별 그림으로)
function ItemCell.label(it): string
	local name = Items.name(it)
	if it.broken then
		return name .. " (부서짐)"
	end
	return name
end
-- 칸 귀퉁이의 별 표시(좁은 칸이라 글 하나로): 「★5」 — 별이 없으면 빈 글
function ItemCell.starMark(star: number): string
	return if star > 0 then "★" .. star else ""
end

-- 성능 단의 글: 보통이면 빈 글
function ItemCell.qualityText(it): string
	local q = D.QUALITY[it.q]
	if q.bonus == 0 then
		return ""
	end
	return ("%s %s%d%%"):format(q.name, if q.bonus > 0 then "+" else "", q.bonus)
end

-- 화면의 그 자리(at)에 있는 칸의 차례(없으면 nil) — 끌던 것을 놓을 칸을 찾을 때 쓴다. cells = ItemCell.new로 만든 칸들
function ItemCell.at(cells, at: Vector2): number?
	for i, cell in cells do
		local p, s = cell.frame.AbsolutePosition, cell.frame.AbsoluteSize
		if at.X >= p.X and at.X < p.X + s.X and at.Y >= p.Y and at.Y < p.Y + s.Y then
			return i
		end
	end
	return nil
end

-- 화면의 그 자리(at)가 그 틀(frame) 안인가
function ItemCell.over(frame: GuiObject, at: Vector2): boolean
	local p, s = frame.AbsolutePosition, frame.AbsoluteSize
	return at.X >= p.X and at.X < p.X + s.X and at.Y >= p.Y and at.Y < p.Y + s.Y
end

-- 칸 하나(한 변 s — 안 주면 ItemCell.size()). onClick(item) — 빈 칸을 눌러도 불린다(item = nil)
function ItemCell.new(parent: Instance, x: number, y: number, onClick: (any) -> (), s: number?)
	local S = s or ItemCell.size()
	local slot = Ui.slot(parent, x, y, S)
	local outer = slot.frame
	outer.Name = "Cell"
	local icon = Ui.worldIcon(outer, nil, 0, 0, S)
	local star = Ui.text(outer, "", 0, S - 13, S - 4, { align = "right", outline = true, color = C.text, z = 6 })
	local cross = Ui.text(outer, "", 0, math.floor((S - 12) / 2), S, { font = "body", align = "center", outline = true, color = C.red, z = 6 })
	local up = Ui.text(outer, "", 3, 2, 12, { outline = true, color = C.green, z = 6 }) -- 지금 낀 것보다 좋은 장비 ▲(2026-10-18 — opts.better)
	local veil = Ui.box(outer, 1, 1, S - 2, S - 2, C.ink, 0.45) -- 아직 열리지 않은 칸
	veil.Name = "Locked"
	veil.ZIndex = 5
	veil.Visible = false
	local cell = { frame = outer, item = nil :: any, size = S }
	cell.hit = Ui.hit(outer) -- 누르는 자리(가방은 여기서 끌기도 받는다)
	cell.hit.Activated:Connect(function()
		onClick(cell.item)
	end)
	-- it = 장비 · 묶음(없으면 빈 칸). opts = { locked 아직 열리지 않은 칸, selected 고른 칸, hot 끌던 것을 놓을 칸, better 지금 낀 것보다 좋은 장비(▲) }
	function cell.set(_, it: any, opts)
		opts = opts or {}
		cell.item = it
		Ui.setWorldIcon(icon, if it then ItemCell.icon(it) else nil)
		if it and it.item then
			star:set(tostring(it.n)) -- 묶음: 수
		else
			star:set(if it then ItemCell.starMark(it.star) else "") -- 장비: 「★5」(2026-10-15 — 「+5」에서)
		end
		local broken = it ~= nil and it.broken == true
		icon.ImageColor3 = if broken then Color3.fromRGB(90, 90, 100) else Color3.new(1, 1, 1)
		cross:set(if broken then "×" else "")
		up:set(if it and opts.better then "▲" else "")
		slot:setOn(opts.selected == true or opts.hot == true)
		veil.Visible = opts.locked == true
	end
	cell:set(nil)
	return cell
end

return ItemCell

end
MODULES['Client/lune/ui/itemDetail'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 아이템 상세 — 가방 · 장비 창 · 창고에서 고른 아이템을 그 창 옆의 작은 판에 보여 준다. 한 번에 하나만 뜬다(다른 창에서 고르면 그쪽으로 옮겨 간다).
--  사용자 2026-10-08: "장비 탭에서 각각의 장비를 선택하면 그 해당장비가 장비창 옆에 작은모달이 떠서 아이템 스펙이 나와야합니다. 인벤토리에서 선택도 마찬가지입니다. 기타아이템, 소비아이템 모두 마찬가지입니다."
--  판의 짜임(공방 js/lune/design/ui.js의 UILAYOUT.detail — 횡스크롤 시험 탭의 paintDetail과 같은 그림):
--   위에 그림 칸과 이름(본문 글씨 — 색 = 성능 단) · 그 아래 갈래 / 줄마다 이름(흐린 글)과 값 / 알림 글(장착하면 전투력 +n …) / 단추(장착 · 사용 · 분해 · 버리기 …).
--   버리기 · 맡기기 · 찾기 · 팔기 · 나누기를 누르면 단추 자리에 "몇 개를 …할까요?"와 수를 고르는 단추 · 「…한다 · 그만둔다」가 뜬다(spec.ask — ItemDetail.ask가 짓는다).
--	장비를 팔 때는 수를 고르지 않고 팔지 말지만 묻는다.
--  적는 글은 shared/lune/ui/itemInfo.luau가 짓는다(공방의 gearInfo · goodsInfo와 같은 글). 판은 창들보다 위, 닫기(X)들보다 아래의 층에 뜬다.
--  PC · 스마트폰 같은 판이다 — 칸을 누르면(손가락으로 톡) 뜨고, 판의 ×나 빈 칸을 누르면 닫힌다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Layout = require(ReplicatedStorage.shared.lune.ui.layout)
local Format = require(ReplicatedStorage.shared.lune.ui.format)
local WORDS = require(ReplicatedStorage.shared.lune.data["ui.generated"]).words
local Stage = require(script.Parent.Parent.stage)
local Ui = require(script.Parent.ui)
local ItemCell = require(script.Parent.itemCell)
local Windows = require(script.Parent.windows)

local C = Ui.COLOR
local K = Layout.DETAIL
local M = Ui.M

local ItemDetail = {}
local STEPS = { -10, -1, 1, 10 } -- 수를 고르는 단추

local layer: Frame? = nil
local shown = nil -- { owner, key, holder }

local function root(): Frame
	if not layer then
		layer = Stage.group(Stage.ui, "ItemDetail", 156) -- 창(150) 위 · 메뉴(160) 아래
	end
	return layer :: Frame
end

-- 지금 떠 있는 판의 주인(창의 이름표 — 없으면 nil)
function ItemDetail.owner(): string?
	return if shown then shown.owner else nil
end

-- 판을 닫는다. owner를 주면 그 창의 것일 때만
function ItemDetail.hide(owner: string?)
	if shown and (owner == nil or shown.owner == owner) then
		shown.holder:Destroy()
		shown = nil
	end
end

-- 수를 고르는 줄(spec.ask)을 짓는다. kind = 하는 일(WORDS.ask의 이름표: "discard" · "store" · "take" · "sell" · "split" · "sellGear") · n = 지금 고른 수(nil이면 수를 고르지 않는다 — 장비 팔기) ·
--  lo · hi = 고를 수 있는 범위 · o = { set(n) 수를 고쳤다, yes(n) 한다, no() 그만둔다, gain(n) → 팔 때 받을 달돈(묻는 글 뒤에 붙는다) }
function ItemDetail.ask(kind: string, n: number?, lo: number, hi: number, o)
	local words = WORDS.ask[kind]
	local text = words[1]
	if o.gain then
		text = text .. "  " .. Format.fill(WORDS[o.gainWord or "gain"], { n = Format.short(o.gain(n or 1)) }) -- gainWord = 받을 것의 글(분해 = 「달가루 +n」 — 2026-10-18)
	end
	local steps = nil
	if n then
		steps = {}
		for i, d in STEPS do
			steps[i] = { text = if d > 0 then "+" .. d else tostring(d), onClick = function()
				o.set(math.clamp(n + d, lo, hi))
			end }
		end
	end
	return {
		text = text,
		n = n,
		steps = steps,
		yes = { text = words[2], onClick = function()
			o.yes(n)
		end },
		no = { text = WORDS.askNo, onClick = o.no },
	}
end

-- 글의 줄 수(그려진 높이에서)
local function linesOf(label, line: number): number
	local _, h = label:size()
	return math.max(1, math.floor(h / line + 0.5))
end

-- 판을 띄운다(이미 같은 것이 떠 있으면 자리만 다시 맞춘다).
--  owner = 주인 창의 이름표 · spec = { key(달라지면 다시 그린다), info(ItemInfo의 것), item(칸에 그릴 장비 · 묶음), buttons = { { text, main?, off?, onClick } … },
--                                    ask = { text, n, steps = { { text, onClick } … 넷 }, yes = { text, onClick }, no = { text, onClick } }?, onClose }
function ItemDetail.show(owner: string, spec)
	local at = Windows.beside(owner, K.w, K.gap)
	if not at then
		ItemDetail.hide(owner)
		return
	end
	if shown and shown.owner == owner and shown.key == spec.key then
		shown.holder.Position = at
		return
	end
	ItemDetail.hide(nil)
	local info = spec.info
	local S = ItemCell.size()
	local inner = Layout.detailInner()
	local holder = Stage.place(root(), "Detail_" .. owner, "tr", 0, 0, K.w, 10)
	holder.Position = at
	local panel = Ui.panel(holder, 0, 0, K.w, 10)
	-- 판을 누른 것이 그 밑의 것(게임 화면 · 다른 창)으로 새지 않게
	local shield = Ui.hit(panel)
	shield.ZIndex = 1
	shield.Name = "Shield"

	-- 장비의 별(맨 위 — 2026-10-15: 이름 옆의 「+n」 대신 1성에 별 하나 · 22성까지의 빈 별도 흐리게)
	local top = K.pad
	if info.stars ~= nil and (info.starMax or 0) > 0 then
		local starRows = math.ceil(info.starMax / 15)
		Ui.stars(panel, K.pad, K.pad, inner, "center"):set(info.stars, info.starMax)
		top += Layout.detailStarsH(starRows)
	end
	-- 그림 칸 · 이름 · 갈래 · 닫기
	local cell = ItemCell.new(panel, K.pad, top, function() end, S)
	cell:set(spec.item, {})
	cell.hit.Active = false
	local nameX = K.pad + S + 8
	local name = Ui.text(panel, info.name, nameX, top, Layout.detailNameW(Stage.ratio), { font = "body", lines = K.nameLines, line = K.nameLine, color = C[info.tone] or C.text })
	local nameLines = linesOf(name, K.nameLine)
	Ui.text(panel, info.sub, nameX, top + nameLines * K.nameLine + K.subGap, inner - S - 8, { color = C.dim })
	Ui.closeButton(panel, K.w - K.pad - 10, K.pad, function()
		if spec.onClose then
			spec.onClose()
		else
			ItemDetail.hide(owner)
		end
	end).ZIndex = 12
	local y = top + math.max(S, nameLines * K.nameLine + K.subGap + M.small)

	-- 줄: 이름(흐린 글)과 값
	Ui.line(panel, K.pad, y + math.floor(K.rowTop / 2), inner)
	y += K.rowTop
	for _, row in info.rows do
		Ui.text(panel, row[1], K.pad, y + 3, K.labelW, { color = C.dim })
		Ui.text(panel, row[2], K.pad + K.labelW, y + 3, Layout.detailValueW(), { color = C[row[3]] or C.text })
		y += K.rowH
	end

	-- 알림 글
	if #info.notes > 0 then
		Ui.line(panel, K.pad, y + math.floor(K.noteTop / 2), inner)
		y += K.noteTop
		for _, note in info.notes do
			local label = Ui.text(panel, note[1], K.pad, y + 2, inner, { lines = K.noteLines, line = K.noteLine, color = C[note[2]] or C.text })
			y += linesOf(label, K.noteLine) * K.noteLine
		end
	end

	-- 단추 — 또는 버릴 수를 고르는 줄
	local ask = spec.ask
	if ask then
		y += K.btnTop
		Ui.text(panel, ask.text, K.pad, y, inner, { color = C.gold })
		y += M.smallLine + 4
		if ask.steps then
			-- [-10] [-1]  수  [+1] [+10]
			local step = K.stepW
			local xs = { 0, step + K.btnGap, inner - step * 2 - K.btnGap, inner - step }
			for i, s in ask.steps do
				Ui.button(panel, s.text, K.pad + xs[i], y, step, s.onClick, { font = "small" }).frame.Name = "Step" .. i
			end
			local mid = xs[2] + step
			Ui.text(panel, tostring(ask.n), K.pad + mid, y + math.floor((M.button - M.body) / 2), xs[3] - mid, { font = "body", align = "center" })
			y += M.button + K.btnGap
		end
		local half = Layout.detailButtonW(2)
		Ui.button(panel, ask.yes.text, K.pad, y, half, ask.yes.onClick, { main = true }).frame.Name = "Yes"
		Ui.button(panel, ask.no.text, K.pad + half + K.btnGap, y, half, ask.no.onClick).frame.Name = "No"
		y += M.button
	elseif #spec.buttons > 0 then
		y += K.btnTop
		local n = #spec.buttons
		local perRow = math.min(n, K.btnCols)
		local bw = Layout.detailButtonW(perRow)
		for i, b in spec.buttons do
			local col, row = (i - 1) % perRow, (i - 1) // perRow
			local button = Ui.button(panel, b.text, K.pad + col * (bw + K.btnGap), y + row * (M.button + K.btnGap), bw, b.onClick, { main = b.main == true })
			button.frame.Name = "Do" .. i
			button:setEnabled(not b.off)
		end
		local rows = math.ceil(n / perRow)
		y += rows * M.button + (rows - 1) * K.btnGap
	end
	local h = y + K.pad
	holder.Size = UDim2.fromOffset(K.w, h)
	panel.Size = UDim2.fromOffset(K.w, h)
	local back = panel:FindFirstChild("Back")
	if back then
		(back :: ImageLabel).Size = UDim2.fromOffset(K.w, h)
	end
	shown = { owner = owner, key = spec.key, holder = holder }
end

return ItemDetail

end
MODULES['Client/lune/ui/keysWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 키 설정 창(넓은 창) — 하는 일마다 지금 키가 적힌 단추가 있다. 단추를 누른 뒤 새 키를 누르면 바뀐다.
--  이미 쓰는 키면 둘이 자리를 바꾼다. 「기본으로」는 처음 세팅으로 돌린다. 바꾼 것은 서버에 저장된다(캐릭터마다).
--  사용자 결정(2026-10-06): 기본 키를 주되 유저가 자유롭게 바꾼다. 화면 오른쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Format = require(ReplicatedStorage.shared.lune.ui.format)
local Ui = require(script.Parent.ui)
local Input = require(script.Parent.Parent.input)

local C = Ui.COLOR
local ROW = Ui.M.button + 4
local PER_COLUMN = 10
local COLUMNS = 3 -- 세 단: 기본 동작 · 창을 여는 키 · 퀵슬롯의 키 차례로 채운다
local COL_W, GAP = 190, 16 -- 한 단의 폭 · 단 사이
local KEY_W = 70 -- 키가 적힌 단추의 폭

local KeysWindow = { wide = true }

function KeysWindow.size(): (number, number)
	return COL_W * COLUMNS + GAP * (COLUMNS - 1), 34 + PER_COLUMN * ROW
end

-- 화면에 적을 "하는 일"의 차례와 이름. ctx.actions() = { { action, name } … }
function KeysWindow.build(body: Frame, ctx, w: number, _h: number)
	local actions = ctx.actions()
	local buttons = {}
	local waiting: string? = nil
	local note = Ui.text(body, "바꿀 단추를 누른 뒤 새 키를 누른다", 0, 5, w - 110, { color = C.dim })

	local function redraw()
		for _, item in actions do
			local key = Input.BIND[item.action]
			local b = buttons[item.action]
			if b then
				b:setText(if waiting == item.action then "…" else Format.key(if key then key.Name else "-"))
				b:setMain(waiting == item.action)
			end
		end
		note:set(if waiting then "새 키를 누른다(같은 단추를 다시 누르면 그만둔다)" else "바꿀 단추를 누른 뒤 새 키를 누른다")
	end

	for i, item in actions do
		if i > PER_COLUMN * COLUMNS then
			break -- 세 단에 들어가는 만큼만
		end
		local col = (i - 1) // PER_COLUMN
		local row = (i - 1) % PER_COLUMN
		local x, y = col * (COL_W + GAP), 34 + row * ROW
		Ui.text(body, item.name, x, y + 7, COL_W - KEY_W - 8, { font = "body" })
		buttons[item.action] = Ui.button(body, "", x + COL_W - KEY_W, y, KEY_W, function()
			if waiting == item.action then
				waiting = nil
				Input.capture(nil)
				redraw()
				return
			end
			waiting = item.action
			redraw()
			Input.capture(function(key: Enum.KeyCode)
				Input.rebind(item.action, key)
				waiting = nil
				redraw()
				ctx.saveKeys()
			end)
		end)
	end
	Ui.button(body, "기본으로", w - 100, 0, 100, function()
		waiting = nil
		Input.capture(nil)
		ctx.resetKeys()
		redraw()
		ctx.saveKeys()
	end, { h = 22, font = "small" })
	redraw()

	return {
		refresh = function() end,
		destroy = function()
			Input.capture(nil)
		end,
	}
end

return KeysWindow

end
MODULES['Client/lune/ui/kit'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 게임 세계의 부품 — 게임 화면(384x216)의 굵은 도트로 그리는 것: 장비 그림(땅에 떨어진 것 · 주민 머리 위의 표시) · 떨어진 돈과 달가루 · 피해 숫자.
--  화면의 글씨와 틀(판 · 칸 · 단추 · 창)은 여기 것이 아니다 — 화면 틀의 고운 격자에 그리는 ui/ui.luau를 쓴다.
--  부품 그림 한 장(ui_kit.png)과 그 자리 · 색은 shared/lune/data/kit.generated.luau — 공방의 tools/build_lune_ui.mjs가 짓는다. 여기서 모양을 따로 그리지 않는다.
--  좌표는 게임 화면의 도트.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local KIT = require(lune.data["kit.generated"])
local ASSETS = require(lune.data["assets.generated"])

local Kit = {}
Kit.DATA = KIT
Kit.IMAGE = ASSETS[KIT.image] or ""
Kit.ICON = KIT.icon -- 장비 그림의 한 변(18)
Kit.GROUND = KIT.ground -- 화면에서 땅의 윗면(발밑)의 y
local PARTS = KIT.parts

Kit.COLOR = {}
for name, c in KIT.colors do
	Kit.COLOR[name] = Color3.fromRGB(c[1], c[2], c[3])
end
local C = Kit.COLOR

-- ---------- 그림 ----------
local function image(parent: Instance, name: string, x: number, y: number, w: number, h: number): ImageLabel
	local label = Instance.new("ImageLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.ResampleMode = Enum.ResamplerMode.Pixelated
	label.Image = Kit.IMAGE
	label.Position = UDim2.fromOffset(x, y)
	label.Size = UDim2.fromOffset(w, h)
	label.Parent = parent
	return label
end

-- 그림의 속을 다른 부품으로 바꾼다
function Kit.swap(label: ImageLabel, name: string)
	local p = PARTS[name]
	assert(p, "없는 부품 " .. tostring(name))
	label.ImageRectOffset = Vector2.new(p.x, p.y)
	label.ImageRectSize = Vector2.new(p.w, p.h)
end

-- 부품 하나(떨어진 돈 · 달가루 · 떨어진 장비의 귀퉁이 표시)
function Kit.part(parent: Instance, name: string, x: number, y: number): ImageLabel
	local p = PARTS[name]
	assert(p, "없는 부품 " .. tostring(name))
	local label = image(parent, name, x, y, p.w, p.h)
	Kit.swap(label, name)
	return label
end

-- 부품을 바꿔 끼우는 그림: 이름이 없으면 숨기고, 있으면 그 부품의 크기로 맞춘다(주민 머리 위의 퀘스트 표시 ! · ?)
function Kit.setPart(label: ImageLabel, name: string?)
	label.Visible = name ~= nil
	if name then
		local p = PARTS[name]
		assert(p, "없는 부품 " .. tostring(name))
		label.ImageRectOffset = Vector2.new(p.x, p.y)
		label.ImageRectSize = Vector2.new(p.w, p.h)
		label.Size = UDim2.fromOffset(p.w, p.h)
	end
end

function Kit.partSize(name: string): (number, number)
	local p = PARTS[name]
	return p.w, p.h
end

-- 장비 그림(18x18). 이름은 공방의 아이콘 이름(tools/build_lune_icons.mjs) — 없는 이름이면 빈 그림
function Kit.setIcon(label: ImageLabel, name: string?)
	local sheet = PARTS.icons
	local at = name and sheet.icons[name]
	label.Visible = at ~= nil
	if at then
		label.ImageRectOffset = Vector2.new(sheet.x + at[1], sheet.y + at[2])
		label.ImageRectSize = Vector2.new(sheet.size, sheet.size)
	end
end

function Kit.hasIcon(name: string): boolean
	return PARTS.icons.icons[name] ~= nil
end

function Kit.icon(parent: Instance, name: string?, x: number, y: number): ImageLabel
	local label = image(parent, "Icon", x, y, PARTS.icons.size, PARTS.icons.size)
	Kit.setIcon(label, name)
	return label
end

-- 색 상자(화살 · 땅속을 메우는 바탕)
function Kit.box(parent: Instance, x: number, y: number, w: number, h: number, color: Color3?, alpha: number?): Frame
	local f = Instance.new("Frame")
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	f.BackgroundColor3 = color or C.line
	f.BackgroundTransparency = alpha or 0
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end

-- 틀만 있는 빈 자리(그 안에 부품을 놓는다)
function Kit.group(parent: Instance, x: number, y: number, w: number, h: number): Frame
	return Kit.box(parent, x, y, w, h, C.line, 1)
end

-- 피해 숫자: 공방 「횡스크롤 시험」 탭의 3x5 점 숫자 그대로(dino-workshop/js/lune/fx.js의 num — 사용자 2026-10-07:
--  "데미지 폰트는 이전 횡스크롤 시험 탭에서 실제 플레이할때의 데미지 출력이랑 동일해야합니다").
--  속에는 색을 입히고, 위 · 아래 · 옆 한 점의 테두리는 늘 같은 어두운 색이다. 틀의 왼쪽 위가 테두리의 왼쪽 위 — width = 글자 수 x 4 + 1.
function Kit.dmg(parent: Instance, text: string, color: Color3)
	local sheet = PARTS.dmg
	local frame = Kit.group(parent, 0, 0, 1, sheet.ch)
	frame.Name = "Dmg"
	local fills = {}
	local n = 0
	for i = 1, #text do
		local d = tonumber(text:sub(i, i))
		if d then
			local line = image(frame, "line", n * sheet.adv, 0, sheet.cw, sheet.ch)
			line.ImageRectOffset = Vector2.new(sheet.x + d * sheet.cw, sheet.y + sheet.ch)
			line.ImageRectSize = Vector2.new(sheet.cw, sheet.ch)
			local fill = image(frame, "fill", n * sheet.adv, 0, sheet.cw, sheet.ch)
			fill.ImageRectOffset = Vector2.new(sheet.x + d * sheet.cw, sheet.y)
			fill.ImageRectSize = Vector2.new(sheet.cw, sheet.ch)
			fill.ImageColor3 = color
			fill.ZIndex = 2
			table.insert(fills, fill)
			n += 1
		end
	end
	local width = n * sheet.adv + 1
	frame.Size = UDim2.fromOffset(width, sheet.ch)
	local item = { frame = frame, width = width, height = sheet.ch }
	function item.color(_, tint: Color3)
		for _, g in fills do
			g.ImageColor3 = tint
		end
	end
	return item
end

return Kit

end
MODULES['Client/lune/ui/mapWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 월드맵 창(M) — 그림으로 된 지역 지도 위에 장소의 표시를 얹는다(메이플스토리의 월드맵처럼).
--  사용자 2026-10-11: "월드맵 똑바로 그리세요 다른 게임 월드맵 참고라도 하던가 퀄리티가 이게 뭡니까 없는게 나은수준인데" — 전의 것은 네모를 선으로 이은 도표였다(없앴다).
--  사용자 같은 날(이 창을 보고): "바위틈 같은 사냥터 표시안되고, 은달항구의 경우 지금 수비대 야영지에서 포탈로 갈수있는데 맵에서는 그냥 좌측 은달항구라고 나와버리면 어떻게 하라는건지?"
--   → 곁맵(굽잇길의 문 「바위 틈으로」 = 옛 은신처 · 멧돼지 굴)도 싣고, 모든 장소에 이름표를 달고, 은달 항구는 수비대 야영지에서 점줄로 이어진 표시로 그린다.
--  왼쪽: 지역의 그림(384x256 · Codex로 그려 옮긴 것 — 공방 assetpack/lune/worldmap) 위에
--   ① 장소마다 동그란 표시(갈래의 색: 마을 민트 · 쉼터 노랑 · 사냥터 흰색 · 던전 분홍 · 곁맵 회색 · 보스 빨강)와 이름표(서로 겹치지 않게 아래 · 위 · 옆에 놓는다 — WM.placeLabels)
--   ② 내가 있는 곳: 민트 고리와 그 위의 화살표, 민트 이름표 ③ 퀘스트를 받을 곳 「!」 · 돌려줄 곳 「?」 ④ 내 레벨에 맞는 사냥터: 풀빛 고리와 풀빛 이름표
--   ⑤ 지금 가야 할 곳까지의 길: 표시 사이를 잇는 금빛 점줄 ⑥ 다른 지역(은달 항구): 그 도시가 그려진 자리의 민트 표시 — 그리로 가는 포탈이 있는 장소(수비대 야영지)에서 민트 점줄로 잇는다
--  오른쪽: 고른 장소의 이름 · 갈래 · 레벨 · 다른 지역으로 가는 포탈 · 몬스터 · 주민, 내 레벨의 사냥터, 가는 길(글).
--  그림이 있는 지역만 보여 준다(그림이 없는 지역은 탭도 없다 — 도표로 때우지 않는다). 이동하는 기능은 없다(보기만 한다).
--  셈은 shared/lune/ui/worldmap.luau, 자리는 data/worldmap.generated.luau의 art(공방 js/lune/design/journey.js의 WORLDART).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local WM = require(lune.ui.worldmap)
local ASSETS = require(lune.data["assets.generated"])
local UI = require(lune.data["ui.generated"])
local Ui = require(script.Parent.ui)
local Kit = require(script.Parent.kit)

local C = Ui.COLOR

local MapWindow = { wide = true }
MapWindow.ART_W, MapWindow.ART_H = WM.ART_W, WM.ART_H -- 그림의 크기(화면 틀의 점 — 그림의 한 점이 화면 틀의 한 점)
MapWindow.SIDE_W, MapWindow.GAP = WM.SIDE_W, 12 -- 오른쪽 글 칸의 폭 · 그림과의 사이
MapWindow.TAB_H = 22 -- 탭 줄(그림이 있는 지역이 둘 넘을 때만)
MapWindow.PIN = WM.PIN -- 표시의 반지름

-- 장소의 갈래마다의 색
local KIND = { town = C.accent, village = C.accent, rest = C.gold, hunt = C.text, road = C.dim, climb = C.pink, dead = C.dim, boss = C.red }

function MapWindow.size(): (number, number)
	local tabs = if #WM.arted() > 1 then MapWindow.TAB_H else 0
	return MapWindow.ART_W + MapWindow.GAP + MapWindow.SIDE_W, tabs + MapWindow.ART_H
end

-- 동그란 표시(네모를 겹쳐 모서리를 깎는다): 어두운 테두리 + 속
local function dot(parent: Instance, x: number, y: number, r: number, color: Color3, name: string)
	local holder = Ui.group(parent, x - r - 1, y - r - 1, r * 2 + 3, r * 2 + 3, name)
	local c = r + 1
	Ui.box(holder, c - r - 1, c - r + 1, r * 2 + 3, r * 2 - 1, C.ink)
	Ui.box(holder, c - r + 1, c - r - 1, r * 2 - 1, r * 2 + 3, C.ink)
	Ui.box(holder, c - r, c - r, r * 2 + 1, r * 2 + 1, C.ink)
	Ui.box(holder, c - r, c - r + 2, r * 2 + 1, r * 2 - 3, color).Name = "Fill"
	Ui.box(holder, c - r + 2, c - r, r * 2 - 3, r * 2 + 1, color).Name = "Fill"
	Ui.box(holder, c - r + 1, c - r + 1, r * 2 - 1, r * 2 - 1, color).Name = "Fill"
	return holder
end

-- 고리(표시 둘레의 한 점 굵기의 네모 테두리 — 내가 있는 곳 · 내 레벨의 사냥터)
local function ring(parent: Instance, x: number, y: number, r: number, color: Color3, name: string)
	local s = r * 2 + 1
	for _, b in { { x - r, y - r, s, 1 }, { x - r, y + r, s, 1 }, { x - r, y - r, 1, s }, { x + r, y - r, 1, s } } do
		Ui.box(parent, b[1], b[2], b[3], b[4], color).Name = name
	end
end

-- 점줄: 표시에서 표시로 곧게, 다섯 점마다 한 점
local function dots(parent: Instance, a, b, color: Color3, name: string)
	for _, d in WM.linkDots(a[1], a[2], b[1], b[2]) do
		Ui.box(parent, d[1], d[2], 2, 2, color).Name = name
	end
end

-- 이름표: 어두운 판 위의 작은 글(자리는 WM.placeLabels가 정한 것)
local function plate(parent: Instance, text: string, rect, color: Color3, name: string)
	local holder = Ui.group(parent, rect.x, rect.y, rect.w, rect.h, name)
	Ui.box(holder, 0, 0, rect.w, rect.h, C.ink, 0.15)
	Ui.box(holder, 0, rect.h - 1, rect.w, 1, color, 0.4)
	Ui.text(holder, text, WM.PLATE.padX, 2, rect.w - WM.PLATE.padX * 2, { color = color })
	return holder
end

-- 파티원(나를 뺀 것): ctx.party가 주는 파티(PartyInfo — members = { { id, name, scene } … })에서. 파티가 없으면 빈 표(2026-10-18)
function MapWindow.partyOf(ctx): { any }
	local info = if ctx.party then ctx.party() else nil
	local me = if ctx.myId then ctx.myId() else nil
	local out = {}
	for _, m in (if typeof(info) == "table" then info.members else nil) or {} do
		if m.id ~= me and typeof(m.scene) == "string" then
			table.insert(out, m)
		end
	end
	return out
end

function MapWindow.build(body: Frame, ctx, w: number, _h: number)
	local view = {}
	local regions = WM.arted()
	local myRegion = WM.nodeOf(ctx.scene())
	local rid = if myRegion and WM.region(myRegion).art then myRegion else regions[1]
	local picked: string? = nil -- 누른 장소(없으면 내가 있는 곳). 다른 지역의 표시는 "out:지역"
	local layer: Frame? = nil
	local top = if #regions > 1 then MapWindow.TAB_H else 0

	local tabs = {}
	if #regions > 1 then
		local tx = 0
		for i, id in regions do
			tabs[i] = Ui.tab(body, WM.region(id).name, tx, 0, function()
				if rid ~= id then
					rid = id
					picked = nil
					view.refresh()
				end
			end)
			tabs[i].region = id
			tx += tabs[i].width + 14
		end
	end

	-- 그림(지역을 바꿀 때 갈아 끼운다)
	local art = Instance.new("ImageLabel")
	art.Name = "Art"
	art.BackgroundColor3 = C.ink
	art.BorderSizePixel = 0
	art.ResampleMode = Enum.ResamplerMode.Pixelated
	art.Position = UDim2.fromOffset(0, top)
	art.Size = UDim2.fromOffset(MapWindow.ART_W, MapWindow.ART_H)
	art.Parent = body
	-- 그림의 테두리(한 점)
	for _, b in { { 0, 0, MapWindow.ART_W, 1 }, { 0, MapWindow.ART_H - 1, MapWindow.ART_W, 1 }, { 0, 0, 1, MapWindow.ART_H }, { MapWindow.ART_W - 1, 0, 1, MapWindow.ART_H } } do
		local edge = Ui.box(art, b[1], b[2], b[3], b[4], C.lineHot)
		edge.Name = "Edge"
		edge.ZIndex = 8
	end

	-- 오른쪽 글 칸
	local sx, sw = MapWindow.ART_W + MapWindow.GAP, MapWindow.SIDE_W
	local side = Ui.group(body, sx, top, sw, MapWindow.ART_H, "Side")
	local head = Ui.text(side, "", 0, 0, sw, { font = "body", color = C.gold })
	local headLv = Ui.text(side, "", 0, 3, sw, { align = "right", color = C.dim })
	Ui.box(side, 0, 20, sw, 1, C.lineHot)
	local name = Ui.text(side, "", 0, 26, sw, { font = "body" })
	local sub = Ui.text(side, "", 0, 43, sw, { color = C.dim })
	local link = Ui.text(side, "", 0, 57, sw, { color = C.accent })
	local mobHead = Ui.text(side, "몬스터", 0, 73, sw, { color = C.off })
	local mobs = Ui.text(side, "", 0, 86, sw, { lines = WM.SIDE.mobLines, color = C.text })
	local npcHead = Ui.text(side, "주민", 0, 116, sw, { color = C.off })
	local npcs = Ui.text(side, "", 0, 129, sw, { lines = WM.SIDE.npcLines, color = C.text })
	Ui.box(side, 0, 162, sw, 1, C.line)
	Ui.text(side, "내 레벨의 사냥터", 0, 166, sw, { color = C.off })
	local best = Ui.text(side, "", 0, 179, sw, { color = C.green })
	Ui.text(side, "가는 길", 0, 195, sw, { color = C.off })
	local goalTitle = Ui.text(side, "", 0, 208, sw, { color = C.gold })
	local route = Ui.text(side, "", 0, 221, sw, { lines = WM.SIDE.routeLines, color = C.text })

	local function showSide(id: string)
		local region = WM.region(rid)
		local to = string.match(id, "^out:(.+)$")
		local info = if to then WM.outCard(rid, to) else WM.card(rid, id)
		head:set(region.name)
		headLv:set(WM.regionLevels(rid))
		name:set(info.name)
		sub:set(info.sub)
		link:set(info.link)
		mobHead:show(info.mobs ~= "")
		mobs:set(info.mobs)
		npcHead:show(info.npcs ~= "")
		npcs:set(info.npcs)
	end

	-- 그림 위의 표시들을 다시 그린다(지역을 바꿨다 · 퀘스트나 내 자리가 바뀌었다 · 다른 장소를 골랐다)
	function view.draw()
		if layer then
			layer:Destroy()
		end
		local region = WM.region(rid)
		local A = region.art
		art.Image = ASSETS[A.img] or ""
		local group = Ui.group(art, 0, 0, MapWindow.ART_W, MapWindow.ART_H, "Marks")
		group.ZIndex = 2
		layer = group
		local me = ctx.me()
		local level = if me then me.level else 1
		local sceneRegion, sceneNode = WM.nodeOf(ctx.scene())
		local mine = if sceneRegion == rid then sceneNode else nil
		local marks = WM.marks(rid, ctx.quests() or {}, level)
		local bestText, bestNode = WM.recommendShort(rid, level)
		local card = WM.goalCard(ctx.quests() or {}, level, ctx.scene(), if ctx.navi then ctx.navi() else nil, if ctx.daily then ctx.daily() else nil)
		local path, goal = if card then card.route else nil, if card then card.goal else nil
		for _, t in tabs do
			t:setOn(t.region == rid)
		end
		-- ⑥ 다른 지역으로 가는 길: 포탈이 있는 장소에서 그 지역의 표시까지 민트 점줄(늘 보인다)
		for _, ex in WM.exits(rid) do
			local from, to = A.at[ex.node], A.out[ex.to]
			if from and to then
				dots(group, from, to, C.accent, "OutLink")
			end
		end
		-- 이어진 곳끼리의 줄(문 하나로 오가는 두 곳 — 사용자 2026-10-13: "월드맵이랑 실제 포탈이랑 안맞잖아요 … 한참 헤멘다구요"): 흐린 점줄로 늘 보인다.
		--  그림에 그려진 길만으로는 어느 곳이 어느 곳과 이어지는지 알 수 없었다(가지로 돌린 맵이 줄기의 길 위에 있는 것처럼 보였다)
		for _, link in region.links do
			local a, b = A.at[link[1]], A.at[link[2]]
			if a and b then
				dots(group, a, b, C.dim, "Link")
			end
		end
		-- ⑤ 가는 길: 이 지역을 지나는 구간마다 금빛 점줄(다른 지역으로 넘어가는 구간은 그 지역의 표시까지)
		local goalNode = nil
		if path then
			for i = 2, #path do
				local a, b = path[i - 1], path[i]
				local pa = if a.region == rid then A.at[a.node] else A.out[a.region]
				local pb = if b.region == rid then A.at[b.node] else A.out[b.region]
				if pa and pb and (a.region == rid or b.region == rid) then
					dots(group, pa, pb, C.gold, "Route")
				end
			end
			local last = path[#path]
			if goal then
				goalNode = if last.region == rid then last.node else "out:" .. last.region
			end
		end
		-- 그릴 것들: 장소들과 다른 지역들. 이름표는 내가 있는 곳 → 가야 할 곳 → 내 레벨의 사냥터 → 고른 곳 → 마을 · 쉼터 → 나머지의 차례로 자리를 잡는다
		local pins = {}
		for _, n in region.nodes do
			local at = A.at[n.id]
			if at then
				table.insert(pins, { id = n.id, x = at[1], y = at[2], r = MapWindow.PIN[n.kind] or 4, text = n.label, node = n, color = KIND[n.kind] or C.text })
			end
		end
		for to, at in A.out or {} do
			local other = WM.region(to)
			if other then
				table.insert(pins, { id = "out:" .. to, x = at[1], y = at[2], r = MapWindow.PIN.out, text = other.name, color = C.accent, out = to })
			end
		end
		local function rank(p): number
			if p.id == mine then
				return 1
			elseif p.id == goalNode then
				return 2
			elseif p.id == bestNode then
				return 3
			elseif p.id == picked then
				return 4
			elseif p.out or (p.node and (p.node.kind == "town" or p.node.kind == "village" or p.node.kind == "rest")) then
				return 5
			end
			return 6
		end
		local order = table.clone(pins)
		for i, p in order do
			p.w = Ui.measure(p.text)
			p.rank, p.at = rank(p), i
		end
		table.sort(order, function(a, b)
			if a.rank ~= b.rank then
				return a.rank < b.rank
			end
			return a.at < b.at
		end)
		local places = WM.placeLabels(order, WM.lines(rid)) -- 이어진 줄을 가리지 않는 자리에
		for _, p in pins do
			local x, y, r = p.x, p.y, p.r
			if p.id == bestNode then
				ring(group, x, y, r + 3, C.green, "Best")
			end
			if p.id == mine then
				ring(group, x, y, r + 3, C.accent, "Here")
			end
			dot(group, x, y, r, p.color, "Pin_" .. p.id)
			-- ③ 퀘스트의 표시: 표시의 오른쪽 위에
			local mark = if p.node then marks[p.id] else nil
			if mark then
				local part = Kit.part(group, if mark == "?" then UI.questMark.done else UI.questMark.new, 0, 0)
				part.Position = UDim2.fromOffset(x + r, y - r - part.Size.Y.Offset + 2)
				part.Name = "Quest"
				part.ZIndex = 5
			end
			-- 이름표
			local rect = places[p.id]
			if rect then
				local color = if p.id == mine then C.accent elseif p.id == goalNode then C.gold elseif p.id == bestNode then C.green elseif p.id == picked then C.text elseif p.out then C.accent else C.dim
				plate(group, p.text, rect, color, "Name_" .. p.id)
			end
			-- ② 내가 있는 곳의 화살표(아래로 뾰족한 세 줄) — 이름표가 위에 놓였으면 그 위에
			if p.id == mine then
				local topY = y - r - 4
				if rect and rect.y + rect.h <= y and rect.x < x + 4 and rect.x + rect.w > x - 4 then
					topY = math.min(topY, rect.y - 1)
				end
				for i, wdt in { 5, 3, 1 } do
					Ui.box(group, x - math.floor(wdt / 2) - 1, topY - 8 + i * 2 - 1, wdt + 2, 3, C.ink).Name = "Arrow"
				end
				for i, wdt in { 5, 3, 1 } do
					Ui.box(group, x - math.floor(wdt / 2), topY - 8 + i * 2, wdt, 1, C.accent).Name = "Arrow"
				end
			end
			-- 누르면 고른다(표시와 이름표 어느 쪽을 눌러도)
			local zone = Ui.group(group, x - 9, y - 9, 19, 19, "Hit_" .. p.id)
			zone.ZIndex = 6
			Ui.hit(zone).Activated:Connect(function()
				picked = p.id
				view.refresh()
			end)
			if rect then
				local zone2 = Ui.group(group, rect.x, rect.y, rect.w, rect.h, "HitName_" .. p.id)
				zone2.ZIndex = 6
				Ui.hit(zone2).Activated:Connect(function()
					picked = p.id
					view.refresh()
				end)
			end
		end
		-- 파티원(2026-10-18 — 메이플처럼): 이 지역에 있는 파티원마다 그 장소의 표시 왼쪽 아래에 작은 금빛 점(나란히 — 파티는 넷까지)
		local count = {}
		for _, m in MapWindow.partyOf(ctx) do
			local pr, pn = WM.nodeOf(m.scene)
			local at = if pr == rid and pn then A.at[pn] else nil
			if at then
				count[pn] = (count[pn] or 0) + 1
				dot(group, at[1] - 7 - (count[pn] - 1) * 5, at[2] + 7, 2, C.gold, "Party")
			end
		end
		-- 오른쪽 글 칸: 고른 곳(없으면 내가 있는 곳 — 다른 지역을 보는 중이면 그 지역의 첫 장소)
		showSide(picked or mine or region.nodes[1].id)
		best:set(bestText)
		best:color(if bestNode then C.green else C.dim)
		goalTitle:set(if card then card.title else "지금 가야 할 곳이 없다")
		goalTitle:color(if card then C.gold else C.off)
		route:set(if card then card.text else "")
	end

	-- 내 상태가 올 때마다 불린다(사냥 중에는 자주) — 그림에 드러나는 것이 바뀌었을 때만 다시 그린다
	local last = ""
	function view.refresh()
		local me = ctx.me()
		local level = if me then me.level else 1
		local parts = { rid, tostring(picked), tostring(ctx.scene()), tostring(level) }
		local marks = WM.marks(rid, ctx.quests() or {}, level)
		for _, n in WM.region(rid).nodes do
			table.insert(parts, marks[n.id] or "-")
		end
		local card = WM.goalCard(ctx.quests() or {}, level, ctx.scene(), if ctx.navi then ctx.navi() else nil, if ctx.daily then ctx.daily() else nil)
		table.insert(parts, if card then card.title .. card.text else "")
		for _, m in MapWindow.partyOf(ctx) do
			table.insert(parts, tostring(m.scene)) -- 파티원이 옮기면 다시 그린다
		end
		local sig = table.concat(parts, "|")
		if sig ~= last then
			last = sig
			view.draw()
		end
	end

	function view.destroy()
		if layer then
			layer:Destroy()
			layer = nil
		end
	end
	return view
end

return MapWindow

end
MODULES['Client/lune/ui/partyWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 파티 창(O · 처음부터 — 2026-10-13에 Lv.10의 문턱을 없앴다) — 위에 파티원(넷까지: 이름 · 레벨 · 파티장 표시)과 「나가기」, 아래에 같은 맵에 있는 사람들과 「초대」.
--  초대 · 나가기는 서버에 부탁한다(Party). 파티 찾기(멀리 있는 사람과 맺기)는 아직 없다. 화면 오른쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Party = require(lune.sim.party)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local W = 300
local LINE = 18 -- 파티원 한 줄
local ROW = Ui.M.button + 4 -- 같은 맵의 사람 한 줄(초대 단추)

local PartyWindow = {}
PartyWindow.NAME_W = W - 80 -- 「Lv.150 이름(열두 자)」가 들어가는 폭 — 넘으면 줄여 적는다
PartyWindow.NEAR = 4 -- 같은 맵의 사람을 몇 줄까지 보이나

function PartyWindow.size(): (number, number)
	return W, 20 + Party.MAX * LINE + 8 + Ui.M.button + 12 + 22 + PartyWindow.NEAR * ROW
end

function PartyWindow.line(level: number, name: string): string
	return ("Lv.%d %s"):format(level, name)
end

function PartyWindow.build(body: Frame, ctx, w: number, _h: number)
	local view = {}
	Ui.text(body, "파티원", 0, 0, 120, { color = C.gold })
	local count = Ui.text(body, "", w - 60, 0, 60, { align = "right", color = C.dim })
	local members = {}
	for i = 1, Party.MAX do
		local y = 20 + (i - 1) * LINE
		members[i] = { name = Ui.text(body, "", 0, y, PartyWindow.NAME_W, { font = "body" }), mark = Ui.text(body, "", w - 70, y + 1, 70, { align = "right", color = C.accent }) }
	end
	local y = 20 + Party.MAX * LINE + 8
	local leave = Ui.button(body, "파티 나가기", 0, y, w, function()
		ctx.send("Party", "leave")
	end)
	y += Ui.M.button + 10
	Ui.line(body, 0, y, w)
	Ui.text(body, "같은 맵의 사람", 0, y + 8, 160, { color = C.gold })
	y += 26
	local near = {}
	for i = 1, PartyWindow.NEAR do
		local ry = y + (i - 1) * ROW
		local row = { name = Ui.text(body, "", 0, ry + 7, PartyWindow.NAME_W, { font = "body" }), id = nil :: any }
		row.button = Ui.button(body, "초대", w - 64, ry, 64, function()
			if row.id then
				ctx.send("Party", "invite", row.id)
			end
		end)
		near[i] = row
	end

	function view.refresh()
		local me, party, myId = ctx.me(), ctx.party(), ctx.myId()
		if not me then
			return
		end
		local list = (party and party.members) or {}
		local inParty = {}
		for i, row in members do
			local m = list[i]
			if m then
				inParty[m.id] = true
				row.name:set(PartyWindow.line(m.level, m.name))
				row.name:color(if m.id == myId then C.text else C.accent)
				row.mark:set(if m.id == party.leader then "파티장" else "")
			else
				row.name:set(if i == 1 and #list == 0 then "파티가 없다" else "")
				row.name:color(C.dim)
				row.mark:set("")
			end
		end
		count:set(("%d / %d"):format(#list, Party.MAX))
		leave:setEnabled(#list > 0)
		-- 초대할 수 있는 사람: 내가 파티장이거나 파티가 없을 때, 자리가 남았을 때
		local canInvite = (#list == 0 or party.leader == myId) and #list < Party.MAX
		local others = {}
		for _, o in ctx.others() do
			if not inParty[o.id] then
				table.insert(others, o)
			end
		end
		for i, row in near do
			local o = others[i]
			row.id = if o then o.id else nil
			row.name:set(if o then PartyWindow.line(o.level, o.name) elseif i == 1 then "아무도 없다" else "")
			row.name:color(if o then C.text else C.dim)
			row.button.frame.Visible = o ~= nil
			row.button:setEnabled(canInvite)
		end
	end
	return view
end

return PartyWindow

end
MODULES['Client/lune/ui/questWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 퀘스트 창(J) — 메이플스토리의 퀘스트 창처럼 탭 셋: 「진행 중」 · 「시작 가능」 · 「완료」(2026-10-11 — 전에는 하는 중인 것 넷만 보였다).
--  위에 그 탭의 목록(메인 · 전직은 노랑), 고르면 아래에 줄거리와 그 탭에 맞는 것:
--   진행 중 = 할 일(다 됐으면 풀빛) · 무엇을 어디서 잡는지 · 보상 · 주민의 부탁은 「포기」(2026-10-18: 그만두기 → 메이플의 낱말)
--   시작 가능 = 누구에게 · 어디서 받는지(「샛별 · 초승달 마을」) · 보상. 레벨이 모자란 다음 메인도 맨 끝에 흐리게 뜬다(「Lv.4가 되면 받는다」)
--   완료 = 줄거리와 받은 보상
--  받는 것과 돌려주는 것은 주민 앞에서 한다(머리 위의 ! · ?). 목록이 줄 수보다 길면 ▲ ▼로 넘긴다.
--  보상은 한 줄에 조각들로: 「경험치 441」 · [달돈 그림] 73 · [물약 그림] x10 · [무기 그림] Lv.30 창 — 아이템은 그 그림과 함께
--   (사용자 2026-10-13: "강화창이랑 퀘스트 보상에 아이템그림 들어가야합니다." — 그 앞에는 「경험치 441 · 달돈 73 · 물약 10」처럼 글뿐이었다)
--  화면 오른쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Quests = require(lune.sim.quests)
local Items = require(lune.sim.items)
local Format = require(lune.ui.format)
local Ui = require(script.Parent.ui)
local ItemCell = require(script.Parent.itemCell)

local C = Ui.COLOR
local ROWS = 5
local ROW = 26 -- 목록의 한 줄
local W = 300
local TAB_H = 22
local TABS = { "진행 중", "시작 가능", "완료" }

local QuestWindow = {}
QuestWindow.ROWS = ROWS
QuestWindow.TABS = TABS
QuestWindow.TEXT_LINES = 5 -- 줄거리가 쓰는 줄 수
QuestWindow.W = W

QuestWindow.DROP, QuestWindow.DROP_SURE, QuestWindow.DROP_WAIT = "포기", "정말 포기", 3 -- 포기 단추 · 한 번 누른 뒤의 글 · 다시 누를 수 있는 초

function QuestWindow.size(): (number, number)
	return W, TAB_H + ROWS * ROW + 12 + QuestWindow.TEXT_LINES * 16 + 8 + 16 + 16 + 20 + Ui.M.button + 4
end

-- 보상의 조각들(왼쪽부터 놓는다) { icon 그림 이름(없으면 글만), text }: 「2차 전직」 · 「경험치 441」 · [달돈] 73 · [물약] x10 · [무기] Lv.30 창
--  물약은 내 레벨에 쓸 수 있는 가장 좋은 것, 장비는 내 직업의 것 · 성능은 보통(sim/hero.luau의 questDone이 주는 그대로)
QuestWindow.REWARD_MAX = 5 -- 조각의 수(전직 · 경험치 · 달돈 · 물약 · 장비)
QuestWindow.REWARD_GAP = 12 -- 조각 사이
QuestWindow.REWARD_ICON = 21 -- 그림(18)과 그 뒤의 글 사이까지
function QuestWindow.rewardParts(reward, level: number, class: string)
	local parts = {}
	if reward.job then
		table.insert(parts, { text = ("%d차 전직"):format(reward.job) })
	end
	if reward.xp > 0 then
		table.insert(parts, { text = ("경험치 %s"):format(Format.short(reward.xp)) })
	end
	if reward.money > 0 then
		table.insert(parts, { icon = "coin", text = Format.short(reward.money) })
	end
	if reward.potions > 0 then
		table.insert(parts, { icon = Items.potionFor(level).icon, text = ("x%d"):format(reward.potions) })
	end
	if (reward.scrolls or 0) > 0 then
		local scroll = Items.goods("scroll_return")
		table.insert(parts, { icon = if scroll then scroll.icon else "scroll", text = ("x%d"):format(reward.scrolls) })
	end
	if (reward.store or 0) > 0 then
		table.insert(parts, { text = ("창고 칸 +%d"):format(reward.store) }) -- 2026-10-18: 창고는 계정의 것(한 번만 늘어난다)
	end
	if reward.gear then
		local it = Items.make(reward.gear.slot, reward.gear.stage, Items.data.NORMAL, class)
		table.insert(parts, { icon = ItemCell.icon(it), text = Items.name(it) })
	end
	return parts
end
-- 조각들의 자리: { { icon = 그림의 x(그림이 없으면 nil), text = 글의 x } … } 와 전체 폭(창의 폭 안이어야 한다 — 자동 검사가 모든 퀘스트 x 직업으로 본다)
function QuestWindow.rewardLayout(parts)
	local at, x = {}, 0
	for i, p in parts do
		local iconX = nil
		if p.icon then
			iconX = x
			x += QuestWindow.REWARD_ICON
		end
		at[i] = { icon = iconX, text = x }
		x += Ui.measure(p.text) + (if i < #parts then QuestWindow.REWARD_GAP else 0)
	end
	return at, x
end

-- 그 탭의 목록(퀘스트의 이름표들). tab = 1 진행 중 · 2 시작 가능 · 3 완료
function QuestWindow.listOf(tab: number, book, level: number): { string }
	if tab == 2 then
		return Quests.listOpen(book, level)
	elseif tab == 3 then
		return Quests.listDone(book)
	end
	return Quests.active(book)
end

-- 「시작 가능」에서 고른 퀘스트의 받는 곳: 「샛별 · 초승달 마을」
function QuestWindow.giverText(def, names): string
	local who = (names and names[def.giver]) or "주민"
	local place = Quests.giverPlace(def)
	return if place then ("받는 곳: %s · %s"):format(who, place) else ("받는 곳: %s"):format(who)
end

function QuestWindow.build(body: Frame, ctx, w: number, _h: number)
	local view = {}
	local tab = 1
	local selected: { string? } = { nil, nil, nil } -- 탭마다 고른 퀘스트
	local top = 0 -- 목록의 첫 줄(넘긴 수)
	local tabs = {}
	local tx = 0
	for i, name in TABS do
		tabs[i] = Ui.tab(body, name, tx, 0, function()
			if tab ~= i then
				tab = i
				top = 0
				view.refresh()
			end
		end)
		tx += tabs[i].width + 16
	end
	local up = Ui.button(body, "▲", w - 38, -3, 17, function()
		top = math.max(0, top - 1)
		view.refresh()
	end, { h = 17 })
	local down = Ui.button(body, "▼", w - 17, -3, 17, function()
		top += 1
		view.refresh()
	end, { h = 17 })
	local rows = {}
	-- 목록: 고른 줄은 왼쪽에 민트 줄, 이름은 본문 글씨(메인 · 전직은 노랑 · 아직 못 받는 것은 흐리게)
	for i = 1, ROWS do
		local y = TAB_H + (i - 1) * ROW
		local frame = Ui.group(body, 0, y, w, ROW - 2, "Row" .. i)
		local back = Ui.box(frame, 0, 0, w, ROW - 2, C.panel2, 1)
		local mark = Ui.box(frame, 0, 0, 2, ROW - 2, C.accent)
		local name = Ui.text(frame, "", 10, 6, w - 70, { font = "body" })
		local lv = Ui.text(frame, "", w - 56, 7, 50, { align = "right", color = C.dim })
		local row = { id = nil :: string?, frame = frame, back = back, mark = mark, name = name, lv = lv }
		Ui.hit(frame).Activated:Connect(function()
			selected[tab] = row.id
			view.refresh()
		end)
		rows[i] = row
	end
	local y = TAB_H + ROWS * ROW + 4
	Ui.line(body, 0, y, w)
	local text = Ui.text(body, "", 0, y + 8, w, { lines = QuestWindow.TEXT_LINES, line = 16, color = C.dim })
	y += 8 + QuestWindow.TEXT_LINES * 16 + 8
	local todo = Ui.text(body, "", 0, y, w)
	-- 할 일 아래에: 무엇을 어디서 잡아야 하는지(사용자 2026-10-07: "뭘잡아야 갑옷조각이 나오는지를 자연스럽게 적어둬야")
	local where = Ui.text(body, "", 0, y + 16, w, { color = C.accent })
	-- 보상: 조각들을 왼쪽부터 — 아이템은 그 그림(18x18)과 글, 경험치 · 전직은 글만
	local ry = y + 33
	local rewards = {}
	for i = 1, QuestWindow.REWARD_MAX do
		rewards[i] = { icon = Ui.smallIcon(body, "coin", 0, ry), text = Ui.text(body, "", 0, ry + 4, w, { color = C.gold }) }
	end
	local function showReward(reward, level: number, class: string)
		local parts = if reward then QuestWindow.rewardParts(reward, level, class) else {}
		local at = QuestWindow.rewardLayout(parts)
		for i, slot in rewards do
			local p = parts[i]
			Ui.setWorldIcon(slot.icon, if p then p.icon else nil)
			slot.text:set(if p then p.text else "")
			if p then
				if at[i].icon then
					slot.icon.Position = UDim2.fromOffset(at[i].icon, ry)
				end
				slot.text:move(at[i].text, ry + 4)
			end
		end
	end
	-- 포기: 모은 것이 사라지므로 한 번 더 묻는다 — 누르면 「정말 포기」로 바뀌고, 3초 안에 다시 누르면 포기한다(2026-10-18 — 전에는 한 번에 사라졌다)
	local armed: { id: string, at: number }? = nil
	local drop
	drop = Ui.button(body, QuestWindow.DROP, w - 100, y + 54, 100, function()
		if tab == 1 and selected[1] then
			if armed and armed.id == selected[1] and os.clock() - armed.at <= QuestWindow.DROP_WAIT then
				armed = nil
				drop:setText(QuestWindow.DROP)
				ctx.send("Quest", "drop", selected[1])
				selected[1] = nil
			else
				local mine = { id = selected[1], at = os.clock() }
				armed = mine
				drop:setText(QuestWindow.DROP_SURE)
				task.delay(QuestWindow.DROP_WAIT, function()
					if armed == mine then
						armed = nil
						drop:setText(QuestWindow.DROP)
					end
				end)
			end
		end
	end)
	function view.refresh()
		if armed and (tab ~= 1 or armed.id ~= selected[1]) then
			armed = nil -- 다른 퀘스트를 골랐다: 「정말 포기」를 되돌린다
			drop:setText(QuestWindow.DROP)
		end
		local book = ctx.quests() or {}
		local me = ctx.me()
		local level = if me then me.level else 1
		local class = if me then me.class else "axion"
		local list = QuestWindow.listOf(tab, book, level)
		for i, t in tabs do
			t:setOn(i == tab)
		end
		-- 고른 것이 목록에서 빠졌으면(돌려줬다 · 받았다) 첫 줄을 고른다
		if selected[tab] and not table.find(list, selected[tab] :: string) then
			selected[tab] = nil
		end
		selected[tab] = selected[tab] or list[1]
		top = math.clamp(top, 0, math.max(0, #list - ROWS))
		up.frame.Visible = #list > ROWS
		down.frame.Visible = #list > ROWS
		up:setEnabled(top > 0)
		down:setEnabled(top < #list - ROWS)
		for i, row in rows do
			local id = list[top + i]
			row.id = id
			row.frame.Visible = id ~= nil
			if id then
				local def = Quests.def(id)
				local on = id == selected[tab]
				local locked = tab == 2 and Quests.state(book, level, id) == "locked"
				row.name:set(def.name)
				row.name:color(if locked then C.off elseif def.kind == "side" then C.text else C.gold)
				row.lv:set("Lv." .. def.lv)
				row.lv:color(if locked then C.red else C.dim)
				row.back.BackgroundTransparency = if on then 0 else 1
				row.mark.Visible = on
			end
		end
		local id = selected[tab]
		local def = id and Quests.def(id)
		drop.frame.Visible = false
		if def and tab == 1 then
			text:set(def.text)
			todo:set(table.concat(Quests.todo(book, id, ctx.npcNames()), " · "))
			todo:color(if Quests.isReady(book, id) then C.green else C.text)
			where:set(table.concat(Quests.hints(book, id), " · "))
			where:color(C.accent)
			showReward(def.reward, level, class)
			drop.frame.Visible = def.kind == "side"
		elseif def and tab == 2 then
			local locked = Quests.state(book, level, id) == "locked"
			text:set(def.text)
			todo:set(QuestWindow.giverText(def, ctx.npcNames()))
			todo:color(C.text)
			where:set(if locked then ("Lv.%d가 되면 받는다"):format(def.lv) else "그 주민 앞에서 ↑ 를 눌러 받는다")
			where:color(if locked then C.red else C.accent)
			showReward(def.reward, level, class)
		elseif def then
			text:set(def.text)
			todo:set("끝낸 퀘스트")
			todo:color(C.dim)
			where:set("")
			showReward(def.reward, level, class)
		else
			text:set(if tab == 1
				then "하는 중인 퀘스트가 없다. 머리 위에 ! 가 뜬 주민에게 말을 건다."
				elseif tab == 2 then "지금 받을 수 있는 퀘스트가 없다."
				else "아직 끝낸 퀘스트가 없다.")
			todo:set("")
			where:set("")
			showReward(nil, level, class)
		end
	end
	return view
end

return QuestWindow

end
MODULES['Client/lune/ui/quickEdit'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 퀵슬롯 고치기 — 스킬 창이 열려 있는 동안 스킬을 화면 가운데 아래의 칸에 놓는다.
--  사용자 2026-10-07: "스킬키를 단축키에 등록하기 쉬워야합니다. … 드래그앤 드랍으로 배치도 되어야하고, 스킬탭에서 스킬아이콘을 꾹누르거나 클릭하면 퀵슬롯쪽이 반짝거리고 거기서 퀵슬롯을 누르면 배치된다던가"
--  놓는 법 둘(공방의 횡스크롤 시험 탭 — js/lune/luneTab.js와 같다):
--   ① 끌어다 놓기: 스킬 창의 스킬(또는 칸에 놓인 것)을 누른 채 움직이면 그림이 따라오고, 칸 위에서 놓으면 그 칸에 놓인다. 칸끼리는 자리를 바꾸고, 칸 밖에 놓으면 칸에서 빠진다(물약은 빠지지 않는다).
--   ② 눌러서 놓기: 스킬 창의 스킬을 누르면 칸들이 반짝이고, 칸을 누르면 그 칸에 놓인다(터치도 같은 방법). 같은 스킬을 한 번 더 누르거나 다른 데를 누르면 그만둔다.
--  칸끼리 끌어 자리를 바꾸거나 칸 밖에 놓아 빼는 것은 늘 된다(사용자 2026-10-07: "스킬창열었을때 뿐만아니라 평소에도 퀵슬롯에서 드래그앤 드랍으로 자리를 바꿀수 있어야합니다").
--  소비 아이템(물약)은 가방의 소비 탭에서 끌어다 놓는다("인벤토리 열고 소비아이템도 드래그앤 드랍으로 퀵슬롯에 올릴수있어야합니다"). 칸의 셈은 shared/lune/ui/quick.luau, 그리는 것은 hud.luau.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Quick = require(ReplicatedStorage.shared.lune.ui.quick)
local Layout = require(ReplicatedStorage.shared.lune.ui.layout)
local Stage = require(script.Parent.Parent.stage)
local Hud = require(script.Parent.Parent.hud)
local Ui = require(script.Parent.ui)

local SLOT = Layout.SKILLS.slot
local DRAG = Quick.DATA.drag -- 이만큼 움직이면 끌기로 본다(화면 틀의 점)

local QuickEdit = {}

local hooks = nil -- { slots() → 지금 칸들, apply(새 칸들), state(id) → "ok" · "passive" · "unlearned", changed() }
local open = false -- 놓을 것을 고르는 창(스킬 창 · 가방)이 열려 있다
local picked: string? = nil -- 놓으려고 고른 스킬
local pending = nil -- 누르고 있는 것 { what, from(칸 · 스킬 창에서 온 것이면 nil), start, input, moved, ghost, extra }
-- 가방의 칸에서 끄는 것(ui/bagWindow.luau)도 여기서 맡는다 — 끌기는 한 번에 하나뿐이다. extra = { icon(게임 세계의 그림 이름), size(끌려오는 그림의 한 변),
--   onMove(at) 움직일 때마다, onDrop(at) → 여기서 받았으면 true(그러면 퀵슬롯에는 놓지 않는다), onEnd() 끝났다(놓았든 그만뒀든) }.
--   what이 nil이면(장비 · 기타 아이템) 퀵슬롯에는 놓이지 않고 extra의 일만 한다

local function isPress(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function paint()
	Hud.setPick(picked ~= nil or (pending ~= nil and pending.moved and pending.what ~= nil))
	if hooks.changed then
		hooks.changed()
	end
end

-- 놓으려고 고른 스킬(없으면 nil)
function QuickEdit.picked(): string?
	return picked
end

-- 지금 무엇을 끌고 있는가(누른 채 움직이기 시작했다) — 끌기를 끝낼 때 함께 오는 "눌렀다"를 창이 가려낼 때 쓴다
function QuickEdit.dragging(): boolean
	return pending ~= nil and pending.moved
end

-- 스킬을 고른다: 칸들이 반짝인다. 같은 것을 한 번 더 고르면 그만둔다. nil = 그만둔다
function QuickEdit.pick(id: string?)
	if id ~= nil and (not open or (not Quick.item(id) and hooks.state(id) ~= "ok") or picked == id) then
		id = nil
	end
	if picked ~= id then
		picked = id
		paint()
	end
end

-- 그 스킬이 놓인 칸의 키 이름(없으면 nil)과 놓을 수 있는지
function QuickEdit.info(id: string, kind: string?)
	local i = Quick.find(hooks.slots(), id)
	return { state = hooks.state(id, kind), key = if i then (if Hud.touch then "단추" else Hud.slotKey(i)) else nil } -- 스마트폰: 칸에 키가 없다
end

-- 끌던 것(p)을 놓았다: 칸 위면 그 칸에(칸에서 온 것이면 자리를 바꾼다), 칸 밖이면 칸에서 온 것은 빠진다
local function drop(p, at: Vector2)
	if p.extra and p.extra.onDrop and p.extra.onDrop(at) then
		return -- 가방의 칸에 놓았다
	end
	if not p.what then
		return
	end
	local j = Hud.slotAt(at)
	local slots = hooks.slots()
	local next = nil
	if j then
		next = Quick.place(slots, p.what, j)
	elseif p.from then
		next = Quick.clear(slots, p.from)
	end
	if next then
		hooks.apply(next)
	end
end

-- 누르던 것을 끝낸다. at = 뗀 자리(없으면 그만둔 것 — 놓지 않는다)
local function finish(at: Vector2?)
	local p = pending
	pending = nil
	if not p then
		return
	end
	if p.ghost then
		p.ghost:Destroy()
	end
	if p.moved then
		if at then
			drop(p, at)
		end
		picked = nil
		Hud.setHot(nil)
		paint()
	end
	if p.extra and p.extra.onEnd then
		p.extra.onEnd()
	end
end

-- 누르기 시작했다(끌기가 될 수도 있다). what = 스킬 · 소비 아이템의 이름표(가방의 장비 · 기타 아이템이면 nil), from = 칸(창에서 온 것이면 nil), extra = 가방의 칸에서 끌 때(위의 설명)
function QuickEdit.press(what: string?, from: number?, input: InputObject, extra: any)
	if not isPress(input) or (what == nil and extra == nil) then
		return
	end
	if what ~= nil and from == nil and not Quick.item(what) and hooks.state(what) ~= "ok" then
		return
	end
	finish(nil)
	pending = { what = what, from = from, start = Vector2.new(input.Position.X, input.Position.Y), input = input, moved = false, ghost = nil, extra = extra, t0 = os.clock() }
end

-- 스킬 창이 열렸다 · 닫혔다: 닫히면 고르던 것 · 끌던 것을 그만둔다
function QuickEdit.setOpen(on: boolean)
	if open == on then
		return
	end
	open = on
	if not on then
		finish(nil)
		picked = nil
	end
	Hud.setPick(picked ~= nil)
end

function QuickEdit.init(h)
	hooks = h
	-- 칸을 눌렀다: 고른 스킬이 있으면 그 칸에 놓는다
	Hud.onSlotClick = function(i: number)
		if open and picked then
			local next = Quick.place(hooks.slots(), picked, i)
			picked = nil
			if next then
				hooks.apply(next)
			end
			paint()
		end
	end
	-- 칸을 누르기 시작했다: 놓인 것이 있으면 끌 수 있다
	Hud.onSlotPress = function(i: number, input: InputObject)
		local what = hooks.slots()[i]
		if what then
			QuickEdit.press(what, i, input) -- 칸의 것은 늘 끌 수 있다
		end
	end
	UserInputService.InputChanged:Connect(function(input)
		local p = pending
		if not p then
			return
		end
		local mouse = input.UserInputType == Enum.UserInputType.MouseMovement and p.input.UserInputType == Enum.UserInputType.MouseButton1
		if not mouse and input ~= p.input then
			return
		end
		local at = Vector2.new(input.Position.X, input.Position.Y)
		if not p.moved and (at - p.start).Magnitude > DRAG * Stage.uiScale then
			-- 스마트폰에서 스크롤 틀 안의 칸(가방 — extra.hold): 잠깐 누르고 있지 않고 바로 밀었으면 끌기가 아니라 스크롤이다(2026-10-15)
			if p.extra and p.extra.hold and p.input.UserInputType == Enum.UserInputType.Touch and os.clock() - (p.t0 or 0) < p.extra.hold then
				pending = nil
				return
			end
			-- 끌기 시작: 그림이 마우스를 따라오고 칸들이 반짝인다
			p.moved = true
			if p.extra and p.extra.onStart then
				p.extra.onStart()
			end
			picked = nil
			local size = if p.extra and p.extra.size then p.extra.size else SLOT
			local ghost = Ui.group(Stage.ui, 0, 0, size, size, "DragGhost")
			ghost.ZIndex = 400
			Ui.slot(ghost, 0, 0, size):setOn(true)
			if p.extra and p.extra.icon then
				Ui.worldIcon(ghost, p.extra.icon, 0, 0, size).ZIndex = 2 -- 가방의 것: 칸에 놓인 그 그림(게임의 굵은 도트)
			else
				local pad = math.floor((size - Ui.M.pic) / 2)
				Ui.pic(ghost, Quick.pic(p.what), pad, pad).ZIndex = 2
			end
			p.ghost, p.size = ghost, size
			paint()
		end
		if p.moved then
			local origin = Stage.ui.AbsolutePosition
			p.ghost.Position = UDim2.fromOffset(math.floor((at.X - origin.X) / Stage.uiScale - p.size / 2 + 0.5), math.floor((at.Y - origin.Y) / Stage.uiScale - p.size / 2 + 0.5))
			Hud.setHot(if p.what then Hud.slotAt(at) else nil)
			if p.extra and p.extra.onMove then
				p.extra.onMove(at)
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		local p = pending
		-- 손가락은 그 손가락만(2026-10-18 검토: 끄는 중에 조이스틱의 손가락을 떼면 거기에 놓였다) · 마우스는 단추가 같으면
		if p and isPress(input) and (input == p.input or (input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType == p.input.UserInputType)) then
			finish(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		finish(nil)
	end)
end

return QuickEdit

end
MODULES['Client/lune/ui/riftWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 수정 틈 토벌 창 — 은달 항구 달맞이 광장의 토벌대장 무진 앞에서 ↑(2026-10-16 — 공방 design/city.js의 RIFT).
--  머리글(「수정 틈 토벌」 · 「오늘 보상 n/2」) 아래에 단계마다 한 칸: 이름(본문 글씨) · 「Lv.30부터」(못 들어가면 빨강) · 오른쪽 「입장」 /
--  그 아래 몬스터들(마지막 = 「정예 ○○」) · 완료 보상(경험치 · [달돈] · [달가루] · 「장비 25%」). 맨 아래 안내 한 줄(파티원이 함께 · 제한 시간 — 들어가지 못한 까닭).
--  들어가기는 서버가 정한다(ctx.riftDo → world.luau의 onRift). 모양은 공방 시험 탭의 js/lune/ui/paint.js(paintRift)와 같다.
--  화면 오른쪽의 옆 판(ui/windows.luau). 토벌대장에게서 멀어지면 닫힌다(boot.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Rift = require(lune.sim.rift)
local COMBAT = require(lune.data["combat.generated"])
local Format = require(lune.ui.format)
local Layout = require(lune.ui.layout)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local S = Layout.RIFT
local D = Rift.DATA
local W = D.words
local XP = "경험치"

local RiftWindow = {}

function RiftWindow.size(): (number, number)
	return S.w, S.top + #D.tiers * S.row + S.footY + Ui.M.small + 4
end

-- 단계의 몬스터들: 「수정싹 그루터기 · 수정 달팽이 · 이끼 두꺼비 · 정예 수정 거미」
function RiftWindow.mobsText(t): string
	local names = {}
	for i, kind in t.kinds do
		local def = COMBAT.mobs[kind]
		local name = if def then def.name else kind
		table.insert(names, if i == #t.kinds then D.elite.name .. " " .. name else name)
	end
	return table.concat(names, " · ")
end

function RiftWindow.build(body: Frame, ctx, w: number, _h: number)
	local view = {}
	Ui.text(body, W.head, 0, 2, w, { color = C.gold })
	local left = Ui.text(body, "", 0, 2, w, { align = "right", color = C.accent })
	local rows = {}
	local entering = false -- 「입장」의 답을 기다리는 중
	for i, t in D.tiers do
		local y = S.top + (i - 1) * S.row
		local by = y - 3 -- 「입장」은 이름 줄의 오른쪽(아래 두 줄 = 몬스터 · 보상이 창의 폭을 다 쓴다)
		if i > 1 then
			Ui.line(body, 0, y - 6, w)
		end
		local row = {}
		local nameW = math.min(Ui.measure(t.name, "body"), w - S.btnW - 76)
		row.name = Ui.text(body, t.name, 0, y, nameW + 2, { font = "body" })
		row.need = Ui.text(body, Format.fill(W.need, { lv = t.lv }), nameW + 8, y + 2, 64, { color = C.dim })
		row.button = Ui.button(body, W.enter, w - S.btnW, by, S.btnW, function()
			if entering then
				return -- 답을 기다리는 중(두 번 눌러 방에 든 뒤 「토벌대장 앞에서 …」가 뜨지 않게 — 2026-10-18 검토)
			end
			entering = true
			ctx.riftDo("enter", t.id)
			entering = false
		end, { main = true })
		local my = by + Ui.M.button + 3
		Ui.text(body, RiftWindow.mobsText(t), 0, my, w, { color = C.dim })
		local py = my + 16
		-- 완료 보상: 경험치 · [달돈] · [달가루] · 장비 n%
		local xpText = ("%s %s"):format(XP, Format.short(t.pay.xp))
		local x = 0
		Ui.text(body, xpText, x, py, w, { color = C.gold })
		x += Ui.measure(xpText) + 10
		Ui.smallIcon(body, "coin", x - 3, py - 4)
		x += 16
		local money = Format.short(t.pay.money)
		Ui.text(body, money, x, py, w - x, { color = C.gold })
		x += Ui.measure(money) + 10
		Ui.smallIcon(body, "dust", x - 3, py - 4)
		x += 16
		local dust = Format.short(t.pay.dust)
		Ui.text(body, dust, x, py, w - x, { color = C.gold })
		x += Ui.measure(dust) + 10
		Ui.text(body, Format.fill(W.gear, { p = math.floor(t.pay.gear * 100 + 0.5) }), x, py, w - x, { color = C.gold })
		rows[i] = row
	end
	local fy = S.top + #D.tiers * S.row - 6
	Ui.line(body, 0, fy, w)
	local note = Ui.text(body, "", 0, fy + S.footY, w, { color = C.dim })
	local base = ("%s · %s"):format(W.party, Format.fill(W.time, { m = math.floor(D.time / 60) }))

	function view.refresh()
		local me = ctx.me()
		local level = if me then me.level else 1
		local got = ctx.rift()
		local n = if got then got.left else D.perDay
		left:set(Format.fill(W.left, { n = n, max = D.perDay }))
		left:color(if n > 0 then C.accent else C.dim)
		for i, t in D.tiers do
			local open = level >= t.lv
			rows[i].name:color(if open then C.text else C.dim)
			rows[i].need:color(if open then C.dim else C.red)
			rows[i].button:setEnabled(open)
		end
		local why = got and got.why
		note:set(if why then why elseif n <= 0 then W.noPay else base)
		note:color(if why then C.red else C.dim)
	end
	view.refresh()
	return view
end

return RiftWindow

end
MODULES['Client/lune/ui/shopWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 상점 · 창고 창 — 주민에게 말을 걸면 가방과 나란히 뜬다(공방 「기본 · UI」 탭). arg = 누구의 것인가:
--   "merchant" 잡화 상인(물약 · 귀환 주문서 · Lv.1 방어구 · 달가루) · "store" 창고지기(맡겨 둔 것). 대장장이는 상점이 없다(2026-10-15 — 제작 · 강화는 ui/forgeWindow.luau)
--  값과 물건은 공방 설계 자료(js/lune/design/items.js의 STOCK)에서 온다. 사고 팔고 맡기는 것은 서버에 부탁한다(Item).
--  사용자 2026-10-08: "소비, 기타아이템도 창고에 맡길수있어야하고, 상점에 팔기 가능해야하고 묶음나누기 가능해야하고 창고에 드래그앤 드랍으로 맡기기가능해야합니다."
--   · 창고는 가방과 같은 짜임이다: 탭 셋(장비 · 소비 · 기타) · 탭마다 칸 여섯 x 넷. 가방의 것을 끌어다 창고의 칸에 놓으면 맡겨지고(놓은 칸에 — 묶음은 전부),
--     창고의 것을 끌어다 가방에 놓으면 찾아진다. 창고 안에서도 끌어서 옮기고 「정렬」한다. 칸을 누르면 상세 판(「찾기」 — 묶음은 몇 개를 찾을지 고른다), 두 번 누르면 전부 찾는다.
--   · 상점: 가방의 것을 끌어다 상점 창에 놓으면 팔지 묻는다(가방의 상세 판에 — ui/bagWindow.luau). 상세 판의 「팔기」도 같은 일이다.
--  사용자 2026-10-13: "대장간 장비제작이나, 상점에서 소비템 구매하는거나  메이플스토리처럼 아이템 아이콘이 보여야합니다"
--   · 상점의 줄마다 그 물건의 그림(가방의 그 그림 — 칸 안에) · 값 앞에 달돈 그림. 제작의 줄마다 만들 장비의 그림과 재료의 그림(그 앞에는 글뿐이었다).
--     자리는 공방 시험 탭의 js/lune/ui/paint.js(paintShop · paintCraft)와 같다 — 치수는 공방 설계 자료(UILAYOUT.shop · craft).
--  화면 오른쪽 · 왼쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Items = require(lune.sim.items)
local Bag = require(lune.sim.bag)
local ItemInfo = require(lune.ui.itemInfo)
local Format = require(lune.ui.format)
local Layout = require(lune.ui.layout) -- 치수(자동 검사가 같은 값을 본다)
local WORDS = require(lune.data["ui.generated"]).words
local Stage = require(script.Parent.Parent.stage)
local Ui = require(script.Parent.ui)
local ItemCell = require(script.Parent.itemCell)
local BagWindow = require(script.Parent.bagWindow)
local ItemDetail = require(script.Parent.itemDetail)
local Windows = require(script.Parent.windows)

local C = Ui.COLOR
local D = Items.data
local COLS = Layout.BAG.cols -- 창고의 칸: 가방과 같은 여섯 칸
local BAR = 3 -- 늘린 창고의 스크롤 막대 두께(가방 창과 같다 — 2026-10-18)
local HOLD = 0.3 -- 스마트폰: 잠깐 누르고 있다가 밀어야 끈다(그 전에 밀면 스크롤 — 가방 창과 같은 값)
