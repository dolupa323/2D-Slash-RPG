	expect(hb.alive and s.scene == SCENES.start, "돌아올 곳이 깨졌으면 시작 마을 — " .. tostring(bad) .. " → " .. tostring(s.scene))
end

-- ---- 3) 다시 들어오면 마지막으로 있던 맵에서(2026-10-16 밤 — 사용자: "게임을 시작하면 항상 초승달마을에서 시작합니다") ----
--  메이플처럼 나갔던 맵의 시작 자리 · 배 위였으면 닿는 곳 · 토벌의 방 · 스토리 보스의 방 · 꿈이면 그 맵에서 가장 가까운 마을 · 없어진 맵이면 마지막 마을
do
	local Voyage = req("ReplicatedStorage/shared/lune/sim/voyage")
	local p2 = { UserId = 4102, Name = "길손4102", attrs = {}, SetAttribute = function(self, k, v) self.attrs[k] = v end }
	handlers.Ready(p2)
	local mk = handlers.Chars(p2, "create", "길손4102", "axion")
	handlers.Chars(p2, "enter", mk.id)
	local s2 = World.session(p2)
	World.wake(p2) -- 꿈에서 깬다(튜토리얼을 마친다)
	local function relog(prep: () -> ()?)
		if prep then
			prep()
		end
		World.removePlayer(p2) -- 저장하고 나간다
		handlers.Ready(p2)
		return handlers.Chars(p2, "enter", mk.id), World.session(p2)
	end
	-- 첫 퀘스트를 끝낸 캐릭터로(새 캐릭터는 사당에서 시작한다)
	local Q = req("ReplicatedStorage/shared/lune/sim/quests")
	local firstId = Q.FIRST and Q.FIRST.quest or nil
	if firstId then
		s2.hero.quests[firstId] = { done = true, c = {} }
	end
	Hero.setLevel(s2.hero, 30)
	World.jump(p2, "r1bv")
	World.jump(p2, "r1b3")
	local got, ss = relog()
	eq(ss.scene, "r1b3", "나갔던 사냥터(무너진 다리)에서 다시 시작한다")
	eq(got.scene, "r1b3", "화면에도 그 장면")
	eq(ss.hero.x, SCENES.scenes.r1b3.spawn.x, "그 맵의 시작 자리")
	World.jump(p2, "ct_inn")
	got, ss = relog()
	eq(ss.scene, "ct_inn", "건물 안(여관)에서 나갔으면 그 안에서")
	local r = Voyage.route("town", "captain")
	got, ss = relog(function()
		World.jump(p2, r.ship)
	end)
	eq(ss.scene, r.to, "배 위에서 나갔으면 배가 닿는 곳(은달 항구)")
	eq(ss.hero.x, r.at[1] * SCENES.tile, "부두의 내리는 자리")
	got, ss = relog(function()
		World.jump(p2, "rf1#9")
	end)
	eq(ss.scene, SCENES.scenes.rf1.ret, "토벌의 방에서 나갔으면 가장 가까운 마을(은달 항구)")
	got, ss = relog(function()
		World.jump(p2, "r1c4")
	end)
	expect(ss.scene == SCENES.scenes.r1c4.ret and SCENES.homes[ss.scene], "스토리 보스의 방에서 나갔으면 가장 가까운 마을 — " .. tostring(ss.scene))
	got, ss = relog(function()
		World.jump(p2, "r2bs")
		s2 = World.session(p2)
		s2.hero.last = "nowhere_old_map"
	end)
	eq(ss.scene, "r2bs", "없어진 맵이면 마지막으로 들른 마을(기사단 본당)")
	got, ss = relog(function()
		World.session(p2).hero.last = nil
	end)
	eq(ss.scene, "r2bs", "마지막 맵이 없는 옛 저장 = 마지막으로 들른 마을")
	-- 뺀 맵(반달 나루 r2t — 2026-10-16 밤)에 남은 저장: 마지막 맵 · 마지막으로 들른 마을 = 그 자리를 대신하는 은달 항구(scenes의 gone)
	got, ss = relog(function()
		local h = World.session(p2).hero
		h.last, h.home = "r2t", "r2t"
	end)
	eq(ss.scene, "ct", "반달 나루에서 나간 저장은 은달 항구에서 시작한다")
	eq(ss.hero.home, "ct", "마지막으로 들른 마을(반달 나루)도 은달 항구로")
	local packed2 = Hero.pack(ss.hero)
	expect(typeof(packed2.last) == "string", "저장에 마지막 맵이 들어간다")
	World.removePlayer(p2)
end

end)
runTest('32_lune_lock', function()
-- 「달의 계승자」 — 계정의 잠금: 같은 계정이 두 서버에 동시에 들어와 저장을 서로 덮어쓰지 못하게(아이템 복사를 막는다).
--  server/lune/modules/store.luau의 Store.lock · unlock, world.luau의 addPlayer · saveAll · removePlayer · stop.

-- ---- 1) 저장소의 잠금(가짜 DataStore 위에서 — 두 서버인 척한다: Store.JOB) ----
local data = {}
local fake = {
	GetAsync = function(_, key)
		return data[key]
	end,
	SetAsync = function(_, key, value)
		data[key] = value
	end,
	UpdateAsync = function(_, key, fn)
		local value = fn(data[key])
		if value ~= nil then
			data[key] = value
		end
	end,
}
SERVICE("DataStoreService", {
	GetDataStore = function()
		return fake
	end,
	GetOrderedDataStore = function()
		return fake
	end,
})
local Store = req("ServerScriptService/server/lune/modules/store")
expect(Store.LOCK_TTL >= 120 and Store.LOCK_TTL <= 300, "잠금은 새로 고치는 간격(60초)의 두 배를 넘겨야 죽은 것으로 본다 " .. Store.LOCK_TTL)
Store.JOB = "서버A"
expect(Store.lock(7) == true, "아무도 잡지 않은 계정은 잡는다")
local t0 = data.lock_7 and data.lock_7.at -- 서버의 시계(검사에서는 가짜 시계)로 잡은 때
expect(data.lock_7 ~= nil and data.lock_7.job == "서버A" and typeof(t0) == "number" and t0 > 0, "누가 언제 잡았는지 적힌다")
expect(Store.lock(7) == true, "제가 잡은 것은 다시 잡는다(새로 고친다)")
Store.JOB = "서버B"
expect(Store.lock(7) == false, "다른 서버가 잡고 있으면 못 잡는다")
eq(data.lock_7.job, "서버A", "잠금은 그대로 A의 것이다")
Store.unlock(7)
eq(data.lock_7.job, "서버A", "남의 잠금은 풀지 못한다")
expect(data.lock_7.at == t0, "남의 잠금의 시간도 건드리지 않는다")
-- A가 죽었다(새로 고치지 않은 지 오래다): B가 넘겨받는다
data.lock_7.at = t0 - Store.LOCK_TTL - 1
expect(Store.lock(7) == true, "오래 새로 고쳐지지 않은 잠금은 넘겨받는다")
eq(data.lock_7.job, "서버B", "이제 B의 것이다")
Store.JOB = "서버A"
expect(Store.lock(7) == false, "되살아난 A는 못 잡는다(저장하면 안 된다)")
-- B가 나간다: 풀고 나면 A가 바로 잡는다
Store.JOB = "서버B"
Store.unlock(7)
expect(data.lock_7.at == 0, "푼 잠금은 지난 것으로 적힌다")
Store.JOB = "서버A"
expect(Store.lock(7) == true, "풀린 계정은 바로 잡는다")
-- 계정마다 따로다
Store.JOB = "서버B"
expect(Store.lock(8) == true and Store.lock(7) == false, "다른 계정의 잠금은 서로 상관없다")
Store.JOB = nil

-- ---- 2) 서버: 잠긴 계정은 읽지 않고 내보낸다 · 저장하기 전에 다시 본다 · 나갈 때 푼다 ----
local handlers = {}
MOCK("ReplicatedStorage/shared/lune/net/net", {
	FireClient = function() end,
	OnServer = function(name, fn)
		handlers[name] = fn
	end,
})
local function signal()
	return { Connect = function() end }
end
SERVICE("Players", { PlayerAdded = signal(), PlayerRemoving = signal(), GetPlayers = function() return {} end })
SERVICE("RunService", { Heartbeat = signal() })
SERVICE("TextService", { FilterStringAsync = function(_, text) return { GetNonChatStringForBroadcastAsync = function() return text end } end })
local disk, names = {}, {}
local free = {} -- [계정] = 이 서버가 잡을 수 있는가(false = 다른 서버의 것)
local asked, saved, unlocked = {}, {}, {}
MOCK("ServerScriptService/server/lune/modules/store", {
	lock = function(id)
		asked[id] = (asked[id] or 0) + 1
		return free[id] ~= false
	end,
	unlock = function(id)
