				end, { h = 20, font = "small", main = i == placeGroup }).frame.Name = "Do_group_" .. g.id
				gx += bwidth + 3
			end
			local top = gy + 28
			local list = groups[placeGroup].list
			local per = AdminWindow.PER_PAGE
			local pages = math.max(1, math.ceil(#list / per))
			placePage = math.clamp(placePage, 1, pages)
			for i = 1, per do
				local at = list[(placePage - 1) * per + i]
				if at then
					local col, line = (i - 1) % 3, math.floor((i - 1) / 3)
					Ui.button(p, at.name, col * 119, top + line * 26, 116, function()
						ask("goto", at.key)
					end, { h = 22, font = "small" }).frame.Name = "Do_goto_" .. at.key
				end
			end
			if pages > 1 then
				Ui.text(p, ("%d / %d"):format(placePage, pages), 0, top + 5 * 26 + 6, 60, { color = C.dim })
				Ui.button(p, "다음 쪽", w - 60, top + 5 * 26, 60, function()
					placePage = placePage % pages + 1
					view.draw()
				end, { h = 22, font = "small" }).frame.Name = "Do_placeNext"
			end
		else
			y = row(p, y, "체력", { { text = "가득 채우기(쓰러졌으면 일어난다)", id = "heal", w = 200, on = function() ask("heal") end } })
			y = row(p, y, "무적", {
				{ text = "켜기", id = "godOn", w = 56, main = on.god == true, on = function() ask("god", true) end },
				{ text = "끄기", id = "godOff", w = 56, main = on.god ~= true, on = function() ask("god", false) end },
			})
			local ds = {}
			for _, v in AdminWindow.DMG do
				table.insert(ds, { text = "x" .. v, id = "dmg" .. v, main = on.dmg == v, on = function() ask("dmg", v) end })
			end
			y = row(p, y, "피해 배율", ds)
			-- 보스의 그림 크기 미리보기(화면 쪽만 — 서버에 묻지 않는다): 받은 동작 그림을 작게 그릴수록 또렷하다. 고른 크기를 알려 주면 설계값(공방 bosses.js의 BOSS_SHOW)으로 굳힌다
			local now = ctx.bossShow and ctx.bossShow() -- 고운 그림이 없으면 nil(이 줄을 그리지 않는다)
			if now then
				local bs = {}
				for _, v in AdminWindow.BOSS_SHOW do
					table.insert(bs, { text = v .. "%", id = "boss" .. v, w = 44, main = now == v, on = function()
						ctx.bossShow(v)
						view.draw()
					end })
				end
				y = row(p, y, "보스 크기", bs)
			end
			Ui.text(p, "배율과 무적은 저장되지 않는다(다시 들어오면 꺼져 있다).", 0, y + 4, w, { color = C.off })
			Ui.text(p, "피해 배율은 보이는 전투력과 순위를 바꾸지 않는다.", 0, y + 18, w, { color = C.off })
			if now then
				Ui.text(p, "보스 크기는 그림만 바꿔 본다(맞는 자리는 그대로).", 0, y + 32, w, { color = C.off })
			end
		end
	end

	-- 내 상태가 오면(레벨 · 배율이 바뀌었다) 다시 그린다
	local last = ""
	function view.refresh(me)
		local a = (me and me.admin) or {}
		local sig = table.concat({ tostring(me and me.level), tostring(me and me.job), tostring(a.xp), tostring(a.dmg), tostring(a.god) }, "|")
		if sig ~= last then
			last = sig
			view.draw()
		end
	end

	function view.destroy()
		alive = false
		if page then
			page:Destroy()
			page = nil
		end
	end
	view.refresh(ctx.me())
	return view
end

return AdminWindow

end
MODULES['Client/lune/ui/bagWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 가방 창 — 화면 오른쪽의 옆 판. 탭 셋(장비 · 소비 · 기타), 세 탭 모두 칸 여섯 x 넷이다(48칸까지 늘리면 ▲▼로 줄을 넘긴다).
--  사용자 2026-10-08: "지금 인벤토리 구조도 잘못되어있는데 … 품목이 고정되어있고 거기서 수량 1/8 이런식으로 표기하는게 인벤토리가 아닙니다."
--  → 가방은 탭마다 진짜 칸이다(공방 js/lune/design/items.js의 BAGPLAY — 셈은 shared/lune/sim/bag.luau):
--   · 칸에는 장비 하나 또는 소비 · 기타 아이템의 묶음(그림과 오른쪽 아래의 수)이 놓인다. 빈 칸은 비어 있고, 놓인 자리는 내가 옮기기 전까지 그대로다.
--   · 칸을 누르면 그 아이템의 상세가 창 옆의 작은 판에 뜬다(ui/itemDetail.luau) — 할 수 있는 일의 단추가 거기 있다:
--     장착 · 분해 / 사용 · 퀵슬롯 · 버리기 · 나누기 / (창고지기 앞) 맡기기 · (상점 앞) 팔기 · (대장장이의 강화 창) 강화.
--     "장비 탭에서 각각의 장비를 선택하면 … 작은모달이 떠서 아이템 스펙이 나와야합니다. 인벤토리에서 선택도 마찬가지입니다. 기타아이템, 소비아이템 모두 마찬가지입니다."
--   · 칸의 것을 끌어 다른 칸에 놓으면 옮겨진다(다른 것이 있으면 자리를 바꾸고, 같은 묶음이면 합친다). 소비 아이템은 끌어 퀵슬롯(스마트폰: 칸 단추)에 놓는다.
--   · 끌어서 창고 창에 놓으면 맡겨지고(놓은 칸에 — 묶음은 전부), 상점 창에 놓으면 팔지 묻는다
--     (사용자 2026-10-08: "소비, 기타아이템도 창고에 맡길수있어야하고, 상점에 팔기 가능해야하고 묶음나누기 가능해야하고 창고에 드래그앤 드랍으로 맡기기가능해야합니다").
--   · 같은 칸을 두 번 누르면 장비는 장착, 소비 아이템은 사용. 「정렬」은 그 탭을 앞에서부터 채운다.
--  달돈 · 달가루 · 정수는 칸을 차지하지 않는다 — 창 아래에 그림과 숫자로(공방 「돈 · 상점」 탭의 가방 규칙).
--  PC · 스마트폰이 같은 창이다: 누르기 = 톡, 끌기 = 누른 채 움직이기, 두 번 누르기 = 톡톡.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Items = require(lune.sim.items)
local Bag = require(lune.sim.bag)
local Format = require(lune.ui.format)
local ItemInfo = require(lune.ui.itemInfo)
local Layout = require(lune.ui.layout) -- 치수(자동 검사가 같은 값을 본다)
local WORDS = require(lune.data["ui.generated"]).words -- 낱말(장착 · 정렬 …) — 공방에서 정한 것
local Stage = require(script.Parent.Parent.stage)
local Ui = require(script.Parent.ui)
local ItemCell = require(script.Parent.itemCell)
local ItemDetail = require(script.Parent.itemDetail)
local Windows = require(script.Parent.windows)

local C = Ui.COLOR
local D = Items.data
local BAG = Layout.BAG
local COLS, ROWS = BAG.cols, BAG.rows
local GRID_Y = BAG.gridY -- 칸들의 윗줄
local KEYS = D.BAG.keys -- 탭의 이름표("gear" · "use" · "etc")
local DOUBLE = 0.4 -- 이 안에 같은 칸을 다시 누르면 두 번 누른 것(초)

local BagWindow = { side = "right" } -- 가방은 늘 오른쪽에 뜬다(같이 열린 창은 왼쪽으로 간다)
BagWindow.COLS, BagWindow.ROWS = COLS, ROWS

function BagWindow.size(): (number, number)
	return Layout.bagBody(Stage.ratio)
end

-- 가방을 늘리는 단추의 글
function BagWindow.growText(cost: number): string
	return ("+%d칸 %s"):format(D.BAG.step, Format.short(cost))
end

-- 그 장비를 지금 낄 수 있는가(화면의 단추를 켜고 끄는 데 쓴다 — 서버가 다시 본다)
function BagWindow.canWear(me, it): boolean
	return not it.broken and (it.slot ~= "weapon" or it.who == me.class) and me.level >= Items.needLevel(it)
end

-- 그림과 숫자(달돈 · 달가루 · 정수). (x, y) = 그림의 왼쪽 위 — 숫자는 그 오른쪽에
local function purse(parent: Instance, icon: string, x: number, y: number, w: number)
	Ui.smallIcon(parent, icon, x, y)
	return Ui.text(parent, "", x + 21, y + 4, w - 21)
end
BagWindow.purse = purse

function BagWindow.build(body: Frame, ctx, w: number, _h: number)
	local ui = ctx.ui
	local S = ItemCell.size()
	local tab = 1
	local top = 0 -- 맨 윗줄이 몇째 줄인가(가방을 늘린 뒤 ▲▼로 넘긴다)
	local sel = nil :: { tab: string, slot: number, id: any }? -- 고른 칸(id = 장비의 번호 · 묶음의 이름표 — 칸의 것이 바뀌면 고른 것을 푼다)
	local ask = nil :: { kind: string, n: number? }? -- 수를 고르는 중(버리기 · 맡기기 · 팔기 · 나누기 — 장비 팔기는 n 없이 묻기만)
	local hot: number? = nil -- 끌던 것을 놓을 칸
	local lastClick = { slot = 0, t = 0 }
	local dragEnd = 0 -- 마지막으로 끌기를 끝낸 때(그 직후에 오는 "눌렀다"는 끌기의 끝이지 누른 것이 아니다)
	local view = {}

	local function key(): string
		return KEYS[tab]
	end
	local function unselect()
		sel, ask = nil, nil
	end
	-- 모든 창을 다시 그린다(상세 판은 하나뿐이라, 여기서 고르면 다른 창이 고른 것은 풀린다)
	local function redraw()
		Windows.refresh(ctx.me())
	end
	local function choose(tabKey: string, slot: number, it)
		sel = { tab = tabKey, slot = slot, id = if it.item then it.item else it.id }
		ask = nil
		ui.detail = "bag"
	end

	local tabs = {}
	local tx = 0
	for i, name in D.BAG.tabs do
		tabs[i] = Ui.tab(body, name, tx, 0, function()
			if tab ~= i then
				tab, top = i, 0
				unselect()
				redraw()
			end
		end)
		tx += tabs[i].width + 16
	end
	local count = Ui.text(body, "", w - BAG.countW, 0, BAG.countW, { align = "right", color = C.dim }) -- 찬 칸 / 가방의 칸
	local up = Ui.button(body, "▲", w - 36, -3, 17, function()
		top = math.max(0, top - 1)
		view.refresh()
	end, { h = 17 })
	local down = Ui.button(body, "▼", w - 17, -3, 17, function()
		top += 1
		view.refresh()
	end, { h = 17 })

	-- 고른 칸의 것으로 할 수 있는 일(상세 판의 단추 · 두 번 누르기가 같이 쓴다)
	local function wear(it)
		ctx.send("Item", "equip", it.id)
		unselect()
	end
	local function use(entry)
		ctx.send("Potion", entry.item)
	end
	-- 팔 때 묻는 것: 장비는 팔지 말지만, 묶음은 몇 개를(처음에는 전부). 팔 수 없는 것(퀘스트의 물건)은 nil
	local function sellAsk(tabKey: string, entry)
		if tabKey == "gear" then
			return { kind = "sellGear" }
		elseif Items.goodsSell(entry.item) > 0 then
			return { kind = "sell", n = entry.n }
		end
		return nil
	end

	local gridRoot = Ui.group(body, 0, GRID_Y, COLS * S, ROWS * S, "Grid")
	local cells = {}
	-- 화면의 그 자리에 있는 칸(가방의 몇째 칸인가 — 없으면 nil). 끌던 것을 놓을 때 쓴다
	local function slotAt(at: Vector2): number?
		local bag = ctx.bag()
		local i = ItemCell.at(cells, at)
		local n = if i then top * COLS + i else nil
		return if n and bag and n <= bag.size then n else nil
	end
	for i = 1, COLS * ROWS do
		local col, row = (i - 1) % COLS, math.floor((i - 1) / COLS)
		local cell
		cell = ItemCell.new(gridRoot, col * S, row * S, function(it)
			local n = top * COLS + i
			local now = os.clock()
			-- 끌어서 놓은 것은 누른 것이 아니다(끌기를 끝낼 때 놓은 자리의 칸에도 "눌렀다"가 온다 — 그대로 받으면 방금 옮긴 것의 고르기가 풀린다)
			if ctx.quick.dragging() or now - dragEnd < 0.2 then
				return
			end
			local twice = it ~= nil and lastClick.slot == n and now - lastClick.t < DOUBLE
			lastClick = { slot = if twice then 0 else n, t = now }
			if not it then
				unselect()
			elseif twice then
				-- 두 번 누르기: 장비는 장착, 소비 아이템은 사용
				local me = ctx.me()
				if key() == "gear" and me and BagWindow.canWear(me, it) then
					wear(it)
				elseif key() == "use" then
					use(it)
				end
			else
				choose(key(), n, it)
			end
			redraw()
		end, S)
		cells[i] = cell
		-- 끌기: 칸의 것을 누른 채 움직이면 그림이 따라온다(ui/quickEdit.luau가 끌기를 맡는다).
		--  가방의 다른 칸 = 옮긴다 · 퀵슬롯 = 소비 아이템을 그 칸에 놓는다 · 창고 창 = 맡긴다 · 상점 창 = 팔지 묻는다
		cell.hit.InputBegan:Connect(function(input)
			local it = cell.item
			if not it then
				return
			end
			local from, tabKey = top * COLS + i, key()
			local moved = false
			ctx.quick.press(if tabKey == "use" then it.item else nil, nil, input, {
				icon = ItemCell.icon(it),
				size = S,
				onMove = function(at: Vector2)
					moved = true
					local to = slotAt(at)
					if hot ~= to then
						hot = to
						view.refresh()
					end
					if ui.storeHover then
						ui.storeHover(at, tabKey) -- 창고의 놓을 칸이 밝아진다
					end
				end,
				onDrop = function(at: Vector2): boolean
					local to = slotAt(at)
					if to and to ~= from then
						ctx.send("Item", "move", tabKey, from, to)
						-- 화면은 바로 옮긴다(서버가 가진 가방이 곧 다시 온다 — 그때 그것으로 맞춘다). 같은 묶음끼리 합치는 것은 서버의 셈을 기다린다
						local bag = ctx.bag()
						local list = if bag then bag[tabKey] else nil
						local a = if list then list[from] else nil
						local b = if list then list[to] else nil
						local merge = tabKey ~= "gear" and a and b and a.item == b.item
						if list and a and not merge then
							list[from], list[to] = b or false, a
						end
						-- 고른 것은 고른 채로 따라간다(합쳐지는 묶음이면 푼다)
						if sel and sel.tab == tabKey and (sel.slot == from or sel.slot == to) then
							if merge then
								unselect()
							else
								sel.slot = if sel.slot == from then to else from
							end
						end
					end
					if to then
						return true -- 가방의 칸에 놓았으면 여기서 끝(퀵슬롯에는 놓지 않는다)
					end
					-- 창고 창 위에 놓았다: 맡긴다(놓은 칸에 — 묶음은 전부)
					if ui.storeDrop and ui.storeDrop(at, tabKey, from) then
						if sel and sel.tab == tabKey and sel.slot == from then
							unselect()
						end
						return true
					end
					-- 상점 창 위에 놓았다: 그것을 고르고 팔지 묻는다(상세 판에 — 팔 수 없는 것이면 상세만 뜬다)
					if ui.shopDrop and ui.shopDrop(at) then
						choose(tabKey, from, it)
						ask = sellAsk(tabKey, it)
						redraw()
						return true
					end
					return false
				end,
				onEnd = function()
					if moved then
						dragEnd = os.clock()
					end
					if ui.storeHover then
						ui.storeHover(nil, nil)
					end
					if hot then
						hot = nil
						view.refresh()
					end
				end,
			})
		end)
	end

	-- 창고에서 끌어 온 것을 놓는 자리(ui/shopWindow.luau의 창고가 묻는다): 가방 창 위인가 · 그 탭의 어느 칸인가.
	--  다른 탭이 열려 있었으면 그 탭으로 넘긴다(찾은 것이 보이게)
	local panel = body.Parent :: GuiObject
	ui.bagDrop = function(at: Vector2, tabKey: string): (boolean, number?)
		if not ItemCell.over(panel, at) then
			return false, nil
		end
		local slot = if tabKey == key() then slotAt(at) else nil
		if tabKey ~= key() then
			tab, top = table.find(KEYS, tabKey) or tab, 0
			unselect()
		end
		return true, slot
	end
	-- 창고에서 「찾기」로 찾았을 때: 가방이 그 탭을 보여 준다(찾은 것이 보이게)
	ui.bagShow = function(tabKey: string)
		if tabKey ~= key() then
			tab, top = table.find(KEYS, tabKey) or tab, 0
			unselect()
		end
	end
	ui.bagHover = function(at: Vector2?, tabKey: string?)
		local to = if at and tabKey == key() then slotAt(at) else nil
		if hot ~= to then
			hot = to
			view.refresh()
		end
	end

	-- 칸 아래: 「정렬」 · 「+4칸 값」, 그 아래 지갑(달돈 · 달가루 · 정수)
	local fy = GRID_Y + ROWS * S + BAG.footY
	local sort = Ui.button(body, WORDS.sort, 0, fy, BAG.sortW, function()
		ctx.send("Item", "sort", key())
		unselect()
		view.refresh()
	end)
	sort.frame.Name = "Sort"
	local grow = Ui.button(body, "", w - BAG.growW, fy, BAG.growW, function()
		ctx.send("Item", "grow")
	end, { font = "small" })
	grow.frame.Name = "Grow"
	Ui.line(body, 0, fy + BAG.purseY - 5, w)
	local pw = Layout.purseW(w)
	local money = purse(body, "coin", -3, fy + BAG.purseY, pw)
	local dust = purse(body, "dust", pw - 3, fy + BAG.purseY, pw)
	local essence = purse(body, "orb", pw * 2 - 3, fy + BAG.purseY, pw)

	-- 고른 것의 상세 판(창 옆)
	local function detail(bag, me)
		if ui.detail ~= "bag" then
			unselect() -- 다른 창에서 골랐다
		end
		local entry = if sel then bag[sel.tab][sel.slot] else nil
		if sel and sel.tab == "gear" and (not entry or entry.id ~= sel.id) then
			-- 고른 장비가 다른 칸으로 갔으면(정렬 · 옮기기) 따라간다
			entry = nil
			for i = 1, bag.size do
				local it = bag.gear[i]
				if it and it.id == sel.id then
					sel.slot, entry = i, it
					break
				end
			end
		elseif sel and sel.tab ~= "gear" and entry and entry.item ~= sel.id then
			entry = nil -- 그 칸에 다른 것이 놓였다(정렬 · 옮기기)
		end
		if not sel or not entry then
			unselect()
			ItemDetail.hide("bag")
			return
		end
		local slot, tabKey, service = sel.slot, sel.tab, ui.service
		local spec = { item = entry, buttons = {}, onClose = function()
			unselect()
			redraw()
		end }
		local function button(text: string, onClick: () -> (), main: boolean?, off: boolean?)
			table.insert(spec.buttons, { text = text, main = main, off = off, onClick = onClick })
		end
		local function stopAsk()
			ask = nil
			view.refresh()
		end
		if tabKey == "gear" then
			local it = entry
			local worn = bag.equip[it.slot]
			local can = BagWindow.canWear(me, it)
			spec.info = ItemInfo.gear(it, me, worn, false)
			if ask and ask.kind == "sellGear" then
				spec.ask = ItemDetail.ask("sellGear", nil, 1, 1, {
					gain = function()
						return Items.sellPrice(it)
					end,
					yes = function()
						ctx.send("Item", "sell", "gear", slot)
						unselect()
						redraw()
					end,
					no = stopAsk,
				})
			else
				ask = nil
				button(WORDS.equip, function()
					wear(it)
					redraw()
				end, true, not can)
				button(WORDS.dismantle, function()
					ctx.send("Item", "dismantle", it.id)
					unselect()
					redraw()
				end)
				if service == "store" then
					button(WORDS.toStore, function()
						ctx.send("Item", "storeIn", "gear", slot)
						if ui.storeShow then
							ui.storeShow("gear") -- 창고가 그 탭을 보여 준다(맡긴 것이 보이게)
						end
						unselect()
						redraw()
					end)
				elseif service == "forge" then
					button(WORDS.toForge, function()
						ctx.toForge(it.id)
					end)
				elseif service == "shop" then
					button(WORDS.sell, function()
						ask = { kind = "sellGear" }
						view.refresh()
					end)
				end
			end
			spec.key = table.concat({ "gear", it.id, it.q, it.star, tostring(it.broken), me.level, if worn then worn.id else 0, if worn then worn.star else 0, service or "-", tostring(can), if ask then ask.kind else "-" }, "|")
		else
			local def = Items.goods(entry.item)
			local have = Bag.countIn(bag, entry.item)
			spec.info = ItemInfo.goods(entry.item, me, have)
			if ask and ask.n then
				-- 수를 고른다: 버리기 · 맡기기 · 팔기는 1 ~ 그 칸의 수, 나누기는 1 ~ 하나를 남긴 수
				local kind = ask.kind
				local hi = if kind == "split" then entry.n - 1 else entry.n
				if hi < 1 then
					ask = nil
				else
					local n = math.clamp(ask.n, 1, hi)
					ask.n = n
					spec.ask = ItemDetail.ask(kind, n, 1, hi, {
						gain = if kind == "sell" then function(count: number)
							return def.sell * count
						end else nil,
						set = function(v: number)
							ask = { kind = kind, n = v }
							view.refresh()
						end,
						yes = function(count: number)
							local action = if kind == "store" then "storeIn" else kind -- "discard" · "sell" · "split"
							ctx.send("Item", action, tabKey, slot, count)
							if kind == "store" and ui.storeShow then
								ui.storeShow(tabKey)
							end
							ask = nil
							redraw()
						end,
						no = stopAsk,
					})
				end
			else
				ask = nil
			end
			if not ask then
				if tabKey == "use" then
					button(WORDS.use, function()
						use(entry)
					end, true, def.lv ~= false and me.level < def.lv)
					button(WORDS.quick, function()
						ctx.quick.pick(entry.item) -- 퀵슬롯(스마트폰: 칸 단추)이 반짝인다 — 놓을 칸을 누른다
					end)
				end
				button(WORDS.discard, function()
					ask = { kind = "discard", n = entry.n } -- 처음에는 그 칸의 묶음 전부
					view.refresh()
				end)
				if entry.n > 1 then
					button(WORDS.split, function()
						ask = { kind = "split", n = math.floor(entry.n / 2) } -- 처음에는 절반
						view.refresh()
					end)
				end
				if service == "store" then
					button(WORDS.toStore, function()
						if entry.n == 1 then
							ctx.send("Item", "storeIn", tabKey, slot, 1)
							if ui.storeShow then
								ui.storeShow(tabKey)
							end
							unselect()
							redraw()
						else
							ask = { kind = "store", n = entry.n }
							view.refresh()
						end
					end)
				elseif service == "shop" and def.sell > 0 then
					button(WORDS.sell, function()
						ask = { kind = "sell", n = entry.n }
						view.refresh()
					end)
				end
			end
			spec.key = table.concat({ tabKey, slot, entry.item, entry.n, have, me.level, service or "-", if ask then ask.kind .. (ask.n or "") else "-" }, "|")
		end
		ItemDetail.show("bag", spec)
	end

	function view.refresh()
		local bag, me = ctx.bag(), ctx.me()
		if not bag or not me then
			return
		end
		for i, button in tabs do
			button:setOn(i == tab)
		end
		local list = bag[key()]
		-- 줄 넘기기: 늘린 가방은 네 줄을 넘는다
		local rows = math.ceil(bag.size / COLS)
		top = math.clamp(top, 0, math.max(0, rows - ROWS))
		local scroll = rows > ROWS
		up.frame.Visible = scroll
		down.frame.Visible = scroll
		up:setEnabled(top > 0)
		down:setEnabled(top < rows - ROWS)
		count:move(if scroll then w - BAG.countW - BAG.scrollW - 4 else w - BAG.countW, 0)
		local used = 0
		for i = 1, bag.size do
			if list[i] then
				used += 1
			end
		end
		count:set(("%d / %d"):format(used, bag.size))
		detail(bag, me) -- 고른 것이 사라졌으면 여기서 풀린다
		for i, cell in cells do
			local at = top * COLS + i
			local item = list[at] or nil
			cell:set(item, { locked = at > bag.size, selected = sel ~= nil and sel.tab == key() and sel.slot == at, hot = hot == at })
		end
		-- 가방 늘리기(세 탭이 함께 늘어난다 — 값이 적혀 있다). 다 늘렸으면 단추가 없다
		grow.frame.Visible = bag.growCost ~= false
		if bag.growCost ~= false then
			grow:setText(BagWindow.growText(bag.growCost))
			grow:setEnabled(me.money >= bag.growCost)
		end
		sort:setEnabled(used > 1)
		money:set(Format.short(me.money))
		dust:set(Format.short(bag.dust))
		essence:set(Format.short(bag.essence))
	end

	function view.destroy()
		ItemDetail.hide("bag")
		if ui.detail == "bag" then
			ui.detail = nil
		end
		ui.bagDrop, ui.bagHover, ui.bagShow = nil, nil, nil
	end
	return view
end

return BagWindow

end
MODULES['Client/lune/ui/dailyWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 일일 의뢰 창 — 마을의 의뢰 게시판 앞에서 ↑를 누르면 뜬다.
--  사용자 2026-10-13: "일일 퀘스트 필요합니다. 게시판이랑 상호작용해서 일퀘받는거 좋습니다. 근데 좀더 간결하게 해도 될거 같습니다.  5분쯤 걸리게 / 일일 의뢰는 10부터 열죠"
--  머리글(「오늘의 의뢰」 · 「자정에 바뀐다」) 아래에 의뢰마다 한 칸: 맵의 이름(작게) · 「포자 주머니 30마리」 · 오른쪽에 「받는다」 → 「12/30」 → 「낸다」 → 「완료」 · 아래에 진행 띠.
--  그 아래 보상 두 줄: 의뢰 하나(경험치 · [달돈 그림]) · 둘을 다 내면([달가루 그림]) — 내 레벨의 것.
--  받기와 내기는 서버가 정한다(ctx.dailyDo → Daily). 셈은 shared/lune/sim/daily.luau, 모양은 공방 시험 탭의 js/lune/ui/paint.js(paintDaily)와 같다.
--  화면 오른쪽의 옆 판(ui/windows.luau). 게시판에서 멀어지면 닫힌다(boot.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Daily = require(lune.sim.daily)
local Format = require(lune.ui.format)
local Layout = require(lune.ui.layout)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local S = Layout.DAILY
local W = Daily.WORDS

local DailyWindow = {}
DailyWindow.ROWS = Daily.DATA.perDay

function DailyWindow.size(): (number, number)
	return S.w, S.top + DailyWindow.ROWS * S.row + S.payY + 2 * S.payRow
end

-- 의뢰의 이름: 「포자 주머니 30마리」
function DailyWindow.taskName(t): string
	return Format.fill(W.kill, { name = t.name, n = t.n })
end

function DailyWindow.build(body: Frame, ctx, w: number, _h: number)
	local view = {}
	local region = Daily.REGION
	Ui.text(body, W.head, 0, 2, w, { color = C.gold })
	Ui.text(body, W.reset, 0, 2, w, { align = "right", color = C.dim })
	local rows = {}
	local textW = w - S.btnW - 8
	for i = 1, DailyWindow.ROWS do
		local y = S.top + (i - 1) * S.row
		local by = y + 14
		local row = {}
		row.place = Ui.text(body, "", 0, y, textW, { color = C.dim })
		row.name = Ui.text(body, "", 0, y + 15, textW, { font = "body" })
		row.button = Ui.button(body, W.accept, w - S.btnW, by, S.btnW, function()
			local board = ctx.daily() and ctx.daily().boards[region]
			local t = board and board.tasks[i]
			if t then
				ctx.dailyDo(if t.st == Daily.OPEN then "accept" else "turn", region, i)
			end
		end, { main = true })
		row.count = Ui.text(body, "", w - S.btnW, by + math.floor((Ui.M.button - Ui.M.small) / 2), S.btnW, { align = "right", color = C.accent })
		row.bar = Ui.bar(body, 0, y + 34, textW, S.barH + 2, C.accent, C.panel2)
		rows[i] = row
	end
	local y = S.top + DailyWindow.ROWS * S.row
	Ui.line(body, 0, y, w)
	y += S.payY
	-- 보상: 의뢰 하나 = 경험치 · [달돈] / 둘을 다 내면 = [달가루]
	Ui.text(body, W.each, 0, y + 4, S.labelW - 4, { color = C.dim })
	local xp = Ui.text(body, "", S.labelW, y + 4, w - S.labelW, { color = C.gold })
	local coin = Ui.smallIcon(body, "coin", S.labelW, y)
	local money = Ui.text(body, "", S.labelW, y + 4, w - S.labelW, { color = C.gold })
	Ui.text(body, W.all, 0, y + S.payRow + 4, S.labelW - 4, { color = C.dim })
	Ui.smallIcon(body, "dust", S.labelW, y + S.payRow)
	local dust = Ui.text(body, "", S.labelW + 21, y + S.payRow + 4, w - S.labelW - 21, { color = C.gold })

	function view.refresh()
		local got = ctx.daily()
		local board = got and got.boards[region]
		for i, row in rows do
			local t = board and board.tasks[i]
			local ready = t ~= nil and Daily.isReady(t)
			local act = t ~= nil and (t.st == Daily.OPEN or ready)
			row.place:set(if t then t.place else "")
			row.name:set(if t then DailyWindow.taskName(t) else "")
			row.name:color(if t and t.st == Daily.DONE then C.dim else C.text)
			row.button.frame.Visible = act
			if t and act then
				row.button:setText(if t.st == Daily.OPEN then W.accept else W.turn)
			end
			row.count:set(if not t or act then "" elseif t.st == Daily.DONE then W.done else ("%d/%d"):format(math.min(t.have, t.n), t.n))
			row.count:color(if t and t.st == Daily.DONE then C.green else C.accent)
			row.bar.frame.Visible = t ~= nil
			if t then
				row.bar:set(if t.st == Daily.DONE then 1 elseif t.st == Daily.OPEN then 0 else t.have / t.n)
				row.bar:setColor(if t.st == Daily.DONE then C.green else C.accent)
			end
		end
		local pay = board and board.pay
		local xpText = if pay then ("%s %s"):format(W.xp, Format.short(pay.xp)) else ""
		xp:set(xpText)
		local mx = S.labelW + Ui.measure(xpText) + 12
		coin.Visible = pay ~= nil
		coin.Position = UDim2.fromOffset(mx, y)
		money:move(mx + 21, y + 4)
		money:set(if pay then Format.short(pay.money) else "")
		dust:set(if pay then Format.short(pay.dust) else "")
	end
	view.refresh()
	return view
end

return DailyWindow

end
MODULES['Client/lune/ui/deathBox'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 쓰러졌을 때 묻는 상자 — 「쓰러졌다 · 마을로 돌아갈까요?」와 단추 하나(공방 js/lune/design/ui.js의 UILAYOUT.death → Layout.DEATH).
--  사용자 2026-10-08: "죽으면 비석 세우고, 모달띄워서 마을로 갈거냐고 물어보는 딜레이를 넣읍시다."
--  쓰러지고 조금 뒤(싸움의 규칙 reviveWait)에 화면 위쪽 가운데에 뜬다. 단추를 누를 때까지 떠 있고(저절로 마을로 가지 않는다), 파티원이 소생으로 일으켜 주면 사라진다.
--  파티 초대 알림(partyHud.luau)과 같은 부품으로 짓는다 — PC는 마우스로, 스마트폰은 손가락으로 누른다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Layout = require(ReplicatedStorage.shared.lune.ui.layout)
local Stage = require(script.Parent.Parent.stage)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local D = Layout.DEATH

local DeathBox = {}
DeathBox.holder = nil :: Frame?

function DeathBox.shown(): boolean
	return DeathBox.holder ~= nil
end

function DeathBox.hide()
	if DeathBox.holder then
		DeathBox.holder:Destroy()
		DeathBox.holder = nil
	end
end

-- root = 늘 보이는 화면의 틀 · onReturn = 「마을로 돌아간다」를 눌렀을 때
function DeathBox.show(root: Instance, onReturn: () -> ())
	DeathBox.hide()
	local holder = Stage.place(root, "DeathBox", D.at, D.x, D.y, D.w, D.h)
	holder.ZIndex = 40
	local panel = Ui.panel(holder, 0, 0, D.w, D.h)
	local inner = D.w - D.pad * 2
	Ui.text(panel, D.title, D.pad, D.titleY, inner, { font = "body", color = C.gold })
	Ui.text(panel, D.text, D.pad, D.textY, inner)
	Ui.text(panel, D.hint, D.pad, D.hintY, inner, { color = C.dim })
	local sent = false
	Ui.button(panel, D.yes, D.pad, D.buttonY, inner, function()
		if not sent then
			sent = true -- 한 번만 보낸다(서버가 마을로 옮기면 이 상자는 사라진다)
			onReturn()
			task.delay(1.5, function()
				sent = false -- 받아들여지지 않았으면(너무 일렀다) 다시 누를 수 있다
			end)
		end
	end, { main = true }).frame.Name = "Return"
	DeathBox.holder = holder
end

return DeathBox

end
MODULES['Client/lune/ui/equipWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 장비 창 — 13부위. 왼쪽에 무기와 방어구 넷(칸 옆에 「Lv.10 +2」), 오른쪽 위에 장신구 여덟(네 칸 x 두 줄). 오른쪽 아래에 전투력과 방어.
--  부위를 누르면 그 장비의 상세가 창 옆의 작은 판에 뜬다(ui/itemDetail.luau) — 「해제」로 가방에 넣고, 대장장이 앞에서는 「강화」로 강화 창에 올린다.
--   사용자 2026-10-08: "장비 탭에서 각각의 장비를 선택하면 그 해당장비가 장비창 옆에 작은모달이 떠서 아이템 스펙이 나와야합니다."
--  같은 부위를 두 번 누르면 해제(가방에서 두 번 누르면 장착인 것과 짝). 화면 오른쪽 · 왼쪽의 옆 판(ui/windows.luau). 칸의 크기는 장비 그림의 크기(화면 틀의 배율)를 따른다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Items = require(lune.sim.items)
local Format = require(lune.ui.format)
local ItemInfo = require(lune.ui.itemInfo)
local Layout = require(lune.ui.layout) -- 치수(자동 검사가 같은 값을 본다)
local WORDS = require(lune.data["ui.generated"]).words
local Stage = require(script.Parent.Parent.stage)
local Ui = require(script.Parent.ui)
local ItemCell = require(script.Parent.itemCell)
local ItemDetail = require(script.Parent.itemDetail)
local Windows = require(script.Parent.windows)

local C = Ui.COLOR
local D = Items.data
local DOUBLE = 0.4 -- 이 안에 같은 칸을 다시 누르면 두 번 누른 것(초)

local EquipWindow = {}
EquipWindow.TEXT_W = Layout.EQUIP.textW -- 부위 이름이나 "Lv.140 +17"이 들어가는 폭
EquipWindow.ACC_COLS = Layout.EQUIP.accCols

-- 속의 짜임: 왼쪽 = 칸 하나 + 글, 오른쪽 = 장신구 네 칸
local function metrics()
	local w, _, rx = Layout.equipBody(Stage.ratio)
	return ItemCell.size(), rx, w
end

function EquipWindow.size(): (number, number)
	local w, h = Layout.equipBody(Stage.ratio)
	return w, h
end

function EquipWindow.build(body: Frame, ctx, w: number, _h: number)
	local ui = ctx.ui
	local S, RX = metrics()
	local nameW = w - RX
	local selected: string? = nil
	local lastClick = { slot = "", t = 0 }
	local view = {}
	local rows = {}
	local left, right = 0, 0
	local function redraw()
		Windows.refresh(ctx.me())
	end
	for _, slot in D.SLOTS do
		local isAcc = slot.kind == "장신구"
		local x, y
		if isAcc then
			x, y = RX + (right % EquipWindow.ACC_COLS) * S, math.floor(right / EquipWindow.ACC_COLS) * S
			right += 1
		else
			x, y = 0, left * (S + 2)
			left += 1
		end
		local cell = ItemCell.new(body, x, y, function(it)
			local now = os.clock()
			local twice = it ~= nil and lastClick.slot == slot.id and now - lastClick.t < DOUBLE
			lastClick = { slot = if twice then "" else slot.id, t = now }
			if twice then
				ctx.send("Item", "unequip", slot.id) -- 두 번 누르기: 해제
				selected = nil
			elseif it then
				selected = slot.id
				ui.detail = "equip"
			else
				selected = nil
			end
			redraw()
		end, S)
		-- 무기 · 방어구는 칸 옆에 한 줄(장신구는 고르면 상세 판에 이름이 뜬다)
		local text = if isAcc then nil else Ui.text(body, "", x + S + 8, y + math.floor((S - 10) / 2), EquipWindow.TEXT_W, { color = C.dim })
		rows[slot.id] = { cell = cell, text = text, slot = slot }
	end
	local ny = 2 * S + 12
	Ui.line(body, RX, ny, nameW)
	local power = Ui.text(body, "", RX, ny + 10, nameW, { color = C.gold })
	local guard = Ui.text(body, "", RX, ny + 26, nameW)

	-- 고른 부위의 상세 판(창 옆)
	local function detail(bag, me)
		if ui.detail ~= "equip" then
			selected = nil -- 다른 창에서 골랐다
		end
		local it = if selected then bag.equip[selected] else nil
		if not it then
			selected = nil
			ItemDetail.hide("equip")
			return
		end
		local slotId = selected
		local buttons = { { text = WORDS.unequip, main = true, onClick = function()
			ctx.send("Item", "unequip", slotId)
			selected = nil
			redraw()
		end } }
		if ui.service == "forge" then
			table.insert(buttons, { text = WORDS.toForge, onClick = function()
				ctx.toForge(it.id)
			end })
		end
		ItemDetail.show("equip", {
			key = table.concat({ "equip", it.id, it.q, it.star, tostring(it.broken), me.level, ui.service or "-" }, "|"),
			info = ItemInfo.gear(it, me, nil, true),
			item = it,
			buttons = buttons,
			onClose = function()
				selected = nil
				redraw()
			end,
		})
	end

	function view.refresh()
		local bag, me = ctx.bag(), ctx.me()
		if not bag or not me then
			return
		end
		detail(bag, me)
		local worn = {}
		for id, row in rows do
			local it = bag.equip[id]
			row.cell:set(it, { selected = id == selected })
			if it then
				table.insert(worn, it)
			end
			if row.text then
				if it then
					row.text:set(if it.star > 0 then ("Lv.%d +%d"):format(it.stage, it.star) else ("Lv.%d"):format(it.stage))
					row.text:color(ItemCell.color(it))
				else
					row.text:set(row.slot.name)
					row.text:color(C.dim)
				end
			end
		end
		power:set(("전투력 %s"):format(Format.short(me.power)))
		guard:set(("방어 %d%%"):format(math.floor(Items.cut(worn, me.level) + 0.5)))
	end

	function view.destroy()
		ItemDetail.hide("equip")
		if ui.detail == "equip" then
			ui.detail = nil
		end
	end
	return view
end

return EquipWindow

end
MODULES['Client/lune/ui/forgeWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 강화 창 — 대장장이에게 말을 걸면 가방과 나란히 뜬다(공방 「기본 · UI」 탭의 「강화의 흐름」).
--  가방이나 장비 창에서 「올리기」로 장비를 올리면: 지금 별과 다음 별 · 성공 / 실패 / 파괴 % · 실패하면 그대로인지 떨어지는지 · 드는 달가루와 정수.
--  둘째로 올린 장비는 「재료」다: 같은 부위면 별 옮기기(재료의 별을 하나 낮춰 옮기고 재료는 사라진다), 올린 것이 부서졌고 같은 장비면 되살리기.
--  확률과 값은 shared/lune/sim/items.luau의 enhanceInfo(공방의 강화 표). 결과는 서버가 정한다(Item → ItemDone).
--  드는 것 두 줄(달가루 · 정수)은 앞에 그 그림이 붙는다(가방의 지갑과 같은 그림 — 사용자 2026-10-13: "강화창이랑 퀘스트 보상에 아이템그림 들어가야합니다.").
--   올린 장비와 재료는 처음부터 칸에 그림으로 보였다.
--  화면 오른쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Items = require(lune.sim.items)
local Format = require(lune.ui.format)
local Ui = require(script.Parent.ui)
local ItemCell = require(script.Parent.itemCell)

local C = Ui.COLOR
local W = 300
local LINE = 16
local COST = 20 -- 드는 것(달가루 · 정수)의 줄: 앞에 그림(18)이 붙어 글만 있는 줄보다 높다
local COST_TX = 21 -- 그 줄의 글이 시작하는 자리(그림 18 + 3)

local ForgeWindow = {}
ForgeWindow.COST_ICONS = { "dust", "orb" } -- 드는 것 두 줄의 그림: 달가루 · 정수(ForgeWindow.lines의 넷째 · 다섯째 줄)
ForgeWindow.COST, ForgeWindow.COST_TX = COST, COST_TX
ForgeWindow.RESULT = { ok = { "붙었다!", C.green }, fail = { "실패 — 별은 그대로다", C.dim }, drop = { "실패 — 한 단계 떨어졌다", C.red }, boom = { "부서졌다 — 흔적이 남았다", C.red } }

function ForgeWindow.size(): (number, number)
	local S = ItemCell.size()
	return W, S + 12 + 3 * LINE + 2 * COST + 8 + Ui.M.button + 8 + 16 + 14 + S + 4
end

local function pct(v: number): string
	return if v == math.floor(v) then ("%d%%"):format(v) else ("%.1f%%"):format(v)
end
ForgeWindow.pct = pct

-- 강화 창에 적는 줄들(화면 없이도 셈할 수 있게 따로 뺐다): { 별, 확률, 실패하면, 달가루, 정수 }
function ForgeWindow.lines(it, info, bag): { string }
	if not info.can then
		return { if info.why == "상한" then ("별 %d — 이 장비는 여기까지다"):format(it.star) else "부서졌다 — 같은 장비를 재료로 올린다", "", "", "", "" }
	end
	local odds = if info.sure then "반드시 성공" else ("성공 %s · 실패 %s"):format(pct(info.ok), pct(info.fail))
	if info.boom > 0 then
		odds ..= (" · 파괴 %s"):format(pct(info.boom))
	end
	return {
		("별 %d → %d"):format(it.star, it.star + 1),
		odds,
		if info.first then "첫 강화 — 달가루 없이 반드시 붙는다" elseif info.sure then "두 번 떨어졌다 — 이번은 반드시 붙는다" elseif info.drops then "실패하면 한 단계 떨어진다" else "실패해도 별은 그대로다",
		("달가루 %s (가진 것 %s)"):format(Format.short(info.dust), Format.short(bag.dust)),
		if info.essence > 0 then ("정수 %d (가진 것 %s)"):format(info.essence, Format.short(bag.essence)) else "",
	}
end

function ForgeWindow.build(body: Frame, ctx, w: number, _h: number)
	local ui = ctx.ui
	local S = ItemCell.size()
	local guard = false
	local view = {}
	local function find(id: number?)
		local bag = ctx.bag()
		if not bag or not id then
			return nil
		end
		for _, it in bag.gear do
			if it and it.id == id then
				return it
			end
		end
		for _, it in bag.equip do
			if it.id == id then
				return it
			end
		end
		return nil
	end

	local cell = ItemCell.new(body, 0, 0, function()
		ui.forgeTarget, ui.forgeMat, ui.forgeResult = nil, nil, nil
		view.refresh()
	end, S)
	local name = Ui.text(body, "", S + 10, math.floor((S - 30) / 2), w - S - 10, { font = "body", lines = 2, line = 16 })
	local lines = {}
	local y = S + 12
	for i = 1, 3 do
		lines[i] = Ui.text(body, "", 0, y + (i - 1) * LINE, w, { color = if i == 1 then C.gold else C.text })
	end
	y += 3 * LINE
	-- 드는 것 두 줄: [달가루 그림] 달가루 120 (가진 것 505) · [정수 그림] 정수 2 (가진 것 0) — 들지 않는 줄은 그림도 숨긴다
	local costIcons = {}
	for i, icon in ForgeWindow.COST_ICONS do
		local cy = y + (i - 1) * COST
		costIcons[i] = Ui.smallIcon(body, icon, 0, cy)
		lines[3 + i] = Ui.text(body, "", COST_TX, cy + 4, w - COST_TX)
	end
	y += 2 * COST + 8
	-- 단추 한 줄: 강화 · 파괴 막기 · 상점
	local go = Ui.button(body, "강화", 0, y, 84, function()
		if ui.forgeTarget then
			ctx.send("Item", "enhance", ui.forgeTarget, guard)
		end
	end, { main = true })
	local shield = Ui.button(body, "", 92, y, 130, function()
		guard = not guard
		view.refresh()
	end)
	Ui.button(body, "상점", 230, y, w - 230, function()
		ctx.openService("smithShop")
	end)
	y += Ui.M.button + 8
	local result = Ui.text(body, "", 0, y, w)
	y += 16
	Ui.line(body, 0, y + 4, w)
	y += 14
	-- 재료: 별을 옮겨 올 장비 · 되살릴 때 쓰는 같은 장비
	local matCell = ItemCell.new(body, 0, y, function()
		ui.forgeMat = nil
		view.refresh()
	end, S)
	local matName = Ui.text(body, "", S + 10, y + math.floor((S - 26) / 2), w - S - 10 - 108, { color = C.dim, lines = 2, line = 14 })
	local move = Ui.button(body, "", w - 100, y + math.floor((S - Ui.M.button) / 2), 100, function()
		local it, mat = find(ui.forgeTarget), find(ui.forgeMat)
		if it and mat then
			ctx.send("Item", if it.broken then "restore" else "transfer", if it.broken then it.id else mat.id, if it.broken then mat.id else it.id)
			ui.forgeMat = nil
		end
	end)

	function view.refresh()
		local bag = ctx.bag()
		if not bag then
			return
		end
		local it, mat = find(ui.forgeTarget), find(ui.forgeMat)
		if not it then
			ui.forgeTarget = nil
		end
		if not mat then
			ui.forgeMat = nil
		end
		cell:set(it)
		matCell:set(mat)
		if not it then
			name:set("가방이나 장비 창에서 장비를 고르고 올리기")
			name:color(C.dim)
			for _, line in lines do
				line:set("")
			end
			for _, icon in costIcons do
				icon.Visible = false
			end
			go:setEnabled(false)
			shield.frame.Visible = false
			result:set("")
			matName:set("")
			move.frame.Visible = false
			return
		end
		name:set(ItemCell.label(it))
		name:color(ItemCell.color(it))
		local me = ctx.me()
		local info = Items.enhanceInfo(it, guard, me ~= nil and me.forged ~= true and it.star == 0) -- 첫 강화(별이 없는 장비의 첫 별)는 공짜로 반드시 붙는다
		local texts = ForgeWindow.lines(it, info, bag)
		for i, text in texts do
			lines[i]:set(text)
		end
		for i, icon in costIcons do
			icon.Visible = texts[3 + i] ~= ""
		end
		go:setEnabled(info.can and bag.dust >= info.dust and bag.essence >= info.essence)
		shield.frame.Visible = info.can and info.guard == true
		shield:setText(if guard then "파괴 막기 켬" else "파괴 막기 끔")
		shield:setMain(guard)
		local last = ui.forgeResult
		local show = last and ForgeWindow.RESULT[last]
		result:set(if show then show[1] else "")
		if show then
			result:color(show[2])
		end
		-- 재료
		if mat then
			matName:set(ItemCell.label(mat))
			local canRestore = it.broken and not mat.broken and Items.same(it, mat)
			local canMove = not it.broken and not mat.broken and mat.slot == it.slot and Items.transfer(mat, it) > it.star
			move.frame.Visible = true
			move:setText(if it.broken then "되살리기" else "별 옮기기")
			move:setEnabled(canRestore or canMove)
		else
			matName:set(if it.broken then "같은 장비를 하나 더 올린다" else "재료: 별을 옮겨 올 장비")
			move.frame.Visible = false
		end
	end
	return view
end

-- 장비를 올린다: 처음 것은 강화할 장비, 그다음 것은 재료
function ForgeWindow.put(ui, id: number)
	if not ui.forgeTarget or ui.forgeTarget == id then
		ui.forgeTarget = id
	else
		ui.forgeMat = id
	end
	ui.forgeResult = nil
end

return ForgeWindow

end
MODULES['Client/lune/ui/hallWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 명예의 전당 창 — 순위판 셋(후원 · 전투력 · 레벨)의 위 열 줄. 명예의 전당 건물 안의 비석 앞에서 ↑를 누르면 그 비석의 판이 뜬다(탭으로 다른 판을 본다).
--  사용자 2026-10-10: "대형 마을마다 명예의 전당 건물 을 만들어서 최대 로벅스 결제자, 전투력 랭킹, 레벨 랭킹 이렇게 캐릭터 닉네임 보여주는 명예의 전당을 만듭니다."
--  순위는 서버가 준다(ctx.rank() — 서버는 1분마다 한 번 읽어 둔 것을 준다). 이름은 캐릭터의 이름(만들 때 지은 것).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local CLASSES = require(lune.data["classes.generated"])
local Rank = require(lune.sim.rank)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local ROW = 20 -- 한 줄의 높이
local TOP = 30 -- 탭 아래 첫 줄의 자리
-- 판의 차례와 머리글(값의 이름)
local TABS = { { id = "robux", name = "후원", value = "쓴 로벅스" }, { id = "power", name = "전투력", value = "전투력" }, { id = "level", name = "레벨", value = "레벨" } }

local HallWindow = {}

function HallWindow.size(): (number, number)
	return 300, TOP + 16 + Rank.TOP * ROW + 8
end

function HallWindow.build(body: Frame, ctx, w: number, _h: number, arg: any)
	local board = if typeof(arg) == "string" then arg else "level"
	local boards = nil -- 서버가 준 판들(아직이면 nil)
	local alive = true
	local tabs = {}
	local x = 0
	for _, t in TABS do
		local tab
		tab = Ui.tab(body, t.name, x, 2, function()
			board = t.id
			HallWindow.redraw()
		end)
		tabs[t.id] = tab
		x += tab.width + 18
	end
	Ui.line(body, 0, 22, w)
	local headName = Ui.text(body, "이름", 34, TOP, 120, { color = C.dim })
	local headValue = Ui.text(body, "", 0, TOP, w, { color = C.dim, align = "right" })
	local note = Ui.text(body, "불러오는 중 …", 0, TOP + 16 + 40, w, { color = C.dim, align = "center" })
	local rows = {}
	for i = 1, Rank.TOP do
		local y = TOP + 16 + (i - 1) * ROW
		rows[i] = {
			no = Ui.text(body, tostring(i), 0, y, 26, { align = "right", color = if i <= 3 then C.gold else C.dim }),
			name = Ui.text(body, "", 34, y, 96, { font = "small" }),
			class = Ui.text(body, "", 134, y, 82, { color = C.dim }),
			value = Ui.text(body, "", 0, y, w, { align = "right", color = C.accent }),
		}
	end

	function HallWindow.redraw()
		if not alive then
			return
		end
		for _, t in TABS do
			tabs[t.id]:setOn(t.id == board)
			if t.id == board then
				headValue:set(t.value)
			end
		end
		local list = if boards then boards[board] or {} else nil
		note:show(list == nil or #list == 0)
		note:set(if list == nil then "불러오는 중 …" else "아직 기록이 없습니다")
		headName:show(list ~= nil and #list > 0)
		headValue:show(list ~= nil and #list > 0)
		for i, row in rows do
			local it = if list then list[i] else nil
			row.no:show(it ~= nil)
			row.name:set(if it then it.name else "")
			row.class:set(if it and it.class and CLASSES.classes[it.class] then CLASSES.classes[it.class].name else "")
			row.value:set(if it then it.value else "")
		end
	end
	HallWindow.redraw()
	task.spawn(function()
		local got = ctx.rank()
		if alive then
			boards = got or {}
			HallWindow.redraw()
		end
	end)

	return {
		destroy = function()
			alive = false
		end,
	}
end

return HallWindow

end
MODULES['Client/lune/ui/itemCell'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 아이템 한 칸 — 가방 · 장비 창 · 창고 · 강화 창 · 상세 판이 같이 쓴다. 칸에 놓이는 것 = 장비({ slot, stage, q, star … }) 또는 소비 · 기타 아이템의 묶음({ item = 이름표, n = 수 }).
--  묶음은 그 아이템의 그림과 오른쪽 아래의 수(사용자 2026-10-08: 소비 · 기타 아이템도 장비처럼 칸에 놓인다).
--  어두운 칸에 그 장비의 그림(땅에 떨어진 것과 같은 그림 — 게임의 굵은 도트 그대로). 오른쪽 아래의 +숫자 = 별, 부서진 것은 어둡게 하고 빨간 ×.
--  고른 칸은 민트 테두리. 등급(성능 단)은 칸에 표시하지 않는다 — 이름의 글자색으로만 보인다(던그리드처럼. 낡은 갈색 · 허름한 회색 · 보통 흰색 · 좋은 하늘색 · 빼어난 노랑).
--  그림은 공방의 아이콘(tools/build_lune_icons.mjs): 무기는 직업마다 하나, 방어구는 부위 x 재질(가죽 · 수정 · 무쇠 · 달빛), 장신구는 부위마다 하나.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Items = require(lune.sim.items)
local KIT = require(lune.data["kit.generated"])
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local D = Items.data
local ICONS = KIT.parts.icons.icons

local ItemCell = {}
-- 칸의 한 변(화면 틀의 배율을 따른다 — 1080p에서 50). 창을 지을 때마다 다시 묻는다
function ItemCell.size(): number
	return Ui.cellSize()
end
-- 성능 단의 글자색: 낡은 · 허름한 · 보통 · 좋은 · 빼어난
ItemCell.QUALITY = { C.tier0, C.tier1, C.tier2, C.tier3, C.tier4 }
local WEAPON = { axion = "w_axe", riven = "w_spear", reaper = "w_scythe", mooni = "w_sword", salamander = "w_fist" }

function ItemCell.color(it): Color3
	if it.broken then
		return C.red
	end
	return ItemCell.QUALITY[it.q] or C.text
end

-- 방어구의 재질 번호(1 가죽 · 2 수정 · 3 무쇠 · 4 달빛) — 장비 단계로 정해진다
function ItemCell.material(stage: number): number
	for i, m in D.MATERIAL do
		if stage < m.below then
			return i
		end
	end
	return #D.MATERIAL
end

-- 소비 · 기타 아이템의 묶음인가
function ItemCell.isStack(it: any): boolean
	return it ~= nil and it.item ~= nil
end

-- 그 아이템의 아이콘 이름
function ItemCell.icon(it): string
	if it.item then
		local g = Items.goods(it.item)
		return if g then g.icon else ""
	end
	if it.slot == "weapon" then
		return WEAPON[it.who] or "w_sword"
	end
	local armor = ("a_%s%d"):format(it.slot, ItemCell.material(it.stage))
	if ICONS[armor] then
		return armor
	end
	return "acc_" .. it.slot
end

-- 땅에 떨어진 장비의 귀퉁이 표시(게임 세계의 그림 — client/lune/effects.luau가 쓴다): 보통이면 nil
local TIER = { "tier0", "tier1", nil, "tier3", "tier4" }
function ItemCell.tier(it): string?
	return TIER[it.q]
end

-- 글로 적는 장비(한 줄): 이름 +별
function ItemCell.label(it): string
	local name = Items.name(it)
	if it.broken then
		return name .. " (부서짐)"
	elseif it.star > 0 then
		return ("%s +%d"):format(name, it.star)
	end
	return name
end

-- 성능 단의 글: 보통이면 빈 글
function ItemCell.qualityText(it): string
	local q = D.QUALITY[it.q]
	if q.bonus == 0 then
		return ""
	end
	return ("%s %s%d%%"):format(q.name, if q.bonus > 0 then "+" else "", q.bonus)
end

-- 화면의 그 자리(at)에 있는 칸의 차례(없으면 nil) — 끌던 것을 놓을 칸을 찾을 때 쓴다. cells = ItemCell.new로 만든 칸들
function ItemCell.at(cells, at: Vector2): number?
	for i, cell in cells do
		local p, s = cell.frame.AbsolutePosition, cell.frame.AbsoluteSize
		if at.X >= p.X and at.X < p.X + s.X and at.Y >= p.Y and at.Y < p.Y + s.Y then
			return i
		end
	end
	return nil
end

-- 화면의 그 자리(at)가 그 틀(frame) 안인가
function ItemCell.over(frame: GuiObject, at: Vector2): boolean
	local p, s = frame.AbsolutePosition, frame.AbsoluteSize
	return at.X >= p.X and at.X < p.X + s.X and at.Y >= p.Y and at.Y < p.Y + s.Y
end

-- 칸 하나(한 변 s — 안 주면 ItemCell.size()). onClick(item) — 빈 칸을 눌러도 불린다(item = nil)
function ItemCell.new(parent: Instance, x: number, y: number, onClick: (any) -> (), s: number?)
	local S = s or ItemCell.size()
	local slot = Ui.slot(parent, x, y, S)
	local outer = slot.frame
	outer.Name = "Cell"
	local icon = Ui.worldIcon(outer, nil, 0, 0, S)
	local star = Ui.text(outer, "", 0, S - 13, S - 4, { align = "right", outline = true, color = C.text, z = 6 })
	local cross = Ui.text(outer, "", 0, math.floor((S - 12) / 2), S, { font = "body", align = "center", outline = true, color = C.red, z = 6 })
	local veil = Ui.box(outer, 1, 1, S - 2, S - 2, C.ink, 0.45) -- 아직 열리지 않은 칸
	veil.Name = "Locked"
	veil.ZIndex = 5
	veil.Visible = false
	local cell = { frame = outer, item = nil :: any, size = S }
	cell.hit = Ui.hit(outer) -- 누르는 자리(가방은 여기서 끌기도 받는다)
	cell.hit.Activated:Connect(function()
		onClick(cell.item)
	end)
	-- it = 장비 · 묶음(없으면 빈 칸). opts = { locked 아직 열리지 않은 칸, selected 고른 칸, hot 끌던 것을 놓을 칸 }
	function cell.set(_, it: any, opts)
		opts = opts or {}
		cell.item = it
		Ui.setWorldIcon(icon, if it then ItemCell.icon(it) else nil)
		if it and it.item then
			star:set(tostring(it.n)) -- 묶음: 수
		else
			star:set(if it and it.star > 0 then "+" .. it.star else "")
		end
		local broken = it ~= nil and it.broken == true
		icon.ImageColor3 = if broken then Color3.fromRGB(90, 90, 100) else Color3.new(1, 1, 1)
		cross:set(if broken then "×" else "")
		slot:setOn(opts.selected == true or opts.hot == true)
		veil.Visible = opts.locked == true
	end
	cell:set(nil)
	return cell
end

return ItemCell

end
MODULES['Client/lune/ui/itemDetail'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 아이템 상세 — 가방 · 장비 창 · 창고에서 고른 아이템을 그 창 옆의 작은 판에 보여 준다. 한 번에 하나만 뜬다(다른 창에서 고르면 그쪽으로 옮겨 간다).
--  사용자 2026-10-08: "장비 탭에서 각각의 장비를 선택하면 그 해당장비가 장비창 옆에 작은모달이 떠서 아이템 스펙이 나와야합니다. 인벤토리에서 선택도 마찬가지입니다. 기타아이템, 소비아이템 모두 마찬가지입니다."
--  판의 짜임(공방 js/lune/design/ui.js의 UILAYOUT.detail — 횡스크롤 시험 탭의 paintDetail과 같은 그림):
--   위에 그림 칸과 이름(본문 글씨 — 색 = 성능 단) · 그 아래 갈래 / 줄마다 이름(흐린 글)과 값 / 알림 글(장착하면 전투력 +n …) / 단추(장착 · 사용 · 분해 · 버리기 …).
--   버리기 · 맡기기 · 찾기 · 팔기 · 나누기를 누르면 단추 자리에 "몇 개를 …할까요?"와 수를 고르는 단추 · 「…한다 · 그만둔다」가 뜬다(spec.ask — ItemDetail.ask가 짓는다).
--	장비를 팔 때는 수를 고르지 않고 팔지 말지만 묻는다.
--  적는 글은 shared/lune/ui/itemInfo.luau가 짓는다(공방의 gearInfo · goodsInfo와 같은 글). 판은 창들보다 위, 닫기(X)들보다 아래의 층에 뜬다.
--  PC · 스마트폰 같은 판이다 — 칸을 누르면(손가락으로 톡) 뜨고, 판의 ×나 빈 칸을 누르면 닫힌다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Layout = require(ReplicatedStorage.shared.lune.ui.layout)
local Format = require(ReplicatedStorage.shared.lune.ui.format)
local WORDS = require(ReplicatedStorage.shared.lune.data["ui.generated"]).words
local Stage = require(script.Parent.Parent.stage)
local Ui = require(script.Parent.ui)
local ItemCell = require(script.Parent.itemCell)
local Windows = require(script.Parent.windows)

local C = Ui.COLOR
local K = Layout.DETAIL
local M = Ui.M

local ItemDetail = {}
local STEPS = { -10, -1, 1, 10 } -- 수를 고르는 단추

local layer: Frame? = nil
local shown = nil -- { owner, key, holder }

local function root(): Frame
	if not layer then
		layer = Stage.group(Stage.ui, "ItemDetail", 156) -- 창(150) 위 · 메뉴(160) 아래
	end
	return layer :: Frame
end

-- 지금 떠 있는 판의 주인(창의 이름표 — 없으면 nil)
function ItemDetail.owner(): string?
	return if shown then shown.owner else nil
end

-- 판을 닫는다. owner를 주면 그 창의 것일 때만
function ItemDetail.hide(owner: string?)
	if shown and (owner == nil or shown.owner == owner) then
		shown.holder:Destroy()
		shown = nil
	end
end

-- 수를 고르는 줄(spec.ask)을 짓는다. kind = 하는 일(WORDS.ask의 이름표: "discard" · "store" · "take" · "sell" · "split" · "sellGear") · n = 지금 고른 수(nil이면 수를 고르지 않는다 — 장비 팔기) ·
--  lo · hi = 고를 수 있는 범위 · o = { set(n) 수를 고쳤다, yes(n) 한다, no() 그만둔다, gain(n) → 팔 때 받을 달돈(묻는 글 뒤에 붙는다) }
function ItemDetail.ask(kind: string, n: number?, lo: number, hi: number, o)
	local words = WORDS.ask[kind]
	local text = words[1]
	if o.gain then
		text = text .. "  " .. Format.fill(WORDS.gain, { n = Format.short(o.gain(n or 1)) })
	end
	local steps = nil
	if n then
		steps = {}
		for i, d in STEPS do
			steps[i] = { text = if d > 0 then "+" .. d else tostring(d), onClick = function()
				o.set(math.clamp(n + d, lo, hi))
			end }
		end
	end
	return {
		text = text,
		n = n,
		steps = steps,
		yes = { text = words[2], onClick = function()
			o.yes(n)
		end },
		no = { text = WORDS.askNo, onClick = o.no },
	}
end

-- 글의 줄 수(그려진 높이에서)
local function linesOf(label, line: number): number
	local _, h = label:size()
	return math.max(1, math.floor(h / line + 0.5))
end

-- 판을 띄운다(이미 같은 것이 떠 있으면 자리만 다시 맞춘다).
--  owner = 주인 창의 이름표 · spec = { key(달라지면 다시 그린다), info(ItemInfo의 것), item(칸에 그릴 장비 · 묶음), buttons = { { text, main?, off?, onClick } … },
--                                    ask = { text, n, steps = { { text, onClick } … 넷 }, yes = { text, onClick }, no = { text, onClick } }?, onClose }
function ItemDetail.show(owner: string, spec)
	local at = Windows.beside(owner, K.w, K.gap)
	if not at then
		ItemDetail.hide(owner)
		return
	end
	if shown and shown.owner == owner and shown.key == spec.key then
		shown.holder.Position = at
		return
	end
	ItemDetail.hide(nil)
	local info = spec.info
	local S = ItemCell.size()
	local inner = Layout.detailInner()
	local holder = Stage.place(root(), "Detail_" .. owner, "tr", 0, 0, K.w, 10)
	holder.Position = at
	local panel = Ui.panel(holder, 0, 0, K.w, 10)
	-- 판을 누른 것이 그 밑의 것(게임 화면 · 다른 창)으로 새지 않게
	local shield = Ui.hit(panel)
	shield.ZIndex = 1
	shield.Name = "Shield"

	-- 그림 칸 · 이름 · 갈래 · 닫기
	local cell = ItemCell.new(panel, K.pad, K.pad, function() end, S)
	cell:set(spec.item, {})
	cell.hit.Active = false
	local nameX = K.pad + S + 8
	local name = Ui.text(panel, info.name, nameX, K.pad, Layout.detailNameW(Stage.ratio), { font = "body", lines = K.nameLines, line = K.nameLine, color = C[info.tone] or C.text })
	local nameLines = linesOf(name, K.nameLine)
	Ui.text(panel, info.sub, nameX, K.pad + nameLines * K.nameLine + K.subGap, inner - S - 8, { color = C.dim })
	Ui.closeButton(panel, K.w - K.pad - 10, K.pad, function()
		if spec.onClose then
			spec.onClose()
		else
			ItemDetail.hide(owner)
		end
	end).ZIndex = 12
	local y = K.pad + math.max(S, nameLines * K.nameLine + K.subGap + M.small)

	-- 줄: 이름(흐린 글)과 값
	Ui.line(panel, K.pad, y + math.floor(K.rowTop / 2), inner)
	y += K.rowTop
	for _, row in info.rows do
		Ui.text(panel, row[1], K.pad, y + 3, K.labelW, { color = C.dim })
		Ui.text(panel, row[2], K.pad + K.labelW, y + 3, Layout.detailValueW(), { color = C[row[3]] or C.text })
		y += K.rowH
	end

	-- 알림 글
	if #info.notes > 0 then
		Ui.line(panel, K.pad, y + math.floor(K.noteTop / 2), inner)
		y += K.noteTop
		for _, note in info.notes do
			local label = Ui.text(panel, note[1], K.pad, y + 2, inner, { lines = K.noteLines, line = K.noteLine, color = C[note[2]] or C.text })
			y += linesOf(label, K.noteLine) * K.noteLine
		end
	end

	-- 단추 — 또는 버릴 수를 고르는 줄
	local ask = spec.ask
	if ask then
		y += K.btnTop
		Ui.text(panel, ask.text, K.pad, y, inner, { color = C.gold })
		y += M.smallLine + 4
		if ask.steps then
			-- [-10] [-1]  수  [+1] [+10]
			local step = K.stepW
			local xs = { 0, step + K.btnGap, inner - step * 2 - K.btnGap, inner - step }
			for i, s in ask.steps do
				Ui.button(panel, s.text, K.pad + xs[i], y, step, s.onClick, { font = "small" }).frame.Name = "Step" .. i
			end
			local mid = xs[2] + step
			Ui.text(panel, tostring(ask.n), K.pad + mid, y + math.floor((M.button - M.body) / 2), xs[3] - mid, { font = "body", align = "center" })
			y += M.button + K.btnGap
		end
		local half = Layout.detailButtonW(2)
		Ui.button(panel, ask.yes.text, K.pad, y, half, ask.yes.onClick, { main = true }).frame.Name = "Yes"
		Ui.button(panel, ask.no.text, K.pad + half + K.btnGap, y, half, ask.no.onClick).frame.Name = "No"
		y += M.button
	elseif #spec.buttons > 0 then
		y += K.btnTop
		local n = #spec.buttons
		local perRow = math.min(n, K.btnCols)
		local bw = Layout.detailButtonW(perRow)
		for i, b in spec.buttons do
			local col, row = (i - 1) % perRow, (i - 1) // perRow
			local button = Ui.button(panel, b.text, K.pad + col * (bw + K.btnGap), y + row * (M.button + K.btnGap), bw, b.onClick, { main = b.main == true })
			button.frame.Name = "Do" .. i
			button:setEnabled(not b.off)
		end
		local rows = math.ceil(n / perRow)
		y += rows * M.button + (rows - 1) * K.btnGap
	end
	local h = y + K.pad
	holder.Size = UDim2.fromOffset(K.w, h)
	panel.Size = UDim2.fromOffset(K.w, h)
	local back = panel:FindFirstChild("Back")
	if back then
		(back :: ImageLabel).Size = UDim2.fromOffset(K.w, h)
	end
	shown = { owner = owner, key = spec.key, holder = holder }
end

return ItemDetail

end
MODULES['Client/lune/ui/keysWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 키 설정 창(넓은 창) — 하는 일마다 지금 키가 적힌 단추가 있다. 단추를 누른 뒤 새 키를 누르면 바뀐다.
--  이미 쓰는 키면 둘이 자리를 바꾼다. 「기본으로」는 처음 세팅으로 돌린다. 바꾼 것은 서버에 저장된다(캐릭터마다).
--  사용자 결정(2026-10-06): 기본 키를 주되 유저가 자유롭게 바꾼다. 화면 오른쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Format = require(ReplicatedStorage.shared.lune.ui.format)
local Ui = require(script.Parent.ui)
local Input = require(script.Parent.Parent.input)

local C = Ui.COLOR
local ROW = Ui.M.button + 4
local PER_COLUMN = 10
local COLUMNS = 3 -- 세 단: 기본 동작 · 창을 여는 키 · 퀵슬롯의 키 차례로 채운다
local COL_W, GAP = 190, 16 -- 한 단의 폭 · 단 사이
local KEY_W = 70 -- 키가 적힌 단추의 폭

local KeysWindow = { wide = true }

function KeysWindow.size(): (number, number)
	return COL_W * COLUMNS + GAP * (COLUMNS - 1), 34 + PER_COLUMN * ROW
end

-- 화면에 적을 "하는 일"의 차례와 이름. ctx.actions() = { { action, name } … }
function KeysWindow.build(body: Frame, ctx, w: number, _h: number)
	local actions = ctx.actions()
	local buttons = {}
	local waiting: string? = nil
	local note = Ui.text(body, "바꿀 단추를 누른 뒤 새 키를 누른다", 0, 5, w - 110, { color = C.dim })

	local function redraw()
		for _, item in actions do
			local key = Input.BIND[item.action]
			local b = buttons[item.action]
			if b then
				b:setText(if waiting == item.action then "…" else Format.key(if key then key.Name else "-"))
				b:setMain(waiting == item.action)
			end
		end
		note:set(if waiting then "새 키를 누른다(같은 단추를 다시 누르면 그만둔다)" else "바꿀 단추를 누른 뒤 새 키를 누른다")
	end

	for i, item in actions do
		if i > PER_COLUMN * COLUMNS then
			break -- 세 단에 들어가는 만큼만
		end
		local col = (i - 1) // PER_COLUMN
		local row = (i - 1) % PER_COLUMN
		local x, y = col * (COL_W + GAP), 34 + row * ROW
		Ui.text(body, item.name, x, y + 7, COL_W - KEY_W - 8, { font = "body" })
		buttons[item.action] = Ui.button(body, "", x + COL_W - KEY_W, y, KEY_W, function()
			if waiting == item.action then
				waiting = nil
				Input.capture(nil)
				redraw()
				return
			end
			waiting = item.action
			redraw()
			Input.capture(function(key: Enum.KeyCode)
				Input.rebind(item.action, key)
				waiting = nil
				redraw()
				ctx.saveKeys()
			end)
		end)
	end
	Ui.button(body, "기본으로", w - 100, 0, 100, function()
		waiting = nil
		Input.capture(nil)
		ctx.resetKeys()
		redraw()
		ctx.saveKeys()
	end, { h = 22, font = "small" })
	redraw()

	return {
		refresh = function() end,
		destroy = function()
			Input.capture(nil)
		end,
	}
end

return KeysWindow

end
MODULES['Client/lune/ui/kit'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 게임 세계의 부품 — 게임 화면(384x216)의 굵은 도트로 그리는 것: 장비 그림(땅에 떨어진 것 · 주민 머리 위의 표시) · 떨어진 돈과 달가루 · 피해 숫자.
--  화면의 글씨와 틀(판 · 칸 · 단추 · 창)은 여기 것이 아니다 — 화면 틀의 고운 격자에 그리는 ui/ui.luau를 쓴다.
--  부품 그림 한 장(ui_kit.png)과 그 자리 · 색은 shared/lune/data/kit.generated.luau — 공방의 tools/build_lune_ui.mjs가 짓는다. 여기서 모양을 따로 그리지 않는다.
--  좌표는 게임 화면의 도트.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local KIT = require(lune.data["kit.generated"])
local ASSETS = require(lune.data["assets.generated"])

local Kit = {}
Kit.DATA = KIT
Kit.IMAGE = ASSETS[KIT.image] or ""
Kit.ICON = KIT.icon -- 장비 그림의 한 변(18)
Kit.GROUND = KIT.ground -- 화면에서 땅의 윗면(발밑)의 y
local PARTS = KIT.parts

Kit.COLOR = {}
for name, c in KIT.colors do
	Kit.COLOR[name] = Color3.fromRGB(c[1], c[2], c[3])
end
local C = Kit.COLOR

-- ---------- 그림 ----------
local function image(parent: Instance, name: string, x: number, y: number, w: number, h: number): ImageLabel
	local label = Instance.new("ImageLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.ResampleMode = Enum.ResamplerMode.Pixelated
	label.Image = Kit.IMAGE
	label.Position = UDim2.fromOffset(x, y)
	label.Size = UDim2.fromOffset(w, h)
	label.Parent = parent
	return label
end

-- 그림의 속을 다른 부품으로 바꾼다
function Kit.swap(label: ImageLabel, name: string)
	local p = PARTS[name]
	assert(p, "없는 부품 " .. tostring(name))
	label.ImageRectOffset = Vector2.new(p.x, p.y)
	label.ImageRectSize = Vector2.new(p.w, p.h)
end

-- 부품 하나(떨어진 돈 · 달가루 · 떨어진 장비의 귀퉁이 표시)
function Kit.part(parent: Instance, name: string, x: number, y: number): ImageLabel
	local p = PARTS[name]
	assert(p, "없는 부품 " .. tostring(name))
	local label = image(parent, name, x, y, p.w, p.h)
	Kit.swap(label, name)
	return label
end

-- 부품을 바꿔 끼우는 그림: 이름이 없으면 숨기고, 있으면 그 부품의 크기로 맞춘다(주민 머리 위의 퀘스트 표시 ! · ?)
function Kit.setPart(label: ImageLabel, name: string?)
	label.Visible = name ~= nil
	if name then
		local p = PARTS[name]
		assert(p, "없는 부품 " .. tostring(name))
		label.ImageRectOffset = Vector2.new(p.x, p.y)
		label.ImageRectSize = Vector2.new(p.w, p.h)
		label.Size = UDim2.fromOffset(p.w, p.h)
	end
end

function Kit.partSize(name: string): (number, number)
	local p = PARTS[name]
	return p.w, p.h
end

-- 장비 그림(18x18). 이름은 공방의 아이콘 이름(tools/build_lune_icons.mjs) — 없는 이름이면 빈 그림
function Kit.setIcon(label: ImageLabel, name: string?)
	local sheet = PARTS.icons
	local at = name and sheet.icons[name]
	label.Visible = at ~= nil
	if at then
		label.ImageRectOffset = Vector2.new(sheet.x + at[1], sheet.y + at[2])
		label.ImageRectSize = Vector2.new(sheet.size, sheet.size)
	end
end

function Kit.hasIcon(name: string): boolean
	return PARTS.icons.icons[name] ~= nil
end

function Kit.icon(parent: Instance, name: string?, x: number, y: number): ImageLabel
	local label = image(parent, "Icon", x, y, PARTS.icons.size, PARTS.icons.size)
	Kit.setIcon(label, name)
	return label
end

-- 색 상자(화살 · 땅속을 메우는 바탕)
function Kit.box(parent: Instance, x: number, y: number, w: number, h: number, color: Color3?, alpha: number?): Frame
	local f = Instance.new("Frame")
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	f.BackgroundColor3 = color or C.line
	f.BackgroundTransparency = alpha or 0
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end

-- 틀만 있는 빈 자리(그 안에 부품을 놓는다)
function Kit.group(parent: Instance, x: number, y: number, w: number, h: number): Frame
	return Kit.box(parent, x, y, w, h, C.line, 1)
end

-- 피해 숫자: 공방 「횡스크롤 시험」 탭의 3x5 점 숫자 그대로(dino-workshop/js/lune/fx.js의 num — 사용자 2026-10-07:
--  "데미지 폰트는 이전 횡스크롤 시험 탭에서 실제 플레이할때의 데미지 출력이랑 동일해야합니다").
--  속에는 색을 입히고, 위 · 아래 · 옆 한 점의 테두리는 늘 같은 어두운 색이다. 틀의 왼쪽 위가 테두리의 왼쪽 위 — width = 글자 수 x 4 + 1.
function Kit.dmg(parent: Instance, text: string, color: Color3)
	local sheet = PARTS.dmg
	local frame = Kit.group(parent, 0, 0, 1, sheet.ch)
	frame.Name = "Dmg"
	local fills = {}
	local n = 0
	for i = 1, #text do
		local d = tonumber(text:sub(i, i))
		if d then
			local line = image(frame, "line", n * sheet.adv, 0, sheet.cw, sheet.ch)
			line.ImageRectOffset = Vector2.new(sheet.x + d * sheet.cw, sheet.y + sheet.ch)
			line.ImageRectSize = Vector2.new(sheet.cw, sheet.ch)
			local fill = image(frame, "fill", n * sheet.adv, 0, sheet.cw, sheet.ch)
			fill.ImageRectOffset = Vector2.new(sheet.x + d * sheet.cw, sheet.y)
			fill.ImageRectSize = Vector2.new(sheet.cw, sheet.ch)
			fill.ImageColor3 = color
			fill.ZIndex = 2
			table.insert(fills, fill)
			n += 1
		end
	end
	local width = n * sheet.adv + 1
	frame.Size = UDim2.fromOffset(width, sheet.ch)
	local item = { frame = frame, width = width, height = sheet.ch }
	function item.color(_, tint: Color3)
		for _, g in fills do
			g.ImageColor3 = tint
		end
	end
	return item
end

return Kit

end
MODULES['Client/lune/ui/mapWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 월드맵 창(M) — 그림으로 된 지역 지도 위에 장소의 표시를 얹는다(메이플스토리의 월드맵처럼).
--  사용자 2026-10-11: "월드맵 똑바로 그리세요 다른 게임 월드맵 참고라도 하던가 퀄리티가 이게 뭡니까 없는게 나은수준인데" — 전의 것은 네모를 선으로 이은 도표였다(없앴다).
--  사용자 같은 날(이 창을 보고): "바위틈 같은 사냥터 표시안되고, 은달항구의 경우 지금 수비대 야영지에서 포탈로 갈수있는데 맵에서는 그냥 좌측 은달항구라고 나와버리면 어떻게 하라는건지?"
--   → 곁맵(굽잇길의 문 「바위 틈으로」 = 옛 은신처 · 멧돼지 굴)도 싣고, 모든 장소에 이름표를 달고, 은달 항구는 수비대 야영지에서 점줄로 이어진 표시로 그린다.
--  왼쪽: 지역의 그림(384x256 · Codex로 그려 옮긴 것 — 공방 assetpack/lune/worldmap) 위에
--   ① 장소마다 동그란 표시(갈래의 색: 마을 민트 · 쉼터 노랑 · 사냥터 흰색 · 던전 분홍 · 곁맵 회색 · 보스 빨강)와 이름표(서로 겹치지 않게 아래 · 위 · 옆에 놓는다 — WM.placeLabels)
--   ② 내가 있는 곳: 민트 고리와 그 위의 화살표, 민트 이름표 ③ 퀘스트를 받을 곳 「!」 · 돌려줄 곳 「?」 ④ 내 레벨에 맞는 사냥터: 풀빛 고리와 풀빛 이름표
--   ⑤ 지금 가야 할 곳까지의 길: 표시 사이를 잇는 금빛 점줄 ⑥ 다른 지역(은달 항구): 그 도시가 그려진 자리의 민트 표시 — 그리로 가는 포탈이 있는 장소(수비대 야영지)에서 민트 점줄로 잇는다
--  오른쪽: 고른 장소의 이름 · 갈래 · 레벨 · 다른 지역으로 가는 포탈 · 몬스터 · 주민, 내 레벨의 사냥터, 가는 길(글).
--  그림이 있는 지역만 보여 준다(그림이 없는 지역은 탭도 없다 — 도표로 때우지 않는다). 이동하는 기능은 없다(보기만 한다).
--  셈은 shared/lune/ui/worldmap.luau, 자리는 data/worldmap.generated.luau의 art(공방 js/lune/design/journey.js의 WORLDART).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local WM = require(lune.ui.worldmap)
local ASSETS = require(lune.data["assets.generated"])
local UI = require(lune.data["ui.generated"])
local Ui = require(script.Parent.ui)
local Kit = require(script.Parent.kit)

local C = Ui.COLOR

local MapWindow = { wide = true }
MapWindow.ART_W, MapWindow.ART_H = WM.ART_W, WM.ART_H -- 그림의 크기(화면 틀의 점 — 그림의 한 점이 화면 틀의 한 점)
MapWindow.SIDE_W, MapWindow.GAP = WM.SIDE_W, 12 -- 오른쪽 글 칸의 폭 · 그림과의 사이
MapWindow.TAB_H = 22 -- 탭 줄(그림이 있는 지역이 둘 넘을 때만)
MapWindow.PIN = WM.PIN -- 표시의 반지름

-- 장소의 갈래마다의 색
local KIND = { town = C.accent, village = C.accent, rest = C.gold, hunt = C.text, road = C.dim, climb = C.pink, dead = C.dim, boss = C.red }

function MapWindow.size(): (number, number)
	local tabs = if #WM.arted() > 1 then MapWindow.TAB_H else 0
	return MapWindow.ART_W + MapWindow.GAP + MapWindow.SIDE_W, tabs + MapWindow.ART_H
end

-- 동그란 표시(네모를 겹쳐 모서리를 깎는다): 어두운 테두리 + 속
local function dot(parent: Instance, x: number, y: number, r: number, color: Color3, name: string)
	local holder = Ui.group(parent, x - r - 1, y - r - 1, r * 2 + 3, r * 2 + 3, name)
	local c = r + 1
	Ui.box(holder, c - r - 1, c - r + 1, r * 2 + 3, r * 2 - 1, C.ink)
	Ui.box(holder, c - r + 1, c - r - 1, r * 2 - 1, r * 2 + 3, C.ink)
	Ui.box(holder, c - r, c - r, r * 2 + 1, r * 2 + 1, C.ink)
	Ui.box(holder, c - r, c - r + 2, r * 2 + 1, r * 2 - 3, color).Name = "Fill"
	Ui.box(holder, c - r + 2, c - r, r * 2 - 3, r * 2 + 1, color).Name = "Fill"
	Ui.box(holder, c - r + 1, c - r + 1, r * 2 - 1, r * 2 - 1, color).Name = "Fill"
	return holder
end

-- 고리(표시 둘레의 한 점 굵기의 네모 테두리 — 내가 있는 곳 · 내 레벨의 사냥터)
local function ring(parent: Instance, x: number, y: number, r: number, color: Color3, name: string)
	local s = r * 2 + 1
	for _, b in { { x - r, y - r, s, 1 }, { x - r, y + r, s, 1 }, { x - r, y - r, 1, s }, { x + r, y - r, 1, s } } do
		Ui.box(parent, b[1], b[2], b[3], b[4], color).Name = name
	end
end

-- 점줄: 표시에서 표시로 곧게, 다섯 점마다 한 점
local function dots(parent: Instance, a, b, color: Color3, name: string)
	local dx, dy = b[1] - a[1], b[2] - a[2]
	local n = math.max(1, math.floor(math.sqrt(dx * dx + dy * dy) / 5))
	for k = 1, n - 1 do
		Ui.box(parent, math.floor(a[1] + dx * k / n) - 1, math.floor(a[2] + dy * k / n) - 1, 2, 2, color).Name = name
	end
end

-- 이름표: 어두운 판 위의 작은 글(자리는 WM.placeLabels가 정한 것)
local function plate(parent: Instance, text: string, rect, color: Color3, name: string)
	local holder = Ui.group(parent, rect.x, rect.y, rect.w, rect.h, name)
	Ui.box(holder, 0, 0, rect.w, rect.h, C.ink, 0.15)
	Ui.box(holder, 0, rect.h - 1, rect.w, 1, color, 0.4)
	Ui.text(holder, text, WM.PLATE.padX, 2, rect.w - WM.PLATE.padX * 2, { color = color })
	return holder
end

function MapWindow.build(body: Frame, ctx, w: number, _h: number)
	local view = {}
	local regions = WM.arted()
	local myRegion = WM.nodeOf(ctx.scene())
	local rid = if myRegion and WM.region(myRegion).art then myRegion else regions[1]
	local picked: string? = nil -- 누른 장소(없으면 내가 있는 곳). 다른 지역의 표시는 "out:지역"
	local layer: Frame? = nil
	local top = if #regions > 1 then MapWindow.TAB_H else 0

	local tabs = {}
	if #regions > 1 then
		local tx = 0
		for i, id in regions do
			tabs[i] = Ui.tab(body, WM.region(id).name, tx, 0, function()
				if rid ~= id then
					rid = id
					picked = nil
					view.refresh()
				end
			end)
			tabs[i].region = id
			tx += tabs[i].width + 14
		end
	end

	-- 그림(지역을 바꿀 때 갈아 끼운다)
	local art = Instance.new("ImageLabel")
	art.Name = "Art"
	art.BackgroundColor3 = C.ink
	art.BorderSizePixel = 0
	art.ResampleMode = Enum.ResamplerMode.Pixelated
	art.Position = UDim2.fromOffset(0, top)
	art.Size = UDim2.fromOffset(MapWindow.ART_W, MapWindow.ART_H)
	art.Parent = body
	-- 그림의 테두리(한 점)
	for _, b in { { 0, 0, MapWindow.ART_W, 1 }, { 0, MapWindow.ART_H - 1, MapWindow.ART_W, 1 }, { 0, 0, 1, MapWindow.ART_H }, { MapWindow.ART_W - 1, 0, 1, MapWindow.ART_H } } do
		local edge = Ui.box(art, b[1], b[2], b[3], b[4], C.lineHot)
		edge.Name = "Edge"
		edge.ZIndex = 8
	end

	-- 오른쪽 글 칸
	local sx, sw = MapWindow.ART_W + MapWindow.GAP, MapWindow.SIDE_W
	local side = Ui.group(body, sx, top, sw, MapWindow.ART_H, "Side")
	local head = Ui.text(side, "", 0, 0, sw, { font = "body", color = C.gold })
	local headLv = Ui.text(side, "", 0, 3, sw, { align = "right", color = C.dim })
	Ui.box(side, 0, 20, sw, 1, C.lineHot)
	local name = Ui.text(side, "", 0, 26, sw, { font = "body" })
	local sub = Ui.text(side, "", 0, 43, sw, { color = C.dim })
	local link = Ui.text(side, "", 0, 57, sw, { color = C.accent })
	local mobHead = Ui.text(side, "몬스터", 0, 73, sw, { color = C.off })
	local mobs = Ui.text(side, "", 0, 86, sw, { lines = WM.SIDE.mobLines, color = C.text })
	local npcHead = Ui.text(side, "주민", 0, 116, sw, { color = C.off })
	local npcs = Ui.text(side, "", 0, 129, sw, { lines = WM.SIDE.npcLines, color = C.text })
	Ui.box(side, 0, 162, sw, 1, C.line)
	Ui.text(side, "내 레벨의 사냥터", 0, 166, sw, { color = C.off })
	local best = Ui.text(side, "", 0, 179, sw, { color = C.green })
	Ui.text(side, "가는 길", 0, 195, sw, { color = C.off })
	local goalTitle = Ui.text(side, "", 0, 208, sw, { color = C.gold })
	local route = Ui.text(side, "", 0, 221, sw, { lines = WM.SIDE.routeLines, color = C.text })

	local function showSide(id: string)
		local region = WM.region(rid)
		local to = string.match(id, "^out:(.+)$")
		local info = if to then WM.outCard(rid, to) else WM.card(rid, id)
		head:set(region.name)
		headLv:set(WM.regionLevels(rid))
		name:set(info.name)
		sub:set(info.sub)
		link:set(info.link)
		mobHead:show(info.mobs ~= "")
		mobs:set(info.mobs)
		npcHead:show(info.npcs ~= "")
		npcs:set(info.npcs)
	end

	-- 그림 위의 표시들을 다시 그린다(지역을 바꿨다 · 퀘스트나 내 자리가 바뀌었다 · 다른 장소를 골랐다)
	function view.draw()
		if layer then
			layer:Destroy()
		end
		local region = WM.region(rid)
		local A = region.art
		art.Image = ASSETS[A.img] or ""
		local group = Ui.group(art, 0, 0, MapWindow.ART_W, MapWindow.ART_H, "Marks")
		group.ZIndex = 2
		layer = group
		local me = ctx.me()
		local level = if me then me.level else 1
		local sceneRegion, sceneNode = WM.nodeOf(ctx.scene())
		local mine = if sceneRegion == rid then sceneNode else nil
		local marks = WM.marks(rid, ctx.quests() or {}, level)
		local bestText, bestNode = WM.recommendShort(rid, level)
		local card = WM.goalCard(ctx.quests() or {}, level, ctx.scene())
		local path, goal = if card then card.route else nil, if card then card.goal else nil
		for _, t in tabs do
			t:setOn(t.region == rid)
		end
		-- ⑥ 다른 지역으로 가는 길: 포탈이 있는 장소에서 그 지역의 표시까지 민트 점줄(늘 보인다)
		for _, ex in WM.exits(rid) do
			local from, to = A.at[ex.node], A.out[ex.to]
			if from and to then
				dots(group, from, to, C.accent, "OutLink")
			end
		end
		-- ⑤ 가는 길: 이 지역을 지나는 구간마다 금빛 점줄(다른 지역으로 넘어가는 구간은 그 지역의 표시까지)
		local goalNode = nil
		if path then
			for i = 2, #path do
				local a, b = path[i - 1], path[i]
				local pa = if a.region == rid then A.at[a.node] else A.out[a.region]
				local pb = if b.region == rid then A.at[b.node] else A.out[b.region]
				if pa and pb and (a.region == rid or b.region == rid) then
					dots(group, pa, pb, C.gold, "Route")
				end
			end
			local last = path[#path]
			if goal then
				goalNode = if last.region == rid then last.node else "out:" .. last.region
			end
		end
		-- 그릴 것들: 장소들과 다른 지역들. 이름표는 내가 있는 곳 → 가야 할 곳 → 내 레벨의 사냥터 → 고른 곳 → 마을 · 쉼터 → 나머지의 차례로 자리를 잡는다
		local pins = {}
		for _, n in region.nodes do
			local at = A.at[n.id]
			if at then
				table.insert(pins, { id = n.id, x = at[1], y = at[2], r = MapWindow.PIN[n.kind] or 4, text = n.label, node = n, color = KIND[n.kind] or C.text })
			end
		end
		for to, at in A.out or {} do
			local other = WM.region(to)
			if other then
				table.insert(pins, { id = "out:" .. to, x = at[1], y = at[2], r = MapWindow.PIN.out, text = other.name, color = C.accent, out = to })
			end
		end
		local function rank(p): number
			if p.id == mine then
				return 1
			elseif p.id == goalNode then
				return 2
			elseif p.id == bestNode then
				return 3
			elseif p.id == picked then
				return 4
			elseif p.out or (p.node and (p.node.kind == "town" or p.node.kind == "village" or p.node.kind == "rest")) then
				return 5
			end
			return 6
		end
		local order = table.clone(pins)
		for i, p in order do
			p.w = Ui.measure(p.text)
			p.rank, p.at = rank(p), i
		end
		table.sort(order, function(a, b)
			if a.rank ~= b.rank then
				return a.rank < b.rank
			end
			return a.at < b.at
		end)
		local places = WM.placeLabels(order)
		for _, p in pins do
			local x, y, r = p.x, p.y, p.r
			if p.id == bestNode then
				ring(group, x, y, r + 3, C.green, "Best")
			end
			if p.id == mine then
				ring(group, x, y, r + 3, C.accent, "Here")
			end
			dot(group, x, y, r, p.color, "Pin_" .. p.id)
			-- ③ 퀘스트의 표시: 표시의 오른쪽 위에
			local mark = if p.node then marks[p.id] else nil
			if mark then
				local part = Kit.part(group, if mark == "?" then UI.questMark.done else UI.questMark.new, 0, 0)
				part.Position = UDim2.fromOffset(x + r, y - r - part.Size.Y.Offset + 2)
				part.Name = "Quest"
				part.ZIndex = 5
			end
			-- 이름표
			local rect = places[p.id]
			if rect then
				local color = if p.id == mine then C.accent elseif p.id == goalNode then C.gold elseif p.id == bestNode then C.green elseif p.id == picked then C.text elseif p.out then C.accent else C.dim
				plate(group, p.text, rect, color, "Name_" .. p.id)
			end
			-- ② 내가 있는 곳의 화살표(아래로 뾰족한 세 줄) — 이름표가 위에 놓였으면 그 위에
			if p.id == mine then
				local topY = y - r - 4
				if rect and rect.y + rect.h <= y and rect.x < x + 4 and rect.x + rect.w > x - 4 then
					topY = math.min(topY, rect.y - 1)
				end
				for i, wdt in { 5, 3, 1 } do
					Ui.box(group, x - math.floor(wdt / 2) - 1, topY - 8 + i * 2 - 1, wdt + 2, 3, C.ink).Name = "Arrow"
				end
				for i, wdt in { 5, 3, 1 } do
					Ui.box(group, x - math.floor(wdt / 2), topY - 8 + i * 2, wdt, 1, C.accent).Name = "Arrow"
				end
			end
			-- 누르면 고른다(표시와 이름표 어느 쪽을 눌러도)
			local zone = Ui.group(group, x - 9, y - 9, 19, 19, "Hit_" .. p.id)
			zone.ZIndex = 6
			Ui.hit(zone).Activated:Connect(function()
				picked = p.id
				view.refresh()
			end)
			if rect then
				local zone2 = Ui.group(group, rect.x, rect.y, rect.w, rect.h, "HitName_" .. p.id)
				zone2.ZIndex = 6
				Ui.hit(zone2).Activated:Connect(function()
					picked = p.id
					view.refresh()
				end)
			end
		end
		-- 오른쪽 글 칸: 고른 곳(없으면 내가 있는 곳 — 다른 지역을 보는 중이면 그 지역의 첫 장소)
		showSide(picked or mine or region.nodes[1].id)
		best:set(bestText)
		best:color(if bestNode then C.green else C.dim)
		goalTitle:set(if card then card.title else "지금 가야 할 곳이 없다")
		goalTitle:color(if card then C.gold else C.off)
		route:set(if card then card.text else "")
	end

	-- 내 상태가 올 때마다 불린다(사냥 중에는 자주) — 그림에 드러나는 것이 바뀌었을 때만 다시 그린다
	local last = ""
	function view.refresh()
		local me = ctx.me()
		local level = if me then me.level else 1
		local parts = { rid, tostring(picked), tostring(ctx.scene()), tostring(level) }
		local marks = WM.marks(rid, ctx.quests() or {}, level)
		for _, n in WM.region(rid).nodes do
			table.insert(parts, marks[n.id] or "-")
		end
		local card = WM.goalCard(ctx.quests() or {}, level, ctx.scene())
		table.insert(parts, if card then card.title .. card.text else "")
		local sig = table.concat(parts, "|")
		if sig ~= last then
			last = sig
			view.draw()
		end
	end

	function view.destroy()
		if layer then
			layer:Destroy()
			layer = nil
		end
	end
	return view
end

return MapWindow

end
MODULES['Client/lune/ui/partyWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 파티 창(O · Lv.10부터) — 위에 파티원(넷까지: 이름 · 레벨 · 파티장 표시)과 「나가기」, 아래에 같은 맵에 있는 사람들과 「초대」.
--  초대 · 나가기는 서버에 부탁한다(Party). 파티 찾기(멀리 있는 사람과 맺기)는 아직 없다. 화면 오른쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Party = require(lune.sim.party)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local W = 300
local LINE = 18 -- 파티원 한 줄
local ROW = Ui.M.button + 4 -- 같은 맵의 사람 한 줄(초대 단추)

local PartyWindow = {}
PartyWindow.NAME_W = W - 80 -- 「Lv.150 이름(열두 자)」가 들어가는 폭 — 넘으면 줄여 적는다
PartyWindow.NEAR = 4 -- 같은 맵의 사람을 몇 줄까지 보이나

function PartyWindow.size(): (number, number)
	return W, 20 + Party.MAX * LINE + 8 + Ui.M.button + 12 + 22 + PartyWindow.NEAR * ROW
end

function PartyWindow.line(level: number, name: string): string
	return ("Lv.%d %s"):format(level, name)
end

function PartyWindow.build(body: Frame, ctx, w: number, _h: number)
	local view = {}
	Ui.text(body, "파티원", 0, 0, 120, { color = C.gold })
	local count = Ui.text(body, "", w - 60, 0, 60, { align = "right", color = C.dim })
	local members = {}
	for i = 1, Party.MAX do
		local y = 20 + (i - 1) * LINE
		members[i] = { name = Ui.text(body, "", 0, y, PartyWindow.NAME_W, { font = "body" }), mark = Ui.text(body, "", w - 70, y + 1, 70, { align = "right", color = C.accent }) }
	end
	local y = 20 + Party.MAX * LINE + 8
	local leave = Ui.button(body, "파티 나가기", 0, y, w, function()
		ctx.send("Party", "leave")
	end)
	y += Ui.M.button + 10
	Ui.line(body, 0, y, w)
	Ui.text(body, "같은 맵의 사람", 0, y + 8, 160, { color = C.gold })
	y += 26
	local near = {}
	for i = 1, PartyWindow.NEAR do
		local ry = y + (i - 1) * ROW
		local row = { name = Ui.text(body, "", 0, ry + 7, PartyWindow.NAME_W, { font = "body" }), id = nil :: any }
		row.button = Ui.button(body, "초대", w - 64, ry, 64, function()
			if row.id then
				ctx.send("Party", "invite", row.id)
			end
		end)
		near[i] = row
	end

	function view.refresh()
		local me, party, myId = ctx.me(), ctx.party(), ctx.myId()
		if not me then
			return
		end
		local list = (party and party.members) or {}
		local inParty = {}
		for i, row in members do
			local m = list[i]
			if m then
				inParty[m.id] = true
				row.name:set(PartyWindow.line(m.level, m.name))
				row.name:color(if m.id == myId then C.text else C.accent)
				row.mark:set(if m.id == party.leader then "파티장" else "")
			else
				row.name:set(if i == 1 and #list == 0 then "파티가 없다" else "")
				row.name:color(C.dim)
				row.mark:set("")
			end
		end
		count:set(("%d / %d"):format(#list, Party.MAX))
		leave:setEnabled(#list > 0)
		-- 초대할 수 있는 사람: 내가 파티장이거나 파티가 없을 때, 자리가 남았을 때
		local canInvite = (#list == 0 or party.leader == myId) and #list < Party.MAX
		local others = {}
		for _, o in ctx.others() do
			if not inParty[o.id] then
				table.insert(others, o)
			end
		end
		for i, row in near do
			local o = others[i]
			row.id = if o then o.id else nil
			row.name:set(if o then PartyWindow.line(o.level, o.name) elseif i == 1 then "아무도 없다" else "")
			row.name:color(if o then C.text else C.dim)
			row.button.frame.Visible = o ~= nil
			row.button:setEnabled(canInvite)
		end
	end
	return view
end

return PartyWindow

end
MODULES['Client/lune/ui/questWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 퀘스트 창(J) — 메이플스토리의 퀘스트 창처럼 탭 셋: 「진행 중」 · 「시작 가능」 · 「완료」(2026-10-11 — 전에는 하는 중인 것 넷만 보였다).
--  위에 그 탭의 목록(메인 · 전직은 노랑), 고르면 아래에 줄거리와 그 탭에 맞는 것:
--   진행 중 = 할 일(다 됐으면 풀빛) · 무엇을 어디서 잡는지 · 보상 · 주민의 부탁은 「그만두기」
--   시작 가능 = 누구에게 · 어디서 받는지(「샛별 · 초승달 마을」) · 보상. 레벨이 모자란 다음 메인도 맨 끝에 흐리게 뜬다(「Lv.4가 되면 받는다」)
--   완료 = 줄거리와 받은 보상
--  받는 것과 돌려주는 것은 주민 앞에서 한다(머리 위의 ! · ?). 목록이 줄 수보다 길면 ▲ ▼로 넘긴다.
--  보상은 한 줄에 조각들로: 「경험치 441」 · [달돈 그림] 73 · [물약 그림] x10 · [무기 그림] Lv.30 창 — 아이템은 그 그림과 함께
--   (사용자 2026-10-13: "강화창이랑 퀘스트 보상에 아이템그림 들어가야합니다." — 그 앞에는 「경험치 441 · 달돈 73 · 물약 10」처럼 글뿐이었다)
--  화면 오른쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Quests = require(lune.sim.quests)
local Items = require(lune.sim.items)
local Format = require(lune.ui.format)
local Ui = require(script.Parent.ui)
local ItemCell = require(script.Parent.itemCell)

local C = Ui.COLOR
local ROWS = 5
local ROW = 26 -- 목록의 한 줄
local W = 300
local TAB_H = 22
local TABS = { "진행 중", "시작 가능", "완료" }

local QuestWindow = {}
QuestWindow.ROWS = ROWS
QuestWindow.TABS = TABS
QuestWindow.TEXT_LINES = 5 -- 줄거리가 쓰는 줄 수
QuestWindow.W = W

function QuestWindow.size(): (number, number)
	return W, TAB_H + ROWS * ROW + 12 + QuestWindow.TEXT_LINES * 16 + 8 + 16 + 16 + 20 + Ui.M.button + 4
end

-- 보상의 조각들(왼쪽부터 놓는다) { icon 그림 이름(없으면 글만), text }: 「2차 전직」 · 「경험치 441」 · [달돈] 73 · [물약] x10 · [무기] Lv.30 창
--  물약은 내 레벨에 쓸 수 있는 가장 좋은 것, 장비는 내 직업의 것 · 성능은 보통(sim/hero.luau의 questDone이 주는 그대로)
QuestWindow.REWARD_MAX = 5 -- 조각의 수(전직 · 경험치 · 달돈 · 물약 · 장비)
QuestWindow.REWARD_GAP = 12 -- 조각 사이
QuestWindow.REWARD_ICON = 21 -- 그림(18)과 그 뒤의 글 사이까지
function QuestWindow.rewardParts(reward, level: number, class: string)
	local parts = {}
	if reward.job then
		table.insert(parts, { text = ("%d차 전직"):format(reward.job) })
	end
	if reward.xp > 0 then
		table.insert(parts, { text = ("경험치 %s"):format(Format.short(reward.xp)) })
	end
	if reward.money > 0 then
		table.insert(parts, { icon = "coin", text = Format.short(reward.money) })
	end
	if reward.potions > 0 then
		table.insert(parts, { icon = Items.potionFor(level).icon, text = ("x%d"):format(reward.potions) })
	end
	if reward.gear then
		local it = Items.make(reward.gear.slot, reward.gear.stage, Items.data.NORMAL, class)
		table.insert(parts, { icon = ItemCell.icon(it), text = Items.name(it) })
	end
	return parts
end
-- 조각들의 자리: { { icon = 그림의 x(그림이 없으면 nil), text = 글의 x } … } 와 전체 폭(창의 폭 안이어야 한다 — 자동 검사가 모든 퀘스트 x 직업으로 본다)
function QuestWindow.rewardLayout(parts)
	local at, x = {}, 0
	for i, p in parts do
		local iconX = nil
		if p.icon then
			iconX = x
			x += QuestWindow.REWARD_ICON
		end
		at[i] = { icon = iconX, text = x }
		x += Ui.measure(p.text) + (if i < #parts then QuestWindow.REWARD_GAP else 0)
	end
	return at, x
end

-- 그 탭의 목록(퀘스트의 이름표들). tab = 1 진행 중 · 2 시작 가능 · 3 완료
function QuestWindow.listOf(tab: number, book, level: number): { string }
	if tab == 2 then
		return Quests.listOpen(book, level)
	elseif tab == 3 then
		return Quests.listDone(book)
	end
	return Quests.active(book)
end

-- 「시작 가능」에서 고른 퀘스트의 받는 곳: 「샛별 · 초승달 마을」
function QuestWindow.giverText(def, names): string
	local who = (names and names[def.giver]) or "주민"
	local place = Quests.giverPlace(def)
	return if place then ("받는 곳: %s · %s"):format(who, place) else ("받는 곳: %s"):format(who)
end

function QuestWindow.build(body: Frame, ctx, w: number, _h: number)
	local view = {}
	local tab = 1
	local selected: { string? } = { nil, nil, nil } -- 탭마다 고른 퀘스트
	local top = 0 -- 목록의 첫 줄(넘긴 수)
	local tabs = {}
	local tx = 0
	for i, name in TABS do
		tabs[i] = Ui.tab(body, name, tx, 0, function()
			if tab ~= i then
				tab = i
				top = 0
				view.refresh()
			end
		end)
		tx += tabs[i].width + 16
	end
	local up = Ui.button(body, "▲", w - 38, -3, 17, function()
		top = math.max(0, top - 1)
		view.refresh()
	end, { h = 17 })
	local down = Ui.button(body, "▼", w - 17, -3, 17, function()
		top += 1
		view.refresh()
	end, { h = 17 })
	local rows = {}
	-- 목록: 고른 줄은 왼쪽에 민트 줄, 이름은 본문 글씨(메인 · 전직은 노랑 · 아직 못 받는 것은 흐리게)
	for i = 1, ROWS do
		local y = TAB_H + (i - 1) * ROW
		local frame = Ui.group(body, 0, y, w, ROW - 2, "Row" .. i)
		local back = Ui.box(frame, 0, 0, w, ROW - 2, C.panel2, 1)
		local mark = Ui.box(frame, 0, 0, 2, ROW - 2, C.accent)
		local name = Ui.text(frame, "", 10, 6, w - 70, { font = "body" })
		local lv = Ui.text(frame, "", w - 56, 7, 50, { align = "right", color = C.dim })
		local row = { id = nil :: string?, frame = frame, back = back, mark = mark, name = name, lv = lv }
		Ui.hit(frame).Activated:Connect(function()
			selected[tab] = row.id
			view.refresh()
		end)
		rows[i] = row
	end
	local y = TAB_H + ROWS * ROW + 4
	Ui.line(body, 0, y, w)
	local text = Ui.text(body, "", 0, y + 8, w, { lines = QuestWindow.TEXT_LINES, line = 16, color = C.dim })
	y += 8 + QuestWindow.TEXT_LINES * 16 + 8
	local todo = Ui.text(body, "", 0, y, w)
	-- 할 일 아래에: 무엇을 어디서 잡아야 하는지(사용자 2026-10-07: "뭘잡아야 갑옷조각이 나오는지를 자연스럽게 적어둬야")
	local where = Ui.text(body, "", 0, y + 16, w, { color = C.accent })
	-- 보상: 조각들을 왼쪽부터 — 아이템은 그 그림(18x18)과 글, 경험치 · 전직은 글만
	local ry = y + 33
	local rewards = {}
	for i = 1, QuestWindow.REWARD_MAX do
		rewards[i] = { icon = Ui.smallIcon(body, "coin", 0, ry), text = Ui.text(body, "", 0, ry + 4, w, { color = C.gold }) }
	end
	local function showReward(reward, level: number, class: string)
		local parts = if reward then QuestWindow.rewardParts(reward, level, class) else {}
		local at = QuestWindow.rewardLayout(parts)
		for i, slot in rewards do
			local p = parts[i]
			Ui.setWorldIcon(slot.icon, if p then p.icon else nil)
			slot.text:set(if p then p.text else "")
			if p then
				if at[i].icon then
					slot.icon.Position = UDim2.fromOffset(at[i].icon, ry)
				end
				slot.text:move(at[i].text, ry + 4)
			end
		end
	end
	local drop = Ui.button(body, "그만두기", w - 100, y + 54, 100, function()
		if tab == 1 and selected[1] then
			ctx.send("Quest", "drop", selected[1])
			selected[1] = nil
		end
	end)
	function view.refresh()
		local book = ctx.quests() or {}
		local me = ctx.me()
		local level = if me then me.level else 1
		local class = if me then me.class else "axion"
		local list = QuestWindow.listOf(tab, book, level)
		for i, t in tabs do
			t:setOn(i == tab)
		end
		-- 고른 것이 목록에서 빠졌으면(돌려줬다 · 받았다) 첫 줄을 고른다
		if selected[tab] and not table.find(list, selected[tab] :: string) then
			selected[tab] = nil
		end
		selected[tab] = selected[tab] or list[1]
		top = math.clamp(top, 0, math.max(0, #list - ROWS))
		up.frame.Visible = #list > ROWS
		down.frame.Visible = #list > ROWS
		up:setEnabled(top > 0)
		down:setEnabled(top < #list - ROWS)
		for i, row in rows do
			local id = list[top + i]
			row.id = id
			row.frame.Visible = id ~= nil
			if id then
				local def = Quests.def(id)
				local on = id == selected[tab]
				local locked = tab == 2 and Quests.state(book, level, id) == "locked"
				row.name:set(def.name)
				row.name:color(if locked then C.off elseif def.kind == "side" then C.text else C.gold)
				row.lv:set("Lv." .. def.lv)
				row.lv:color(if locked then C.red else C.dim)
				row.back.BackgroundTransparency = if on then 0 else 1
				row.mark.Visible = on
			end
		end
		local id = selected[tab]
		local def = id and Quests.def(id)
		drop.frame.Visible = false
		if def and tab == 1 then
			text:set(def.text)
			todo:set(table.concat(Quests.todo(book, id, ctx.npcNames()), " · "))
			todo:color(if Quests.isReady(book, id) then C.green else C.text)
			where:set(table.concat(Quests.hints(book, id), " · "))
			where:color(C.accent)
			showReward(def.reward, level, class)
			drop.frame.Visible = def.kind == "side"
		elseif def and tab == 2 then
			local locked = Quests.state(book, level, id) == "locked"
			text:set(def.text)
			todo:set(QuestWindow.giverText(def, ctx.npcNames()))
			todo:color(C.text)
			where:set(if locked then ("Lv.%d가 되면 받는다"):format(def.lv) else "그 주민 앞에서 ↑ 를 눌러 받는다")
			where:color(if locked then C.red else C.accent)
			showReward(def.reward, level, class)
		elseif def then
			text:set(def.text)
			todo:set("끝낸 퀘스트")
			todo:color(C.dim)
			where:set("")
			showReward(def.reward, level, class)
		else
			text:set(if tab == 1
				then "하는 중인 퀘스트가 없다. 머리 위에 ! 가 뜬 주민에게 말을 건다."
				elseif tab == 2 then "지금 받을 수 있는 퀘스트가 없다."
				else "아직 끝낸 퀘스트가 없다.")
			todo:set("")
			where:set("")
			showReward(nil, level, class)
		end
	end
	return view
end

return QuestWindow

end
MODULES['Client/lune/ui/quickEdit'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 퀵슬롯 고치기 — 스킬 창이 열려 있는 동안 스킬을 화면 가운데 아래의 칸에 놓는다.
--  사용자 2026-10-07: "스킬키를 단축키에 등록하기 쉬워야합니다. … 드래그앤 드랍으로 배치도 되어야하고, 스킬탭에서 스킬아이콘을 꾹누르거나 클릭하면 퀵슬롯쪽이 반짝거리고 거기서 퀵슬롯을 누르면 배치된다던가"
--  놓는 법 둘(공방의 횡스크롤 시험 탭 — js/lune/luneTab.js와 같다):
--   ① 끌어다 놓기: 스킬 창의 스킬(또는 칸에 놓인 것)을 누른 채 움직이면 그림이 따라오고, 칸 위에서 놓으면 그 칸에 놓인다. 칸끼리는 자리를 바꾸고, 칸 밖에 놓으면 칸에서 빠진다(물약은 빠지지 않는다).
--   ② 눌러서 놓기: 스킬 창의 스킬을 누르면 칸들이 반짝이고, 칸을 누르면 그 칸에 놓인다(터치도 같은 방법). 같은 스킬을 한 번 더 누르거나 다른 데를 누르면 그만둔다.
--  칸끼리 끌어 자리를 바꾸거나 칸 밖에 놓아 빼는 것은 늘 된다(사용자 2026-10-07: "스킬창열었을때 뿐만아니라 평소에도 퀵슬롯에서 드래그앤 드랍으로 자리를 바꿀수 있어야합니다").
--  소비 아이템(물약)은 가방의 소비 탭에서 끌어다 놓는다("인벤토리 열고 소비아이템도 드래그앤 드랍으로 퀵슬롯에 올릴수있어야합니다"). 칸의 셈은 shared/lune/ui/quick.luau, 그리는 것은 hud.luau.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Quick = require(ReplicatedStorage.shared.lune.ui.quick)
local Layout = require(ReplicatedStorage.shared.lune.ui.layout)
local Stage = require(script.Parent.Parent.stage)
local Hud = require(script.Parent.Parent.hud)
local Ui = require(script.Parent.ui)

local SLOT = Layout.SKILLS.slot
local DRAG = Quick.DATA.drag -- 이만큼 움직이면 끌기로 본다(화면 틀의 점)

local QuickEdit = {}

local hooks = nil -- { slots() → 지금 칸들, apply(새 칸들), state(id) → "ok" · "passive" · "unlearned", changed() }
local open = false -- 놓을 것을 고르는 창(스킬 창 · 가방)이 열려 있다
local picked: string? = nil -- 놓으려고 고른 스킬
local pending = nil -- 누르고 있는 것 { what, from(칸 · 스킬 창에서 온 것이면 nil), start, input, moved, ghost, extra }
-- 가방의 칸에서 끄는 것(ui/bagWindow.luau)도 여기서 맡는다 — 끌기는 한 번에 하나뿐이다. extra = { icon(게임 세계의 그림 이름), size(끌려오는 그림의 한 변),
--   onMove(at) 움직일 때마다, onDrop(at) → 여기서 받았으면 true(그러면 퀵슬롯에는 놓지 않는다), onEnd() 끝났다(놓았든 그만뒀든) }.
--   what이 nil이면(장비 · 기타 아이템) 퀵슬롯에는 놓이지 않고 extra의 일만 한다

local function isPress(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function paint()
	Hud.setPick(picked ~= nil or (pending ~= nil and pending.moved and pending.what ~= nil))
	if hooks.changed then
		hooks.changed()
	end
end

-- 놓으려고 고른 스킬(없으면 nil)
function QuickEdit.picked(): string?
	return picked
end

-- 지금 무엇을 끌고 있는가(누른 채 움직이기 시작했다) — 끌기를 끝낼 때 함께 오는 "눌렀다"를 창이 가려낼 때 쓴다
function QuickEdit.dragging(): boolean
	return pending ~= nil and pending.moved
end

-- 스킬을 고른다: 칸들이 반짝인다. 같은 것을 한 번 더 고르면 그만둔다. nil = 그만둔다
function QuickEdit.pick(id: string?)
	if id ~= nil and (not open or (not Quick.item(id) and hooks.state(id) ~= "ok") or picked == id) then
		id = nil
	end
	if picked ~= id then
		picked = id
		paint()
	end
end

-- 그 스킬이 놓인 칸의 키 이름(없으면 nil)과 놓을 수 있는지
function QuickEdit.info(id: string, kind: string?)
	local i = Quick.find(hooks.slots(), id)
	return { state = hooks.state(id, kind), key = if i then (if Hud.touch then "단추" else Hud.slotKey(i)) else nil } -- 스마트폰: 칸에 키가 없다
end

-- 끌던 것(p)을 놓았다: 칸 위면 그 칸에(칸에서 온 것이면 자리를 바꾼다), 칸 밖이면 칸에서 온 것은 빠진다
local function drop(p, at: Vector2)
	if p.extra and p.extra.onDrop and p.extra.onDrop(at) then
		return -- 가방의 칸에 놓았다
	end
	if not p.what then
		return
	end
	local j = Hud.slotAt(at)
	local slots = hooks.slots()
	local next = nil
	if j then
		next = Quick.place(slots, p.what, j)
	elseif p.from then
		next = Quick.clear(slots, p.from)
	end
	if next then
		hooks.apply(next)
	end
end

-- 누르던 것을 끝낸다. at = 뗀 자리(없으면 그만둔 것 — 놓지 않는다)
local function finish(at: Vector2?)
	local p = pending
	pending = nil
	if not p then
		return
	end
	if p.ghost then
		p.ghost:Destroy()
	end
	if p.moved then
		if at then
			drop(p, at)
		end
		picked = nil
		Hud.setHot(nil)
		paint()
	end
	if p.extra and p.extra.onEnd then
		p.extra.onEnd()
	end
end

-- 누르기 시작했다(끌기가 될 수도 있다). what = 스킬 · 소비 아이템의 이름표(가방의 장비 · 기타 아이템이면 nil), from = 칸(창에서 온 것이면 nil), extra = 가방의 칸에서 끌 때(위의 설명)
function QuickEdit.press(what: string?, from: number?, input: InputObject, extra: any)
	if not isPress(input) or (what == nil and extra == nil) then
		return
	end
	if what ~= nil and from == nil and not Quick.item(what) and hooks.state(what) ~= "ok" then
		return
	end
	finish(nil)
	pending = { what = what, from = from, start = Vector2.new(input.Position.X, input.Position.Y), input = input, moved = false, ghost = nil, extra = extra }
end

-- 스킬 창이 열렸다 · 닫혔다: 닫히면 고르던 것 · 끌던 것을 그만둔다
function QuickEdit.setOpen(on: boolean)
	if open == on then
		return
	end
	open = on
	if not on then
		finish(nil)
		picked = nil
	end
	Hud.setPick(picked ~= nil)
end

function QuickEdit.init(h)
	hooks = h
	-- 칸을 눌렀다: 고른 스킬이 있으면 그 칸에 놓는다
	Hud.onSlotClick = function(i: number)
		if open and picked then
			local next = Quick.place(hooks.slots(), picked, i)
			picked = nil
			if next then
				hooks.apply(next)
			end
			paint()
		end
	end
	-- 칸을 누르기 시작했다: 놓인 것이 있으면 끌 수 있다
	Hud.onSlotPress = function(i: number, input: InputObject)
		local what = hooks.slots()[i]
		if what then
			QuickEdit.press(what, i, input) -- 칸의 것은 늘 끌 수 있다
		end
	end
	UserInputService.InputChanged:Connect(function(input)
		local p = pending
		if not p then
			return
		end
		local mouse = input.UserInputType == Enum.UserInputType.MouseMovement and p.input.UserInputType == Enum.UserInputType.MouseButton1
		if not mouse and input ~= p.input then
			return
		end
		local at = Vector2.new(input.Position.X, input.Position.Y)
		if not p.moved and (at - p.start).Magnitude > DRAG * Stage.uiScale then
			-- 끌기 시작: 그림이 마우스를 따라오고 칸들이 반짝인다
			p.moved = true
			picked = nil
			local size = if p.extra and p.extra.size then p.extra.size else SLOT
			local ghost = Ui.group(Stage.ui, 0, 0, size, size, "DragGhost")
			ghost.ZIndex = 400
			Ui.slot(ghost, 0, 0, size):setOn(true)
			if p.extra and p.extra.icon then
				Ui.worldIcon(ghost, p.extra.icon, 0, 0, size).ZIndex = 2 -- 가방의 것: 칸에 놓인 그 그림(게임의 굵은 도트)
			else
				local pad = math.floor((size - Ui.M.pic) / 2)
				Ui.pic(ghost, Quick.pic(p.what), pad, pad).ZIndex = 2
			end
			p.ghost, p.size = ghost, size
			paint()
		end
		if p.moved then
			local origin = Stage.ui.AbsolutePosition
			p.ghost.Position = UDim2.fromOffset(math.floor((at.X - origin.X) / Stage.uiScale - p.size / 2 + 0.5), math.floor((at.Y - origin.Y) / Stage.uiScale - p.size / 2 + 0.5))
			Hud.setHot(if p.what then Hud.slotAt(at) else nil)
			if p.extra and p.extra.onMove then
				p.extra.onMove(at)
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		local p = pending
		if p and isPress(input) and (input == p.input or input.UserInputType == p.input.UserInputType) then
			finish(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
	UserInputService.WindowFocusReleased:Connect(function()
		finish(nil)
	end)
end

return QuickEdit

end
MODULES['Client/lune/ui/shopWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 상점 · 창고 창 — 주민에게 말을 걸면 가방과 나란히 뜬다(공방 「기본 · UI」 탭). arg = 누구의 것인가:
--   "merchant" 잡화 상인(물약 · Lv.1 방어구) · "smith" 대장장이(달가루 · Lv.10 무기와 방어구) · "store" 창고지기(맡겨 둔 것)
--  값과 물건은 공방 설계 자료(js/lune/design/items.js의 STOCK)에서 온다. 사고 팔고 맡기는 것은 서버에 부탁한다(Item).
--  사용자 2026-10-08: "소비, 기타아이템도 창고에 맡길수있어야하고, 상점에 팔기 가능해야하고 묶음나누기 가능해야하고 창고에 드래그앤 드랍으로 맡기기가능해야합니다."
--   · 창고는 가방과 같은 짜임이다: 탭 셋(장비 · 소비 · 기타) · 탭마다 칸 여섯 x 넷. 가방의 것을 끌어다 창고의 칸에 놓으면 맡겨지고(놓은 칸에 — 묶음은 전부),
--     창고의 것을 끌어다 가방에 놓으면 찾아진다. 창고 안에서도 끌어서 옮기고 「정렬」한다. 칸을 누르면 상세 판(「찾기」 — 묶음은 몇 개를 찾을지 고른다), 두 번 누르면 전부 찾는다.
--   · 상점: 가방의 것을 끌어다 상점 창에 놓으면 팔지 묻는다(가방의 상세 판에 — ui/bagWindow.luau). 상세 판의 「팔기」도 같은 일이다.
--  사용자 2026-10-13: "대장간 장비제작이나, 상점에서 소비템 구매하는거나  메이플스토리처럼 아이템 아이콘이 보여야합니다"
--   · 상점의 줄마다 그 물건의 그림(가방의 그 그림 — 칸 안에) · 값 앞에 달돈 그림. 제작의 줄마다 만들 장비의 그림과 재료의 그림(그 앞에는 글뿐이었다).
--     자리는 공방 시험 탭의 js/lune/ui/paint.js(paintShop · paintCraft)와 같다 — 치수는 공방 설계 자료(UILAYOUT.shop · craft).
--  화면 오른쪽 · 왼쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Items = require(lune.sim.items)
local Bag = require(lune.sim.bag)
local ItemInfo = require(lune.ui.itemInfo)
local Format = require(lune.ui.format)
local Layout = require(lune.ui.layout) -- 치수(자동 검사가 같은 값을 본다)
local WORDS = require(lune.data["ui.generated"]).words
local Stage = require(script.Parent.Parent.stage)
local Ui = require(script.Parent.ui)
local ItemCell = require(script.Parent.itemCell)
local BagWindow = require(script.Parent.bagWindow)
local ItemDetail = require(script.Parent.itemDetail)
local Windows = require(script.Parent.windows)

local C = Ui.COLOR
local D = Items.data
local COLS = Layout.BAG.cols -- 창고의 칸: 가방과 같은 여섯 칸
local ROW = Ui.M.button + 4 -- 상점의 한 줄
local SHOP = Layout.SHOP
local CRAFT = Layout.CRAFT
local STORE = Layout.STORE
local W = SHOP.w
local MAX_ROWS = SHOP.rows -- 상점에 놓이는 물건의 줄 수(창의 높이)
local IC = SHOP.iconS -- 줄의 아이콘 칸(그 안에 18x18 그림)
local TX = IC + 6 -- 아이콘 칸의 오른쪽 — 이름이 시작하는 자리
local KEYS = D.BAG.keys -- 탭의 이름표("gear" · "use" · "etc")
local DOUBLE = 0.4 -- 이 안에 같은 칸을 다시 누르면 두 번 누른 것(초)

local ShopWindow = {}
ShopWindow.NAME_W, ShopWindow.PRICE_W, ShopWindow.BUY_W = SHOP.nameW, SHOP.priceW, SHOP.buyW -- 물건 이름 · 값 · 사는 단추(들)의 칸
ShopWindow.TITLE = { merchant = "잡화 상인 반달", smith = "대장장이 무쇠뿔", craft = "대장장이 무쇠뿔 — 제작", store = WORDS.storeName }

function ShopWindow.title(arg: string): string
	return ShopWindow.TITLE[arg] or "상점"
end

function ShopWindow.size(arg: string): (number, number)
	if arg == "store" then
		return Layout.storeBody(Stage.ratio, D.BAG.storeBase)
	end
	return W, MAX_ROWS * ROW + Ui.M.button + 12 + 32
end

local function stockOf(npc: string)
	local list = {}
	for _, s in D.STOCK do
		if s.npc == npc then
			table.insert(list, s)
		end
	end
	return list
end
ShopWindow.stockOf = stockOf

-- 상점의 그 물건의 그림 이름(가방에 들어왔을 때의 그 그림): 물약 · 주문서 = 그 아이템의 것 · 장비 = 부위와 재질(무기는 내 직업의 것) · 달가루
function ShopWindow.stockIcon(stock, class: string): string
	if stock.goods then
		local g = Items.goods(stock.goods)
		return if g then g.icon else ""
	elseif stock.item then
		return ItemCell.icon(Items.make(stock.item.slot, stock.item.stage, D.NORMAL, class))
	end
	return "dust"
end

-- 창고: 탭 셋 · 칸 · 끌어서 맡기기와 찾기
local function buildStore(body: Frame, ctx, w: number)
	local view = {}
	local ui = ctx.ui
	local S = ItemCell.size()
	local size = D.BAG.storeBase -- 탭 하나의 칸 수
	local rowsN = math.ceil(size / COLS)
	local tab = 1
	local sel = nil :: { tab: string, slot: number, id: any }? -- 고른 칸(id = 장비의 번호 · 묶음의 이름표)
	local ask: number? = nil -- 찾을 수를 고르는 중이면 그 수
	local hot: number? = nil -- 끌던 것을 놓을 칸
	local lastClick = { slot = 0, t = 0 }
	local dragEnd = 0
	local panel = body.Parent :: GuiObject

	local function key(): string
		return KEYS[tab]
	end
	local function unselect()
		sel, ask = nil, nil
	end
	local function redraw()
		Windows.refresh(ctx.me())
	end
	-- 찾는다: 창고의 그 칸의 것을 가방으로(n = 묶음에서 찾을 수 — 안 주면 전부 · to = 놓을 가방 칸). 가방은 그 탭을 보여 준다(찾은 것이 보이게)
	local function take(tabKey: string, slot: number, n: number?, to: number?)
		ctx.send("Item", "storeOut", tabKey, slot, n, to)
		if ui.bagShow then
			ui.bagShow(tabKey)
		end
	end

	local tabs = {}
	local tx = 0
	for i, name in D.BAG.tabs do
		tabs[i] = Ui.tab(body, name, tx, 0, function()
			if tab ~= i then
				tab = i
				unselect()
				redraw()
			end
		end)
		tx += tabs[i].width + 16
	end
	local count = Ui.text(body, "", w - Layout.BAG.countW, 0, Layout.BAG.countW, { align = "right", color = C.dim }) -- 찬 칸 / 창고의 칸

	local gridRoot = Ui.group(body, 0, STORE.gridY, COLS * S, rowsN * S, "Grid")
	local cells = {}
	local function slotAt(at: Vector2): number?
		local i = ItemCell.at(cells, at)
		return if i and i <= size then i else nil
	end
	for i = 1, COLS * rowsN do
		local col, row = (i - 1) % COLS, math.floor((i - 1) / COLS)
		local cell
		cell = ItemCell.new(gridRoot, col * S, row * S, function(it)
			local now = os.clock()
			-- 끌어서 놓은 것은 누른 것이 아니다(놓은 자리의 칸에도 "눌렀다"가 온다)
			if ctx.quick.dragging() or now - dragEnd < 0.2 then
				return
			end
			local twice = it ~= nil and lastClick.slot == i and now - lastClick.t < DOUBLE
			lastClick = { slot = if twice then 0 else i, t = now }
			if not it then
				unselect()
			elseif twice then
				take(key(), i, nil, nil) -- 두 번 누르기: 전부 찾는다
				unselect()
			else
				sel = { tab = key(), slot = i, id = if it.item then it.item else it.id }
				ask = nil
				ui.detail = "shop"
			end
			redraw()
		end, S)
		cells[i] = cell
		-- 끌기: 창고의 다른 칸 = 창고 안에서 옮긴다 · 가방 창 = 찾는다(놓은 칸에 — 묶음은 전부)
		cell.hit.InputBegan:Connect(function(input)
			local it = cell.item
			if not it then
				return
			end
			local from, tabKey = i, key()
			local moved = false
			ctx.quick.press(nil, nil, input, {
				icon = ItemCell.icon(it),
				size = S,
				onMove = function(at: Vector2)
					moved = true
					local to = slotAt(at)
					if hot ~= to then
						hot = to
						view.refresh()
					end
					if ui.bagHover then
						ui.bagHover(at, tabKey) -- 가방의 놓을 칸이 밝아진다
					end
				end,
				onDrop = function(at: Vector2): boolean
					local to = slotAt(at)
					if to and to ~= from then
						ctx.send("Item", "storeMove", tabKey, from, to)
						-- 화면은 바로 옮긴다(같은 묶음끼리 합치는 것은 서버의 셈을 기다린다)
						local bag = ctx.bag()
						local list = if bag then bag.store[tabKey] else nil
						local a = if list then list[from] else nil
						local b = if list then list[to] else nil
						local merge = tabKey ~= "gear" and a and b and a.item == b.item
						if list and a and not merge then
							list[from], list[to] = b or false, a
						end
						if sel and sel.tab == tabKey and (sel.slot == from or sel.slot == to) then
							if merge then
								unselect()
							else
								sel.slot = if sel.slot == from then to else from
							end
						end
					end
					if to then
						return true
					end
					if ui.bagDrop then
						local over, slot = ui.bagDrop(at, tabKey)
						if over then
							take(tabKey, from, nil, slot)
							if sel and sel.tab == tabKey and sel.slot == from then
								unselect()
							end
							return true
						end
					end
					return false
				end,
				onEnd = function()
					if moved then
						dragEnd = os.clock()
					end
					if ui.bagHover then
						ui.bagHover(nil, nil)
					end
					if hot then
						hot = nil
						view.refresh()
					end
				end,
			})
		end)
	end

	-- 가방에서 끌어 온 것을 놓는 자리(ui/bagWindow.luau가 묻는다): 창고 창 위면 맡긴다 — 그 탭이 열려 있으면 놓은 칸에, 다른 탭이 열려 있었으면 그 탭으로 넘긴다
	ui.storeDrop = function(at: Vector2, tabKey: string, from: number): boolean
		if not ItemCell.over(panel, at) then
			return false
		end
		local to = if tabKey == key() then slotAt(at) else nil
		ctx.send("Item", "storeIn", tabKey, from, nil, to)
		if tabKey ~= key() then
			tab = table.find(KEYS, tabKey) or tab
			unselect()
		end
		return true
	end
	-- 가방의 「맡기기」로 맡겼을 때: 창고가 그 탭을 보여 준다
	ui.storeShow = function(tabKey: string)
		if tabKey ~= key() then
			tab = table.find(KEYS, tabKey) or tab
			unselect()
		end
	end
	ui.storeHover = function(at: Vector2?, tabKey: string?)
		local to = if at and tabKey == key() then slotAt(at) else nil
		if hot ~= to then
			hot = to
			view.refresh()
		end
	end

	-- 칸 아래: 「정렬」과 안내 글
	local fy = STORE.gridY + rowsN * S + STORE.footY
	local sort = Ui.button(body, WORDS.sort, 0, fy, STORE.sortW, function()
		ctx.send("Item", "storeSort", key())
		unselect()
		view.refresh()
	end)
	sort.frame.Name = "Sort"
	Ui.text(body, WORDS.storeHint, STORE.sortW + 10, fy + 8, w - STORE.sortW - 10, { align = "right", color = C.dim })

	-- 고른 것의 상세 판(창 옆): 「찾기」 — 묶음은 몇 개를 찾을지 고른다
	local function detail(bag, me)
		if ui.detail ~= "shop" then
			unselect() -- 다른 창에서 골랐다
		end
		local list = if sel then bag.store[sel.tab] else nil
		local entry = if sel and list then list[sel.slot] else nil
		if sel and sel.tab == "gear" and (not entry or entry.id ~= sel.id) then
			entry = nil
			for i = 1, size do
				local it = list[i]
				if it and it.id == sel.id then
					sel.slot, entry = i, it
					break
				end
			end
		elseif sel and sel.tab ~= "gear" and entry and entry.item ~= sel.id then
			entry = nil
		end
		if not sel or not entry then
			unselect()
			ItemDetail.hide("shop")
			return
		end
		local slot, tabKey = sel.slot, sel.tab
		local spec = { item = entry, buttons = {}, onClose = function()
			unselect()
			redraw()
		end }
		if tabKey == "gear" then
			ask = nil
			spec.info = ItemInfo.gear(entry, me, bag.equip[entry.slot], false)
			table.insert(spec.buttons, { text = WORDS.take, main = true, onClick = function()
				take("gear", slot, nil, nil)
				unselect()
				redraw()
			end })
			spec.key = table.concat({ "store", entry.id, entry.q, entry.star, tostring(entry.broken), me.level }, "|")
		else
			spec.info = ItemInfo.goods(entry.item, me, entry.n) -- 가진 수 = 창고의 그 묶음
			if ask then
				local n = math.clamp(ask, 1, entry.n)
				ask = n
				spec.ask = ItemDetail.ask("take", n, 1, entry.n, {
					set = function(v: number)
						ask = v
						view.refresh()
					end,
					yes = function(countNow: number)
						take(tabKey, slot, countNow, nil)
						ask = nil
						view.refresh()
					end,
					no = function()
						ask = nil
						view.refresh()
					end,
				})
			else
				table.insert(spec.buttons, { text = WORDS.take, main = true, onClick = function()
					if entry.n == 1 then
						take(tabKey, slot, 1, nil)
						unselect()
						redraw()
					else
						ask = entry.n -- 처음에는 그 묶음 전부
						view.refresh()
					end
				end })
			end
			spec.key = table.concat({ "store", tabKey, slot, entry.item, entry.n, me.level, if ask then ask else "-" }, "|")
		end
		ItemDetail.show("shop", spec)
	end

	function view.refresh()
		local bag, me = ctx.bag(), ctx.me()
		if not bag or not me then
			return
		end
		for i, button in tabs do
			button:setOn(i == tab)
		end
		local list = bag.store[key()]
		local used = 0
		for i = 1, size do
			if list[i] then
				used += 1
			end
		end
		count:set(("%d / %d"):format(used, bag.storeSize))
		detail(bag, me)
		for i, cell in cells do
			local item = list[i] or nil
			cell:set(item, { locked = i > bag.storeSize, selected = sel ~= nil and sel.tab == key() and sel.slot == i, hot = hot == i })
		end
		sort:setEnabled(used > 1)
	end

	function view.destroy()
		ItemDetail.hide("shop")
		if ui.detail == "shop" then
			ui.detail = nil
		end
		ui.storeDrop, ui.storeHover, ui.storeShow = nil, nil, nil
	end
	return view
end

-- 제작(대장장이 — 사용자 2026-10-11: "안뜨면 재료를 모아서 대장장이에서 만들수도 있구요"): 단계의 탭(Lv.1 · Lv.10 · Lv.20) 아래에 장비마다 한 줄.
--  윗줄 = 장비의 이름 · 삯(달돈) · 「제작」, 아랫줄 = 드는 재료 「강철 광석 12/20 · 질긴 가죽 3/5」(가진 수/드는 수 — 다 모였으면 풀빛). 만든 것의 성능은 보통 이상이다.
ShopWindow.CRAFT_ROW = CRAFT.row
ShopWindow.CRAFT_MAKE_W, ShopWindow.CRAFT_FEE_W = CRAFT.makeW, CRAFT.feeW
ShopWindow.CRAFT_NOTE = CRAFT.note
ShopWindow.CRAFT_MATS = 2 -- 한 줄에 그리는 재료의 수(레시피의 재료는 둘이다 — 광석 · 가죽)
-- 한 줄의 재료들 { { icon 그림 이름, text 「청동 광석 3/5」(가진 수/드는 수), ok 그 재료가 모였는가 } … } 와 다 모였는가
function ShopWindow.craftParts(recipe, bag)
	local parts, enough = {}, true
	for _, need in recipe.needs do
		local have = Bag.countIn(bag, need.item)
		local g = Items.goods(need.item)
		table.insert(parts, { icon = g.icon, text = ("%s %d/%d"):format(g.name, math.min(have, 9999), need.n), ok = have >= need.n })
		enough = enough and have >= need.n
	end
	return parts, enough
end

local function buildCraft(body: Frame, ctx, w: number, h: number)
	local view = {}
	local ui = ctx.ui
	local stages = {}
	for _, r in D.RECIPES do
		if not table.find(stages, r.stage) then
			table.insert(stages, r.stage)
		end
	end
	table.sort(stages)
	-- 처음 보이는 탭: 내 레벨로 만들 수 있는 가장 높은 단계
	local tab = 1
	local me0 = ctx.me()
	for i, st in stages do
		if me0 and me0.level >= st then
			tab = i
		end
	end
	local tabs = {}
	local tx = 0
	for i, st in stages do
		tabs[i] = Ui.tab(body, "Lv." .. st, tx, 0, function()
			if tab ~= i then
				tab = i
				ui.craftResult = nil
				view.refresh()
			end
		end)
		tx += tabs[i].width + 16
	end
	Ui.text(body, ShopWindow.CRAFT_NOTE, tx, 0, w - tx, { align = "right", color = C.dim })
	local perStage = 0
	for _, r in D.RECIPES do
		if r.stage == stages[1] then
			perStage += 1
		end
	end
	local rows = {}
	local bw, fw = ShopWindow.CRAFT_MAKE_W, ShopWindow.CRAFT_FEE_W
	for i = 1, perStage do
		local y = CRAFT.tabH + (i - 1) * CRAFT.row
		local row = {}
		-- 윗줄: [만들 장비의 그림] 이름 · [달돈] 삯 · 「제작」
		row.cell = Ui.slot(body, 0, y, IC)
		row.cell.frame.Name = "Icon"
		row.icon = Ui.smallIcon(row.cell.frame, "coin", 3, 3)
		row.name = Ui.text(body, "", TX, y + 5, w - TX - bw - 8 - fw - 22, { font = "body" })
		row.coin = Ui.smallIcon(body, "coin", w - bw - 8 - fw - 19, y + 3)
		row.fee = Ui.text(body, "", w - bw - 8 - fw, y + 7, fw, { align = "right", color = C.gold })
		row.make = Ui.button(body, "제작", w - bw, y + 1, bw, function()
			if row.recipe then
				ctx.send("Item", "craft", row.recipe.id)
			end
		end, { h = CRAFT.makeH })
		-- 아랫줄: 재료마다 [그림] 이름 가진 수/드는 수(모였으면 풀빛). 아직 못 만드는 장비는 그 자리에 「Lv.10부터 만든다」
		row.mats = {}
		for k = 1, ShopWindow.CRAFT_MATS do
			local mx = TX + (k - 1) * CRAFT.matW
			row.mats[k] = { icon = Ui.smallIcon(body, "coin", mx, y + 25), text = Ui.text(body, "", mx + 21, y + 29, CRAFT.matW - 25, { color = C.dim }) }
		end
		row.lock = Ui.text(body, "", TX, y + 29, w - TX, { color = C.dim })
		rows[i] = row
	end
	local fy = h - 28
	local by = fy - Ui.M.button - 12
	local result = Ui.text(body, "", 0, by - 18, w, { color = C.accent })
	local half = math.floor((w - 6) / 2)
	Ui.button(body, "상점", 0, by, half, function()
		ctx.openService("smithShop")
	end)
	local forge = Ui.button(body, "강화", half + 6, by, w - half - 6, function()
		ctx.openService("forge")
	end)
	Ui.line(body, 0, fy - 6, w)
	local money = BagWindow.purse(body, "coin", -3, fy, 90)
	Ui.text(body, CRAFT.hint, 96, fy + 4, w - 96, { align = "right", color = C.dim })

	function view.refresh()
		local bag, me = ctx.bag(), ctx.me()
		if not bag or not me then
			return
		end
		for i, t in tabs do
			t:setOn(i == tab)
		end
		local k = 0
		for _, r in D.RECIPES do
			if r.stage == stages[tab] then
				k += 1
				local row = rows[k]
				if row then
					row.recipe = r
					local open = me.level >= r.from
					local item = Items.make(r.slot, r.stage, D.NORMAL, me.class)
					Ui.setWorldIcon(row.icon, ItemCell.icon(item))
					row.name:set(Items.name(item))
					row.name:color(if open then C.text else C.dim)
					local parts, enough = ShopWindow.craftParts(r, bag)
					for j, m in row.mats do
						local q = if open then parts[j] else nil
						Ui.setWorldIcon(m.icon, if q then q.icon else nil)
						m.text:set(if q then q.text else "")
						m.text:color(if q and q.ok then C.green else C.dim)
					end
					row.lock:set(if open then "" else ("Lv.%d부터 만든다"):format(r.from))
					row.fee:set(if open then Format.short(r.money) else "")
					row.coin.Visible = open
					row.make.frame.Visible = open
					row.make:setEnabled(enough and me.money >= r.money)
				end
			end
		end
		local made = ui.craftResult
		result:set(if made then ("%s — 만들었다"):format(ItemCell.label(made)) else "")
		if made then
			result:color(ItemCell.color(made))
		end
		forge:setEnabled(me.level >= D.OPEN.forge)
		money:set(Format.short(me.money))
	end

	function view.destroy()
		ui.craftResult = nil
	end
	return view
end

function ShopWindow.build(body: Frame, ctx, w: number, h: number, arg: string)
	if arg == "store" then
		return buildStore(body, ctx, w)
	elseif arg == "craft" then
		return buildCraft(body, ctx, w, h)
	end
	local view = {}
	local ui = ctx.ui
	local panel = body.Parent :: GuiObject

	-- 상점: 물건마다 한 줄([그림] 이름 · [달돈] 값 · 사기). 물약(단마다 따로 판다 — 가방의 소비 탭에 들어온다)과 달가루는 열 개씩도 산다
	local rows = {}
	local bx = w - ShopWindow.BUY_W
	for i, stock in stockOf(arg) do
		local y = (i - 1) * ROW
		local many = stock.max > 1
		-- [그 물건의 그림(칸 안에)] 이름 · [달돈] 값 · 사는 단추 — 살 수 없는 것도 그림은 보인다
		local cell = Ui.slot(body, 0, y + 1, IC)
		cell.frame.Name = "Icon"
		local icon = Ui.smallIcon(cell.frame, "coin", 3, 3)
		local name = Ui.text(body, "", TX, y + 7, ShopWindow.NAME_W, { font = "body" })
		local coin = Ui.smallIcon(body, "coin", bx - 8 - ShopWindow.PRICE_W - 19, y + 4)
		local price = Ui.text(body, "", bx - 8 - ShopWindow.PRICE_W, y + 8, ShopWindow.PRICE_W, { align = "right", color = C.gold })
		local half = math.floor((ShopWindow.BUY_W - 6) / 2)
		local one = Ui.button(body, if many then "1" else "사기", bx, y, if many then half else ShopWindow.BUY_W, function()
			ctx.send("Item", "buy", stock.id, 1)
		end)
		local ten = if many
			then Ui.button(body, "10", bx + half + 6, y, half, function()
				ctx.send("Item", "buy", stock.id, 10)
			end)
			else nil
		-- 아직 살 수 없는 것은 값과 단추 자리에 "Lv.10부터"
		local lock = Ui.text(body, "", TX + ShopWindow.NAME_W, y + 8, w - TX - ShopWindow.NAME_W, { align = "right", color = C.dim })
		rows[i] = { stock = stock, icon = icon, coin = coin, name = name, price = price, one = one, ten = ten, lock = lock }
	end
	local fy = h - 28
	-- 대장장이의 상점: 아래에 단추 둘 — 「제작하러 가기」(재료로 장비를 만든다) · 「강화하러 가기」(Lv.8부터)
	local halfW = math.floor((w - 6) / 2)
	if arg == "smith" then
		Ui.button(body, "제작하러 가기", 0, fy - Ui.M.button - 12, halfW, function()
			ctx.openService("craft")
		end, { main = true })
	end
	local swap = if arg == "smith"
		then Ui.button(body, "강화하러 가기", halfW + 6, fy - Ui.M.button - 12, w - halfW - 6, function()
			ctx.openService("forge")
		end)
		else nil
	Ui.line(body, 0, fy - 6, w)
	local money = BagWindow.purse(body, "coin", -3, fy, 90)
	local dust = BagWindow.purse(body, "dust", 96, fy, 90)
	-- 팔기: 가방의 것을 끌어다 이 창에 놓는다(가방의 상세 판이 팔지 묻는다)
	Ui.text(body, WORDS.shopHint, SHOP.hintX, fy + 4, w - SHOP.hintX, { align = "right", color = C.dim })
	ui.shopDrop = function(at: Vector2): boolean
		return ItemCell.over(panel, at)
	end

	function view.refresh()
		local bag, me = ctx.bag(), ctx.me()
		if not bag or not me then
			return
		end
		for _, row in rows do
			local stock = row.stock
			local cost = Items.stockPrice(stock, me.level)
			local label = stock.name
			if stock.id == "w10" then
				label = Items.name(Items.make("weapon", stock.item.stage, D.NORMAL, me.class))
			end
			local open = me.level >= stock.from
			Ui.setWorldIcon(row.icon, ShopWindow.stockIcon(stock, me.class))
			row.coin.Visible = open
			row.name:set(label)
			row.name:color(if open then C.text else C.dim)
			row.price:set(if open then Format.short(cost) else "")
			row.lock:set(if open then "" else ("Lv.%d부터"):format(stock.from))
			row.one.frame.Visible = open
			row.one:setEnabled(me.money >= cost)
			if row.ten then
				row.ten.frame.Visible = open
				row.ten:setEnabled(me.money >= cost * 10)
			end
		end
		if swap then
			swap:setEnabled(me.level >= D.OPEN.forge)
		end
		money:set(Format.short(me.money))
		dust:set(Format.short(bag.dust))
	end

	function view.destroy()
		ui.shopDrop = nil
	end
	return view
end

return ShopWindow

end
MODULES['Client/lune/ui/skillWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 스킬 창(넓은 창) — 위에 차수 탭(로마 숫자 I · II · III · IV — 사용자 2026-10-07: "1차 이렇게 적지말고 로마자로 적으세요 차 라는말 빼고"), 그 아래 그 차수의 스킬들(두 줄로 — 그림 · 이름 · 레벨 / 마스터 · + 단추)과 「추천대로 찍기」, 오른쪽에 고른 스킬의 설명.
--  사용자 2026-10-07: "스킬창에 차수 탭이 없습니다. 1,2,3,4 차 스킬 탭이있어야지 지금뭐가뭔지" · "패시브든 뭐든 다 아이콘이 있는거에요"(별 그림으로 때우던 것을 없앴다 — 스킬마다 제 그림이 있다)
--  공방의 횡스크롤 시험 탭(js/lune/ui/paint.js의 paintSkill)과 같은 그림이다. 치수는 Layout.SKILL · 글은 UI.skillWords · 스킬은 CLASSES.classes[직업].tiers(차수마다).
--  퀵슬롯에 놓기(사용자 2026-10-07: "스킬키를 단축키에 등록하기 쉬워야합니다"): 스킬을 끌어다 화면 아래의 칸에 놓거나, 스킬을 누른 뒤 반짝이는 칸을 누른다 — ctx.quick(ui/quickEdit.luau)이 맡는다.
--   설명 칸의 맨 아래 두 줄에 그 스킬이 놓인 칸(「퀵슬롯 Q」)과 놓는 법을 적는다.
--  올리는 것은 서버에 부탁한다(SkillUp · SkillAuto). 아직 전직하지 않은 차수는 볼 수만 있다(+ 단추가 꺼져 있고, 언제 배우는지를 적는다). 화면 오른쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local CLASSES = require(lune.data["classes.generated"])
local UI = require(lune.data["ui.generated"])
local Layout = require(lune.ui.layout)
local Format = require(lune.ui.format)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local S = Layout.SKILL
local WORDS = UI.skillWords
local QWORDS = UI.quick.words
local COMBAT = require(lune.data["combat.generated"])
local BONUS = COMBAT.rules.targetBonus -- 사냥기 · 보스기가 맞는 상대에게 더 주는 피해(%)
local EFFECTS = COMBAT.kitEffects -- 온오프 사출기 · 핵심 장치 · 패시브의 레벨마다의 효과 글([스킬][레벨])
local READY = COMBAT.ready -- 게임에 들어와 있는 스킬. 여기에 없는 스킬은 + 단추가 꺼져 있고 「아직 준비 중」이라고 적힌다(서버도 찍어 주지 않는다 — sim/hero.luau의 skillUp)
local TYPES = CLASSES.types

local SkillWindow = { wide = true }

function SkillWindow.size(): (number, number)
	local w, h = Layout.skillBody()
	return w, h
end

-- 지금 레벨에서 열린 차수(전직이 생기면 내 상태의 차수를 쓴다)
function SkillWindow.jobOf(me): number
	if me.job then
		return me.job
	end
	local job = 1
	for _, j in CLASSES.jobs do
		if j.lv <= me.level then
			job = math.max(job, j.job)
		end
	end
	return job
end

-- 누르는 자리. onPress = 누르기 시작했을 때(끌기의 시작 — 없어도 된다)
local function picker(parent: Instance, x: number, y: number, w: number, h: number, name: string, onClick: () -> (), onPress: ((InputObject) -> ())?): TextButton
	local hit = Instance.new("TextButton")
	hit.Name = name
	hit.Text = ""
	hit.BackgroundTransparency = 1
	hit.Position = UDim2.fromOffset(x, y)
	hit.Size = UDim2.fromOffset(w, h)
	hit.ZIndex = 4
	hit.Parent = parent
	hit.Activated:Connect(onClick)
	if onPress then
		hit.InputBegan:Connect(onPress)
	end
	return hit
end

function SkillWindow.build(body: Frame, ctx, _w: number, h: number)
	local _, _, listW = Layout.skillBody()
	local tiers = nil -- 내 직업의 차수들 { { job, lv, skills } … }
	local names = {} -- [스킬] = 이름(앞 차수의 기술을 잇는 스킬의 설명에 쓴다)
	local tab, selected = 1, 1
	local last = nil
	local tabs = {}
	local view = {}

	local points = Ui.text(body, "", listW - 160, 2, 160, { color = C.gold, align = "right" })
	local info = Ui.text(body, "", 0, S.infoY + 6, listW - S.autoW - 8, {})
	local auto = Ui.button(body, WORDS.auto, listW - S.autoW, S.infoY, S.autoW, function()
		ctx.send("SkillAuto")
	end, { main = true, h = 22, font = "small" })
	-- 전직하며 받은 공짜 초기화(설계: "전직하면 SP 초기화 한 번이 공짜"): 남아 있을 때만 탭의 오른쪽에 단추가 보인다. 잘못 누르지 않게 두 번 눌러야 한다(「정말 초기화?」 — 3초 안에)
	local RESET_X, RESET_W = (S.tabW + S.tabGap) * 4 + 8, 96
	local resetHolder = Ui.group(body, RESET_X, -2, RESET_W, 20, "Reset")
	local resetBtn: Instance? = nil
	local resetArmed, resetShown = 0, nil :: string?
	local function drawReset(me)
		local left = (me and me.resets) or 0
		local armed = os.clock() - resetArmed < 3
		local label = if left < 1 then "" elseif armed then "정말 초기화?" else "초기화(무료 1회)"
		if label == resetShown then
			return
		end
		resetShown = label
		if resetBtn then
			resetBtn:Destroy()
			resetBtn = nil
		end
		if label ~= "" then
			local button = Ui.button(resetHolder, label, 0, 0, RESET_W, function()
				if os.clock() - resetArmed < 3 then
					resetArmed = 0
					ctx.send("SkillReset")
				else
					resetArmed = os.clock()
					task.delay(3.1, function()
						drawReset(ctx.me())
					end)
				end
				drawReset(ctx.me())
			end, { h = 18, font = "small" })
			button.frame.Name = "Do_reset"
			resetBtn = button.frame
		end
	end
	view.drawReset = drawReset

	-- 스킬 칸들(cols x rows)을 미리 만들어 두고, 탭에 따라 채운다
	local cells = {}
	local nameW = S.colW - S.slot - 8 - S.plusW - 4
	for i = 1, S.cols * S.rows do
		local holder = Ui.group(body, ((i - 1) % S.cols) * (S.colW + S.colGap), S.top + math.floor((i - 1) / S.cols) * S.row, S.colW, S.row, "Skill" .. i)
		local cell = Ui.slot(holder, 0, 0, S.slot)
		local pic = Ui.pic(holder, nil, 3, 3)
		pic.ZIndex = 2
		local name = Ui.text(holder, "", S.slot + 8, 2, nameW, { font = "body" })
		local level = Ui.text(holder, "", S.slot + 8, 18, nameW, { color = C.dim })
		local plus = Ui.button(holder, "+", S.colW - S.plusW, 2, S.plusW, function()
			local sk = tiers and tiers[tab].skills[i]
			if sk then
				selected = i
				ctx.send("SkillUp", sk.id)
				view.paint()
			end
		end)
		-- 칸을 누르면 오른쪽에 설명이 나오고, 퀵슬롯에 놓을 수 있는 스킬이면 칸들이 반짝인다(한 번 더 누르면 그만둔다). 누른 채 움직이면 끌기
		picker(holder, 0, 0, S.colW - S.plusW - 4, S.slot, "Pick", function()
			local sk = tiers and tiers[tab].skills[i]
			if sk then
				selected = i
				ctx.quick.pick(sk.id)
				view.paint()
			end
		end, function(input: InputObject)
			local sk = tiers and tiers[tab].skills[i]
			if sk then
				ctx.quick.press(sk.id, nil, input)
			end
		end)
		cells[i] = { holder = holder, cell = cell, pic = pic, name = name, level = level, plus = plus }
	end

	-- 오른쪽: 고른 스킬의 그림 · 이름 · 갈래와 레벨 · 설명 · (앞 차수의 기술을 잇는 것이면) 그 기술의 이름
	local dx = listW + S.gap
	local detailW = S.detailW - S.slot - 10
	Ui.box(body, listW + math.floor(S.gap / 2), 0, 1, h, C.line)
	Ui.slot(body, dx, 0, S.slot)
	local detailPic = Ui.pic(body, nil, dx + 3, 3)
	local detailName = Ui.text(body, "", dx + S.slot + 10, 1, detailW, { font = "body", color = C.gold })
	local detailType = Ui.text(body, "", dx + S.slot + 10, 18, detailW, { color = C.dim })
	local detailBonus = Ui.text(body, "", dx, S.slot + 14, S.detailW, { color = C.accent }) -- 사냥기 · 보스기의 쓰임(일반 몬스터 · 보스에게 피해 +%)
	local detailText = Ui.text(body, "", dx, S.slot + 14, S.detailW, { lines = S.textLines, line = S.textLine })
	local detailNote = Ui.text(body, "", dx, S.slot + 14, S.detailW, { color = C.dim })
	-- 온오프 사출기 · 핵심 장치 · 패시브: 설명 아래에 그 레벨의 효과를 숫자로(지금의 것 · + 를 누르면 되는 것)
	local effects = {}
	for i = 1, 2 do
		effects[i] = {
			label = Ui.text(body, "", dx, 0, S.detailW, { color = C.dim }),
			text = Ui.text(body, "", dx, 0, S.detailW, { lines = 3, line = S.textLine, color = if i == 1 then C.text else C.dim }),
		}
	end
	-- 맨 아래 두 줄: 퀵슬롯의 어느 칸에 있는가 · 놓는 법
	local quickAt = Ui.text(body, "", dx, h - Ui.M.small - 16, S.detailW, { color = C.dim })
	local quickHint = Ui.text(body, "", dx, h - Ui.M.small, S.detailW, { color = C.dim })

	-- 차수 탭: 로마 숫자(본문 글씨)를 같은 폭의 칸에 가운데로 — 고른 것은 민트 글씨에 밑줄, 아직 못 배우는 차수는 더 흐리다
	local function buildTabs()
		for i, t in tiers do
			local holder = Ui.group(body, (i - 1) * (S.tabW + S.tabGap), 0, S.tabW, 18, "Tier" .. t.job)
			local label = Ui.text(holder, WORDS.tabs[t.job] or tostring(t.job), 0, 0, S.tabW, { font = "body", align = "center", color = C.dim })
			local under = Ui.box(holder, 0, 15, S.tabW, 2, C.accent)
			under.Visible = false
			picker(holder, 0, -4, S.tabW, 24, "Hit", function()
				if tab ~= i then
					tab, selected = i, 1
					ctx.quick.pick(nil)
					view.paint()
				end
			end)
			tabs[i] = { label = label, under = under, job = t.job }
		end
	end

	function view.paint()
		local me = last
		if not me or not tiers then
			return
		end
		local job = SkillWindow.jobOf(me)
		local tier = tiers[tab]
		local locked = tier.job > job
		for i, t in tabs do
			t.label:color(if i == tab then C.accent elseif t.job > job then C.off else C.dim)
			t.under.Visible = i == tab
		end
		-- 스킬 포인트는 차수마다 따로다(받은 SP는 그때의 차수 스킬에만 쓴다) — 보고 있는 탭의 것을 적는다
		local pool = if me.sps then me.sps[tier.job] or 0 else me.sp
		points:set(Format.fill(WORDS.points, { n = pool }))
		info:set(Format.fill(if locked then WORDS.locked else WORDS.open, { job = tier.job, lv = tier.lv, n = #tier.skills }))
		info:color(if locked then C.red else C.dim)
		auto:setEnabled(not locked and pool > 0)
		for i, c in cells do
			local sk = tier.skills[i]
			c.holder.Visible = sk ~= nil
			if sk then
				local lv = me.skills[sk.id] or 0
				c.cell:setOn(i == selected)
				Ui.setPic(c.pic, "skill_" .. sk.id)
				c.name:set(sk.name)
				c.name:color(if i == selected then C.accent elseif not READY[sk.id] then C.off elseif lv > 0 then C.text else C.dim)
				c.level:set(("%d / %d"):format(lv, sk.max))
				c.level:color(if lv >= sk.max then C.accent else C.dim)
				c.plus:setEnabled(not locked and pool > 0 and lv < sk.max and READY[sk.id] == true and (not sk.needs or not READY[sk.needs] or (me.skills[sk.needs] or 0) > 0))
			end
		end
		local sk = tier.skills[selected]
		if sk then
			local lv = me.skills[sk.id] or 0
			Ui.setPic(detailPic, "skill_" .. sk.id)
			detailName:set(sk.name)
			detailType:set(("%s · Lv.%d / %d"):format(TYPES[sk.type] or sk.type, lv, sk.max))
			local bonus = WORDS.bonus[sk.type]
			local top = S.slot + 14 + (if bonus then S.textLine else 0)
			detailBonus:set(if bonus then Format.fill(bonus, { pct = BONUS }) else "")
			detailText:set(sk.text)
			detailText:move(dx, top)
			local _, th = detailText:size()
			-- 알림 한 줄: 게임에 아직 없는 스킬이면 그것부터(빨강), 먼저 배워야 하는 스킬을 아직 안 배웠으면 그것(빨강), 아니면 앞 차수의 어느 기술 자리에 들어가는지
			local soon = not READY[sk.id]
			local needs = not soon and sk.needs and READY[sk.needs] and (me.skills[sk.needs] or 0) < 1 and names[sk.needs]
			local note = if soon then WORDS.soon elseif needs then Format.fill(WORDS.needs, { name = needs }) elseif sk.replaces and names[sk.replaces] then Format.fill(WORDS.replaces, { name = names[sk.replaces] }) else ""
			detailNote:color(if soon or needs then C.red else C.dim)
			detailNote:set(note)
			local below = top + math.max(1, math.floor(th / S.textLine + 0.5)) * S.textLine
			detailNote:move(dx, below + 6)
			-- 그 레벨의 효과: 지금(배웠을 때) · 다음(마스터가 아닐 때)
			local list = EFFECTS[sk.id]
			local y = below + S.effGap + (if note ~= "" then S.textLine + 6 else 0)
			for i, e in effects do
				local at = lv + i - 1
				local text = if list then list[at] else nil
				e.label:set(if text then Format.fill(if i == 1 then WORDS.now else WORDS.next, { lv = at }) else "")
				e.label:color(if i == 1 then C.accent else C.dim)
				e.text:set(text or "")
				if text then
					e.label:move(dx, y)
					e.text:move(dx, y + S.textLine)
					local _, eh = e.text:size()
					y += S.textLine + math.max(1, math.floor(eh / S.textLine + 0.5)) * S.textLine
				end
			end
			-- 퀵슬롯: 놓인 칸의 키 · 놓는 법(놓으려고 고른 중이면 민트)
			local q = ctx.quick.info(sk.id, sk.type)
			local armed = ctx.quick.picked() == sk.id
			quickAt:set(if q.state == "passive" then QWORDS.passive elseif q.state == "unlearned" then QWORDS.unlearned elseif q.state == "later" then QWORDS.later elseif q.key then Format.fill(QWORDS.at, { key = q.key }) else QWORDS.none)
			quickAt:color(if q.state == "ok" and q.key then C.gold else C.dim)
			quickHint:set(if q.state ~= "ok" then "" elseif armed then QWORDS.armed else QWORDS.hint)
			quickHint:color(if armed then C.accent else C.dim)
		end
	end

	function view.refresh(me)
		last = me
		drawReset(me)
		if not tiers then
			-- 처음: 내 직업의 차수들로 탭을 만든다. 지금 배울 수 있는 가장 높은 차수의 탭부터 보여 준다
			tiers = CLASSES.classes[me.class].tiers
			for _, t in tiers do
				for _, sk in t.skills do
					names[sk.id] = sk.name
				end
			end
			buildTabs()
			tab = math.clamp(SkillWindow.jobOf(me), 1, #tiers)
		end
		view.paint()
	end
	-- 탭을 고른다(시험 · 화면 확인용)
	function view.setTab(i: number, pick: number?)
		if tiers and tiers[i] then
			tab, selected = i, pick or 1
			view.paint()
		end
	end
	return view
end

return SkillWindow

end
MODULES['Client/lune/ui/soundWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 소리 설정 창 — 메뉴 → 「소리 설정」. 배경 음악과 효과음의 크기를 따로 열 칸으로(한 칸 10%).
--  사용자 2026-10-13: "소리조절 있어야합니다." — 그 앞에는 메뉴에 「소리 끄기 / 켜기」뿐이었다.
--  줄마다: 이름 · 「−」 · 칸 열 개(찬 칸 = 민트 — 눌러서 그 칸까지 · 모두 껐으면 흐린 회색) · 「+」 · %. 아래에 「모두 끄기 / 켜기」와 안내 글.
--  바꾸면 바로 그 크기로 나고(music.luau), 계정에 저장된다(ctx.saveSound → 서버의 Sound). 모양은 공방 시험 탭의 js/lune/ui/paint.js(paintSound)와 같다.
--  화면 오른쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Layout = require(ReplicatedStorage.shared.lune.ui.layout)
local Ui = require(script.Parent.ui)
local Music = require(script.Parent.Parent.music)

local C = Ui.COLOR
local S = Layout.SOUND

local SoundWindow = {}

function SoundWindow.size(): (number, number)
	return S.w, #S.rows * S.row + S.muteY + Ui.M.button
end

-- 줄 안에서의 자리: 첫 칸의 x · 「+」의 x
function SoundWindow.bar(): (number, number)
	local x = S.labelW + S.btn + S.barGap
	return x, x + S.steps * S.seg + (S.steps - 1) * S.gap + S.barGap
end

function SoundWindow.pct(v: number): string
	return ("%d%%"):format(math.floor(v / S.steps * 100 + 0.5))
end

function SoundWindow.build(body: Frame, ctx, w: number, _h: number)
	local view = {}
	local rows = {}
	local barX, plusX = SoundWindow.bar()
	local function set(kind: string, v: number)
		if Music.setLevel(kind, v) then
			ctx.saveSound()
			view.refresh()
		end
	end
	for i, def in S.rows do
		local kind, name = def[1], def[2]
		local y = (i - 1) * S.row
		local row = { kind = kind, segs = {} }
		Ui.text(body, name, 0, y + math.floor((S.btn - Ui.M.body) / 2), S.labelW - 6, { font = "body" })
		row.minus = Ui.button(body, "-", S.labelW, y, S.btn, function()
			set(kind, Music.level[kind] - 1)
		end, { h = S.btn, font = "body" })
		local by = y + math.floor((S.btn - S.barH) / 2)
		for k = 1, S.steps do
			local x = barX + (k - 1) * (S.seg + S.gap)
			-- 칸: 한 점 테두리(빈 칸) + 속 — 찬 칸은 둘 다 한 색
			local edge = Ui.box(body, x, by, S.seg, S.barH, C.line)
			edge.Name = "Seg" .. k
			local fill = Ui.box(edge, 1, 1, S.seg - 2, S.barH - 2, C.panel2)
			-- 누르는 자리는 칸보다 넓게(사이의 틈까지 · 줄의 높이만큼) — 손가락으로도 누른다
			Ui.hit(Ui.group(body, x, y, S.seg + S.gap, S.btn, "SegHit" .. k)).Activated:Connect(function()
				set(kind, k)
			end)
			row.segs[k] = { edge = edge, fill = fill }
		end
		row.plus = Ui.button(body, "+", plusX, y, S.btn, function()
			set(kind, Music.level[kind] + 1)
		end, { h = S.btn, font = "body" })
		row.pct = Ui.text(body, "", w - S.pctW, y + math.floor((S.btn - Ui.M.small) / 2), S.pctW, { align = "right" })
		rows[i] = row
	end
	local my = #S.rows * S.row + S.muteY
	local mute = Ui.button(body, "", 0, my, S.muteW, function()
		Music.toggle()
		ctx.saveSound()
		view.refresh()
	end)
	Ui.text(body, S.note, S.muteW + 8, my + math.floor((Ui.M.button - Ui.M.small) / 2), w - S.muteW - 8, { align = "right", color = C.dim })

	function view.refresh()
		for _, row in rows do
			local v = Music.level[row.kind]
			for k, seg in row.segs do
				local color = if k <= v then (if Music.on then C.accent else C.off) else nil
				seg.edge.BackgroundColor3 = color or C.line
				seg.fill.BackgroundColor3 = color or C.panel2
			end
			row.minus:setEnabled(v > 0)
			row.plus:setEnabled(v < S.steps)
			row.pct:set(if Music.on then SoundWindow.pct(v) else S.off)
			row.pct:color(if Music.on and v > 0 then C.text else C.dim)
		end
		mute:setText(S.mute[if Music.on then 1 else 2])
		mute:setMain(not Music.on)
	end
	view.refresh()
	return view
end

return SoundWindow

end
MODULES['Client/lune/ui/statWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 능력치 창 — 남은 점수, 다섯 능력치와 + 단추, 「자동으로 찍기」, 아래에 전투력과 체력.
--  찍는 것은 서버에 부탁한다(StatAdd · StatAuto). 서버가 내 상태를 다시 보내면 고쳐 그린다. 화면 오른쪽의 옆 판(ui/windows.luau).
--  능력치에 마우스를 올리면(터치는 그 줄을 누르면) 창 옆에 설명 판이 뜬다 — 그 직업에게 무엇을 해 주는지와 지금 레벨에서 1점에 얼마가 오르는지.
--   사용자 2026-10-07: "능력치에 각각 스텟별로 마우스 올리면 호버로 스텟 효과를 보여줘야합니다. 뭔지알고 스텟을찍으라는건지"
--   글과 숫자는 shared/lune/ui/format.luau의 statTip(공방의 횡스크롤 시험 탭 — js/lune/ui/paint.js의 paintStat · tipPanel과 같은 그림). 이 직업이 안 쓰는 능력치는 이름이 흐리다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local N = require(ReplicatedStorage.shared.lune.config.numbers)
local Format = require(ReplicatedStorage.shared.lune.ui.format)
local Layout = require(ReplicatedStorage.shared.lune.ui.layout)
local UI = require(ReplicatedStorage.shared.lune.data["ui.generated"])
local Stage = require(script.Parent.Parent.stage)
local Ui = require(script.Parent.ui)

local STATS = N.data.STATS
local C = Ui.COLOR
local S = Layout.STAT
local TIP = S.tip
local MARK = UI.statTip.marks
local TIPCOLOR = { main = C.gold, sub = C.accent, none = C.dim, hp = C.text }

local StatWindow = {}

function StatWindow.size(): (number, number)
	return Layout.statBody(#STATS.order)
end

function StatWindow.build(body: Frame, ctx, w: number, _h: number)
	local points = Ui.text(body, "", 0, 0, w, { color = C.gold })
	local rows = {}
	local last = nil -- 마지막으로 받은 내 상태
	local tip = nil -- 떠 있는 설명 판 { frame, id }

	local function hideTip()
		if tip then
			tip.frame:Destroy()
			rows[tip.id].back.Visible = false
			tip = nil
		end
	end

	-- 설명 판: 칸과 같은 판에 제목(주 노랑 · 부 민트 · 안 쓰는 것 흐림) · 그 옆의 꼬리표 · 글 줄들. 창의 왼쪽에 붙인다(창이 화면 왼쪽에 있으면 오른쪽에)
	local function showTip(id: string)
		if not last or (tip and tip.id == id) then
			return
		end
		hideTip()
		local t = Format.statTip(last.class, id, last.level)
		local color = TIPCOLOR[t.kind]
		local inner = TIP.w - TIP.pad * 2
		local frame = Ui.group(body, 0, 0, TIP.w, 10, "Tip")
		frame.ZIndex = 20
		local back = Ui.part(frame, "uTip", 0, 0, TIP.w, 10)
		local title = Ui.text(frame, t.title, TIP.pad, TIP.pad, inner, { font = "body", color = color })
		if t.tag ~= "" then
			local tw = title:size()
			Ui.text(frame, t.tag, TIP.pad + tw + 8, TIP.pad + 2, inner - tw - 8, { color = color })
		end
		local y = TIP.pad + TIP.title
		for i, line in t.lines do
			local tint = if i > 1 then (if t.kind == "none" then C.dim else C.accent) elseif t.kind == "none" then C.red else C.text
			local label = Ui.text(frame, line, TIP.pad, y, inner, { lines = TIP.lines, line = TIP.line, color = tint })
			local _, lh = label:size()
			y += math.max(1, math.floor(lh / TIP.line + 0.5)) * TIP.line
		end
		local h = y - (TIP.line - Ui.M.small) + TIP.pad
		frame.Size = UDim2.fromOffset(TIP.w, h)
		back.Size = UDim2.fromOffset(TIP.w, h)
		local left = -Ui.WIN.pad - TIP.gap - TIP.w
		if body.AbsolutePosition.X / Stage.uiScale + left < 4 then
			left = w + Ui.WIN.pad + TIP.gap -- 왼쪽에 자리가 없다(창이 화면 왼쪽에 있다)
		end
		frame.Position = UDim2.fromOffset(left, rows[id].y - 2)
		rows[id].back.Visible = true
		tip = { frame = frame, id = id }
	end

	local y = S.top
	for _, id in STATS.order do
		local ty = y + math.floor((Ui.M.button - Ui.M.body) / 2)
		local back = Ui.box(body, -6, y - 2, w - S.plusW, S.row, C.panel2)
		back.Name = "Hot"
		back.Visible = false
		local name = Ui.text(body, STATS.names[id], 0, ty, S.tagX - 4, { font = "body" })
		local tag = Ui.text(body, "", S.tagX, ty + 1, 30, { color = C.accent })
		local value = Ui.text(body, "", S.tagX + 32, ty, w - S.tagX - 32 - S.valueRight, { font = "body", align = "right" })
		local plus = Ui.button(body, "+", w - S.plusW, y, S.plusW, function()
			ctx.send("StatAdd", id, 1)
		end)
		-- 줄에 마우스를 올리면 설명이 뜨고, 벗어나면 사라진다. 터치는 줄을 누르면 뜨고 한 번 더 누르면 사라진다
		local over = Instance.new("TextButton")
		over.Name = "Over_" .. id
		over.Text = ""
		over.BackgroundTransparency = 1
		over.Position = UDim2.fromOffset(-6, y - 2)
		over.Size = UDim2.fromOffset(w - S.plusW, S.row)
		over.ZIndex = 8
		over.Parent = body
		over.MouseEnter:Connect(function()
			showTip(id)
		end)
		over.MouseLeave:Connect(function()
			if tip and tip.id == id then
				hideTip()
			end
		end)
		over.Activated:Connect(function(input)
			if input and input.UserInputType == Enum.UserInputType.Touch and tip and tip.id == id then
				hideTip()
			else
				showTip(id)
			end
		end)
		rows[id] = { name = name, tag = tag, value = value, plus = plus, back = back, y = y }
		y += S.row
	end
	y += 4
	local auto = Ui.button(body, "자동으로 찍기", 0, y, w, function()
		ctx.send("StatAuto")
	end, { main = true })
	y += Ui.M.button + 10
	Ui.line(body, 0, y, w)
	-- 전투력(왼쪽)과 체력(오른쪽)을 한 줄에
	local power = Ui.text(body, "", 0, y + 10, math.floor(w / 2), { color = C.gold })
	local hp = Ui.text(body, "", math.floor(w / 2), y + 10, w - math.floor(w / 2), { align = "right" })

	local view = {}
	function view.refresh(me)
		last = me
		local pair = STATS.classes[me.class]
		points:set(("남은 점수 %d"):format(me.ap))
		for _, id in STATS.order do
			local row = rows[id]
			local used = id == "hp" or id == pair[1] or id == pair[2]
			row.tag:set(if id == pair[1] then MARK.main elseif id == pair[2] then MARK.sub else "")
			row.value:set(tostring(STATS.base + me.stats[id]))
			row.name:color(if used then C.text else C.off)
			row.value:color(if used then C.text else C.off)
			row.plus:setEnabled(me.ap > 0)
		end
		auto:setEnabled(me.ap > 0)
		power:set(("전투력 %s"):format(Format.short(me.power)))
		hp:set(("체력 %s"):format(Format.short(me.maxHp)))
		-- 떠 있는 설명은 새 값으로(레벨이 오르면 1점의 값이 달라진다)
		if tip then
			local id = tip.id
			hideTip()
			showTip(id)
		end
	end
	-- 설명 판을 띄운다 · 지운다(시험 · 화면 확인용)
	view.showTip, view.hideTip = showTip, hideTip
	return view
end

return StatWindow

end
MODULES['Client/lune/ui/talk'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 주민과의 대화 — 그 주민 머리 위의 흰 말풍선(산나비처럼: 흰 속 · 어두운 테두리 한 점 · 아래 그림자 · 꼬리. 얼굴 칸 · 이름표를 따로 두지 않는다).
--  주민 앞에서 ↑를 누르면 뜨고, 한 번 더 누르면 다음 말, 마지막 말 뒤에는 닫힌다. 말풍선을 눌러도 ↑와 같다(스마트폰).
--  말풍선 위에는 퀘스트의 이름(노랑), 아래에는 지금 ↑가 하는 일(「↑ 다음」 · 「↑ 받는다」 · 「↑ 끝낸다」 · 「↑ 닫기」)이 적힌다. 말이 더 남았으면 말풍선 귀퉁이에 파란 점.
--  말은 장면 자료(공방 js/lune/design/town.js에서 내보낸 것)의 lines, 또는 퀘스트의 대사(받을 때 · 하는 중 · 돌려줄 때 — data/quests.generated.luau).
--  퀘스트의 대사는 마지막 말에서 ↑(또는 말풍선)를 누르면 그 일(받기 · 돌려주기)이 일어난다 — 그 전에 자리를 뜨면 아무 일도 없다.
--  말풍선은 글씨의 층(화면 틀의 고운 격자)에 그리고, 화면마다 주민의 자리(게임 세계의 도트)를 따라간다(Talk.place).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Format = require(ReplicatedStorage.shared.lune.ui.format)
local pixelText = require(script.Parent.Parent.Parent.modules.ui.pixelText)
local Stage = require(script.Parent.Parent.stage)
local Overlay = require(script.Parent.Parent.overlay)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local B = Format.BUBBLE -- 자동 검사가 주민의 말이 이 폭 · 줄 수에 들어가는지 본다
local LINE = Ui.M.bodyLine

local Talk = {}
Talk.npc = nil :: any
Talk.index = 0
Talk.TEXT_W = B.textW
Talk.LINES = B.lines
Talk.onToggle = nil :: ((any) -> ())? -- 말풍선이 뜨고 닫힐 때(뜨면 그 주민, 닫히면 nil) — 그 주민 머리 위의 퀘스트 표시가 그동안 숨는다

local root: Frame
local bubble: Frame
local back, tail, body, title, key, hint, more
local lines: { string } = {}
local onEnd: (() -> ())? = nil
local endHint: string? = nil
local size = { w = 0, h = 0 }

function Talk.init()
	root = Stage.group(Overlay.root, "Talk", 60)
	root.Visible = false
	bubble = Ui.group(root, 0, 0, 1, 1, "Bubble")
	back = Ui.part(bubble, "uBubble", 0, 0, 12, 14)
	tail = Ui.part(bubble, "uTail", 0, 0)
	tail.ZIndex = 2
	body = Ui.text(bubble, "", B.padX, B.padY, Talk.TEXT_W, { font = "body", lines = Talk.LINES, line = LINE, color = C.bubbleInk, z = 3 })
	more = Ui.box(bubble, 0, 0, 4, 4, C.mark)
	more.Name = "More"
	more.ZIndex = 3
	title = Ui.text(bubble, "", 2, -14, 300, { color = C.gold, outline = true })
	key = Ui.keycap(bubble, "↑", 0, 0)
	hint = Ui.text(bubble, "", 0, 0, 120, { color = C.accent, outline = true })
	local hit = Ui.hit(bubble)
	hit.Name = "Next"
	hit.Activated:Connect(function()
		if Talk.npc then
			Talk.next(Talk.npc)
		end
	end)
end

-- 말 한 토막이 말풍선에서 차지하는 크기(폭 · 줄 수)
function Talk.measure(text: string): (number, number)
	local fitted = pixelText.Fit(text, Talk.TEXT_W, Talk.LINES, "body")
	local w = pixelText.Measure(fitted, "body")
	return w, #string.split(fitted, "\n")
end

local function show()
	local text = lines[Talk.index]
	body:set(text)
	local tw, count = Talk.measure(text)
	local last = Talk.index >= #lines
	local hintText = if last and endHint then endHint elseif last then "닫기" else "다음"
	local w = math.max(tw, 60) + B.padX * 2
	local h = (count - 1) * LINE + 14 + B.padY * 2 -- 글 한 줄의 칸이 13(내림선 포함)
	size.w, size.h = w, h
	back.Size = UDim2.fromOffset(w, h + 2) -- 아래 두 점은 그림자
	bubble.Size = UDim2.fromOffset(w, h + B.tail)
	more.Position = UDim2.fromOffset(w - 10, h - 9)
	more.Visible = not last
	-- 말풍선 아래 오른쪽: 키 딱지와 그 키가 지금 하는 일
	hint:set(hintText)
	local hw = Ui.measure(hintText)
	hint:move(w - hw, h + 7)
	hint:color(if last and endHint then C.accent else C.text)
	key:move(w - hw - 5 - math.floor(key.width / 2), h + 5)
	if not root.Visible and Talk.onToggle then
		Talk.onToggle(Talk.npc)
	end
	root.Visible = true
	Talk.place()
end

-- 말풍선을 그 주민 머리 위에 놓는다(화면마다 — 카메라가 움직이면 따라간다). 화면 밖으로 나가지 않게 옆으로 민다(꼬리는 주민 쪽에 남는다)
function Talk.place()
	local npc = Talk.npc
	if not npc or not root.Visible then
		return
	end
	local cx = Overlay.x(npc.x)
	local bottom = Overlay.y(npc.y - (npc.h or 24) - B.up)
	local left = math.clamp(cx - math.floor(size.w / 2), 8, math.max(8, Stage.uiW - size.w - 8))
	bubble.Position = UDim2.fromOffset(left, bottom - size.h - B.tail)
	tail.Position = UDim2.fromOffset(math.clamp(cx - left - 4, 6, size.w - 15), size.h - 1)
end

-- 말을 시작한다. questName = 말풍선 위에 적을 글(퀘스트 이름) · finish = 마지막 말 뒤에 일어날 일 · finishHint = 그 일의 이름(「받는다」)
function Talk.start(npc, list: { string }, questName: string?, finish: (() -> ())?, finishHint: string?)
	Talk.npc, Talk.index = npc, 1
	lines, onEnd, endHint = list, finish, finishHint
	title:set(questName or "")
	show()
end

-- 지금 이 주민과 말하는 중인가
function Talk.with(npc): boolean
	return Talk.npc == npc and Talk.index > 0
end

-- 다음 말로(말하는 중이 아니면 그 주민의 평소 말을 시작한다). 대화가 끝났으면 false.
function Talk.next(npc): boolean
	if Talk.npc ~= npc then
		Talk.start(npc, npc.lines)
		return true
	end
	Talk.index += 1
	if Talk.index > #lines then
		local finish = onEnd
		Talk.close()
		if finish then
			finish()
		end
		return false
	end
	show()
	return true
end

function Talk.close()
	Talk.npc, Talk.index = nil, 0
	lines, onEnd, endHint = {}, nil, nil
	if root then
		if root.Visible and Talk.onToggle then
			Talk.onToggle(nil)
		end
		root.Visible = false
	end
end

return Talk

end
MODULES['Client/lune/ui/ui'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 화면 틀의 부품 — 판 · 칸 · 단추 · 키 딱지 · 띠 · 글 · 그림. 화면의 고운 격자(client/lune/stage.luau의 ui 층 — 1080p에서 960x540)에 놓는다.
--  방식은 산나비 계열 도트 게임(사용자 2026-10-07: "제가말하는건 산나비같은 도트게임을말하는거에요" → 실제 크기 시안을 보고 "훌룡합니다"):
--   판은 무채색에 강조색 하나(민트), 고른 것의 표시는 민트 테두리 한 가지. 늘 보이는 글은 판 없이 어두운 테두리를 두른 글씨로 게임 화면 위에 바로 적는다.
--   글씨는 둘뿐: 작은 글씨(small = 갈무리9 — 화면에서 20픽셀)와 본문 글씨(body = 갈무리11 — 24픽셀, 이름 · 말 · 제목).
--   그림은 둘: 화면의 것(창을 여는 단추 · 기술 칸 · 버프)은 24x24(pic), 게임 세계의 것(장비 — 땅에 떨어진 것과 같은 그림)은 게임의 굵은 도트 그대로(worldIcon).
--  부품 그림 한 장(ui_kit.png)과 그 자리 · 색 · 치수는 shared/lune/data/kit.generated.luau — 공방의 tools/build_lune_ui.mjs가 짓는다(시안 tools/preview_lune_ui_hd.mjs와 같은 그리기).
--  글은 칸을 넘지 않게 폭(width)을 꼭 준다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local KIT = require(lune.data["kit.generated"])
local ASSETS = require(lune.data["assets.generated"])
local Layout = require(lune.ui.layout) -- 창과 칸의 치수(자동 검사가 같은 값을 본다)
local pixelText = require(script.Parent.Parent.Parent.modules.ui.pixelText)
local Stage = require(script.Parent.Parent.stage)

local Ui = {}
Ui.IMAGE = ASSETS[KIT.image] or ""
Ui.M = KIT.ui.metric
local M = Ui.M
local PARTS = KIT.parts

-- 글자판을 글씨 모듈에 알린다: 작은 글씨 · 테두리를 두른 작은 글씨와 본문 글씨(본문 글씨의 맨 글자판은 글씨 모듈이 이미 갖고 있다)
for _, key in { "small", "small_o", "body_o" } do
	local meta = KIT.font[key]
	local pages = {}
	for i, file in meta.files do
		pages[i] = ASSETS[file] or ""
	end
	pixelText.Register(key, meta, pages)
end

Ui.COLOR = {}
for name, c in KIT.ui.colors do
	Ui.COLOR[name] = Color3.fromRGB(c[1], c[2], c[3])
end
local C = Ui.COLOR
Ui.PANEL_ALPHA = 1 - M.panelAlpha / 255 -- 판은 조금 비친다(그림에 이미 들어 있다 — 빈 틀로 같은 판을 만들 때 쓴다)
Ui.TIER = { [0] = C.tier0, C.tier1, C.tier2, C.tier3, C.tier4 } -- 등급의 이름 색(낡은 · 허름한 · 보통 · 좋은 · 빼어난)

-- 글씨의 이름: font = "small" | "body", outline = 테두리를 두른 것
local function fontOf(font: string?, outline: boolean?): string
	local base = font or "small"
	return if outline then base .. "_o" else base
end

function Ui.measure(text: string, font: string?): number
	return (pixelText.Measure(text, font or "small"))
end

-- ---------- 빈 틀 · 색 상자 ----------
function Ui.box(parent: Instance, x: number, y: number, w: number, h: number, color: Color3?, alpha: number?): Frame
	local f = Instance.new("Frame")
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	f.BackgroundColor3 = color or C.panel
	f.BackgroundTransparency = alpha or 0
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end

function Ui.group(parent: Instance, x: number, y: number, w: number, h: number, name: string?): Frame
	local f = Ui.box(parent, x, y, w, h, C.panel, 1)
	if name then
		f.Name = name
	end
	return f
end

-- ---------- 그림 ----------
local function image(parent: Instance, name: string, x: number, y: number, w: number, h: number): ImageLabel
	local label = Instance.new("ImageLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.ResampleMode = Enum.ResamplerMode.Pixelated
	label.Image = Ui.IMAGE
	label.Position = UDim2.fromOffset(x, y)
	label.Size = UDim2.fromOffset(w, h)
	label.Parent = parent
	return label
end

-- 그림의 속을 다른 부품으로 바꾼다(단추에 마우스를 올렸을 때 · 칸을 골랐을 때)
function Ui.swap(label: ImageLabel, name: string)
	local p = PARTS[name]
	assert(p, "없는 부품 " .. tostring(name))
	label.ImageRectOffset = Vector2.new(p.x, p.y)
	label.ImageRectSize = Vector2.new(p.w, p.h)
	if p.m then
		label.ScaleType = Enum.ScaleType.Slice
		label.SliceCenter = Rect.new(p.m, p.m, p.w - p.m, p.h - (p.mb or p.m))
	end
end

-- 부품 하나. w · h를 주면 그 크기로 늘인다(가장자리는 그대로 두고 가운데만 — 아홉 조각)
function Ui.part(parent: Instance, name: string, x: number, y: number, w: number?, h: number?): ImageLabel
	local p = PARTS[name]
	assert(p, "없는 부품 " .. tostring(name))
	local label = image(parent, name, x, y, w or p.w, h or p.h)
	Ui.swap(label, name)
	return label
end

-- 화면의 그림(24x24): 창을 여는 단추 · 기술 칸 · 버프. 이름은 공방의 아이콘 이름 — 없는 이름이면 빈 그림
function Ui.setPic(label: ImageLabel, name: string?)
	local sheet = PARTS.pics
	local at = name and sheet.icons[name]
	label.Visible = at ~= nil
	if at then
		label.ImageRectOffset = Vector2.new(sheet.x + at[1], sheet.y + at[2])
		label.ImageRectSize = Vector2.new(sheet.size, sheet.size)
	end
end

function Ui.hasPic(name: string): boolean
	return PARTS.pics.icons[name] ~= nil
end

function Ui.pic(parent: Instance, name: string?, x: number, y: number): ImageLabel
	local label = image(parent, "Pic", x, y, PARTS.pics.size, PARTS.pics.size)
	Ui.setPic(label, name)
	return label
end

-- 게임 세계의 그림(18x18 — 장비 · 돈 · 달가루)을 게임과 같은 굵은 도트로, 칸(x, y, 한 변 s)의 한가운데에 놓는다.
--  화면 틀의 배율이 바뀌면(창 크기가 달라지면) 크기를 다시 맞춘다
local worldIcons = setmetatable({}, { __mode = "k" }) -- [그림] = { x, y, s }
local function fitWorldIcon(label: ImageLabel, at)
	local side = PARTS.icons.size * Stage.ratio
	label.Size = UDim2.fromOffset(side, side)
	label.Position = UDim2.fromOffset(at.x + math.floor((at.s - side) / 2), at.y + math.floor((at.s - side) / 2))
end
function Ui.setWorldIcon(label: ImageLabel, name: string?)
	local sheet = PARTS.icons
	local at = name and sheet.icons[name]
	label.Visible = at ~= nil
	if at then
		label.ImageRectOffset = Vector2.new(sheet.x + at[1], sheet.y + at[2])
		label.ImageRectSize = Vector2.new(sheet.size, sheet.size)
	end
end
function Ui.worldIcon(parent: Instance, name: string?, x: number, y: number, s: number): ImageLabel
	local label = image(parent, "Icon", x, y, 1, 1)
	local at = { x = x, y = y, s = s }
	worldIcons[label] = at
	fitWorldIcon(label, at)
	Ui.setWorldIcon(label, name)
	return label
end
-- 글 옆에 붙이는 작은 그림(돈 · 달가루): 같은 그림을 화면 틀의 격자에 그대로(18x18점)
function Ui.smallIcon(parent: Instance, name: string, x: number, y: number): ImageLabel
	local label = image(parent, "Icon", x, y, PARTS.icons.size, PARTS.icons.size)
	Ui.setWorldIcon(label, name)
	return label
end
Stage.onResize(function()
	for label, at in worldIcons do
		if label.Parent then
			fitWorldIcon(label, at)
		end
	end
end)

-- ---------- 판 ----------
-- 어두운 판(창 · 알림 · 채팅을 쓸 때의 바탕). 돌려주는 것은 그 자리의 빈 틀 — 그 안에 내용을 놓는다
function Ui.panel(parent: Instance, x: number, y: number, w: number, h: number): Frame
	local outer = Ui.group(parent, x, y, w, h, "Panel")
	Ui.part(outer, "uPanel", 0, 0, w, h).Name = "Back"
	return outer
end

-- ---------- 글 ----------
-- 글. width = 이 글이 쓸 수 있는 폭(넘으면 줄을 바꾸고, lines를 넘으면 …로 줄인다). opts.align = "left" | "center" | "right"(그 폭 안에서)
--  opts.font = "small"(기본) · "body" / opts.outline = 어두운 테두리(판 없이 게임 화면 위에 적는 글) / opts.color / opts.lines / opts.line(줄 간격) / opts.z
function Ui.text(parent: Instance, text: string, x: number, y: number, width: number, opts)
	opts = opts or {}
	local label = pixelText.new(parent, {
		Text = text,
		Font = fontOf(opts.font, opts.outline),
		Color = opts.color or C.text,
		Align = opts.align or "left",
		MaxWidth = width,
		MaxLines = opts.lines or 1,
		Line = opts.line,
		ZIndex = opts.z,
	})
	local item = { label = label, x = x, y = y, width = width, align = opts.align or "left" }
	local function place()
		local px = item.x
		if item.align == "center" then
			px = item.x + math.floor((item.width - label.Width) / 2)
		elseif item.align == "right" then
			px = item.x + item.width - label.Width
		end
		label.Frame.Position = UDim2.fromOffset(px, item.y)
	end
	function item.set(_, value: string)
		label:SetText(value)
		place()
	end
	function item.color(_, color: Color3)
		label:SetColor(color)
	end
	function item.move(_, nx: number, ny: number)
		item.x, item.y = nx, ny
		place()
	end
	function item.show(_, on: boolean)
		label.Frame.Visible = on
	end
	-- 지금 그려진 글의 폭 · 높이
	function item.size(_): (number, number)
		return label.Width, label.Height
	end
	function item.destroy()
		label:Destroy()
	end
	place()
	return item
end

-- 이름표: 판 없이 테두리를 두른 작은 글(발밑의 이름 · 문 위의 글). 글씨 모듈의 글(Frame · Width · SetText · SetColor · Destroy)처럼 쓴다
Ui.TAG_H = M.small + 3 -- 이름표 한 줄이 차지하는 높이(쌓을 때 쓴다)
--  plate = true: 플레이어(나 · 다른 사람)의 이름표 — 어두운 판에 민트의 가는 테두리를 두른다(data/ui.generated.luau의 layout.tag.plate).
--   사용자 2026-10-08: "닉네임 표시되는게 그냥 닉네임하얀글씨로 표시되는게 아니라 얇은 우리게임 민트색 테두리같은게 있으면 좋을거같네요". 주민(노랑 글) · 졸개의 이름표는 판이 없다.
--   같은 날 글자 둘레에 민트를 두르는 방식("이름 글씨만 있는데 글자 그자체 테두리에 민트 테두리")으로 바꿔 봤다가 되돌렸다 — "생각보다 별로네요 이전방식으로 롤백".
function Ui.tag(parent: Instance, text: string, color: Color3?, maxWidth: number?, plate: boolean?)
	local label = pixelText.new(parent, { Text = text, Font = "small_o", Color = color or C.text, MaxWidth = maxWidth or 220, MaxLines = 1 })
	label.Frame.Name = "Tag"
	if plate then
		local P = Layout.TAG.plate
		local box = Instance.new("Frame")
		box.Name = "Plate"
		box.BackgroundColor3 = C.ink
		box.BorderSizePixel = 0
		box.ZIndex = 1 -- 글씨(틀 안에서 5부터) 아래
		box.Parent = label.Frame
		local stroke = Instance.new("UIStroke")
		stroke.Color = C.accent
		stroke.Thickness = 1
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.LineJoinMode = Enum.LineJoinMode.Miter
		stroke.Parent = box
		-- 글이 바뀌면 판도 그 폭에 맞춘다(빈 글이면 숨긴다)
		local function fit()
			local w = label.Frame.Size.X.Offset
			box.Visible = w > 0
			box.Position = UDim2.fromOffset(-P.padX, -P.padY)
			box.Size = UDim2.fromOffset(w + P.padX * 2, M.small + P.padY * 2)
		end
		label.Frame:GetPropertyChangedSignal("Size"):Connect(fit)
		fit()
	end
	return label
end

-- ---------- 누르는 것 ----------
function Ui.hit(parent: Instance): TextButton
	local hit = Instance.new("TextButton")
	hit.Name = "Hit"
	hit.Text = ""
	hit.BackgroundTransparency = 1
	hit.Size = UDim2.fromScale(1, 1)
	hit.ZIndex = 9
	hit.Parent = parent
	return hit
end

-- 단추(높이 26 — 글 12와 위아래 여백 7). opts.main = 그 창에서 가장 하고 싶은 일(민트로 칠한다 — 창마다 하나쯤) · opts.h = 다른 높이 · opts.font
--  onClick은 눌렀을 때(마우스 · 터치). 글은 단추 폭 안에 한 줄. 쓸 수 없을 때는 흐리게.
function Ui.button(parent: Instance, text: string, x: number, y: number, w: number, onClick: () -> (), opts)
	opts = opts or {}
	local h = opts.h or M.button
	local font = opts.font or (if h >= M.button then "body" else "small")
	local fh = if font == "body" then M.body else M.small
	local outer = Ui.group(parent, x, y, w, h, "Button")
	local item = { frame = outer, enabled = true, main = opts.main == true, hot = false }
	local back = Ui.part(outer, if item.main then "uBtnMain" else "uBtn", 0, 0, w, h)
	local label = Ui.text(outer, text, 3, math.floor((h - fh) / 2), w - 6, { align = "center", font = font, color = if item.main then C.ink else C.text })
	local function paint()
		if not item.enabled then
			Ui.swap(back, "uBtnOff")
			label:color(C.off)
		elseif item.main then
			Ui.swap(back, if item.hot then "uBtnMainHot" else "uBtnMain")
			label:color(C.ink)
		else
			Ui.swap(back, if item.hot then "uBtnHot" else "uBtn")
			label:color(C.text)
		end
	end
	local hit = Ui.hit(outer)
	hit.Activated:Connect(function()
		if item.enabled then
			onClick()
		end
	end)
	hit.MouseEnter:Connect(function()
		item.hot = true
		paint()
	end)
	hit.MouseLeave:Connect(function()
		item.hot = false
		paint()
	end)
	function item.setEnabled(_, on: boolean)
		if item.enabled ~= on then
			item.enabled = on
			paint()
		end
	end
	function item.setText(_, value: string)
		label:set(value)
	end
	function item.setMain(_, on: boolean)
		if item.main ~= on then
			item.main = on
			paint()
		end
	end
	return item
end

-- 닫기(×)
function Ui.closeButton(parent: Instance, x: number, y: number, onClick: () -> ()): ImageLabel
	local back = Ui.part(parent, "uClose", x, y)
	back.Name = "Close"
	local hit = Ui.hit(back)
	hit.Activated:Connect(onClick)
	hit.MouseEnter:Connect(function()
		Ui.swap(back, "uCloseHot")
	end)
	hit.MouseLeave:Connect(function()
		Ui.swap(back, "uClose")
	end)
	return back
end

-- 키 이름의 딱지(어두운 작은 딱지에 글자 — 칸 위 · 말풍선 아래). (cx, y) = 가운데 · 윗줄. 폭은 글에 맞춘다
Ui.KEY_H = M.key
function Ui.keycap(parent: Instance, text: string, cx: number, y: number)
	local outer = Ui.group(parent, cx, y, 1, M.key, "Key")
	local back = Ui.part(outer, "uKey", 0, 0, 8, M.key)
	local label = pixelText.new(outer, { Text = text, Font = "small", Color = C.text })
	label.Frame.Position = UDim2.fromOffset(4, 2)
	local item = { frame = outer, width = 0, cx = cx, y = y }
	local function fit()
		item.width = label.Width + 8
		outer.Size = UDim2.fromOffset(item.width, M.key)
		back.Size = UDim2.fromOffset(item.width, M.key)
		outer.Position = UDim2.fromOffset(item.cx - math.floor(item.width / 2), item.y)
		outer.Visible = label.Width > 0
	end
	function item.set(_, value: string)
		label:SetText(value)
		fit()
	end
	function item.move(_, ncx: number, ny: number)
		item.cx, item.y = ncx, ny
		fit()
	end
	function item.color(_, tint: Color3)
		label:SetColor(tint)
	end
	fit()
	return item
end

-- 칸(한 변 s). setOn(true) = 고른 것(민트 테두리)
function Ui.slot(parent: Instance, x: number, y: number, s: number)
	local outer = Ui.group(parent, x, y, s, s, "Slot")
	local back = Ui.part(outer, "uSlot", 0, 0, s, s)
	local item = { frame = outer, on = false }
	function item.setOn(_, on: boolean)
		if item.on ~= on then
			item.on = on
			Ui.swap(back, if on then "uSlotOn" else "uSlot")
		end
	end
	return item
end

-- ---------- 띠(게이지) ----------
-- 어두운 테두리 한 점 + 바탕(back — 빈 데의 색) + 채운 띠. set(0~1)
function Ui.bar(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, back: Color3?)
	local outer = Ui.box(parent, x, y, w, h, C.ink)
	outer.Name = "Bar"
	Ui.box(outer, 1, 1, w - 2, h - 2, back or C.ink).Name = "Empty"
	local fill = Ui.box(outer, 1, 1, w - 2, h - 2, color)
	fill.Name = "Fill"
	local item = { frame = outer, fill = fill }
	function item.set(_, ratio: number)
		fill.Size = UDim2.fromOffset(math.floor((w - 2) * math.clamp(ratio, 0, 1) + 0.5), h - 2)
	end
	function item.setColor(_, tint: Color3)
		fill.BackgroundColor3 = tint
	end
	return item
end

-- 가르는 줄(한 점)
function Ui.line(parent: Instance, x: number, y: number, w: number): Frame
	local f = Ui.box(parent, x, y, w, 1, C.line)
	f.Name = "Line"
	return f
end

-- ---------- 창 ----------
-- 장비 칸의 한 변: 장비 그림(게임의 굵은 도트 18개)에 사방으로 여백을 둔 크기 — 화면 틀의 배율에 따라 달라진다(1080p에서 50)
function Ui.cellSize(): number
	return Layout.cellFor(Stage.ratio)
end

-- 탭(글자만 — 고른 것은 민트 글씨에 밑줄). 돌려주는 것 { frame, width, setOn }
function Ui.tab(parent: Instance, text: string, x: number, y: number, onClick: () -> ())
	local w = Ui.measure(text)
	local outer = Ui.group(parent, x, y, w, 16, "Tab")
	local label = Ui.text(outer, text, 0, 0, w, { color = C.dim })
	local under = Ui.box(outer, 0, 13, w, 2, C.accent)
	under.Visible = false
	local item = { frame = outer, width = w, on = false }
	Ui.hit(outer).Activated:Connect(onClick)
	function item.setOn(_, on: boolean)
		if item.on ~= on then
			item.on = on
			label:color(if on then C.accent else C.dim)
			under.Visible = on
		end
	end
	return item
end

-- 창: 어두운 판 + 제목(본문 글씨) + 닫기(×) + 가르는 줄 + 속. (x, y, w, h)는 판의 자리.
--  속은 판에서 옆으로 pad(18), 위로 head(44) 안쪽이다. 돌려주는 것 { frame, body(속을 넣는 틀), w, h(속의 크기), setTitle }
Ui.WIN = { pad = Layout.WIN.pad, head = Layout.WIN.head, foot = Layout.WIN.foot, w = Layout.WIN.bodyW + Layout.WIN.pad * 2, gap = 8 }
function Ui.windowSize(bodyW: number, bodyH: number): (number, number)
	return bodyW + Ui.WIN.pad * 2, bodyH + Ui.WIN.head + Ui.WIN.foot
end
function Ui.window(parent: Instance, title: string, x: number, y: number, w: number, h: number, onClose: () -> ())
	local W = Ui.WIN
	local outer = Ui.panel(parent, x, y, w, h)
	outer.Name = "Window"
	local name = Ui.text(outer, title, W.pad, 13, w - W.pad * 2 - 20, { font = "body" })
	Ui.closeButton(outer, w - W.pad - 10, 13, onClose)
	Ui.line(outer, W.pad, 34, w - W.pad * 2)
	local body = Ui.group(outer, W.pad, W.head, w - W.pad * 2, h - W.head - W.foot, "Body")
	return { frame = outer, body = body, w = w - W.pad * 2, h = h - W.head - W.foot, setTitle = function(_, value: string)
		name:set(value)
	end }
end

return Ui

end
MODULES['Client/lune/ui/windows'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 창 관리 — 창을 열고 닫고, 한 번에 둘까지 화면의 오른쪽과 왼쪽에 하나씩 놓는다(넓은 창은 혼자 쓴다 — 가운데의 캐릭터는 늘 보인다). 창의 이름과 여는 키는 공방에서 정한 것(data/ui.generated.luau).
--  창은 화면 틀의 층(고운 격자)에 뜨는 오른쪽 옆 판이다 — 가운데의 캐릭터를 가리지 않는다(던그리드의 가방처럼. 사용자 2026-10-07의 시안 승인).
--  창마다 build(body, ctx, w, h, arg) → { refresh(me), destroy() } 꼴의 모듈을 등록한다. 서버가 내 상태를 다시 보내면 열려 있는 창을 고쳐 그린다.
--   창의 크기는 모듈의 size(arg) → 속의 폭 · 높이(없으면 기본). 장비 칸이 든 창은 칸의 크기(화면 틀의 배율을 따른다)로 정한다.
--  닫기는 ×나 여는 키를 한 번 더. (Esc는 Roblox가 제 메뉴에 쓴다 — 게임이 받지 못한다)
--  창은 처음부터 다 보이지 않는다 — 공방에서 정한 레벨(from)이 되어야 열린다(능력치 · 스킬은 Lv.2).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UI = require(ReplicatedStorage.shared.lune.data["ui.generated"])
local Layout = require(ReplicatedStorage.shared.lune.ui.layout)
local Stage = require(script.Parent.Parent.stage)
local Ui = require(script.Parent.ui)

local TOP, EDGE = Layout.WIN.top, Layout.WIN.edge -- 화면 위 · 옆 끝에서 띄우는 폭
local BODY_W, BODY_H = Ui.WIN.w - Ui.WIN.pad * 2, 300 -- 크기를 따로 정하지 않은 창의 속

local Windows = {}

local defs = {} -- [id] = { name, key, wide, size, build }
local open = {} -- 열린 차례대로 { id, win, view, arg, w, h, side("right" · "left") }
local root: Frame = nil
-- 닫기(X)를 누르는 자리: 창들보다, 그 위에 뜨는 다른 판(메뉴 · 놓을 것의 목록 · 손가락 단추)보다도 위의 층에 따로 둔다 —
--  창이 다른 것과 겹쳐도 닫기가 먼저 눌린다(사용자 2026-10-08: "겹쳐있을때 x 닫기버튼이 우선판정으로 눌려서 닫을수있어야합니다" — PC · 스마트폰 모두).
--  손가락으로도 누르기 쉽게 X 그림보다 넓게 받는다.
local closers: Frame = nil
local CLOSE_HIT = 40
local ctx = nil
local level = 1 -- 내 레벨(이 레벨에 열린 창만 쓴다)

-- 열린 창을 제 쪽 끝에 놓는다: 오른쪽 창은 화면 오른쪽 끝에, 왼쪽 창은 왼쪽 끝에(가운데의 캐릭터를 가리지 않는다)
local function layout()
	for _, o in open do
		if o.side == "left" then
			o.holder.Position = Stage.atPosition("tl", EDGE, TOP)
		else
			o.holder.Position = Stage.atPosition("tr", Stage.REF_W - EDGE - o.w, TOP)
		end
		if o.closer then
			-- X 그림(창의 오른쪽 위, 한 변 10쯤)의 한가운데에 맞춘다
			o.closer.Position = o.holder.Position + UDim2.fromOffset(o.w - Ui.WIN.pad - 5 - CLOSE_HIT / 2, 18 - CLOSE_HIT / 2)
		end
	end
end

local function at(side: string)
	for _, o in open do
		if o.side == side then
			return o
		end
	end
	return nil
end

local function other(side: string): string
	return if side == "right" then "left" else "right"
end

function Windows.init(context)
	ctx = context
	root = Stage.group(Stage.ui, "Windows", 150)
	closers = Stage.group(Stage.ui, "Closers", 300)
	-- 화면 틀의 배율이 바뀌면 창의 크기가 달라진다 — 다 닫는다(다시 열면 새 크기로 뜬다)
	Stage.onResize(function()
		while #open > 0 do
			Windows.close(open[1].id)
		end
	end)
end

-- 창을 등록한다. def = { wide = 넓은 창인가, side = 늘 그쪽에 뜨는 창("right" — 가방), size = function(arg) → 속의 폭 · 높이, build = function(body, ctx, w, h, arg) → { refresh(me), destroy() } }
function Windows.register(id: string, def)
	local info = nil
	for _, w in UI.windows do
		if w.id == id then
			info = w
		end
	end
	assert(info, "공방에 없는 창 " .. id)
	def.name = info.name
	def.key = info.key
	def.from = info.from or 1
	defs[id] = def
end

-- 아직 열리지 않은 창인가
function Windows.locked(id: string): boolean
	local def = defs[id]
	return def == nil or def.from > level
end

-- 다른 캐릭터로 들어왔다: 그 캐릭터의 레벨에서 다시 센다(열려 있던 창은 부른 쪽이 먼저 닫는다 — 낮은 레벨의 캐릭터에게는 아직 열리지 않은 창이 있다)
function Windows.resetLevel(now: number)
	level = now
end

-- 내 레벨을 알린다. 이번에 새로 열린 창의 이름표(id)들을 돌려준다
function Windows.setLevel(now: number): { string }
	local fresh = {}
	for _, w in UI.windows do
		local def = defs[w.id]
		if def and def.from > level and def.from <= now then
			table.insert(fresh, w.id)
		end
	end
	level = math.max(level, now)
	return fresh
end

function Windows.info(id: string)
	return defs[id]
end

function Windows.isOpen(id: string): boolean
	for _, o in open do
		if o.id == id then
			return true
		end
	end
	return false
end

function Windows.anyOpen(): boolean
	return #open > 0
end

-- 그쪽("right" · "left") 끝에 창이 떠 있는가(오른쪽 창은 오른쪽 위의 퀘스트 알리미를 덮는다)
function Windows.sideOpen(side: string): boolean
	return at(side) ~= nil
end

function Windows.close(id: string)
	for i, o in open do
		if o.id == id then
			if o.view and o.view.destroy then
				o.view.destroy()
			end
			o.holder:Destroy()
			if o.closer then
				o.closer:Destroy()
			end
			table.remove(open, i)
			layout()
			if ctx.changed then
				ctx.changed()
			end
			return
		end
	end
end

function Windows.closeTop(): boolean
	local top = open[#open]
	if top then
		Windows.close(top.id)
		return true
	end
	return false
end

-- arg = 창에 딸려 주는 값(같은 창이 다른 값으로 열려 있으면 닫고 다시 연다)
--  force = 아직 열리지 않은 창이어도 띄운다(창고를 열 때의 가방 — 새 캐릭터도 계정의 창고에서 바로 꺼낼 수 있어야 한다)
function Windows.open(id: string, arg: any, force: boolean?)
	local def = defs[id]
	if not def or (def.from > level and not force) then
		return
	end
	if Windows.isOpen(id) then
		if Windows.argOf(id) == arg then
			return
		end
		Windows.close(id)
	end
	-- 넓은 창은 다 닫고 혼자(오른쪽), 보통 창은 둘까지 — 오른쪽에 하나, 왼쪽에 하나.
	--  제 쪽이 정해진 창(가방 = 오른쪽)이 뜰 때 그 자리에 다른 창이 있으면 그 창을 맞은편으로 옮긴다(맞은편도 찼으면 그 자리의 창을 닫는다).
	--  쪽이 정해지지 않은 창은 빈 쪽에(오른쪽 먼저), 둘 다 찼으면 가장 먼저 연 창의 자리에.
	local side = "right"
	if def.wide then
		while #open > 0 do
			Windows.close(open[1].id)
		end
	else
		for i = #open, 1, -1 do
			if defs[open[i].id].wide then
				Windows.close(open[i].id)
			end
		end
		if def.side then
			side = def.side
			local there = at(side)
			if there then
				local across = at(other(side))
				if across or defs[there.id].side == side then
					Windows.close(there.id)
				else
					there.side = other(side)
				end
			end
		elseif not at("right") then
			side = "right"
		elseif not at("left") then
			side = "left"
		else
			-- 둘 다 찼다: 쪽이 정해지지 않은 창 가운데 가장 먼저 연 것의 자리를 쓴다(없으면 가장 먼저 연 것)
			local old = open[1]
			for _, o in open do
				if not defs[o.id].side then
					old = o
					break
				end
			end
			side = old.side
			Windows.close(old.id)
		end
	end
	local bw, bh = BODY_W, BODY_H
	if def.size then
		bw, bh = def.size(arg)
	end
	local w, h = Ui.windowSize(bw, bh)
	local holder = Stage.place(root, "Window_" .. id, "tr", 0, TOP, w, h)
	local win = Ui.window(holder, if def.title then def.title(arg) else def.name, 0, 0, w, h, function()
		Windows.close(id)
	end)
	local view = def.build(win.body, ctx, win.w, win.h, arg)
	local closer = Instance.new("TextButton")
	closer.Name = "Close_" .. id
	closer.Text = ""
	closer.BackgroundTransparency = 1
	closer.Size = UDim2.fromOffset(CLOSE_HIT, CLOSE_HIT)
	closer.Parent = closers
	closer.Activated:Connect(function()
		Windows.close(id)
	end)
	local cross = win.frame:FindFirstChild("Close")
	if cross then
		closer.MouseEnter:Connect(function()
			Ui.swap(cross, "uCloseHot")
		end)
		closer.MouseLeave:Connect(function()
			Ui.swap(cross, "uClose")
		end)
	end
	table.insert(open, { id = id, win = win, holder = holder, view = view, arg = arg, w = w, h = h, side = side, closer = closer })
	layout()
	if ctx.changed then
		ctx.changed() -- 열린 창이 바뀌었다(가방의 단추가 옆 창에 따라 달라진다) — 여기서 모두 다시 그린다
	elseif view and view.refresh and ctx.me() then
		view.refresh(ctx.me())
	end
end

function Windows.toggle(id: string)
	if Windows.isOpen(id) then
		Windows.close(id)
	else
		Windows.open(id, nil)
	end
end

-- 내 상태가 바뀌었다: 열려 있는 창을 고쳐 그린다
function Windows.refresh(me)
	for _, o in open do
		if o.view and o.view.refresh then
			o.view.refresh(me)
		end
	end
end

-- 그 창 옆(화면 가운데 쪽)에 폭 w의 판을 놓을 자리 — 아이템 상세 판(ui/itemDetail.luau)이 쓴다. 창이 열려 있지 않으면 nil.
--  오른쪽 창이면 그 왼쪽에, 왼쪽 창이면 그 오른쪽에(창과 gap만큼 띄운다). 윗줄은 창과 같다
function Windows.beside(id: string, w: number, gap: number): UDim2?
	for _, o in open do
		if o.id == id then
			if o.side == "left" then
				return Stage.atPosition("tl", EDGE + o.w + gap, TOP)
			end
			return Stage.atPosition("tr", Stage.REF_W - EDGE - o.w - gap - w, TOP)
		end
	end
	return nil
end

-- 열린 창에 딸린 값(상점 창이 누구의 것인지 등)
function Windows.argOf(id: string): any
	for _, o in open do
		if o.id == id then
			return o.arg
		end
	end
	return nil
end

-- 등록된 창의 목록(여는 키가 있는 것만, 공방의 차례대로). all = 아직 열리지 않은 것까지
local function listOf(all: boolean)
	local out = {}
	for _, w in UI.windows do
		if defs[w.id] and w.key and (all or defs[w.id].from <= level) then
			table.insert(out, { id = w.id, name = w.name, key = w.key })
		end
	end
	return out
end

-- 지금 쓸 수 있는 창
function Windows.list()
	return listOf(false)
end

-- 등록된 창 모두(키를 묶을 때 쓴다)
function Windows.all()
	return listOf(true)
end

return Windows

end
