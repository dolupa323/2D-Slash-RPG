	-- 길찾기(알리미의 화살표 단추): 누른 퀘스트를 켜고(같은 것을 다시 누르면 끈다) 알리미를 다시 그린다. 화살표는 그리는 고리가 장마다 놓는다
	state.naviArrow = NaviArrow.new()
	QuestHud.onNavi = function(key: string)
		state.navi = if state.navi == key then nil else key
		if state.drawQuests then
			state.drawQuests()
		end
	end
	state.drawQuests = function()
		local level = if state.me then state.me.level else 1
		if state.view then
			state.view:setMarks(function(npcId: string)
				if state.sceneKey == Tutorial.SCENE then
					return nil -- 꿈(튜토리얼)에는 퀘스트 표시가 없다
				end
				-- 의뢰 게시판: 낼 의뢰가 있으면 「?」 · 안 받은 의뢰가 있으면 「!」
				for region, board in Daily.DATA.boards do
					if board.npc == npcId and board.scene == state.sceneKey then
						return if level >= math.max(Daily.FROM, board.from or 0) and state.daily then Daily.mark(state.daily.boards[region]) else nil
					end
				end
				local here = SCENES.scenes[state.sceneKey]
				return Quests.mark(state.quests, level, npcId, here.region, here.also)
			end)
			-- 그 퀘스트를 받아야 열리는 문(달의 사당 안의 「사당 지하」 — 메인 「불타는 마을」): 받기 전에는 보이지 않는다
			state.view:setPortals(function(p)
				return Quests.portalOpen(state.quests, p)
			end)
		end
		-- 길찾기: 켜 둔 퀘스트에 더 안내할 것이 없으면(끝냈다 · 의뢰가 바뀌었다) 끈다
		if state.navi and not Navi.target(state.navi, state.quests, level, state.daily) then
			state.navi = nil
		end
		QuestHud.navi = state.navi
		QuestHud.set(state.quests, state.npcNames, level, Daily.tracked(state.daily))
		drawSpots() -- 맵에 놓인 것 앞에서 ↑를 누르는 퀘스트의 자리
		drawShards() -- 달조각(2026-10-16)
		Windows.refresh(state.me)
	end

	-- 스마트폰 단추(터치 화면이면 저절로 켜진다)
	local touchMenu: Frame? = nil
	state.closeTouchMenu = function() -- (장면 · 대화가 시작되면 닫는다 — closeMenus)
		if touchMenu then
			touchMenu:Destroy()
			touchMenu = nil
		end
	end
	Touch.init({
		-- 칸 단추에 놓을 수 있는 것: 물약과 배운(쓸 수 있는) 스킬 — 놓을 것의 목록에 뜬다
		choices = function()
			-- 소비 아이템: 가방에 있는 것과 이미 단추에 놓아 둔 것(다 써서 0개여도 놓아 둔 것은 남는다)
			local list = {}
			for _, g in Items.data.GOODS do
				if g.tab == "use" and (Bag.countIn(state.bag, g.id) > 0 or Quick.find(state.touchSlots, g.id)) then
					table.insert(list, { what = g.id, name = g.short })
				end
			end
			for _, sk in mySkills do
				if quickHooks.state(sk.id) == "ok" then
					table.insert(list, { what = sk.id, name = sk.name })
				end
			end
			-- 배운 버프 · 설치 · 소환(쓰는 동작이 있는 것은 위의 기술 목록에 있다)
			for _, t in CLASSES.classes[state.who].tiers do
				for _, sk in t.skills do
					local placedDef = COMBAT.placed[sk.id]
					if not COMBAT.skills[sk.id] and ((Buffs.is(sk.id) and Buffs.learned(kitHero(), sk.id)) or ((placedDef ~= nil or COMBAT.cast[sk.id] ~= nil) and (state.me.skills[sk.id] or 0) > 0)) then
						table.insert(list, { what = sk.id, name = sk.name })
					end
				end
			end
			-- 배운 온오프 사출기
			local toggle = KitSim.data[state.who].toggle.id
			if KitSim.isToggle(kitHero(), toggle) then
				for _, sk in CLASSES.classes[state.who].skills do
					if sk.id == toggle then
						table.insert(list, { what = toggle, name = sk.name })
					end
				end
			end
			return list
		end,
		apply = quickHooks.apply,
		-- 누르고 있으면 이어서 쓰는 스킬: 공격 스킬(사냥기 · 보스기)
		--  힘을 모을 수 있는 기술(힘 모으기를 배운 액시온의 강타 기술)은 이어 쓰지 않는다 — 누르고 있으면 모인다
			repeats = function(id: string): boolean
			-- 2~4차의 사냥기 · 보스기도 이어 쓴다 — 누르고 있는 것(몰아치기 · 난도질 · 난타) · 모으는 것(초승달 가르기) · 이어 누르는 것은 빼고
			local castDef = COMBAT.cast[id]
			if castDef then
				if castDef.type ~= "mob" and castDef.type ~= "boss" then
					return false
				end
				for _, s in Kitset.skill(id).segs or {} do
					if s.hold or s.charge or s.needPress then
						return false
					end
				end
				return true
			end
			local def = COMBAT.skills[id]
			return def ~= nil and (def.type == "mob" or def.type == "boss") and KitSim.chargeTime(kitHero(), id) == 0
		end,
		-- 상황 단추: 떨어진 것이 가까우면 줍고, 아니면 ↑(문 · 주민)
		onAct = function(down: boolean)
			if not down then
				Input.release("pickup")
				Input.release("up")
			elseif state.fx and state.fx:dropNear(state.body.x, state.body.y, RULES.pickup) then
				Input.press("pickup")
			else
				Input.press("up")
			end
		end,
		onToggle = function(on: boolean)
			Hud.setTouch(on)
			QuestHud.setTouch(on)
			GainLog.setTouch(on)
			if state.placeParty then
				state.placeParty() -- 폰에서는 파티원 칸을 제자리에(채팅 창은 Roblox 단추로 여닫는다)
			end
		end,
		-- 메뉴: 창 이름이 적힌 큰 단추들
		onMenu = function()
			if touchMenu then
				touchMenu:Destroy()
				touchMenu = nil
				return
			end
			local items = Windows.list() -- 키 설정은 넣지 않는다(손가락 단추에는 바꿀 키가 없다)
			-- 키 없이 「메뉴」 안에 두는 창(출석 · 업적 · 모험의 서 · 게임 설정 — PC의 「메뉴」와 같다). 전에는 빠져 폰에서는 출석 · 업적을 열 수 없었다(2026-10-18 검토)
			for _, w in UI_DATA.windows do
				if w.menu and w.id ~= "keys" and Windows.info(w.id) and (not w.need or (state.bond and state.bond.open)) then
					table.insert(items, { id = w.id, name = w.name })
				end
			end
			state.touchMenuItems = {}
			if state.me ~= nil and state.me.admin ~= nil then
				table.insert(items, { id = "admin", name = "관리" }) -- 관리자에게만
			end
			table.insert(items, { id = "@arrange", name = "단추 배치" }) -- 스킬 · 물약을 단추에 놓는다
			table.insert(items, { id = "@chars", name = "캐릭터 선택" }) -- 저장하고 캐릭터 고르기 화면으로 돌아간다
			-- 단추가 화면보다 길면(폰의 화면 틀은 768x432 — 단추 열셋이면 520) 판은 화면에 들어가는 만큼만 서고, 그 안에서 위아래로 민다
			--  사용자 2026-10-13(폰에서 해 보고): "메뉴탭 열었을때 스크롤이 되어야해 모든메뉴를 접근할수가 없다" — 치수는 Layout.touchMenu(공방 ui.js의 UILAYOUT.touchMenu)
			local m = Layout.touchMenu(#items, Stage.uiH)
			local K = Layout.TOUCHMENU
			local holder = Stage.place(Stage.ui, "TouchMenu", "tc", 480 - m.w / 2, m.top, m.w, m.h)
			holder.ZIndex = 160
			local panel = Ui.panel(holder, 0, 0, m.w, m.h)
			local list = Ui.scroll(panel, K.pad, K.pad, m.w - K.pad * 2, m.viewH, m.contentH, K.bar)
			list.Name = "List"
			list.ZIndex = 2
			for i, win in items do
				local itemBtn = Ui.button(list, win.name, 0, (i - 1) * K.row, m.btnW, function()
					holder:Destroy()
					touchMenu = nil
					if win.id == "@arrange" then
						Touch.arrange(true)
					elseif win.id == "@chars" then
						state.toSelect()
					else
						Windows.toggle(win.id)
					end
				end, { h = K.btnH, font = "body", main = win.id == "@arrange" })
				state.touchMenuItems[win.id] = itemBtn.frame -- 튜토리얼(꿈)이 그 줄을 반짝이게 한다
			end
			touchMenu = holder
		end,
	})

	Touch.setCounts()

	-- 내 상태가 올 때마다: 레벨이 올라 새 창이 열리면 메뉴 칸이 생기고 한 번 반짝인다 · 스마트폰 물약 단추의 남은 수
	state.afterSelf = function(me)
		jobCall() -- 전직할 레벨이 됐으면 「달이 부른다」
		local fresh = Windows.setLevel(me.level)
		if #fresh > 0 then
			drawKeyHints()
			for _, id in fresh do
				Hud.flashMenu(id)
			end
		end
	end

	-- 게임에 들어온다: 처음 화면(캐릭터 고르기) 위로 막을 치고 → 그 뒤에서 게임 화면을 그리고 → 그림이 다 불러와지면 막을 걷는다(아래 — 화면이 돌기 시작한 뒤)
	Curtain.cover()
	enterScene(first.scene, first.x, first.y, first.room)
	Title.close() -- 게임 화면이 그려졌다: 처음 화면을 걷는다
	state.busy = true

	-- 캐릭터 고르기 화면으로 돌아간다(메뉴 → 캐릭터 선택): 서버가 저장하고 세계에서 빼 준 뒤, 고르기 화면에서 고른 캐릭터로 다시 들어온다.
	--  그동안 게임 화면은 멈춰 있다(자리 보고 · 기술 · 창을 여는 키를 받지 않는다). 확인용 임시 캐릭터(LuneGuest = 직업)에게는 고르기 화면이 없다.
	state.toSelect = function()
		if state.paused then
			return
		end
		state.paused = true
		Input.paused = true
		while Windows.closeTop() do
		end
		Talk.close()
		local left = Net.Invoke("Chars", "leave", nil, nil)
		if not (left and left.select) then
			state.paused, Input.paused = false, false
			if state.fx then
				state.fx:float("이 캐릭터로는 캐릭터 선택으로 갈 수 없다", state.body.x, state.body.y - 46, Effects.MINT, 1.6)
			end
			return
		end
		-- 게임 화면의 것(이름표 · 문 위의 글 · 손가락 단추)은 고르기 화면 위에 비치지 않게 숨긴다
		local touchWas = Touch.root ~= nil and Touch.root.Visible
		Hud.root.Visible = false
		Overlay.root.Visible = false
		if Touch.root then
			Touch.root.Visible = false
		end
		DeathBox.hide()
		Guide.clear()
		PartyHud.ask(nil) -- 앞 캐릭터가 받은 파티 초대는 지운다(서버는 이미 지웠다 — 2026-10-18 검토)
		closeMenus()
		Music.play(MUSIC.title)
		local got = Title.run(left.select, {
			skipLoading = true,
			invoke = function(action: string, a: any, b: any)
				return Net.Invoke("Chars", action, a, b)
			end,
		})
		adopt(got)
		state.daily = nil
		state.fetchDaily() -- 바꿔 들어온 캐릭터의 일일 의뢰
		state.attend, state.ach = nil, nil
		state.fetchAttend() -- 출석 칸(오늘 처음이면 창이 뜬다 — 계정에 하루 한 번이라 대개는 이미 찼다)
		Windows.resetLevel(got.self.level)
		Input.reset()
		Input.import(got.self.keys)
		drawKeyHints()
		Touch.setCounts()
		Curtain.cover() -- 고르기 화면 위로 막을 치고, 그 뒤에서 게임 화면을 그린다
		enterScene(got.scene, got.x, got.y, got.room)
		Hud.root.Visible = true
		Overlay.root.Visible = true
		if Touch.root then
			Touch.root.Visible = touchWas
		end
		Title.close()
		state.acc = 0
		state.busy = true
		state.paused, Input.paused = false, false
		task.spawn(function()
			showLoaded() -- 그 장면의 그림이 다 불러와진 뒤에 막을 걷는다
			Curtain.lift()
			afterLift()
			Input.flush()
			state.busy = false
		end)
	end

	local markT = 0
	RunService:BindToRenderStep("LuneFrame", Enum.RenderPriority.Camera.Value - 1, function(dt)
		if state.paused then
			return -- 캐릭터 고르기 화면에 가 있다
		end
		state.now += dt
		state.acc = math.min(state.acc + dt, STEP * MAX_STEPS)
		while state.acc >= STEP do
			state.acc -= STEP
			step()
		end
		draw(dt)
		if CashShop.isOpen() then
			CashShop.step(state.now, dt) -- 달빛 상점의 미리보기(내 캐릭터 · 펫 · 탈것)
			if Input.take("win:cash") then
				CashShop.leave(state.shopCtx) -- ` 키를 한 번 더: 나온다
			end
		end
		Hud.step(dt) -- 체력 바의 효과
		QuestHud.step(state.now) -- 켠 길찾기 단추의 빛
		-- 길찾기의 화살표: 켜 둔 퀘스트의 지금 진행에 맞는 쪽을 머리 위에(쓰러졌거나 장면을 바꾸는 중에는 숨긴다)
		if state.naviArrow then
			local dirNow = nil
			if state.navi and not state.dead and not state.busy and state.me and not CineView.active() then -- 장면이 도는 동안은 화살표를 숨긴다
				Navi.prepare(state.sceneKey) -- 이 맵의 발판과 길을 조금씩 잰다(다 재면 화살표가 발판을 따라 가리킨다)
				-- 땅에 서 있는 동안 1초에 10번만 다시 셈한다(맵이 바뀌었거나 방향이 없으면 바로 — 2026-10-18 검토: 매 장면 맵 사이의 길 · 발판 길을 다시 셈했다)
				if state.naviDir == nil or state.naviScene ~= state.sceneKey or (state.body.ground and state.now - (state.naviAt or -9) >= 0.1) then
					state.naviAt = state.now
					local mobs = {}
					if state.mobs then
						for id, m in state.mobs.mobs do
							if m.state ~= "gone" and m.state ~= "dead" then
								-- 길찾기는 { id, kind, x, y }를 본다 — 화면의 몬스터는 종류 · 높이를 info에 둔다(2026-10-18 검토: 그대로 넘겨 종류가 맞지 않아 사냥터에서 화살표가 몬스터를 가리키지 않고 사라졌다)
								table.insert(mobs, { id = id, kind = m.info.kind, x = m.x, y = m.info.y })
							end
						end
					end
					local arrow = Navi.arrow(state.navi, state.sceneKey, state.body.x, state.body.y, state.quests, state.me.level, state.daily, mobs)
					state.naviDir, state.naviScene = if arrow then arrow.dir else "none", state.sceneKey
				end
				-- 뛰어오른 동안에는 땅에 있을 때의 방향을 그대로 둔다(공중에서는 선 발판이 없어 길을 셈하지 못한다 — 화살표가 깜빡이지 않게)
				dirNow = state.naviDir
			else
				state.naviDir = nil
			end
			state.naviArrow:set(dirNow, state.body.x, state.body.y, state.now)
		end
		if state.me and state.body then
			if state.skill then
				TutView.cast = true -- 튜토리얼: 기술을 썼다
			end
			-- 꿈(튜토리얼)에서는 Lv.1이어도 가방이 열린다(「가방 열기」 미션) — 꿈을 나서면 거둔다. 바뀌면 화면 아래의 단추 줄을 다시 그린다
			local dreaming = state.sceneKey == Tutorial.SCENE
			if (Windows.extra.bag == true) ~= dreaming then
				Windows.extra.bag = if dreaming then true else nil
				if not dreaming then
					Windows.close("bag")
				end
				if state.drawKeyHints then
					state.drawKeyHints()
				end
			end
			local skillKey, skillName = state.slotOf("mob")
			TutView.update({
				tut = state.me.tut, skip = state.me.tutSkip, scene = state.sceneKey, zones = SCENES.scenes[state.sceneKey] and SCENES.scenes[state.sceneKey].tut,
				body = state.body, touch = Touch.on, key = state.keyName, dt = dt,
				skill = if skillKey then ("%s 키 「%s」"):format(skillKey, skillName or "") else nil, potion = (state.slotOf("potion")),
				windows = { bag = Windows.isOpen("bag"), stat = Windows.isOpen("stat"), skill = Windows.isOpen("skill") }, find = state.tutFind,
			})
		end
		Guide.step(dt)
		MapName.step(dt, (BossView.box ~= nil and BossView.box.Visible) or CineView.active() or Windows.anyOpen()) -- 보스 체력 · 퀘스트 연출이 그 자리를 쓰거나 창이 열리면(창의 윗부분과 겹친다 — 2026-10-18) 바로 사라진다. 보스 체력은 칸이 보일 때만(전에는 한 번 보인 보스의 이름이 남아, 첫 보스 뒤로 맵 이름이 영영 안 떴다 — 2026-10-18 검토)
		GainLog.step(dt)
		markT += dt
		if markT >= 0.25 then
			markT = 0
			debugMarks()
			Guide.setHint(if Talk.npc then nil else state.guide()) -- 말풍선이 떠 있는 동안은 안내를 걷는다
		end
	end)
	-- 처음 장면의 그림이 다 불러와지면 막을 걷는다(그때까지 캐릭터는 멈춰 있다)
	task.spawn(function()
		showLoaded()
		Curtain.lift()
		afterLift()
		Input.flush()
		state.busy = false
	end)
	print(("[lune] 시작 — 장면 %s · 캐릭터 %s · 배율 x%s"):format(state.sceneKey, state.who, tostring(math.floor(Stage.scale * 100 + 0.5) / 100)))
end

return Boot

end
MODULES['Client/lune/bossView'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 스토리 보스의 화면 — 예고(바닥에 칠해지는 맞을 자리 · 머리 위의 느낌표) · 치는 순간의 이펙트 그림과 화면 흔들림 · 땅 울림의 물결 · 내달리기의 잔상과 먼지 ·
--  화면 위 가운데의 체력 바(이름 · 숫자 · 지금 쓰는 패턴의 이름).
--  보스가 무엇을 하는지는 서버가 정한다(sim/room.luau의 stepBoss) — 여기서는 서버가 보내는 모습(상태 · 패턴의 차례 · 흐른 시간: mobsView가 받아 적는다)이
--  바뀌는 때를 보고 그림을 띄운다. 그리는 것은 shared/lune/bossfx.luau(공방 시험 탭의 bossfx.js를 옮긴 것), 자료는 COMBAT.mobs[보스].story(공방 design/bosses.js의 STORYBOSS).
--  몸의 그림(대기 그림을 움직여 대신하는 것 · 예고 때의 분홍 윤곽)은 mobsView.luau가 그린다.
--  사용자 2026-10-11(해 보고): "뭐 보스 패턴도 없고 이펙트도없고 체력 몇인지도 숫자로안보이고 …" → 체력 바 안에 숫자(지금/최대)를 적고, 패턴을 쓸 때 그 이름을 바 아래에 띄우고, 예고와 이펙트를 크게 했다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local BossFx = require(lune.bossfx)
local BossPat = require(lune.sim.bosspat) -- 표시된 자리 · 도약 · 물결의 자리와 시간(서버와 같은 셈)
local MobsView = require(script.Parent.mobsView)
local Layout = require(lune.ui.layout)
local Format = require(lune.ui.format)
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)
local HpBar = require(script.Parent.ui.hpBar) -- 체력 바의 효과(플레이어의 체력 바와 같은 셈)

local C = Ui.COLOR
local M = Ui.M
local TRAIL = 0.05 -- 내달리는 동안 발밑의 먼지를 내는 간격(초 — 그 패턴에 적힌 것이 없을 때)
local GHOST = 0.07 -- 내달리는 동안 잔상을 남기는 간격(초)
local PINK = Color3.fromRGB(255, 126, 162) -- 패턴의 이름 · 잔상(적의 분홍)

local BossView = {}
BossView.__index = BossView

-- 화면 위 가운데의 체력 바(한 번 만든다): 이름(금색) · 넓은 바(안에 지금/최대 숫자) · 그 아래에 지금 쓰는 패턴의 이름(분홍)
--  공방 「기본 · UI」의 UILAYOUT.boss · 시험 탭의 P.bossBar와 같은 자리 · 크기
function BossView.init(root: Frame)
	local B = Layout.BOSS
	local box = Stage.place(root, "Boss", "tc", math.floor((Stage.REF_W - B.w) / 2), B.y, B.w, B.patY + 16)
	box.Visible = false
	BossView.box = box
	BossView.name = Ui.text(box, "", 0, 0, B.w, { font = "body", color = C.gold, align = "center", outline = true })
	BossView.bar = Ui.bar(box, 0, B.barY, B.w, B.h, C.hp)
	BossView.barFx = HpBar.attach(BossView.bar, B.w, B.h) -- 닳은 자리가 밝게 남았다 줄어든다 · 번쩍임(사용자 2026-10-13: "몬스터 체력바도  유저 체력바처럼 고도화 되어야합니다.")
	BossView.hpText = Ui.text(box, "", B.pad, B.barY + math.floor((B.h - M.small) / 2), B.w - B.pad * 2, { align = "center", outline = true, z = 6 })
	BossView.pat = Ui.text(box, "", 0, B.patY, B.w, { font = "body", color = PINK, align = "center", outline = true })
	BossView.shownName, BossView.shownHp, BossView.shownPat = nil, nil, nil
end

-- 체력 글: "지금 / 최대"(칸에 안 들어가면 짧게 — shared/lune/ui/format.luau의 hp)
function BossView.hpLabel(hp: number, maxHp: number, width: number, measure): string
	return Format.hp(math.max(0, math.ceil(hp)), maxHp, width, measure)
end

-- mobs = 그 장면의 졸개 그림(mobsView) · cast = 기술의 이펙트를 돌리는 것(cast.fx = 이펙트 한 벌 · 화면 흔들기) · effects = 장면의 효과(잔상) · scene = 장면 자료(bosses의 range = 내달리기의 끝)
--  hooks = { push(x, dist) } — 보스가 포효할 때 부른다(x = 보스의 자리 · dist = 밀어내는 거리): 내 캐릭터가 가까이 있으면 밀려난다(boot.luau)
--          music(곡의 이름표 또는 nil) — 보스가 나타나 그 곡으로 바꿀 때 · 쓰러지거나 사라져 맵의 곡으로 돌아갈 때(nil)
function BossView.new(mobs, cast, effects, scene, hooks)
	local self = setmetatable({ cast = cast, effects = effects, list = {}, hooks = hooks or {}, spots = {} }, BossView)
	-- 이펙트 한 벌: 예고(맞을 자리 · 느낌표)는 기술의 이펙트와 같은 판(cast.fx)에 그리고, 패턴의 이펙트 그림(스프라이트)은 장면의 효과(effects:play)가 튼다
	self.fx = setmetatable({
		sprite = function(who: string, clip: string, x: number, y: number, dir: number, opts)
			if effects and effects.play then
				effects:play(who, clip, x, y, dir, opts)
			end
		end,
	}, { __index = cast.fx })
	self.roomLo, self.roomHi = BossPat.bounds(scene) -- 표시된 자리들이 놓이는 범위(서버와 같다)
	self.shake = function(amount: number, t: number)
		cast.shakeA, cast.shakeT = math.max(cast.shakeA or 0, amount), math.max(cast.shakeT or 0, t)
	end
	-- 방의 양 끝(보스가 선 바닥 바로 위의 줄에서 막힌 칸이 아닌 첫 칸 · 끝 칸): 땅 울림의 물결을 그 밖으로는 그리지 않는다(서버의 판정도 벽에서 멈춘다)
	self.lo, self.hi = 0, scene.w * 16
	local first = (scene.bosses or {})[1]
	if first then
		local row = scene.rows[math.floor((first.y - 1) / 16) + 1]
		local mid = math.floor(first.x / 16)
		local a, b = mid, mid
		while a > 0 and string.sub(row, a, a) ~= "#" do
			a -= 1
		end
		while b < scene.w - 1 and string.sub(row, b + 2, b + 2) ~= "#" do
			b += 1
		end
		self.lo, self.hi = a * 16, (b + 1) * 16
	end
	local range = {}
	for _, b in scene.bosses or {} do
		range[b.kind] = b.range
	end
	for _, m in mobs.mobs do
		if m.def.story then
			local r = range[m.info.kind] or { 0, scene.w * 16 }
			table.insert(self.list, { m = m, state = m.state, pat = m.pat or 0, a = r[1], b = r[2], trail = 0, ghost = 0, x = nil :: number? })
		end
	end
	table.sort(self.list, function(p, q)
		return p.m.info.id < q.m.info.id
	end)
	return self
end

function BossView:update(dt: number)
	local shown, shownPat = nil, ""
	local now = os.clock()
	for _, b in self.list do
		local m = b.m
		local pat = m.pat or 0
		local S = m.def.story
		local p = MobsView.patOf(m) -- 연속기 안에서는 예고 · 굳는 시간이 줄어든 것
		local y = m.info.y
		local top = m.sprite.char.fh -- 그림의 높이(뿔 · 깃발까지) — 느낌표를 그 위에 띄운다
		local who = m.sprite.who -- 패턴의 이펙트 그림은 그 보스의 동작 묶음에 있다
		if m.state == "tell" and p and (b.state ~= "tell" or b.pat ~= pat) then
			-- 예고가 시작됐다: 그 자리에(보스는 예고하는 동안 서 있다 — 연속기는 한 걸음 다가서며) 맞을 자리와 머리 위의 느낌표를 그린다 — 끊기면(묶임) 그리지 않는다
			--  도약 찍기: 내려앉을 자리는 겨눈 사람을 따라오고(m.aim), 날아가는 동안에도 보인다
			b.x = m.toX
			self.fx.add(p.tell + (if p.leap then p.leap.time else 0) + 0.5, function(ctx)
				if m.state == "tell" and m.pat == pat then
					BossFx.tell(ctx, m.x, y, m.dir, p, math.clamp((m.tNow or 0) / p.tell, 0, 1), b.a, b.b, top, m.aim)
				elseif p.leap and m.state == "act" and m.pat == pat and (m.tNow or 0) < p.leap.time then
					BossFx.tell(ctx, b.leapX or m.x, y, b.leapDir or m.dir, p, 1, b.a, b.b, nil, m.aim)
				end
			end, { back = true })
			if p.spots then
				-- 표시된 자리들(불씨 뿌리기 · 봉화 불기둥): 지금 정해진다 — 예고가 끝나면(자리마다 더 기다린 뒤) 솟는다. 자리는 서버와 같은 식으로 센다
				local fromX, fromY = nil, nil
				if p.spots.aim ~= "grid" then
					fromX, fromY = m.toX - m.dir * 10, y - m.def.body[2] - 16 -- 등의 화로에서 불씨가 날아온다
				end
				for _, sp in BossPat.spots(p, m.aim or m.toX, self.roomLo, self.roomHi) do
					local spot = { m = m, who = who, pat = pat, x = sp[1], at = now, T = p.tell + sp[2], def = p.spots, live = true, armed = false }
					table.insert(self.spots, spot)
					self.fx.add(spot.T + 0.1, function(ctx)
						if spot.live then
							BossFx.spot(ctx, spot.x, y, spot.def.r, spot.def.up, (os.clock() - spot.at) / spot.T, fromX, fromY)
						end
					end, { back = true })
				end
			end
		elseif (m.state == "act" or m.state == "dash") and p and b.state == "tell" then
			local x = m.toX
			if p.leap then
				-- 도약: 뛰어오른다 — 이펙트와 물결은 내려앉을 때
				BossFx.jump(self.fx, who, p, b.x or x, y)
				b.leapX, b.leapDir, b.leapPat = b.x or x, m.dir, pat
			else
				-- 친다: 그 순간의 이펙트(화면이 흔들린다) · 물결(화면이 조금 늦게 알았으면 그만큼 간 자리에서 시작한다)
				BossFx.strike(self.fx, who, p, x, y, m.dir, self.shake)
				for _, spot in self.spots do
					if spot.m == m and spot.pat == pat then
						spot.armed = true -- 예고가 끝까지 갔다: 표시된 자리는 이제 보스가 무엇을 하든 제 때에 솟는다
					end
				end
				if p.wave then
					for _, w in BossPat.waves(p, m.dir) do
						BossFx.wave(self.fx, who, x + m.dir * p.wave.at, y, w[1], p.wave, (m.tNow or 0) - w[2], self.lo, self.hi)
					end
				end
			end
			b.trail, b.ghost = 0, 0
			b.dashP = if p.dash then p else nil -- 내달리기가 끝날 때(그때는 패턴이 이미 바뀌어 있다) 그 패턴의 그림으로 터진다
		elseif b.state == "dash" and m.state ~= "dash" and m.state ~= "gone" and m.state ~= "dead" then
			-- 내달리기가 끝났다(벽에 닿았다)
			BossFx.crash(self.fx, who, b.dashP, m.toX, y, m.dir, self.shake)
		elseif m.state == "roar" and b.state ~= "roar" then
			-- 체력 구간의 포효: 큰 고리와 긴 흔들림 — 가까이 있는 내 캐릭터는 밀려난다
			BossFx.roar(self.fx, who, S, m.toX, y, self.shake)
			if self.hooks.push and S.phase then
				self.hooks.push(m.toX, S.phase.push)
			end
		end
		if b.leapPat and (m.state ~= "act" or m.pat ~= b.leapPat) then
			b.leapPat = nil -- 뛰어오른 것이 끊겼다(묶임)
		elseif b.leapPat and p and p.leap and (m.tNow or 0) >= p.leap.time then
			-- 도약: 내려앉았다 — 그 자리에서 친다
			b.leapPat = nil
			BossFx.strike(self.fx, who, p, m.toX, y, m.dir, self.shake)
			if p.wave then
				for _, w in BossPat.waves(p, m.dir) do
					BossFx.wave(self.fx, who, m.toX + m.dir * p.wave.at, y, w[1], p.wave, (m.tNow or 0) - p.leap.time - w[2], self.lo, self.hi)
				end
			end
		end
		if m.state == "dash" then
			b.trail -= dt
			if b.trail <= 0 then
				local dp = if p and p.dash then p else b.dashP
				b.trail = (dp and dp.dash.trail and dp.dash.trail.every) or TRAIL
				BossFx.dashTrail(self.fx, who, dp, m.x, y, m.dir)
			end
			b.ghost -= dt
			if b.ghost <= 0 and self.effects then
				b.ghost = GHOST
				self.effects:ghost(m.def.sprite, "idle", 1, m.x, y, m.dir, PINK) -- 달리는 몸의 잔상(분홍)
			end
		end
		if (b.state ~= m.state or b.pat ~= pat) and BossView.box then
			-- 확인용: 지금 보스가 하는 것을 체력 바의 틀에 적어 둔다(PlayerGui.LuneStage.Holder.Ui.Hud.Boss의 속성 State · Pattern · Chain)
			if m.state ~= "gone" then
				BossView.box:SetAttribute("State", m.state)
				BossView.box:SetAttribute("Pattern", if p then p.id else "")
				BossView.box:SetAttribute("Chain", if S.patterns[m.chain or 0] then S.patterns[m.chain].id else "")
			end
		end
		b.state, b.pat = m.state, pat
		if m.state ~= "gone" and m.state ~= "dead" then
			shown = m
			-- 바 아래의 이름: 포효 = 그 이름 · 연속기 = 연속기의 이름 · 그 밖에는 패턴의 이름
			local chain = S.patterns[m.chain or 0]
			shownPat = if m.state == "roar" and S.phase then S.phase.name elseif p and (m.state == "tell" or m.state == "act" or m.state == "dash") then (if chain then chain.name else p.name) else ""
		end
	end
	-- 표시된 자리들: 때가 되면 솟는다. 예고하던 중에 끊기거나(묶임) 보스가 쓰러지면 사라진다(서버와 같다)
	for i = #self.spots, 1, -1 do
		local spot = self.spots[i]
		local m = spot.m
		local age = now - spot.at
		if m.state == "dead" or m.state == "gone" or (not spot.armed and not (m.state == "tell" and m.pat == spot.pat)) then
			spot.live = false
			table.remove(self.spots, i)
		elseif age >= spot.T then
			spot.live = false
			table.remove(self.spots, i)
			BossFx.blast(self.fx, spot.who, spot.x, m.info.y, spot.def, self.shake)
		end
	end
	-- 보스의 곡: 보스가 나타나 있는 동안은 그 보스의 곡을(없으면 그 맵의 곡 그대로), 쓰러지거나 사라지면 맵의 곡으로 — 바뀔 때만 알린다(boot.luau가 튼다)
	local track = if shown then shown.def.story.music else nil
	if track ~= self.track then
		self.track = track
		if self.hooks.music then
			self.hooks.music(track)
		end
	end
	local box = BossView.box
	if not box then
		return
	end
	box.Visible = shown ~= nil
	if shown then
		if BossView.shownName ~= shown.info.name then
			BossView.shownName = shown.info.name
			BossView.name:set(shown.info.name)
		end
		if BossView.shownMob ~= shown then
			BossView.shownMob = shown -- 다른 보스 · 다시 나타난 보스: 효과 없이 그대로 놓는다
			BossView.shownHp = nil
			BossView.barFx:reset()
		end
		if BossView.shownHp ~= shown.hp then
			BossView.shownHp = shown.hp
			BossView.barFx:set(math.max(0, shown.hp) / shown.info.maxHp, math.max(0, shown.hp))
			BossView.hpText:set(BossView.hpLabel(shown.hp, shown.info.maxHp, Layout.BOSS.w - Layout.BOSS.pad * 2, Ui.measure))
		end
		if BossView.shownPat ~= shownPat then
			BossView.shownPat = shownPat
			BossView.pat:set(shownPat)
		end
		BossView.barFx:step(dt)
	else
		BossView.shownMob = nil
	end
end

function BossView:destroy()
	table.clear(self.list)
	for _, spot in self.spots do
		spot.live = false
	end
	table.clear(self.spots)
	if BossView.box then
		BossView.box.Visible = false
	end
	BossView.shownHp, BossView.shownPat = nil, nil
end

return BossView

end
MODULES['Client/lune/canvas'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
--!native
--!optimize 2
-- 점 그림판 — 공방 시험 탭의 이펙트(dino-workshop/js/lune/fx.js · kits/*.js)는 캔버스에 점을 하나씩 찍어 그린다.
--  사용자 2026-10-08: "시험탭의 이펙트를 게임으로 옮기세요" — 게임도 같은 식으로 찍는다: 게임 화면 크기(384x216)의 EditableImage 두 장(캐릭터 뒤 · 앞)에
--  장마다 지우고 다시 찍는다. 그리는 쪽(client/lune/fx.luau · shared/lune/kits)은 시험 탭의 코드를 줄마다 옮긴 것이라, 캔버스의 2D 문맥에서 쓰던 것만 흉내 낸다:
--    ctx.fillStyle = c      → ctx:style(c)   (c = 0xRRGGBB)
--    ctx.globalAlpha = a    → ctx:alpha(a)   (0~1)
--    ctx.fillRect(x, y, w, h) → ctx:rect(x, y, w, h)   (게임 세계의 좌표 — 카메라만큼 밀어 찍는다. 화면 밖은 잘린다)
--  그림판은 맵 틀(world) 안에 카메라 자리로 놓여 화면에 붙어 있다(화면을 흔들면 같이 흔들린다).
--  EditableImage를 만들지 못하는 기기에서는 아무것도 찍지 않는다(게임은 그대로 돈다 — 이펙트만 안 보인다).
local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local G = require(ReplicatedStorage.shared.lune.config.game)

local W, H = G.VIEW_W, G.VIEW_H
local SIZE = Vector2.new(W, H)

local Ctx = {}
Ctx.__index = Ctx

local function newCtx(name: string)
	local self = setmetatable({}, Ctx)
	self.buf = buffer.create(W * H * 4)
	self.ox, self.oy = 0, 0 -- 카메라(게임 세계의 좌표에서 뺀다)
	self.r, self.g, self.b, self.a = 255, 255, 255, 255
	self.packed = 0xffffffff
	self.used = false -- 이번 장에 찍은 것이 있다
	self.shown = false -- 화면에 지난 장의 그림이 남아 있다
	local label = Instance.new("ImageLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.ResampleMode = Enum.ResamplerMode.Pixelated
	label.ScaleType = Enum.ScaleType.Stretch
	label.Size = UDim2.fromOffset(W, H)
	label.Active = false
	self.label = label
	local ok, image = pcall(function()
		return AssetService:CreateEditableImage({ Size = SIZE })
	end)
	if ok and image then
		self.image = image
		label.ImageContent = Content.fromObject(image)
	else
		warn("[lune] 점 그림판을 만들지 못했다 — 이펙트를 그리지 않는다: " .. tostring(image))
	end
	return self
end

function Ctx:style(c: number)
	local r, g, b = bit32.band(bit32.rshift(c, 16), 255), bit32.band(bit32.rshift(c, 8), 255), bit32.band(c, 255)
	self.r, self.g, self.b = r, g, b
	self.packed = r + g * 256 + b * 65536 + 255 * 16777216
end

function Ctx:alpha(a: number)
	self.a = math.clamp(math.floor(a * 255 + 0.5), 0, 255)
end

-- 네모를 채운다. 좌표와 크기는 가장 가까운 점으로 맞춘다
function Ctx:rect(x: number, y: number, w: number, h: number)
	local x0 = math.floor(x + 0.5) - self.ox
	local y0 = math.floor(y + 0.5) - self.oy
	local x1 = x0 + math.floor(w + 0.5)
	local y1 = y0 + math.floor(h + 0.5)
	if x0 < 0 then
		x0 = 0
	end
	if y0 < 0 then
		y0 = 0
	end
	if x1 > W then
		x1 = W
	end
	if y1 > H then
		y1 = H
	end
	local a = self.a
	if x1 <= x0 or y1 <= y0 or a <= 0 then
		return
	end
	self.used = true
	local buf = self.buf
	if a >= 255 then
		local v = self.packed
		for yy = y0, y1 - 1 do
			local i = (yy * W + x0) * 4
			for _ = x0, x1 - 1 do
				buffer.writeu32(buf, i, v)
				i += 4
			end
		end
		return
	end
	-- 비치는 점: 먼저 찍힌 점 위에 얹는다
	local r, g, b = self.r, self.g, self.b
	local inv = 255 - a
	for yy = y0, y1 - 1 do
		local i = (yy * W + x0) * 4
		for _ = x0, x1 - 1 do
			local da = buffer.readu8(buf, i + 3)
			if da == 0 then
				buffer.writeu8(buf, i, r)
				buffer.writeu8(buf, i + 1, g)
				buffer.writeu8(buf, i + 2, b)
				buffer.writeu8(buf, i + 3, a)
			else
				local rest = da * inv / 255
				local oa = a + rest
				buffer.writeu8(buf, i, math.floor((r * a + buffer.readu8(buf, i) * rest) / oa + 0.5))
				buffer.writeu8(buf, i + 1, math.floor((g * a + buffer.readu8(buf, i + 1) * rest) / oa + 0.5))
				buffer.writeu8(buf, i + 2, math.floor((b * a + buffer.readu8(buf, i + 2) * rest) / oa + 0.5))
				buffer.writeu8(buf, i + 3, math.floor(oa + 0.5))
			end
			i += 4
		end
	end
end

-- 그림(점 자료 { w, h, buf })의 한 조각을 찍는다 — 캔버스의 translate · scale · drawImage 대신.
--  자르는 네모 (sx, sy, w, h) · (x, y) = 기준점(게임 세계의 좌표) · (lx, ly) = 기준점에서 조각의 왼쪽 위까지 · flip = 기준점에서 좌우로 뒤집는다 · sc = 배(1 · 2) · mul = 불투명도의 배수
function Ctx:blit(src, sx: number, sy: number, w: number, h: number, x: number, y: number, lx: number, ly: number, flip: boolean?, sc: number?, mul: number?)
	local keepA, keepR, keepG, keepB, keepP = self.a, self.r, self.g, self.b, self.packed
	local base = keepA * (mul or 1)
	if base <= 0 then
		return
	end
	local s = sc or 1
	local data, sw = src.buf, src.w
	for j = 0, h - 1 do
		for i = 0, w - 1 do
			local at = ((sy + j) * sw + sx + i) * 4
			local sa = buffer.readu8(data, at + 3)
			if sa > 0 then
				local r, g, b = buffer.readu8(data, at), buffer.readu8(data, at + 1), buffer.readu8(data, at + 2)
				self.r, self.g, self.b = r, g, b
				self.packed = r + g * 256 + b * 65536 + 255 * 16777216
				self.a = math.floor(sa * base / 255 + 0.5)
				local px = lx + i
				self:rect(x + (if flip then -(px + 1) else px) * s, y + (ly + j) * s, s, s)
			end
		end
	end
	self.a, self.r, self.g, self.b, self.packed = keepA, keepR, keepG, keepB, keepP
end

-- 한 장을 시작한다: 지난 장을 지우고 카메라를 받는다
function Ctx:begin(camX: number, camY: number)
	if self.used then
		buffer.fill(self.buf, 0, 0)
		self.used = false
	end
	self.ox, self.oy = camX, camY
	self.r, self.g, self.b, self.a, self.packed = 255, 255, 255, 255, 0xffffffff
	self.label.Position = UDim2.fromOffset(camX, camY)
end

-- 찍은 것을 화면에 올린다(찍은 것도 남은 것도 없으면 아무것도 하지 않는다)
function Ctx:present()
	if self.image and (self.used or self.shown) then
		self.image:WritePixelsBuffer(Vector2.zero, SIZE, self.buf)
	end
	self.shown = self.used
end

local Canvas = {}
Canvas.W, Canvas.H = W, H

local back: any, front: any = nil, nil

-- 맵 틀에 붙인다(장면이 바뀔 때마다 — 그림판은 한 번만 만들어 다시 쓴다). 캐릭터 뒤의 것 · 앞의 것
function Canvas.attach(world: Instance, zBack: number, zFront: number)
	if not back then
		back, front = newCtx("FxBack"), newCtx("FxFront")
	end
	back.label.ZIndex, front.label.ZIndex = zBack, zFront
	back.label.Parent, front.label.Parent = world, world
	return back, front
end

-- 장면을 치울 때: 그림판을 떼어 둔다(없애지 않는다)
function Canvas.detach()
	if back then
		back.label.Parent, front.label.Parent = nil, nil
	end
end

return Canvas

end
MODULES['Client/lune/cashShop'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 달빛 상점의 공간(2026-10-21 사용자: "달빛상점은 메뉴탭 안에 숨어있는게 아니라, 장비 , 능력치처럼 빠른버튼으로 앞에 나와야하고 ui 처럼 열리는 방식이아니라
--  메이플스토리 캐시샵처럼 아예 무적공간으로 들어가버리는 형태여야합니다. 로벅스 관련 쇼핑을 여유롭게 할수있는거죠 캐시샵은 마을에서만 갈수있구요" ·
--  "캐시샵 들어가고 나서 로딩중 잠시 넣고 그동안 다 로드해서 대기하는시간이 거의 없도록하세요").
--  아래 단추 줄의 「상점」 · ` 키 → (마을에서만) 화면 가득 「…가는 중」 → 그동안 서버에 들어간다고 알리고(server world.luau의 Cash "enter" — 맵에서 빠진다: 안 보이고 맞지 않는다)
--   공간을 막 뒤에서 다 짓고 그 안의 그림을 모두 불러 둔다(Curtain.load) → 달밤 배경 · 위쪽에 제목과 「나가기」 · 왼쪽에 미리보기(내 캐릭터 + 펫 · 탈것 — 상점의 펫 · 탈것 줄을 누르면 그것)
--   · 오른쪽에 상점 판(ui/cashWindow.luau를 그대로). 「나가기」 · ` · Esc → 막 → 서버가 들어간 자리로 다시 보낸다(Revive — boot의 goScene이 맵을 다시 그린다).
--  배치 · 글 = 공방 design/bm.js의 BM_SHOP.space(제가 정한 것) · 공방 시험 탭 ?lunedemo=cashshop
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local BM = require(lune.data["bm.generated"])
local ASSETS = require(lune.data["assets.generated"])
local RIDE = require(lune.data["ride.generated"])
local Layout = require(lune.ui.layout)
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)
local CashWindow = require(script.Parent.ui.cashWindow)
local Sprite = require(script.Parent.sprite)
local RideView = require(script.Parent.rideView)
local Curtain = require(script.Parent.curtain)

local SP = BM.shop.space
local W = SP.words
local C = Ui.COLOR
local S = Layout.CASH

local CashShop = {}
CashShop.SPACE = SP
local root: Frame? = nil
local parts: any = nil -- 지은 것들(미리보기 · 상점 판의 view · 고른 펫 · 탈것)
local busy = false

function CashShop.isOpen(): boolean
	return root ~= nil
end

-- 공간의 치수(화면 틀의 점): 위 줄 · 미리보기와 상점 판을 가운데에 나란히
function CashShop.layout(uiW: number, uiH: number)
	local _, panelH0 = CashWindow.size(nil)
	local panelW, panelH = S.w + SP.panelPad * 2, panelH0 + SP.panelPad * 2
	local total = SP.previewW + SP.gap + panelW
	local x0 = math.floor((uiW - total) / 2)
	local y0 = SP.topH + math.max(0, math.floor((uiH - SP.topH - panelH) / 2))
	return { panelW = panelW, panelH = panelH, x0 = x0, y0 = y0, previewX = x0, panelX = x0 + SP.previewW + SP.gap, leaveX = uiW - SP.pad - SP.leaveW }
end

-- 미리보기에 보일 펫 · 탈것: id = 상품의 이름표(pet_ · mount_) · nil = 지금 꺼내 둔 것 · 탄 것
local function setPreview(id: string?)
	if not parts then
		return
	end
	local p = parts
	if id and string.sub(id, 1, 4) == "pet_" then
		p.petId = id
	elseif id and string.sub(id, 1, 6) == "mount_" then
		p.rideId = id
	end
	if p.pet and p.pet.who ~= p.petId then
		p.pet.sprite:destroy()
		p.pet = nil
	end
	if p.petId and not p.pet then
		p.pet = { who = p.petId, sprite = Sprite.new(p.world, p.petId, 2) }
	end
	p.ride:setRide(p.rideId)
	local name = nil
	if id then
		for _, q in BM.products do
			if q.id == id then
				name = q.name
			end
		end
	end
	p.name:set(name or "")
end
CashShop.preview = setPreview

-- 한 장 그린다(boot의 그리기 — 상점이 열려 있는 동안 장마다)
function CashShop.step(now: number, dt: number)
	if not parts then
		return
	end
	local p = parts
	local cx, floor = p.cx + 8, p.floor -- 영웅 · 탈것은 가운데에서 8점 오른쪽(펫이 왼쪽에 설 자리 — 공방 탭과 같다)
	-- 탈것이면 영웅을 앉는 자리에 · 펫은 영웅의 뒤(왼쪽 30점)에
	local hx, hy = p.ride:update(now, dt, cx, floor, 1, false, false, false, nil, nil)
	local char = p.hero.char
	p.hero:set("idle", Sprite.frameAt(char, "idle", now, false), hx or cx, hy or floor, 1)
	if p.pet then
		local pc = p.pet.sprite.char
		p.pet.sprite:set("idle", Sprite.frameAt(pc, "idle", now, false), cx - 30, floor, 1)
	end
end

-- 「…가는 중」(공간이 다 지어지고 그림이 다 불러와질 때까지 — 막 위의 글)
local function sayLoading(text: string?)
	if not root then
		return
	end
	local p = parts
	p.loading:set(text or "")
	p.loading:show(text ~= nil)
	p.content.Visible = text == nil
end

-- 공간을 짓는다(보이지 않게 — 그림을 불러온 뒤 sayLoading(nil)로 연다). ctx = boot의 창 ctx(cash · cashDo · bag · me) + who(영웅의 그림 이름) · myPet · myRide · onLeave
local function build(ctx)
	local uiW, uiH = Stage.uiW, Stage.uiH
	local L = CashShop.layout(uiW, uiH)
	local r = Stage.group(Stage.ui, "CashShop", 500) -- HUD(100) · 창(150) · 막이 아닌 모든 것 위
	root = r
	local base = Ui.box(r, 0, 0, uiW, uiH, C.ink) -- 그림이 오기 전에도 게임 화면이 비치지 않게
	base.Active = true -- 아래의 단추(HUD · 손가락 단추)로 누름이 새지 않게
	local bg = Instance.new("ImageLabel")
	bg.Name = "Back"
	bg.BackgroundTransparency = 1
	bg.BorderSizePixel = 0
	bg.Image = ASSETS[SP.bg] or ""
	bg.ScaleType = Enum.ScaleType.Crop -- 화면의 꼴이 16:9가 아니어도 가득(넘치는 가장자리만 잘린다)
	bg.Size = UDim2.fromScale(1, 1)
	bg.ZIndex = 2
	bg.Parent = r
	local veil = Ui.box(r, 0, 0, uiW, uiH, C.ink, SP.veil)
	veil.ZIndex = 3
	local content = Ui.group(r, 0, 0, uiW, uiH, "Content")
	content.ZIndex = 4
	local loading = Ui.text(r, "", 0, math.floor(uiH / 2) - 8, uiW, { align = "center", font = "body", color = C.accent, outline = true, z = 5 })
	-- 위 줄: 제목 · 「나가기」
	Ui.text(content, W.title, SP.pad, 10, 200, { font = "body", color = C.accent, outline = true })
	Ui.button(content, W.leave, L.leaveX, 5, SP.leaveW, function()
		CashShop.leave(ctx)
	end).frame.Name = "Leave"
	-- 미리보기: 판 · 제목 · 바닥 · 내 캐릭터(게임과 같은 점 크기 — 판 안에 게임 세계의 배율을 건다) · 고른 것의 이름 · 안내
	local pv = Ui.panel(content, L.previewX, L.y0, SP.previewW, L.panelH)
	pv.Name = "Preview"
	Ui.text(pv, W.preview, 10, 8, SP.previewW - 20, { font = "body" })
	local nameText = Ui.text(pv, "", 10, L.panelH - 46, SP.previewW - 20, { align = "center", color = C.gold })
	Ui.text(pv, W.hint, 10, L.panelH - 28, SP.previewW - 20, { align = "center", color = C.dim, lines = 2 })
	local ratio = Stage.ratio
	local world = Instance.new("Frame")
	world.Name = "World"
	world.BackgroundTransparency = 1
	world.BorderSizePixel = 0
	world.Size = UDim2.fromOffset(SP.previewW / ratio, L.panelH / ratio)
	world.ZIndex = 3
	world.ClipsDescendants = true
	world.Parent = pv
	local scale = Instance.new("UIScale")
	scale.Scale = ratio -- 판 안은 게임 도트(화면 틀의 점 x ratio = 화면의 정수 화소)
	scale.Parent = world
	local floorUi = L.panelH - SP.floor
	Ui.box(pv, 16, floorUi, SP.previewW - 32, 2, C.line).ZIndex = 2
	local cx, floor = math.floor(SP.previewW / ratio / 2), math.floor(floorUi / ratio)
	local hero = Sprite.new(world, ctx.who(), 3)
	local ride = RideView.new(world, 3, nil)
	parts = { root = r, content = content, loading = loading, world = world, hero = hero, ride = ride, pet = nil, petId = ctx.myPet(), rideId = ctx.myRide(), name = nameText, cx = cx, floor = floor }
	setPreview(nil)
	-- 상점 판: 상점 창의 것을 그대로(같은 탭 · 줄 · 단추). 펫 · 탈것 줄을 누르면 미리보기에
	local panel = Ui.panel(content, L.panelX, L.y0, L.panelW, L.panelH)
	panel.Name = "Shop"
	local body = Ui.group(panel, SP.panelPad, SP.panelPad, S.w, L.panelH - SP.panelPad * 2, "Body")
	local wctx = setmetatable({
		cashFetch = function() end, -- 들어올 때 받은 것을 쓴다(server의 Cash "enter"가 상점의 지금 것을 같이 준다)
		cashPreview = setPreview,
	}, { __index = ctx })
	parts.view = CashWindow.build(body, wctx, S.w, L.panelH - SP.panelPad * 2, nil)
	return r
end

-- 들어간다. ctx: 창 ctx + who · myPet · myRide(함수) · invoke(일, …) · notice(글) · townOk() · onOpen() · onClose()
function CashShop.enter(ctx)
	if root or busy then
		return
	end
	if not ctx.townOk() then
		ctx.notice(W.townOnly)
		return
	end
	busy = true
	task.spawn(function()
		local t0 = os.clock()
		Curtain.cover()
		local res = ctx.invoke("enter")
		if not (res and res.ok) then
			Curtain.lift()
			busy = false
			ctx.notice((res and res.why) or W.townOnly)
			return
		end
		ctx.setCash(res)
		ctx.onOpen() -- 게임 화면 · HUD를 숨기고 움직이지 않게
		local ok, err = pcall(build, ctx)
		if not ok then
			warn("[lune] 달빛 상점을 짓지 못했다: " .. tostring(err))
		end
		sayLoading(W.loading)
		Curtain.lift(0.12) -- 막을 걷으면 「…가는 중」이 보인다(그 뒤에서 그림을 모두 불러 둔다)
		if root then
			Curtain.load({ root }) -- 배경 · 상품 그림 · 미리보기의 캐릭터 · 펫 · 탈것
		end
		local wait = SP.minLoad - (os.clock() - t0)
		if wait > 0 then
			task.wait(wait)
		end
		sayLoading(nil)
		busy = false
	end)
end

-- 상점의 것이 바뀌었다(받기 · 꺼내기 · 산 것이 들어옴)
function CashShop.refresh(me)
	if parts and parts.view and parts.view.refresh then
		parts.view.refresh(me)
	end
end

-- 나온다: 막 → 공간을 치운다 → 서버가 들어간 자리로 다시 보낸다(Revive → boot의 goScene이 맵을 다시 그리고 막을 걷는다)
function CashShop.leave(ctx)
	if not root or busy then
		return
	end
	busy = true
	task.spawn(function()
		sayLoading(W.back)
		Curtain.cover()
		if parts then
			if parts.pet then
				parts.pet.sprite:destroy()
			end
			parts.hero:destroy()
			parts.ride:destroy()
		end
		if root then
			root:Destroy()
		end
		root, parts = nil, nil
		ctx.onClose()
		ctx.invoke("leave") -- 서버가 Revive를 보낸다 → boot의 goScene이 맵을 다시 그리고 막을 걷는다
		ctx.afterLeave() -- (끝내 Revive가 오지 않으면 막을 걷는다 — 검은 화면에 멈추지 않게)
		busy = false
	end)
end

return CashShop

end
