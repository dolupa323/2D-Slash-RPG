handlers.Pickup(p1, drop.id)
eq(#got("DropGone", p1), 1, "주우면 방 사람들에게 알린다")
eq(s1.hero.money, money0 + drop.amount, "달돈이 는다")
expect(#got("Self", p1) >= 1, "내 상태가 다시 온다")

