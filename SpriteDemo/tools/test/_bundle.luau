		openRename = function()
			Windows.open("cash", "rename", true) -- 가방에서 이름 바꾸기 주문서를 썼다 → 이름을 적는 칸
		end,
		-- 일일 의뢰: 서버가 준 상태 · 받기와 내기(서버가 정한다 — 게시판 앞이어야 한다)
		daily = function()
			return state.daily
