local Quests = require(script.Parent.Parent.sim.quests)
local COMBAT = require(script.Parent.Parent.data["combat.generated"])

local Guide = {}
Guide.W, Guide.LINES = 420, 2 -- 안내 글의 칸(화면 틀의 고운 격자의 점 · 작은 글씨)
Guide.UNTIL = 5 -- 이 레벨이 지나면 조작 안내는 뜨지 않는다(퀘스트의 길잡이는 알리미가 한다)

-- 지금 띄울 안내를 고른다. s = 지금의 상태:
--  { level, quests(book), scene(장면 이름표), touch(스마트폰 단추인가), nearNpc(가까이 선 주민의 id), drop(주울 것이 발밑에 있는가), hpShare(체력 0~1), potions(가방의 물약 수),
--    ap · sp(안 찍은 점수), key = function(하는 일) → 키 이름, slotOf = function(갈래 "mob" · "boss" · "move" · "potion") → 그것이 놓인 칸의 키 이름과 이름(없으면 nil) }
--  돌려주는 것: 안내 글(없으면 nil). 화면을 모르는 셈이라 자동 검사가 그대로 부른다
-- 튜토리얼이 따라가는 두 퀘스트: 첫 퀘스트(「첫 기술」)와 줄에서 그 바로 다음 것(첫 사냥) — 자료에서 읽는다(줄의 차례가 바뀌어도 따라간다)
local FIRST = Quests.FIRST.quest
local SECOND = nil
for _, def in Quests.list do
	if def.after == FIRST and def.playable then
		SECOND = def
	end
end
local PREY = "몬스터" -- 첫 사냥에서 잡는 몬스터의 이름
do
	local step = SECOND and SECOND.steps[1]
	local mob = step and step.mob and COMBAT.mobs[step.mob]
	if mob then
		PREY = mob.name
	end
end

function Guide.pick(s): string?
	if s.level > Guide.UNTIL then
		return nil
	end
	local book = s.quests or {}
	local key = s.key
	local first, second = book[FIRST], if SECOND then book[SECOND.id] else nil
	-- 튜토리얼(첫 기술 → 첫 사냥)이 끝났으면 더 가르치지 않는다
	if second and second.done then
		return nil
	end
	-- ① 첫 퀘스트 「첫 기술」: 사제에게 걸어가서 말을 걸어 받고, 한 번 더 말을 걸어 끝낸다(새 캐릭터 — Lv.1). 받기 전(first == nil)에도 뜬다 — 퀘스트는 저절로 받지 않는다
	if not (first and first.done) and s.level <= 1 then
		if s.scene ~= "in_shrine" then
			return "달의 사당의 그믐 사제에게 간다"
		elseif s.nearNpc == "master" then
			local what = if first then "한 번 더 말을 걸어 「첫 기술」을 끝낸다" else "그믐 사제에게 말을 걸어 「첫 기술」을 받는다"
			return if s.touch then ("「말 걸기」 단추: %s"):format(what) else ("%s 키: %s"):format(key("up"), what)
		end
		return if s.touch then "왼쪽 아래의 조이스틱으로 걷는다 — 그믐 사제에게 간다" else ("%s %s 키로 걷는다 — 그믐 사제에게 간다"):format(key("left"), key("right"))
	end
	-- ② 주울 것이 발밑에 있다
	if s.drop then
		return if s.touch then "「줍기」 단추: 떨어진 것을 줍는다" else ("%s 키: 떨어진 것을 줍는다"):format(key("pickup"))
	end
	-- ③ 체력이 절반 아래다
	if s.hpShare < 0.5 and s.potions > 0 then
		local potionKey = s.slotOf("potion")
		if potionKey then
			return if s.touch then "물약 단추: 체력을 되찾는다" else ("%s 키: 물약을 마신다"):format(potionKey)
		end
	end
	-- ④ 처음 받은 점수를 찍는다(능력치 → 스킬) — 길 안내보다 먼저: 찍지 않으면 사냥이 느리다. 처음 점수를 받은 Lv.2에서만(그 뒤의 레벨업마다 되풀이하지 않는다)
	if s.level == 2 then
		if s.ap > 0 then
			return if s.touch then "「메뉴」 → 능력치: 받은 점수를 찍는다(「자동으로 찍기」)" else ("%s 키: 능력치 창 — 받은 점수를 찍는다(「자동으로 찍기」)"):format(key("win:stat"))
		elseif s.sp > 0 then
			return if s.touch then "「메뉴」 → 스킬: 스킬 포인트로 스킬을 올린다(「추천대로 찍기」)" else ("%s 키: 스킬 창 — 스킬 포인트로 스킬을 올린다(「추천대로 찍기」)"):format(key("win:skill"))
		end
	end
	-- ⑤ 첫 사냥(줄에서 첫 퀘스트 바로 다음 것 — 지금은 「등불 심지」): 받기 전에는 샛별에게, 받은 뒤에는 문 밖으로, 사냥터에서는 기술의 키
	if first and first.done and not (second and second.done) then
		if not second then
			if s.scene == "in_shrine" then
				return if s.touch then "문 앞에서 「들어가기」 단추: 사당 밖으로 나간다" else ("문 앞에서 %s 키: 사당 밖으로 나간다"):format(key("up"))
			elseif s.scene == "town" then
				return if s.touch
					then "「점프」로 뛴다 · 조이스틱 아래 + 「점프」로 내려간다 — 샛별은 맨 아래 길의 왼쪽"
					else ("%s 키로 뛴다 · %s + %s 키로 내려간다 — 샛별은 맨 아래 길의 왼쪽"):format(key("jump"), key("down"), key("jump"))
			end
		elseif SECOND and not Quests.isReady(book, SECOND.id) then
			if s.scene == SECOND.scene then
				local mobKey, mobName = s.slotOf("mob")
				local moveKey, moveName = s.slotOf("move")
				if s.touch then
					return ("오른쪽 아래의 기술 단추로 %s을 쓰러뜨린다"):format(PREY)
				elseif mobKey and moveKey then
					return ("%s을 쓰러뜨린다 — %s 키: %s · %s 키: %s"):format(PREY, mobKey, mobName, moveKey, moveName)
				end
			elseif s.scene == "town" then
				return if s.touch then "마을 왼쪽 끝의 문 앞에서 「들어가기」 단추: 마을 어귀로 나간다" else ("마을 왼쪽 끝의 문 앞에서 %s 키: 마을 어귀로 나간다"):format(key("up"))
			end
		end
	end
	return nil
end

return Guide

end
MODULES['ReplicatedStorage/shared/lune/ui/hpFx'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 체력 바의 효과 — 화면을 모르는 셈(그리는 것은 client/lune/hud.luau · 공방 시험 탭의 js/lune/ui/hpfx.js와 같은 셈이다).
--  사용자 2026-10-13: "플레이어 체력표기 gui 체력 다는거나  회복되는게 잘 보이지않습니다. 효과가 좀 들어가야해요"
--  닳을 때: 빨간 띠는 바로 줄고, 닳은 만큼이 밝은 색으로 잠깐 남았다가(hold) 따라 줄어든다(drain) · 띠가 희게 번쩍인다 · 「-23」이 떠오른다
--  찰 때: 찬 만큼이 풀빛으로 먼저 보이고 빨간 띠가 그 자리까지 차오른다(fill) · 풀빛으로 번쩍인다 · 「+60」이 떠오른다
--  수는 공방의 UILAYOUT.vitals.fx(data/ui.generated.luau).
--  상태: fill = 빨간 띠(0~1 — 처음에는 nil) · lag = 닳은 자리의 끝 · gain = 찬 자리의 끝 · hold · flash(남은 초) · kind("hurt" | "heal") · delta(더한 수) · deltaT(남은 초) · to(지금의 체력 0~1) · hp
local F = require(script.Parent.Parent.data["ui.generated"]).layout.vitals.fx

local HpFx = {}
HpFx.F = F

function HpFx.new()
	return { fill = nil :: number?, lag = 0, gain = 0, hold = 0, flash = 0, kind = nil :: string?, delta = 0, deltaT = 0, hp = 0, to = 0 }
end

-- 새 체력(ratio 0~1 · hp = 숫자): 처음이면 그대로 놓고, 닳았으면 · 찼으면 효과를 건다
function HpFx.set(st, ratio: number, hp: number)
	if st.fill == nil then
		st.fill, st.lag, st.gain, st.to, st.hp = ratio, ratio, ratio, ratio, hp
		return
	end
	local d = hp - st.hp
	if d == 0 and ratio == st.to then
		return
	end
	if ratio < st.to then
		st.lag = math.max(st.lag, st.fill)
		st.fill = math.min(st.fill, ratio)
		st.gain = math.min(st.gain, ratio)
		st.hold, st.flash, st.kind = F.hold, F.flash, "hurt"
	elseif ratio > st.to then
		st.gain = ratio
		st.flash, st.kind = F.flash, "heal"
	end
	if d ~= 0 then
		-- 잇달아 닳으면(merge초 안) 숫자를 더한다
		st.delta = if st.deltaT > F.delta - F.merge and math.sign(st.delta) == math.sign(d) then st.delta + d else d
		st.deltaT = F.delta
	end
	st.to, st.hp = ratio, hp
end

function HpFx.step(st, dt: number)
	if st.fill == nil then
		return
	end
	st.flash = math.max(0, st.flash - dt)
	st.deltaT = math.max(0, st.deltaT - dt)
	if st.fill < st.to then
		st.fill = math.min(st.to, st.fill + F.fill * dt) -- 차오른다
	end
	-- 닳은 자리: 잠깐(hold) 남아 있다가 따라 줄어든다 — 한 장 안에서 hold가 끝나면 남은 시간만큼은 줄인다
	local left = dt
	if st.hold > 0 then
		local used = math.min(st.hold, left)
		st.hold -= used
		left -= used
	end
	if st.hold <= 0 and st.lag > st.fill then
		st.lag = math.max(st.fill, st.lag - F.drain * left)
	end
	if st.lag < st.fill then
		st.lag = st.fill
	end
end

-- 효과가 다 끝났는가(그릴 것이 없다)
function HpFx.idle(st): boolean
	return st.fill == nil or (st.flash <= 0 and st.deltaT <= 0 and st.fill == st.to and st.lag <= st.fill)
end

-- 떠오르는 글: 「-23」 · 「+60」(없으면 nil), 그리고 얼마나 떠올랐는가(도트)
function HpFx.deltaText(st): (string?, number)
	if st.deltaT <= 0 or st.delta == 0 then
		return nil, 0
	end
	return (if st.delta > 0 then "+" else "") .. tostring(st.delta), math.floor(F.deltaUp * (1 - st.deltaT / F.delta) + 0.5)
end

return HpFx

end
MODULES['ReplicatedStorage/shared/lune/ui/itemInfo'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 아이템의 상세 — 가방 · 장비 창에서 고른 아이템을 창 옆의 작은 판에 적는 것(그리지는 않는다: client/lune/ui/itemDetail.luau가 그린다).
--  사용자 2026-10-08: "장비 탭에서 각각의 장비를 선택하면 그 해당장비가 장비창 옆에 작은모달이 떠서 아이템 스펙이 나와야합니다. 인벤토리에서 선택도 마찬가지입니다. 기타아이템, 소비아이템 모두 마찬가지입니다."
--  글과 차례는 공방 js/lune/design/items.js의 gearInfo · goodsInfo와 같다(낱말은 data/items.generated.luau의 WORDS) — tools/test/tests/15_lune_items.luau가 공방의 본보기(checks.info)와 맞춰 본다.
--  돌려주는 것 { name, tone(이름의 색), sub(이름 아래의 갈래), rows = { { 이름, 값, 색 } … }, notes = { { 글, 색 } … }, stars · starMax(장비 — 이름 위에 그리는 별) }
--  2026-10-15 스펙을 다시 짜며: 이름에 「+n」을 붙이지 않는다(별은 이름 위에 별 그림으로 — 1성에 별 하나) · 「강화 +n / 상한」 · 「전투력 +n」 줄 대신 옵션 줄
--   (무기 「공격력 +73 (65 +8)」 · 방어구 「올스탯」 · 「방어력」 — 괄호 안 = 기본 + 별이 붙인 몫) · 「장착하면 전투력 ±n」은 내 스펙(me.spec — 서버의 Hero.specView)으로 셈한다
--   색 = "text" · "dim" · "accent" · "red" · "gold" · "tier0"~"tier4"(성능 단: 낡은 … 빼어난)
local Items = require(script.Parent.Parent.sim.items)
local N = require(script.Parent.Parent.config.numbers)
local CLASSES = require(script.Parent.Parent.data["classes.generated"])
local Format = require(script.Parent.format)

local D = Items.data
local W = D.WORDS
local SPEC = N.data.SPEC
local STATS = N.data.STATS

local I = {}

-- 스펙이 오지 않았을 때(본보기 · 시험)의 스펙: 그 레벨의 점수를 다 주스탯에 · 그 장비들만 · 패시브 없이(공방 items.js의 specOf와 같은 셈)
function I.specOf(level: number, list)
	local all, atk = 0, 0
	for _, it in list do
		local o = Items.options(it).total
		all += o.stat or 0
		atk += o.atk or 0
	end
	return { main = STATS.base + STATS.perLevel * (level - 1) + all, sub = STATS.base + all, atk = atk, k = 1 + SPEC.crit.chance / 100 * (SPEC.crit.mul - 1) }
end

-- 그 레벨의 본보기 캐릭터의 스펙(같은 레벨 보통 무기 + 방어구 넷 · 찍은 점수는 다 주스탯 · 패시브 없이 — 공방 items.js의 refSpec) — 내 스펙을 모를 때 쓴다
function I.refSpec(level: number)
	local all = 4 * N.armorStat(level)
	return { main = STATS.base + STATS.perLevel * (level - 1) + all, sub = STATS.base + all, atk = N.weaponAtk(level), k = 1 + SPEC.crit.chance / 100 * (SPEC.crit.mul - 1) }
end

-- 지금 장착한 것(worn — 없으면 nil)을 it로 바꾸면 달라지는 전투력. sp = 내 스펙 { main, sub, atk, k }
function I.wearDiff(it, worn, sp): number
	local a = Items.options(it).total
	local b = if worn then Items.options(worn).total else {}
	local ds, da = (a.stat or 0) - (b.stat or 0), (a.atk or 0) - (b.atk or 0)
	local raw = (N.statAtk(sp.main + ds, sp.sub + ds, sp.atk + da) - N.statAtk(sp.main, sp.sub, sp.atk)) * sp.k
	return math.sign(raw) * math.floor(math.abs(raw) + 0.5)
end

-- 옵션 한 줄의 값: 「+68」 · 별이 붙었으면 「+68 (65 +3)」
function I.optText(base: number, total: number): string
	if total > base then
		return ("+%s (%s +%s)"):format(Format.short(total), Format.short(base), Format.short(total - base))
	end
	return "+" .. Format.short(total)
end

-- 장비의 상세. me = { level, class, spec(내 스펙 — 없으면 그 레벨 · 장착한 것으로 셈한다) } · worn = 같은 부위에 장착한 것(없으면 nil) · isWorn = 이 장비가 바로 장착한 그것인가(장비 창에서 골랐다)
function I.gear(it, me, worn: any, isWorn: boolean?)
	local slot, q, need = Items.slot(it.slot), D.QUALITY[it.q], Items.needLevel(it)
	local tier = "tier" .. (it.q - 1)
	local o = Items.options(it)
	local rows = { { W.need, "Lv." .. need, if me.level >= need then "text" else "red" } }
	if it.slot == "weapon" then
		table.insert(rows, { W.job, CLASSES.classes[it.who].name, if it.who == me.class then "text" else "red" })
	end
	table.insert(rows, { W.quality, if q.bonus == 0 then q.name else ("%s %s%d%%"):format(q.name, if q.bonus > 0 then "+" else "", q.bonus), tier })
	for _, k in { "atk", "stat", "def" } do
		if o.base[k] ~= nil then
			table.insert(rows, { W[k], I.optText(o.base[k], o.total[k]), if k == "def" then "text" else "gold" })
		end
	end
	local notes = {}
	if it.broken then
		table.insert(notes, { W.brokenNote, "red" })
	elseif isWorn then
		table.insert(notes, { W.worn, "accent" })
	elseif it.slot == "weapon" and it.who ~= me.class then
		table.insert(notes, { W.otherJob, "red" })
	elseif me.level < need then
		table.insert(notes, { Format.fill(W.needLv, { n = need }), "red" })
	else
		local d = I.wearDiff(it, worn, me.spec or I.refSpec(me.level))
		if d > 0 then
			table.insert(notes, { Format.fill(W.wearUp, { n = Format.short(d) }), "accent" })
		elseif d < 0 then
			table.insert(notes, { Format.fill(W.wearDown, { n = Format.short(-d) }), "red" })
		else
			table.insert(notes, { W.wearSame, "dim" })
		end
	end
	if not isWorn then
		table.insert(notes, { Format.fill(W.dust, { n = Format.short(Items.dismantle(it)) }), "dim" })
		table.insert(notes, { Format.fill(W.sell, { n = Format.short(Items.sellPrice(it)) }), "dim" })
	end
	local name = Items.name(it)
	if it.broken then
		name = name .. " " .. W.broken
	end
	return {
		name = name,
		tone = if it.broken then "red" else tier,
		sub = if it.slot == "weapon" then slot.kind else slot.kind .. " · " .. slot.name,
		rows = rows,
		notes = notes,
		stars = it.star,
		starMax = D.ENHANCE.max,
	}
end

-- 소비 · 기타 아이템의 상세. id = 이름표 · n = 가방에 든 수(모든 칸의 합)
function I.goods(id: string, me, n: number)
	local g = Items.goods(id)
	local rows = { { W.have, Format.fill(W.count, { n = n }), "text" } }
	if g.kind == "potion" then
		table.insert(rows, { W.effect, Format.fill(W.heal, { n = g.heal }), "accent" })
		table.insert(rows, { W.useLv, "Lv." .. g.lv, if me.level >= g.lv then "text" else "red" })
		table.insert(rows, { W.wait, Format.fill(W.sec, { n = N.data.BODY.cooldown.field }), "text" })
	end
	table.insert(rows, { W.stack, Format.fill(W.upTo, { n = g.stack }), "dim" })
	local notes = { { g.text, "text" } }
	if g.kind == "potion" and me.level < g.lv then
		table.insert(notes, { Format.fill(W.useNeed, { n = g.lv }), "red" })
	end
	if g.from then
		table.insert(notes, { Format.fill(W.from, { mob = g.from }), "dim" })
	end
	if g.quest then
		table.insert(notes, { Format.fill(W.quest, { quest = g.quest, n = g.need }), "dim" })
	end
	if g.sell > 0 then
		table.insert(notes, { Format.fill(W.sellEach, { n = Format.short(g.sell) }), "dim" })
	end
	return {
		name = g.name,
		tone = "text",
		sub = if g.kind == "quest" then W.tab[g.tab] .. " · " .. W.questItem else W.tab[g.tab],
		rows = rows,
		notes = notes,
	}
end

return I

end
