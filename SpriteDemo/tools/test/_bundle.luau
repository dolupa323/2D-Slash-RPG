ShopWindow.stockOf = stockOf

-- 상점의 그 물건의 그림 이름(가방에 들어왔을 때의 그 그림): 물약 · 주문서 = 그 아이템의 것 · 장비 = 부위와 재질(무기는 내 직업의 것) · 달가루
function ShopWindow.stockIcon(stock, class: string): string
	if stock.goods then
		local g = Items.goods(stock.goods)
		return if g then g.icon else ""
	elseif stock.item then
		return ItemCell.icon(Items.make(stock.item.slot, stock.item.stage, D.NORMAL, class))
	end
	return "dust"
end

-- 창고: 탭 셋 · 칸 · 끌어서 맡기기와 찾기
local function buildStore(body: Frame, ctx, w: number)
	local view = {}
	local ui = ctx.ui
	local S = ItemCell.size()
	local base = D.BAG.storeBase -- 창의 높이는 처음 칸 수(네 줄)로 — 늘린 창고는 그 안에서 위아래로 민다
	local rowsN = math.ceil(base / COLS)
	local function sizeNow(): number
		local bag = ctx.bag()
		return if bag and bag.storeSize then bag.storeSize else base
	end
	local tab = 1
	local sel = nil :: { tab: string, slot: number, id: any }? -- 고른 칸(id = 장비의 번호 · 묶음의 이름표)
	local ask: number? = nil -- 찾을 수를 고르는 중이면 그 수
	local hot: number? = nil -- 끌던 것을 놓을 칸
	local lastClick = { slot = 0, t = 0 }
	local dragEnd = 0
	local panel = body.Parent :: GuiObject

	local function key(): string
		return KEYS[tab]
	end
	local function unselect()
		sel, ask = nil, nil
	end
	local function redraw()
		Windows.refresh(ctx.me())
	end
	-- 찾는다: 창고의 그 칸의 것을 가방으로(n = 묶음에서 찾을 수 — 안 주면 전부 · to = 놓을 가방 칸). 가방은 그 탭을 보여 준다(찾은 것이 보이게)
	local function take(tabKey: string, slot: number, n: number?, to: number?)
		ctx.send("Item", "storeOut", tabKey, slot, n, to)
		if ui.bagShow then
			ui.bagShow(tabKey)
		end
	end

	local tabs = {}
	local tx = 0
	for i, name in D.BAG.tabs do
		tabs[i] = Ui.tab(body, name, tx, 0, function()
			if tab ~= i then
				tab = i
				unselect()
				redraw()
			end
		end)
		tx += tabs[i].width + 16
	end
	local count = Ui.text(body, "", w - Layout.BAG.countW, 0, Layout.BAG.countW, { align = "right", color = C.dim }) -- 찬 칸 / 창고의 칸

	local gridRoot = Ui.scroll(body, 0, STORE.gridY, COLS * S, rowsN * S, rowsN * S, BAR) -- 칸들(늘린 창고는 위아래로 스크롤)
	gridRoot.Name = "Grid"
	local cells = {}
	local function slotAt(at: Vector2): number?
		if not ItemCell.over(gridRoot, at) then
			return nil -- 스크롤로 가려진 칸은 아니다
		end
		local i = ItemCell.at(cells, at)
		return if i and i <= sizeNow() then i else nil
	end
	-- 칸 하나를 짓는다(2026-10-18 검토: 창고 칸을 늘려도(Bag.growStore) 처음 24칸만 지어 25칸부터 보이지도 꺼내지도 못했다 — 가방 창처럼 늘어난 만큼 더 짓고 위아래로 민다)
	local function makeCell(i: number)
		local col, row = (i - 1) % COLS, math.floor((i - 1) / COLS)
		local cell
		cell = ItemCell.new(gridRoot, col * S, row * S, function(it)
			local now = os.clock()
			-- 끌어서 놓은 것은 누른 것이 아니다(놓은 자리의 칸에도 "눌렀다"가 온다)
			if ctx.quick.dragging() or now - dragEnd < 0.2 then
				return
			end
			local twice = it ~= nil and lastClick.slot == i and now - lastClick.t < DOUBLE
			lastClick = { slot = if twice then 0 else i, t = now }
			if not it then
				unselect()
			elseif twice then
				take(key(), i, nil, nil) -- 두 번 누르기: 전부 찾는다
				unselect()
			else
				sel = { tab = key(), slot = i, id = if it.item then it.item else it.id }
				ask = nil
				ui.detail = "shop"
			end
			redraw()
		end, S)
		cells[i] = cell
		-- 끌기: 창고의 다른 칸 = 창고 안에서 옮긴다 · 가방 창 = 찾는다(놓은 칸에 — 묶음은 전부)
		cell.hit.InputBegan:Connect(function(input)
			local it = cell.item
			if not it then
				return
			end
			local from, tabKey = i, key()
			local moved = false
			ctx.quick.press(nil, nil, input, {
				icon = ItemCell.icon(it),
				size = S,
				hold = HOLD,
				onStart = function()
					gridRoot.ScrollingEnabled = false -- 끄는 동안은 칸들이 움직이지 않는다(늘린 창고는 스크롤한다)
				end,
				onMove = function(at: Vector2)
					moved = true
					local to = slotAt(at)
					if hot ~= to then
						hot = to
						view.refresh()
					end
					if ui.bagHover then
						ui.bagHover(at, tabKey) -- 가방의 놓을 칸이 밝아진다
					end
				end,
				onDrop = function(at: Vector2): boolean
					local to = slotAt(at)
					if to and to ~= from then
						ctx.send("Item", "storeMove", tabKey, from, to)
						-- 화면은 바로 옮긴다(같은 묶음끼리 합치는 것은 서버의 셈을 기다린다)
						local bag = ctx.bag()
						local list = if bag then bag.store[tabKey] else nil
						local a = if list then list[from] else nil
						local b = if list then list[to] else nil
						local merge = tabKey ~= "gear" and a and b and a.item == b.item
						if list and a and not merge then
							list[from], list[to] = b or false, a
						end
						if sel and sel.tab == tabKey and (sel.slot == from or sel.slot == to) then
							if merge then
								unselect()
							else
								sel.slot = if sel.slot == from then to else from
							end
						end
					end
					if to then
						return true
					end
					if ui.bagDrop then
						local over, slot = ui.bagDrop(at, tabKey)
						if over then
							take(tabKey, from, nil, slot)
							if sel and sel.tab == tabKey and sel.slot == from then
								unselect()
							end
							return true
						end
					end
					return false
				end,
				onEnd = function()
					if moved then
						dragEnd = os.clock()
					end
					if ui.bagHover then
						ui.bagHover(nil, nil)
					end
					if hot then
						hot = nil
						view.refresh()
					end
				end,
			})
		end)
	end
	for i = 1, COLS * rowsN do
		makeCell(i)
	end

	-- 가방에서 끌어 온 것을 놓는 자리(ui/bagWindow.luau가 묻는다): 창고 창 위면 맡긴다 — 그 탭이 열려 있으면 놓은 칸에, 다른 탭이 열려 있었으면 그 탭으로 넘긴다
	ui.storeDrop = function(at: Vector2, tabKey: string, from: number): boolean
		if not ItemCell.over(panel, at) then
			return false
		end
		local to = if tabKey == key() then slotAt(at) else nil
		ctx.send("Item", "storeIn", tabKey, from, nil, to)
		if tabKey ~= key() then
			tab = table.find(KEYS, tabKey) or tab
			unselect()
		end
		return true
	end
	-- 가방의 「맡기기」로 맡겼을 때: 창고가 그 탭을 보여 준다
	ui.storeShow = function(tabKey: string)
		if tabKey ~= key() then
			tab = table.find(KEYS, tabKey) or tab
			unselect()
		end
	end
	ui.storeHover = function(at: Vector2?, tabKey: string?)
		local to = if at and tabKey == key() then slotAt(at) else nil
		if hot ~= to then
			hot = to
			view.refresh()
		end
	end

	-- 칸 아래: 「정렬」과 안내 글
	local fy = STORE.gridY + rowsN * S + STORE.footY
	local sort = Ui.button(body, WORDS.sort, 0, fy, STORE.sortW, function()
		ctx.send("Item", "storeSort", key())
		unselect()
		view.refresh()
	end)
	sort.frame.Name = "Sort"
	Ui.text(body, WORDS.storeHint, STORE.sortW + 10, fy + 8, w - STORE.sortW - 10, { align = "right", color = C.dim })

	-- 고른 것의 상세 판(창 옆): 「찾기」 — 묶음은 몇 개를 찾을지 고른다
	local function detail(bag, me)
		if ui.detail ~= "shop" then
			unselect() -- 다른 창에서 골랐다
		end
		local list = if sel then bag.store[sel.tab] else nil
		local entry = if sel and list then list[sel.slot] else nil
		if sel and sel.tab == "gear" and (not entry or entry.id ~= sel.id) then
			entry = nil
			for i = 1, bag.storeSize do
				local it = list[i]
				if it and it.id == sel.id then
					sel.slot, entry = i, it
					break
				end
			end
		elseif sel and sel.tab ~= "gear" and entry and entry.item ~= sel.id then
			entry = nil
		end
		if not sel or not entry then
			unselect()
			ItemDetail.hide("shop")
			return
		end
		local slot, tabKey = sel.slot, sel.tab
		local spec = { item = entry, buttons = {}, onClose = function()
			unselect()
			redraw()
		end }
		if tabKey == "gear" then
			ask = nil
			spec.info = ItemInfo.gear(entry, me, bag.equip[entry.slot], false)
			table.insert(spec.buttons, { text = WORDS.take, main = true, onClick = function()
				take("gear", slot, nil, nil)
				unselect()
				redraw()
			end })
			spec.key = table.concat({ "store", entry.id, entry.q, entry.star, tostring(entry.broken), me.level }, "|")
		else
			spec.info = ItemInfo.goods(entry.item, me, entry.n) -- 가진 수 = 창고의 그 묶음
			if ask then
				local n = math.clamp(ask, 1, entry.n)
				ask = n
				spec.ask = ItemDetail.ask("take", n, 1, entry.n, {
					set = function(v: number)
						ask = v
						view.refresh()
					end,
					yes = function(countNow: number)
						take(tabKey, slot, countNow, nil)
						ask = nil
						view.refresh()
					end,
					no = function()
						ask = nil
						view.refresh()
					end,
				})
			else
				table.insert(spec.buttons, { text = WORDS.take, main = true, onClick = function()
					if entry.n == 1 then
						take(tabKey, slot, 1, nil)
						unselect()
						redraw()
					else
						ask = entry.n -- 처음에는 그 묶음 전부
						view.refresh()
					end
				end })
			end
			spec.key = table.concat({ "store", tabKey, slot, entry.item, entry.n, me.level, if ask then ask else "-" }, "|")
		end
		ItemDetail.show("shop", spec)
	end

	function view.refresh()
		local bag, me = ctx.bag(), ctx.me()
		if not bag or not me then
			return
		end
		for i, button in tabs do
			button:setOn(i == tab)
		end
		local list = bag.store[key()]
		-- 늘린 창고: 네 줄을 넘는 만큼 칸을 더 짓고 스크롤 틀의 속을 늘린다(가방 창과 같다)
		local rows = math.ceil(bag.storeSize / COLS)
		for i = #cells + 1, rows * COLS do
			makeCell(i)
		end
		local scroll = rows > rowsN
		gridRoot.CanvasSize = UDim2.fromOffset(0, math.max(rowsN, rows) * S)
		gridRoot.ScrollingEnabled = scroll and not ctx.quick.dragging()
		gridRoot.ScrollBarThickness = if scroll then BAR else 0
		local used = 0
		for i = 1, bag.storeSize do
			if list[i] then
				used += 1
			end
		end
		count:set(("%d / %d"):format(used, bag.storeSize))
		detail(bag, me)
		for i, cell in cells do
			local item = list[i] or nil
			cell:set(item, { locked = i > bag.storeSize, selected = sel ~= nil and sel.tab == key() and sel.slot == i, hot = hot == i })
		end
		sort:setEnabled(used > 1)
	end

	function view.destroy()
		ItemDetail.hide("shop")
		if ui.detail == "shop" then
			ui.detail = nil
		end
		ui.storeDrop, ui.storeHover, ui.storeShow = nil, nil, nil
	end
	return view
end

-- (제작은 2026-10-15에 대장장이 창으로 옮겼다 — ui/forgeWindow.luau. 대장장이의 상점은 없앴다: 사용자 "상점 없어야함 제작, 강화만 하는곳임")

function ShopWindow.build(body: Frame, ctx, w: number, h: number, arg: string)
	if arg == "store" then
		return buildStore(body, ctx, w)
	end
	local view = {}
	local ui = ctx.ui
	local panel = body.Parent :: GuiObject

	-- 상점: 물건마다 한 줄([그림] 이름 · [달돈] 값 · 사기). 물약(단마다 따로 판다 — 가방의 소비 탭에 들어온다)과 달가루는 열 개씩도 산다
	local rows = {}
	local bx = w - ShopWindow.BUY_W
	-- 물건이 창의 줄(MAX_ROWS)보다 많으면 목록이 스크롤한다(2026-10-18 — 달빛 부적 · 능력치 초기화 주문서로 열둘이 됐다. 창은 스마트폰의 화면 틀에 들어가야 한다)
	local stocks = stockOf(arg)
	local list = Ui.scroll(body, 0, 0, w, MAX_ROWS * ROW, #stocks * ROW, 3)
	for i, stock in stocks do
		local y = (i - 1) * ROW
		local many = stock.max > 1
		-- [그 물건의 그림(칸 안에)] 이름 · [달돈] 값 · 사는 단추 — 살 수 없는 것도 그림은 보인다
		local cell = Ui.slot(list, 0, y + 1, IC)
		cell.frame.Name = "Icon"
		local icon = Ui.smallIcon(cell.frame, "coin", 3, 3)
		local name = Ui.text(list, "", TX, y + 7, ShopWindow.NAME_W, { font = "body" })
		local coin = Ui.smallIcon(list, "coin", bx - 8 - ShopWindow.PRICE_W - 19, y + 4)
		local price = Ui.text(list, "", bx - 8 - ShopWindow.PRICE_W, y + 8, ShopWindow.PRICE_W, { align = "right", color = C.gold })
		local half = math.floor((ShopWindow.BUY_W - 6) / 2)
		local one = Ui.button(list, if many then "1" else "사기", bx, y, if many then half else ShopWindow.BUY_W, function()
			ctx.send("Item", "buy", stock.id, 1)
		end)
		local ten = if many
			then Ui.button(list, "10", bx + half + 6, y, half, function()
				ctx.send("Item", "buy", stock.id, 10)
			end)
			else nil
		-- 아직 살 수 없는 것은 값과 단추 자리에 "Lv.10부터"
		local lock = Ui.text(list, "", TX + ShopWindow.NAME_W, y + 8, w - TX - ShopWindow.NAME_W, { align = "right", color = C.dim })
		rows[i] = { stock = stock, icon = icon, coin = coin, name = name, price = price, one = one, ten = ten, lock = lock }
	end
	-- 되사기(2026-10-18 — 메이플의 재구매): 물건의 줄 아래에 머리 한 줄 「되사기 — 이번 접속에 판 것」과 판 것들(가장 최근 것부터 · 판 값 그대로). 판 것이 없으면 감춘다
	local backY = #stocks * ROW
	local backHead = Ui.text(list, ShopWindow.BACK_HEAD, 0, backY + 8, w, { color = C.dim })
	local backs = {}
	for i = 1, Bag.BUYBACK do
		local y = backY + i * ROW
		local cell = Ui.slot(list, 0, y + 1, IC)
		cell.frame.Name = "BackIcon"
		local icon = Ui.smallIcon(cell.frame, "coin", 3, 3)
		local name = Ui.text(list, "", TX, y + 7, ShopWindow.NAME_W, { font = "body" })
		local coin = Ui.smallIcon(list, "coin", bx - 8 - ShopWindow.PRICE_W - 19, y + 4)
		local price = Ui.text(list, "", bx - 8 - ShopWindow.PRICE_W, y + 8, ShopWindow.PRICE_W, { align = "right", color = C.gold })
		local buy = Ui.button(list, ShopWindow.BACK_BUY, bx, y, ShopWindow.BUY_W, function()
			ctx.send("Item", "buyback", i)
		end)
		backs[i] = { cell = cell, icon = icon, name = name, coin = coin, price = price, buy = buy }
	end
	local fy = h - 28
	Ui.line(body, 0, fy - 6, w)
	local money = BagWindow.purse(body, "coin", -3, fy, 90)
	local dust = BagWindow.purse(body, "dust", 96, fy, 90)
	-- 팔기: 가방의 것을 끌어다 이 창에 놓는다(가방의 상세 판이 팔지 묻는다)
	Ui.text(body, WORDS.shopHint, SHOP.hintX, fy + 4, w - SHOP.hintX, { align = "right", color = C.dim })
	ui.shopDrop = function(at: Vector2): boolean
		return ItemCell.over(panel, at)
	end

	function view.refresh()
		local bag, me = ctx.bag(), ctx.me()
		if not bag or not me then
			return
		end
		for _, row in rows do
			local stock = row.stock
			local cost = Items.stockPrice(stock, me.level)
			local label = stock.name
			local open = me.level >= stock.from
			Ui.setWorldIcon(row.icon, ShopWindow.stockIcon(stock, me.class))
			row.coin.Visible = open
			row.name:set(label)
			row.name:color(if open then C.text else C.dim)
			row.price:set(if open then Format.short(cost) else "")
			row.lock:set(if open then "" else ("Lv.%d부터"):format(stock.from))
			row.one.frame.Visible = open
			row.one:setEnabled(me.money >= cost)
			if row.ten then
				row.ten.frame.Visible = open
				row.ten:setEnabled(me.money >= cost * 10)
			end
		end
		-- 되사기의 줄들
		local sold = bag.buyback or {}
		backHead:show(#sold > 0)
		for i, b in backs do
			local e = sold[i]
			local on = e ~= nil
			b.cell.frame.Visible, b.coin.Visible, b.buy.frame.Visible = on, on, on
			b.name:show(on)
			b.price:show(on)
			if e then
				local goods = e.item and Items.goods(e.item)
				Ui.setWorldIcon(b.icon, if e.gear then ItemCell.icon(e.gear) elseif goods then goods.icon else "")
				b.name:set(if e.gear then ItemCell.label(e.gear) elseif goods then ("%s x%d"):format(goods.name, e.n) else "")
				b.name:color(if e.gear then ItemCell.color(e.gear) else C.text)
				b.price:set(Format.short(e.price))
				b.buy:setEnabled(me.money >= e.price)
			end
		end
		list.CanvasSize = UDim2.fromOffset(0, math.max(MAX_ROWS * ROW, #stocks * ROW + (if #sold > 0 then ROW * (#sold + 1) else 0)))
		list.ScrollingEnabled = #stocks + (if #sold > 0 then #sold + 1 else 0) > MAX_ROWS
		money:set(Format.short(me.money))
		dust:set(Format.short(bag.dust))
	end

	function view.destroy()
		ui.shopDrop = nil
	end
	return view
end

return ShopWindow

end
MODULES['Client/lune/ui/skillWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 스킬 창(넓은 창) — 위에 차수 탭(로마 숫자 I · II · III · IV — 사용자 2026-10-07: "1차 이렇게 적지말고 로마자로 적으세요 차 라는말 빼고"), 그 아래 그 차수의 스킬들(두 줄로 — 그림 · 이름 · 레벨 / 마스터 · + 단추)과 「추천대로 찍기」, 오른쪽에 고른 스킬의 설명.
--  사용자 2026-10-07: "스킬창에 차수 탭이 없습니다. 1,2,3,4 차 스킬 탭이있어야지 지금뭐가뭔지" · "패시브든 뭐든 다 아이콘이 있는거에요"(별 그림으로 때우던 것을 없앴다 — 스킬마다 제 그림이 있다)
--  공방의 횡스크롤 시험 탭(js/lune/ui/paint.js의 paintSkill)과 같은 그림이다. 치수는 Layout.SKILL · 글은 UI.skillWords · 스킬은 CLASSES.classes[직업].tiers(차수마다).
--  퀵슬롯에 놓기(사용자 2026-10-07: "스킬키를 단축키에 등록하기 쉬워야합니다"): 스킬을 끌어다 화면 아래의 칸에 놓거나, 스킬을 누른 뒤 반짝이는 칸을 누른다 — ctx.quick(ui/quickEdit.luau)이 맡는다.
--   설명 칸의 맨 아래 두 줄에 그 스킬이 놓인 칸(「퀵슬롯 Q」)과 놓는 법을 적는다.
--  올리는 것은 서버에 부탁한다(SkillUp · SkillAuto). 아직 전직하지 않은 차수는 볼 수만 있다(+ 단추가 꺼져 있고, 언제 배우는지를 적는다). 화면 오른쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local CLASSES = require(lune.data["classes.generated"])
local UI = require(lune.data["ui.generated"])
local Layout = require(lune.ui.layout)
local Format = require(lune.ui.format)
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local S = Layout.SKILL
local WORDS = UI.skillWords
local QWORDS = UI.quick.words
local COMBAT = require(lune.data["combat.generated"])
local BONUS = COMBAT.rules.targetBonus -- 사냥기 · 보스기가 맞는 상대에게 더 주는 피해(%)
local SkillDamage = require(lune.ui.skillDamage) -- 그 레벨의 효과 글: 사출기 · 장치 · 패시브 · 버프의 효과와 공격 스킬의 % 피해(사용자 2026-10-13: "스킬 퍼뎀같은거 스킬 창에 설명에 나와있어야해  메이플처럼")
local READY = COMBAT.ready -- 게임에 들어와 있는 스킬. 여기에 없는 스킬은 + 단추가 꺼져 있고 「아직 준비 중」이라고 적힌다(서버도 찍어 주지 않는다 — sim/hero.luau의 skillUp)
local TYPES = CLASSES.types

local SkillWindow = { wide = true }

function SkillWindow.size(): (number, number)
	local w, h = Layout.skillBody()
	return w, h
end

-- 지금 레벨에서 열린 차수(전직이 생기면 내 상태의 차수를 쓴다)
function SkillWindow.jobOf(me): number
	if me.job then
		return me.job
	end
	local job = 1
	for _, j in CLASSES.jobs do
		if j.lv <= me.level then
			job = math.max(job, j.job)
		end
	end
	return job
end

-- 누르는 자리. onPress = 누르기 시작했을 때(끌기의 시작 — 없어도 된다)
local function picker(parent: Instance, x: number, y: number, w: number, h: number, name: string, onClick: () -> (), onPress: ((InputObject) -> ())?): TextButton
	local hit = Instance.new("TextButton")
	hit.Name = name
	hit.Text = ""
	hit.BackgroundTransparency = 1
	hit.Position = UDim2.fromOffset(x, y)
	hit.Size = UDim2.fromOffset(w, h)
	hit.ZIndex = 4
	hit.Parent = parent
	hit.Activated:Connect(onClick)
	if onPress then
		hit.InputBegan:Connect(onPress)
	end
	return hit
end

function SkillWindow.build(body: Frame, ctx, _w: number, h: number)
	local _, _, listW = Layout.skillBody()
	local tiers = nil -- 내 직업의 차수들 { { job, lv, skills } … }
	local names = {} -- [스킬] = 이름(앞 차수의 기술을 잇는 스킬의 설명에 쓴다)
	local tab, selected = 1, 1
	local last = nil
	local tabs = {}
	local view = {}

	local points = Ui.text(body, "", listW - 160, 2, 160, { color = C.gold, align = "right" })
	local info = Ui.text(body, "", 0, S.infoY + 6, listW - S.autoW - 8, {})
	local auto = Ui.button(body, WORDS.auto, listW - S.autoW, S.infoY, S.autoW, function()
		ctx.send("SkillAuto")
	end, { main = true, h = 22, font = "small" })
	SkillWindow.autoFrame = auto.frame -- 튜토리얼(꿈)의 「스킬 찍기」 미션에서 반짝인다(2026-10-14)
	-- 전직하며 받은 공짜 초기화(설계: "전직하면 SP 초기화 한 번이 공짜"): 남아 있을 때만 탭의 오른쪽에 단추가 보인다. 잘못 누르지 않게 두 번 눌러야 한다(「정말 초기화?」 — 3초 안에)
	local RESET_X, RESET_W = (S.tabW + S.tabGap) * 4 + 8, 96
	local resetHolder = Ui.group(body, RESET_X, -2, RESET_W, 20, "Reset")
	local resetBtn: Instance? = nil
	local resetArmed, resetShown = 0, nil :: string?
	local function drawReset(me)
		local left = (me and me.resets) or 0
		local armed = os.clock() - resetArmed < 3
		local label = if left < 1 then "" elseif armed then "정말 초기화?" else "초기화(무료 1회)"
		if label == resetShown then
			return
		end
		resetShown = label
		if resetBtn then
			resetBtn:Destroy()
			resetBtn = nil
		end
		if label ~= "" then
			local button = Ui.button(resetHolder, label, 0, 0, RESET_W, function()
				if os.clock() - resetArmed < 3 then
					resetArmed = 0
					ctx.send("SkillReset")
				else
					resetArmed = os.clock()
					task.delay(3.1, function()
						drawReset(ctx.me())
					end)
				end
				drawReset(ctx.me())
			end, { h = 18, font = "small" })
			button.frame.Name = "Do_reset"
			resetBtn = button.frame
		end
	end
	view.drawReset = drawReset

	-- 스킬 칸들(cols x rows)을 미리 만들어 두고, 탭에 따라 채운다
	local cells = {}
	local nameW = S.colW - S.slot - 8 - S.plusW - 4
	for i = 1, S.cols * S.rows do
		local holder = Ui.group(body, ((i - 1) % S.cols) * (S.colW + S.colGap), S.top + math.floor((i - 1) / S.cols) * S.row, S.colW, S.row, "Skill" .. i)
		local cell = Ui.slot(holder, 0, 0, S.slot)
		local pic = Ui.pic(holder, nil, 3, 3)
		pic.ZIndex = 2
		local name = Ui.text(holder, "", S.slot + 8, 2, nameW, { font = "body" })
		local level = Ui.text(holder, "", S.slot + 8, 18, nameW, { color = C.dim })
		local plus = Ui.button(holder, "+", S.colW - S.plusW, 2, S.plusW, function()
			local sk = tiers and tiers[tab].skills[i]
			if sk then
				selected = i
				ctx.send("SkillUp", sk.id)
				view.paint()
			end
		end)
		-- 칸을 누르면 오른쪽에 설명이 나오고, 퀵슬롯에 놓을 수 있는 스킬이면 칸들이 반짝인다(한 번 더 누르면 그만둔다). 누른 채 움직이면 끌기
		picker(holder, 0, 0, S.colW - S.plusW - 4, S.slot, "Pick", function()
			local sk = tiers and tiers[tab].skills[i]
			if sk then
				selected = i
				ctx.quick.pick(sk.id)
				view.paint()
			end
		end, function(input: InputObject)
			local sk = tiers and tiers[tab].skills[i]
			if sk then
				ctx.quick.press(sk.id, nil, input)
			end
		end)
		cells[i] = { holder = holder, cell = cell, pic = pic, name = name, level = level, plus = plus }
	end

	-- 오른쪽: 고른 스킬의 그림 · 이름 · 갈래와 레벨 · 설명 · (앞 차수의 기술을 잇는 것이면) 그 기술의 이름
	local dx = listW + S.gap
	local detailW = S.detailW - S.slot - 10
	Ui.box(body, listW + math.floor(S.gap / 2), 0, 1, h, C.line)
	Ui.slot(body, dx, 0, S.slot)
	local detailPic = Ui.pic(body, nil, dx + 3, 3)
	local detailName = Ui.text(body, "", dx + S.slot + 10, 1, detailW, { font = "body", color = C.gold })
	local detailType = Ui.text(body, "", dx + S.slot + 10, 18, detailW, { color = C.dim })
	local detailBonus = Ui.text(body, "", dx, S.slot + 14, S.detailW, { color = C.accent }) -- 사냥기 · 보스기의 쓰임(일반 몬스터 · 보스에게 피해 +%)
	local detailText = Ui.text(body, "", dx, S.slot + 14, S.detailW, { lines = S.textLines, line = S.textLine })
	local detailNote = Ui.text(body, "", dx, S.slot + 14, S.detailW, { color = C.dim })
	-- 설명 아래에 그 레벨의 효과를 숫자로(지금의 것 · + 를 누르면 되는 것): 온오프 사출기 · 핵심 장치 · 패시브 · 버프의 효과, 공격 스킬의 % 피해
	--  「지금 Lv.n」과 「다음 Lv.n+1」이 나란히 적혀, 한 레벨을 찍으면 얼마가 오르는지 보인다(사용자 2026-10-13: "스킬레벨 추가로 찍으면 퍼뎀올라가는것도 보여야하고")
	local effects = {}
	for i = 1, 2 do
		effects[i] = {
			label = Ui.text(body, "", dx, 0, S.detailW, { color = C.dim }),
			text = Ui.text(body, "", dx, 0, S.detailW, { lines = 3, line = S.textLine, color = if i == 1 then C.text else C.dim }),
		}
	end
	-- 맨 아래 두 줄: 퀵슬롯의 어느 칸에 있는가 · 놓는 법
	local quickAt = Ui.text(body, "", dx, h - Ui.M.small - 16, S.detailW, { color = C.dim })
	local quickHint = Ui.text(body, "", dx, h - Ui.M.small, S.detailW, { color = C.dim })

	-- 차수 탭: 로마 숫자(본문 글씨)를 같은 폭의 칸에 가운데로 — 고른 것은 민트 글씨에 밑줄, 아직 못 배우는 차수는 더 흐리다
	local function buildTabs()
		for i, t in tiers do
			local holder = Ui.group(body, (i - 1) * (S.tabW + S.tabGap), 0, S.tabW, 18, "Tier" .. t.job)
			local label = Ui.text(holder, WORDS.tabs[t.job] or tostring(t.job), 0, 0, S.tabW, { font = "body", align = "center", color = C.dim })
			local under = Ui.box(holder, 0, 15, S.tabW, 2, C.accent)
			under.Visible = false
			picker(holder, 0, -4, S.tabW, 24, "Hit", function()
				if tab ~= i then
					tab, selected = i, 1
					ctx.quick.pick(nil)
					view.paint()
				end
			end)
			tabs[i] = { label = label, under = under, job = t.job }
		end
	end

	function view.paint()
		local me = last
		if not me or not tiers then
			return
		end
		local job = SkillWindow.jobOf(me)
		local tier = tiers[tab]
		local locked = tier.job > job
		for i, t in tabs do
			t.label:color(if i == tab then C.accent elseif t.job > job then C.off else C.dim)
			t.under.Visible = i == tab
		end
		-- 스킬 포인트는 차수마다 따로다(받은 SP는 그때의 차수 스킬에만 쓴다) — 보고 있는 탭의 것을 적는다
		local pool = if me.sps then me.sps[tier.job] or 0 else me.sp
		points:set(Format.fill(WORDS.points, { n = pool }))
		info:set(Format.fill(if locked then WORDS.locked else WORDS.open, { job = tier.job, lv = tier.lv, n = #tier.skills }))
		info:color(if locked then C.red else C.dim)
		auto:setEnabled(not locked and pool > 0)
		for i, c in cells do
			local sk = tier.skills[i]
			c.holder.Visible = sk ~= nil
			if sk then
				local lv = me.skills[sk.id] or 0
				c.cell:setOn(i == selected)
				Ui.setPic(c.pic, "skill_" .. sk.id)
				c.name:set(sk.name)
				c.name:color(if i == selected then C.accent elseif not READY[sk.id] then C.off elseif lv > 0 then C.text else C.dim)
				c.level:set(("%d / %d"):format(lv, sk.max))
				c.level:color(if lv >= sk.max then C.accent else C.dim)
				c.plus:setEnabled(not locked and pool > 0 and lv < sk.max and READY[sk.id] == true and (not sk.needs or not READY[sk.needs] or (me.skills[sk.needs] or 0) > 0))
			end
		end
		local sk = tier.skills[selected]
		if sk then
			local lv = me.skills[sk.id] or 0
			Ui.setPic(detailPic, "skill_" .. sk.id)
			detailName:set(sk.name)
			detailType:set(("%s · Lv.%d / %d"):format(TYPES[sk.type] or sk.type, lv, sk.max))
			local bonus = WORDS.bonus[sk.type]
			local top = S.slot + 14 + (if bonus then S.textLine else 0)
			detailBonus:set(if bonus then Format.fill(bonus, { pct = BONUS }) else "")
			detailText:set(sk.text)
			detailText:move(dx, top)
			local _, th = detailText:size()
			-- 알림 한 줄: 게임에 아직 없는 스킬이면 그것부터(빨강), 먼저 배워야 하는 스킬을 아직 안 배웠으면 그것(빨강), 아니면 앞 차수의 어느 기술 자리에 들어가는지
			local soon = not READY[sk.id]
			local needs = not soon and sk.needs and READY[sk.needs] and (me.skills[sk.needs] or 0) < 1 and names[sk.needs]
			local note = if soon then WORDS.soon elseif needs then Format.fill(WORDS.needs, { name = needs }) elseif sk.replaces and names[sk.replaces] then Format.fill(WORDS.replaces, { name = names[sk.replaces] }) else ""
			detailNote:color(if soon or needs then C.red else C.dim)
			detailNote:set(note)
			local below = top + math.max(1, math.floor(th / S.textLine + 0.5)) * S.textLine
			detailNote:move(dx, below + 6)
			-- 그 레벨의 효과: 지금(배웠을 때) · 다음(마스터가 아닐 때)
			local y = below + S.effGap + (if note ~= "" then S.textLine + 6 else 0)
			for i, e in effects do
				local at = lv + i - 1
				local text = if at >= 1 and at <= sk.max then SkillDamage.text(sk.id, at) else nil
				e.label:set(if text then Format.fill(if i == 1 then WORDS.now else WORDS.next, { lv = at }) else "")
				e.label:color(if i == 1 then C.accent else C.dim)
				e.text:set(text or "")
				if text then
					e.label:move(dx, y)
					e.text:move(dx, y + S.textLine)
					local _, eh = e.text:size()
					y += S.textLine + math.max(1, math.floor(eh / S.textLine + 0.5)) * S.textLine
				end
			end
			-- 퀵슬롯: 놓인 칸의 키 · 놓는 법(놓으려고 고른 중이면 민트)
			local q = ctx.quick.info(sk.id, sk.type)
			local armed = ctx.quick.picked() == sk.id
			quickAt:set(if q.state == "passive" then QWORDS.passive elseif q.state == "unlearned" then QWORDS.unlearned elseif q.state == "later" then QWORDS.later elseif q.key then Format.fill(QWORDS.at, { key = q.key }) else QWORDS.none)
			quickAt:color(if q.state == "ok" and q.key then C.gold else C.dim)
			quickHint:set(if q.state ~= "ok" then "" elseif armed then QWORDS.armed else QWORDS.hint)
			quickHint:color(if armed then C.accent else C.dim)
		end
	end

	function view.refresh(me)
		last = me
		drawReset(me)
		if not tiers then
			-- 처음: 내 직업의 차수들로 탭을 만든다. 지금 배울 수 있는 가장 높은 차수의 탭부터 보여 준다
			tiers = CLASSES.classes[me.class].tiers
			for _, t in tiers do
				for _, sk in t.skills do
					names[sk.id] = sk.name
				end
			end
			buildTabs()
			tab = math.clamp(SkillWindow.jobOf(me), 1, #tiers)
		end
		view.paint()
	end
	-- 탭을 고른다(시험 · 화면 확인용)
	function view.setTab(i: number, pick: number?)
		if tiers and tiers[i] then
			tab, selected = i, pick or 1
			view.paint()
		end
	end
	return view
end

return SkillWindow

end
MODULES['Client/lune/ui/soundWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 소리 설정 창 — 메뉴 → 「소리 설정」. 배경 음악과 효과음의 크기를 따로 열 칸으로(한 칸 10%).
--  사용자 2026-10-13: "소리조절 있어야합니다." — 그 앞에는 메뉴에 「소리 끄기 / 켜기」뿐이었다.
--  줄마다: 이름 · 「−」 · 칸 열 개(찬 칸 = 민트 — 눌러서 그 칸까지 · 모두 껐으면 흐린 회색) · 「+」 · %. 아래에 「모두 끄기 / 켜기」와 안내 글.
--  바꾸면 바로 그 크기로 나고(music.luau), 계정에 저장된다(ctx.saveSound → 서버의 Sound). 모양은 공방 시험 탭의 js/lune/ui/paint.js(paintSound)와 같다.
--  화면 오른쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Layout = require(ReplicatedStorage.shared.lune.ui.layout)
local Ui = require(script.Parent.ui)
local Music = require(script.Parent.Parent.music)
local ViewOpts = require(script.Parent.Parent.viewOpts) -- 화면(다른 사람의 스킬 효과 · 피해 숫자 — 2026-10-18)

local C = Ui.COLOR
local S = Layout.SOUND

local SoundWindow = {}

function SoundWindow.size(): (number, number)
	local V = S.view
	return S.w, #S.rows * S.row + S.muteY + Ui.M.button + V.gap + V.headH + #V.rows * S.row + Ui.M.small
end

-- 줄 안에서의 자리: 첫 칸의 x · 「+」의 x
function SoundWindow.bar(): (number, number)
	local x = S.labelW + S.btn + S.barGap
	return x, x + S.steps * S.seg + (S.steps - 1) * S.gap + S.barGap
end

function SoundWindow.pct(v: number): string
	return ("%d%%"):format(math.floor(v / S.steps * 100 + 0.5))
end

function SoundWindow.build(body: Frame, ctx, w: number, _h: number)
	local view = {}
	local rows = {}
	local barX, plusX = SoundWindow.bar()
	local function set(kind: string, v: number)
		if Music.setLevel(kind, v) then
			ctx.saveSound()
			view.refresh()
		end
	end
	for i, def in S.rows do
		local kind, name = def[1], def[2]
		local y = (i - 1) * S.row
		local row = { kind = kind, segs = {} }
		Ui.text(body, name, 0, y + math.floor((S.btn - Ui.M.body) / 2), S.labelW - 6, { font = "body" })
		row.minus = Ui.button(body, "-", S.labelW, y, S.btn, function()
			set(kind, Music.level[kind] - 1)
		end, { h = S.btn, font = "body" })
		local by = y + math.floor((S.btn - S.barH) / 2)
		for k = 1, S.steps do
			local x = barX + (k - 1) * (S.seg + S.gap)
			-- 칸: 한 점 테두리(빈 칸) + 속 — 찬 칸은 둘 다 한 색
			local edge = Ui.box(body, x, by, S.seg, S.barH, C.line)
			edge.Name = "Seg" .. k
			local fill = Ui.box(edge, 1, 1, S.seg - 2, S.barH - 2, C.panel2)
			-- 누르는 자리는 칸보다 넓게(사이의 틈까지 · 줄의 높이만큼) — 손가락으로도 누른다
			Ui.hit(Ui.group(body, x, y, S.seg + S.gap, S.btn, "SegHit" .. k)).Activated:Connect(function()
				set(kind, k)
			end)
			row.segs[k] = { edge = edge, fill = fill }
		end
		row.plus = Ui.button(body, "+", plusX, y, S.btn, function()
			set(kind, Music.level[kind] + 1)
		end, { h = S.btn, font = "body" })
		row.pct = Ui.text(body, "", w - S.pctW, y + math.floor((S.btn - Ui.M.small) / 2), S.pctW, { align = "right" })
		rows[i] = row
	end
	local my = #S.rows * S.row + S.muteY
	local mute = Ui.button(body, "", 0, my, S.muteW, function()
		Music.toggle()
		ctx.saveSound()
		view.refresh()
	end)
	Ui.text(body, S.note, S.muteW + 8, my + math.floor((Ui.M.button - Ui.M.small) / 2), w - S.muteW - 8, { align = "right", color = C.dim })
	-- 화면(2026-10-18 — 공방 시험 탭의 paintSound와 같은 모양): 가로줄 · 「화면」 · 줄마다 이름과 오른쪽 끝의 켜짐 / 꺼짐 단추 · 맨 아래 안내
	local V = S.view
	local vy = my + Ui.M.button + V.gap
	Ui.box(body, 0, vy, w, 1, C.line)
	Ui.text(body, V.head, 0, vy + 6, w, { color = C.dim })
	local toggles = {}
	for j, def in V.rows do
		local key, name = def[1], def[2]
		local y = vy + V.headH + (j - 1) * S.row
		Ui.text(body, name, 0, y + math.floor((S.btn - Ui.M.body) / 2), w - V.btnW - 8, { font = "body" })
		toggles[key] = Ui.button(body, V.on, w - V.btnW, y, V.btnW, function()
			if ViewOpts.toggle(key) then
				ctx.saveSound()
				view.refresh()
			end
		end, { h = S.btn })
	end
	Ui.text(body, V.note, 0, vy + V.headH + #V.rows * S.row, w, { color = C.dim })

	function view.refresh()
		for _, row in rows do
			local v = Music.level[row.kind]
			for k, seg in row.segs do
				local color = if k <= v then (if Music.on then C.accent else C.off) else nil
				seg.edge.BackgroundColor3 = color or C.line
				seg.fill.BackgroundColor3 = color or C.panel2
			end
			row.minus:setEnabled(v > 0)
			row.plus:setEnabled(v < S.steps)
			row.pct:set(if Music.on then SoundWindow.pct(v) else S.off)
			row.pct:color(if Music.on and v > 0 then C.text else C.dim)
		end
		mute:setText(S.mute[if Music.on then 1 else 2])
		mute:setMain(not Music.on)
		for key, b in toggles do
			b:setText(if ViewOpts[key] then V.on else V.off)
			b:setMain(ViewOpts[key] == true)
		end
	end
	view.refresh()
	return view
end

return SoundWindow

end
MODULES['Client/lune/ui/statWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 능력치 창 — 남은 점수, 다섯 능력치와 + 단추, 「자동으로 찍기」, 아래에 전투력과 체력.
--  찍는 것은 서버에 부탁한다(StatAdd · StatAuto). 서버가 내 상태를 다시 보내면 고쳐 그린다. 화면 오른쪽의 옆 판(ui/windows.luau).
--  능력치에 마우스를 올리면(터치는 그 줄을 누르면) 창 옆에 설명 판이 뜬다 — 그 직업에게 무엇을 해 주는지와 지금 레벨에서 1점에 얼마가 오르는지.
--   사용자 2026-10-07: "능력치에 각각 스텟별로 마우스 올리면 호버로 스텟 효과를 보여줘야합니다. 뭔지알고 스텟을찍으라는건지"
--   글과 숫자는 shared/lune/ui/format.luau의 statTip(공방의 횡스크롤 시험 탭 — js/lune/ui/paint.js의 paintStat · tipPanel과 같은 그림). 이 직업이 안 쓰는 능력치는 이름이 흐리다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local N = require(ReplicatedStorage.shared.lune.config.numbers)
local Format = require(ReplicatedStorage.shared.lune.ui.format)
local Layout = require(ReplicatedStorage.shared.lune.ui.layout)
local UI = require(ReplicatedStorage.shared.lune.data["ui.generated"])
local Stage = require(script.Parent.Parent.stage)
local Ui = require(script.Parent.ui)

local STATS = N.data.STATS
local C = Ui.COLOR
local S = Layout.STAT
local TIP = S.tip
local MARK = UI.statTip.marks
local TIPCOLOR = { main = C.gold, sub = C.accent, none = C.dim, hp = C.text }

local StatWindow = {}

function StatWindow.size(): (number, number)
	return Layout.statBody(#STATS.order)
end

function StatWindow.build(body: Frame, ctx, w: number, _h: number)
	local points = Ui.text(body, "", 0, 0, w, { color = C.gold })
	local rows = {}
	local last = nil -- 마지막으로 받은 내 상태
	local tip = nil -- 떠 있는 설명 판 { frame, id }

	local function hideTip()
		if tip then
			tip.frame:Destroy()
			rows[tip.id].back.Visible = false
			tip = nil
		end
	end

	-- 설명 판: 칸과 같은 판에 제목(주 노랑 · 부 민트 · 안 쓰는 것 흐림) · 그 옆의 꼬리표 · 글 줄들. 창의 왼쪽에 붙인다(창이 화면 왼쪽에 있으면 오른쪽에)
	local function showTip(id: string)
		if not last or (tip and tip.id == id) then
			return
		end
		hideTip()
		local sh = last.sheet
		local t = Format.statTip(last.class, id, last.level, if sh then sh.attack * (1 + sh.dmg / 100) * (1 + sh.final / 100) else nil) -- 1점의 값 = 스탯 공격력이 오르는 만큼(지금 낀 무기로 — 2026-10-15)
		local color = TIPCOLOR[t.kind]
		local inner = TIP.w - TIP.pad * 2
		local frame = Ui.group(body, 0, 0, TIP.w, 10, "Tip")
		frame.ZIndex = 20
		local back = Ui.part(frame, "uTip", 0, 0, TIP.w, 10)
		local title = Ui.text(frame, t.title, TIP.pad, TIP.pad, inner, { font = "body", color = color })
		if t.tag ~= "" then
			local tw = title:size()
			Ui.text(frame, t.tag, TIP.pad + tw + 8, TIP.pad + 2, inner - tw - 8, { color = color })
		end
		local y = TIP.pad + TIP.title
		for i, line in t.lines do
			local tint = if i > 1 then (if t.kind == "none" then C.dim else C.accent) elseif t.kind == "none" then C.red else C.text
			local label = Ui.text(frame, line, TIP.pad, y, inner, { lines = TIP.lines, line = TIP.line, color = tint })
			local _, lh = label:size()
			y += math.max(1, math.floor(lh / TIP.line + 0.5)) * TIP.line
		end
		local h = y - (TIP.line - Ui.M.small) + TIP.pad
		frame.Size = UDim2.fromOffset(TIP.w, h)
		back.Size = UDim2.fromOffset(TIP.w, h)
		local left = -Ui.WIN.pad - TIP.gap - TIP.w
		-- 기준 격자 안의 자리로 잰다(화면이 넓으면 기준 격자 양옆에 검은 띠가 있다 — 2026-10-18 검토: 띠의 폭까지 더해 설명이 띠 속으로 나가 안 보였다)
		if (body.AbsolutePosition.X - Stage.ui.AbsolutePosition.X) / Stage.uiScale + left < 4 then
			left = w + Ui.WIN.pad + TIP.gap -- 왼쪽에 자리가 없다(창이 화면 왼쪽에 있다)
		end
		frame.Position = UDim2.fromOffset(left, rows[id].y - 2)
		rows[id].back.Visible = true
		tip = { frame = frame, id = id }
	end

	local y = S.top
	for _, id in STATS.order do
		local ty = y + math.floor((Ui.M.button - Ui.M.body) / 2)
		local back = Ui.box(body, -6, y - 2, w - S.plusW, S.row, C.panel2)
		back.Name = "Hot"
		back.Visible = false
		local name = Ui.text(body, STATS.names[id], 0, ty, S.tagX - 4, { font = "body" })
		local tag = Ui.text(body, "", S.tagX, ty + 1, 30, { color = C.accent })
		local value = Ui.text(body, "", S.tagX + 32, ty, w - S.tagX - 32 - S.valueRight, { font = "body", align = "right" })
		local plus = Ui.button(body, "+", w - S.plusW, y, S.plusW, function()
			ctx.send("StatAdd", id, 1)
		end)
		-- 줄에 마우스를 올리면 설명이 뜨고, 벗어나면 사라진다. 터치는 줄을 누르면 뜨고 한 번 더 누르면 사라진다
		local over = Instance.new("TextButton")
		over.Name = "Over_" .. id
		over.Text = ""
		over.BackgroundTransparency = 1
		over.Position = UDim2.fromOffset(-6, y - 2)
		over.Size = UDim2.fromOffset(w - S.plusW, S.row)
		over.ZIndex = 8
		over.Parent = body
		over.MouseEnter:Connect(function()
			showTip(id)
		end)
		over.MouseLeave:Connect(function()
			if tip and tip.id == id then
				hideTip()
			end
		end)
		over.Activated:Connect(function(input)
			if input and input.UserInputType == Enum.UserInputType.Touch and tip and tip.id == id then
				hideTip()
			else
				showTip(id)
			end
		end)
		rows[id] = { name = name, tag = tag, value = value, plus = plus, back = back, y = y }
		y += S.row
	end
	y += 4
	local auto = Ui.button(body, "자동으로 찍기", 0, y, w, function()
		ctx.send("StatAuto")
	end, { main = true })
	StatWindow.autoFrame = auto.frame -- 튜토리얼(꿈)의 「능력치 찍기」 미션에서 반짝인다(2026-10-14)
	y += Ui.M.button + 10
	Ui.line(body, 0, y, w)
	-- 전투력(왼쪽)과 체력(오른쪽)을 한 줄에
	local power = Ui.text(body, "", 0, y + 10, math.floor(w / 2), { color = C.gold })
	local hp = Ui.text(body, "", math.floor(w / 2), y + 10, w - math.floor(w / 2), { align = "right" })

	local view = {}
	function view.refresh(me)
		last = me
		local pair = STATS.classes[me.class]
		points:set(("남은 점수 %d"):format(me.ap))
		for _, id in STATS.order do
			local row = rows[id]
			local used = id == "hp" or id == pair[1] or id == pair[2]
			row.tag:set(if id == pair[1] then MARK.main elseif id == pair[2] then MARK.sub else "")
			row.value:set(tostring(if me.sheet and me.sheet.stats then me.sheet.stats[id] else STATS.base + me.stats[id])) -- 처음 4 + 찍은 점수 + 장비의 올스탯(2026-10-15)
			row.name:color(if used then C.text else C.off)
			row.value:color(if used then C.text else C.off)
			row.plus:setEnabled(me.ap > 0)
		end
		auto:setEnabled(me.ap > 0)
		power:set(("전투력 %s"):format(Format.short(me.power)))
		hp:set(("최대 체력 %s"):format(Format.short(me.maxHp))) -- 「체력」은 능력치의 이름이라 「최대 체력」(2026-10-15)
		-- 떠 있는 설명은 새 값으로(레벨이 오르면 1점의 값이 달라진다)
		if tip then
			local id = tip.id
			hideTip()
			showTip(id)
		end
	end
	-- 설명 판을 띄운다 · 지운다(시험 · 화면 확인용)
	view.showTip, view.hideTip = showTip, hideTip
	return view
end

return StatWindow

end
MODULES['Client/lune/ui/talk'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 주민과의 대화 — 둘로 나눈다(2026-10-14):
--  사용자: "npc 대화 뜨는건 그냥 idle 일때 혼잣말할때만 말풍선 형태로 말하고 상호작용해서 퀘스트 받거나 대화할때는 일반 도트 게임처럼 … 대화창이떠서 말을 듣는"
--  둘째 판(같은 날): "대화창 색감이 우리 게임 ui와 맞지않습니다. 그리고 글씨는 한글자씩 도트게임스타일로 … 캐릭터이미지 안떠도 됩니다. 그리고 좌우로 너무 대화창 넓습니다.
--    또, 모바일에서도 정확히 나오게 크로스 플랫폼 고려해서"
--  ① 대화창(Talk.start · next · accept · decline · close): ↑로 말을 걸면 화면 아래 가운데의 어두운 판(창과 같은 판 uPanel). 판의 위 테두리에 이름표(어두운 판 · 민트 테두리 · 흰 이름 + 노랑 퀘스트 이름),
--     대사는 한 글자씩(DIALOG.cps) · 강조 낱말(몬스터 · 물건 · 곳 · 사람)은 민트. 말이 다 나오면 오른쪽 아래에 「↑ 다음 · 닫기 · 완료」, 받을 퀘스트의 마지막 말이면 「수락 · 거절」 단추.
--     나오는 중에 ↑ · 스페이스 · 판을 누르면 그 말이 한 번에 다 나오고, 한 번 더 누르면 다음 말. X · Esc = 거절(닫기). 판 · 단추를 눌러도 같다(스마트폰).
--     폭은 DIALOG.w(화면 틀이 좁으면 양옆 margin을 남기고 줄인다) — 화면 틀이 바뀌면(창 크기 · 폰을 돌림) 매 화면 다시 놓는다(Talk.place).
--  ② 혼잣말(Talk.say): 주민 머리 위의 흰 말풍선(산나비처럼) — 단추 · 안내 없이 한 줄, IDLE.show초 뒤에 사라진다. 누가 언제 말할지는 boot.luau가 정한다(IDLE).
--  모양은 공방 시험 탭(js/lune/ui/paint.js의 dialog · bubble)과 같게 짓는다. 값은 공방 js/lune/design/ui.js의 DIALOG · BUBBLE · IDLE(→ shared/lune/ui/format.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Format = require(ReplicatedStorage.shared.lune.ui.format)
local pixelText = require(script.Parent.Parent.Parent.modules.ui.pixelText)
local Stage = require(script.Parent.Parent.stage)
local Overlay = require(script.Parent.Parent.overlay)
local Ui = require(script.Parent.ui)
local WORDS = require(ReplicatedStorage.shared.lune.data["ui.generated"]).words

local C = Ui.COLOR
local M = Ui.M
local B = Format.BUBBLE -- 혼잣말 말풍선(자동 검사가 주민의 말이 이 폭 · 줄 수에 들어가는지 본다)
local D = Format.DIALOG -- 대화창
local LINE = M.bodyLine
local MAX_SEGS = 8 -- 한 줄에 나뉘는 조각(강조 낱말 앞뒤)의 수 — 넘으면 나머지를 한 조각에 붙인다

local Talk = {}
Talk.npc = nil :: any
Talk.index = 0
Talk.TEXT_W = Format.DIALOG_TEXT_W -- 대화창 대사의 폭(자동 검사가 퀘스트 대사가 이 폭 · 줄 수에 들어가는지 본다)
Talk.LINES = D.lines
Talk.BUBBLE_W = B.textW
Talk.onFinish = nil :: ((any) -> ())? -- 대화를 끝까지 들었다(마지막 말 뒤에 넘겼다 — 튜토리얼의 「말 걸기」 미션)
Talk.onToggle = nil :: ((any) -> ())? -- 대화창이 뜨고 닫힐 때(뜨면 그 주민, 닫히면 nil) — 머리 위 퀘스트 표시 · 아래쪽 화면 · 터치 단추를 그동안 숨긴다
-- 여러 사람이 말하는 대화(2026-10-15 — 퀘스트 연출): 말 앞에 「@id 」가 붙으면 그 사람의 이름표로 바꾼다(@hero = 내 캐릭터). 이름은 boot.luau가 알려 준다
Talk.nameOf = nil :: ((string) -> string?)?
Talk.CINE = { id = "__cine", name = "", x = 0, y = 0, cine = true } -- 장면(cineView.luau)이 대화창에 말을 띄울 때의 「주민」 — 이름은 말마다 바뀐다

local root: Frame
-- 대화창
local box: Frame
local panel: Frame
local plateEdge: { Frame }, plateIn: Frame
local nameText, titleText
local rows: { { any } } = {} -- 줄마다 조각 글
local hintText, hintKey
local acceptBtn, declineBtn
local lines: { string } = {}
local onEnd: (() -> ())? = nil
local endHint: string? = nil
local started = 0 -- 지금 말이 나오기 시작한 때(os.clock)
local fitted: { string } = {} -- 지금 말을 폭에 맞춰 바꾼 줄들
local total = 0 -- 지금 말의 글자 수
local drawn = -1 -- 그려 둔 글자 수(바뀔 때만 다시 그린다)
local layoutKey = "" -- 놓은 화면 틀(바뀌면 다시 놓는다)
local nameStr, hintStr = "", "" -- 이름표의 이름 · 아래 줄의 안내(폭을 재는 데 쓴다)
local baseName = "" -- 말을 건 주민의 이름(「@id 」가 붙은 말이 끝나면 이 이름으로 돌아온다)
local curText = "" -- 지금 말(「@id 」를 뗀 것)
-- 고르는 말(Talk.menu — 2026-10-18, 메이플스토리의 NPC 대화처럼): 한 주민에게 할 일이 둘 넘게 있으면 줄마다 하나씩 보이고 고른다
local menuItems: { any }? = nil -- 지금 고르는 줄들 { text, color } — nil이면 고르는 중이 아니다
local menuPick: ((number) -> ())? = nil
local menuSel = 1
local menuRows = {} -- 줄마다 글
local menuHits = {} -- 줄마다 누르는 판(스마트폰 · 마우스)
local menuBar: Frame -- 고른 줄 밑의 띠
-- 혼잣말
local chat: Frame
local chatBack, chatTail, chatBody
local chatNpc: any = nil
local chatTill = 0
local chatSize = { w = 0, h = 0 }

local function utf8len(s: string): number
	return utf8.len(s) or #s
end

function Talk.init()
	root = Stage.group(Overlay.root, "Talk", 60)
	-- ① 대화창
	box = Ui.group(root, 0, 0, 1, 1, "Dialog")
	box.Visible = false
	panel = Ui.panel(box, 0, 0, 1, 1)
	local hit = Ui.hit(box) -- 판 아무 데나 누르면 다음(스마트폰) — 단추는 이 위에 놓는다
	hit.Name = "Next"
	hit.Activated:Connect(function()
		if Talk.npc and Talk.npc ~= Talk.CINE then -- 장면의 말은 장면이 넘긴다(화면 위의 누르는 판 — cineView.luau)
			Talk.next(Talk.npc)
		end
	end)
	-- 이름표: 민트 한 점 테두리(모서리 한 점 깎기 — 사각형 둘을 겹친다) · 어두운 속
	plateEdge = { Ui.box(box, 0, 0, 1, 1, C.accent), Ui.box(box, 0, 0, 1, 1, C.accent) }
	plateIn = Ui.box(box, 0, 0, 1, 1, C.ink)
	nameText = Ui.text(box, "", 0, 0, 200, { font = "body", color = C.text })
	titleText = Ui.text(box, "", 0, 0, 240, { color = C.gold })
	for r = 1, D.lines do
		rows[r] = {}
		for k = 1, MAX_SEGS do
			rows[r][k] = Ui.text(box, "", 0, 0, 2000, { font = "body", color = C.text })
		end
	end
	-- 고르는 말의 줄: 고른 줄 밑에 어두운 민트 띠 · 줄을 누르면 그것을 고른다
	menuBar = Ui.box(box, 0, 0, 1, 1, C.accentDark)
	menuBar.Visible = false
	for r = 1, D.lines do
		menuRows[r] = Ui.text(box, "", 0, 0, 2000, { font = "body", color = C.text })
		menuRows[r]:show(false)
		local holder = Ui.group(box, 0, 0, 1, 1, "MenuRow" .. r)
		holder.ZIndex = 10
		holder.Visible = false
		Ui.hit(holder).Activated:Connect(function()
			if menuItems and Talk.npc and r <= #menuItems then
				menuSel = r
				Talk.next(Talk.npc)
			end
		end)
		menuHits[r] = holder
	end
	hintText = Ui.text(box, "", 0, 0, 120, { color = C.dim })
	hintKey = Ui.keycap(box, "↑", 0, 0)
	acceptBtn = Ui.button(box, WORDS.accept or "수락", 0, 0, D.button[1], function()
		Talk.accept()
	end, { main = true, h = D.button[2] })
	declineBtn = Ui.button(box, WORDS.decline or "거절", 0, 0, D.button[1], function()
		Talk.decline()
	end, { h = D.button[2] })
	-- X · Esc = 거절(닫기) — 대화창이 떠 있을 때만
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not Talk.npc or Talk.npc == Talk.CINE then -- 장면의 말: Esc는 장면의 건너뛰기(cineView.luau)
			return
		end
		if input.KeyCode == Enum.KeyCode.X or input.KeyCode == Enum.KeyCode.Escape then
			Talk.decline()
		end
	end)
	-- ② 혼잣말 말풍선
	chat = Ui.group(root, 0, 0, 1, 1, "Chat")
	chat.Visible = false
	chatBack = Ui.part(chat, "uBubble", 0, 0, 12, 14)
	chatTail = Ui.part(chat, "uTail", 0, 0)
	chatTail.ZIndex = 2
	chatBody = Ui.text(chat, "", B.padX, B.padY, B.textW, { font = "body", lines = B.lines, line = LINE, color = C.bubbleInk, z = 3 })
end

-- 대화창의 자리와 크기: 화면 아래 가운데 · 폭 = DIALOG.w(좁은 화면 틀이면 양옆 margin을 남기고 줄인다)
local function dims()
	local w = math.min(D.w, Stage.uiW - D.margin * 2)
	local h = D.padY + D.lines * LINE + D.foot
	return math.floor((Stage.uiW - w) / 2), Stage.uiH - D.bottom - h, w, h
end

-- 버튼 · 안내 · 이름표의 자리(화면 틀이 바뀌거나 말이 바뀔 때)
local function layout()
	local x, y, w, h = dims()
	box.Position = UDim2.fromOffset(x, y)
	box.Size = UDim2.fromOffset(w, h)
	panel.Size = UDim2.fromOffset(w, h)
	panel:FindFirstChild("Back").Size = UDim2.fromOffset(w, h)
	-- 이름표: 판의 위 테두리에 걸친다
	local nameW = Ui.measure(nameStr, "body")
	local tW = select(1, titleText:size())
	local titleW = if tW > 0 then math.min(tW, w - nameW - 60) + 12 else 0
	local pw, ph, px, py = nameW + 12 + titleW, D.plateH, D.padX - 6, -math.floor(D.plateH / 2)
	plateEdge[1].Position, plateEdge[1].Size = UDim2.fromOffset(px + 1, py), UDim2.fromOffset(pw - 2, ph)
	plateEdge[2].Position, plateEdge[2].Size = UDim2.fromOffset(px, py + 1), UDim2.fromOffset(pw, ph - 2)
	plateIn.Position, plateIn.Size = UDim2.fromOffset(px + 1, py + 1), UDim2.fromOffset(pw - 2, ph - 2)
	local plate = nameStr ~= "" -- 이름이 없는 말(장면의 속마음)은 이름표를 달지 않는다
	plateEdge[1].Visible, plateEdge[2].Visible, plateIn.Visible = plate, plate, plate
	nameText:show(plate)
	titleText:show(plate)
	nameText:move(D.padX, py + math.floor((ph - M.body) / 2))
	titleText:move(D.padX + nameW + 12, py + math.floor((ph - M.small) / 2))
	-- 아래 줄: 「수락 · 거절」 또는 「↑ 다음」
	local bw, bh = D.button[1], D.button[2]
	local cy = h - bh - 6
	local dx = w - D.padX - bw
	declineBtn.frame.Position = UDim2.fromOffset(dx, cy)
	acceptBtn.frame.Position = UDim2.fromOffset(dx - 8 - bw, cy)
	local hw = Ui.measure(hintStr)
	hintText:move(w - D.padX - hw, cy + 8)
	hintKey:move(w - D.padX - hw - 12, cy + 6)
	-- 고르는 말의 줄 · 띠 · 누르는 판
	for r = 1, D.lines do
		local ty = D.padY + (r - 1) * LINE
		menuRows[r]:move(D.padX + 8, ty)
		menuHits[r].Position = UDim2.fromOffset(D.padX - 4, ty - 3)
		menuHits[r].Size = UDim2.fromOffset(w - D.padX * 2 + 8, LINE)
	end
	if menuItems then
		menuBar.Position = UDim2.fromOffset(D.padX - 4, D.padY + (menuSel - 1) * LINE - 3)
		menuBar.Size = UDim2.fromOffset(w - D.padX * 2 + 8, LINE)
	end
end

-- 고르는 말을 그린다(줄 · 고른 줄의 띠) — 고르는 중이 아니면 모두 감춘다
local function paintMenu()
	for r = 1, D.lines do
		local item = menuItems and menuItems[r]
		menuRows[r]:set(if item then item.text else "")
		if item then
			menuRows[r]:color(item.color or C.text)
		end
		menuRows[r]:show(item ~= nil)
		menuHits[r].Visible = item ~= nil
	end
	menuBar.Visible = menuItems ~= nil
end

-- 대사를 나온 글자까지 그린다(줄은 다 나왔을 때의 자리 그대로 — 한 글자씩 나와도 줄이 바뀌거나 출렁이지 않는다)
local function paintText(shown: number)
	if menuItems then -- 고르는 말: 대사 줄은 비운다(줄마다 고를 것이 선다)
		for r = 1, D.lines do
			for k = 1, MAX_SEGS do
				rows[r][k]:set("")
				rows[r][k]:show(false)
			end
		end
		return
	end
	local segs = Format.talkSegments(curText, fitted, shown)
	for r = 1, D.lines do
		local list = segs[r] or {}
		local cx = D.padX
		local ty = D.padY + (r - 1) * LINE
		for k = 1, MAX_SEGS do
			local item = rows[r][k]
			local seg = list[k]
			if seg and k == MAX_SEGS and #list > MAX_SEGS then -- 조각이 너무 많으면 나머지를 이 조각에 붙인다(색은 앞의 것)
				local rest = {}
				for q = k, #list do
					table.insert(rest, list[q].t)
				end
				seg = { t = table.concat(rest), key = false }
			end
			if seg then
				item:set(seg.t)
				item:color(if seg.key then C.accent else C.text)
				item:move(cx, ty)
				item:show(true)
				cx += Ui.measure(seg.t, "body")
			else
				item:set("")
				item:show(false)
			end
		end
	end
end

local function full(): boolean
	return drawn >= total
end

-- 말이 다 나왔을 때의 아래 줄
local function paintFoot()
	local last = Talk.index >= #lines
	local done = full()
	local offer = done and last and endHint == "수락"
	acceptBtn.frame.Visible = offer
	declineBtn.frame.Visible = offer
	hintStr = if menuItems then "고르기" elseif Talk.npc == Talk.CINE then "다음" elseif last and endHint then endHint elseif last then "닫기" else "다음" -- 장면의 말은 늘 「다음」(장면이 이어진다)
	hintText:set(hintStr)
	hintText:color(if last and endHint then C.accent else C.dim)
	layout() -- 자리를 먼저 놓고(키 딱지는 자리를 옮기면 다시 보인다) 보일지를 정한다
	hintText:show(done and not offer)
	hintKey.frame.Visible = done and not offer
end

-- 말 앞의 「@id 」: 그 사람의 이름과 뗀 말(없으면 nil과 그 말 그대로)
function Talk.speaker(text: string): (string?, string)
	local id, rest = string.match(text, "^@(%w+) (.*)$")
	if id then
		return (Talk.nameOf and Talk.nameOf(id)) or id, rest
	end
	return nil, text
end

local function show()
	local who, text = Talk.speaker(lines[Talk.index] or "")
	curText = text
	nameStr = who or baseName
	nameText:set(nameStr)
	fitted = string.split(pixelText.Fit(text, Talk.TEXT_W, D.lines, "body"), "\n")
	total = 0
	for _, ln in fitted do
		total += utf8len(ln)
	end
	started, drawn = os.clock(), -1
	if not box.Visible and Talk.onToggle then
		Talk.onToggle(Talk.npc)
	end
	box.Visible = true
	layoutKey = ""
	Talk.place()
end

-- 매 화면: 글자를 한 글자씩 내보내고, 화면 틀이 바뀌었으면 다시 놓고, 혼잣말 말풍선은 그 주민을 따라간다
function Talk.place()
	if box and box.Visible then
		local key = Stage.uiW .. "x" .. Stage.uiH
		if key ~= layoutKey then
			layoutKey = key
			paintFoot() -- 다시 놓고 아래 줄의 보임도 다시 정한다
		end
		local shown = math.min(total, math.floor((os.clock() - started) * D.cps))
		if shown ~= drawn then
			drawn = shown
			paintText(shown)
			paintFoot()
		end
	end
	if chat and chat.Visible then
		if os.clock() > chatTill or not chatNpc or chatNpc == Talk.npc then
			chat.Visible, chatNpc = false, nil
		else
			local cx = Overlay.x(chatNpc.x)
			local bottom = Overlay.y(chatNpc.y - (chatNpc.h or 24) - B.up)
			local left = math.clamp(cx - math.floor(chatSize.w / 2), 8, math.max(8, Stage.uiW - chatSize.w - 8))
			chat.Position = UDim2.fromOffset(left, bottom - chatSize.h - B.tail)
			chatTail.Position = UDim2.fromOffset(math.clamp(cx - left - 4, 6, chatSize.w - 15), chatSize.h - 1)
		end
	end
end

-- 말을 시작한다. questName = 이름표 뒤의 퀘스트 이름 · finish = 마지막 말 뒤에 일어날 일 · finishHint = 그 일의 이름(「수락」이면 「수락 · 거절」 단추, 「완료」면 「↑ 완료」)
function Talk.start(npc, list: { string }, questName: string?, finish: (() -> ())?, finishHint: string?)
	-- 고르는 말이 떠 있던 중에 다른 말(장면 · 이야기)이 오면 고르는 말을 걷는다 — 남아 있으면 말이 비고 다음 ↑가 옛 고르기를 했다(2026-10-18 검토)
	if menuItems then
		menuItems, menuPick = nil, nil
		paintMenu()
	end
	Talk.npc, Talk.index = npc, 1
	lines, onEnd, endHint = list, finish, finishHint
	baseName = npc.name or npc.id or ""
	nameStr = baseName
	nameText:set(nameStr)
	titleText:set(questName or "")
	if chatNpc == npc then
		chat.Visible, chatNpc = false, nil
	end
	show()
end

-- 장면(퀘스트 연출)의 한 말: name = 이름표(nil이면 이름표 없이 — 속마음) · text = 말. text가 nil이면 닫는다. 넘기는 것은 장면이 한다(Talk.cineFull · Talk.cineReveal)
function Talk.cine(name: string?, text: string?)
	if not text then
		if Talk.npc == Talk.CINE then
			Talk.close()
		end
		return
	end
	Talk.CINE.name = name or ""
	Talk.start(Talk.CINE, { text }, nil, nil, nil)
end
function Talk.cineFull(): boolean
	return full()
end
function Talk.cineReveal()
	started = os.clock() - 999
	Talk.place()
end

-- 고르는 말을 띄운다(2026-10-18): items = { { text, color } }(D.lines개까지 — 넘는 것은 버린다) · onPick(i) = 고른 줄
--  ↓ = 다음 줄(Talk.menuMove) · ↑ · 스페이스 = 고른다(Talk.next) · 줄을 누르면 그것 · X · Esc = 닫기
function Talk.menu(npc, items: { any }, onPick: (number) -> ())
	local list = {}
	for i = 1, math.min(#items, D.lines) do
		list[i] = items[i]
	end
	menuItems, menuPick, menuSel = list, onPick, 1
	Talk.npc, Talk.index = npc, 1
	lines, onEnd, endHint = { "" }, nil, nil
	baseName = npc.name or npc.id or ""
	nameStr = baseName
	nameText:set(nameStr)
	titleText:set("")
	if chatNpc == npc then
		chat.Visible, chatNpc = false, nil
	end
	paintMenu()
	show()
end

-- 고르는 중인가 · 고른 줄(자동 검사가 본다)
function Talk.inMenu(): boolean
	return menuItems ~= nil
end
function Talk.menuSelected(): number
	return menuSel
end

-- 고른 줄을 옮긴다(d = 1 아래 · -1 위 — 끝에서는 처음으로)
function Talk.menuMove(d: number)
	if not menuItems or #menuItems == 0 then
		return
	end
	menuSel = ((menuSel - 1 + d) % #menuItems) + 1
	layout()
end

-- 지금 이 주민과 말하는 중인가
function Talk.with(npc): boolean
	return Talk.npc == npc and Talk.index > 0
end

-- 다음 말로: 나오는 중이면 그 말을 한 번에 다 보이고, 다 나왔으면 다음 말(마지막 말 뒤에는 그 일 — 수락 · 완료). 말하는 중이 아니면 그 주민의 평소 말을 시작한다. 대화가 끝났으면 false
function Talk.next(npc): boolean
	if menuItems and Talk.npc == npc then -- 고르는 말: 고른 줄의 일을 한다(그 일이 새 말을 시작한다)
		local pick, i = menuPick, menuSel
		Talk.close()
		if pick then
			pick(i)
		end
		return true
	end
	if Talk.npc ~= npc then
		Talk.start(npc, npc.lines)
		return true
	end
	if not full() then
		started = os.clock() - 999
		Talk.place()
		return true
	end
	if Talk.index >= #lines then
		local finish = onEnd
		Talk.close()
		if Talk.onFinish then
			Talk.onFinish(npc)
		end
		if finish then
			finish()
		end
		return false
	end
	Talk.index += 1
	show()
	return true
end

-- 「수락」 단추(↑ · 스페이스와 같다)
function Talk.accept()
	if Talk.npc then
		Talk.next(Talk.npc)
	end
end

-- 「거절」 단추 · X · Esc: 나오는 중이면 그 말을 다 보이고, 다 나왔으면 아무 일도 하지 않고 닫는다(다시 말을 걸면 또 권한다)
function Talk.decline()
	if not Talk.npc then
		return
	end
	if not full() then
		started = os.clock() - 999
		Talk.place()
		return
	end
	Talk.close()
end

function Talk.close()
	Talk.npc, Talk.index = nil, 0
	lines, onEnd, endHint = {}, nil, nil
	if menuItems then
		menuItems, menuPick = nil, nil
		if menuBar then
			paintMenu()
		end
	end
	if box then
		if box.Visible and Talk.onToggle then
			Talk.onToggle(nil)
		end
		box.Visible = false
	end
end

-- 혼잣말: 그 주민 머리 위에 한 줄(단추 · 안내 없이) — seconds초 뒤에 사라진다. 대화창으로 말하는 주민은 혼잣말을 하지 않는다
function Talk.say(npc, text: string, seconds: number?)
	if not chat or npc == Talk.npc then
		return
	end
	chatBody:set(text)
	local fittedChat = pixelText.Fit(text, B.textW, B.lines, "body")
	local tw = pixelText.Measure(fittedChat, "body")
	local count = #string.split(fittedChat, "\n")
	local w = math.max(tw, 60) + B.padX * 2
	local h = (count - 1) * LINE + 14 + B.padY * 2
	chatSize.w, chatSize.h = w, h
	chatBack.Size = UDim2.fromOffset(w, h + 2)
	chat.Size = UDim2.fromOffset(w, h + B.tail)
	chatNpc, chatTill = npc, os.clock() + (seconds or Format.IDLE.show)
	chat.Visible = true
	Talk.place()
end

-- 혼잣말 말풍선을 바로 거둔다 — 장면(맵)을 바꿀 때(2026-10-15 사용자: "npc 가 혼잣말 하는데 다음포탈로 넘어가면 그 말풍선이 그대로 있는 문제" —
--  말풍선은 화면 틀의 층에 있어 맵을 지워도 남고, 시간이 다 될 때까지 옛 주민의 자리에 떠 있었다)
function Talk.hush()
	if chat then
		chat.Visible, chatNpc, chatTill = false, nil, 0
	end
end

-- 지금 혼잣말을 하는 주민(없으면 nil)
function Talk.saying(): any
	return if chat and chat.Visible then chatNpc else nil
end

-- 대화창의 자리(화면 틀의 점 — 자동 검사 · 터치가 쓴다)
function Talk.rect(): (number, number, number, number)
	return dims()
end

return Talk

end
MODULES['Client/lune/ui/tomeWindow'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 모험의 서 창 — 메뉴 → 「모험의 서」(2026-10-16 · 2편 — 로스트아크의 모험의 서. 칸 · 보상은 제 제안: 공방 design/city.js의 TOME).
--  곳마다 한 장(탭 — 은달 항구 · 수정 숲): 「○○ 모험의 서」와 채운 % · 띠 / 칸 다섯(퀘스트 · 호감도 · 몬스터 · 달조각 · 숨은 이야기 — 띠와 n/N) /
--  보상 다섯(10 · 30 · 50 · 70 · 100%: 그림 · 「받기」 · 「받음」 · 「n%에서」) / 그곳 몬스터의 잡은 수(종류마다 100마리까지 — 두 줄로).
--  받는 것은 서버가 한다(ctx.bondDo → Bond "tome"). 셈은 shared/lune/sim/bond.luau(Bond.area). 화면 오른쪽의 옆 판(ui/windows.luau).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Bond = require(lune.sim.bond)
local Gift = require(lune.sim.gift)
local Format = require(lune.ui.format)
local Layout = require(lune.ui.layout)
local COMBAT = require(lune.data["combat.generated"])
local Ui = require(script.Parent.ui)

local C = Ui.COLOR
local S = Layout.TOME
local D = Bond.DATA
local W = D.tome.words
local PARTS = { "quest", "mob", "shard", "story" } -- (호감도는 2026-10-16에 뺐다)
local GW = { money = "달돈 {n}", dust = "달가루 {n}", potion = "물약 {n}병", scroll = "귀환 주문서 {n}장" }

local TomeWindow = {}
local MOBS = 0
for _, a in D.tome.areas do
	MOBS = math.max(MOBS, #a.mobs)
end

function TomeWindow.size(): (number, number)
	return S.w, S.mobY + math.ceil(MOBS / 2) * S.mobRow + 4
end

-- 보상 칸의 그림(첫 것): 아이템이면 그 그림, 아니면 달가루 · 달돈 · 귀환 주문서 · 물약
function TomeWindow.rewardIcon(give): (string, string)
	for _, id in Gift.items(nil, { items = give.items }) do
		return id[1], tostring(id[2])
	end
	local icon, n = Gift.icon(give)
	return icon, Format.short(n)
end

function TomeWindow.build(body: Frame, ctx, w: number, _h: number)
	local view = {}
	local area = 1
	local note, noteTone = nil, nil
	local waiting = false -- 답을 기다리는 중(두 번 눌러 두 번 가지 않게 — 2026-10-18 검토)
	local tabs = {}
	local tx = 0
	for i, a in D.tome.areas do
		local item = Ui.tab(body, a.name, tx, 0, function()
			if area ~= i then
				area = i
				note = nil
				view.refresh()
			end
		end)
		item.frame.Name = "Tab_" .. a.id
		tabs[i] = item
		tx += item.width + 14
	end
	local head = Ui.text(body, "", 0, S.headY, w, { font = "body" })
	local pct = Ui.text(body, "", 0, S.headY, w, { font = "body", align = "right", color = C.gold })
	local bar = Ui.bar(body, 0, S.barY, w, S.barH, C.gold, C.panel2)
	local parts = {}
	for i, key in PARTS do
		local y = S.partY + (i - 1) * S.partRow
		parts[key] = {
			name = Ui.text(body, W.part[key], 0, y + 2, S.partBarX - 4, {}),
			bar = Ui.bar(body, S.partBarX, y + 6, S.partBarW, 4, C.accent, C.panel2),
			count = Ui.text(body, "", 0, y + 2, w, { align = "right", color = C.dim }),
		}
	end
	Ui.line(body, 0, S.rewardY - 6, w)
	local cellW = math.floor(w / #D.tome.rewards)
	local rewards = {}
	for i, r in D.tome.rewards do
		local x = (i - 1) * cellW
		local ru = {}
		ru.label = Ui.text(body, Format.fill(W.pct, { n = r.pct }), x, S.rewardY, cellW - 4, { align = "center", color = C.dim })
		local icon, num = TomeWindow.rewardIcon(r.give)
		ru.icon = Ui.smallIcon(body, icon, x + math.floor(cellW / 2) - 9, S.rewardY + 14)
		ru.num = Ui.text(body, num, x, S.rewardY + 24, math.floor(cellW / 2) + 18, { align = "right", outline = true })
		ru.take = Ui.button(body, W.take, x + 4, S.rewardY + S.rewardH - 22, cellW - 8, function()
			if waiting then
				return
			end
			waiting = true
			local res = ctx.bondDo("tome", D.tome.areas[area].id, r.pct)
			waiting = false
			note, noteTone = nil, nil
			if res and res.why then
				note, noteTone = res.why, C.red
			elseif res and res.note and res.note.reward then
				note, noteTone = Gift.text(res.note.reward, GW), C.green
			end
			view.refresh()
		end, { main = true, h = 20 })
		ru.take.frame.Name = "Take_" .. r.pct
		ru.state = Ui.text(body, "", x, S.rewardY + S.rewardH - 18, cellW - 4, { align = "center", color = C.dim })
		rewards[i] = ru
	end
	local noteText = Ui.text(body, "", 0, S.rewardY + S.rewardH + 2, w, { color = C.dim })
	local mobRows = {}
	for i = 1, MOBS do
		local col, row = (i - 1) % 2, math.floor((i - 1) / 2)
		mobRows[i] = Ui.text(body, "", col * math.floor(w / 2), S.mobY + row * S.mobRow, math.floor(w / 2) - 6, { color = C.dim })
	end

	function view.refresh()
		local v = ctx.bond()
		for i, t in tabs do
			t:setOn(i == area)
		end
		local a = D.tome.areas[area]
		local av = nil
		for _, x in (v and v.tome) or {} do
			if x.id == a.id then
				av = x
			end
		end
		head:set(("%s · %s"):format(a.name, W.title))
		local p = if av then av.pct else 0
		pct:set(Format.fill(W.pct, { n = p }))
		bar:set(p / 100)
		for _, key in PARTS do
			local pu, have = parts[key], (av and av.parts[key]) or { 0, 0 }
			pu.bar:set(if have[2] > 0 then have[1] / have[2] else 0)
			pu.bar:setColor(if have[2] > 0 and have[1] >= have[2] then C.green else C.accent)
			pu.count:set(if have[2] > 0 then Format.fill(W.count, { a = have[1], b = have[2] }) else W.none)
			pu.name:color(if have[2] > 0 then C.text else C.dim)
		end
		for i, r in D.tome.rewards do
			local ru = rewards[i]
			local got = av and av.got[tostring(r.pct)]
			local can = av ~= nil and p >= r.pct and not got
			ru.take.frame.Visible = can
			ru.state:show(not can)
			ru.state:set(if got then W.got else Format.fill(W.locked, { n = r.pct }))
			ru.state:color(if got then C.green else C.dim)
			ru.label:color(if p >= r.pct then C.gold else C.dim)
		end
		noteText:set(note or (if v and not v.open then "모험의 서는 은달 항구의 안내인 바람이 건넨다" else ""))
		noteText:color(noteTone or C.dim)
		for i, tu in mobRows do
			local kind = a.mobs[i]
			tu:show(kind ~= nil)
			if kind then
				local n = (v and v.kill[kind]) or 0
				local mob = COMBAT.mobs[kind]
				tu:set(Format.fill(W.mobRow, { name = if mob then mob.name else kind, a = n, b = D.tome.mobNeed }))
				tu:color(if n >= D.tome.mobNeed then C.green else C.dim)
			end
		end
	end
	if ctx.bondFetch then
		ctx.bondFetch()
	end
	view.refresh()
	return view
end

return TomeWindow

end
MODULES['Client/lune/ui/ui'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 화면 틀의 부품 — 판 · 칸 · 단추 · 키 딱지 · 띠 · 글 · 그림. 화면의 고운 격자(client/lune/stage.luau의 ui 층 — 1080p에서 960x540)에 놓는다.
--  방식은 산나비 계열 도트 게임(사용자 2026-10-07: "제가말하는건 산나비같은 도트게임을말하는거에요" → 실제 크기 시안을 보고 "훌룡합니다"):
--   판은 무채색에 강조색 하나(민트), 고른 것의 표시는 민트 테두리 한 가지. 늘 보이는 글은 판 없이 어두운 테두리를 두른 글씨로 게임 화면 위에 바로 적는다.
--   글씨는 둘뿐: 작은 글씨(small = 갈무리9 — 화면에서 20픽셀)와 본문 글씨(body = 갈무리11 — 24픽셀, 이름 · 말 · 제목).
--   그림은 둘: 화면의 것(창을 여는 단추 · 기술 칸 · 버프)은 24x24(pic), 게임 세계의 것(장비 — 땅에 떨어진 것과 같은 그림)은 게임의 굵은 도트 그대로(worldIcon).
--  부품 그림 한 장(ui_kit.png)과 그 자리 · 색 · 치수는 shared/lune/data/kit.generated.luau — 공방의 tools/build_lune_ui.mjs가 짓는다(시안 tools/preview_lune_ui_hd.mjs와 같은 그리기).
--  글은 칸을 넘지 않게 폭(width)을 꼭 준다.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local KIT = require(lune.data["kit.generated"])
local ASSETS = require(lune.data["assets.generated"])
local Layout = require(lune.ui.layout) -- 창과 칸의 치수(자동 검사가 같은 값을 본다)
local pixelText = require(script.Parent.Parent.Parent.modules.ui.pixelText)
local Stage = require(script.Parent.Parent.stage)

local Ui = {}
Ui.IMAGE = ASSETS[KIT.image] or ""
Ui.M = KIT.ui.metric
local M = Ui.M
local PARTS = KIT.parts

-- 글자판을 글씨 모듈에 알린다: 작은 글씨 · 테두리를 두른 작은 글씨와 본문 글씨(본문 글씨의 맨 글자판은 글씨 모듈이 이미 갖고 있다)
for _, key in { "small", "small_o", "body_o" } do
	local meta = KIT.font[key]
	local pages = {}
	for i, file in meta.files do
		pages[i] = ASSETS[file] or ""
	end
	pixelText.Register(key, meta, pages)
end

Ui.COLOR = {}
for name, c in KIT.ui.colors do
	Ui.COLOR[name] = Color3.fromRGB(c[1], c[2], c[3])
end
local C = Ui.COLOR
Ui.PANEL_ALPHA = 1 - M.panelAlpha / 255 -- 판은 조금 비친다(그림에 이미 들어 있다 — 빈 틀로 같은 판을 만들 때 쓴다)
Ui.TIER = { [0] = C.tier0, C.tier1, C.tier2, C.tier3, C.tier4 } -- 등급의 이름 색(낡은 · 허름한 · 보통 · 좋은 · 빼어난)

-- 글씨의 이름: font = "small" | "body", outline = 테두리를 두른 것
local function fontOf(font: string?, outline: boolean?): string
	local base = font or "small"
	return if outline then base .. "_o" else base
end

function Ui.measure(text: string, font: string?): number
	return (pixelText.Measure(text, font or "small"))
end

-- ---------- 빈 틀 · 색 상자 ----------
function Ui.box(parent: Instance, x: number, y: number, w: number, h: number, color: Color3?, alpha: number?): Frame
	local f = Instance.new("Frame")
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	f.BackgroundColor3 = color or C.panel
	f.BackgroundTransparency = alpha or 0
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end

-- 스크롤하는 칸: 속(contentH)이 칸(h)보다 길면 세로로 스크롤한다(마우스 휠 · 손가락으로 끌기). 오른쪽 끝에 가는 민트 막대(barW점)가 지금 자리를 보여 준다.
--  속이 칸보다 짧으면 막대도 스크롤도 없다(그냥 틀). 안에 놓는 것의 좌표는 속의 위에서부터
Ui.SCROLL_IMAGE = "rbxasset://textures/ui/Scroll/scroll-middle.png"
function Ui.scroll(parent: Instance, x: number, y: number, w: number, h: number, contentH: number, barW: number?): ScrollingFrame
	local f = Instance.new("ScrollingFrame")
	local long = contentH > h
	f.Name = "Scroll"
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	f.CanvasSize = UDim2.fromOffset(0, math.max(h, contentH))
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.ScrollingDirection = Enum.ScrollingDirection.Y
	f.ScrollingEnabled = long
	f.ScrollBarThickness = if long then barW or 3 else 0
	f.ScrollBarImageColor3 = C.accent
	f.ScrollBarImageTransparency = 0.15
	f.TopImage, f.MidImage, f.BottomImage = Ui.SCROLL_IMAGE, Ui.SCROLL_IMAGE, Ui.SCROLL_IMAGE -- 모서리가 둥글지 않은 곧은 막대
	f.VerticalScrollBarInset = Enum.ScrollBarInset.None
	f.ElasticBehavior = Enum.ElasticBehavior.Never
	f.Parent = parent
	return f
end

function Ui.group(parent: Instance, x: number, y: number, w: number, h: number, name: string?): Frame
	local f = Ui.box(parent, x, y, w, h, C.panel, 1)
	if name then
		f.Name = name
	end
	return f
end

-- ---------- 그림 ----------
local function image(parent: Instance, name: string, x: number, y: number, w: number, h: number): ImageLabel
	local label = Instance.new("ImageLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.ResampleMode = Enum.ResamplerMode.Pixelated
	label.Image = Ui.IMAGE
	label.Position = UDim2.fromOffset(x, y)
	label.Size = UDim2.fromOffset(w, h)
	label.Parent = parent
	return label
end

-- 그림의 속을 다른 부품으로 바꾼다(단추에 마우스를 올렸을 때 · 칸을 골랐을 때)
function Ui.swap(label: ImageLabel, name: string)
	local p = PARTS[name]
	assert(p, "없는 부품 " .. tostring(name))
	label.ImageRectOffset = Vector2.new(p.x, p.y)
	label.ImageRectSize = Vector2.new(p.w, p.h)
	if p.m then
		label.ScaleType = Enum.ScaleType.Slice
		label.SliceCenter = Rect.new(p.m, p.m, p.w - p.m, p.h - (p.mb or p.m))
	end
end

-- 부품 하나. w · h를 주면 그 크기로 늘인다(가장자리는 그대로 두고 가운데만 — 아홉 조각)
function Ui.part(parent: Instance, name: string, x: number, y: number, w: number?, h: number?): ImageLabel
	local p = PARTS[name]
	assert(p, "없는 부품 " .. tostring(name))
	local label = image(parent, name, x, y, w or p.w, h or p.h)
	Ui.swap(label, name)
	return label
end

-- 화면의 그림(24x24): 창을 여는 단추 · 기술 칸 · 버프. 이름은 공방의 아이콘 이름 — 없는 이름이면 빈 그림
function Ui.setPic(label: ImageLabel, name: string?)
	local sheet = PARTS.pics
	local at = name and sheet.icons[name]
	label.Visible = at ~= nil
	if at then
		label.ImageRectOffset = Vector2.new(sheet.x + at[1], sheet.y + at[2])
		label.ImageRectSize = Vector2.new(sheet.size, sheet.size)
	end
end

function Ui.hasPic(name: string): boolean
	return PARTS.pics.icons[name] ~= nil
end

function Ui.pic(parent: Instance, name: string?, x: number, y: number): ImageLabel
	local label = image(parent, "Pic", x, y, PARTS.pics.size, PARTS.pics.size)
	Ui.setPic(label, name)
	return label
end

-- 게임 세계의 그림(18x18 — 장비 · 돈 · 달가루)을 게임과 같은 굵은 도트로, 칸(x, y, 한 변 s)의 한가운데에 놓는다.
--  화면 틀의 배율이 바뀌면(창 크기가 달라지면) 크기를 다시 맞춘다
local worldIcons = setmetatable({}, { __mode = "k" }) -- [그림] = { x, y, s }
local function fitWorldIcon(label: ImageLabel, at)
	local side = PARTS.icons.size * Stage.ratio
	label.Size = UDim2.fromOffset(side, side)
	label.Position = UDim2.fromOffset(at.x + math.floor((at.s - side) / 2), at.y + math.floor((at.s - side) / 2))
end
function Ui.setWorldIcon(label: ImageLabel, name: string?)
	local sheet = PARTS.icons
	local at = name and sheet.icons[name]
	label.Visible = at ~= nil
	if at then
		label.ImageRectOffset = Vector2.new(sheet.x + at[1], sheet.y + at[2])
		label.ImageRectSize = Vector2.new(sheet.size, sheet.size)
	end
end
function Ui.worldIcon(parent: Instance, name: string?, x: number, y: number, s: number): ImageLabel
	local label = image(parent, "Icon", x, y, 1, 1)
	local at = { x = x, y = y, s = s }
	worldIcons[label] = at
	fitWorldIcon(label, at)
	Ui.setWorldIcon(label, name)
	return label
end
-- 글 옆에 붙이는 작은 그림(돈 · 달가루): 같은 그림을 화면 틀의 격자에 그대로(18x18점)
function Ui.smallIcon(parent: Instance, name: string, x: number, y: number): ImageLabel
	local label = image(parent, "Icon", x, y, PARTS.icons.size, PARTS.icons.size)
	Ui.setWorldIcon(label, name)
	return label
end
Stage.onResize(function()
	for label, at in worldIcons do
		if label.Parent then
			fitWorldIcon(label, at)
		end
	end
end)

-- ---------- 판 ----------
-- 어두운 판(창 · 알림 · 채팅을 쓸 때의 바탕). 돌려주는 것은 그 자리의 빈 틀 — 그 안에 내용을 놓는다
function Ui.panel(parent: Instance, x: number, y: number, w: number, h: number): Frame
	local outer = Ui.group(parent, x, y, w, h, "Panel")
	Ui.part(outer, "uPanel", 0, 0, w, h).Name = "Back"
	return outer
end

-- ---------- 글 ----------
-- 글. width = 이 글이 쓸 수 있는 폭(넘으면 줄을 바꾸고, lines를 넘으면 …로 줄인다). opts.align = "left" | "center" | "right"(그 폭 안에서)
--  opts.font = "small"(기본) · "body" / opts.outline = 어두운 테두리(판 없이 게임 화면 위에 적는 글) / opts.color / opts.lines / opts.line(줄 간격) / opts.z
function Ui.text(parent: Instance, text: string, x: number, y: number, width: number, opts)
	opts = opts or {}
	local label = pixelText.new(parent, {
		Text = text,
		Font = fontOf(opts.font, opts.outline),
		Color = opts.color or C.text,
		Align = opts.align or "left",
		MaxWidth = width,
		MaxLines = opts.lines or 1,
		Line = opts.line,
		ZIndex = opts.z,
	})
	local item = { label = label, x = x, y = y, width = width, align = opts.align or "left" }
	local function place()
		local px = item.x
		if item.align == "center" then
			px = item.x + math.floor((item.width - label.Width) / 2)
		elseif item.align == "right" then
			px = item.x + item.width - label.Width
		end
		label.Frame.Position = UDim2.fromOffset(px, item.y)
	end
	function item.set(_, value: string)
		label:SetText(value)
		place()
	end
	function item.color(_, color: Color3)
		label:SetColor(color)
	end
	function item.move(_, nx: number, ny: number)
		item.x, item.y = nx, ny
		place()
	end
	function item.show(_, on: boolean)
		label.Frame.Visible = on
	end
	-- 지금 그려진 글의 폭 · 높이
	function item.size(_): (number, number)
		return label.Width, label.Height
	end
	function item.destroy()
		label:Destroy()
	end
	place()
	return item
end

-- 장비의 별(스타포스 — 2026-10-15): 한 줄에 15개(다섯마다 띄운다), 붙은 별은 노랑 · 아직 안 붙은 별은 흐리게. (x, y) = 왼쪽 위 · width = 폭(align "center"면 그 가운데에).
--  돌려주는 것 { set(n, max), height(max) } — 셈은 shared/lune/ui/starText.luau
function Ui.stars(parent: Instance, x: number, y: number, width: number, align: string?)
	local StarText = require(lune.ui.starText)
	local rowH = Layout.DETAIL.starRow
	local rows = {}
	for r = 1, 2 do
		rows[r] = {
			on = Ui.text(parent, "", x, y + (r - 1) * rowH, width, { color = C.gold }),
			off = Ui.text(parent, "", x, y + (r - 1) * rowH, width, { color = C.off }),
		}
	end
	local item = { rows = rows }
	function item.set(_, n: number, max: number)
		local list = StarText.rows(n, max)
		for r, row in rows do
			local t = list[r]
			local on, off = if t then t.on else "", if t then t.off else ""
			local x0 = if align == "center" then x + math.floor((width - Ui.measure(on .. off)) / 2) else x
			row.on:set(on)
			row.on:move(x0, y + (r - 1) * rowH)
			row.off:set(off)
			row.off:move(x0 + (if on == "" then 0 else Ui.measure(on)), y + (r - 1) * rowH)
		end
	end
	return item
end

-- 이름표: 판 없이 테두리를 두른 작은 글(발밑의 이름 · 문 위의 글). 글씨 모듈의 글(Frame · Width · SetText · SetColor · Destroy)처럼 쓴다
Ui.TAG_H = M.small + 3 -- 이름표 한 줄이 차지하는 높이(쌓을 때 쓴다)
--  plate = true: 플레이어(나 · 다른 사람)의 이름표 — 어두운 판에 민트의 가는 테두리를 두른다(data/ui.generated.luau의 layout.tag.plate).
--   사용자 2026-10-08: "닉네임 표시되는게 그냥 닉네임하얀글씨로 표시되는게 아니라 얇은 우리게임 민트색 테두리같은게 있으면 좋을거같네요". 주민(노랑 글) · 졸개의 이름표는 판이 없다.
--   같은 날 글자 둘레에 민트를 두르는 방식("이름 글씨만 있는데 글자 그자체 테두리에 민트 테두리")으로 바꿔 봤다가 되돌렸다 — "생각보다 별로네요 이전방식으로 롤백".
function Ui.tag(parent: Instance, text: string, color: Color3?, maxWidth: number?, plate: boolean?)
	local label = pixelText.new(parent, { Text = text, Font = "small_o", Color = color or C.text, MaxWidth = maxWidth or 220, MaxLines = 1 })
	label.Frame.Name = "Tag"
	if plate then
		local P = Layout.TAG.plate
		local box = Instance.new("Frame")
		box.Name = "Plate"
		box.BackgroundColor3 = C.ink
		box.BorderSizePixel = 0
		box.ZIndex = 1 -- 글씨(틀 안에서 5부터) 아래
		box.Parent = label.Frame
		local stroke = Instance.new("UIStroke")
		stroke.Color = C.accent
		stroke.Thickness = 1
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.LineJoinMode = Enum.LineJoinMode.Miter
		stroke.Parent = box
		-- 글이 바뀌면 판도 그 폭에 맞춘다(빈 글이면 숨긴다)
		local function fit()
			local w = label.Frame.Size.X.Offset
			box.Visible = w > 0
			box.Position = UDim2.fromOffset(-P.padX, -P.padY)
			box.Size = UDim2.fromOffset(w + P.padX * 2, M.small + P.padY * 2)
		end
		label.Frame:GetPropertyChangedSignal("Size"):Connect(fit)
		fit()
	end
	return label
end

-- ---------- 누르는 것 ----------
function Ui.hit(parent: Instance): TextButton
	local hit = Instance.new("TextButton")
	hit.Name = "Hit"
	hit.Text = ""
	hit.BackgroundTransparency = 1
	hit.Size = UDim2.fromScale(1, 1)
	hit.ZIndex = 9
	hit.Parent = parent
	return hit
end

-- 글을 적는 칸(틀 + Roblox의 글자 입력 칸 — 경매장의 값 · 찾기). 돌려주는 것: 입력 칸(TextBox — .Text를 읽고, 바뀐 것은 GetPropertyChangedSignal("Text")로 듣는다)
--  적는 글은 Roblox의 글씨다(도트 글씨는 그려서 찍는 것이라 입력 칸에 쓸 수 없다 — 처음 화면의 이름 칸과 같다)
function Ui.field(parent: Instance, x: number, y: number, w: number, h: number, placeholder: string): TextBox
	local frame = Ui.group(parent, x, y, w, h, "Field")
	Ui.part(frame, "uField", 0, 0, w, h)
	local box = Instance.new("TextBox")
	box.Name = "Input"
	box.BackgroundTransparency = 1
	box.Position = UDim2.fromOffset(6, 0)
	box.Size = UDim2.new(1, -12, 1, 0)
	box.Font = Enum.Font.SourceSans
	box.TextSize = 12
	box.TextColor3 = C.text
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = C.off
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.ClearTextOnFocus = false
	box.Text = ""
	box.ZIndex = 6
	box.Parent = frame
	return box
end

-- 단추(높이 26 — 글 12와 위아래 여백 7). opts.main = 그 창에서 가장 하고 싶은 일(민트로 칠한다 — 창마다 하나쯤) · opts.h = 다른 높이 · opts.font
--  onClick은 눌렀을 때(마우스 · 터치). 글은 단추 폭 안에 한 줄. 쓸 수 없을 때는 흐리게.
function Ui.button(parent: Instance, text: string, x: number, y: number, w: number, onClick: () -> (), opts)
	opts = opts or {}
	local h = opts.h or M.button
	local font = opts.font or (if h >= M.button then "body" else "small")
	local fh = if font == "body" then M.body else M.small
	local outer = Ui.group(parent, x, y, w, h, "Button")
	local item = { frame = outer, enabled = true, main = opts.main == true, hot = false }
	local back = Ui.part(outer, if item.main then "uBtnMain" else "uBtn", 0, 0, w, h)
	local label = Ui.text(outer, text, 3, math.floor((h - fh) / 2), w - 6, { align = "center", font = font, color = if item.main then C.ink else C.text })
	local function paint()
		if not item.enabled then
			Ui.swap(back, "uBtnOff")
			label:color(C.off)
		elseif item.main then
			Ui.swap(back, if item.hot then "uBtnMainHot" else "uBtnMain")
			label:color(C.ink)
		else
			Ui.swap(back, if item.hot then "uBtnHot" else "uBtn")
			label:color(C.text)
		end
	end
	local hit = Ui.hit(outer)
	hit.Activated:Connect(function()
		if item.enabled then
			onClick()
		end
	end)
	hit.MouseEnter:Connect(function()
		item.hot = true
		paint()
	end)
	hit.MouseLeave:Connect(function()
		item.hot = false
		paint()
	end)
	function item.setEnabled(_, on: boolean)
		if item.enabled ~= on then
			item.enabled = on
			paint()
		end
	end
	function item.setText(_, value: string)
		label:set(value)
	end
	function item.setMain(_, on: boolean)
		if item.main ~= on then
			item.main = on
			paint()
		end
	end
	return item
end

-- 닫기(×)
function Ui.closeButton(parent: Instance, x: number, y: number, onClick: () -> ()): ImageLabel
	local back = Ui.part(parent, "uClose", x, y)
	back.Name = "Close"
	local hit = Ui.hit(back)
	hit.Activated:Connect(onClick)
	hit.MouseEnter:Connect(function()
		Ui.swap(back, "uCloseHot")
	end)
	hit.MouseLeave:Connect(function()
		Ui.swap(back, "uClose")
	end)
	return back
end

-- 키 이름의 딱지(어두운 작은 딱지에 글자 — 칸 위 · 말풍선 아래). (cx, y) = 가운데 · 윗줄. 폭은 글에 맞춘다
Ui.KEY_H = M.key
function Ui.keycap(parent: Instance, text: string, cx: number, y: number)
	local outer = Ui.group(parent, cx, y, 1, M.key, "Key")
	local back = Ui.part(outer, "uKey", 0, 0, 8, M.key)
	local label = pixelText.new(outer, { Text = text, Font = "small", Color = C.text })
	label.Frame.Position = UDim2.fromOffset(4, 2)
	local item = { frame = outer, width = 0, cx = cx, y = y }
	local function fit()
		item.width = label.Width + 8
		outer.Size = UDim2.fromOffset(item.width, M.key)
		back.Size = UDim2.fromOffset(item.width, M.key)
		outer.Position = UDim2.fromOffset(item.cx - math.floor(item.width / 2), item.y)
		outer.Visible = label.Width > 0
	end
	function item.set(_, value: string)
		label:SetText(value)
		fit()
	end
	function item.move(_, ncx: number, ny: number)
		item.cx, item.y = ncx, ny
		fit()
	end
	function item.color(_, tint: Color3)
		label:SetColor(tint)
	end
	fit()
	return item
end

-- 칸(한 변 s). setOn(true) = 고른 것(민트 테두리)
function Ui.slot(parent: Instance, x: number, y: number, s: number)
	local outer = Ui.group(parent, x, y, s, s, "Slot")
	local back = Ui.part(outer, "uSlot", 0, 0, s, s)
	local item = { frame = outer, on = false }
	function item.setOn(_, on: boolean)
		if item.on ~= on then
			item.on = on
			Ui.swap(back, if on then "uSlotOn" else "uSlot")
		end
	end
	return item
end

-- ---------- 띠(게이지) ----------
-- 어두운 테두리 한 점 + 바탕(back — 빈 데의 색) + 채운 띠. set(0~1)
function Ui.bar(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, back: Color3?)
	local outer = Ui.box(parent, x, y, w, h, C.ink)
	outer.Name = "Bar"
	Ui.box(outer, 1, 1, w - 2, h - 2, back or C.ink).Name = "Empty"
	local fill = Ui.box(outer, 1, 1, w - 2, h - 2, color)
	fill.Name = "Fill"
	local item = { frame = outer, fill = fill }
	function item.set(_, ratio: number)
		fill.Size = UDim2.fromOffset(math.floor((w - 2) * math.clamp(ratio, 0, 1) + 0.5), h - 2)
	end
	function item.setColor(_, tint: Color3)
		fill.BackgroundColor3 = tint
	end
	return item
end

-- 가르는 줄(한 점)
function Ui.line(parent: Instance, x: number, y: number, w: number): Frame
	local f = Ui.box(parent, x, y, w, 1, C.line)
	f.Name = "Line"
	return f
end

-- ---------- 창 ----------
-- 장비 칸의 한 변: 장비 그림(게임의 굵은 도트 18개)에 사방으로 여백을 둔 크기 — 화면 틀의 배율에 따라 달라진다(1080p에서 50)
function Ui.cellSize(): number
	return Layout.cellFor(Stage.ratio)
end

-- 탭(글자만 — 고른 것은 민트 글씨에 밑줄). 돌려주는 것 { frame, width, setOn }
function Ui.tab(parent: Instance, text: string, x: number, y: number, onClick: () -> ())
	local w = Ui.measure(text)
	local outer = Ui.group(parent, x, y, w, 16, "Tab")
	local label = Ui.text(outer, text, 0, 0, w, { color = C.dim })
	local under = Ui.box(outer, 0, 13, w, 2, C.accent)
	under.Visible = false
	local item = { frame = outer, width = w, on = false }
	Ui.hit(outer).Activated:Connect(onClick)
	function item.setOn(_, on: boolean)
		if item.on ~= on then
			item.on = on
			label:color(if on then C.accent else C.dim)
			under.Visible = on
		end
	end
	return item
end

-- 창: 어두운 판 + 제목(본문 글씨) + 닫기(×) + 가르는 줄 + 속. (x, y, w, h)는 판의 자리.
--  속은 판에서 옆으로 pad(18), 위로 head(44) 안쪽이다. 돌려주는 것 { frame, body(속을 넣는 틀), w, h(속의 크기), setTitle }
Ui.WIN = { pad = Layout.WIN.pad, head = Layout.WIN.head, foot = Layout.WIN.foot, w = Layout.WIN.bodyW + Layout.WIN.pad * 2, gap = 8 }
function Ui.windowSize(bodyW: number, bodyH: number): (number, number)
	return bodyW + Ui.WIN.pad * 2, bodyH + Ui.WIN.head + Ui.WIN.foot
end
function Ui.window(parent: Instance, title: string, x: number, y: number, w: number, h: number, onClose: () -> ())
	local W = Ui.WIN
	local outer = Ui.panel(parent, x, y, w, h)
	outer.Name = "Window"
	local name = Ui.text(outer, title, W.pad, 13, w - W.pad * 2 - 20, { font = "body" })
	Ui.closeButton(outer, w - W.pad - 10, 13, onClose)
	Ui.line(outer, W.pad, 34, w - W.pad * 2)
	local body = Ui.group(outer, W.pad, W.head, w - W.pad * 2, h - W.head - W.foot, "Body")
	return { frame = outer, body = body, w = w - W.pad * 2, h = h - W.head - W.foot, setTitle = function(_, value: string)
		name:set(value)
	end }
end

return Ui

end
MODULES['Client/lune/ui/windows'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 창 관리 — 창을 열고 닫고, 한 번에 둘까지 화면의 오른쪽과 왼쪽에 하나씩 놓는다(넓은 창은 혼자 쓴다 — 가운데의 캐릭터는 늘 보인다). 창의 이름과 여는 키는 공방에서 정한 것(data/ui.generated.luau).
--  창은 화면 틀의 층(고운 격자)에 뜨는 오른쪽 옆 판이다 — 가운데의 캐릭터를 가리지 않는다(던그리드의 가방처럼. 사용자 2026-10-07의 시안 승인).
--  창마다 build(body, ctx, w, h, arg) → { refresh(me), destroy() } 꼴의 모듈을 등록한다. 서버가 내 상태를 다시 보내면 열려 있는 창을 고쳐 그린다.
--   창의 크기는 모듈의 size(arg) → 속의 폭 · 높이(없으면 기본). 장비 칸이 든 창은 칸의 크기(화면 틀의 배율을 따른다)로 정한다.
--  닫기는 ×나 여는 키를 한 번 더. (Esc는 Roblox가 제 메뉴에 쓴다 — 게임이 받지 못한다)
--  창은 처음부터 다 보이지 않는다 — 공방에서 정한 레벨(from)이 되어야 열린다(능력치 · 스킬은 Lv.2).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UI = require(ReplicatedStorage.shared.lune.data["ui.generated"])
local Layout = require(ReplicatedStorage.shared.lune.ui.layout)
local Stage = require(script.Parent.Parent.stage)
local Ui = require(script.Parent.ui)

local TOP, EDGE = Layout.WIN.top, Layout.WIN.edge -- 화면 위 · 옆 끝에서 띄우는 폭
local BODY_W, BODY_H = Ui.WIN.w - Ui.WIN.pad * 2, 300 -- 크기를 따로 정하지 않은 창의 속

local Windows = {}

local defs = {} -- [id] = { name, key, wide, size, build }
local open = {} -- 열린 차례대로 { id, win, view, arg, w, h, side("right" · "left") }
local root: Frame = nil
-- 닫기(X)를 누르는 자리: 창들보다, 그 위에 뜨는 다른 판(메뉴 · 놓을 것의 목록 · 손가락 단추)보다도 위의 층에 따로 둔다 —
--  창이 다른 것과 겹쳐도 닫기가 먼저 눌린다(사용자 2026-10-08: "겹쳐있을때 x 닫기버튼이 우선판정으로 눌려서 닫을수있어야합니다" — PC · 스마트폰 모두).
--  손가락으로도 누르기 쉽게 X 그림보다 넓게 받는다.
local closers: Frame = nil
local CLOSE_HIT = 40
local ctx = nil
local level = 1 -- 내 레벨(이 레벨에 열린 창만 쓴다)
Windows.extra = {} :: { [string]: boolean } -- 레벨과 상관없이 쓸 수 있는 창(튜토리얼의 꿈: Lv.1에도 가방 — 「가방 열기」 미션 · 2026-10-14)

-- 열린 창을 제 쪽 끝에 놓는다: 오른쪽 창은 화면 오른쪽 끝에, 왼쪽 창은 왼쪽 끝에(가운데의 캐릭터를 가리지 않는다)
local function layout()
	for _, o in open do
		if o.side == "left" then
			o.holder.Position = Stage.atPosition("tl", EDGE, TOP)
		else
			o.holder.Position = Stage.atPosition("tr", Stage.REF_W - EDGE - o.w, TOP)
		end
		if o.closer then
			-- X 그림(창의 오른쪽 위, 한 변 10쯤)의 한가운데에 맞춘다
			o.closer.Position = o.holder.Position + UDim2.fromOffset(o.w - Ui.WIN.pad - 5 - CLOSE_HIT / 2, 18 - CLOSE_HIT / 2)
		end
	end
end

local function at(side: string)
	for _, o in open do
		if o.side == side then
			return o
		end
	end
	return nil
end

local function other(side: string): string
	return if side == "right" then "left" else "right"
end

-- 창들이 쓰는 ctx(boot가 준 것 — 달빛 상점의 공간이 같은 것을 쓴다: cashShop.luau · 2026-10-21)
function Windows.context()
	return ctx
end

function Windows.init(context)
	ctx = context
	root = Stage.group(Stage.ui, "Windows", 150)
	closers = Stage.group(Stage.ui, "Closers", 300)
	-- 화면 틀의 배율이 바뀌면 창의 크기가 달라진다 — 다 닫는다(다시 열면 새 크기로 뜬다)
	Stage.onResize(function()
		while #open > 0 do
			Windows.close(open[1].id)
		end
	end)
end

-- 창을 등록한다. def = { wide = 넓은 창인가, side = 늘 그쪽에 뜨는 창("right" — 가방), size = function(arg) → 속의 폭 · 높이, build = function(body, ctx, w, h, arg) → { refresh(me), destroy() } }
function Windows.register(id: string, def)
	local info = nil
	for _, w in UI.windows do
		if w.id == id then
			info = w
		end
	end
	assert(info, "공방에 없는 창 " .. id)
	def.name = info.name
	def.key = info.key
	def.from = info.from or 1
	defs[id] = def
end

-- 아직 열리지 않은 창인가
function Windows.locked(id: string): boolean
	local def = defs[id]
	return def == nil or (def.from > level and not Windows.extra[id])
end

-- 다른 캐릭터로 들어왔다: 그 캐릭터의 레벨에서 다시 센다(열려 있던 창은 부른 쪽이 먼저 닫는다 — 낮은 레벨의 캐릭터에게는 아직 열리지 않은 창이 있다)
function Windows.resetLevel(now: number)
	level = now
end

-- 내 레벨을 알린다. 이번에 새로 열린 창의 이름표(id)들을 돌려준다
function Windows.setLevel(now: number): { string }
	local fresh = {}
	for _, w in UI.windows do
		local def = defs[w.id]
		if def and def.from > level and def.from <= now then
			table.insert(fresh, w.id)
		end
	end
	level = math.max(level, now)
	return fresh
end

function Windows.info(id: string)
	return defs[id]
end

function Windows.isOpen(id: string): boolean
	for _, o in open do
		if o.id == id then
			return true
		end
	end
	return false
end

function Windows.anyOpen(): boolean
	return #open > 0
end

-- 그쪽("right" · "left") 끝에 창이 떠 있는가(오른쪽 창은 오른쪽 위의 퀘스트 알리미를 덮는다)
function Windows.sideOpen(side: string): boolean
	return at(side) ~= nil
end

function Windows.close(id: string)
	for i, o in open do
		if o.id == id then
			if o.view and o.view.destroy then
				o.view.destroy()
			end
			o.holder:Destroy()
			if o.closer then
				o.closer:Destroy()
			end
			table.remove(open, i)
			layout()
			if ctx.changed then
				ctx.changed()
			end
			return
		end
	end
end

function Windows.closeTop(): boolean
	local top = open[#open]
	if top then
		Windows.close(top.id)
		return true
	end
	return false
end

-- arg = 창에 딸려 주는 값(같은 창이 다른 값으로 열려 있으면 닫고 다시 연다)
--  force = 아직 열리지 않은 창이어도 띄운다(창고를 열 때의 가방 — 새 캐릭터도 계정의 창고에서 바로 꺼낼 수 있어야 한다)
function Windows.open(id: string, arg: any, force: boolean?)
	local def = defs[id]
	if not def or (def.from > level and not force and not Windows.extra[id]) then
		return
	end
	if Windows.isOpen(id) then
		if Windows.argOf(id) == arg then
			return
		end
		Windows.close(id)
	end
	-- 넓은 창은 다 닫고 혼자(오른쪽), 보통 창은 둘까지 — 오른쪽에 하나, 왼쪽에 하나.
	--  제 쪽이 정해진 창(가방 = 오른쪽)이 뜰 때 그 자리에 다른 창이 있으면 그 창을 맞은편으로 옮긴다(맞은편도 찼으면 그 자리의 창을 닫는다).
	--  쪽이 정해지지 않은 창은 빈 쪽에(오른쪽 먼저), 둘 다 찼으면 가장 먼저 연 창의 자리에.
	local side = "right"
	if def.wide then
		while #open > 0 do
			Windows.close(open[1].id)
		end
	else
		for i = #open, 1, -1 do
			if defs[open[i].id].wide then
				Windows.close(open[i].id)
			end
		end
		if def.side then
			side = def.side
			local there = at(side)
			if there then
				local across = at(other(side))
				if across or defs[there.id].side == side then
					Windows.close(there.id)
				else
					there.side = other(side)
				end
			end
		elseif not at("right") then
			side = "right"
		elseif not at("left") then
			side = "left"
		else
			-- 둘 다 찼다: 쪽이 정해지지 않은 창 가운데 가장 먼저 연 것의 자리를 쓴다(없으면 가장 먼저 연 것)
			local old = open[1]
			for _, o in open do
				if not defs[o.id].side then
					old = o
					break
				end
			end
			side = old.side
			Windows.close(old.id)
		end
	end
	local bw, bh = BODY_W, BODY_H
	if def.size then
		bw, bh = def.size(arg)
	end
	local w, h = Ui.windowSize(bw, bh)
	local holder = Stage.place(root, "Window_" .. id, "tr", 0, TOP, w, h)
	local win = Ui.window(holder, (if def.title then def.title(arg) else nil) or def.name, 0, 0, w, h, function() -- title이 nil이면 공방의 이름
		Windows.close(id)
	end)
	local view = def.build(win.body, ctx, win.w, win.h, arg)
	local closer = Instance.new("TextButton")
	closer.Name = "Close_" .. id
	closer.Text = ""
	closer.BackgroundTransparency = 1
	closer.Size = UDim2.fromOffset(CLOSE_HIT, CLOSE_HIT)
	closer.Parent = closers
	closer.Activated:Connect(function()
		Windows.close(id)
	end)
	local cross = win.frame:FindFirstChild("Close")
	if cross then
		closer.MouseEnter:Connect(function()
			Ui.swap(cross, "uCloseHot")
		end)
		closer.MouseLeave:Connect(function()
			Ui.swap(cross, "uClose")
		end)
	end
	table.insert(open, { id = id, win = win, holder = holder, view = view, arg = arg, w = w, h = h, side = side, closer = closer })
	layout()
	if ctx.changed then
		ctx.changed() -- 열린 창이 바뀌었다(가방의 단추가 옆 창에 따라 달라진다) — 여기서 모두 다시 그린다
	elseif view and view.refresh and ctx.me() then
		view.refresh(ctx.me())
	end
end

function Windows.toggle(id: string)
	if Windows.isOpen(id) then
		Windows.close(id)
	else
		Windows.open(id, nil)
	end
end

-- 내 상태가 바뀌었다: 열려 있는 창을 고쳐 그린다
function Windows.refresh(me)
	for _, o in open do
		if o.view and o.view.refresh then
			o.view.refresh(me)
		end
	end
end

-- 그 창 옆(화면 가운데 쪽)에 폭 w의 판을 놓을 자리 — 아이템 상세 판(ui/itemDetail.luau)이 쓴다. 창이 열려 있지 않으면 nil.
--  오른쪽 창이면 그 왼쪽에, 왼쪽 창이면 그 오른쪽에(창과 gap만큼 띄운다). 윗줄은 창과 같다
function Windows.beside(id: string, w: number, gap: number): UDim2?
	for _, o in open do
		if o.id == id then
			if o.side == "left" then
				return Stage.atPosition("tl", EDGE + o.w + gap, TOP)
			end
			-- 넓은 창(경매장)은 좁은 화면 틀에서 왼쪽에 자리가 없다: 그때는 화면 왼쪽 끝에 붙인다(창의 왼쪽을 조금 덮는다)
			local x = Stage.REF_W - EDGE - o.w - gap - w
			local least = EDGE + (Stage.REF_W - Stage.uiW)
			return Stage.atPosition("tr", math.max(x, least), TOP)
		end
	end
	return nil
end

-- 열린 창에 딸린 값(상점 창이 누구의 것인지 등)
function Windows.argOf(id: string): any
	for _, o in open do
		if o.id == id then
			return o.arg
		end
	end
	return nil
end

-- 등록된 창의 목록(여는 키가 있는 것만, 공방의 차례대로). all = 아직 열리지 않은 것까지
local function listOf(all: boolean)
	local out = {}
	for _, w in UI.windows do
		if defs[w.id] and w.key and (all or defs[w.id].from <= level or Windows.extra[w.id]) then
			table.insert(out, { id = w.id, name = w.name, key = w.key })
		end
	end
	return out
end

-- 지금 쓸 수 있는 창
function Windows.list()
	return listOf(false)
end

-- 등록된 창 모두(키를 묶을 때 쓴다)
function Windows.all()
	return listOf(true)
end

return Windows

end
MODULES['Client/lune/viewOpts'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 화면 설정(2026-10-18 — 메뉴 → 「설정」의 「화면」 두 줄 · 공방 ui.js의 UILAYOUT.sound.view): 다른 사람의 스킬 효과(fx) · 다른 사람의 피해 숫자(nums)를 보일지.
--  메이플 · 로스트아크의 「다른 캐릭터의 스킬 이펙트」처럼 — 사람이 많은 맵에서 폰이 버거울 때 끈다. 내 것은 늘 보인다. 몸의 움직임 · 몬스터의 맞는 모습 · 설치 · 소환은 그대로.
--  소리 설정과 함께 계정에 저장된다(shared/lune/sim/account.luau의 sound.fx · sound.nums — 없으면 켜짐)
local ViewOpts = { fx = true, nums = true }

-- 저장된 설정을 얹는다(서버가 준 계정의 sound)
function ViewOpts.import(sound: any)
	if typeof(sound) == "table" then
		ViewOpts.fx = sound.fx ~= false
		ViewOpts.nums = sound.nums ~= false
	end
end

-- 저장할 꼴에 얹는다(소리 설정의 표에 fx · nums를 더한다)
function ViewOpts.into(t)
	t.fx, t.nums = ViewOpts.fx, ViewOpts.nums
	return t
end

function ViewOpts.toggle(key: string): boolean
	if key ~= "fx" and key ~= "nums" then
		return false
	end
	ViewOpts[key] = not ViewOpts[key]
	return true
end

return ViewOpts

end
MODULES['Client/lune/vistaView'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 경관 — 성의 테라스에 들어서면 화면 가득 잠깐 보이는 그림(2026-10-16 밤 · 공방 design/city.js의 CITYROOMS vista · tools/build_lune_cityrooms.mjs의 vistaPicture).
--  사용자 2026-10-16: "영주 성같은걸 크게 만들고 들어가게하고 바깥 경관 볼수있는 그런것도 만들고 경관 이미지 멋있게 만들어서 잠깐 보여주는등"
--  들어설 때마다 한 번 · 테라스의 가운데(vista.x)에서 ↑ = 다시 본다. 천천히 밝아지고(FADE_IN) → 머물고(HOLD — 아래에 곳의 이름) → 천천히 사라진다(FADE_OUT).
--  화면 부품(HUD)보다 위 · 장면을 바꾸는 막(curtain — DisplayOrder 1000)보다 아래. 보는 동안에도 캐릭터는 움직일 수 있다(그림이 덮을 뿐)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local ASSETS = require(lune.data["assets.generated"])
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR

local VistaView = {}
VistaView.FADE_IN, VistaView.HOLD, VistaView.FADE_OUT = 0.7, 3.2, 0.9 -- 초(제가 정한 것)
VistaView.t = nil :: number? -- 보이기 시작한 뒤의 시간(안 보이면 nil)

local box: Frame = nil
local image: ImageLabel = nil
local title, sub

function VistaView.init(_root: Frame)
	-- 게임 화면 틀(Stage.ui) 전체를 덮는다 — 기준 격자(960x540)에 맞추면 화면의 꼴(가로가 긴 PC · 폰)에 따라 오른쪽 · 아래가 비고 잘린다(사용자 2026-10-16 밤: "테라스 뷰 보여주는거 잘려서나온다")
	box = Instance.new("Frame")
	box.Name = "Vista"
	box.BackgroundTransparency = 1
	box.BorderSizePixel = 0
	box.Size = UDim2.fromScale(1, 1)
	box.ZIndex = 1000 -- HUD(100)보다 위
	box.Visible = false
	box.Parent = Stage.ui
	image = Instance.new("ImageLabel")
	image.Name = "Picture"
	image.BackgroundColor3 = Color3.fromRGB(11, 15, 22)
	image.BackgroundTransparency = 1
	image.BorderSizePixel = 0
	image.ResampleMode = Enum.ResamplerMode.Pixelated
	image.ScaleType = Enum.ScaleType.Crop -- 화면의 꼴이 그림(16:9)과 달라도 가득 채운다(넘치는 가장자리만 잘린다)
	image.Size = UDim2.fromScale(1, 1)
	image.ZIndex = 1
	image.Parent = box
	-- 곳의 이름: 아래 가운데(화면의 폭과 상관없이 가운데)
	local caption = Instance.new("Frame")
	caption.Name = "Caption"
	caption.BackgroundTransparency = 1
	caption.AnchorPoint = Vector2.new(0.5, 1)
	caption.Position = UDim2.new(0.5, 0, 1, -40)
	caption.Size = UDim2.fromOffset(Stage.REF_W, 36)
	caption.ZIndex = 2
	caption.Parent = box
	title = Ui.text(caption, "", 0, 0, Stage.REF_W, { align = "center", font = "body", color = C.text })
	sub = Ui.text(caption, "", 0, 18, Stage.REF_W, { align = "center", color = C.accent })
	for _, d in caption:GetDescendants() do
		if d:IsA("GuiObject") then
			d.ZIndex = math.max(d.ZIndex, 2) -- 글은 그림 위
		end
	end
end

-- 그 장면의 경관을 띄운다(vista = { img, title, sub } — 장면의 자료)
function VistaView.show(vista)
	if not box or not vista or not ASSETS[vista.img] then
		return
	end
	image.Image = ASSETS[vista.img]
	title:set(vista.title or "")
	sub:set(vista.sub or "")
	title:show(false)
	sub:show(false)
	VistaView.t = 0
	box.Visible = true
	image.ImageTransparency = 1
	image.BackgroundTransparency = 1
end

function VistaView.stop()
	VistaView.t = nil
	if box then
		box.Visible = false
	end
end

function VistaView.showing(): boolean
	return VistaView.t ~= nil
end

-- 매 장면: 밝아지기 → 머물기(글) → 사라지기
function VistaView.update(dt: number)
	if not VistaView.t then
		return
	end
	VistaView.t += dt
	local t, A, B, Cc = VistaView.t, VistaView.FADE_IN, VistaView.FADE_IN + VistaView.HOLD, VistaView.FADE_IN + VistaView.HOLD + VistaView.FADE_OUT
	local a = if t < A then t / A elseif t < B then 1 elseif t < Cc then 1 - (t - B) / VistaView.FADE_OUT else 0
	image.ImageTransparency = 1 - a
	image.BackgroundTransparency = 1 - a
	local words = t >= A * 0.6 and t < B
	title:show(words)
	sub:show(words)
	if t >= Cc then
		VistaView.stop()
	end
end

return VistaView

end
MODULES['Client/lune/voyageView'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 배의 갑판에서 화면 위 가운데의 판: 「은달 항구까지 42초」(2026-10-16 — sim/voyage.luau · 서버가 Voyage로 알린다).
--  사용자 2026-10-16: "왜 대도시로 넘어갈때 배타는건 구현을 안합니까 왜 그냥 포탈이에요" — 선장에게 말을 걸어 배에 오르면 갑판에서 바다를 건넌다(배가 닿으면 서버가 내려 준다).
--  자리 · 크기는 토벌의 위의 판(UILAYOUT.riftHud)과 같다. 시계만 받은 뒤로 흐르게 한다(닿는 때는 서버가 정한다)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage.shared.lune
local Voyage = require(lune.sim.voyage)
local Layout = require(lune.ui.layout)
local Stage = require(script.Parent.stage)
local Ui = require(script.Parent.ui.ui)

local C = Ui.COLOR

local VoyageView = {}
VoyageView.left = nil :: number? -- 닿기까지 남은 초(배 위에 있을 때만)
VoyageView.dest = ""

function VoyageView.init(root: Frame)
	local H = Layout.RIFT_HUD
	local box = Stage.place(root, "Voyage", "tc", math.floor((Stage.REF_W - H.w) / 2), H.y, H.w, 24)
	box.Visible = false
	Ui.panel(box, 0, 0, H.w, 24)
	VoyageView.box = box
	VoyageView.text = Ui.text(box, "", 10, 7, H.w - 20, { align = "center", color = C.text })
end

function VoyageView.draw()
	if not VoyageView.left then
		return
	end
	VoyageView.text:set(Voyage.leftText({ dest = VoyageView.dest }, VoyageView.left))
end

function VoyageView.start(left: number, dest: string)
	VoyageView.left, VoyageView.dest = left, dest
	VoyageView.box.Visible = true
	VoyageView.draw()
end

function VoyageView.stop()
	VoyageView.left = nil
	if VoyageView.box then
		VoyageView.box.Visible = false
	end
end

-- 매 장면: 초가 바뀔 때만 다시 그린다
function VoyageView.update(dt: number)
	if not VoyageView.left then
		return
	end
	local before = math.ceil(VoyageView.left)
	VoyageView.left = math.max(0, VoyageView.left - dt)
	if math.ceil(VoyageView.left) ~= before then
		VoyageView.draw()
	end
end

return VoyageView

end
runTest('01_shared', function()
-- 공용 데이터: 아이템 표 · 가게 · 드롭 표 · 몬스터 레벨 · 씬 도우미
local items = req("ReplicatedStorage/shared/data/items")
local shops = req("ReplicatedStorage/shared/config/shops")
local drops = req("ReplicatedStorage/shared/config/drops")
local townWorld = req("ReplicatedStorage/shared/data/townWorld")
local monsterLevels = req("ReplicatedStorage/shared/config/monsterLevels")
local itemIcons = req("ReplicatedStorage/shared/data/itemIcons.generated")
local kit = req("ReplicatedStorage/shared/data/uiKit.generated")
local world = townWorld.data

-- 닌자 아이템이 표에 합쳐졌는가 · 투척 무기 수치
for _, id in { "Shuriken", "Kunai", "Bomb" } do
	local def = items[id]
	expect(def and def.Type == "Throw" and def.Tab == "Use", id .. " 투척 무기")
	expect(def.Throw.power > 0 and def.Throw.range > 0 and def.Throw.speed > 0, id .. " 수치")
end
expect(items.Bomb.Throw.radius and items.Bomb.Throw.radius > 0, "폭탄 범위")
expect(items.Onigiri.Heal == 40, "주먹밥 회복량")

-- 모든 아이템: 아이콘 이름이 실제로 있는가(도트 UI 키트 또는 팩 아이템 시트)
for id, def in items do
	if def.KitIcon and def.KitIcon ~= "" then
		local name = "icon_" .. def.KitIcon
		expect(kit.rects[name] ~= nil or itemIcons.rects[name] ~= nil, ("%s 아이콘 %s 없음"):format(id, name))
	end
end

-- 아이템은 전부 팩 그림(옛 도트 UI 키트 아이콘을 쓰는 아이템이 없어야 한다)
for id, def in items do
	expect(typeof(def.KitIcon) == "string" and string.sub(def.KitIcon, 1, 3) == "nj_" and itemIcons.rects["icon_" .. def.KitIcon] ~= nil, id .. " 은 팩 아이콘")
end
for _, legacy in { "WoodenSword", "LeafArmor", "RedPotion", "OrangePotion", "WhitePotion", "Bell1", "RainbowEgg", "SproutFragment", "Mat_piyo" } do
	expect(items[legacy] == nil, "옛 아이템이 표에 없음 " .. legacy)
end

-- UI 키트(팩 UI): 게임 코드가 쓰는 부품 · 색이 전부 있다
for _, name in { "panel", "tag", "tab_on", "tab_off", "button_primary", "button_primary_pressed", "button_plain", "button_plain_pressed", "button_disabled",
	"pill", "pill_dark", "slot", "slot_selected", "bar_frame", "bar_fill_red", "bar_fill_yellow", "bar_fill_sky", "bar_fill_mint", "bubble", "dialog_face",
	"icon_heart", "icon_coin", "icon_bag", "icon_book", "icon_gear", "icon_close", "icon_energy", "act_attack", "act_talk",
	"key_q", "key_r", "key_1", "key_2", "key_3", "key_e", "key_f" } do
	expect(kit.rects[name] ~= nil, "UI 부품 " .. name)
end
for _, name in { "ink", "white", "paper", "accent", "accentD", "accentL", "goodD", "grayD" } do
	expect(kit.colors[name] ~= nil, "UI 색 " .. name)
end
-- 그림 자리만 바꿔 끼우는 짝은 크기 · 9분할이 같아야 한다
for _, pair in { { "tab_on", "tab_off" }, { "slot", "slot_selected" }, { "button_primary", "button_primary_pressed" }, { "button_primary", "button_disabled" }, { "button_plain", "button_plain_pressed" }, { "button_plain", "button_disabled" } } do
	local a, b = kit.rects[pair[1]], kit.rects[pair[2]]
	expect(a.w == b.w and a.h == b.h and table.concat(a.slice, ",") == table.concat(b.slice, ","), ("%s / %s 크기 · 9분할 같음"):format(pair[1], pair[2]))
end
local ninjutsuConfig = req("ReplicatedStorage/shared/config/ninjutsu")
for id in ninjutsuConfig.SKILLS do
	local on, off = kit.rects["skill_" .. id], kit.rects["skill_" .. id .. "_off"]
	expect(on ~= nil and off ~= nil and on.w == off.w and on.h == off.h, "인술 아이콘 " .. id)
end
for _, id in ninjutsuConfig.SCHOOLS do
	expect(kit.rects["face_school_" .. id] ~= nil, "유파 얼굴 그림 " .. id)
end
for _, t in world.npcTypes do
	expect(kit.rects["face_" .. t.id] ~= nil, "NPC 얼굴 그림 " .. t.id)
end

-- 가게: 파는 물건이 전부 아이템 표에 있고 값이 있다
for shopId, shop in shops do
	for _, id in shop.goods do
		expect(items[id] ~= nil and (items[id].Price or 0) > 0, ("가게 %s의 %s"):format(shopId, id))
	end
end

-- 드롭 표: 지역이 전부 있고, 아이템이 실제로 있고, 확률이 0~1
for _, r in world.regions do
	local list = drops.REGION[r.id]
	expect(list ~= nil and #list > 0, "드롭 표 없음 " .. r.id)
	for _, d in list or {} do
		expect(items[d.item] ~= nil, ("드롭 아이템 없음 %s/%s"):format(r.id, d.item))
		expect(d.chance > 0 and d.chance <= 1, "확률 범위 " .. d.item)
	end
end
-- 굴림 통계: 들판에서 2000번 굴리면 풀잎이 35% 근처
local rng = RandomNew(7)
local grass, total = 0, 2000
for _ = 1, total do
	for _, d in drops.Roll("field", rng) do
		if d.item == "GrassBlade" then grass += 1 end
	end
end
expect(math.abs(grass / total - 0.35) < 0.04, ("풀잎 드롭률 %.3f"):format(grass / total))
eq(#drops.Roll("없는지역", rng), 0, "모르는 지역은 드롭 없음")

-- 몬스터 레벨: 종 범위 안에서만 나오고, 낮은 레벨이 더 흔하다
local lo, hi = monsterLevels.LevelRange(1)
eq(lo, 1, "말랑이 최소 레벨"); eq(hi, 4, "말랑이 최대 레벨")
local counts = {}
for _ = 1, 3000 do
	local l = monsterLevels.RollLevel(1, rng)
	expect(l >= lo and l <= hi, "레벨 범위 밖 " .. l)
	counts[l] = (counts[l] or 0) + 1
end
expect(counts[1] > counts[4], "낮은 레벨이 더 흔함")

