	end
	-- 이름표 = 지역 + m(메인) / s(부탁) + 차례
	expect(string.match(def.id, "^r%d[ms]%d+$") ~= nil or (def.city and string.match(def.id, "^cq%d%d$") ~= nil) or (def.kind == "job" and def.id == "job" .. tostring(def.reward.job)), "이름표의 꼴 " .. def.id) -- cq = 2편의 흩어진 퀘스트(2026-10-16)
	if def.after then
