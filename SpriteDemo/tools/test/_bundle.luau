		end
	end
	table.sort(list, function(a, b)
		return abs(a.x - from.x) < abs(b.x - from.x)
	end)
	for i = 0, n - 1 do
		local t = list[i % max(1, #list) + 1]
		if not t then
			return
		end
		g.call("wisp", t, i, n)
	end
