MODULES['ReplicatedStorage/shared/util/setup'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 공식 SpaceFighter 예제(notreux/SpaceFighter)의 src/shared/util/setup.luau 그대로 재활용.
local exports = {}

--[[
    Retrieves all ModuleScripts from a given path and requires them.
    Returns a table mapping module names to the required module.
]]
function exports.getModulesByPath(path)
	local modules = {}
	for _, module in path:GetChildren() do
		if module:IsA("ModuleScript") then
			modules[module.Name] = require(module)
		end
	end

	return modules
end

--[[
    Iterates over a table of modules and calls the specified method on each,
    passing any additional arguments provided.
]]
function exports.run(modules, methodName, ...)
	for _, module in modules do
		if module[methodName] then
			module[methodName](...)
		end
	end
end

return exports

end
MODULES['ServerScriptService/server/lune/boot'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 「달의 계승자」(횡스크롤 MMORPG) 서버의 시작점. shared/config/features.luau의 GAME이 "lune"일 때 server/main.server.luau가 부른다.
--  server/lune/modules 아래의 모듈을 차례로 켠다. 지금은 world(사람 · 방 · 싸움) 하나다.
local World = require(script.Parent.modules.world)
local Chat = require(script.Parent.modules.chat)

local Boot = {}

function Boot.start()
	-- 이 게임의 캐릭터는 화면 위의 도트 그림이다 — Roblox 기본 캐릭터(3D)는 만들지 않는다.
	--  (만들어 두면 화살표 키로 보이지 않는 캐릭터가 같이 걷고, 스마트폰에서는 기본 조이스틱이 뜬다)
	local Players = game:GetService("Players")
	Players.CharacterAutoLoads = false
	for _, player in Players:GetPlayers() do
		if player.Character then
			player.Character:Destroy()
		end
	end
	World.start()
	Chat.start(World)
	print("[lune] 서버 시작")
end

function Boot.stop()
	World.stop() -- 서버가 닫힐 때 모두 저장한다
end

return Boot

end
MODULES['ServerScriptService/server/lune/modules/admin'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 관리자(어드민) — 누가 관리자인가. 이 파일은 서버에만 있다(ServerScriptService — 클라이언트로 복제되지 않는다).
--  사용자 2026-10-11: "저만 쓸수있는 어드민용 탭 만들어주세요 다른 유저들에게는 보이지않고, 어드민만 보이는 어드민관리탭 … 경험치 배율증가, 레벨 조정, 아이템발급 등등
--   여러 테스트용 편의 기능 … 누군가 해킹같은거해서 사용도 못해야하고 오직 어드민만 사용할수있어야합니다."
--  지키는 법:
--   ① 관리자인지는 서버가 그 사람의 로블록스 계정 번호(UserId — 로블록스가 정해 주는 값이라 클라이언트가 속일 수 없다)로만 가린다. 클라이언트가 보낸 「나는 관리자다」 같은 말은 어디에서도 듣지 않는다.
--   ② 관리자 명령(패킷 「Admin」)은 올 때마다 서버가 다시 가린다 — 관리 창을 억지로 띄우거나 패킷을 직접 쏴도, 관리자가 아니면 아무 일도 일어나지 않는다(대답도 하지 않는다).
--   ③ 명령의 값(레벨 · 수 · 아이템의 이름 · 장면의 이름)은 서버가 범위와 꼴을 다시 본다(server/lune/modules/world.luau의 onAdmin).
--   ④ 관리 창의 코드는 누구에게나 내려가지만(로블록스의 클라이언트 코드는 감출 수 없다) 창을 여는 단추는 서버가 「관리자」라고 알려 준 사람에게만 보인다. 감추는 것은 보기 좋으라고 하는 것이고, 막는 것은 ① ②다.
--  관리자를 더하려면 아래 IDS에 그 계정의 번호를 적는다(게임의 주인은 적지 않아도 관리자다).
local Admin = {}

-- 관리자의 계정 번호 → 메모(이름). 게임의 주인 dolupa95
Admin.IDS = {
	[10311679477] = "dolupa95",
}

-- 그 사람이 관리자인가(서버만 부른다)
function Admin.is(player: any): boolean
	if typeof(player) ~= "Instance" and typeof(player) ~= "table" then
		return false
	end
	return Admin.isId(player.UserId)
end

-- 그 계정 번호가 관리자인가(명예의 전당이 관리자의 줄을 거른다 — 2026-10-15)
function Admin.isId(id: any): boolean
	if typeof(id) ~= "number" or id <= 0 then
		return false
	end
	if Admin.IDS[id] ~= nil then
		return true
	end
	-- 게임의 주인(개인이 주인일 때)
	local ok, owner = pcall(function()
		return game.CreatorType == Enum.CreatorType.User and game.CreatorId == id
	end)
	return ok and owner == true
end

return Admin

end
MODULES['ServerScriptService/server/lune/modules/analytics'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 플레이어 데이터 기록 — 로블록스의 분석(AnalyticsService)에 보낸다(2026-10-15)
--  사용자: "플레이어 데이터 수집 로블록스에서 어떻게 진행되는지 알아보고 조치합시다"
--  보는 곳: 크리에이터 대시보드 → 경험 → 분석(Analytics)
--   · Funnels: 온보딩(접속 → 캐릭터 → 달빛 꿈의 미션 열하나 → 깨어남 → 첫 퀘스트 → Lv.5 · Lv.10) · MainQuest(1지역 줄 14개) · Part2Quest(2편의 길 열둘 — 2026-10-16) · Level(Lv.1 → 100)
--   · Economy: 달돈(Money)이 어디서 들어오고(퀘스트 · 일일 의뢰 · 몬스터 · 상점에 팔기 · 경매 대금) 어디로 나가는가(상점 · 가방 늘리기 · 제작 · 대장간 · 경매)
--   · Explore(커스텀 이벤트): LevelUp(값 = 그 캐릭터로 논 분) · JobAdvanced(값 = 레벨) · Death(어느 맵) · DailyDone · Enhance(값 = 노린 별 · 결과) · RiftEnter · RiftClear(수정 틈 토벌 — 단계, 2026-10-16) · FieldElite(사냥터 정예를 잡음 — 맵, 2026-10-18)
--  로블록스의 규칙(문서 2026-10 — 조사는 공방 「개발 진행」): 서버에서만 · 게시된 게임에서만 간다(Studio에서는 보내지 않는다 — 여기서도 Studio에서는 부르지 않고 Analytics.log에만 적는다).
--   커스텀 필드 셋 = 직업 · 레벨 구간 · 그때의 것(맵 · 퀘스트) — 값은 글이고 셋의 조합이 8,000을 넘으면 「Other」로 묶인다 · 퍼널은 10개까지 · 커스텀 이벤트 이름은 100개까지이고 지울 수 없다(이름을 늘리지 않는다).
--   1분에 120 + 20 x 동접 — 달돈은 갈래마다 모아 60초에 한 번(맵을 나갈 때 · 게임을 나갈 때도) 보낸다. 대시보드에는 보통 하루 뒤에 나온다(각 쪽의 View Events는 바로).
--  적지 않는 것(제 판단): 사람의 이름 · 캐릭터 이름 · 채팅 · 숫자 id를 필드에 넣지 않는다(이벤트는 로블록스가 이미 그 사람과 잇는다).
--   관리자 · 확인용 캐릭터(LuneGuest) · 봇은 적지 않는다(명예의 전당과 같다 — 개발하며 논 것이 숫자를 흐리지 않게).
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lune = ReplicatedStorage:WaitForChild("shared"):WaitForChild("lune")
local Quests = require(lune.sim.quests)
local Tutorial = require(lune.sim.tutorial)

local Analytics = {}

Analytics.FLUSH = 60 -- 달돈을 모았다가 보내는 틈(초)
Analytics.WATCH = 1 -- 캐릭터가 바뀐 것(레벨 · 차수 · 퀘스트 · 쓰러짐)을 보는 틈(초)
Analytics.KEEP = 300 -- Analytics.log에 남기는 수(시험 · Studio에서 본다)
Analytics.CURRENCY = "Money" -- 달돈(통화는 다섯 개 안 — 지금은 하나)
Analytics.LEVEL_STEPS = 100 -- 퍼널 하나는 100단계까지

-- 온보딩 퍼널의 단계(1부터 · 같은 사람이 다시 보내면 로블록스가 무시한다 — 계정에 한 번)
local ONBOARD_JOIN, ONBOARD_MADE, ONBOARD_DREAM = 1, 2, 3
local ONBOARD_MISSION0 = 3 -- 꿈의 n째 미션을 마침 = 3 + n
local ONBOARD_WOKE = ONBOARD_MISSION0 + Tutorial.TOTAL + 1
local ONBOARD_Q_ACCEPT, ONBOARD_Q_DONE = ONBOARD_WOKE + 1, ONBOARD_WOKE + 2
local ONBOARD_LV = { [5] = ONBOARD_WOKE + 3, [10] = ONBOARD_WOKE + 4 }
Analytics.ONBOARD_LAST = ONBOARD_WOKE + 4

-- 1지역 퀘스트 줄의 차례(after를 따라간다) — MainQuest 퍼널: 1 = 첫 퀘스트를 받음 · k + 1 = k째 퀘스트를 끝냄
local LINE: { any } = {}
do
	local lineDefs = {}
	for _, def in Quests.list do
		if def.line and def.region == "r1" and def.playable then
			table.insert(lineDefs, def)
		end
	end
	local byAfter = {}
	local head = nil
	for _, def in lineDefs do
		if def.after then
			byAfter[def.after] = def
		elseif not head then
			head = def
		end
	end
	local cur = head
	while cur and #LINE < #lineDefs do
		table.insert(LINE, cur)
		cur = byAfter[cur.id]
	end
end
Analytics.LINE = LINE
-- 2편의 길(2026-10-16): 큰 항구로 → 항구의 첫날 → 2편 메인 아홉 → 3차 전직 — Part2Quest 퍼널(1 = 「큰 항구로」를 받음 · k + 1 = k째를 끝냄).
--  2편의 사이드 · 도시 퀘스트는 흩어져 있어(차례가 없다) 퍼널에 넣지 않는다
local LINE2: { any } = {}
for _, id in { "cq01", "cq02", "r2m1", "r2m2", "r2m3", "r2m4", "r2m5", "r2m6", "r2m7", "r2m8", "r2m9", "job3" } do
	local def = Quests.def(id)
	if def and def.playable then
		table.insert(LINE2, def)
	end
end
Analytics.LINE2 = LINE2

-- 돈의 갈래: 어느 요청(Net 이름 · 그 일)이 바꿨는가 → 흐름 · 거래의 꼴 · 품목(itemSku)
--  거래의 꼴은 로블록스의 이름(Shop · Gameplay)을 먼저 쓰고, 경매만 제 이름(Auction — 사람끼리 오가는 돈이라 대시보드에서 따로 거른다)
local function moneyKind(name: string, action: any, gain: boolean): (string, string)
	if name == "Item" then
		if action == "buy" then
			return "Shop", "ShopBuy"
		elseif action == "sell" then
			return "Shop", "NpcSell"
		elseif action == "grow" then
			return "Shop", "BagExpand"
		elseif action == "craft" then
			return "Gameplay", "Craft"
		elseif action == "enhance" or action == "transfer" or action == "restore" then
			return "Gameplay", "Smith"
		end
	elseif name == "Market" then
		if action == "list" then
			return "Auction", if gain then "AuctionRefund" else "AuctionDeposit"
		elseif action == "buy" then
			return "Auction", if gain then "AuctionRefund" else "AuctionBuy"
		end
		return "Auction", if gain then "AuctionCollect" else "AuctionOther"
	elseif name == "Quest" then
		return "Gameplay", "QuestReward"
	elseif name == "Daily" then
		return "Gameplay", "DailyQuest"
	elseif name == "Attend" then
		return "TimedReward", "Attendance" -- 출석 보상(로블록스의 꼴 TimedReward)
	elseif name == "Achieve" then
		return "Gameplay", "Achievement"
	elseif name == "Pickup" or name == "PetPick" or name == "Skill" or name == "tick" then -- PetPick = 펫이 주운 것(2026-10-20)
		return "Gameplay", if gain then "MonsterDrop" else "Other"
	end
	return "Gameplay", "Other"
end
Analytics.moneyKind = moneyKind

-- ---------- 보내기 ----------
local service: any = nil -- AnalyticsService(게시된 게임의 서버) · false(Studio · 시험)
local function svc(): any
	if service == nil then
		local ok, studio = pcall(function()
			return RunService:IsStudio()
		end)
		if not ok or studio then
			service = false
		else
			local got, s = pcall(function()
				return game:GetService("AnalyticsService")
			end)
			service = if got and s then s else false
		end
	end
	return service
end
-- (시험) 보내는 곳을 바꾼다 — nil이면 다시 찾는다
function Analytics.setService(s: any)
	service = s
end

Analytics.log = {} :: { any }
local function remember(row)
	table.insert(Analytics.log, row)
	if #Analytics.log > Analytics.KEEP then
		table.remove(Analytics.log, 1)
	end
end

-- 커스텀 필드(값은 글 · 없는 것은 뺀다)
local function fieldsOf(f: { any }?): any
	if not f then
		return nil
	end
	local keys = { "CustomField01", "CustomField02", "CustomField03" }
	local out = {}
	local any = false
	for i, k in keys do
		local v = f[i]
		if v ~= nil and v ~= "" then
			local ok, name = pcall(function()
				return (Enum.AnalyticsCustomFieldKeys :: any)[k].Name
			end)
			out[if ok and typeof(name) == "string" then name else k] = tostring(v)
			any = true
		end
	end
	return if any then out else nil
end

local function emit(kind: string, player: any, args: { any }, f: { any }?)
	remember({ kind = kind, user = player and player.UserId, args = args, fields = f })
	local s = svc()
	if not s then
		return
	end
	local fields = fieldsOf(f)
	pcall(function()
		if kind == "onboard" then
			s:LogOnboardingFunnelStepEvent(player, args[1], args[2], fields)
		elseif kind == "funnel" then
			s:LogFunnelStepEvent(player, args[1], args[2], args[3], args[4], fields)
		elseif kind == "custom" then
			s:LogCustomEvent(player, args[1], args[2], fields)
		elseif kind == "economy" then
			local flow = if args[1] == "Source" then Enum.AnalyticsEconomyFlowType.Source else Enum.AnalyticsEconomyFlowType.Sink
			s:LogEconomyEvent(player, flow, Analytics.CURRENCY, args[2], args[3], args[4], args[5], fields)
		end
	end)
end

-- ---------- 누구를 적는가 ----------
local hooks = {
	skip = function(_s): boolean
		return false
	end,
}
-- skip(s) = 적지 않는 사람(관리자 · 확인용 · 봇) — world.luau가 준다
function Analytics.init(o: { skip: (any) -> boolean })
	hooks.skip = o.skip
end

local function tracked(s): boolean
	return s ~= nil and s.player ~= nil and not hooks.skip(s)
end

-- 레벨 구간(커스텀 필드 둘째): 1~30은 다섯씩(배우는 구간), 그 뒤는 열씩
function Analytics.band(level: number): string
	if level <= 30 then
		local lo = math.floor((level - 1) / 5) * 5 + 1
		return ("Lv%02d-%02d"):format(lo, lo + 4)
	end
	local lo = math.floor((level - 1) / 10) * 10 + 1
	return ("Lv%02d-%02d"):format(lo, lo + 9)
end

local function fieldsFor(s, ctx: string?, level: number?): { any }
	local h = s.hero
	return { h.class, Analytics.band(level or h.level), ctx }
end

local function charKey(s): string
	return ("%d-%s"):format(s.player.UserId, tostring(s.cid or "?"))
end

-- ---------- 온보딩 · 퍼널 · 커스텀 ----------
function Analytics.onboard(s, step: number, name: string)
	if not tracked(s) then
		return
	end
	s.anBoard = s.anBoard or {}
	if s.anBoard[step] then
		return -- 이 접속에서 이미 보냈다(로블록스도 두 번째는 무시하지만 한도를 쓴다)
	end
	s.anBoard[step] = true
	emit("onboard", s.player, { step, ("%02d %s"):format(step, name) }, if s.hero then fieldsFor(s) else nil)
end

function Analytics.custom(s, name: string, value: number, ctx: string?)
	if not tracked(s) or not s.hero then
		return
	end
	emit("custom", s.player, { name, value }, fieldsFor(s, ctx))
end

-- ---------- 달돈: 갈래마다 모은다 ----------
local function addMoney(s, name: string, action: any, delta: number)
	if delta == 0 or not s.anMoney then
		return
	end
	local gain = delta > 0
	local tx, sku = moneyKind(name, action, gain)
	local key = (if gain then "Source" else "Sink") .. "|" .. tx .. "|" .. sku
	s.anMoney[key] = (s.anMoney[key] or 0) + math.abs(delta)
end

-- 모은 달돈을 보낸다(갈래마다 한 번 — 잔고는 보내는 때의 것)
function Analytics.flush(s)
	if not s.anMoney or not s.hero then
		return
	end
	local keys = {}
	for k in s.anMoney do
		table.insert(keys, k)
	end
	table.sort(keys)
	for _, k in keys do
		local amount = s.anMoney[k]
		local flow, tx, sku = string.match(k, "^(%a+)|(%a+)|(%a+)$")
		if amount > 0 and flow then
			emit("economy", s.player, { flow, amount, math.max(0, s.hero.money), tx, sku }, fieldsFor(s))
		end
	end
	table.clear(s.anMoney)
	s.anFlushT = 0
end

-- ---------- 캐릭터가 바뀐 것을 본다 ----------
local function snapshot(h)
	local q = {}
	for id, st in h.quests do
		q[id] = if st.done then "done" else "active"
	end
	return { level = h.level, job = h.job, money = h.money, alive = h.alive, tut = h.tut.step, tutDone = h.tut.done, quests = q }
end

-- 세계에 들어왔다(캐릭터를 골랐다)
function Analytics.begin(s)
	if not tracked(s) or not s.hero then
		s.an = nil
		return
	end
	s.an = snapshot(s.hero)
	s.anMoney = {}
	s.anT, s.anFlushT = 0, 0
	if not s.hero.tut.done then
		Analytics.onboard(s, ONBOARD_DREAM, "달빛 꿈")
	end
end

-- 세계에서 나간다(캐릭터 고르기 · 게임을 나감): 모은 달돈을 보내고 그친다
function Analytics.finish(s)
	if s.an then
		Analytics.watch(s)
		Analytics.flush(s)
	end
	s.an, s.anMoney = nil, nil
end

function Analytics.watch(s)
	local was = s.an
	local h = s.hero
	if not was or not h then
		return
	end
	local key = charKey(s)
	-- 꿈(튜토리얼)의 미션
	if h.tut.step > was.tut then
		for k = was.tut, math.min(h.tut.step - 1, Tutorial.TOTAL) do
			local def = Tutorial.STEPS[k]
			Analytics.onboard(s, ONBOARD_MISSION0 + k, "꿈 " .. ((def and (def.title or def.id)) or tostring(k)))
		end
	end
	if h.tut.done and not was.tutDone then
		Analytics.onboard(s, ONBOARD_WOKE, "꿈에서 깸")
	end
	-- 레벨
	if h.level > was.level then
		for lv = was.level + 1, h.level do
			if lv <= Analytics.LEVEL_STEPS then
				emit("funnel", s.player, { "Level", key, lv, ("Lv.%d"):format(lv) }, fieldsFor(s, nil, lv))
			end
			emit("custom", s.player, { "LevelUp", math.floor((h.played or 0) / 6) / 10 }, fieldsFor(s, ("Lv%02d"):format(lv), lv))
			if ONBOARD_LV[lv] then
				Analytics.onboard(s, ONBOARD_LV[lv], ("Lv.%d"):format(lv))
			end
		end
	end
	-- 전직
	if h.job > was.job then
		for j = was.job + 1, h.job do
			emit("custom", s.player, { "JobAdvanced", h.level }, fieldsFor(s, ("job%d"):format(j)))
		end
	end
	-- 2편의 길
	for i, def in LINE2 do
		local st = h.quests[def.id]
		local now = if st then (if st.done then "done" else "active") else nil
		local before = was.quests[def.id]
		if now ~= before then
			if i == 1 and now ~= nil and before == nil then
				emit("funnel", s.player, { "Part2Quest", key, 1, ("P01 %s 받음"):format(def.name) }, fieldsFor(s, def.id))
			end
			if now == "done" then
				emit("funnel", s.player, { "Part2Quest", key, i + 1, ("P%02d %s 끝"):format(i, def.name) }, fieldsFor(s, def.id))
			end
		end
	end
	-- 퀘스트 줄
	for i, def in LINE do
		local st = h.quests[def.id]
		local now = if st then (if st.done then "done" else "active") else nil
		local before = was.quests[def.id]
		if now ~= before then
			if i == 1 and now ~= nil and before == nil then
				emit("funnel", s.player, { "MainQuest", key, 1, ("Q01 %s 받음"):format(def.name) }, fieldsFor(s, def.id))
				Analytics.onboard(s, ONBOARD_Q_ACCEPT, "첫 퀘스트 받음")
			end
			if now == "done" then
				emit("funnel", s.player, { "MainQuest", key, i + 1, ("Q%02d %s 끝"):format(i, def.name) }, fieldsFor(s, def.id))
				if i == 1 then
					Analytics.onboard(s, ONBOARD_Q_DONE, "첫 퀘스트 끝")
				end
			end
		end
	end
	-- 쓰러짐(어느 맵에서)
	if was.alive and not h.alive then
		emit("custom", s.player, { "Death", 1 }, fieldsFor(s, s.scene))
	end
	-- 요청 밖에서 바뀐 달돈(바닥에 떨어진 돈을 저절로 주웠다 등)
	if not s.anBusy and h.money ~= was.money then
		addMoney(s, "tick", nil, h.money - was.money)
	end
	s.an = snapshot(h)
end

-- 시계: 1초마다 보고, 60초마다 달돈을 보낸다
function Analytics.tick(s, dt: number)
	if not s.an then
		return
	end
	s.anT += dt
	s.anFlushT += dt
	if s.anT >= Analytics.WATCH then
		s.anT = 0
		Analytics.watch(s)
	end
	if s.anFlushT >= Analytics.FLUSH then
		Analytics.flush(s)
	end
end

local LOOK = { Quest = true, Tut = true, Item = true, Daily = true, Market = true, Travel = true, Return = true }
-- 요청(Net.OnServer)을 감싼다: 그 요청이 바꾼 달돈을 그 갈래에 적고, 바뀐 것을 바로 본다. 돌려주는 값은 그대로
function Analytics.wrap(name: string, fn: (...any) -> ...any, sessionOf: (any) -> any): (...any) -> ...any
	return function(player, ...)
		local s = sessionOf(player)
		local h = s and s.an and s.hero
		if not h then
			return fn(player, ...)
		end
		local action = ...
		local before = h.money
		s.anBusy = (s.anBusy or 0) + 1
		local out = table.pack(pcall(fn, player, ...)) -- 요청이 터져도 「요청 중」 표시는 걷는다(오류는 그대로 다시 던진다)
		s.anBusy = if s.anBusy and s.anBusy > 1 then s.anBusy - 1 else nil
		if s.hero == h and s.an then
			addMoney(s, name, action, h.money - before)
			s.an.money = h.money
			if LOOK[name] then
				Analytics.watch(s) -- 퀘스트 · 꿈 · 가방 · 의뢰 · 경매 · 이동은 바로 본다(싸움 · 줍기는 1초 시계가 본다 — 자주 오는 요청이라)
			end
		end
		if not out[1] then
			error(out[2], 0)
		end
		return table.unpack(out, 2, out.n)
	end
end

-- 계정에 들어옴 · 캐릭터를 만듦(온보딩의 앞 두 단계)
function Analytics.joined(s)
	Analytics.onboard(s, ONBOARD_JOIN, "접속")
end
function Analytics.made(s)
	Analytics.onboard(s, ONBOARD_MADE, "캐릭터 만듦")
end

return Analytics

end
MODULES['ServerScriptService/server/lune/modules/cash'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 로블록스 결제(로벅스) — 서버만. 셈은 shared/lune/sim/cash.luau, 설계는 공방 js/lune/design/bm.js(2026-10-20).
--  로블록스 공식 문서(developer-products · game-passes · subscriptions)에서 읽은 것:
--   · ProcessReceipt는 서버의 한 곳에서만 정한다 · 준 것이 확실할 때만 PurchaseGranted · 아니면 NotProcessedYet(그 사람이 다음에 들어올 때 다시 보낸다)
--   · PromptProductPurchaseFinished는 「샀다」가 아니다 — 주는 것은 ProcessReceipt에서만
--   · 게임 패스는 로블록스가 산 기록을 남기지 않는다(UserOwnsGamePassAsync로 본다) · 구독은 GetUserSubscriptionStatusAsync · Players.UserSubscriptionStatusChanged
--  같은 결제를 두 번 주지 않는다: 처리한 결제 번호를 계정 저장(acct.bm.rec)에 남기고, 준 것과 번호를 한 번의 저장으로 함께 적는다(계정 잠금 — 한 계정은 한 서버만 쓴다).
--  저장에 실패하면 준 것을 되돌리고 NotProcessedYet — 돈을 받고 주지 않는 일 · 두 번 주는 일 둘 다 없게.
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")

local lune = game:GetService("ReplicatedStorage").shared.lune
local Cash = require(lune.sim.cash)
local Account = require(lune.sim.account)

local CashServer = {}
local W -- World가 넘겨주는 것: sessionOf(userId) · saveNow(s) · afterSpent(s) · notify(s, key) · now()
local pending = {} -- [userId] = { [상품] = 띄워 둔 구매 창 수 }

function CashServer.pending(userId: number, key: string): number
	return (pending[userId] and pending[userId][key]) or 0
end
local function addPending(userId: number, key: string, d: number)
	pending[userId] = pending[userId] or {}
	pending[userId][key] = math.max(0, (pending[userId][key] or 0) + d)
end
function CashServer.forget(userId: number)
	pending[userId] = nil
end

-- 결제 하나를 처리한다(로블록스가 부른다 · 테스트와 Studio의 Debug도 같은 길로).
--  info = { PlayerId, ProductId, PurchaseId, CurrencySpent } · key = 상품(없으면 ProductId로 찾는다)
function CashServer.processReceipt(info, key: string?)
	local Decision = Enum.ProductPurchaseDecision
	local k = key or Cash.byRid(info.ProductId)
	if not k then
		warn("[Cash] 모르는 상품 번호", info.ProductId)
		return Decision.NotProcessedYet
	end
	local s = W.sessionOf(info.PlayerId)
	if not s or not s.acct or not s.loaded or s.guest then
		return Decision.NotProcessedYet -- 이 서버에 없거나 계정을 다 읽지 못했다 — 들어올 때 다시
	end
	local acct = s.acct
	local before, spentBefore = Cash.pack(acct.bm), acct.spent
	local ok, why = Cash.grant(acct, k, tostring(info.PurchaseId), W.now(), Account.MAX, s.hero and s.hero.level)
	if not ok then
		if why == "dup" then
			return Decision.PurchaseGranted -- 이미 준 결제(로블록스가 다시 보냈다)
		end
		acct.bm = Cash.unpack(before, Account.MAX)
		warn("[Cash] 줄 수 없는 상품", k, why)
		return Decision.NotProcessedYet
	end
	acct.spent += math.max(0, math.floor(tonumber(info.CurrencySpent) or 0))
	if W.saveNow(s) then
		addPending(info.PlayerId, k, -1)
		task.spawn(W.afterSpent, s)
		W.notify(s, k)
		return Decision.PurchaseGranted
	end
	acct.bm = Cash.unpack(before, Account.MAX)
	acct.spent = spentBefore
	return Decision.NotProcessedYet
end

-- 구매 창을 띄운다(서버가 한도를 본 뒤에만). → true / false · 까닭
function CashServer.prompt(s, key: any): (boolean, string?)
	local p = Cash.product(key)
	if not p then
		return false, "없는 상품이다"
	elseif not s.acct or not s.loaded or s.guest then
		return false, "계정을 읽지 못했다"
	elseif not Cash.ready(p) then
		return false, "판매 준비 중" -- 상품 번호가 없거나 게임에 아직 만들지 않은 것
	end
	local uid = s.player.UserId
	local ok, why = Cash.canBuy(s.acct, key, W.now(), CashServer.pending(uid, key), Account.MAX)
	if not ok then
		return false, why
	end
	local done, err = pcall(function()
		if p.kind == "product" then
			addPending(uid, key, 1)
			MarketplaceService:PromptProductPurchase(s.player, p.rid)
		elseif p.kind == "pass" then
			MarketplaceService:PromptGamePassPurchase(s.player, p.rid)
		else
			MarketplaceService:PromptSubscriptionPurchase(s.player, p.rid)
		end
	end)
	if not done then
		addPending(uid, key, -1)
		warn("[Cash] 구매 창을 띄우지 못했다", key, err)
		return false, "구매 창을 띄우지 못했다"
	end
	return true
end

-- 상품의 실제 값(로블록스 — 대시보드에서 바꾼 값 · 가격 실험이 있으면 그 값). 10분 동안 기억한다 · 못 읽으면 nil(화면은 설계의 값)
--  로블록스 문서: MarketplaceService:GetProductInfoAsync(번호, Enum.InfoType.Product).PriceInRobux(GetProductInfo는 낡은 이름)
local PRICE_KEEP = 600
local priceAt, priceOf = 0, {}
function CashServer.prices(): { [string]: number }
	local now = os.clock()
	if now - priceAt < PRICE_KEEP and next(priceOf) ~= nil then
		return priceOf
	end
	priceAt = now
	for _, p in Cash.PRODUCTS do
		if typeof(p.rid) == "number" and p.rid > 0 then
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfoAsync(p.rid, Enum.InfoType.Product)
			end)
			if ok and typeof(info) == "table" and typeof(info.PriceInRobux) == "number" then
				priceOf[p.id] = info.PriceInRobux
			end
		end
	end
	return priceOf
end

-- 게임 패스를 가졌는가(들어올 때 · 산 순간 — 로블록스가 산 기록을 주지 않으니 물어서 기억한다)
function CashServer.owns(s, key: string): boolean
	local p = Cash.product(key)
	if not p or p.kind ~= "pass" or not (typeof(p.rid) == "number" and p.rid > 0) then
		return false
	end
	s.passes = s.passes or {}
	if s.passes[key] == nil then
		local ok, has = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, s.player.UserId, p.rid)
		if not ok then
			return false -- 물어보지 못했다 — 다음에 다시
		end
		s.passes[key] = has == true
	end
	return s.passes[key]
end

-- 이벤트를 잇는다 — 진짜 로블록스의 이벤트일 때만(검사 틀 — 가짜 로블록스 — 에는 결제 서비스가 없다: 조용히 넘어간다)
local function on(get, fn)
	local ok, sig = pcall(get)
	if ok and typeof(sig) == "RBXScriptSignal" then
		sig:Connect(fn)
	end
end

function CashServer.start(hooks)
	W = hooks
	pcall(function()
		MarketplaceService.ProcessReceipt = CashServer.processReceipt
	end)
	-- 구매 창이 닫혔다(샀든 안 샀든) — 띄워 둔 수만 줄인다(산 것은 ProcessReceipt가 준다)
	on(function()
		return MarketplaceService.PromptProductPurchaseFinished
	end, function(userId, productId, isPurchased)
		local k = Cash.byRid(productId)
		if k and not isPurchased then
			addPending(userId, k, -1)
		end
	end)
	on(function()
		return MarketplaceService.PromptGamePassPurchaseFinished
	end, function(player, passId, purchased)
		local s = W.sessionOf(player.UserId)
		local k = Cash.byRid(passId)
		if s and k and purchased then
			s.passes = s.passes or {}
			s.passes[k] = true
			W.notify(s, k)
		end
	end)
	on(function()
		return Players.PlayerRemoving
	end, function(player)
		CashServer.forget(player.UserId)
	end)
end

return CashServer

end
MODULES['ServerScriptService/server/lune/modules/chat'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 채팅이 누구에게 가는지 — Roblox의 채팅(TextChatService)에 얹는다. 글 거르기는 Roblox가 한다. 화면도 Roblox의 기본 채팅 창이다(2026-10-13 — client/lune/chat.luau).
--  둘레(기본 채널 RBXGeneral): 같은 맵에 있는 사람에게만 간다.
--  파티(채널 「파티」): 모두가 들어 있되, 같은 파티인 사람에게만 간다(파티가 없으면 나만 본다).
--  누가 어느 맵 · 어느 파티인지는 world.luau에 묻는다.
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PARTY = require(ReplicatedStorage.shared.lune.data["ui.generated"]).chatUi.party.channel -- 파티 채널의 이름(Roblox 채팅의 채널 탭에 그대로 뜬다 — 화면의 chat.luau와 같은 자료)

local Chat = {}

function Chat.start(World)
	task.spawn(function()
		local channels = TextChatService:WaitForChild("TextChannels", 15)
		if not channels then
			warn("[lune] 채팅 채널을 찾지 못했다 — 채팅은 Roblox 기본 그대로 돈다")
			return
		end
		local general = channels:WaitForChild("RBXGeneral", 15)
		if general then
			general.ShouldDeliverCallback = function(message, target)
				local from = message.TextSource
				if not from then
					return true
				end
				if from.UserId == target.UserId then
					return true -- 제 말은 늘 제게 보인다
				end
				-- 같은 맵의 사람끼리만. 맵이 없는 사람(캐릭터 고르기 화면)은 주고받지 않는다(2026-10-18 검토: 전에는 모든 맵의 말을 주고받았다)
				local a, b = World.sceneOf(from.UserId), World.sceneOf(target.UserId)
				return a ~= nil and a == b
			end
		end
		local party = Instance.new("TextChannel")
		party.Name = PARTY
		party.Parent = channels
		party.ShouldDeliverCallback = function(message, target)
			local from = message.TextSource
			return from ~= nil and World.sameParty(from.UserId, target.UserId)
		end
		local function add(player)
			pcall(function()
				party:AddUserAsync(player.UserId)
			end)
		end
		Players.PlayerAdded:Connect(add)
		for _, player in Players:GetPlayers() do
			task.spawn(add, player)
		end
	end)
end

return Chat

end
MODULES['ServerScriptService/server/lune/modules/store'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 저장소(DataStore). 게임 규칙은 모른다 — 숫자와 글로 된 표를 읽고 쓸 뿐이다(저장 꼴은 sim/account.luau · sim/hero.luau의 pack · unpack).
--  셋을 다룬다:
--   계정(LuneAccount_v1, 열쇠 acct_<사람 번호>) = 그 사람의 캐릭터들과 같이 쓰는 창고. 한 열쇠에 통째로 적는다 — 캐릭터와 창고가 어긋나지 않게.
--   이름 장부(LuneNames_v1, 열쇠 = 이름) = 그 이름을 가진 사람. 캐릭터의 이름은 겹치지 않는다(사용자 2026-10-10: "중복확인을하고") — UpdateAsync로 먼저 적은 사람이 갖는다.
--   예전 저장(LuneHero_v1, 열쇠 hero_<사람 번호>) = 계정이 생기기 전의 캐릭터 하나. 읽기만 한다(계정으로 옮긴 뒤에도 지우지 않고 그대로 둔다).
--  DataStore 호출은 몇 번 다시 해 본다. Studio에서 API 접근이 꺼져 있으면 메모리에만 담아 둔다(Play를 끄면 사라진다 — 그때는 경고를 한 번 낸다).
--  아직 하지 않은 것: 같은 계정이 두 서버에 동시에 들어왔을 때의 잠금(여럿이 하는 단계에서 넣는다).
local DataStoreService = game:GetService("DataStoreService")
-- 메모리 모드(offline)는 Studio에서만(2026-10-18 검토): 라이브 서버에서 한 번 읽기에 실패했다고 서버 전체가 메모리에만 저장하면 모두의 진행을 잃고 ·
--  새로 들어온 사람은 빈 계정을 보고 · 이름 장부가 서버마다 따로 놀았다. 라이브에서는 그때그때 실패를 알리고(부른 쪽이 들여보내지 않는다) 다음에 다시 해 본다
local function studio(): boolean
	local ok, yes = pcall(function()
		return game:GetService("RunService"):IsStudio()
	end)
	return ok and yes == true
end

local NAME = { account = "LuneAccount_v1", names = "LuneNames_v1", old = "LuneHero_v1", rankInfo = "LuneRankInfo_v1", market = "LuneMarket_v2" }
local RANK = { level = "LuneRankLevel_v1", power = "LuneRankPower_v1", robux = "LuneRankRobux_v1" } -- 순위판(OrderedDataStore): 열쇠 → 점수
local RETRIES = 3
local WAIT = 1

local Store = {}

local stores = {}
local memory = { account = {}, names = {}, market = {} } -- DataStore를 못 쓸 때의 임시 저장
local offline = false

local function getStore(which: string)
	if stores[which] or offline then
		return stores[which]
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(NAME[which])
	end)
	if ok then
		stores[which] = result
	elseif studio() then
		offline = true
		warn("[lune] 저장소를 열지 못해 메모리에만 저장한다: " .. tostring(result))
	else
		warn("[lune] 저장소를 열지 못했다(다음에 다시 해 본다): " .. tostring(result))
	end
	return stores[which]
end

local function try(fn)
	local last
	for attempt = 1, RETRIES do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		last = result
		if attempt < RETRIES then
			task.wait(WAIT)
		end
	end
	return false, last
end

-- 읽는다. 돌려주는 것: 읽었는가, 읽은 값(없으면 nil), 읽기에 실패했는가(라이브 — 부른 쪽이 「없음」으로 다루면 안 된다).
--  Studio에서 읽지 못했으면(API 접근이 꺼져 있을 때) 그 뒤로는 메모리만 쓴다(실패가 아니라 메모리 모드)
local function read(which: string, key: string): (boolean, any, boolean)
	local ds = getStore(which)
	if ds and not offline then
		local ok, result = try(function()
			return ds:GetAsync(key)
		end)
		if ok then
			return true, result, false
		end
		if studio() then
			offline = true
			warn("[lune] 저장소를 읽지 못해 메모리에만 저장한다: " .. tostring(result))
			return false, nil, false
		end
		warn(("[lune] 저장소에서 %s를 읽지 못했다: %s"):format(key, tostring(result)))
		return false, nil, true
	end
	return false, nil, not offline -- 저장소를 열지 못했다(라이브면 실패 · Studio의 메모리 모드면 실패가 아니다)
end

-- ---------- 계정 ----------
-- 저장된 계정을 읽는다. 없으면 nil.
-- 저장된 계정을 읽는다 → 계정(없으면 nil), 읽기에 실패했는가(true면 nil을 「새 계정」으로 다루면 안 된다 — 저장된 것을 빈 계정으로 덮어쓴다)
function Store.loadAccount(userId: number): (any, boolean)
	local ok, result, failed = read("account", "acct_" .. userId)
	if ok then
		return result, false
	end
	if failed then
		return nil, true
	end
	return memory.account[userId], false
end

-- 계정을 저장한다. 됐으면 true.
-- 저장의 차례(계정마다): 다시 해 보는 사이에 더 새로운 저장이 나왔으면 옛 것은 그만 쓴다 — 늦게 다시 쓴 옛 것이 새 것을 덮지 않게(2026-10-18 검토)
local saveSeq: { [number]: number } = {}
function Store.saveAccount(userId: number, data): boolean
	memory.account[userId] = data
	local ds = getStore("account")
	if not ds or offline then
		return false
	end
	saveSeq[userId] = (saveSeq[userId] or 0) + 1
	local mine = saveSeq[userId]
	local stale = false
	local ok, err = try(function()
		if saveSeq[userId] ~= mine then
			stale = true -- 더 새로운 저장이 이미 나갔다: 이것은 쓰지 않는다
			return
		end
		ds:SetAsync("acct_" .. userId, data)
	end)
	if not ok then
		warn(("[lune] %d의 저장에 실패했다: %s"):format(userId, tostring(err)))
	end
	-- 그만 쓴 옛 저장은 「저장했다」가 아니다(더 새로운 저장도 실패할 수 있다) — 경매장은 저장을 확인하고서야 장부를 바꾼다(2026-10-18 검토)
	return ok and not stale
end

-- ---------- 계정의 잠금 ----------
-- 같은 계정이 두 서버에 동시에 들어오면, 두 서버가 제가 아는 가방을 번갈아 저장해 물건이 복사되거나 사라진다(한쪽에서 창고에 넣고 다른 쪽에서 그 전의 가방을 저장한다).
--  그래서 계정을 읽기 전에 이 서버가 그 계정을 잡는다(같은 저장소의 "lock_<번호>" = { job = 서버의 번호, at = 잡은 때 }). 다른 서버가 잡고 있으면 읽지 않는다.
--  서버는 틈틈이(저장할 때마다 — 60초) 잠금을 새로 고치고, 나갈 때 푼다. LOCK_TTL초가 지나도록 새로 고쳐지지 않은 잠금은 죽은 서버의 것으로 보고 넘겨받는다.
--  저장소를 쓸 수 없으면(Studio — 메모리에만 저장한다) 잠그지 않는다. 저장소가 잠깐 말을 듣지 않을 때에도 막지 않는다(들어오지 못하는 것보다 낫다).
local LOCK_TTL = 150
Store.LOCK_TTL = LOCK_TTL
Store.JOB = nil :: string? -- (자동 검사가 다른 서버인 척할 때 적는다)
local function jobId(): string
	if Store.JOB then
		return Store.JOB
	end
	local ok, id = pcall(function()
		return game.JobId
	end)
	return if ok and typeof(id) == "string" and id ~= "" then id else "studio"
end

-- 이 서버가 그 계정을 잡는다(이미 잡고 있으면 시간을 새로 고친다). 다른 서버가 잡고 있으면 false
function Store.lock(userId: number): boolean
	local ds = getStore("account")
	if offline then
		return true
	end
	if not ds then
		return false -- 저장소를 열지 못했다(라이브): 잡지 못한 것으로(들여보내지 않는다)
	end
	local mine, job = true, jobId()
	local ok, err = try(function()
		ds:UpdateAsync("lock_" .. userId, function(old)
			local now = os.time()
			if typeof(old) == "table" and old.job ~= job and typeof(old.at) == "number" and now - old.at < LOCK_TTL then
				mine = false
				return nil -- 다른 서버의 것이다: 그대로 둔다
			end
			mine = true
			return { job = job, at = now }
		end)
	end)
	if not ok then
		warn(("[lune] %d의 잠금을 확인하지 못했다(막지 않는다): %s"):format(userId, tostring(err)))
		return true
	end
	return mine
end

-- 잠금을 푼다(이 서버가 잡고 있을 때만). 계정을 저장한 뒤에 부른다
function Store.unlock(userId: number)
	local ds = getStore("account")
	if not ds or offline then
		return
	end
	local job = jobId()
	try(function()
		ds:UpdateAsync("lock_" .. userId, function(old)
			if typeof(old) == "table" and old.job == job then
				return { job = job, at = 0 } -- 지난 잠금으로 적는다(다른 서버가 바로 잡을 수 있다)
			end
			return nil
		end)
	end)
end

-- 계정이 생기기 전의 저장(캐릭터 하나)을 읽는다. 없으면 nil. 쓰지도 지우지도 않는다.
function Store.loadOld(userId: number): (any, boolean)
	local ok, result, failed = read("old", "hero_" .. userId)
	if ok then
		return result, false
	end
	return nil, failed
end

-- ---------- 이름 장부 ----------
-- 그 이름을 가진 사람의 번호. 아무도 없으면 nil. 읽지 못했으면 false(그때는 이름을 지을 수 없다고 답한다)
function Store.nameOwner(key: string): any
	if offline then
		return memory.names[key]
	end
	if not getStore("names") then
		return false -- 장부를 열지 못했다(라이브): 이름을 지을 수 없다고 답한다
	end
	local ok, result = read("names", key)
	if ok then
		return if typeof(result) == "table" and result.u then result.u else nil
	end
	return if offline then memory.names[key] else false
end

-- 그 이름을 내 것으로 적는다. 비어 있거나 이미 내 것이면 true, 남의 것이면 false. 적지 못했으면 nil.
function Store.claimName(key: string, userId: number, at: number?): boolean?
	local ds = getStore("names")
	if offline then
		if memory.names[key] ~= nil and memory.names[key] ~= userId then
			return false
		end
		memory.names[key] = userId
		return true
	end
	if not ds then
		return nil -- 장부를 열지 못했다(라이브): 적지 못했다
	end
	local mine = false
	local ok, err = try(function()
		mine = false
		ds:UpdateAsync(key, function(old)
			if typeof(old) == "table" and old.u and old.u ~= userId then
				return nil -- 남의 것: 그대로 둔다
			end
			mine = true
			return { u = userId, at = at or 0 }
		end)
	end)
	if not ok then
		warn(("[lune] 이름 장부에 적지 못했다: %s"):format(tostring(err)))
		return nil
	end
	return mine
end

-- 내 이름을 장부에서 지운다(캐릭터를 지웠을 때 — 그 이름을 다른 사람이 쓸 수 있게 된다). 남의 것은 건드리지 않는다.
function Store.freeName(key: string, userId: number)
	local ds = getStore("names")
	if offline then
		if memory.names[key] == userId then
			memory.names[key] = nil
		end
		return
	end
	if not ds then
		return
	end
	try(function()
		ds:UpdateAsync(key, function(old)
			if typeof(old) == "table" and old.u == userId then
				return { u = false, at = old.at } -- 빈 이름(u = false): 누구든 다시 가질 수 있다
			end
			return nil
		end)
	end)
end

-- ---------- 명예의 전당의 순위판 ----------
--  판마다 OrderedDataStore 하나(열쇠 → 점수). 이름 · 직업은 따로(rankInfo — 열쇠 → { name, class }).
--  memoryOnly = 저장소에 쓰지 않고 이 서버의 메모리에만 둔다(확인용 임시 계정 — Studio에서 판을 볼 때만 쓰인다). 읽을 때는 저장소의 것과 메모리의 것을 합친다.
local ranks = {} -- [판] = OrderedDataStore
local rankMemory = { level = {}, power = {}, robux = {} } -- [판][열쇠] = 점수(메모리에만 있는 것 · 저장소를 못 쓸 때의 것)
local infoMemory = {} -- [열쇠] = { name, class }

local function getRank(board: string)
	if ranks[board] or offline then
		return ranks[board]
	end
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(RANK[board])
	end)
	if ok then
		ranks[board] = result
	elseif studio() then
		offline = true
		warn("[lune] 순위판을 열지 못해 메모리에만 둔다: " .. tostring(result))
	else
		warn("[lune] 순위판을 열지 못했다(다음에 다시 해 본다): " .. tostring(result)) -- 라이브: 순위판 하나 때문에 서버 전체를 메모리 모드로 돌리지 않는다(2026-10-18 검토)
	end
	return ranks[board]
end

-- 그 판에 점수를 적는다(같은 열쇠는 덮어쓴다)
function Store.rankSet(board: string, key: string, score: number, memoryOnly: boolean?)
	if not RANK[board] then
		return
	end
	local ds = if memoryOnly then nil else getRank(board)
	if not ds or offline then
		rankMemory[board][key] = score
		return
	end
	rankMemory[board][key] = nil
	local ok, err = try(function()
		ds:SetAsync(key, score)
	end)
	if not ok then
		warn(("[lune] 순위판 %s에 적지 못했다: %s"):format(board, tostring(err)))
	end
end

function Store.rankRemove(board: string, key: string)
	if not RANK[board] then
		return
	end
	rankMemory[board][key] = nil
	local ds = getRank(board)
	if ds and not offline then
		try(function()
			ds:RemoveAsync(key)
		end)
	end
end

-- 그 판의 위에서부터 n줄: { { key, score } … }(높은 차례)
function Store.rankTop(board: string, n: number)
	local rows = {}
	if not RANK[board] then
		return rows
	end
	local ds = getRank(board)
	if ds and not offline then
		local ok, pages = try(function()
			return ds:GetSortedAsync(false, n)
		end)
		if ok and pages then
			for _, entry in pages:GetCurrentPage() do
				table.insert(rows, { key = entry.key, score = entry.value })
			end
		end
	end
	for key, score in rankMemory[board] do
		table.insert(rows, { key = key, score = score })
	end
	table.sort(rows, function(a, b)
		if a.score ~= b.score then
			return a.score > b.score
		end
		return a.key < b.key
	end)
	while #rows > n do
		table.remove(rows)
	end
	return rows
end

-- 순위판에 적힌 열쇠의 이름 · 직업
function Store.rankInfoSet(key: string, info, memoryOnly: boolean?)
	infoMemory[key] = info
	local ds = if memoryOnly then nil else getStore("rankInfo")
	if ds and not offline then
		try(function()
			ds:SetAsync(key, info)
		end)
	end
end

function Store.rankInfoGet(key: string)
	if infoMemory[key] then
		return infoMemory[key]
	end
	local ok, result = read("rankInfo", key)
	if ok and typeof(result) == "table" then
		infoMemory[key] = result
		return result
	end
	return nil
end

function Store.rankInfoRemove(key: string)
	infoMemory[key] = nil
	local ds = getStore("rankInfo")
	if ds and not offline then
		try(function()
			ds:RemoveAsync(key)
		end)
	end
end

-- ---------- 경매장의 장부 ----------
--  분류마다 문서 하나(LuneMarket_v2의 열쇠 b_<분류> — v1은 2026-10-13의 첫 꼴: 메이플 옥션 방식으로 바꾸며 버렸다). 문서를 바꾸는 것은 UpdateAsync 하나로만 한다 — 두 서버가 같은 줄을 같이 바꾸려 해도 한쪽만 된다(셈은 shared/lune/sim/market.luau의 tx…).
--  저장소를 못 쓰면(Studio에서 API 접근이 꺼져 있을 때) 이 서버의 메모리에 둔다 — 그 판 안에서는 올리고 살 수 있다(끄면 사라진다).
--  잠깐 말을 듣지 않는다고 메모리로 넘어가지는 않는다(장부는 여러 서버가 같이 본다 — 이 서버만의 장부가 생기면 안 된다): 못 읽고 못 썼다고 알릴 뿐이다.
-- 장부를 읽는다 → 읽었는가, 문서(없으면 nil)
function Store.marketRead(key: string): (boolean, any)
	local ds = getStore("market")
	if offline then
		return true, memory.market[key]
	end
	if not ds then
		return false, nil -- (라이브) 이 서버만의 장부를 만들지 않는다
	end
	local ok, result = try(function()
		return ds:GetAsync("b_" .. key)
	end)
	if not ok then
		warn(("[lune] 경매장의 장부 %s를 읽지 못했다: %s"):format(key, tostring(result)))
		return false, nil
	end
	return true, result
end

-- 장부를 바꾼다. fn(지금의 문서) → 새 문서(nil이면 그대로 둔다), 결과 둘. 돌려주는 것: 저장소가 답했는가, 그 결과 둘, 바꾼 뒤의 문서.
--  fn은 여러 번 불릴 수 있다(다른 서버가 먼저 쓰면 저장소가 다시 부른다 · 답이 늦으면 우리가 다시 해 본다) — 받은 문서만 보고, 다시 불려도 같은 답을 내야 한다.
--  false가 돌아오면 적혔는지 알 수 없다(부른 쪽이 그렇게 다룬다)
function Store.marketUpdate(key: string, fn: (any) -> (any, any, any)): (boolean, any, any, any)
	local ds = getStore("market")
	if not ds and not offline then
		return false, nil, nil, nil -- (라이브) 저장소를 열지 못했다
	end
	if offline then
		local new, a, b = fn(memory.market[key])
		if new ~= nil then
			memory.market[key] = new
		end
		return true, a, b, memory.market[key]
	end
	local a, b, doc
	local ok, err = try(function()
		ds:UpdateAsync("b_" .. key, function(old)
			local new
			new, a, b = fn(old)
			doc = if new ~= nil then new else old
			return new
		end)
	end)
	if not ok then
		warn(("[lune] 경매장의 장부 %s에 쓰지 못했다: %s"):format(key, tostring(err)))
		return false, nil, nil, nil
	end
	return true, a, b, doc
end

function Store.isOffline(): boolean
	return offline
end

return Store

end
