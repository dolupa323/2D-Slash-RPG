eq(Bag.buy(b, "potion", 1.5), nil, "소수는 못 산다")
eq(Bag.buy(b, "potion", 100000), nil, "한 번에 너무 많이는 못 산다")
eq(Bag.buy(b, "nothing", 1), nil, "없는 물건")
expect(Bag.buy(b, "a1_hat", 1), "Lv.1 모자")
