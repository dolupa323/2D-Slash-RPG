	end,
	mult = function(g)
		return 1 + (if hot(g) then 0.15 else 0) + (if g.has("sl_overheat") then 0.3 else 0) + (if g.has("c_hero") then 0.05 else 0)
	end,
	hot = hot,
	onHit = function(g, m, dmg, o)
		if not dmg or dmg == 0 or o.proc then
			return
		end
		if g.sk("sl_heat") > 0 then
			g.s.heat = min(HEAT.max, g.s.heat + HEAT.gain * (if g.sk("sl_heat2") > 0 then 1.3 else 1))
			g.s.lastHit = g.clock
		end
		if hot(g) then
			g.call("flame", m) -- 달아오름: 불꽃이 한 번 더 터진다
		end
		if g.toggle and g.clock - g.s.emberAt > 0.25 then
			g.s.emberAt = g.clock
			for i = 0, if hot(g) and g.sk("sl_ember2") > 0 then 1 else 0 do
				g.call("ember", m.x, m.y - m.h - 10, g.nearest(130, { from = m.x, ["not"] = m }) or m, if i ~= 0 then -1 else 1)
			end
		end
	end,
	tick = function(g, dt)
		local f = g.s.furnace
		local nearFurnace = f ~= nil and f.t < f.life and abs(f.x - g.x) < 60
		if g.has("sl_overheat") then
			g.s.heat = HEAT.max
		elseif nearFurnace then
			g.s.heat = min(HEAT.max, g.s.heat + 5 * dt)
		elseif g.authority and g.clock - g.s.lastHit > HEAT.cool then -- 식는 것은 서버가 셈한다(화면은 받은 값을 그린다)
			g.s.heat = max(0, g.s.heat - HEAT.decay * (if g.sk("sl_heat2") > 0 then 0.6 else 1) * dt)
		end
		if g.has("sl_overheat") then -- 폭주: 몸 둘레에 계속 타오르는 불, 발자국마다 불
			g.s.aura += dt
			if g.s.aura > 0.06 then
				g.s.aura = 0
				g.fx.shards(g.x + (g.rnd() - 0.5) * 12, g.y - 2 - g.rnd() * 16, 1, g.tone, flameWith({ speed = 8, up = 50, life = 0.5 }))
			end
			if g.ground and abs(g.hero.vx) > 1 then
				g.s.step += dt
				if g.s.step > 0.12 then
					g.s.step = 0
					g.fx.spike(g.x - g.dir * 4, g.y, 6, 7 + g.rnd() * 5, g.tone, { life = 0.5 })
				end
			end
		end
	end,
	drawBack = function(ctx, g) -- 맞불: 몸을 두른 불꽃 고리
		if g.has("sl_cross") then
			for i = 0, 11 do
				local a = g.clock * 5 + i * 0.5236
				local x, y = g.x + cos(a) * 15, g.y - 9 + sin(a) * 12
				ctx:style(if i % 2 == 1 then g.tone.n else g.tone.l)
				ctx:rect(R(x) - 1, R(y) - 1, 2 + (if i % 3 == 0 then 1 else 0), 2)
			end
		end
	end,
	draw = function(ctx, g) -- 열기 막대(발밑의 이름표 바로 아래 — 핵심 장치): 눈금을 넘으면 달아오름. 열기를 배운 내 캐릭터에만 보인다
		if g.sk("sl_heat") <= 0 then
			return
		end
		-- 발밑에서 Common.GAUGE_DOWN만큼 아래: 이름표(발밑 2~9점)에 가리지 않는다(사용자 2026-10-11: "캐릭터 아래에 게이지 보여주는 스킬들이 … 닉네임이랑 겹쳐서 가려버리는 문제")
		local x, y, w = R(g.x) - 9, R(g.y) + Common.GAUGE_DOWN, R((18 * g.s.heat) / 100)
		ctx:style(0x12161c)
		ctx:rect(x - 1, y - 1, 20, 4)
		ctx:style(if hot(g) then (if floor(g.clock * 10) % 2 == 1 then g.tone.l else g.tone.n) else g.tone.d)
		ctx:rect(x, y, w, 2)
		ctx:style(0xeef6f6)
		ctx:rect(x + R(18 * hotAt(g) / 100), y - 1, 1, 4)
	end,
	-- 서버가 정해 화면에 알리는 것(g.call)
	calls = {
		-- 불티 하나: (x, y)에서 t에게. 옮겨붙는 것은 옮겨붙는 불티를 배웠을 때
		ember = function(g, x, y, t, side)
			ember(g, x, y, t, g.sk("sl_ember3") > 0, side)
		end,
		flame = function(g, m)
			g.fx.shards(m.x, m.y - m.h - 8, 3, g.tone, flame)
			g.hurt(m, 1, { proc = true, quiet = true })
		end,
	},
	-- 지금의 서버(1차 — sim/kit.luau)가 알리는 따로 나가는 타. o = { sx, sy(날아오는 자리) · land(닿은 순간에 부를 것) }
	procs = {
		-- o.i = 몇째 불티(겹불티의 둘째는 반대로 휜다) · o.hop = 앞의 불티가 맞힌 뒤 옮겨붙은 것(조금 늦게 떠난다)
		ember = function(g, m, o)
			local function go()
				ember(g, o.sx, o.sy, m, false, if o.i == 1 then -1 else 1, o)
			end
			if o.hop then
				g.after(0.3, go)
			else
				go()
			end
		end,
		flame = function(g, m, o)
			g.fx.shards(m.x, m.y - m.h - 8, 3, g.tone, flame)
			o.land()
		end,
	},
	skills = skills,
}

return salamander

end
MODULES['ReplicatedStorage/shared/lune/kitset'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 직업 묶음(shared/lune/kits/<직업>.luau)의 찾아보기 — 공방 시험 탭의 js/lune/skills.js(KITS).
--  직업 묶음 = { tone, toggle, icons, 고리들(init · tick · onHit · mult · haste · chargeMax … · draw · drawBack · drawMarks · drawBind), calls(서버가 정해 화면에 알리는 것), procs, skills }
--  스킬 = { id, key, air, ground, segs = { 구간 } } 또는 바로 걸리는 것 { id, key, instant = true, cast(g) }
--  구간 = { clip, from, to, fps, loopFrom, needPress, float, walk, turn, trail, loop + dur · hold(min · max) · charge(per) · till(g),
--           start(g) · finish(g) · every = { 초, fn(g) } · ev = { [장 번호] = fn(g) } }
--  여기서 덧붙이는 것: kit.who(직업) · kit.byId[스킬] · 구간마다 evs(장 번호 차례로 늘어놓은 { 장, fn } — 같은 걸음에 여러 장이 지나가도 차례대로 터진다)
local kits = script.Parent.kits

local Kits = {
	axion = require(kits.axion),
	riven = require(kits.riven),
	reaper = require(kits.reaper),
	mooni = require(kits.mooni),
	salamander = require(kits.salamander),
}

local SKILL = {} -- [스킬] = 직업 묶음
for who, kit in Kits do
	kit.who = who
	kit.byId = {}
	for _, skill in kit.skills do
		kit.byId[skill.id] = skill
		SKILL[skill.id] = kit
		for _, seg in skill.segs or {} do
			local evs = {}
			for frame, fn in seg.ev or {} do
				table.insert(evs, { frame, fn })
			end
			table.sort(evs, function(a, b)
				return a[1] < b[1]
			end)
			seg.evs = evs
		end
	end
end

local Kitset = {}
Kitset.kits = Kits

function Kitset.of(who: string)
	return Kits[who]
end

-- 그 스킬이 든 직업 묶음과 스킬(없으면 nil)
function Kitset.skill(id: string)
	local kit = SKILL[id]
	if kit then
		return kit.byId[id], kit
	end
	return nil, nil
end

return Kitset

end
MODULES['ReplicatedStorage/shared/lune/net/net'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 「달의 계승자」의 네트워크 계층 — shared/net/net.luau(닌자 게임의 것)를 그대로 가져와 리모트 폴더 이름만 바꿨다. 패킷 정의는 같은 폴더의 packets.luau.
-- 네트워크 계층. 모든 RemoteEvent/RemoteFunction은 shared/net/packets.luau의 정의로만 만들고 쓴다 — 모듈마다
-- 리모트를 제각각 만들고 이름 문자열로 찾던 구조를 대체한다.
--   서버: Net.OnServer(이름, 핸들러) — 인자 개수/타입과 요청 빈도를 검사해서 통과한 요청만 핸들러로 보낸다.
--         Net.FireClient / Net.FireAllClients
--   클라: Net.FireServer / Net.Invoke / Net.OnClient
-- 검증에 실패하거나 빈도를 넘긴 요청은 조용히 버리고(서버 로그에는 플레이어·패킷별로 몇 초에 한 번만 경고) 핸들러는
-- 호출하지 않는다. 이동 위치를 매번 거절하는 것은 엔진 공식 문서가 비권장하지만(오탐/지연), 이 계층은 "중요 행동
-- 요청이 형식에 맞는지, 폭주하지 않는지"만 본다 — 위치/내용의 타당성 검증은 각 서비스가 맡는다.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local packets = require(script.Parent.packets)

local IS_SERVER = RunService:IsServer()
local FOLDER_NAME = "LuneRemotes"

local Net = {}

local folder: Folder
if IS_SERVER then
	folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME) or Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = ReplicatedStorage
	for name, def in packets do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new(if def.Kind == "Function" then "RemoteFunction" else "RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

local function getRemote(name: string)
	assert(packets[name], ("Net: 정의되지 않은 패킷 '%s' (shared/net/packets.luau에 먼저 추가)"):format(name))
	if IS_SERVER then
		return folder:FindFirstChild(name)
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME):WaitForChild(name)
end

-- ===== 서버 =====

-- 플레이어별 패킷별 토큰 버킷: buckets[userId][name] = { tokens, last }
local buckets: { [number]: { [string]: { tokens: number, last: number } } } = {}
local lastWarn: { [string]: number } = {}

local function warnThrottled(key: string, message: string)
	local now = os.clock()
	if not lastWarn[key] or now - lastWarn[key] > 5 then
		lastWarn[key] = now
		warn(message)
	end
end

local function takeToken(player: Player, name: string, limit): boolean
	local perPlayer = buckets[player.UserId]
	if not perPlayer then
		perPlayer = {}
		buckets[player.UserId] = perPlayer
	end
	local now = os.clock()
	local bucket = perPlayer[name]
	if not bucket then
		bucket = { tokens = limit.Burst, last = now }
		perPlayer[name] = bucket
	end
	bucket.tokens = math.min(limit.Burst, bucket.tokens + (now - bucket.last) * limit.PerSecond)
	bucket.last = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

local function validArgs(def, ...): boolean
	if select("#", ...) > #def.Args then
		return false -- 정의보다 인자가 많으면 형식 위반
	end
	for i, check in def.Args do
		if not check((select(i, ...))) then
			return false
		end
	end
	return true
end

-- ClientToServer 패킷 핸들러 등록. Function 패킷이면 핸들러의 반환값이 클라이언트에 돌아간다.
function Net.OnServer(name: string, handler: (player: Player, ...any) -> ...any)
	assert(IS_SERVER, "Net.OnServer는 서버에서만 쓴다")
	local def = packets[name]
	assert(def and def.Direction == "ClientToServer", ("Net.OnServer: '%s'는 ClientToServer 패킷이 아니다"):format(name))
	local remote = getRemote(name)

	local function guarded(player: Player, ...)
		if not takeToken(player, name, def.RateLimit) then
			warnThrottled(player.UserId .. name .. "rate", ("Net: %s의 '%s' 요청이 빈도 제한을 넘어 버려졌다"):format(player.Name, name))
			return false
		end
		if not validArgs(def, ...) then
			warnThrottled(player.UserId .. name .. "arg", ("Net: %s의 '%s' 요청 인자가 형식에 맞지 않아 버려졌다"):format(player.Name, name))
			return false
		end
		return true
	end

	if def.Kind == "Function" then
		remote.OnServerInvoke = function(player: Player, ...)
			if not guarded(player, ...) then
				return nil
			end
			return handler(player, ...)
		end
	else
		remote.OnServerEvent:Connect(function(player: Player, ...)
			if guarded(player, ...) then
				handler(player, ...)
			end
		end)
	end
end

function Net.FireClient(name: string, player: Player, ...: any)
	assert(IS_SERVER)
	getRemote(name):FireClient(player, ...)
end

function Net.FireAllClients(name: string, ...: any)
	assert(IS_SERVER)
	getRemote(name):FireAllClients(...)
end

if IS_SERVER then
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		buckets[player.UserId] = nil
	end)
end

-- ===== 클라이언트 =====

function Net.FireServer(name: string, ...: any)
	assert(not IS_SERVER)
	getRemote(name):FireServer(...)
end

function Net.Invoke(name: string, ...: any): any
	assert(not IS_SERVER)
	return getRemote(name):InvokeServer(...)
end

function Net.OnClient(name: string, handler: (...any) -> ()): RBXScriptConnection
	assert(not IS_SERVER)
	return getRemote(name).OnClientEvent:Connect(handler)
end

return Net

end
MODULES['ReplicatedStorage/shared/lune/net/packets'] = function(script, game, require, task, os, typeof, Vector2, Random, Color3, UDim2, Enum, Instance, warn, print, workspace, tick)
-- 「달의 계승자」의 네트워크 패킷 정의(단 하나의 출처). 짜임은 shared/net/packets.luau와 같다.
--  Direction: "ClientToServer" / "ServerToClient" · Kind: "Event" / "Function"
--  Args · RateLimit은 ClientToServer만 — net.luau가 인자 형식과 빈도를 검사한 뒤에야 핸들러를 부른다.
--  원칙: 클라이언트는 "하고 싶다"만 보낸다. 체력 · 경험치 · 돈 · 졸개 · 떨어진 것의 진실은 서버가 갖는다.
local t = {}

function t.number(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function t.string(value: any): boolean
	return typeof(value) == "string" and #value <= 64
end

function t.dir(value: any): boolean
	return value == 1 or value == -1
end

function t.table(value: any): boolean
	return typeof(value) == "table"
end

function t.any(_value: any): boolean
	return true -- 꼴은 받는 쪽이 본다(없어도 된다)
end

local packets = {
	-- ===== 클라이언트 → 서버 =====
	-- 들어와서 처음 한 번: 캐릭터 고르기 화면에 놓을 것 { select = { chars = { { id, name, class, level } … }, max, last } }.
	--  이미 캐릭터로 들어가 있으면(다시 물었을 때) 내 상태와 지금 방 { self, scene, x, y, room … }
	Ready = { Kind = "Function", Direction = "ClientToServer", Args = {}, RateLimit = { PerSecond = 1, Burst = 3 } },
	-- 캐릭터 고르기 화면의 일(하는 일, 대상 둘): check(이름) · create(이름, 직업) · name(번호, 이름) · delete(번호, 이름) · enter(번호) · leave()
	--  돌려주는 값: { ok, why, select … } — enter는 Ready의 뒤쪽과 같은 것(내 상태와 방). server/lune/modules/world.luau의 onChars
	Chars = { Kind = "Function", Direction = "ClientToServer", Args = { t.string, t.any, t.any }, RateLimit = { PerSecond = 2, Burst = 5 } },
	-- 명예의 전당: 순위판 셋의 위 열 줄 { level = { { name, class, value } … }, power = …, robux = … }
	Rank = { Kind = "Function", Direction = "ClientToServer", Args = {}, RateLimit = { PerSecond = 1, Burst = 3 } },
	-- 능력치에 점수를 찍는다(능력치 이름, 점수) · 남은 점수를 모두 주 능력치에
	StatAdd = { Kind = "Event", Direction = "ClientToServer", Args = { t.string, t.number }, RateLimit = { PerSecond = 10, Burst = 20 } },
	StatAuto = { Kind = "Event", Direction = "ClientToServer", Args = {}, RateLimit = { PerSecond = 2, Burst = 3 } },
	-- 스킬을 한 레벨 올린다(스킬 id) · 남은 포인트를 추천대로
	SkillUp = { Kind = "Event", Direction = "ClientToServer", Args = { t.string }, RateLimit = { PerSecond = 10, Burst = 20 } },
	SkillAuto = { Kind = "Event", Direction = "ClientToServer", Args = {}, RateLimit = { PerSecond = 2, Burst = 3 } },
	-- 전직하며 받은 공짜 초기화를 쓴다(스킬 창의 「초기화」 — 찍은 스킬을 모두 되돌린다)
	SkillReset = { Kind = "Event", Direction = "ClientToServer", Args = {}, RateLimit = { PerSecond = 1, Burst = 2 } },
	-- 물건을 다룬다: 하는 일(equip · unequip · dismantle · buy · enhance · transfer · restore · grow · storeIn · storeOut)과 그 대상 둘(번호 · 부위 · 수 등)
	Item = { Kind = "Event", Direction = "ClientToServer", Args = { t.string, t.any, t.any, t.any, t.any }, RateLimit = { PerSecond = 8, Burst = 12 } },
	-- 파티: 하는 일(invite · accept · decline · leave)과 대상(초대할 사람의 번호)
	Party = { Kind = "Event", Direction = "ClientToServer", Args = { t.string, t.any }, RateLimit = { PerSecond = 4, Burst = 6 } },
	-- 퀘스트: 하는 일(accept · complete · drop)과 퀘스트 id — 받기와 돌려주기는 그 주민 앞에서만
	Quest = { Kind = "Event", Direction = "ClientToServer", Args = { t.string, t.any }, RateLimit = { PerSecond = 4, Burst = 6 } },
	-- 바꾼 키를 저장한다 { [하는 일] = 키 이름 } — 꼴은 서버가 다시 본다
	Keys = { Kind = "Event", Direction = "ClientToServer", Args = { t.table }, RateLimit = { PerSecond = 2, Burst = 4 } },
	-- 일일 의뢰: 하는 일(view 보기 · accept 받기 · turn 내기)과 지역 · 몇째 의뢰. 받기와 내기는 그 게시판 앞에서만.
	--  돌려주는 값 { ok, why, reward = { xp, money, dust, all, name }, view = sim/daily.luau의 view }
	Daily = { Kind = "Function", Direction = "ClientToServer", Args = { t.string, t.any, t.any }, RateLimit = { PerSecond = 4, Burst = 8 } },
	-- 출석(2026-10-15): "view" = 판 { view, fresh(오늘 처음 들어와 칸이 찼다 — 창을 한 번 띄운다) } · "claim" = 받지 않은 칸을 모두 받는다 { view, got, why }
	Attend = { Kind = "Function", Direction = "ClientToServer", Args = { t.string }, RateLimit = { PerSecond = 2, Burst = 4 } },
	-- 업적(2026-10-15): "view" = { view = { score, rows = { [id] = { have, need, st } } } } · "claim" id = 그 업적의 보상 · "all" = 받을 것을 모두 { view, got, why }
	Achieve = { Kind = "Function", Direction = "ClientToServer", Args = { t.string, t.any }, RateLimit = { PerSecond = 3, Burst = 6 } },
	-- 2편의 도시 생활(2026-10-16): "view" · "talk" 사람 · "gift" 사람, 선물 · "claim" 사람 · "read" 이야기 · "tome" 곳, % — 돌려주는 값 { ok, why, view, note } (server/lune/modules/world.luau의 onBond · 셈은 sim/bond.luau)
	Bond = { Kind = "Function", Direction = "ClientToServer", Args = { t.string, t.any, t.any }, RateLimit = { PerSecond = 6, Burst = 12 } },
